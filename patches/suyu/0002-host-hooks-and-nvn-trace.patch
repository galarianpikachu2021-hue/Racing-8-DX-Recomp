+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: SDK call tracer, Phase 0 of the native-engine plan (docs/NATIVE_ENGINE.md).
+//
+// The game reaches the console OS through the Nintendo SDK module ("sdk"): nn::os, nn::fs, nn::hid, nn::audio, ... Every exported
+// function of that module gets a counting hook, so a run shows which SDK functions the game really calls and how often - the work
+// list for replacing the emulated OS with native code. Only calls that come back through the host dispatcher are seen, which is
+// every call from main into the sdk (cross-module); calls inside the sdk are mostly chained and not seen.
+//
+// Enabled with KARTRECOMP_SDK_TRACE=1. Writes <log dir>/sdk_trace.txt every 10 s:
+//   <calls from main> <all calls> <calls from main in the last 10 s> <mangled name>
+#pragma once
+
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::SdkTrace {
+
+bool Enabled();
+
+/// Every defined function in a module's dynamic symbol table: (mangled name, module-relative address).
+std::vector<std::pair<std::string, u64>> ExportedFunctions(std::span<const u8> image);
+
+/// Called by the NSO loader with each module's image before it is mapped; hooks the exports of "sdk", remembers where "main" is.
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name);
+
+} // namespace Core::SdkTrace
