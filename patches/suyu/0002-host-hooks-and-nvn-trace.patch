+                const u64 view = Mem(ctx).Read64(ctx.x[3] + i * 8);
+                const auto& tt = c.colors.back();
+                if (view && (tt.width == 960 || tt.width == 480) && shown.fetch_add(1) < 400) {
+                    u32 w[12]{};
+                    Mem(ctx).ReadBlock(view, w, sizeof(w));
+                    const auto& t = c.colors.back();
+                    KartRe::Log("rt-view levels={} {}x{} f{} slot {} view {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} "
+                                "{:08x} {:08x} {:08x} {:08x}",
