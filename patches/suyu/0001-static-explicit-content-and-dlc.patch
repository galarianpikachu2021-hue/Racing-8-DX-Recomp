+uint32_t Menu::Apply(Row row) {
+    const int v = items[row].value;
+    switch (row) {
+    case kUpscaler: live.upscaler = v; return kChangeUpscaler;
+    case kGraphics: live.graphics = v; return kChangeGraphics;
+    case kResolution: live.resolution = v; return kChangeResolution;
+    case kRecord: live.record = v != 0; return kChangeRecord;
+    case kQuality: live.quality = v; return kChangeQuality;
+    case kSharp: live.sharpness = v; return kChangeOther;
+    case kJitter: live.jitter = v != 0; return kChangeJitter;
+    case kFrameGen: live.framegen = v; return kChangeFrameGen;
+    case kHdr: live.hdr = v != 0; return kChangeHdr;
+    case kHdrPaper: live.hdr_paper = v; return kChangeOther;
+    case kHdrPeak: live.hdr_peak = v; return kChangeOther;
+    case kPresent: live.present_mode = v; return kChangePresent;
+    case kSpeed: live.speed_limit = v; return kChangeSpeed;
+    case kFps: live.fps_counter = v != 0; return kChangeOther;
+    case kExtraCup: {
+        if (v <= 0 || static_cast<size_t>(v) > extra_cups.size()) {
+            std::remove("extra_cup.txt");
+        } else if (std::ofstream out("extra_cup.txt", std::ios::trunc); out) {
+            out << extra_cups[static_cast<size_t>(v - 1)] << '\n';
+        }
+        return 0;
+    }
+    case kPlayer1: case kPlayer2: case kPlayer3: case kPlayer4: {
+        auto& pads = Pads();
+        std::scoped_lock lock{pads.lock};
+        pads.want[static_cast<size_t>(row - kPlayer1)] = v - 2; // option 0 = disconnected (-2), 1 = keyboard (-1), then the devices
+        return kChangePads;
+    }
+    default: return 0;
+    }
+}
+
+void Menu::SyncPads() {
+    auto& pads = Pads();
+    std::scoped_lock lock{pads.lock};
+    if (!pads.published || pads.version == pads_version) return;
+    pads_version = pads.version;
+    for (int i = 0; i < 4; ++i) {
+        Item& item = items[kPlayer1 + i];
+        item.options = {"Disconnected", "Keyboard"};
+        for (const auto& name : pads.devices) item.options.push_back(name);
+        const int cur = pads.current[static_cast<size_t>(i)];
+        item.value = std::clamp(cur + 2, 0, static_cast<int>(item.options.size()) - 1);
+        item.enabled = true;
+        item.note = "";
+    }
+}
+
+uint32_t Menu::Set(Row row, int value) {
+    Item& item = items[row];
+    if (item.options.empty() || !item.enabled) return 0;
+    item.value = std::clamp(value, 0, static_cast<int>(item.options.size()) - 1);
+    return Apply(row);
+}
+
+uint32_t Menu::Handle(Nav nav) {
+    Item& item = items[selected];
+    const int count = static_cast<int>(item.options.size());
+    switch (nav) {
+    case Nav::Up: selected = (selected + kRowCount - 1) % kRowCount; return 0;
+    case Nav::Down: selected = (selected + 1) % kRowCount; return 0;
+    case Nav::Back: OpenFlag().store(false); return 0;
+    case Nav::Left:
+    case Nav::Right:
+    case Nav::Accept:
+        if (selected == kClose) {
+            if (nav == Nav::Accept) OpenFlag().store(false);
+            return 0;
+        }
+        if (!item.enabled || count == 0) return 0;
+        item.value = (item.value + (nav == Nav::Left ? count - 1 : 1)) % count;
+        return Apply(static_cast<Row>(selected));
+    default: return 0;
+    }
+}
