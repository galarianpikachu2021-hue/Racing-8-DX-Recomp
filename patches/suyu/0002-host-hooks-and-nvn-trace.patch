+            for (u64 d : c.shaders) datas += fmt::format(" {:#x}", d);
+            KartRe::Log("nvn-bind-compute program={:#x} datas{}", ctx.x[1], datas);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
