+        c.stencil_value = Arg32(ctx, 2);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    // CallCommands is expanded at record time: the nested lists exist already.
+    h["nvnCommandBufferCallCommands"] = [](HookContext& ctx, State& s) {
+        const auto it = s.recording.find(ctx.x[0]);
+        if (it == s.recording.end()) {
+            return;
+        }
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 256; ++i) {
+            const u64 handle = Mem(ctx).Read64(ctx.x[2] + i * 8);
+            if (const auto l = s.lists.find(handle); l != s.lists.end() && l->second) {
+                Command c{.op = Op::Call};
+                c.call = l->second; // shared, expanded at submit
+                it->second.push_back(std::move(c));
+            } else {
+                ++s.missing_call_handles;
+            }
+        }
+    };
