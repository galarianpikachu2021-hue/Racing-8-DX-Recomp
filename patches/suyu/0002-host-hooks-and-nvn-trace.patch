+/// Shared fonts ("pl:u"): the font table of the emulator's font loader (the player's firmware fonts or the stand-ins); the fonts'
+/// shared memory is still the emulated kernel's object (memory system calls are emulated), handed out as a copy handle.
+std::shared_ptr<KartRuntime::Service> MakeSharedFont(KernelCore& kernel) {
+    Core::System& system = kernel.System();
+    auto pl = system.ServiceManager().GetService<Service::NS::IPlatformServiceManager>("pl:u", true);
+    if (!pl) return nullptr;
+    auto s = std::make_shared<KartRuntime::Service>("pl:u");
+    s->Ok(0);                                                                   // RequestLoad
+    s->On(1, [](KartRuntime::Context& c) { c.Push<u32>(1); });                 // GetLoadState: loaded
+    s->On(2, [pl](KartRuntime::Context& c) { c.Push<u32>(pl->FontOffsetAndSize(c.Pop<u32>()).second); }); // GetSize
+    s->On(3, [pl](KartRuntime::Context& c) { c.Push<u32>(pl->FontOffsetAndSize(c.Pop<u32>()).first); });  // GetSharedMemoryAddressOffset
+    s->On(4, [pl, &kernel](KartRuntime::Context& c) { // GetSharedMemoryNativeHandle
+        if (NativeGame::Process()) return c.PushCopyHandle(NativeGame::AddSharedMemory(pl->FontSharedMemory()));
+        Handle h{};
+        if (GetCurrentProcess(kernel).GetHandleTable().Add(kernel, &h, &pl->FontSharedMemory()).IsError()) return c.SetResult(0xD201); // out of handles
+        c.PushCopyHandle(h);
+    });
+    s->On(5, [pl](KartRuntime::Context& c) { // GetSharedFontInOrderOfPriority(language) -> codes, offsets, sizes, loaded, count
+        c.Pop<u64>();
+        const size_t n = std::min<size_t>({6, pl->FontCount(), c.WriteBufferSize(0) / 4, c.WriteBufferSize(1) / 4, c.WriteBufferSize(2) / 4});
+        std::vector<u32> codes(n), offsets(n), sizes(n);
+        for (size_t i = 0; i < n; ++i) {
+            codes[i] = static_cast<u32>(i);
+            std::tie(offsets[i], sizes[i]) = pl->FontOffsetAndSize(i);
+        }
+        c.WriteBuffer(codes.data(), n * 4, 0);
+        c.WriteBuffer(offsets.data(), n * 4, 1);
+        c.WriteBuffer(sizes.data(), n * 4, 2);
+        c.Push<u8>(1);
+        c.Push<u32>(static_cast<u32>(n));
+    });
+    return s;
+}
