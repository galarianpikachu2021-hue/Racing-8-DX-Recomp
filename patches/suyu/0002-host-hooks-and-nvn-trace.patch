+++ b/src/kart_runtime/services/applet.h
@@ -0,0 +1,494 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the applet manager as an application sees it ("appletOE": IApplicationProxy and its interfaces)
+// (docs/NATIVE_ENGINE.md, "native services").
+//
+// What it does for the game: lifecycle messages (focus changed at start, operation / performance mode changed when the player
+// switches graphics quality, exit) behind one event, the launch parameter with the preselected user, the game's display layer,
+// the exit lock, and library applets - the controller applet (answered at once with the players the engine has connected), the
+// error applet and any other (finished at once with no output). The engine's side comes in through `AppletHooks`.
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+struct AppletHooks {
+    uint64_t aruid = 0;                       ///< the game's applet resource user id (its process id)
+    std::vector<uint8_t> preselected_user;    ///< launch parameter "account preselected user" (0x88 bytes)
+    uint64_t desired_language = 0;            ///< GetDesiredLanguage
+    std::array<char, 0x10> display_version{}; ///< GetDisplayVersion
+    std::function<bool()> docked;             ///< operation mode
+    std::function<uint32_t()> performance_mode;
+    std::function<bool(uint64_t*)> create_layer; ///< CreateManagedDisplayLayer
+    std::function<void(bool)> exit_locked;       ///< LockExit / UnlockExit
+    std::function<void(uint32_t)> terminate_result; ///< SetTerminateResult (the game is about to stop on an error)
+    std::function<void(const std::string&)> log;      ///< diagnostics
+    struct ControllerArgs {
+        int min_players = 1, max_players = 4;
+        bool single = false;
+        uint32_t style_set = 0; ///< allowed controller kinds (bit 0 pro, 1 handheld, 2 dual Joy-Con, 3 left, 4 right)
+    };
+    struct ControllerResult {
+        int8_t player_count;
+        uint32_t selected_id;
+    };
+    std::function<ControllerResult(const ControllerArgs&)> controller_applet;
+    /// The web applet: an offline page of the game (its manual: document kind 1, a path inside the "html-document" archive;
+    /// 2 = legal information, 3 = a system data page, with `title_id`) or a web address. Returns the exit reason (0 end button,
+    /// 2 exit requested, 4 window closed) and the last address.
+    struct WebRequest {
+        uint32_t shim_kind = 0; ///< 1 shop, 2 login, 3 offline, 4 share, 5 web, 6 wifi, 7 lobby, 8 lhub
+        uint32_t document_kind = 0;
+        uint64_t title_id = 0;
+        std::string document_path, url;
+    };
+    std::function<std::pair<uint32_t, std::string>(const WebRequest&)> web_applet;
+};
+
+class Applets {
+public:
+    enum Message : uint32_t { Exit = 4, FocusStateChanged = 15, Resume = 16, OperationModeChanged = 30, PerformanceModeChanged = 31 };
+    static constexpr uint32_t ResultNoDataInChannel = 128 | (2u << 9);
+    static constexpr uint32_t ResultNoMessages = 128 | (3u << 9);
+
+    Applets(NativeKernel& k, AppletHooks h) : kernel{k}, hooks{std::move(h)}, message_event{std::make_shared<Event>(k, "applet message")} {
+        std::scoped_lock lk{mutex};
+        UpdateEventLocked(); // the first focus message waits from the start
+    }
+
+    /// The engine changed docked / handheld (graphics quality): the game gets a message when it asked for one.
+    void OnOperationModeChanged() {
+        std::scoped_lock lk{mutex};
+        if (operation_mode_notify) operation_mode_changed = true;
+        if (performance_mode_notify) performance_mode_changed = true;
+        UpdateEventLocked();
+    }
+    /// The engine asks the game to quit.
+    void RequestExit() {
+        std::scoped_lock lk{mutex};
+        exit_requested = true;
+        UpdateEventLocked();
+    }
+
+    std::shared_ptr<Service> Root(const char* name) {
+        auto s = std::make_shared<Service>(name);
+        s->On(0, [this](Context& c) { c.PushInterface(Proxy()); }); // OpenApplicationProxy
+        s->On(1, [this](Context& c) { c.PushInterface(Proxy()); }); // OpenApplicationProxyOld
+        return s;
+    }
+
+    /// An "IStorage": a byte buffer passed between the game and applets.
+    class Storage : public Service {
+    public:
+        explicit Storage(std::vector<uint8_t> d) : Service{"IStorage"}, data{std::move(d)} {
+            On(0, [this](Context& c) { c.PushInterface(Accessor()); }); // Open
+            On(1, [this](Context& c) { c.PushInterface(Accessor()); }); // OpenTransferStorage
+        }
+        std::vector<uint8_t> data;
+
+    private:
+        std::shared_ptr<Service> Accessor() {
+            auto a = std::make_shared<Service>("IStorageAccessor");
+            auto self = std::static_pointer_cast<Storage>(shared_from_this());
+            a->On(0, [self](Context& c) { c.Push<int64_t>(static_cast<int64_t>(self->data.size())); }); // GetSize
+            a->On(10, [self](Context& c) {                                                         // Write(offset, buffer)
+                const auto offset = c.Pop<int64_t>();
+                const auto in = c.ReadBuffer(0);
+                if (offset < 0 || static_cast<uint64_t>(offset) + in.size() > self->data.size()) return c.SetResult(128 | (503u << 9));
+                std::memcpy(self->data.data() + offset, in.data(), in.size());
+            });
+            a->On(11, [self](Context& c) { // Read(offset) -> buffer
+                const auto offset = c.Pop<int64_t>();
+                const size_t want = c.WriteBufferSize(0);
+                if (offset < 0 || static_cast<uint64_t>(offset) + want > self->data.size()) return c.SetResult(128 | (503u << 9));
+                c.WriteBuffer(self->data.data() + offset, want, 0);
+            });
+            return a;
+        }
+    };
+
+private:
+    std::shared_ptr<Service> Proxy() {
+        auto p = std::make_shared<Service>("IApplicationProxy");
+        p->On(0, [this](Context& c) { c.PushInterface(CommonStateGetter()); });
+        p->On(1, [this](Context& c) { c.PushInterface(SelfController()); });
+        p->On(2, [this](Context& c) { c.PushInterface(WindowController()); });
+        p->On(3, [](Context& c) { c.PushInterface(AudioController()); });
+        p->On(4, [](Context& c) { c.PushInterface(std::make_shared<Service>("IDisplayController")); });
+        p->On(10, [](Context& c) { c.PushInterface(std::make_shared<Service>("IProcessWindingController")); });
+        p->On(11, [this](Context& c) { c.PushInterface(LibraryAppletCreator()); });
+        p->On(20, [this](Context& c) { c.PushInterface(ApplicationFunctions()); });
+        p->On(1000, [](Context& c) { c.PushInterface(std::make_shared<Service>("IDebugFunctions")); });
+        return p;
+    }
+
+    std::shared_ptr<Service> CommonStateGetter() {
+        auto s = std::make_shared<Service>("ICommonStateGetter");
+        s->On(0, [this](Context& c) { c.PushCopyObject(message_event); }); // GetEventHandle
+        s->On(1, [this](Context& c) {                                      // ReceiveMessage
+            std::scoped_lock lk{mutex};
+            const uint32_t m = PopMessageLocked();
+            UpdateEventLocked();
+            if (m == 0) return c.SetResult(ResultNoMessages);
+            c.Push<uint32_t>(m);
+        });
+        s->On(5, [this](Context& c) { c.Push<uint8_t>(hooks.docked && !hooks.docked() ? 0 : 1); }); // GetOperationMode
+        s->On(6, [this](Context& c) { c.Push<uint32_t>(hooks.performance_mode ? hooks.performance_mode() : 1); });
+        s->On(8, [](Context& c) { c.Push<uint8_t>(0); });  // GetBootMode: normal
+        s->On(9, [](Context& c) { c.Push<uint8_t>(1); });  // GetCurrentFocusState: in focus
+        s->Ok(10);                                          // RequestToAcquireSleepLock
+        s->Ok(11);                                          // ReleaseSleepLock
+        s->On(50, [](Context& c) { c.Push<uint8_t>(0); }); // IsVrModeEnabled
+        s->Ok(51);                                          // SetVrModeEnabled
+        s->On(55, [](Context& c) { c.Push<uint8_t>(0); }); // IsInControllerFirmwareUpdateSection
+        s->On(60, [this](Context& c) {                      // GetDefaultDisplayResolution
+            const bool d = !hooks.docked || hooks.docked();
+            c.Push<int32_t>(d ? 1920 : 1280);
+            c.Push<int32_t>(d ? 1080 : 720);
+        });
+        s->On(200, [](Context& c) { c.Push<uint32_t>(0); }); // GetOperationModeSystemInfo
+        return s;
+    }
+
+    std::shared_ptr<Service> SelfController() {
+        auto s = std::make_shared<Service>("ISelfController");
+        s->On(1, [this](Context&) { if (hooks.exit_locked) hooks.exit_locked(true); });  // LockExit
+        s->On(2, [this](Context&) { if (hooks.exit_locked) hooks.exit_locked(false); }); // UnlockExit
+        s->On(9, [this](Context& c) { // GetLibraryAppletLaunchableEvent: applets can always be launched
+            if (!launchable) {
+                launchable = std::make_shared<Event>(kernel, "library applet launchable");
+                launchable->Signal();
+            }
+            c.PushCopyObject(launchable);
+        });
+        s->Ok(3);  // EnterFatalSection
+        s->Ok(4);  // LeaveFatalSection
+        s->Ok(10); // SetScreenShotPermission
+        s->On(11, [this](Context& c) { // SetOperationModeChangedNotification
+            std::scoped_lock lk{mutex};
+            operation_mode_notify = c.Pop<uint8_t>() != 0;
+        });
+        s->On(12, [this](Context& c) { // SetPerformanceModeChangedNotification
+            std::scoped_lock lk{mutex};
+            performance_mode_notify = c.Pop<uint8_t>() != 0;
+        });
+        s->On(13, [this](Context& c) { // SetFocusHandlingMode(notify, background, suspend)
+            std::scoped_lock lk{mutex};
+            focus_notify = c.Pop<uint8_t>() != 0;
+            UpdateEventLocked();
+        });
+        s->On(14, [this](Context& c) { // SetRestartMessageEnabled
+            std::scoped_lock lk{mutex};
+            resume_notify = c.Pop<uint8_t>() != 0;
+        });
+        s->Ok(15); // SetScreenShotAppletIdentityInfo
+        s->Ok(16); // SetOutOfFocusSuspendingEnabled
+        s->Ok(19); // SetAlbumImageOrientation
+        s->On(40, [this](Context& c) { // CreateManagedDisplayLayer
+            uint64_t id = 0;
+            if (!hooks.create_layer || !hooks.create_layer(&id)) return c.SetResult(114 | (6u << 9)); // vi: operation failed
+            c.Push<uint64_t>(id);
+        });
+        s->On(44, [this](Context& c) { // CreateManagedDisplaySeparableLayer: one layer (as the emulator did)
+            uint64_t id = 0;
+            if (!hooks.create_layer || !hooks.create_layer(&id)) return c.SetResult(114 | (6u << 9));
+            c.Push<uint64_t>(id);
+            c.Push<uint64_t>(0);
+        });
+        s->Ok(50); // SetHandlesRequestToDisplay
+        s->Ok(51); // ApproveToDisplay
+        s->Ok(62); // SetIdleTimeDetectionExtension
+        s->On(63, [](Context& c) { c.Push<uint32_t>(0); }); // GetIdleTimeDetectionExtension
+        s->Ok(65); // ReportUserIsActive
+        s->Ok(68); // SetAutoSleepDisabled
+        s->On(69, [](Context& c) { c.Push<uint8_t>(0); }); // IsAutoSleepDisabled
+        s->On(90, [](Context& c) { c.Push<uint64_t>(0); }); // GetAccumulatedSuspendedTickValue
+        s->Ok(100); // SetAlbumImageTakenNotificationEnabled
+        return s;
+    }
+
+    std::shared_ptr<Service> WindowController() {
+        auto s = std::make_shared<Service>("IWindowController");
+        s->On(1, [this](Context& c) { c.Push<uint64_t>(hooks.aruid); }); // GetAppletResourceUserId
+        s->On(2, [](Context& c) { c.Push<uint64_t>(0); });               // GetAppletResourceUserIdOfCallerApplet
+        s->Ok(10);                                                       // AcquireForegroundRights
+        s->Ok(11);                                                       // ReleaseForegroundRights
+        s->Ok(12);                                                       // RejectToChangeIntoBackground
+        return s;
+    }
+
+    static std::shared_ptr<Service> AudioController() {
+        auto s = std::make_shared<Service>("IAudioController");
+        auto volume = std::make_shared<float>(1.0f);
+        s->On(0, [volume](Context& c) { *volume = c.Pop<float>(); });            // SetExpectedMasterVolume(main, library)
+        s->On(1, [volume](Context& c) { c.Push<float>(*volume); });              // GetMainAppletExpectedMasterVolume
+        s->On(2, [](Context& c) { c.Push<float>(1.0f); });                       // GetLibraryAppletExpectedMasterVolume
+        s->Ok(3);                                                                // ChangeMainAppletMasterVolume
+        s->Ok(4);                                                                // SetTransparentVolumeRate
+        return s;
+    }
+
+    std::shared_ptr<Service> ApplicationFunctions() {
+        auto s = std::make_shared<Service>("IApplicationFunctions");
+        s->On(1, [this](Context& c) { // PopLaunchParameter(kind)
+            const auto kind = c.Pop<uint32_t>();
+            std::scoped_lock lk{mutex};
+            if (kind != 2 || preselected_popped || hooks.preselected_user.empty()) return c.SetResult(ResultNoDataInChannel);
+            preselected_popped = true;
+            c.PushInterface(std::make_shared<Storage>(hooks.preselected_user));
+        });
+        s->On(21, [this](Context& c) { c.Push<uint64_t>(hooks.desired_language); }); // GetDesiredLanguage
+        s->On(22, [this](Context& c) { // SetTerminateResult: the game is stopping with this result (logged by the engine)
+            const auto r = c.Pop<uint32_t>();
+            if (hooks.terminate_result) hooks.terminate_result(r);
+        });
+        s->On(23, [this](Context& c) { c.Push(hooks.display_version); });            // GetDisplayVersion
+        s->Ok(30);                                                                    // BeginBlockingHomeButtonShortAndLongPressed
+        s->Ok(31);
+        s->Ok(32);
+        s->Ok(33);
+        s->On(40, [](Context& c) { c.Push<uint8_t>(1); });                      // NotifyRunning: became running
+        s->On(50, [](Context& c) { c.Push(std::array<uint8_t, 16>{}); });       // GetPseudoDeviceId
+        s->Ok(60);                                                              // SetMediaPlaybackStateForApplication
+        s->On(65, [](Context& c) { c.Push<uint8_t>(0); });                      // IsGamePlayRecordingSupported
+        s->Ok(66);                                                              // InitializeGamePlayRecording
+        s->Ok(67);                                                              // SetGamePlayRecordingState
+        s->Ok(90);                                                              // EnableApplicationCrashReport
+        s->Ok(100);
+        s->Ok(101);
+        s->Ok(102);
+        s->Ok(121); // ClearUserChannel
+        s->On(123, [](Context& c) { c.Push<int32_t>(0); }); // GetPreviousProgramIndex
+        return s;
+    }
+
+    /// One library applet run: storage channels in and out, events, finished at Start.
+    struct LibraryApplet {
+        uint32_t id = 0;
+        std::deque<std::shared_ptr<Storage>> in, out;
+        bool completed = false;
+        std::shared_ptr<Event> state_changed, out_data;
+    };
+
+    std::shared_ptr<Service> LibraryAppletCreator() {
+        auto s = std::make_shared<Service>("ILibraryAppletCreator");
+        auto create = [this](Context& c) { // CreateLibraryApplet(applet id, mode)
+            auto la = std::make_shared<LibraryApplet>();
+            la->id = c.Pop<uint32_t>();
+            la->state_changed = std::make_shared<Event>(kernel, "library applet state");
+            la->out_data = std::make_shared<Event>(kernel, "library applet out data");
+            c.PushInterface(Accessor(la));
+        };
+        s->On(0, create);
+        s->On(3, create); // CreateLibraryAppletEx
+        s->On(10, [](Context& c) { // CreateStorage(size)
+            const auto size = c.Pop<int64_t>();
+            if (size <= 0 || size > (64 << 20)) return c.SetResult(128 | (503u << 9));
+            c.PushInterface(std::make_shared<Storage>(std::vector<uint8_t>(static_cast<size_t>(size))));
+        });
+        return s;
+    }
+
+    std::shared_ptr<Service> Accessor(std::shared_ptr<LibraryApplet> la) {
+        auto s = std::make_shared<Service>("ILibraryAppletAccessor");
+        s->On(0, [la](Context& c) { c.PushCopyObject(la->state_changed); }); // GetAppletStateChangedEvent
+        s->On(1, [la](Context& c) { c.Push<uint8_t>(la->completed); });       // IsCompleted
+        s->On(10, [this, la](Context& c) { Run(*la); (void)c; });             // Start
+        s->On(20, [la](Context&) {                                             // RequestExit
+            la->completed = true;
+            la->state_changed->Signal();
+        });
+        s->On(25, [la](Context&) { // Terminate
+            la->completed = true;
+            la->state_changed->Signal();
+        });
+        s->Ok(30); // GetResult: success
+        s->Ok(50); // SetOutOfFocusApplicationSuspendingEnabled
+        s->Ok(60); // PresetLibraryAppletGpuTimeSliceZero
+        s->On(100, [la](Context& c) { // PushInData(storage)
+            auto obj = c.InputObject(0);
+            if (!obj || obj->name != "IStorage") return c.SetResult(128 | (503u << 9));
+            la->in.push_back(std::static_pointer_cast<Storage>(obj));
+        });
+        auto pop = [this, la](Context& c) { // PopOutData / PopInteractiveOutData
+            {
+                // The caller is back in front: it gets a "resume" message when it asked for those (as the console does).
+                std::scoped_lock lk{mutex};
+                if (resume_notify) resume_pending = true;
+                UpdateEventLocked();
+            }
+            if (la->out.empty()) return c.SetResult(ResultNoDataInChannel);
+            auto st = la->out.front();
+            la->out.pop_front();
+            if (la->out.empty()) la->out_data->Clear();
+            c.PushInterface(st);
+        };
+        s->On(101, pop);
+        s->On(103, [](Context&) {}); // PushInteractiveInData: nothing reads it
+        s->On(104, [](Context& c) { c.SetResult(ResultNoDataInChannel); });
+        s->On(105, [la](Context& c) { c.PushCopyObject(la->out_data); }); // GetPopOutDataEvent
+        s->On(106, [this](Context& c) { c.PushCopyObject(std::make_shared<Event>(kernel, "interactive out")); });
+        s->On(120, [la](Context& c) { // GetLibraryAppletInfo
+            c.Push<uint32_t>(la->id);
+            c.Push<uint32_t>(0);
+        });
+        return s;
+    }
+
+    /// Runs a library applet at once (the PC game shows no system applet screens).
+    void Run(LibraryApplet& la) {
+        constexpr uint32_t Controller = 0x0C;
+        if (la.id == Controller) {
+            // In: common arguments, ControllerSupportArgPrivate (0x14 bytes: mode at 10, allowed styles at 12), then the user
+            // argument (header: min players, max players, ..., single mode at 5). Other modes (firmware update, strap guide)
+            // finish with the same result.
+            AppletHooks::ControllerArgs args;
+            if (hooks.log) {
+                std::string sizes;
+                for (const auto& st : la.in) sizes += std::to_string(st->data.size()) + " ";
+                hooks.log("controller applet input storages: " + sizes);
+            }
+            if (la.in.size() >= 2 && la.in[1]->data.size() >= 0x14) std::memcpy(&args.style_set, la.in[1]->data.data() + 12, 4);
+            if (la.in.size() >= 3 && la.in[2]->data.size() >= 7) {
+                args.min_players = static_cast<int8_t>(la.in[2]->data[0]);
+                args.max_players = static_cast<int8_t>(la.in[2]->data[1]);
+                args.single = la.in[2]->data[5] != 0;
+            }
+            AppletHooks::ControllerResult r{1, 0};
+            if (hooks.controller_applet) r = hooks.controller_applet(args);
+            struct {
+                int8_t player_count;
+                uint8_t pad[3];
+                uint32_t selected_id;
+                uint32_t result;
+            } info{r.player_count, {}, r.selected_id, 0};
+            std::vector<uint8_t> data(sizeof(info));
+            std::memcpy(data.data(), &info, sizeof(info));
+            la.out.push_back(std::make_shared<Storage>(std::move(data)));
+            la.out_data->Signal();
+        }
+        if (la.id == 0x13 || la.id == 0x14 || la.id == 0x17 || la.id == 0x18 || la.id == 0x19 || la.id == 0x35) RunWeb(la);
+        la.completed = true;
+        la.state_changed->Signal();
+    }
+
+    void RunWeb(LibraryApplet& la) {
+        uint32_t library_version = 0;
+        if (!la.in.empty() && la.in[0]->data.size() >= 12) std::memcpy(&library_version, la.in[0]->data.data() + 8, 4);
+        if (la.in.size() < 2 || la.in[1]->data.size() < 8) return;
+        const std::vector<uint8_t>& arg = la.in[1]->data;
+        AppletHooks::WebRequest req;
+        uint16_t entries = 0;
+        std::memcpy(&entries, arg.data(), 2);
+        std::memcpy(&req.shim_kind, arg.data() + 4, 4);
+        std::map<uint16_t, std::vector<uint8_t>> tlv;
+        size_t at = 8;
+        for (uint16_t i = 0; i < entries && at + 8 <= arg.size(); ++i) {
+            uint16_t type = 0, size = 0;
+            std::memcpy(&type, arg.data() + at, 2);
+            std::memcpy(&size, arg.data() + at + 2, 2);
+            at += 8;
+            if (at + size > arg.size()) break;
+            tlv[type].assign(arg.begin() + static_cast<std::ptrdiff_t>(at), arg.begin() + static_cast<std::ptrdiff_t>(at + size));
+            at += size;
+        }
+        auto str = [&](uint16_t t) {
+            const auto it = tlv.find(t);
+            return it == tlv.end() ? std::string{} : std::string(reinterpret_cast<const char*>(it->second.data()), strnlen(reinterpret_cast<const char*>(it->second.data()), it->second.size()));
+        };
+        auto raw = [&](uint16_t t, auto& v) {
+            if (const auto it = tlv.find(t); it != tlv.end()) std::memcpy(&v, it->second.data(), std::min(sizeof(v), it->second.size()));
+        };
+        req.url = str(0x1);
+        req.document_path = str(0x6);
+        raw(0x7, req.document_kind);
+        raw(req.document_kind == 3 ? 0x8 : 0x5, req.title_id);
+        std::pair<uint32_t, std::string> result{0, req.shim_kind == 5 ? req.url : req.document_path};
+        if ((req.shim_kind == 3 || req.shim_kind == 5) && hooks.web_applet) result = hooks.web_applet(req);
+        const bool tlv_output = (req.shim_kind == 4 && library_version >= 0x30000) || (req.shim_kind == 5 && library_version >= 0x80000) ||
+                                req.shim_kind == 8;
+        std::vector<uint8_t> out;
+        if (tlv_output) {
+            out.assign(0x2000, 0);
+            size_t o = 8;
+            uint16_t count = 0;
+            auto put = [&](uint16_t type, const void* data, size_t size) {
+                const uint16_t sz = static_cast<uint16_t>(size);
+                std::memcpy(out.data() + o, &type, 2);
+                std::memcpy(out.data() + o + 2, &sz, 2);
+                o += 8;
+                std::memcpy(out.data() + o, data, size);
+                o = (o + size + 7) & ~size_t{7};
+                ++count;
+            };
+            put(1, &result.first, 4);
+            put(2, result.second.c_str(), result.second.size() + 1);
+            const uint64_t len = result.second.size();
+            put(3, &len, 8);
+            std::memcpy(out.data(), &count, 2);
+            std::memcpy(out.data() + 4, &req.shim_kind, 4);
+        } else {
+            out.assign(0x1010, 0); // WebCommonReturnValue
+            std::memcpy(out.data(), &result.first, 4);
+            std::memcpy(out.data() + 8, result.second.data(), std::min<size_t>(result.second.size(), 0x1000));
+            const uint64_t len = result.second.size();
+            std::memcpy(out.data() + 0x1008, &len, 8);
+        }
+        la.out.push_back(std::make_shared<Storage>(std::move(out)));
+        la.out_data->Signal();
+    }
+
+    uint32_t PopMessageLocked() {
+        if (resume_pending) {
+            resume_pending = false;
+            return Resume;
+        }
+        if (exit_requested != exit_acknowledged) {
+            exit_acknowledged = exit_requested;
+            return Exit;
+        }
+        if (focus_notify && focus_changed) {
+            focus_changed = false;
+            return FocusStateChanged;
+        }
+        if (operation_mode_changed) {
+            operation_mode_changed = false;
+            return OperationModeChanged;
+        }
+        if (performance_mode_changed) {
+            performance_mode_changed = false;
+            return PerformanceModeChanged;
+        }
+        return 0;
+    }
+    void UpdateEventLocked() {
+        const bool pending = resume_pending || (exit_requested != exit_acknowledged) || (focus_notify && focus_changed) || operation_mode_changed ||
+                             performance_mode_changed;
+        if (pending) message_event->Signal();
+        else message_event->Clear();
+    }
+
+    NativeKernel& kernel;
+    AppletHooks hooks;
+    std::shared_ptr<Event> message_event, launchable;
+    std::mutex mutex;
+    // Notifications are on until the game turns them off; the focus state message is waiting when the game starts.
+    bool focus_notify = true, focus_changed = true;
+    bool operation_mode_notify = true, operation_mode_changed = false;
+    bool performance_mode_notify = true, performance_mode_changed = false;
+    bool exit_requested = false, exit_acknowledged = false;
+    bool preselected_popped = false;
+    bool resume_notify = false, resume_pending = false;
+};
+
+} // namespace KartRuntime::Services
diff --git a/src/kart_runtime/services/display.h b/src/kart_runtime/services/display.h
new file mode 100644
index 0000000000..dd18851237
--- /dev/null
+++ b/src/kart_runtime/services/display.h
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the display service ("vi:m", "vi:u", "vi:s") and its buffer queues ("IHOSBinderDriver")
+// (docs/NATIVE_ENGINE.md, "native services").
+//
+// The game opens the default display, opens its layer (made by the applet manager) and gets a "native window": an Android-style
+// parcel naming a buffer-queue binder. Its graphics driver connects to that queue and registers its window textures with it at
+// boot. Frames are not queued here: the engine's renderer takes the game's window acquire and present calls directly (native
+// graphics queue), so the queue only has to answer the setup transactions the way the console's does. Vsync: the display's event
+// is signalled once per refresh by the engine's display clock (`Vsync`).
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+class Display {
+public:
+    static constexpr uint32_t ResultOperationFailed = 114 | (6u << 9);
+    static constexpr uint32_t ResultNotFound = 114 | (7u << 9);
+    static constexpr uint32_t ResultPermissionDenied = 114 | (5u << 9);
+
+    explicit Display(NativeKernel& k) : kernel{k} {}
+
+    /// The applet manager's CreateManagedDisplayLayer: a layer on the default display.
+    uint64_t CreateLayer() {
+        std::scoped_lock lk{mutex};
+        const uint64_t id = next_layer++;
+        layers[id] = next_binder++;
+        return id;
+    }
+    /// Called once per display refresh.
+    void Vsync() {
+        std::scoped_lock lk{mutex};
+        for (auto& [id, e] : vsync_events) e->Signal();
+    }
+
+    std::shared_ptr<Service> Root(const char* name, uint32_t get_display_service_cmd) {
+        auto s = std::make_shared<Service>(name);
+        s->On(get_display_service_cmd, [this](Context& c) { c.PushInterface(ApplicationDisplayService()); });
+        return s;
+    }
+
+    /// Parcels: header {data size, data offset, objects size, objects offset}, then 4-byte aligned values.
+    class ParcelReader {
+    public:
+        explicit ParcelReader(const std::vector<uint8_t>& d) : data{d} {
+            uint32_t offset = 0;
+            if (data.size() >= 16) std::memcpy(&offset, data.data() + 4, 4);
+            pos = offset;
+            // Interface token: u32 strict-mode policy, u32 length, UTF-16 characters + terminator, aligned.
+            Read<uint32_t>();
+            const uint32_t len = Read<uint32_t>();
+            pos += (static_cast<size_t>(len) + 1) * 2;
+            pos = (pos + 3) & ~size_t{3};
+        }
+        template <typename T>
+        T Read() {
+            T v{};
+            if (pos + sizeof(T) <= data.size()) std::memcpy(&v, data.data() + pos, sizeof(T));
+            pos = (pos + sizeof(T) + 3) & ~size_t{3};
+            return v;
+        }
+        std::vector<uint8_t> ReadBytes(size_t n) {
+            std::vector<uint8_t> out(n);
+            if (pos + n <= data.size()) std::memcpy(out.data(), data.data() + pos, n);
+            pos = (pos + n + 3) & ~size_t{3};
+            return out;
+        }
+
+    private:
+        const std::vector<uint8_t>& data;
+        size_t pos = 0;
+    };
+    class ParcelWriter {
+    public:
+        template <typename T>
+        void Write(const T& v) {
+            const size_t at = data.size();
+            data.resize(at + ((sizeof(T) + 3) & ~size_t{3}));
+            std::memcpy(data.data() + at, &v, sizeof(T));
+        }
+        void WriteBytes(const std::vector<uint8_t>& b) {
+            const size_t at = data.size();
+            data.resize(at + ((b.size() + 3) & ~size_t{3}));
+            std::memcpy(data.data() + at, b.data(), b.size());
+        }
+        void WriteObjectSlot() { objects.resize(objects.size() + 4); }
+        std::vector<uint8_t> Serialize() const {
+            std::vector<uint8_t> out(16 + data.size() + objects.size());
+            const uint32_t h[4]{static_cast<uint32_t>(data.size()), 16, static_cast<uint32_t>(objects.size()),
+                                static_cast<uint32_t>(16 + data.size())};
+            std::memcpy(out.data(), h, 16);
+            std::memcpy(out.data() + 16, data.data(), data.size());
+            if (!objects.empty()) std::memcpy(out.data() + 16 + data.size(), objects.data(), objects.size());
+            return out;
+        }
+
+    private:
+        std::vector<uint8_t> data, objects;
+    };
+
+    /// One buffer queue (the producer side the game's graphics driver talks to).
+    struct Queue {
+        bool connected = false;
+        int32_t api = 0;
+        int32_t buffer_count = 0;
+        std::map<int32_t, std::vector<uint8_t>> buffers; ///< slot -> flattened graphic buffer as registered
+        int32_t next_slot = 0;
+        std::shared_ptr<Event> buffer_event;
+    };
+    /// Android status codes.
+    static constexpr int32_t NoError = 0, BadValue = -22, NoInit = -19;
+
+    std::vector<uint8_t> Transact(int32_t binder, uint32_t code, const std::vector<uint8_t>& in) {
+        std::scoped_lock lk{mutex};
+        Queue& q = queues[binder];
+        ParcelReader r{in};
+        ParcelWriter w;
+        int32_t status = NoError;
+        switch (code) {
+        case 10: { // Connect(listener?, api, producer controlled by app) -> QueueBufferOutput
+            r.Read<uint8_t>();
+            q.api = r.Read<int32_t>();
+            q.connected = true;
+            const uint32_t out[4]{1, 1, 0, 0}; // width, height (default 1x1), transform hint, pending buffers
+            w.Write(out);
+            break;
+        }
+        case 11: // Disconnect(api)
+            q.connected = false;
+            break;
+        case 14: { // SetPreallocatedBuffer(slot, object: valid flag, flattened size, buffer)
+            const int32_t slot = r.Read<int32_t>();
+            if (r.Read<uint32_t>() != 0) {
+                const int64_t size = r.Read<int64_t>();
+                if (size > 0 && size < 0x1000) q.buffers[slot] = r.ReadBytes(static_cast<size_t>(size));
+            } else {
+                q.buffers.erase(slot);
+            }
+            break;
+        }
+        case 1: { // RequestBuffer(slot) -> flattened buffer
+            const int32_t slot = r.Read<int32_t>();
+            const auto it = q.buffers.find(slot);
+            if (it == q.buffers.end()) {
+                w.Write<uint32_t>(0);
+            } else {
+                w.Write<uint32_t>(1);
+                w.Write<int64_t>(static_cast<int64_t>(it->second.size()));
+                w.WriteBytes(it->second);
+            }
+            break;
+        }
+        case 2: // SetBufferCount(count)
+            q.buffer_count = r.Read<int32_t>();
+            break;
+        case 3: { // DequeueBuffer(async, w, h, format, usage) -> slot, fence (frames are not queued here: slots in turn)
+            int32_t slot = 0;
+            if (!q.buffers.empty()) {
+                auto it = q.buffers.upper_bound(q.next_slot - 1);
+                if (it == q.buffers.end()) it = q.buffers.begin();
+                slot = it->first;
+                q.next_slot = slot + 1;
+            }
+            w.Write<int32_t>(slot);
+            w.Write<uint32_t>(1);                       // fence present
+            w.Write<int64_t>(0x24);                     // flattened size of a fence
+            std::array<uint8_t, 0x24> fence{};          // no sync points
+            std::memset(fence.data() + 4, 0xFF, 4);     // first point: invalid id
+            w.WriteBytes({fence.begin(), fence.end()});
+            break;
+        }
+        case 7: { // QueueBuffer(slot, input) -> output
+            const uint32_t out[4]{1, 1, 0, 0};
+            w.Write(out);
+            break;
+        }
+        case 8: // CancelBuffer
+            break;
+        case 9: { // Query(what)
+            const int32_t what = r.Read<int32_t>();
+            int32_t value = 0;
+            switch (what) {
+            case 0: value = 1; break;  // width (the queue's default 1x1)
+            case 1: value = 1; break;  // height
+            case 2: value = 1; break;  // format: RGBA8888
+            case 3: value = 0; break;  // min undequeued buffers (synchronous queue)
+            case 9: value = 0; break;  // consumer running behind
+            case 10: value = 0; break; // consumer usage bits
+            case 11: value = 0; break; // sticky transform
+            case 12: value = 3; break; // (the emulator answered its max buffer count here)
+            default: status = BadValue; break;
+            }
+            w.Write(value);
+            break;
+        }
+        case 13: // GetBufferHistory
+            break;
+        default:
+            status = BadValue;
+            if (on_unknown_transaction) on_unknown_transaction(code);
+            break;
+        }
+        w.Write(status);
+        return w.Serialize();
+    }
+
+    std::function<void(uint32_t)> on_unknown_transaction;
+
+private:
+    std::shared_ptr<Service> ApplicationDisplayService() {
+        auto s = std::make_shared<Service>("IApplicationDisplayService");
+        s->On(100, [this](Context& c) { c.PushInterface(Binder()); });                                   // GetRelayService
+        s->On(101, [](Context& c) { c.PushInterface(std::make_shared<Service>("ISystemDisplayService")); });
+        s->On(102, [](Context& c) { c.PushInterface(std::make_shared<Service>("IManagerDisplayService")); });
+        s->On(103, [this](Context& c) { c.PushInterface(Binder()); });                                   // GetIndirectDisplayTransactionService
+        s->On(1010, [this](Context& c) { // OpenDisplay(name)
+            auto name = c.Pop<std::array<char, 0x40>>();
+            name.back() = 0;
+            const auto id = DisplayId(name.data());
+            if (id < 0) return c.SetResult(ResultNotFound);
+            c.Push<uint64_t>(static_cast<uint64_t>(id));
+        });
+        s->On(1011, [](Context& c) { c.Push<uint64_t>(0); }); // OpenDefaultDisplay
+        s->Ok(1020);                                          // CloseDisplay
+        s->Ok(1101);                                          // SetDisplayEnabled
+        s->On(1102, [](Context& c) {                          // GetDisplayResolution
+            c.Push<int64_t>(1920);
+            c.Push<int64_t>(1080);
+        });
+        s->On(2020, [this](Context& c) { // OpenLayer(display name, layer id, aruid) -> native window parcel
+            c.Pop<std::array<char, 0x40>>();
+            const auto layer = c.Pop<uint64_t>();
+            int32_t binder = 0;
+            {
+                std::scoped_lock lk{mutex};
+                const auto it = layers.find(layer);
+                if (it == layers.end()) return c.SetResult(ResultNotFound);
+                binder = it->second;
+            }
+            c.Push<uint64_t>(WriteNativeWindow(c, binder));
+        });
+        s->Ok(2021); // CloseLayer
+        s->On(2030, [this](Context& c) { // CreateStrayLayer(flags, display) -> layer id, parcel
+            const uint64_t layer = CreateLayer();
+            int32_t binder = 0;
+            {
+                std::scoped_lock lk{mutex};
+                binder = layers[layer];
+            }
+            c.Push<uint64_t>(layer);
+            c.Push<uint64_t>(WriteNativeWindow(c, binder));
+        });
+        s->Ok(2031);                                                      // DestroyStrayLayer
+        s->On(2101, [](Context& c) {                                      // SetLayerScalingMode(mode, layer)
+            const auto mode = c.Pop<uint32_t>();
+            if (mode > 4) c.SetResult(ResultOperationFailed);
+        });
+        s->On(2102, [](Context& c) { // ConvertScalingMode
+            static constexpr uint64_t table[]{0, 3, 1, 2, 4};
+            const auto mode = c.Pop<uint32_t>();
+            if (mode > 4) return c.SetResult(ResultOperationFailed);
+            c.Push<uint64_t>(table[mode]);
+        });
+        s->On(5202, [this](Context& c) { // GetDisplayVsyncEvent(display): once per display
+            const auto display = c.Pop<uint64_t>();
+            std::scoped_lock lk{mutex};
+            if (vsync_events.contains(display)) return c.SetResult(ResultPermissionDenied);
+            auto e = std::make_shared<Event>(kernel, "vsync");
+            vsync_events[display] = e;
+            c.PushCopyObject(e);
+        });
+        return s;
+    }
+
+    std::shared_ptr<Service> Binder() {
+        auto s = std::make_shared<Service>("IHOSBinderDriver");
+        auto transact = [this](Context& c) { // TransactParcel(binder, code, in parcel, out parcel, flags)
+            const auto binder = c.Pop<int32_t>();
+            const auto code = c.Pop<uint32_t>();
+            const auto in = c.ReadBuffer(0);
+            const auto out = Transact(binder, code, in);
+            c.WriteBuffer(out.data(), std::min(out.size(), c.WriteBufferSize(0)), 0);
+        };
+        s->On(0, transact);
+        s->On(3, transact); // TransactParcelAuto
+        s->Ok(1);           // AdjustRefcount
+        s->On(2, [this](Context& c) { // GetNativeHandle(binder, type): the buffer-available event (always available here)
+            const auto binder = c.Pop<int32_t>();
+            std::scoped_lock lk{mutex};
+            Queue& q = queues[binder];
+            if (!q.buffer_event) {
+                q.buffer_event = std::make_shared<Event>(kernel, "buffer available");
+                q.buffer_event->Signal();
+            }
+            c.PushCopyObject(q.buffer_event);
+        });
+        return s;
+    }
+
+    static uint64_t WriteNativeWindow(Context& c, int32_t binder) {
+        struct {
+            uint32_t magic = 2, process_id = 1;
+            uint64_t id = 0;
+            uint32_t pad0[2]{};
+            std::array<char, 8> dispdrv{'d', 'i', 's', 'p', 'd', 'r', 'v', '\0'};
+            uint32_t pad1[2]{};
+        } window;
+        static_assert(sizeof(window) == 0x28);
+        window.id = static_cast<uint64_t>(binder);
+        ParcelWriter p;
+        p.Write(window);
+        p.WriteObjectSlot();
+        const auto bytes = p.Serialize();
+        c.WriteBuffer(bytes.data(), std::min(bytes.size(), c.WriteBufferSize(0)), 0);
+        return bytes.size();
+    }
+
+    static int DisplayId(const std::string& name) {
+        static const char* names[]{"Default", "External", "Edid", "Internal", "Null"};
+        for (int i = 0; i < 5; ++i)
+            if (name == names[i]) return i;
+        return -1;
+    }
+
+    NativeKernel& kernel;
+    std::mutex mutex;
+    uint64_t next_layer = 1;
+    int32_t next_binder = 1;
+    std::map<uint64_t, int32_t> layers; ///< layer id -> binder id
+    std::map<int32_t, Queue> queues;
+    std::map<uint64_t, std::shared_ptr<Event>> vsync_events;
+};
+
+} // namespace KartRuntime::Services
diff --git a/src/kart_runtime/services/filesystem.h b/src/kart_runtime/services/filesystem.h
new file mode 100644
index 0000000000..decd1fcf75
--- /dev/null
+++ b/src/kart_runtime/services/filesystem.h
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the file system service ("fsp-srv") for what the game opens through it after its content moved to the
+// native file system: save data (IFileSystem / IFile / IDirectory) and system archives (IStorage: fonts, Mii resources)
+// (docs/NATIVE_ENGINE.md, "native services").
+//
+// The service framing, paths, buffers and results are here; the storage itself comes from the engine (`FsBackend`): its save
+// folders and its archive readers.
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+class FsFile {
+public:
+    virtual ~FsFile() = default;
+    virtual uint32_t Read(int64_t offset, void* out, uint64_t size, uint64_t* out_read) = 0;
+    virtual uint32_t Write(int64_t offset, const void* in, uint64_t size, bool flush) = 0;
+    virtual uint32_t Flush() = 0;
+    virtual uint32_t SetSize(int64_t size) = 0;
+    virtual uint32_t GetSize(int64_t* out) = 0;
+};
+
+class FsDirectory {
+public:
+    virtual ~FsDirectory() = default;
+    /// Up to `max` 0x310-byte entries into `out`.
+    virtual uint32_t Read(uint8_t* out, int64_t max, int64_t* out_count) = 0;
+    virtual uint32_t GetEntryCount(int64_t* out) = 0;
+};
+
+class FsFileSystem {
+public:
+    virtual ~FsFileSystem() = default;
+    virtual uint32_t CreateFile(const std::string& path, int64_t size) = 0;
+    virtual uint32_t DeleteFile(const std::string& path) = 0;
+    virtual uint32_t CreateDirectory(const std::string& path) = 0;
+    virtual uint32_t DeleteDirectory(const std::string& path) = 0;
+    virtual uint32_t DeleteDirectoryRecursively(const std::string& path) = 0;
+    virtual uint32_t CleanDirectoryRecursively(const std::string& path) = 0;
+    virtual uint32_t RenameFile(const std::string& from, const std::string& to) = 0;
+    virtual uint32_t GetEntryType(const std::string& path, uint32_t* out) = 0;
+    virtual uint32_t OpenFile(const std::string& path, uint32_t mode, std::shared_ptr<FsFile>* out) = 0;
+    virtual uint32_t OpenDirectory(const std::string& path, uint32_t mode, std::shared_ptr<FsDirectory>* out) = 0;
+    virtual uint32_t Commit() = 0;
+    virtual uint32_t GetFreeSpace(int64_t* out) = 0;
+    virtual uint32_t GetTotalSpace(int64_t* out) = 0;
+    virtual uint32_t GetFileTimeStampRaw(const std::string& path, std::array<uint8_t, 0x20>* out) = 0;
+};
+
+class FsStorage {
+public:
+    virtual ~FsStorage() = default;
+    virtual uint32_t Read(int64_t offset, void* out, uint64_t size) = 0;
+    virtual uint32_t GetSize(int64_t* out) = 0;
+};
+
+class FsBackend {
+public:
+    virtual ~FsBackend() = default;
+    /// SetCurrentProcess
+    virtual uint32_t SetProcess(uint64_t pid) = 0;
+    /// OpenSaveDataFileSystem(space id, 0x40-byte save data attribute)
+    virtual uint32_t OpenSaveData(uint8_t space, const std::array<uint8_t, 0x40>& attribute, std::shared_ptr<FsFileSystem>* out) = 0;
+    /// OpenDataStorageByDataId(storage id, data id): a system archive (fonts, Mii data)
+    virtual uint32_t OpenDataStorage(uint8_t storage_id, uint64_t data_id, std::shared_ptr<FsStorage>* out) = 0;
+    /// CreateSaveDataFileSystem(attribute, creation info, meta info)
+    virtual uint32_t CreateSaveData(const std::array<uint8_t, 0x40>& attribute, const std::array<uint8_t, 0x40>& creation) = 0;
+};
+
+class FileSystemService {
+public:
+    explicit FileSystemService(std::shared_ptr<FsBackend> b) : backend{std::move(b)} {}
+
+    std::shared_ptr<Service> Root(const char* name) {
+        auto s = std::make_shared<Service>(name);
+        s->serialize = false;
+        s->On(1, [this](Context& c) { c.SetResult(backend->SetProcess(c.Pid())); }); // SetCurrentProcess (the sender's process)
+        s->On(22, [this](Context& c) { // CreateSaveDataFileSystem(creation info, attribute, meta) - the emulator's order
+            const auto creation = c.Pop<std::array<uint8_t, 0x40>>();
+            const auto attr = c.Pop<std::array<uint8_t, 0x40>>();
+            c.SetResult(backend->CreateSaveData(attr, creation));
+        });
+        auto open_save = [this](Context& c) { // OpenSaveDataFileSystem(space id u8, attribute)
+            const auto space = c.Pop<uint8_t>();
+            c.args.Skip(7);
+            const auto attr = c.Pop<std::array<uint8_t, 0x40>>();
+            std::shared_ptr<FsFileSystem> fs;
+            if (const uint32_t r = backend->OpenSaveData(space, attr, &fs); r != 0) return c.SetResult(r);
+            c.PushInterface(FileSystem(fs));
+        };
+        s->On(51, open_save);
+        s->On(53, open_save); // OpenReadOnlySaveDataFileSystem
+        s->On(202, [this](Context& c) { // OpenDataStorageByDataId(storage id u8, data id u64)
+            const auto storage = c.Pop<uint8_t>();
+            const auto id = c.Pop<uint64_t>();
+            std::shared_ptr<FsStorage> st;
+            if (const uint32_t r = backend->OpenDataStorage(storage, id, &st); r != 0) return c.SetResult(r);
+            c.PushInterface(Storage(st));
+        });
+        s->On(27, [](Context& c) { c.Push<uint8_t>(0); }); // IsExFatSupported
+        s->On(631, [](Context& c) { c.Push<uint8_t>(0); }); // IsSdCardAccessible
+        s->Ok(1003);                                          // DisableAutoSaveDataCreation
+        s->Ok(1004);                                          // SetGlobalAccessLogMode
+        s->On(1005, [](Context& c) { c.Push<uint32_t>(0); }); // GetGlobalAccessLogMode: off
+        s->Ok(1006);                                          // OutputAccessLogToSdCard
+        s->On(1011, [](Context& c) { c.Push<uint32_t>(0); }); // GetProgramIndexForAccessLog (index, count)
+        s->Ok(1016);                                          // FlushAccessLogOnSdCard
+        return s;
+    }
+
+    /// The path argument: a 0x301-byte string in the first X (pointer) buffer.
+    static std::string Path(Context& c, size_t i = 0) {
+        const auto raw = c.ReadBuffer(i);
+        return std::string(reinterpret_cast<const char*>(raw.data()), strnlen(reinterpret_cast<const char*>(raw.data()), raw.size()));
+    }
+
+    std::shared_ptr<Service> FileSystem(std::shared_ptr<FsFileSystem> fs) {
+        auto s = std::make_shared<Service>("IFileSystem");
+        s->On(0, [fs](Context& c) { // CreateFile(option, size)
+            c.Pop<int32_t>();
+            const auto size = c.Pop<int64_t>();
+            c.SetResult(fs->CreateFile(Path(c), size));
+        });
+        s->On(1, [fs](Context& c) { c.SetResult(fs->DeleteFile(Path(c))); });
+        s->On(2, [fs](Context& c) { c.SetResult(fs->CreateDirectory(Path(c))); });
+        s->On(3, [fs](Context& c) { c.SetResult(fs->DeleteDirectory(Path(c))); });
+        s->On(4, [fs](Context& c) { c.SetResult(fs->DeleteDirectoryRecursively(Path(c))); });
+        s->On(5, [fs](Context& c) { c.SetResult(fs->RenameFile(Path(c, 0), Path(c, 1))); });
+        s->On(7, [fs](Context& c) { // GetEntryType
+            uint32_t type = 0;
+            if (const uint32_t r = fs->GetEntryType(Path(c), &type); r != 0) return c.SetResult(r);
+            c.Push<uint32_t>(type);
+        });
+        s->On(8, [this, fs](Context& c) { // OpenFile(mode)
+            const auto mode = c.Pop<uint32_t>();
+            std::shared_ptr<FsFile> f;
+            if (const uint32_t r = fs->OpenFile(Path(c), mode, &f); r != 0) return c.SetResult(r);
+            c.PushInterface(File(f));
+        });
+        s->On(9, [this, fs](Context& c) { // OpenDirectory(mode)
+            const auto mode = c.Pop<uint32_t>();
+            std::shared_ptr<FsDirectory> d;
+            if (const uint32_t r = fs->OpenDirectory(Path(c), mode, &d); r != 0) return c.SetResult(r);
+            c.PushInterface(Directory(d));
+        });
+        s->On(10, [fs](Context& c) { c.SetResult(fs->Commit()); });
+        s->On(11, [fs](Context& c) {
+            int64_t v = 0;
+            c.SetResult(fs->GetFreeSpace(&v));
+            c.Push(v);
+        });
+        s->On(12, [fs](Context& c) {
+            int64_t v = 0;
+            c.SetResult(fs->GetTotalSpace(&v));
+            c.Push(v);
+        });
+        s->On(13, [fs](Context& c) { c.SetResult(fs->CleanDirectoryRecursively(Path(c))); });
+        s->On(14, [fs](Context& c) {
+            std::array<uint8_t, 0x20> t{};
+            if (const uint32_t r = fs->GetFileTimeStampRaw(Path(c), &t); r != 0) return c.SetResult(r);
+            c.Push(t);
+        });
+        return s;
+    }
+
+    static std::shared_ptr<Service> File(std::shared_ptr<FsFile> f) {
+        auto s = std::make_shared<Service>("IFile");
+        s->On(0, [f](Context& c) { // Read(option, offset, size) -> bytes read
+            c.Pop<uint32_t>();
+            const auto offset = c.Pop<int64_t>();
+            const auto size = c.Pop<int64_t>();
+            if (offset < 0 || size < 0) return c.SetResult(2 | (6061u << 9)); // fs: invalid offset / size
+            const size_t want = std::min<size_t>(static_cast<size_t>(size), c.WriteBufferSize(0));
+            std::vector<uint8_t> buf(want);
+            uint64_t got = 0;
+            if (const uint32_t r = f->Read(offset, buf.data(), want, &got); r != 0) return c.SetResult(r);
+            if (got) c.WriteBuffer(buf.data(), got, 0);
+            c.Push<int64_t>(static_cast<int64_t>(got));
+        });
+        s->On(1, [f](Context& c) { // Write(option, offset, size)
+            const auto option = c.Pop<uint32_t>();
+            const auto offset = c.Pop<int64_t>();
+            const auto size = c.Pop<int64_t>();
+            auto data = c.ReadBuffer(0);
+            if (offset < 0 || size < 0) return c.SetResult(2 | (6061u << 9));
+            data.resize(std::min<size_t>(data.size(), static_cast<size_t>(size)));
+            c.SetResult(f->Write(offset, data.data(), data.size(), (option & 1) != 0));
+        });
+        s->On(2, [f](Context& c) { c.SetResult(f->Flush()); });
+        s->On(3, [f](Context& c) { c.SetResult(f->SetSize(c.Pop<int64_t>())); });
+        s->On(4, [f](Context& c) {
+            int64_t v = 0;
+            if (const uint32_t r = f->GetSize(&v); r != 0) return c.SetResult(r);
+            c.Push(v);
+        });
+        return s;
+    }
+
+    static std::shared_ptr<Service> Directory(std::shared_ptr<FsDirectory> d) {
+        auto s = std::make_shared<Service>("IDirectory");
+        s->On(0, [d](Context& c) { // Read -> entry count
+            const int64_t max = static_cast<int64_t>(c.WriteBufferSize(0) / 0x310);
+            std::vector<uint8_t> buf(static_cast<size_t>(max) * 0x310);
+            int64_t n = 0;
+            if (const uint32_t r = d->Read(buf.data(), max, &n); r != 0) return c.SetResult(r);
+            if (n) c.WriteBuffer(buf.data(), static_cast<size_t>(n) * 0x310, 0);
+            c.Push<int64_t>(n);
+        });
+        s->On(1, [d](Context& c) {
+            int64_t n = 0;
+            if (const uint32_t r = d->GetEntryCount(&n); r != 0) return c.SetResult(r);
+            c.Push(n);
+        });
+        return s;
+    }
+
+    static std::shared_ptr<Service> Storage(std::shared_ptr<FsStorage> st) {
+        auto s = std::make_shared<Service>("IStorage");
+        s->serialize = false;
+        s->On(0, [st](Context& c) { // Read(offset, length)
+            const auto offset = c.Pop<int64_t>();
+            const auto length = c.Pop<int64_t>();
+            if (offset < 0 || length < 0) return c.SetResult(2 | (6061u << 9));
+            const size_t want = std::min<size_t>(static_cast<size_t>(length), c.WriteBufferSize(0));
+            std::vector<uint8_t> buf(want);
+            if (const uint32_t r = st->Read(offset, buf.data(), want); r != 0) return c.SetResult(r);
+            c.WriteBuffer(buf.data(), want, 0);
+        });
+        s->On(4, [st](Context& c) {
+            int64_t v = 0;
+            if (const uint32_t r = st->GetSize(&v); r != 0) return c.SetResult(r);
+            c.Push<uint64_t>(static_cast<uint64_t>(v));
+        });
+        return s;
+    }
+
+private:
+    std::shared_ptr<FsBackend> backend;
+};
+
+} // namespace KartRuntime::Services
diff --git a/src/kart_runtime/services/system.h b/src/kart_runtime/services/system.h
new file mode 100644
index 0000000000..bbb135c5a5
--- /dev/null
+++ b/src/kart_runtime/services/system.h
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the small system services a game opens at boot (docs/NATIVE_ENGINE.md, "native services"): settings
+// ("set"), performance mode ("apm"), parental controls ("pctl*"), play reports ("prepo:*"), friends ("friend:*"), the system
+// log ("lm") and multimedia clock requests ("mm:u"). On a PC there is nothing behind most of them: the answers are the ones an
+// unrestricted, offline console gives.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+struct SystemConfig {
+    std::string language = "en-US"; ///< the console's language (a code from LanguageCodes)
+    int region = 1;                  ///< 0 Japan, 1 USA, 2 Europe, 3 Australia, 4 HongKongTaiwanKorea, 5 China
+    bool docked = true;              ///< operation mode (docked = the higher quality)
+};
+
+/// The console's language list, in its order ("set" GetAvailableLanguageCodes).
+inline const std::vector<std::string>& LanguageCodes() {
+    static const std::vector<std::string> codes{"ja", "en-US", "fr", "de", "it", "es", "zh-CN", "ko", "nl", "pt",
+                                                "ru", "zh-TW", "en-GB", "fr-CA", "es-419", "zh-Hans", "zh-Hant", "pt-BR", "pl", "th"};
+    return codes;
+}
+/// A language code as the console passes it: the characters in a u64, first character lowest.
+inline uint64_t PackLanguage(const std::string& code) {
+    uint64_t v = 0;
+    std::memcpy(&v, code.data(), std::min<size_t>(code.size(), 8));
+    return v;
+}
+
+inline std::shared_ptr<Service> MakeSettings(const SystemConfig& cfg) {
+    auto s = std::make_shared<Service>("set");
+    s->On(0, [cfg](Context& c) { c.Push<uint64_t>(PackLanguage(cfg.language)); }); // GetLanguageCode
+    auto list = [](Context& c, size_t max) {
+        std::vector<uint64_t> codes;
+        for (const auto& l : LanguageCodes()) codes.push_back(PackLanguage(l));
+        const size_t n = std::min({codes.size(), max, c.WriteBufferSize(0) / 8});
+        c.WriteBuffer(codes.data(), n * 8, 0);
+        c.Push<int32_t>(static_cast<int32_t>(n));
+    };
+    s->On(1, [list](Context& c) { list(c, 0xF); });  // GetAvailableLanguageCodes (pre-4.0 list size)
+    s->On(5, [list](Context& c) { list(c, 0x40); }); // GetAvailableLanguageCodes2
+    s->On(2, [](Context& c) { // MakeLanguageCode(index)
+        const auto i = c.Pop<uint32_t>();
+        if (i >= LanguageCodes().size()) return c.SetResult(105 | (625u << 9)); // set: out of range
+        c.Push<uint64_t>(PackLanguage(LanguageCodes()[i]));
+    });
+    s->On(3, [](Context& c) { c.Push<int32_t>(0xF); });  // GetAvailableLanguageCodeCount
+    s->On(6, [](Context& c) { c.Push<int32_t>(static_cast<int32_t>(LanguageCodes().size())); }); // ...Count2
+    s->On(4, [cfg](Context& c) { c.Push<int32_t>(cfg.region); }); // GetRegionCode
+    s->On(8, [](Context& c) { c.Push<int32_t>(0); });            // GetQuestFlag
+    return s;
+}
+
+inline std::shared_ptr<Service> MakeApm(const char* name) {
+    auto s = std::make_shared<Service>(name);
+    auto session = [] {
+        auto ss = std::make_shared<Service>("apm ISession");
+        auto config = std::make_shared<std::map<uint32_t, uint32_t>>();
+        ss->On(0, [config](Context& c) { // SetPerformanceConfiguration(mode, config)
+            const auto mode = c.Pop<uint32_t>();
+            (*config)[mode] = c.Pop<uint32_t>();
+        });
+        ss->On(1, [config](Context& c) { // GetPerformanceConfiguration(mode)
+            const auto mode = c.Pop<uint32_t>();
+            const auto it = config->find(mode);
+            c.Push<uint32_t>(it != config->end() ? it->second : (mode == 1 ? 0x92220008u : 0x92220007u));
+        });
+        ss->Ok(2); // SetCpuOverclockEnabled
+        return ss;
+    };
+    s->On(0, [session](Context& c) { c.PushInterface(session()); }); // OpenSession
+    s->On(1, [](Context& c) { c.Push<uint32_t>(1); });             // GetPerformanceMode: boost (docked)
+    s->On(6, [](Context& c) { c.Push<uint8_t>(0); });              // IsCpuOverclockEnabled
+    return s;
+}
+
+inline std::shared_ptr<Service> MakeParentalControl(const char* name) {
+    auto s = std::make_shared<Service>(name);
+    auto service = [] {
+        auto ps = std::make_shared<Service>("IParentalControlService");
+        ps->Ok(1);                                                  // Initialize
+        ps->Ok(1001);                                               // CheckFreeCommunicationPermission
+        ps->Ok(1002);                                               // ConfirmLaunchApplicationPermission
+        ps->Ok(1013);                                               // ConfirmStereoVisionPermission
+        ps->Ok(1018);                                               // IsFreeCommunicationAvailable (result only: available)
+        ps->On(1031, [](Context& c) { c.Push<uint8_t>(0); });     // IsRestrictionEnabled: no
+        ps->Ok(1061);                                               // ConfirmStereoVisionRestrictionConfigurable
+        ps->Ok(1064);                                               // ResetConfirmedStereoVisionPermission
+        ps->On(1065, [](Context& c) { c.Push<uint8_t>(1); });     // IsStereoVisionPermitted: yes
+        return ps;
+    };
+    s->On(0, [service](Context& c) { c.PushInterface(service()); }); // CreateService
+    s->On(1, [service](Context& c) { c.PushInterface(service()); }); // CreateServiceWithoutInitialize
+    return s;
+}
+
+/// Play reports: accepted and dropped (the console uploads them; this is an offline PC game).
+inline std::shared_ptr<Service> MakePlayReport(const char* name) {
+    auto s = std::make_shared<Service>(name);
+    for (uint32_t cmd : {10100u, 10101u, 10102u, 10103u, 10104u, 10105u, 10106u, 10107u, 10200u, 10201u, 10300u, 10400u}) s->Ok(cmd);
+    return s;
+}
+
+inline std::shared_ptr<Service> MakeFriends(const char* name) {
+    auto s = std::make_shared<Service>(name);
+    s->On(0, [](Context& c) { // CreateFriendService
+        auto f = std::make_shared<Service>("IFriendService");
+        // Local wireless play records who the player met: accepted and dropped, as suyu does (the game shows "a communication
+        // error has occurred" when these fail).
+        f->Ok(10700); // GetPlayHistoryRegistrationKey(local play, user) -> key buffer (left as the game passed it)
+        f->Ok(10701); // GetPlayHistoryRegistrationKeyWithNetworkServiceAccountId
+        f->Ok(10702); // AddPlayHistory
+        c.PushInterface(f);
+    });
+    s->On(1, [](Context& c) { c.PushInterface(std::make_shared<Service>("INotificationService")); }); // CreateNotificationService
+    s->Ok(2); // CreateDaemonSuspendSessionService
+    return s;
+}
+
+/// The network interface service ("nifm:u", "nifm:a", "nifm:s"). The game's online mode needs Nintendo's servers, which a
+/// recompiled game cannot use, so internet requests are refused at once with the console's "network communication disabled"
+/// result: the game shows its "can't connect" message and goes back to the main menu. (Without the service the game asked the
+/// service manager for it, got "not registered" and froze on its communication-error screen.) Playing together over the internet
+/// is the game's Wireless Play over a multiplayer room, which does not go through this service.
+inline std::shared_ptr<Service> MakeNetwork(NativeKernel& kernel, const char* name) {
+    constexpr uint32_t PendingConnection = 110 | (111u << 9);           // 2110-0111
+    constexpr uint32_t CommunicationDisabled = 110 | (1111u << 9);      // 2110-1111
+    const auto request = [&kernel, CommunicationDisabled](Context& c) { // CreateRequest(requirement preset) -> IRequest
+        struct State {
+            uint32_t state = 1; // NotSubmitted / Invalid
+            bool submitted = false;
+            std::shared_ptr<Event> e1, e2;
+        };
+        auto st = std::make_shared<State>();
+        st->e1 = std::make_shared<Event>(kernel, "nifm request");
+        st->e2 = std::make_shared<Event>(kernel, "nifm request 2");
+        auto r = std::make_shared<Service>("IRequest");
+        // The console's sequence for a network that is not there (as suyu answers it with no connection): Submit puts the request
+        // on hold; the first GetResult says "pending" and turns it invalid (state 1, events signalled); GetResult then gives the
+        // final error. Refusing it straight from Submit made the SDK abort in GetRequestState (2001-0114).
+        const auto update = [st](uint32_t state) {
+            st->state = state;
+            st->e1->Signal();
+            st->e2->Signal();
+        };
+        r->On(0, [st](Context& c2) { c2.Push<uint32_t>(st->state); }); // GetRequestState
+        r->On(1, [st, update, CommunicationDisabled](Context& c2) {    // GetResult
+            if (st->state == 2) { // on hold: decided now - no connection
+                update(1);
+                return c2.SetResult(110 | (111u << 9)); // pending connection (2110-0111)
+            }
+            if (st->state == 3) return; // accepted (never here)
+            c2.SetResult(CommunicationDisabled);
+        });
+        r->On(2, [st](Context& c2) { // GetSystemEventReadableHandles
+            c2.PushCopyObject(st->e1);
+            c2.PushCopyObject(st->e2);
+        });
+        r->Ok(3); // Cancel
+        r->On(4, [st, update](Context&) { // Submit
+            if (!st->submitted || st->state == 1) {
+                st->submitted = true;
+                update(2); // on hold
+            }
+        });
+        for (uint32_t cmd : {6u, 9u, 10u, 11u, 12u, 13u, 14u, 15u, 16u, 17u, 23u}) r->Ok(cmd); // requirement setters
+        r->On(21, [](Context& c2) { // GetAppletInfo: no applet to show
+            std::vector<uint8_t> zero(c2.WriteBufferSize(0));
+            if (!zero.empty()) c2.WriteBuffer(zero.data(), zero.size(), 0);
+            c2.Push<uint32_t>(0);
+            c2.Push<uint32_t>(0);
+            c2.Push<uint32_t>(0);
+        });
+        c.PushInterface(r);
+    };
+    const auto general = [request, PendingConnection, CommunicationDisabled]() {
+        auto g = std::make_shared<Service>("IGeneralService");
+        g->On(1, [](Context& c) { c.Push<uint64_t>(1); }); // GetClientId (non-zero)
+        g->On(2, [](Context& c) {                          // CreateScanRequest: scans find nothing
+            auto scan = std::make_shared<Service>("IScanRequest");
+            scan->Ok(0);                                                       // Submit
+            scan->On(1, [](Context& c2) { c2.Push<uint8_t>(0); });             // IsProcessing
+            scan->Ok(2);                                                       // GetResult
+            c.PushInterface(scan);
+        });
+        g->On(4, request);
+        g->On(5, [CommunicationDisabled](Context& c) { c.SetResult(CommunicationDisabled); }); // GetCurrentNetworkProfile
+        g->On(12, [CommunicationDisabled](Context& c) { c.SetResult(CommunicationDisabled); }); // GetCurrentIpAddress
+        g->On(17, [](Context& c) { c.Push<uint8_t>(1); }); // IsWirelessCommunicationEnabled (local wireless works)
+        g->On(18, [CommunicationDisabled](Context& c) { c.SetResult(CommunicationDisabled); }); // GetInternetConnectionStatus
+        g->On(20, [](Context& c) { c.Push<uint8_t>(0); }); // IsEthernetCommunicationEnabled
+        g->On(21, [](Context& c) { c.Push<uint8_t>(0); }); // IsAnyInternetRequestAccepted
+        g->On(22, [](Context& c) { c.Push<uint8_t>(0); }); // IsAnyForegroundRequestAccepted
+        (void)PendingConnection;
+        return g;
+    };
+    auto s = std::make_shared<Service>(name);
+    s->On(4, [general](Context& c) { c.PushInterface(general()); }); // CreateGeneralServiceOld
+    s->On(5, [general](Context& c) { c.PushInterface(general()); }); // CreateGeneralService(pid)
+    return s;
+}
+
+/// The secure random number service ("csrng"): GenerateRandomBytes fills the output buffer from the host's random source.
+inline std::shared_ptr<Service> MakeRandom() {
+    auto s = std::make_shared<Service>("csrng");
+    s->On(0, [](Context& c) {
+        static std::mutex m;
+        static std::random_device device;
+        std::vector<uint8_t> out(c.WriteBufferSize(0));
+        {
+            std::scoped_lock lk{m};
+            for (size_t i = 0; i < out.size(); i += 4) {
+                const uint32_t v = device();
+                std::memcpy(out.data() + i, &v, std::min<size_t>(4, out.size() - i));
+            }
+        }
+        c.WriteBuffer(out.data(), out.size(), 0);
+    });
+    return s;
+}
+
+/// The system log: the game's log lines are dropped (the engine has its own log).
+inline std::shared_ptr<Service> MakeLog() {
+    auto s = std::make_shared<Service>("lm");
+    s->On(0, [](Context& c) { // OpenLogger
+        auto logger = std::make_shared<Service>("ILogger");
+        logger->Ok(0); // Log
+        logger->Ok(1); // SetDestination
+        c.PushInterface(logger);
+    });
+    return s;
+}
+
+/// Multimedia clock requests: remembered and answered back (the host sets its own clocks).
+inline std::shared_ptr<Service> MakeMultimedia() {
+    struct State {
+        std::mutex m;
+        uint32_t next = 1;
+        std::map<uint32_t, uint32_t> min; ///< by request id
+        std::map<uint32_t, uint32_t> old; ///< by module (the old commands)
+    };
+    auto st = std::make_shared<State>();
+    auto s = std::make_shared<Service>("mm:u");
+    s->Ok(0); // InitializeOld
+    s->Ok(1); // FinalizeOld
+    s->On(2, [st](Context& c) { // SetAndWaitOld(module, min, max)
+        const auto module = c.Pop<uint32_t>();
+        std::scoped_lock lk{st->m};
+        st->old[module] = c.Pop<uint32_t>();
+    });
+    s->On(3, [st](Context& c) { // GetOld(module)
+        const auto module = c.Pop<uint32_t>();
+        std::scoped_lock lk{st->m};
+        c.Push<uint32_t>(st->old.contains(module) ? st->old[module] : 0);
+    });
+    s->On(4, [st](Context& c) { // Initialize(module, priority, clear mode) -> id
+        std::scoped_lock lk{st->m};
+        const uint32_t id = st->next++;
+        st->min[id] = 0;
+        c.Push<uint32_t>(id);
+    });
+    s->On(5, [st](Context& c) { // Finalize(id)
+        const auto id = c.Pop<uint32_t>();
+        std::scoped_lock lk{st->m};
+        st->min.erase(id);
+    });
+    s->On(6, [st](Context& c) { // SetAndWait(id, min, max)
+        const auto id = c.Pop<uint32_t>();
+        const auto min = c.Pop<uint32_t>();
+        std::scoped_lock lk{st->m};
+        if (st->min.contains(id)) st->min[id] = min;
+    });
+    s->On(7, [st](Context& c) { // Get(id)
+        const auto id = c.Pop<uint32_t>();
+        std::scoped_lock lk{st->m};
+        c.Push<uint32_t>(st->min.contains(id) ? st->min[id] : 0);
+    });
+    return s;
+}
+
+} // namespace KartRuntime::Services
diff --git a/src/kart_runtime/services/time.h b/src/kart_runtime/services/time.h
new file mode 100644
index 0000000000..ee746c03f8
--- /dev/null
+++ b/src/kart_runtime/services/time.h
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the clock services ("time:u", "time:a", "time:s") on the host clock (docs/NATIVE_ENGINE.md, "native services").
+//
+// The console has a steady clock (seconds since an arbitrary start, with a source id that changes when the clock is reset), and
+// system clocks that are the steady clock plus an offset ("context"). Here the steady clock is the host's monotonic clock since
+// the runtime started, the system clocks are the host's wall clock, and time zone conversion is the host's local time zone.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <ctime>
+#include <memory>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+class Time {
+public:
+    struct SteadyClockTimePoint {
+        int64_t time_point; ///< seconds
+        std::array<uint8_t, 16> source_id;
+    };
+    struct SystemClockContext {
+        int64_t offset;
+        SteadyClockTimePoint steady;
+    };
+    struct CalendarTime {
+        int16_t year;
+        int8_t month, day, hour, minute, second, pad;
+    };
+    struct CalendarAdditionalInfo {
+        int32_t day_of_week, day_of_year;
+        char name[8];
+        int32_t is_dst, ut_offset;
+    };
+    static_assert(sizeof(SystemClockContext) == 0x20 && sizeof(CalendarTime) == 8 && sizeof(CalendarAdditionalInfo) == 0x18);
+    static constexpr uint32_t ResultClockMismatch = 116 | (102u << 9);
+    static constexpr uint32_t ResultOutOfRange = 116 | (902u << 9);
+
+    Time() : start{std::chrono::steady_clock::now()} {
+        // A source id per run, as the console makes one per boot.
+        const uint64_t seed = static_cast<uint64_t>(std::chrono::system_clock::now().time_since_epoch().count());
+        for (int i = 0; i < 16; ++i) source_id[i] = static_cast<uint8_t>((seed >> ((i % 8) * 8)) ^ (0x5Bu * i));
+    }
+
+    int64_t SteadySeconds() const {
+        return std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - start).count();
+    }
+    static int64_t Posix() { return static_cast<int64_t>(std::time(nullptr)); }
+    SteadyClockTimePoint SteadyNow() const { return {SteadySeconds(), source_id}; }
+    SystemClockContext ClockContext() const {
+        const SteadyClockTimePoint now = SteadyNow();
+        return {Posix() - now.time_point, now};
+    }
+
+    /// Local calendar time of a POSIX time (the device's own time zone = the host's).
+    static bool ToCalendar(int64_t posix, CalendarTime& out, CalendarAdditionalInfo& info) {
+        const std::time_t t = static_cast<std::time_t>(posix);
+        std::tm tm{};
+        if (!localtime_r(&t, &tm)) return false;
+        out = {static_cast<int16_t>(tm.tm_year + 1900), static_cast<int8_t>(tm.tm_mon + 1), static_cast<int8_t>(tm.tm_mday),
+               static_cast<int8_t>(tm.tm_hour), static_cast<int8_t>(tm.tm_min), static_cast<int8_t>(tm.tm_sec), 0};
+        info = {};
+        info.day_of_week = tm.tm_wday;
+        info.day_of_year = tm.tm_yday;
+        if (tm.tm_zone) std::memcpy(info.name, tm.tm_zone, std::min(std::strlen(tm.tm_zone), sizeof(info.name)));
+        info.is_dst = tm.tm_isdst > 0;
+        info.ut_offset = static_cast<int32_t>(tm.tm_gmtoff);
+        return true;
+    }
+
+    std::shared_ptr<Service> SystemClock(const char* name) {
+        auto s = std::make_shared<Service>(name);
+        s->serialize = false;
+        s->On(0, [](Context& c) { c.Push<int64_t>(Posix()); }); // GetCurrentTime
+        s->Ok(1);                                                   // SetCurrentTime (ignored: the host owns the clock)
+        s->On(2, [this](Context& c) { c.Push(ClockContext()); });       // GetSystemClockContext
+        s->Ok(3);                                                   // SetSystemClockContext
+        return s;
+    }
+    std::shared_ptr<Service> SteadyClock() {
+        auto s = std::make_shared<Service>("ISteadyClock");
+        s->serialize = false;
+        s->On(0, [this](Context& c) { c.Push(SteadyNow()); });                // GetCurrentTimePoint
+        s->On(2, [](Context& c) { c.Push<int64_t>(0); });                      // GetTestOffset
+        s->On(100, [](Context& c) { c.Push<int64_t>(Posix()); });              // GetRtcValue
+        s->On(101, [](Context& c) { c.Push<uint8_t>(0); });                    // IsRtcResetDetected
+        s->On(102, [](Context& c) { c.Push<uint32_t>(0); });                   // GetSetupResultValue
+        s->On(200, [](Context& c) { c.Push<int64_t>(0); });                    // GetInternalOffset
+        return s;
+    }
+    std::shared_ptr<Service> TimeZone() {
+        auto s = std::make_shared<Service>("ITimeZoneService");
+        s->serialize = false;
+        s->On(0, [](Context& c) { // GetDeviceLocationName
+            std::array<char, 0x24> name{};
+            std::strncpy(name.data(), "UTC", name.size());
+            if (const char* tz = std::getenv("TZ"); tz && *tz) std::strncpy(name.data(), tz[0] == ':' ? tz + 1 : tz, name.size() - 1);
+            c.Push(name);
+        });
+        s->On(101, [](Context& c) { // ToCalendarTimeWithMyRule
+            CalendarTime t{};
+            CalendarAdditionalInfo i{};
+            if (!ToCalendar(c.Pop<int64_t>(), t, i)) return c.SetResult(ResultOutOfRange);
+            c.Push(t);
+            c.Push(i);
+        });
+        s->On(100, [](Context& c) { // ToCalendarTime (with a rule from LoadTimeZoneRule): the device's zone
+            CalendarTime t{};
+            CalendarAdditionalInfo i{};
+            if (!ToCalendar(c.Pop<int64_t>(), t, i)) return c.SetResult(ResultOutOfRange);
+            c.Push(t);
+            c.Push(i);
+        });
+        s->On(202, [](Context& c) { // ToPosixTimeWithMyRule: calendar time -> one POSIX time
+            const auto t = c.Pop<CalendarTime>();
+            std::tm tm{};
+            tm.tm_year = t.year - 1900;
+            tm.tm_mon = t.month - 1;
+            tm.tm_mday = t.day;
+            tm.tm_hour = t.hour;
+            tm.tm_min = t.minute;
+            tm.tm_sec = t.second;
+            tm.tm_isdst = -1;
+            const int64_t p = static_cast<int64_t>(std::mktime(&tm));
+            c.WriteBuffer(&p, sizeof(p), 0);
+            c.Push<uint32_t>(1);
+        });
+        return s;
+    }
+    std::shared_ptr<Service> Static(const char* name) {
+        auto s = std::make_shared<Service>(name);
+        s->serialize = false;
+        s->On(0, [this](Context& c) { c.PushInterface(SystemClock("ISystemClock")); });  // GetStandardUserSystemClock
+        s->On(1, [this](Context& c) { c.PushInterface(SystemClock("ISystemClock")); });  // GetStandardNetworkSystemClock
+        s->On(2, [this](Context& c) { c.PushInterface(SteadyClock()); });                // GetStandardSteadyClock
+        s->On(3, [this](Context& c) { c.PushInterface(TimeZone()); });                   // GetTimeZoneService
+        s->On(4, [this](Context& c) { c.PushInterface(SystemClock("ISystemClock")); });  // GetStandardLocalSystemClock
+        s->On(5, [this](Context& c) { c.PushInterface(SystemClock("ISystemClock")); });  // GetEphemeralNetworkSystemClock
+        s->On(100, [](Context& c) { c.Push<uint8_t>(1); });                              // IsStandardUserSystemClockAutomaticCorrectionEnabled
+        s->Ok(101);
+        s->On(300, [this](Context& c) { // CalculateMonotonicSystemClockBaseTimePoint
+            const auto ctx = c.Pop<SystemClockContext>();
+            if (ctx.steady.source_id != source_id) return c.SetResult(ResultClockMismatch);
+            c.Push<int64_t>(ctx.offset); // the system clock's time when the steady clock (= monotonic time) was 0
+        });
+        return s;
+    }
+
+    std::array<uint8_t, 16> source_id{};
+
+private:
+    std::chrono::steady_clock::time_point start;
+};
+
+} // namespace KartRuntime::Services
diff --git a/src/kart_runtime/sync_arbiter.h b/src/kart_runtime/sync_arbiter.h
new file mode 100644
index 0000000000..a5c0ed8498
--- /dev/null
+++ b/src/kart_runtime/sync_arbiter.h
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the console's user-mode synchronisation system calls, natively (docs/NATIVE_ENGINE.md, "native kernel").
+//
+// The game's locks, condition variables and light events are words in its own memory. Uncontended, the game changes them with
+// atomic instructions and never calls the system; only a contended lock, a wait or a wake-up does. This class is what the console
+// kernel does for those calls - same rules, same results - with host threads blocking on host condition variables:
+//
+//   ArbitrateLock / ArbitrateUnlock          LockWait / Unlock        (lock word: owner tag, bit 30 = "has waiters")
+//   WaitProcessWideKeyAtomic / SignalPWKey   ConditionWait / ConditionSignal
+//   WaitForAddress / SignalToAddress         AddressWait / AddressSignal (less-than, decrement-and-less-than, equal;
+//                                                                     signal, increment-if-equal, modify-by-count-if-equal)
+//
+// Waiters are woken best priority first (lower number = better), first come first served among equals. One lock guards all
+// queues, like the kernel's scheduler lock. The words are reached through `Resolve` (guest address -> host pointer, nullptr when
+// not mapped) and changed with host atomics, which the game's own exclusive loads/stores see. A thread about to block calls
+// `before_block` and, once woken and outside the lock, `after_block` (to give a virtual core up and take it back).
+//
+// Standard library only: no emulator types (tests: tests/test_sync_arbiter.cpp).
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <list>
+#include <map>
+#include <mutex>
+#include <set>
+
+namespace KartRuntime {
+
+class SyncArbiter {
+public:
+    enum class Result { Success, TimedOut, InvalidState, InvalidCurrentMemory, Cancelled };
+
+    static constexpr uint32_t HandleWaitMask = 1u << 30;
+
+    struct Hooks {
+        std::function<uint32_t*(uint64_t)> resolve;
+        std::function<void()> before_block;
+        std::function<void()> after_block;
+    };
+
+    explicit SyncArbiter(Hooks hooks_) : hooks{std::move(hooks_)} {}
+
+    // --- mutexes ---------------------------------------------------------------------------------------------------------------
+
+    /// ArbitrateLock: the lock word at `addr` was seen as `owner_tag | HandleWaitMask`. If it still is, wait until the owner
+    /// hands the lock over (the word then holds `self_tag`).
+    Result LockWait(uint64_t id, uint64_t addr, uint32_t owner_tag, uint32_t self_tag, int priority) {
+        Waiter w{id, priority, self_tag};
+        {
+            std::unique_lock lk{mutex};
+            if (cancelled.contains(id)) return Result::Cancelled;
+            uint32_t* word = hooks.resolve(addr);
+            if (!word) return Result::InvalidCurrentMemory;
+            if (Load(word) != (owner_tag | HandleWaitMask)) return Result::Success;
+            w.lock_addr = addr;
+            Insert(lock_waiters[addr], &w);
+            Block(lk, w, -1);
+        }
+        if (hooks.after_block) hooks.after_block();
+        return w.result;
+    }
+
+    /// ArbitrateUnlock: hands the lock at `addr` to its best waiter (the word becomes that waiter's tag, with the wait bit if
+    /// more wait), or clears it.
+    Result Unlock(uint64_t addr) {
+        std::unique_lock lk{mutex};
+        uint32_t* word = hooks.resolve(addr);
+        if (!word) return Result::InvalidCurrentMemory;
+        HandOver(addr, word);
+        return Result::Success;
+    }
+
+    // --- condition variables ---------------------------------------------------------------------------------------------------
+
+    /// WaitProcessWideKeyAtomic: releases the lock at `lock_addr` (as Unlock), marks `cv_key` as waited on, and waits for a
+    /// signal; then waits to own the lock again (the word holds `self_tag` on success). `timeout_ns` < 0 waits forever, 0 does
+    /// not wait.
+    Result ConditionWait(uint64_t id, uint64_t lock_addr, uint64_t cv_key, uint32_t self_tag, int priority, int64_t timeout_ns) {
+        Waiter w{id, priority, self_tag};
+        {
+            std::unique_lock lk{mutex};
+            if (cancelled.contains(id)) return Result::Cancelled;
+            uint32_t* word = hooks.resolve(lock_addr);
+            uint32_t* key = hooks.resolve(cv_key);
+            if (!word || !key) return Result::InvalidCurrentMemory;
+            // The key first: once the lock is released another thread may take it and signal, and the game only makes the
+            // signal call when it sees the key set.
+            Store(key, 1);
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+            HandOver(lock_addr, word, /*release_fence=*/false);
+            if (timeout_ns == 0) return Result::TimedOut;
+            w.cv_key = cv_key;
+            w.lock_addr = lock_addr;
+            Insert(cv_waiters[cv_key], &w);
+            if (!Block(lk, w, timeout_ns)) {
+                RemoveFromQueues(w);
+                lk.unlock();
+                if (hooks.after_block) hooks.after_block();
+                return Result::TimedOut;
+            }
+        }
+        if (hooks.after_block) hooks.after_block();
+        return w.result;
+    }
+
+    /// SignalProcessWideKey: wakes up to `count` waiters of `cv_key` (all when count <= 0). Each tries to take its lock: free ->
+    /// it owns it and runs; held -> it queues on the lock (the wait bit is set). The key word is cleared when nobody is left.
+    void ConditionSignal(uint64_t cv_key, int32_t count) {
+        std::unique_lock lk{mutex};
+        auto it = cv_waiters.find(cv_key);
+        int32_t woken = 0;
+        while (it != cv_waiters.end() && !it->second.empty() && (count <= 0 || woken < count)) {
+            Waiter* w = it->second.front();
+            it->second.pop_front();
+            w->cv_key = 0;
+            ++woken;
+            uint32_t* word = hooks.resolve(w->lock_addr);
+            if (!word) {
+                Wake(*w, Result::InvalidCurrentMemory);
+                continue;
+            }
+            // Take the lock if it is free, else mark it contended and wait for it.
+            uint32_t prev = Load(word);
+            for (;;) {
+                const uint32_t next = prev == 0 ? w->tag : (prev | HandleWaitMask);
+                if (__atomic_compare_exchange_n(word, &prev, next, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) break;
+            }
+            if (prev == 0) {
+                Wake(*w, Result::Success);
+            } else {
+                Insert(lock_waiters[w->lock_addr], w);
+            }
+        }
+        if (it == cv_waiters.end() || it->second.empty()) {
+            if (it != cv_waiters.end()) cv_waiters.erase(it);
+            if (uint32_t* key = hooks.resolve(cv_key)) Store(key, 0);
+        }
+    }
+
+    // --- address arbiter -------------------------------------------------------------------------------------------------------
+
+    enum class WaitType { LessThan, DecrementAndLessThan, Equal };
+    enum class SignalType { Signal, IncrementIfEqual, ModifyByWaitingCountIfEqual };
+
+    Result AddressWait(uint64_t id, uint64_t addr, WaitType type, int32_t value, int priority, int64_t timeout_ns) {
+        Waiter w{id, priority, 0};
+        {
+            std::unique_lock lk{mutex};
+            if (cancelled.contains(id)) return Result::Cancelled;
+            uint32_t* word = hooks.resolve(addr);
+            if (!word) return Result::InvalidCurrentMemory;
+            int32_t current = static_cast<int32_t>(Load(word));
+            if (type == WaitType::DecrementAndLessThan) {
+                uint32_t expected = static_cast<uint32_t>(current);
+                while (static_cast<int32_t>(expected) < value &&
+                       !__atomic_compare_exchange_n(word, &expected, expected - 1, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+                }
+                current = static_cast<int32_t>(expected);
+            }
+            const bool waits = type == WaitType::Equal ? current == value : current < value;
+            if (!waits) return Result::InvalidState;
+            if (timeout_ns == 0) return Result::TimedOut;
+            w.arb_addr = addr;
+            Insert(arb_waiters[addr], &w);
+            if (!Block(lk, w, timeout_ns)) {
+                RemoveFromQueues(w);
+                lk.unlock();
+                if (hooks.after_block) hooks.after_block();
+                return Result::TimedOut;
+            }
+        }
+        if (hooks.after_block) hooks.after_block();
+        return w.result;
+    }
+
+    Result AddressSignal(uint64_t addr, SignalType type, int32_t value, int32_t count) {
+        std::unique_lock lk{mutex};
+        auto it = arb_waiters.find(addr);
+        const size_t waiting = it == arb_waiters.end() ? 0 : it->second.size();
+        if (type != SignalType::Signal) {
+            uint32_t* word = hooks.resolve(addr);
+            if (!word) return Result::InvalidCurrentMemory;
+            int32_t new_value = value + 1;
+            if (type == SignalType::ModifyByWaitingCountIfEqual) {
+                // As the kernel: more waiters than will be woken -> value - 1 (count <= 0: all woken -> value - 2), else value;
+                // none waiting -> value + 1.
+                if (waiting == 0) {
+                    new_value = value + 1;
+                } else if (count <= 0) {
+                    new_value = value - 2;
+                } else {
+                    // The kernel counts the waiters after the first, stopping once it has seen `count` of them.
+                    const size_t others = waiting - 1;
+                    new_value = others < static_cast<size_t>(count) ? value - 1 : value;
+                }
+            }
+            uint32_t expected = static_cast<uint32_t>(value);
+            if (new_value != value) {
+                __atomic_compare_exchange_n(word, &expected, static_cast<uint32_t>(new_value), false, __ATOMIC_SEQ_CST,
+                                            __ATOMIC_SEQ_CST);
+            } else {
+                expected = Load(word);
+            }
+            if (static_cast<int32_t>(expected) != value) return Result::InvalidState;
+        }
+        int32_t woken = 0;
+        while (it != arb_waiters.end() && !it->second.empty() && (count <= 0 || woken < count)) {
+            Waiter* w = it->second.front();
+            it->second.pop_front();
+            w->arb_addr = 0;
+            Wake(*w, Result::Success);
+            ++woken;
+        }
+        if (it != arb_waiters.end() && it->second.empty()) arb_waiters.erase(it);
+        return Result::Success;
+    }
+
+    /// SleepThread with a positive time: the thread sleeps (its core given up) until the time passes or it is terminated.
+    Result Sleep(uint64_t id, int64_t ns) {
+        Waiter w{id, 0, 0};
+        {
+            std::unique_lock lk{mutex};
+            if (cancelled.contains(id)) return Result::Cancelled;
+            Insert(sleepers[id], &w);
+            const bool woken = Block(lk, w, ns);
+            if (!woken) RemoveFromQueues(w);
+        }
+        if (hooks.after_block) hooks.after_block();
+        return w.done ? w.result : Result::Success;
+    }
+
+    /// Thread `id` is being terminated: its current wait (if any) and every later one ends at once with Cancelled, as the
+    /// kernel ends a terminating thread's waits. Ids are never reused.
+    void Cancel(uint64_t id) {
+        std::unique_lock lk{mutex};
+        cancelled.insert(id);
+        for (auto* m : {&lock_waiters, &cv_waiters, &arb_waiters, &sleepers}) {
+            for (auto& [key, q] : *m) {
+                for (Waiter* w : q) {
+                    if (w->id != id) continue;
+                    Waiter* found = w;
+                    RemoveFromQueues(*found);
+                    Wake(*found, Result::Cancelled);
+                    return;
+                }
+            }
+        }
+    }
+
+    /// Waiters currently queued (tests and diagnostics).
+    size_t Waiting() {
+        std::scoped_lock lk{mutex};
+        size_t n = 0;
+        for (auto* m : {&lock_waiters, &cv_waiters, &arb_waiters})
+            for (auto& [k, q] : *m) n += q.size();
+        return n;
+    }
+
+private:
+    struct Waiter {
+        uint64_t id;
+        int priority;
+        uint32_t tag;
+        uint64_t lock_addr = 0; ///< queued on this lock (lock_waiters) when cv_key == 0
+        uint64_t cv_key = 0;    ///< queued on this condition variable
+        uint64_t arb_addr = 0;  ///< queued on this address (arbiter)
+        bool done = false;
+        Result result = Result::Success;
+        std::condition_variable cv;
+        Waiter(uint64_t i, int p, uint32_t t) : id{i}, priority{p}, tag{t} {}
+    };
+    using Queue = std::list<Waiter*>;
+
+    static uint32_t Load(uint32_t* p) { return __atomic_load_n(p, __ATOMIC_SEQ_CST); }
+    static void Store(uint32_t* p, uint32_t v) { __atomic_store_n(p, v, __ATOMIC_SEQ_CST); }
+
+    static void Insert(Queue& q, Waiter* w) {
+        auto it = q.begin();
+        while (it != q.end() && (*it)->priority <= w->priority) ++it;
+        q.insert(it, w);
+    }
+
+    void Wake(Waiter& w, Result r) {
+        w.result = r;
+        w.done = true;
+        w.cv.notify_one();
+    }
+
+    /// The lock at `addr` passes to its best waiter, or becomes free. Lock held.
+    void HandOver(uint64_t addr, uint32_t* word, bool release_fence = true) {
+        uint32_t next = 0;
+        auto it = lock_waiters.find(addr);
+        if (it != lock_waiters.end() && !it->second.empty()) {
+            Waiter* w = it->second.front();
+            it->second.pop_front();
+            next = w->tag | (it->second.empty() ? 0 : HandleWaitMask);
+            if (it->second.empty()) lock_waiters.erase(it);
+            w->lock_addr = 0;
+            if (release_fence) std::atomic_thread_fence(std::memory_order_seq_cst);
+            Store(word, next);
+            Wake(*w, Result::Success);
+            return;
+        }
+        if (release_fence) std::atomic_thread_fence(std::memory_order_seq_cst);
+        Store(word, next);
+    }
+
+    /// Blocks until woken (true) or the timeout passes (false, still queued). `lk` is held on return.
+    bool Block(std::unique_lock<std::mutex>& lk, Waiter& w, int64_t timeout_ns) {
+        if (hooks.before_block) {
+            lk.unlock();
+            hooks.before_block();
+            lk.lock();
+        }
+        if (timeout_ns < 0) {
+            w.cv.wait(lk, [&] { return w.done; });
+            return true;
+        }
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::nanoseconds(timeout_ns);
+        return w.cv.wait_until(lk, deadline, [&] { return w.done; });
+    }
+
+    void RemoveFromQueues(Waiter& w) {
+        auto drop = [&](std::map<uint64_t, Queue>& m, uint64_t key) {
+            if (auto it = m.find(key); it != m.end()) {
+                it->second.remove(&w);
+                if (it->second.empty()) m.erase(it);
+            }
+        };
+        if (w.cv_key) {
+            drop(cv_waiters, w.cv_key);
+            w.cv_key = 0;
+        } else if (w.lock_addr) {
+            drop(lock_waiters, w.lock_addr);
+        }
+        if (w.arb_addr) drop(arb_waiters, w.arb_addr);
+        drop(sleepers, w.id);
+        w.lock_addr = 0;
+        w.arb_addr = 0;
+    }
+
+    Hooks hooks;
+    std::mutex mutex;
+    std::map<uint64_t, Queue> lock_waiters, cv_waiters, arb_waiters, sleepers; ///< sleepers by thread id
+    std::set<uint64_t> cancelled;
+};
+
+} // namespace KartRuntime
