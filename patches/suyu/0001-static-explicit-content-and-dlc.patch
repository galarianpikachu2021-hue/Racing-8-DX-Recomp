+                }
+                index_wide.resize(count);
+                for (u32 i = 0; i < count; ++i) {
+                    index_wide[i] = index_scratch[i];
+                    highest = std::max<u32>(highest, index_wide[i]);
+                }
+                std::memcpy(ring_ptr + *wide, index_wide.data(), static_cast<u64>(count) * 2);
+                index_offset = *wide;
+            } else {
+                const auto raw = Allocate(std::max<u64>(bytes, 4), 4);
+                if (!raw) {
+                    return false;
+                }
+                if (isize == 2) {
+                    const auto* src = reinterpret_cast<const u16*>(index_scratch.data());
+                    for (u32 i = 0; i < count; ++i) {
+                        if (src[i] != 0xFFFF) highest = std::max<u32>(highest, src[i]);
+                    }
+                } else {
+                    const auto* src = reinterpret_cast<const u32*>(index_scratch.data());
+                    for (u32 i = 0; i < count; ++i) {
+                        if (src[i] != 0xFFFFFFFF) highest = std::max<u32>(highest, src[i]);
+                    }
+                    vk_index = VK_INDEX_TYPE_UINT32;
+                }
+                std::memcpy(ring_ptr + *raw, index_scratch.data(), bytes);
+                index_offset = *raw;
+            }
+            max_vertex = static_cast<u32>(std::max<s64>(0, static_cast<s64>(highest) + base_vertex)) + 1;
+        }
