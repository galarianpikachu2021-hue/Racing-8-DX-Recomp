+    namespace fs = std::filesystem;
+    std::error_code ec;
+    const fs::path root = Common::FS::GetSuyuPath(Common::FS::SuyuPath::SuyuDir) / "saves";
+    fs::create_directories(root, ec);
+    // The console's first profile owns saves/ itself; any other profile gets saves/user-<id>.
+    const std::string id = fmt::format("{:016X}{:016X}", user_id[1], user_id[0]);
+    std::string owner;
+    if (const auto first = system.GetProfileManager().GetUser(0)) {
+        u128 first_id{};
+        std::memcpy(first_id.data(), first->uuid.data(), sizeof(first_id));
+        owner = fmt::format("{:016X}{:016X}", first_id[1], first_id[0]);
+    }
+    const fs::path target = owner == id ? root : root / ("user-" + id);
+    fs::create_directories(target, ec);
+    // First use: copy an existing save from the NAND folder (the original stays where it was).
+    bool empty = true;
+    for (const auto& e : fs::directory_iterator(target, ec)) {
+        if (e.path().filename().string().rfind("user-", 0) != 0) {
+            empty = false;
+            break;
+        }
+    }
+    if (empty) {
+        const fs::path old_save =
+            Common::FS::GetSuyuPath(Common::FS::SuyuPath::SaveDir) / fs::path(nand_path).relative_path();
+        if (fs::is_directory(old_save, ec) && !fs::is_empty(old_save, ec)) {
+            fs::copy(old_save, target, fs::copy_options::recursive | fs::copy_options::skip_existing, ec);
+            LOG_INFO(Service_FS, "save moved to {} (copied from {}; the original is kept){}",
+                     Common::FS::PathToUTF8String(target), Common::FS::PathToUTF8String(old_save),
+                     ec ? fmt::format(", error: {}", ec.message()) : std::string{});
+        }
+    }
+    return system.GetFilesystem()->OpenDirectory(Common::FS::PathToUTF8String(target), OpenMode::ReadWrite);
+}
