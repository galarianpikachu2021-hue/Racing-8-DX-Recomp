+        // Opt-in (SUYU_RECOMP_BLOCK_HOOKS=1 at export time): only the paused CTGP work needs them; the shipped build has none.
+        static const bool block_hooks = [] { const char* v = std::getenv("SUYU_RECOMP_BLOCK_HOOKS"); return v && *v == '1'; }();
+        if (block_hooks && mod == "main") {
