+std::shared_ptr<KartRuntime::Service> MakeService(KartRuntime::NativeKernel& runtime, KernelCore& kernel, const std::string& name) {
+    static Time time;
+    Core::System& system = kernel.System();
+    using Factory = std::function<std::shared_ptr<KartRuntime::Service>()>;
+    const std::map<std::string, Factory> factories{
+        {"time:u", [] { return time.Static("time:u"); }},
+        {"time:a", [] { return time.Static("time:a"); }},
+        {"time:s", [] { return time.Static("time:s"); }},
+        {"set", [] { return MakeSettings(MakeSystemConfig()); }},
+        {"apm", [] { return MakeApm("apm"); }},
+        {"apm:am", [] { return MakeApm("apm:am"); }},
+        {"pctl", [] { return MakeParentalControl("pctl"); }},
+        {"pctl:a", [] { return MakeParentalControl("pctl:a"); }},
+        {"pctl:r", [] { return MakeParentalControl("pctl:r"); }},
+        {"pctl:s", [] { return MakeParentalControl("pctl:s"); }},
+        {"prepo:u", [] { return MakePlayReport("prepo:u"); }},
+        {"prepo:a", [] { return MakePlayReport("prepo:a"); }},
+        {"prepo:a2", [] { return MakePlayReport("prepo:a2"); }},
+        {"prepo:s", [] { return MakePlayReport("prepo:s"); }},
+        {"friend:u", [] { return MakeFriends("friend:u"); }},
+        {"friend:a", [] { return MakeFriends("friend:a"); }},
+        {"lm", [] { return MakeLog(); }},
+        {"csrng", [] { return MakeRandom(); }},
+        {"nifm:u", [&] { return MakeNetwork(runtime, "nifm:u"); }},
+        {"nifm:a", [&] { return MakeNetwork(runtime, "nifm:a"); }},
+        {"nifm:s", [&] { return MakeNetwork(runtime, "nifm:s"); }},
+        {"mm:u", [] { return MakeMultimedia(); }},
+        {"acc:u0", [&] { return MakeAccount("acc:u0", MakeAccountConfig(system)); }},
+        {"acc:u1", [&] { return MakeAccount("acc:u1", MakeAccountConfig(system)); }},
+        {"aoc:u", [&] { return MakeAddOnContent(runtime, MakeAddOnConfig(system)); }},
+        {"appletOE", [&] { return MakeApplets(runtime, kernel); }},
+        {"fsp-srv", [&] {
+             static KartRuntime::Services::FileSystemService& fs = *new KartRuntime::Services::FileSystemService{MakeFsBackend(system)};
+             return fs.Root("fsp-srv");
+         }},
+        {"pl:u", [&] { return MakeSharedFont(kernel); }},
+        {"hid", [&] { return MakeHidService(kernel); }},
+        {"audren:u", [&] { return MakeAudioRendererService(kernel); }},
+        {"nvdrv", [&] { return MakeNvdrvService(kernel, "nvdrv"); }},
+        {"mii:e", [] { return MakeMiiService("mii:e", true); }},
+        {"mii:u", [] { return MakeMiiService("mii:u", false); }},
+        {"vi:m", [&] { return NativeDisplay(runtime).Root("vi:m", 2); }},
+        {"vi:u", [&] { return NativeDisplay(runtime).Root("vi:u", 0); }},
+        {"vi:s", [&] { return NativeDisplay(runtime).Root("vi:s", 1); }},
+        {"ldn:u", [&] { return MakeLocalCommunicationService(runtime, "ldn:u"); }},
+        {"bsd:u", [] { return MakeSocketService("bsd:u"); }},
+        {"bsd:s", [] { return MakeSocketService("bsd:s"); }},
+    };
+    const auto it = factories.find(name);
+    return it == factories.end() ? nullptr : it->second();
+}
