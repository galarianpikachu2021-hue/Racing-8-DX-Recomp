+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: native services (docs/NATIVE_ENGINE.md, "native services") - the suyu-side adapter of kart_runtime/native_kernel.h.
+// Services named in KARTRECOMP_NATIVE_SERVICES (default on Linux: every service the runtime has) are answered by the runtime: the
+// service manager hands the game a runtime session handle for them, and SendSyncRequest / CloseHandle / WaitSynchronization /
+// ResetSignal / CancelSynchronization on runtime handles never reach the emulated kernel. Other handles go on as before.
+#pragma once
+
+#include <optional>
+#include <string>
+
+#include "common/common_types.h"
+#include "core/hle/kernel/svc_types.h"
+#include "core/hle/result.h"
+
+namespace KartRuntime {
+class NativeKernel;
+class Event;
+}
+
+namespace Kernel {
+class KernelCore;
+class KThread;
+class KReadableEvent;
+class KProcess;
+}
+
+namespace Kernel::NativeServices {
+
+bool Enabled();
+bool IsNative(Svc::Handle handle);
+/// True when the runtime is asked to answer `name` (KARTRECOMP_NATIVE_SERVICES), whether or not it has that service.
+bool ServiceWanted(const std::string& name);
+
+/// ConnectToNamedPort: a runtime session for "sm:" (the runtime's service manager) when native services are on.
+std::optional<u32> ConnectToNamedPort(KernelCore& kernel, const std::string& name);
+
+/// The service manager's GetService: a new runtime session handle when `name` is served by the runtime.
+std::optional<u32> OpenService(KernelCore& kernel, const std::string& name);
+
+Result SendSyncRequest(KernelCore& kernel, Svc::Handle handle);
+Result CloseHandle(KernelCore& kernel, Svc::Handle handle);
+Result ResetSignal(KernelCore& kernel, Svc::Handle handle);
+/// svcClearEvent on a runtime event (nifm's request events, for one).
+Result ClearEvent(KernelCore& kernel, Svc::Handle handle);
+/// WaitSynchronization when any of the handles is a runtime handle (`*handled` false otherwise: the caller goes on).
+Result WaitSynchronization(KernelCore& kernel, s32* out_index, const Svc::Handle* handles, s32 count, s64 timeout_ns, bool* handled);
+/// True when it ended a runtime wait; otherwise the caller asks the emulated kernel (which keeps the request on the thread).
+bool CancelSynchronization(KernelCore& kernel, KThread* thread);
+void OnTerminateRequested(KernelCore& kernel, KThread* thread);
+/// The game process is stopping: releases the runtime's objects before the engine shuts its services down.
+void Shutdown(KernelCore& kernel);
+
+KartRuntime::NativeKernel& Runtime(KernelCore& kernel);
+
+/// A runtime handle that mirrors an emulated kernel event signalled by the engine's library parts (audio_core, hid_core, the
+/// driver module): the game waits on it and resets it natively; the emulated event's signal and reset reach the mirror.
+u32 MirrorKernelEvent(KernelCore& kernel, KReadableEvent* event);
+/// After the runtime's ResetSignal on a mirror: the emulated event is reset too.
+void OnRuntimeReset(KernelCore& kernel, KartRuntime::Event& event);
+/// The game's process: the runtime kernel's when the game runs on it, else the calling thread's.
+KProcess& GameProcess(KernelCore& kernel);
+/// From KThread::FinishTermination: the thread has ended.
+void OnThreadEnded(KThread* thread);
+/// From KReadableEvent::Signal / Reset.
+void OnKernelEvent(KReadableEvent* event, bool signaled);
+
+} // namespace Kernel::NativeServices
