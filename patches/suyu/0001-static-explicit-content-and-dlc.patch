+void EmuWindow_SDL2::StopRecordingAndSave() {
+    if (!recording) {
+        return;
+    }
+    recording = false;
+    KartOverlay::Recording().store(false);
+    auto* const tas = input_subsystem->GetTas();
+    if (tas->Record()) { // toggled: it must now be off
+        LOG_ERROR(Frontend, "input recording: could not stop");
+        return;
+    }
+    tas->SaveRecording(false); // writes user/tas/record.txt
+    namespace fs = std::filesystem;
+    const fs::path dir = Common::FS::GetSuyuPath(Common::FS::SuyuPath::TASDir);
+    const auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+    char stamp[32];
+    std::strftime(stamp, sizeof stamp, "%Y%m%d-%H%M%S", std::localtime(&now));
+    std::error_code ec;
+    fs::create_directories(dir / "recordings", ec);
+    const fs::path target = dir / "recordings" / (std::string{"run-"} + stamp + ".txt");
+    fs::rename(dir / "record.txt", target, ec);
+    LOG_INFO(Frontend, "input recording saved: {}", ec ? "could not move record.txt" : target.string());
+}
