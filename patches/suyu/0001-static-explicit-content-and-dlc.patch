new file mode 100644
index 0000000000..c274d6df04
--- /dev/null
+++ b/src/suyu_cmd/native_gpu/overlay_menu.h
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the in-game overlay menu (model and layout; drawing is in vk_shadow_backend.cpp).
+//
+// Opened with F10 or by pressing both stick buttons (L3+R3) on a controller. While it is open the
+// keyboard and controller go to the menu and not to the game: Up/Down select, Left/Right change a
+// value, A/Enter changes it too or closes the menu on "Close", B/Esc/F10 close it.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "common/kart_overlay.h"
+
+namespace KartOverlay {
+
+struct Quad {
+    float x, y, w, h;     ///< pixels
+    float u0, v0, u1, v1; ///< font atlas, 0..1
+    uint32_t rgba;        ///< 0xAABBGGRR
+};
+
+/// Settings the renderer applies as they change.
+struct Live {
+    int upscaler = 0;     ///< index into the names given to Menu (0 = off)
+    int quality = 0;      ///< render scale: 0 = off (everything at the output resolution), then 100/67/58/50/33 % of it, then 150/200 % (supersampling)
+    int resolution = 0;   ///< output resolution: 0 = the launcher's, then 720p, 1080p, 1440p, 4K
+    int graphics = 0;     ///< graphics quality: 0 = the launcher's, 1 = low (handheld), 2 = high (docked)
+    bool record = false;  ///< recording the player's inputs
+    int sharpness = 3;    ///< sharpening: 0 off, 1 low, 2 medium, 3 high
+    bool jitter = false;
+    int framegen = 0;     ///< frame generation: 0 off, 1 built-in, 2.. a plugin (index into the names given to SetFrameGenNames)
+    bool hdr = false;
+    int hdr_paper = 1;    ///< HDR paper white, index into 100, 150, 203, 250, 300 nits
+    int hdr_peak = 0;     ///< HDR highlight peak, index into 400, 600, 800, 1000, 1500 nits
+    int present_mode = 0; ///< 0 mailbox, 1 fifo, 2 immediate
+    int speed_limit = 2;  ///< index into the speed limits (50, 75, 100, 125, 150, 200, off)
+    bool fps_counter = false;
+};
+
+enum Change : uint32_t {
+    kChangeUpscaler = 1,
+    kChangeJitter = 2,
+    kChangePresent = 4,
+    kChangeSpeed = 8,
+    kChangeQuality = 32,
+    kChangeResolution = 64,
+    kChangeGraphics = 128,
+    kChangeRecord = 256,
+    kChangeFrameGen = 1024, ///< frame-generation backend
+    kChangeHdr = 512, ///< HDR on/off: the swapchain is rebuilt
+    kChangePads = 2048, ///< a player's controller was changed (request posted to the frontend)
+    kChangeOther = 16, ///< fps counter, quality, hdr: nothing to apply, but worth saving
+};
+
+struct Stats {
+    double fps = 0;
+    double frame_ms = 0;
+    const char* upscaler = "";
+};
+
+class Menu {
+public:
+    explicit Menu(std::vector<std::string> upscaler_names);
+
+    /// Applies one navigation event (the menu must be open). Returns the changes it made.
+    uint32_t Handle(Nav nav);
+    const Live& Settings() const { return live; }
+    /// Speed limit in percent, 0 = unlimited.
+    int SpeedLimitPercent() const;
+    /// The 3D render scale relative to the output resolution; false when the row is off.
+    bool RenderRatio(float& ratio) const;
+    /// Output height in pixels (720, 1080, 1440, 2160); 0 = the launcher's setting.
+    int OutputHeight() const;
+    /// FSR 1 sharpening in RCAS stops (0 = sharpest .. 2 = softest); negative = off.
+    float SharpnessStops() const;
+    /// Strength of the host's contrast-adaptive sharpening of the upscaled 3D image (0 = off).
+    float SharpenStrength() const;
+    /// HDR10 paper white and peak highlight in nits.
+    float HdrPaperNits() const;
+    float HdrPeakNits() const;
+    /// Enables the HDR rows (the display and compositor must offer an HDR10 surface).
+    void SetHdrAvailable(bool on);
+    /// Frame-generation choices after Off and Built-in: the plugins found.
+    void SetFrameGenPlugins(const std::vector<std::string>& names);
+    void SetFrameGen(int index) { live.framegen = index; items[kFrameGen].value = index; }
+    /// Refreshes the four player rows from the controllers the frontend published. Call once per frame.
+    void SyncPads();
+    /// Appends the quads for this frame (the open menu, or just the fps counter).
+    void Build(uint32_t screen_w, uint32_t screen_h, const Stats& stats, std::vector<Quad>& out) const;
+    /// Forces a setting (used by the environment variables at start-up).
+    void SetUpscaler(int index) { live.upscaler = index; items[kUpscaler].value = index; }
+    void SetJitter(bool on) { live.jitter = on; items[kJitter].value = on ? 1 : 0; }
+
+    static constexpr int kSpeedDefault = 2; ///< 100%
+    enum Row { kUpscaler, kGraphics, kResolution, kQuality, kSharp, kJitter, kFrameGen, kHdr, kHdrPaper, kHdrPeak, kPresent, kSpeed, kFps, kRecord, kPlayer1, kPlayer2, kPlayer3, kPlayer4, kExtraCup, kClose, kRowCount };
+    /// Sets a row's value (clamped) and applies it; returns the Change bits it caused.
+    uint32_t Set(Row row, int value);
+    int Get(Row row) const { return items[row].value; }
+
+private:
+    struct Item {
+        std::string label;
+        std::vector<std::string> options;
+        int value = 0;
+        bool enabled = true;
+        std::string note;
+    };
+    uint32_t Apply(Row row);
+
+    std::vector<Item> items;
+    std::vector<std::string> extra_cups; ///< track folders of each extra cup, parallel to the row's options after "Off"
+    int selected = 0;
+    uint64_t pads_version = ~0ull;
+    Live live;
+};
+
+} // namespace KartOverlay
