+bool Menu::RenderRatio(float& ratio) const {
+    // 3D resolution as a share of the output: off, 100 (DLAA / native AA), 67, 58, 50, 33 percent (the ratios give whole pixels
+    // at 1080p: 1280x720, 1120x630, 960x540, 640x360), then 150 and 200 percent: supersampling, rendered larger and averaged down.
+    static constexpr float table[] = {1.0f, 1.0f, 2.0f / 3.0f, 7.0f / 12.0f, 0.5f, 1.0f / 3.0f, 1.5f, 2.0f};
+    const int q = std::clamp(live.quality, 0, 7);
+    if (q == 0) return false;
+    ratio = table[q];
+    return true;
+}
+
+int Menu::OutputHeight() const {
+    static constexpr int heights[] = {0, 720, 1080, 1440, 2160};
+    return heights[std::clamp(live.resolution, 0, 4)];
+}
