diff --git a/src/core/hle/service/native_ipc.cpp b/src/core/hle/service/native_ipc.cpp
new file mode 100644
index 0000000000..6ef545c2f7
--- /dev/null
+++ b/src/core/hle/service/native_ipc.cpp
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/hle/service/native_ipc.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+
+#include "common/logging/log.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_server_session.h"
+#include "core/hle/kernel/k_thread.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_threads.h"
+#include "core/hle/ipc.h"
+#include "core/hle/service/hle_ipc.h"
+#include "core/memory.h"
+
+namespace Service::NativeIpc {
+namespace {
+
+std::mutex g_lock;
+std::unordered_map<Kernel::KServerSession*, std::weak_ptr<SessionRequestManager>> g_sessions;
+
+/// Services whose handlers answer at once - they never defer a reply (only sm does) and never wait on the host (the display queue's
+/// DequeueBuffer does: on the calling thread that would block a whole emulated core, so it waits for native threads). Every request
+/// still runs under the service's own lock (ServiceFrameworkBase::LockService).
+const std::set<std::string>& SafeServices() {
+    static const std::set<std::string> safe = [] {
+        std::set<std::string> out{"ISystemClock", "ITimeZoneService", "ISteadyClock", "hid",
+                                  "IActiveVibrationDeviceList", "IAudioRenderer", "nvdrv"};
+        // The display queue may wait for a free buffer. With native threads the waiting thread gives its virtual core up
+        // (NativeThreads::BeginHostWait in BufferQueueCore), so only its own thread waits, as on the console.
+        if (Kernel::NativeThreads::Enabled()) out.insert("IHOSBinderDriver");
+        return out;
+    }();
+    return safe;
+}
+
+const std::set<std::string>& Wanted() {
+    static const std::set<std::string> wanted = [] {
+        std::set<std::string> out;
+        // On by default on Linux for every safe service (KARTRECOMP_NATIVE_IPC=0 turns it off); elsewhere only when asked for.
+        const char* v = std::getenv("KARTRECOMP_NATIVE_IPC");
+#ifdef __linux__
+        if (!v) v = "all-safe";
+#endif
+        if (!v || std::strcmp(v, "0") == 0) return out;
+        std::istringstream list{v};
+        for (std::string item; std::getline(list, item, ',');) {
+            if (item == "all-safe") out.insert(SafeServices().begin(), SafeServices().end());
+            else if (SafeServices().contains(item)) out.insert(item);
+            else if (!item.empty()) LOG_WARNING(Service, "native IPC: {} is not on the safe list, left on the emulated path", item);
+        }
+        return out;
+    }();
+    return wanted;
+}
+
+} // namespace
+
+bool Enabled() {
+    return !Wanted().empty();
+}
+
+void Register(Kernel::KServerSession* session, std::weak_ptr<SessionRequestManager> manager) {
+    if (!Enabled()) return;
+    std::scoped_lock lk{g_lock};
+    g_sessions[session] = std::move(manager);
+}
+
+void Unregister(Kernel::KServerSession* session) {
+    if (!Enabled()) return;
+    std::scoped_lock lk{g_lock};
+    g_sessions.erase(session);
+}
+
+bool TryHandle(Kernel::KernelCore& kernel, Kernel::KServerSession& session, Result* out) {
+    if (!Enabled()) return false;
+    std::shared_ptr<SessionRequestManager> manager;
+    {
+        std::scoped_lock lk{g_lock};
+        const auto it = g_sessions.find(&session);
+        if (it == g_sessions.end()) return false;
+        manager = it->second.lock();
+    }
+    if (!manager) return false;
+
+    // What the service thread does for a request (KServerSession::ReceiveRequest + ServerManager::CompleteSyncRequest), on the
+    // calling thread: the context reads the request from, and the handler writes the reply into, the caller's TLS command buffer.
+    Kernel::KThread* thread = Kernel::GetCurrentThreadPointer(kernel);
+    Core::Memory::Memory& memory = thread->GetOwnerProcess()->GetMemory();
+    u32* cmd_buf = reinterpret_cast<u32*>(memory.GetPointer(thread->GetTlsAddress()));
+    if (!cmd_buf) return false;
+    // Plain requests only (CMIF Request / RequestWithContext): Close and control messages keep the emulated path, which also
+    // tears the session down.
+    if (const u32 type = cmd_buf[0] & 0xFFFF; type != 4 && type != 6) return false;
+    auto ctx = std::make_shared<HLERequestContext>(kernel, memory, &session, thread);
+    ctx->SetSessionRequestManager(manager);
+    ctx->PopulateFromIncomingCommandBuffer(cmd_buf); // reads the request only (incoming handles are not taken yet)
+    // The object the request is for: the session's handler, or in a domain (several objects behind one session, chosen by the
+    // domain header) that object's handler. Only messages to an enabled service go on.
+    const char* name = nullptr;
+    if (manager->IsDomain()) {
+        if (!ctx->HasDomainMessageHeader()) return false;
+        const auto& header = ctx->GetDomainMessageHeader();
+        if (header.command != IPC::DomainMessageHeader::CommandType::SendMessage) return false;
+        if (header.object_id == 0 || header.object_id > manager->DomainHandlerCount()) return false;
+        const auto handler = manager->DomainHandler(header.object_id - 1).lock();
+        if (!handler) return false;
+        name = handler->NativeIpcName();
+    } else {
+        if (!manager->HasSessionHandler()) return false;
+        name = manager->SessionHandler().NativeIpcName();
+    }
+    if (!name || !Wanted().contains(name)) return false;
+    ctx->SetIsDeferred(false);
+    *out = manager->CompleteSyncRequest(&session, *ctx);
+    if (ctx->GetIsDeferred()) {
+        // Must not happen for the safe services; if it ever does, the reply is lost: say so loudly.
+        LOG_CRITICAL(Service, "native IPC: {} deferred a reply; remove it from KARTRECOMP_NATIVE_IPC", name);
+    }
+    {
+        static std::mutex seen_lock;
+        static std::set<std::string> seen;
+        std::scoped_lock lk{seen_lock};
+        if (seen.insert(name).second) LOG_INFO(Service, "native IPC: {} answered on the calling thread", name);
+    }
+    return true;
+}
+
+} // namespace Service::NativeIpc
