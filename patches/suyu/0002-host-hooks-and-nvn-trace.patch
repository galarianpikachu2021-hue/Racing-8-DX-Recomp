+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/hle/kernel/native_threads.h"
+
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstdlib>
+#include <vector>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+
+#ifdef __linux__
+#include <sched.h>
+#endif
+#include "common/logging/log.h"
+#include "common/thread.h"
+#include "core/core.h"
+#include "core/hardware_properties.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_scheduler.h"
+#include "core/hle/kernel/k_thread.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/physical_core.h"
+#include "kart_runtime/core_scheduler.h"
+
+namespace Kernel::NativeThreads {
+namespace {
+
+using KartRuntime::CoreScheduler;
+
+struct Entry {
+    std::unique_ptr<CoreScheduler::Thread> sched;
+    std::function<void()> entry; ///< service threads; empty = a game thread (runs the CPU interface)
+    bool started = false;
+};
+
+std::mutex g_lock;
+std::unordered_map<KThread*, Entry> g_threads;
+std::vector<std::unique_ptr<CoreScheduler::Thread>> g_retired; ///< handles of exited threads (their host threads are parked)
+std::atomic<int> g_parked{0};
+thread_local int t_core = -1;
+thread_local CoreScheduler::Thread* t_sched = nullptr;
+KernelCore* g_kernel = nullptr;
+
+CoreScheduler& Scheduler() {
+    static CoreScheduler scheduler{static_cast<int>(Core::Hardware::NUM_CPU_CORES)};
+    return scheduler;
+}
+
+int CoreOf(const KThread* thread) {
+    const s32 core = thread->GetActiveCore();
+    return core >= 0 && core < static_cast<s32>(Core::Hardware::NUM_CPU_CORES) ? core : 0;
+}
+
+/// KARTRECOMP_PIN=<cpu>,<cpu>,<cpu>,<cpu>: virtual core N's threads run on the Nth listed host CPU (as the emulated-core threads
+/// did). A hand-off between two threads of one core then stays on one CPU: the next thread starts where the last one stopped,
+/// with its caches warm, instead of being woken on some other CPU.
+int PinnedCpu(int core) {
+    static const std::array<int, 4> cpus = [] {
+        std::array<int, 4> out{-1, -1, -1, -1};
+        if (const char* pin = std::getenv("KARTRECOMP_PIN")) {
+            std::size_t i = 0;
+            for (const char* p = pin; *p && i < out.size();) {
+                char* end = nullptr;
+                const long cpu = std::strtol(p, &end, 10);
+                if (end == p) break;
+                out[i++] = static_cast<int>(cpu);
+                p = *end == ',' ? end + 1 : end;
+            }
+        }
+        return out;
+    }();
+    return core >= 0 && core < 4 ? cpus[static_cast<std::size_t>(core)] : -1;
+}
+
+void PinToCore(int core) {
+#ifdef __linux__
+    thread_local int pinned = -1;
+    const int cpu = PinnedCpu(core);
+    if (cpu < 0 || cpu == pinned || cpu >= CPU_SETSIZE) return;
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(cpu, &set);
+    if (sched_setaffinity(0, sizeof(set), &set) == 0) pinned = cpu;
+#else
+    (void)core;
+#endif
+}
+
+/// Takes the thread's virtual core and puts its registers into that core's CPU interface.
+void Enter(KernelCore& kernel, KThread* thread) {
+    PinToCore(t_sched->Core());
+    Scheduler().Acquire(t_sched);
+    t_core = t_sched->Core();
+    thread->SetCurrentCore(t_core);
+    kernel.PhysicalCore(static_cast<std::size_t>(t_core)).LoadContext(thread);
+}
+
+/// Saves the registers and gives the core up.
+void Leave(KernelCore& kernel, KThread* thread) {
+    kernel.PhysicalCore(static_cast<std::size_t>(t_core)).SaveContext(thread);
+    t_core = -1;
+    Scheduler().Release(t_sched);
+}
+
+void GuestLoop(KernelCore& kernel, KThread* thread) {
+    thread->EnableDispatch(kernel); // KScheduler::OnThreadStart
+    for (;;) {
+        auto& core = kernel.PhysicalCore(static_cast<std::size_t>(t_core));
+        core.RunThread(kernel, thread); // returns after a system call or an interrupt
+        if (core.IsInterrupted()) core.ClearInterrupt();
+        // Suspended by another thread while it ran: wait like any kernel wait (the lock's release blocks this thread).
+        while (thread->GetState() != ThreadState::Runnable) {
+            KScopedSchedulerLock sl{kernel};
+            if (thread->GetState() != ThreadState::Runnable) thread->RequestDummyThreadWait(kernel);
+        }
+        if (Scheduler().PreemptRequested(t_sched)) Yield(kernel, thread);
+    }
+}
+
+void HostMain(Core::System& system, KThread* thread, CoreScheduler::Thread* sched, std::function<void()> entry) {
+    auto& kernel = system.Kernel();
+    Common::SetCurrentThreadName(entry ? "KartService" : "KartThread");
+    kernel.RegisterHostThread(thread);
+    SetCurrentThread(kernel, thread);
+    t_sched = sched;
+    Enter(kernel, thread);
+    if (entry) {
+        entry(); // enables dispatch, runs the service loop, exits the thread (never returns)
+    } else {
+        GuestLoop(kernel, thread);
+    }
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_THREADS");
+        return v && *v == '1';
+    }();
+    return on;
+}
+
+int CurrentCore() {
+    return t_core;
+}
+
+void Prepare(KThread* thread, std::function<void()>&& entry) {
+    std::scoped_lock lk{g_lock};
+    // Thread objects are recycled: one that exited leaves its entry (and its parked host thread's scheduler handle) behind.
+    if (const auto it = g_threads.find(thread); it != g_threads.end()) {
+        if (it->second.sched) g_retired.push_back(std::move(it->second.sched));
+        g_threads.erase(it);
+    }
+    g_threads[thread].entry = std::move(entry);
+}
+
+[[noreturn]] void ExitCurrent(KernelCore& kernel, KThread* thread) {
+    // The thread has terminated inside the kernel. Its object may be reused at any time, so nothing of it is touched again:
+    // give the core up and park this host thread for good. (TODO: end the host thread properly instead of parking it.)
+    if (t_core >= 0) Leave(kernel, thread);
+    g_parked.fetch_add(1, std::memory_order_relaxed);
+    std::mutex never;
+    std::condition_variable forever;
+    std::unique_lock lk{never};
+    for (;;) forever.wait(lk);
+}
+
+void OnRunnable(Core::System& system, KThread* thread) {
+    CoreScheduler::Thread* sched = nullptr;
+    std::function<void()> entry;
+    {
+        std::scoped_lock lk{g_lock};
+        const auto it = g_threads.find(thread);
+        if (it == g_threads.end() || it->second.started) return;
+        it->second.started = true;
+        it->second.sched = Scheduler().Create(CoreOf(thread), thread->GetPriority());
+        sched = it->second.sched.get();
+        entry = std::move(it->second.entry);
+        if (!g_kernel) {
+            g_kernel = &system.Kernel();
+            // A better-priority thread waits for a core: interrupt whatever runs there so it yields at once.
+            Scheduler().SetPreemptCallback([](CoreScheduler::Thread* t) {
+                g_kernel->PhysicalCore(static_cast<std::size_t>(t->Core())).Interrupt();
+            });
+            LOG_INFO(Kernel, "native threads: game and service threads run as host threads (KARTRECOMP_NATIVE_THREADS=1)");
+        }
+    }
+    std::thread(HostMain, std::ref(system), thread, sched, std::move(entry)).detach();
+}
+
+void BeforeBlock(KernelCore& kernel, KThread* thread) {
+    if (t_core >= 0) Leave(kernel, thread);
+}
+
+void AfterBlock(KernelCore& kernel, KThread* thread) {
+    if (t_sched && t_core < 0) Enter(kernel, thread);
+}
+
+void Yield(KernelCore& kernel, KThread* thread) {
+    if (!t_sched || t_core < 0) return;
+    kernel.PhysicalCore(static_cast<std::size_t>(t_core)).SaveContext(thread);
+    Scheduler().Yield(t_sched);
+    t_core = t_sched->Core();
+    PinToCore(t_core);
+    thread->SetCurrentCore(t_core);
+    kernel.PhysicalCore(static_cast<std::size_t>(t_core)).LoadContext(thread);
+}
+
+void OnPriorityChanged(KThread* thread) {
+    std::scoped_lock lk{g_lock};
+    if (const auto it = g_threads.find(thread); it != g_threads.end() && it->second.sched)
+        Scheduler().SetPriority(it->second.sched.get(), thread->GetPriority());
+}
+
+void OnCoreChanged(KThread* thread) {
+    std::scoped_lock lk{g_lock};
+    if (const auto it = g_threads.find(thread); it != g_threads.end() && it->second.sched)
+        Scheduler().SetCore(it->second.sched.get(), CoreOf(thread));
+}
+
+void OnStoppedByOther(KernelCore& kernel, KThread* thread) {
+    int core = -1;
+    {
+        std::scoped_lock lk{g_lock};
+        if (const auto it = g_threads.find(thread); it != g_threads.end() && it->second.sched) core = it->second.sched->Core();
+    }
+    if (core >= 0) kernel.PhysicalCore(static_cast<std::size_t>(core)).Interrupt();
+}
+
+} // namespace Kernel::NativeThreads
