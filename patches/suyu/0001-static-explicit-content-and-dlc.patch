+#undef KR_DECLARE
+
+// ---- NVN enums -> Vulkan (NVN numbering as observed in MK8D; docs/NATIVE_GPU.md) ----
+
+struct FormatInfo {
+    VkFormat format;
+    bool depth;
+    bool compressed = false; ///< BC: sampled only, written through a block-sized proxy
+};
+
+std::optional<FormatInfo> MapFormat(u32 nvn) {
+    switch (nvn) {
+    case 1: return FormatInfo{VK_FORMAT_R8_UNORM, false};
+    case 5: return FormatInfo{VK_FORMAT_R16_SFLOAT, false};
+    case 10: return FormatInfo{VK_FORMAT_R32_SFLOAT, false};
+    case 13: return FormatInfo{VK_FORMAT_R8G8_UNORM, false};
+    case 17: return FormatInfo{VK_FORMAT_R16G16_SFLOAT, false};
+    case 22: return FormatInfo{VK_FORMAT_R32G32_SFLOAT, false};
+    case 37: return FormatInfo{VK_FORMAT_R8G8B8A8_UNORM, false};
+    case 41: return FormatInfo{VK_FORMAT_R16G16B16A16_SFLOAT, false};
+    case 46: return FormatInfo{VK_FORMAT_R32G32B32A32_SFLOAT, false};
+    case 47: return FormatInfo{VK_FORMAT_R32G32B32A32_UINT, false};
+    // BC formats (NVN RGB/RGBA_DXT1, DXT3, DXT5): the game GPU-compresses its
+    // environment probes by rendering into a DXT5 cube through an RGBA32UI view.
+    case 65: return FormatInfo{VK_FORMAT_BC1_RGB_UNORM_BLOCK, false, true};
+    case 66: return FormatInfo{VK_FORMAT_BC1_RGBA_UNORM_BLOCK, false, true};
+    case 67: return FormatInfo{VK_FORMAT_BC2_UNORM_BLOCK, false, true};
+    case 68: return FormatInfo{VK_FORMAT_BC3_UNORM_BLOCK, false, true};
+    case 50: return FormatInfo{VK_FORMAT_D16_UNORM, true};
+    case 51: return FormatInfo{VK_FORMAT_D32_SFLOAT, true};
+    case 52: return FormatInfo{VK_FORMAT_D32_SFLOAT, true};
+    case 53: return FormatInfo{VK_FORMAT_D32_SFLOAT_S8_UINT, true};
+    case 54: return FormatInfo{VK_FORMAT_D32_SFLOAT_S8_UINT, true};
+    case 56: return FormatInfo{VK_FORMAT_R8G8B8A8_SRGB, false};
+    case 61: return FormatInfo{VK_FORMAT_A2B10G10R10_UNORM_PACK32, false};
+    case 63: return FormatInfo{VK_FORMAT_B10G11R11_UFLOAT_PACK32, false};
+    default: return std::nullopt;
+    }
+}
+
+/// Vertex attribute formats: the NVNformat order (R8 = 1 ... RGBA32I = 48).
+VkFormat MapVertexFormat(u32 nvn) {
+    static constexpr VkFormat table[] = {
+        VK_FORMAT_UNDEFINED,
+        VK_FORMAT_R8_UNORM, VK_FORMAT_R8_SNORM, VK_FORMAT_R8_UINT, VK_FORMAT_R8_SINT,
+        VK_FORMAT_R16_SFLOAT, VK_FORMAT_R16_UNORM, VK_FORMAT_R16_SNORM, VK_FORMAT_R16_UINT,
+        VK_FORMAT_R16_SINT, VK_FORMAT_R32_SFLOAT, VK_FORMAT_R32_UINT, VK_FORMAT_R32_SINT,
+        VK_FORMAT_R8G8_UNORM, VK_FORMAT_R8G8_SNORM, VK_FORMAT_R8G8_UINT, VK_FORMAT_R8G8_SINT,
+        VK_FORMAT_R16G16_SFLOAT, VK_FORMAT_R16G16_UNORM, VK_FORMAT_R16G16_SNORM,
+        VK_FORMAT_R16G16_UINT, VK_FORMAT_R16G16_SINT, VK_FORMAT_R32G32_SFLOAT,
+        VK_FORMAT_R32G32_UINT, VK_FORMAT_R32G32_SINT, VK_FORMAT_R8G8B8_UNORM,
+        VK_FORMAT_R8G8B8_SNORM, VK_FORMAT_R8G8B8_UINT, VK_FORMAT_R8G8B8_SINT,
+        VK_FORMAT_R16G16B16_SFLOAT, VK_FORMAT_R16G16B16_UNORM, VK_FORMAT_R16G16B16_SNORM,
+        VK_FORMAT_R16G16B16_UINT, VK_FORMAT_R16G16B16_SINT, VK_FORMAT_R32G32B32_SFLOAT,
+        VK_FORMAT_R32G32B32_UINT, VK_FORMAT_R32G32B32_SINT, VK_FORMAT_R8G8B8A8_UNORM,
+        VK_FORMAT_R8G8B8A8_SNORM, VK_FORMAT_R8G8B8A8_UINT, VK_FORMAT_R8G8B8A8_SINT,
+        VK_FORMAT_R16G16B16A16_SFLOAT, VK_FORMAT_R16G16B16A16_UNORM,
+        VK_FORMAT_R16G16B16A16_SNORM, VK_FORMAT_R16G16B16A16_UINT, VK_FORMAT_R16G16B16A16_SINT,
+        VK_FORMAT_R32G32B32A32_SFLOAT, VK_FORMAT_R32G32B32A32_UINT, VK_FORMAT_R32G32B32A32_SINT,
+    };
+    if (nvn < std::size(table)) {
+        return table[nvn];
+    }
+    // Integer-to-float ("UI2F"/"I2F") variants: NVN 81..104, the same component
+    // order as above with unsigned/signed pairs; Vulkan's scaled formats.
+    static constexpr VkFormat to_float[] = {
+        VK_FORMAT_R8_USCALED, VK_FORMAT_R8_SSCALED, VK_FORMAT_R16_USCALED, VK_FORMAT_R16_SSCALED,
+        VK_FORMAT_UNDEFINED, VK_FORMAT_UNDEFINED, // R32 (no 32-bit scaled formats)
+        VK_FORMAT_R8G8_USCALED, VK_FORMAT_R8G8_SSCALED, VK_FORMAT_R16G16_USCALED,
+        VK_FORMAT_R16G16_SSCALED, VK_FORMAT_UNDEFINED, VK_FORMAT_UNDEFINED,
+        VK_FORMAT_R8G8B8_USCALED, VK_FORMAT_R8G8B8_SSCALED, VK_FORMAT_R16G16B16_USCALED,
+        VK_FORMAT_R16G16B16_SSCALED, VK_FORMAT_UNDEFINED, VK_FORMAT_UNDEFINED,
+        VK_FORMAT_R8G8B8A8_USCALED, VK_FORMAT_R8G8B8A8_SSCALED, VK_FORMAT_R16G16B16A16_USCALED,
+        VK_FORMAT_R16G16B16A16_SSCALED, VK_FORMAT_UNDEFINED, VK_FORMAT_UNDEFINED,
+    };
+    switch (nvn) {
+    case 61: return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+    case 62: return VK_FORMAT_A2B10G10R10_UINT_PACK32;
+    case 105: return VK_FORMAT_A2B10G10R10_SNORM_PACK32;
+    case 106: return VK_FORMAT_A2B10G10R10_SINT_PACK32;
+    case 107: return VK_FORMAT_A2B10G10R10_USCALED_PACK32;
+    case 108: return VK_FORMAT_A2B10G10R10_SSCALED_PACK32;
+    default: break;
+    }
+    if (nvn >= 81 && nvn <= 104) {
+        return to_float[nvn - 81];
+    }
+    return VK_FORMAT_UNDEFINED;
+}
