+void Conductor::OnFrameQueued() {
+    const s64 now = SteadyNs();
+    if (m_last_queue_ns) {
+        const double ms = static_cast<double>(now - m_last_queue_ns) * 1e-6;
+        ++m_interval_buckets[ms <= 17.5 ? 0 : ms <= 20.0 ? 1 : ms <= 25.0 ? 2 : ms <= 40.0 ? 3 : 4];
+        if (++m_interval_count == 600) {
+            LOG_INFO(Service_VI, "frame pacing: queue intervals <=17.5 ms {}, <=20 {}, <=25 {}, <=40 {}, longer {}; {} early composes (adaptive vsync {})",
+                     m_interval_buckets[0], m_interval_buckets[1], m_interval_buckets[2], m_interval_buckets[3],
+                     m_interval_buckets[4], m_early_composes, m_adaptive_vsync ? "on" : "off");
+            std::fill(std::begin(m_interval_buckets), std::end(m_interval_buckets), 0u);
+            m_early_composes = 0;
+            m_interval_count = 0;
+        }
+    }
+    m_last_queue_ns = now;
+    if (!m_adaptive_vsync || !Service::Nvnflinger::Pacing::Starved().exchange(false)) {
+        return;
+    }
+    const s64 since_vsync = now - m_last_vsync_ns.load();
+    // A tick that just fired already took the frame, and one about to fire will: only a frame that missed its tick by a margin
+    // is worth composing early.
+    if (since_vsync < 2'000'000 || since_vsync > static_cast<s64>(FrameNs.count()) - 1'500'000) {
+        return;
+    }
+    ++m_early_composes;
+    m_system.CoreTiming().UnscheduleEvent(m_event);
+    const auto next = std::chrono::nanoseconds(this->GetNextTicks());
+    m_system.CoreTiming().ScheduleLoopingEvent(next, next, m_event);
+    m_signal.Set();
+}
