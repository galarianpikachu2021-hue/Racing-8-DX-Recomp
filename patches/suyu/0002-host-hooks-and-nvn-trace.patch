@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: native threads (KARTRECOMP_NATIVE_THREADS=1), the suyu-side adapter of kart_runtime/core_scheduler.h
+// (docs/NATIVE_ENGINE.md, "native threads").
+//
+// Every game thread and every service thread that used to be a fiber on one of four emulated-core host threads is a real host
+// thread. The kernel's objects and waits are unchanged: when the kernel makes such a thread wait, its host thread blocks (the path
+// suyu already uses for its "dummy" host threads) and gives its virtual core to the next thread; KartRuntime::CoreScheduler keeps
+// the console's rules (one running thread per core, best priority first). While a thread runs it uses that core's CPU interface
+// and PhysicalCore, as a fiber did. The four CPUCore_N host threads and the fibers are not used.
+#pragma once
+
+#include <functional>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Kernel {
+class KernelCore;
+class KThread;
+} // namespace Kernel
+
+namespace Kernel::NativeThreads {
+
+bool Enabled();
+
+/// The virtual core the calling host thread currently holds, or -1 (not a native thread, or it is waiting).
+int CurrentCore();
+
+/// A thread that will run as a host thread: remembers how to start it (a service thread's function; empty for a game thread).
+void Prepare(KThread* thread, std::function<void()>&& entry);
+/// The thread became runnable: starts its host thread the first time.
+void OnRunnable(Core::System& system, KThread* thread);
+/// The calling thread is about to block in the kernel / may run again.
+void BeforeBlock(KernelCore& kernel, KThread* thread);
+void AfterBlock(KernelCore& kernel, KThread* thread);
+/// svcSleepThread's yield variants for the calling thread.
+void Yield(KernelCore& kernel, KThread* thread);
+void OnPriorityChanged(KThread* thread);
+void OnCoreChanged(KThread* thread);
+/// Another thread made `thread` stop being runnable (suspension): interrupt it if it is executing game code.
+void OnStoppedByOther(KernelCore& kernel, KThread* thread);
+/// The calling thread has terminated: releases its core and never returns.
+[[noreturn]] void ExitCurrent(KernelCore& kernel, KThread* thread);
+
+} // namespace Kernel::NativeThreads
