+                    const u32 w0 = Mem(ctx).Read32(view);
+                    if (w0 & 1) level = (w0 >> 8) & 0xFF;
+                    if (w0 & 2) layer = Mem(ctx).Read32(view + 4) & 0xFFFF;
+                    if (w0 & 4) view_format = Mem(ctx).Read32(view + 8);
+                }
