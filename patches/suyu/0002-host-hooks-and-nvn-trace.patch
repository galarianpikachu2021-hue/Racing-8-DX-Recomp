+namespace Core::NvnHost {
+namespace {
+
+using RecompHooks::HookContext;
+
+// ---- Reconstructed state ----------------------------------------------------
+
+struct State {
+    std::mutex lock;
+    std::unordered_map<std::string, std::pair<u64, u64>> hook_time; ///< ns, calls (since last report)
+    u64 presents_timed = 0;
+    u64 submit_flatten_ns = 0;
+    std::array<u64, 4> submit_backend_ns{};
+    /// GPU-address -> guest-storage ranges of every pool mapping, sorted by base,
+    /// under their own reader-writer lock: the render thread reads guest memory
+    /// thousands of times a frame and must not contend with the game's NVN calls.
+    struct Range {
+        u64 base, size, storage;
+    };
+    std::vector<Range> ranges;
+    std::shared_mutex range_lock;
+    std::atomic<Core::System*> system_ptr{nullptr};
+    std::unordered_map<u64, TextureDesc> texture_builders;
+    std::unordered_map<u64, TextureDesc> textures;
+    std::unordered_map<u64, MemoryPool> pool_builders;
+    std::unordered_map<u64, MemoryPool> pools;
+    std::unordered_map<u64, std::vector<TextureDesc>> window_builders;
+    std::unordered_map<u64, std::vector<TextureDesc>> windows;
+    // Command buffers being recorded, and finished command lists by handle.
+    std::unordered_map<u64, std::vector<Command>> recording;
+    /// Length of each command buffer's last list: the next recording reserves that much, so Append does not regrow
+    /// (and move every Command) a few times per list per frame.
+    std::unordered_map<u64, size_t> recorded_size;
+    std::unordered_map<u64, u32> polygon_offset_enables; ///< per NVNpolygonState
+    std::unordered_map<u64, u64> copy_row_stride;   ///< per command buffer
+    std::unordered_map<u64, u64> copy_image_stride; ///< per command buffer
+    std::unordered_map<u64, CommandList> lists;
+    std::vector<std::string> entry_names{""};
+    std::vector<std::unique_ptr<Backend>> backends;
+    std::atomic<u64> decode_matches{0};
+    std::atomic<u64> decode_mismatches{0};
+    u64 decoded_lookups = 0;
+    Core::System* system = nullptr;
+    // Shader translation (phase 4 bring-up): program addresses seen and results.
+    std::set<u64> shaders_seen;
+    std::deque<u64> shader_queue;
+    std::condition_variable shader_cv;
+    std::atomic<u64> shaders_ok{0}, shaders_failed{0};
+    std::map<std::string, u64> shader_errors;
+    std::map<int, u64> shader_stages;
+    std::unordered_map<u64, std::vector<u64>> programs;
+    std::unordered_map<u64, u64> shader_controls;
+    std::unordered_map<u32, TextureDesc> texture_ids; ///< under texture_id_lock
+    std::shared_mutex texture_id_lock;
+    /// Guest address of TIC/TSC entry 0 and the entry count (0 = not set), read
+    /// without the model lock.
+    std::atomic<u64> tic_base{0}, tsc_base{0};
+    std::atomic<u32> tic_count{0}, tsc_count{0};
+    struct DescriptorPool {
+        u64 memory_pool = 0, offset = 0;
+        u32 count = 0;
+    } texture_pool, sampler_pool;
+    std::atomic<u64> resolved_calls{0};
+    int window_origin = -1; ///< nvnDeviceSetWindowOriginMode argument (-1 = default)
+    u64 missing_handles = 0, missing_call_handles = 0;
+    u64 pool_base_agree = 0, pool_base_disagree = 0;
+    std::map<u64, u64> pool_base_offsets; ///< struct offset -> times it held the GPU base
+};
+
+State& S() {
+    // Never destroyed: hook and worker threads may still touch it during exit.
+    static State* const state = new State;
+    return *state;
+}
+
+Core::Memory::Memory& Mem(HookContext& ctx) {
+    return ctx.system.ApplicationMemory();
+}
+
+u32 Arg32(HookContext& ctx, int reg) {
+    return static_cast<u32>(ctx.x[reg]);
+}
+
+float ArgF(HookContext& ctx, int vreg) {
+    float f;
+    const u32 bits = static_cast<u32>(ctx.v[vreg][0]);
+    std::memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+// Layout of an initialized NVNtexture as the guest driver writes it, worked out
+// from MK8D 3.0.4 (see docs/NATIVE_GPU.md). It is checked against the builder on
+// every nvnTextureInitialize (decode_matches / decode_mismatches in the report),
+// so a driver with a different layout shows up instead of silently misdecoding.
+namespace TexLayout {
+constexpr u64 kGpuAddress = 0x80;
+constexpr u64 kPool = 0x10, kOffset = 0x18, kFlags = 0x20, kTarget = 0x24, kWidth = 0x28,
+              kHeight = 0x2C, kDepth = 0x30, kLevels = 0x34, kFormat = 0x38;
+}
+
+constexpr u64 kTextureGpuAddress = TexLayout::kGpuAddress;
+
+TextureDesc DecodeTextureStruct(Core::Memory::Memory& mem, u64 texture) {
+    TextureDesc d;
+    if (texture == 0) {
+        return d;
+    }
+    using namespace TexLayout;
+    d.pool = mem.Read64(texture + kPool);
+    d.offset = mem.Read64(texture + kOffset);
+    d.flags = mem.Read32(texture + kFlags);
+    d.target = mem.Read32(texture + kTarget);
+    d.width = mem.Read32(texture + kWidth);
+    d.height = mem.Read32(texture + kHeight);
+    d.depth = mem.Read32(texture + kDepth);
+    d.levels = mem.Read32(texture + kLevels);
+    d.format = mem.Read32(texture + kFormat);
+    d.valid = d.pool != 0 && d.width != 0 && d.format != 0;
+    return d;
+}
+
+/// Texture objects are tracked by address, but the engine also copies
+/// initialized structs around; those are decoded from their contents.
+TextureDesc ResolveTexture(HookContext& ctx, State& s, u64 texture) {
+    if (const auto it = s.textures.find(texture); it != s.textures.end()) {
+        return it->second;
+    }
+    ++s.decoded_lookups;
+    return DecodeTextureStruct(Mem(ctx), texture);
+}
+
+void Append(State& s, u64 cmdbuf, Command&& cmd) {
+    // Commands outside Begin/EndRecording are not part of any list; ignore them.
+    if (const auto it = s.recording.find(cmdbuf); it != s.recording.end()) {
+        it->second.push_back(std::move(cmd));
+    }
+}
+
+void FlattenList(const CommandList& list, SubmitData& out, int depth) {
+    out.lists.push_back(list);
+    for (const auto& cmd : *list) {
+        if (cmd.op == Op::Call) {
+            if (cmd.call && depth < 8) FlattenList(cmd.call, out, depth + 1);
+        } else {
+            out.commands.push_back(&cmd);
+        }
+    }
+}
+
+void Flatten(State& s, u64 handle, SubmitData& out, int depth) {
+    const auto it = s.lists.find(handle);
+    if (it == s.lists.end() || !it->second) {
+        ++s.missing_handles;
+        return;
+    }
+    FlattenList(it->second, out, depth);
+}
+
+// NVNmemoryPool: up to three GPU mappings of the storage, each written by the
+// driver at init as a (descriptor pointer, GPU base) pair. Learned from MK8D by
+// matching texture GPU addresses (+0x80 of NVNtexture) against these fields.
+constexpr u64 kPoolGpuMappings[3] = {0x40, 0x50, 0x60};
+
+bool LooksLikeGpuBase(u64 v) {
+    // Mappings are page aligned and sit in the low tens of GB of the GPU VA space.
+    return v >= 0x1'0000'0000ULL && v < 0x10'0000'0000ULL && (v & 0xFFF) == 0;
+}
+
+// NVN shader data starts with a 0x30-byte prefix; the Maxwell program (SPH) follows.
+constexpr u64 kNvnShaderPrefix = 0x30;
+
+/// GPU address -> guest memory, through the memory pools' storage.
+/// Reads [gpu, gpu+size) through the memory pools. Pieces that are not mapped to
+/// CPU-visible storage read as zero. True when at least the first byte was
+/// mapped. (Uniform and shader-constant reads are often sized generously and run
+/// past the end of a small pool; refusing those whole lost real data.)
+/// Publishes a TIC/TSC pool's guest address for lock-free descriptor reads.
+static void PublishDescriptorPool(State& s, const State::DescriptorPool& p, std::atomic<u64>& base,
+                                  std::atomic<u32>& count) {
+    const auto it = s.pools.find(p.memory_pool);
+    if (it == s.pools.end() || it->second.storage == 0) {
+        base = 0;
+        count = 0;
+        return;
+    }
+    base = it->second.storage + p.offset;
+    count = p.count;
+}
+
+static bool ReadPublishedDescriptor(State& s, const std::atomic<u64>& base, const std::atomic<u32>& count,
+                                    u32 id, void* out32) {
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    const u64 b = base.load(std::memory_order_acquire);
+    if (!system || b == 0 || id >= count.load(std::memory_order_acquire)) {
+        return false;
+    }
+    return system->ApplicationMemory().ReadBlock(b + u64{id} * 32, out32, 32);
+}
+
+/// Rebuilds State::ranges from the pools (call with State::lock held, after
+/// any change to a pool's storage or GPU mappings).
+void RebuildRanges(State& s) {
+    std::vector<State::Range> ranges;
+    ranges.reserve(s.pools.size() * 2);
+    for (const auto& [obj, pool] : s.pools) {
+        if (pool.storage == 0 || pool.size == 0) {
+            continue; // GPU-only pool: no CPU bytes to read
+        }
+        for (const u64 base : pool.gpu_bases) {
+            ranges.push_back({base, pool.size, pool.storage});
+        }
+    }
+    std::sort(ranges.begin(), ranges.end(), [](const auto& a, const auto& b) { return a.base < b.base; });
+    std::unique_lock lock{s.range_lock};
+    s.ranges = std::move(ranges);
+}
+
+bool ReadGpu(State& s, u64 gpu, void* out, size_t size, bool /*lock_held*/ = false) {
+    // A few recent hits per thread; otherwise a binary search under a shared lock.
+    // Ranges never move once a pool is initialized.
+    thread_local std::array<State::Range, 8> recent{};
+    thread_local u32 next_slot = 0;
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    auto* dst = static_cast<u8*>(out);
+    bool first_mapped = false;
+    size_t done = 0;
+    while (done < size) {
+        const u64 addr = gpu + done;
+        const State::Range* hit = nullptr;
+        for (const auto& r : recent) {
+            if (r.size && addr >= r.base && addr < r.base + r.size) {
+                hit = &r;
+                break;
+            }
+        }
+        State::Range found{};
+        if (!hit) {
+            std::shared_lock lock{s.range_lock};
+            auto it = std::upper_bound(s.ranges.begin(), s.ranges.end(), addr,
+                                       [](u64 a, const State::Range& r) { return a < r.base; });
+            // Mappings can nest: look back a few ranges for one that contains addr.
+            for (int back = 0; back < 16 && it != s.ranges.begin(); ++back) {
+                --it;
+                if (addr < it->base + it->size) {
+                    found = *it;
+                    break;
+                }
+            }
+            if (found.size) {
+                recent[next_slot] = found;
+                next_slot = (next_slot + 1) % recent.size();
+                hit = &found;
+            }
+        }
+        if (!hit || !system) {
+            std::memset(dst + done, 0, size - done);
+            break;
+        }
+        const size_t chunk = std::min<size_t>(size - done, hit->base + hit->size - addr);
+        if (!system->ApplicationMemory().ReadBlock(hit->storage + (addr - hit->base), dst + done, chunk)) {
+            std::memset(dst + done, 0, chunk);
+        } else if (done == 0) {
+            first_mapped = true;
+        }
+        done += chunk;
+    }
+    return first_mapped;
+}
+
+void ShaderWorker() {
+    auto& s = S();
+    const GpuReader reader = [](u64 gpu, void* out, size_t size) {
+        return ReadGpuMemory(gpu, out, size); // takes the model lock
+    };
+    while (true) {
+        u64 program;
+        {
+            std::unique_lock lock{s.lock};
+            s.shader_cv.wait(lock, [&s] { return !s.shader_queue.empty(); });
+            program = s.shader_queue.front();
+            s.shader_queue.pop_front();
+        }
+        const TranslatedShader t =
+            TranslateShader(reader, program, static_cast<u32>(kNvnShaderPrefix));
+        KartRe::Log("nvn-xlate program={:#x} ok={} stage={} error={}", program + kNvnShaderPrefix, t.ok,
+                    static_cast<int>(t.stage), t.error);
+        std::scoped_lock lock{s.lock};
+        if (t.ok) {
+            ++s.shaders_ok;
+            ++s.shader_stages[static_cast<int>(t.stage)];
+        } else {
+            ++s.shaders_failed;
+            ++s.shader_errors[t.error];
+        }
+    }
+}
+
+// ---- Statistics backend (shadow stage default) ------------------------------
+
+class StatsBackend final : public Backend {
+public:
+    void Submit(const SubmitData& submit) override {
+        ++submits;
+        for (const Command* c : submit.commands) {
+            ++ops[static_cast<int>(c->op)];
+            if (c->op == Op::SetRenderTargets) {
+                for (const auto& t : c->colors) {
+                    if (t.valid) {
+                        targets.insert({t.width, t.height, t.format});
+                        storages.insert({t.pool, t.offset});
+                    } else {
+                        ++unresolved_targets;
+                    }
+                }
+            }
+        }
+    }
+    void Present(const TextureDesc& t, u32 window_index) override {
+        ++frames;
+        last_present = t;
+        last_index = window_index;
+        if (frames % 600 == 0) {
+            Write();
+        }
+    }
+
+private:
+    void Write() {
+        auto& s = S();
+        std::ofstream out(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_host.txt",
+                          std::ios::trunc);
+        out << "=== nvn-host shadow ===\n"
+            << "frames presented : " << frames << "\n"
+            << "submits          : " << submits << "\n"
+            << "commands         : set_rt " << ops[0] << ", clear_color " << ops[1]
+            << ", clear_ds " << ops[2] << ", draw " << ops[3] << ", dispatch " << ops[4] << "\n"
+            << "memory pools     : " << s.pools.size() << "\n"
+            << "texture objects  : " << s.textures.size() << "\n"
+            << "command lists    : " << s.lists.size() << "\n"
+            << "windows          : " << s.windows.size() << "\n"
+            << "resolved calls   : " << s.resolved_calls << "\n"
+            << "missing handles  : submit " << s.missing_handles << ", call " << s.missing_call_handles << "\n"
+            << "struct decoder   : " << s.decode_matches << " match / " << s.decode_mismatches
+            << " mismatch at init; " << s.decoded_lookups << " lookups decoded from copies\n";
+        {
+            u64 mapped = 0;
+            for (const auto& [obj, pool] : s.pools) {
+                mapped += pool.gpu_base != 0;
+            }
+            out << "pools with GPU base: " << mapped << " / " << s.pools.size() << "\n";
+            out << "pool GPU base (+0x50) vs texture-derived: " << s.pool_base_agree << " agree / "
+                << s.pool_base_disagree << " disagree\n";
+            out << "pool struct offsets holding the GPU base:";
+            for (const auto& [off, n] : s.pool_base_offsets) {
+                out << " +" << std::hex << off << std::dec << " x" << n;
+            }
+            out << "\n";
+            out << "shaders          : " << s.shaders_ok << " translated to SPIR-V, "
+                << s.shaders_failed << " failed, " << s.shader_queue.size() << " queued\n";
+            for (const auto& [stage, n] : s.shader_stages) {
+                out << "  stage " << stage << ": " << n << "\n";
+            }
+            for (const auto& [err, n] : s.shader_errors) {
+                out << "  error x" << n << ": " << err << "\n";
+            }
+        }
+        out << "last present     : window texture #" << last_index << " " << last_present.width
+            << "x" << last_present.height << " format " << last_present.format << " pool "
+            << std::hex << last_present.pool << " offset " << last_present.offset << std::dec
+            << (last_present.valid ? "" : " (unresolved)") << "\n";
+        out << "color target storages: " << storages.size()
+            << ", unresolved binds: " << unresolved_targets << "\n";
+        out << "distinct color targets (w x h fmt): " << targets.size() << "\n";
+        for (const auto& [w, h, f] : targets) {
+            out << "  " << w << "x" << h << " fmt " << f << "\n";
+        }
+    }
+
+    u64 frames = 0, submits = 0;
+    u64 ops[32]{}; // indexed by Op; keep larger than the enum
+    std::set<std::tuple<u32, u32, u32>> targets;
+    std::set<std::pair<u64, u64>> storages;
+    u64 unresolved_targets = 0;
+    TextureDesc last_present;
+    u32 last_index = 0;
+};
+
+// ---- Handlers -----------------------------------------------------------------
+
+using Handler = std::function<void(HookContext&, State&)>;
+
+void TextureBuilderField(std::map<std::string, Handler>& h, const char* name,
+                         u32 TextureDesc::*field) {
+    h[name] = [field](HookContext& ctx, State& s) {
+        s.texture_builders[ctx.x[0]].*field = Arg32(ctx, 1);
+    };
+}
+
+u16 EntryIndex(State& s, const std::string& name) {
+    s.entry_names.push_back(name);
+    return static_cast<u16>(s.entry_names.size() - 1);
+}
+
+std::map<std::string, Handler> BuildHandlers() {
+    std::map<std::string, Handler> h;
+
+    // Memory pools
+    h["nvnMemoryPoolBuilderSetDefaults"] = [](HookContext& ctx, State& s) {
+        s.pool_builders[ctx.x[0]] = {};
+    };
+    h["nvnMemoryPoolBuilderSetStorage"] = [](HookContext& ctx, State& s) {
+        auto& b = s.pool_builders[ctx.x[0]];
+        b.storage = ctx.x[1];
+        b.size = ctx.x[2];
+    };
+    h["nvnMemoryPoolBuilderSetFlags"] = [](HookContext& ctx, State& s) {
+        s.pool_builders[ctx.x[0]].flags = Arg32(ctx, 1);
+    };
+    h["nvnMemoryPoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.pools[ctx.x[0]] = s.pool_builders[ctx.x[1]];
+        // The driver writes the pool's GPU base into the struct during init
+        // (+0x50, learned from texture-derived bases; cross-checked below).
+        RecompHooks::TrapReturn(ctx, [pool = ctx.x[0]](HookContext& ret) {
+            u64 bases[3];
+            for (int i = 0; i < 3; ++i) {
+                bases[i] = Mem(ret).Read64(pool + kPoolGpuMappings[i]);
+            }
+            auto& st = S();
+            std::scoped_lock lock{st.lock};
+            if (const auto it = st.pools.find(pool); it != st.pools.end()) {
+                it->second.gpu_bases.clear();
+                for (u64 b : bases) {
+                    if (LooksLikeGpuBase(b)) {
+                        it->second.gpu_bases.push_back(b);
+                    }
+                }
+                it->second.gpu_base = it->second.gpu_bases.empty() ? 0 : it->second.gpu_bases[0];
+                RebuildRanges(st);
+            }
+        });
+    };
+    h["nvnMemoryPoolFinalize"] = [](HookContext& ctx, State& s) {
+        s.pools.erase(ctx.x[0]);
+        RebuildRanges(s);
+    };
+
+    // Texture builders and textures
+    h["nvnTextureBuilderSetDefaults"] = [](HookContext& ctx, State& s) {
+        s.texture_builders[ctx.x[0]] = {};
+    };
+    TextureBuilderField(h, "nvnTextureBuilderSetTarget", &TextureDesc::target);
+    TextureBuilderField(h, "nvnTextureBuilderSetFormat", &TextureDesc::format);
+    TextureBuilderField(h, "nvnTextureBuilderSetWidth", &TextureDesc::width);
+    TextureBuilderField(h, "nvnTextureBuilderSetHeight", &TextureDesc::height);
+    TextureBuilderField(h, "nvnTextureBuilderSetDepth", &TextureDesc::depth);
+    TextureBuilderField(h, "nvnTextureBuilderSetLevels", &TextureDesc::levels);
+    TextureBuilderField(h, "nvnTextureBuilderSetSamples", &TextureDesc::samples);
+    TextureBuilderField(h, "nvnTextureBuilderSetFlags", &TextureDesc::flags);
+    h["nvnTextureBuilderSetSize2D"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.width = Arg32(ctx, 1);
+        b.height = Arg32(ctx, 2);
+    };
+    h["nvnTextureBuilderSetSize3D"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.width = Arg32(ctx, 1);
+        b.height = Arg32(ctx, 2);
+        b.depth = Arg32(ctx, 3);
+    };
+    h["nvnTextureBuilderSetStorage"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.pool = ctx.x[1];
+        b.offset = ctx.x[2];
+    };
+    h["nvnTextureInitialize"] = [](HookContext& ctx, State& s) {
+        TextureDesc d = s.texture_builders[ctx.x[1]];
+        d.valid = true;
+        s.textures[ctx.x[0]] = d;
+        // Calibrate the struct decoder against what the builder said.
+        RecompHooks::TrapReturn(ctx, [tex = ctx.x[0], d](HookContext& ret) {
+            const TextureDesc decoded = DecodeTextureStruct(Mem(ret), tex);
+            auto& st = S();
+            (decoded == d ? st.decode_matches : st.decode_mismatches)++;
+            // The struct also carries the storage's GPU address, which gives the
+            // pool's GPU base: what GPU-address -> guest-memory translation needs.
+            const u64 gpu = Mem(ret).Read64(tex + kTextureGpuAddress);
+            std::scoped_lock lock{st.lock};
+            if (const auto it = st.pools.find(d.pool); it != st.pools.end() && gpu > d.offset) {
+                auto& bases = it->second.gpu_bases;
+                const u64 derived = gpu - d.offset;
+                const bool agree = std::find(bases.begin(), bases.end(), derived) != bases.end();
+                (agree ? st.pool_base_agree : st.pool_base_disagree)++;
+                if (!agree && it->second.size != 0) {
+                    bases.push_back(derived); // a mapping the struct decode missed
+                    RebuildRanges(st);
+                }
+            }
+        });
