+        c.words.resize(count);
+        Mem(ctx).ReadBlock(ctx.x[2], c.words.data(), count * 4);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindVertexStreamState"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexStreams};
