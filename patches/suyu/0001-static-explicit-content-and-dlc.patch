+/// Append-only byte buffer without zero-initialization (submit-time snapshots
+/// are several MB per frame, filled while the game thread waits).
+class SnapshotBuffer {
+public:
+    size_t size() const { return used; }
+    const u8* data() const { return buf.get(); }
+    u8* data() { return buf.get(); }
+    const u8* begin() const { return buf.get(); }
+    void reserve(size_t n) {
+        if (n <= cap) return;
+        std::unique_ptr<u8[]> fresh{new u8[n]};
+        if (used) std::memcpy(fresh.get(), buf.get(), used);
+        buf = std::move(fresh);
+        cap = n;
+    }
+    /// Grows by n bytes (uninitialized); returns the offset of the new bytes.
+    size_t grow(size_t n) {
+        if (used + n > cap) reserve(std::max(cap * 2, used + n + (1u << 20)));
+        const size_t at = used;
+        used += n;
+        return at;
+    }
+
+private:
+    std::unique_ptr<u8[]> buf;
+    size_t used = 0, cap = 0;
+};
