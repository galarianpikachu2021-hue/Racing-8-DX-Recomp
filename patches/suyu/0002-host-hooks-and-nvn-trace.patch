+struct VerifyModule {
+    RecompVerifyCodeFn verify;
+    const u64* base;
+    std::string name;
+};
+std::vector<VerifyModule> g_verify_modules;
+std::atomic<bool> g_verify_pending{false};
+
+/// GW1: every module that leaves the per-block check out verifies its whole code once, here.
+void VerifyWholeImages(System& system) {
+    if (!g_verify_pending.load(std::memory_order_acquire)) return;
+    std::scoped_lock lk{g_dm_lock};
+    if (!g_verify_pending.load(std::memory_order_acquire)) return;
+    const u8* const arena = system.DeviceMemory().buffer.VirtualBasePointer();
+    // The modules learn their load bases when the first guest thread looks up its first block (ModuleBaseFor), which calls
+    // this again; before that there is nothing to compare.
+    for (const auto& m : g_verify_modules) {
+        if (m.base && *m.base == 0) return;
+    }
+    for (const auto& m : g_verify_modules) {
+        if (!arena || !m.base || m.verify(arena + *m.base) != 1) {
+            LOG_CRITICAL(Core_ARM, "The game's code in memory is not the code the recompiled module '{}' was built from (a different "
+                                   "game update, or a mod or cheat that patches code). Run Setup again to rebuild the game.", m.name);
+            if (arena && m.base) {
+                u32 w[8];
+                std::memcpy(w, arena + *m.base, sizeof(w));
+                LOG_CRITICAL(Core_ARM, "  module base {:#x}; first code words in memory: {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x}",
+                             *m.base, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+            }
+            std::fprintf(stderr, "kart-recomp: recompiled module '%s' does not match the game's code; run Setup again.\n",
+                         m.name.c_str());
+            std::abort();
+        }
+    }
+    LOG_INFO(Core_ARM, "whole-image code guard: {} module(s) verified", g_verify_modules.size());
+    g_verify_pending.store(false, std::memory_order_release);
+}
+
+void ActivateDirectMem(System& system, const void* entries, u64 address_space_max) {
+    VerifyWholeImages(system);
+    if (!g_dm_wanted.load(std::memory_order_acquire) || g_dm_active.load(std::memory_order_acquire)) return;
+    std::scoped_lock lk{g_dm_lock};
+    if (g_dm_active.load(std::memory_order_acquire)) return;
+    u8* const arena = system.DeviceMemory().buffer.VirtualBasePointer();
+    g_dm_entries.store(static_cast<const Common::PageTable::PageEntryData*>(entries));
+    g_dm_limit.store(address_space_max);
+    if (!arena || !KartRuntime::DirectMemory::Install(arena, u64{1} << 39, &DirectMemIsMapped)) {
+        LOG_CRITICAL(Core_ARM, "The game was built for direct memory but this engine has no address-space arena or fault handler "
+                               "here; rebuild the game without it");
+        std::abort();
+    }
+    // Prove the fault handler works here before the game depends on it: address 0x100 is never mapped, so a read must give zero
+    // and a write must be dropped.
+    {
+        volatile u64* const probe = reinterpret_cast<volatile u64*>(arena + 0x100);
+        const u64 before = *probe;
+        *probe = 0x5a5a5a5a;
+        if (before != 0 || *probe != 0) {
+            LOG_CRITICAL(Core_ARM, "direct memory: the fault handler self-test failed (read {:#x}, then {:#x} after a write)", before,
+                         static_cast<u64>(*probe));
+            std::abort();
+        }
+    }
+    for (const auto setter : g_dm_setters) {
+        if (setter(arena, u64{1} << 39) != 1) {
+            LOG_CRITICAL(Core_ARM, "A game module refused the direct memory arena; rebuild the game");
+            std::abort();
+        }
+    }
+    g_dm_active.store(true, std::memory_order_release);
+    LOG_INFO(Core_ARM, "direct memory: {} module(s) read the game's address space at {}", g_dm_setters.size(), fmt::ptr(arena));
+}
+} // namespace
+
+void AddRecompVerifyModule(RecompVerifyCodeFn verify, const u64* base, std::string name) {
+    std::scoped_lock lk{g_dm_lock};
+    for (const auto& m : g_verify_modules) {
+        if (m.verify == verify) return; // the loader runs twice
+    }
+    g_verify_modules.push_back({verify, base, std::move(name)});
+    g_verify_pending.store(true, std::memory_order_release);
+}
+
+void AddRecompDirectMemModule(RecompDirectMemSetter setter) {
+    std::scoped_lock lk{g_dm_lock};
+    if (std::find(g_dm_setters.begin(), g_dm_setters.end(), setter) != g_dm_setters.end()) return; // the loader runs twice
+    g_dm_setters.push_back(setter);
+    g_dm_wanted.store(true, std::memory_order_release);
+}
+
+void RecompDirectMemFrame() {
+    if (g_dm_active.load(std::memory_order_acquire)) KartRuntime::DirectMemory::ZeroSinks();
+}
+
+std::string TakeRecompDirectMemReport() {
+    if (!g_dm_active.load(std::memory_order_acquire)) return {};
+    auto& st = KartRuntime::DirectMemory::GetStats();
+    static u64 seen_r = 0, seen_w = 0, seen_o = 0;
+    const u64 r = st.unmapped_reads.load(), w = st.unmapped_writes.load(), o = st.opened_pages.load();
+    if (r == seen_r && w == seen_w && o == seen_o) return {};
+    std::string line = fmt::format("direct memory: {} unmapped pages read (as zeros), {} writes to unmapped memory dropped (latest "
+                                   "address {:#x}), {} pages opened without permission (latest {:#x}), {} sink pages in all",
+                                   r - seen_r, w - seen_w, st.last_unmapped.load(), o - seen_o, st.last_opened.load(),
+                                   st.sink_pages.load());
+    seen_r = r, seen_w = w, seen_o = o;
+#if defined(__linux__)
+    // Which code wrote: the module file and the offset in it (resolve with nm on that file).
+    if (const u64 ip = st.last_write_ip.load(); ip != 0) {
+        Dl_info info{};
+        if (dladdr(reinterpret_cast<void*>(ip), &info) != 0 && info.dli_fname) {
+            line += fmt::format("; latest dropped write from {}+{:#x}", info.dli_fname, ip - reinterpret_cast<u64>(info.dli_fbase));
+        }
+    }
+#endif
+    return line;
+}
