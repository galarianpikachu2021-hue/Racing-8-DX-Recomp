+class VulkanShadowBackend final : public Core::NvnHost::Backend {
+public:
+    bool start_fullscreen = false; ///< exclusive mode: open the window fullscreen
+    bool Start() {
+        // SDL windows (Wayland especially) must be created and owned by the thread
+        // that pumps SDL events - the main thread here. Creating it on the render
+        // thread raced SDL's Wayland event queues and corrupted the heap. The window,
+        // instance and surface are made here; only Vulkan work runs on the thread.
+        if (!InitWindowAndSurface()) {
+            return false;
+        }
+        thread = std::thread([this] {
+            pthread_setname_np(pthread_self(), "NativeRender");
+            // KARTRECOMP_PIN_RENDER=<cpu> keeps the render thread off the guest cores' CPUs.
+            if (const char* cpu = std::getenv("KARTRECOMP_PIN_RENDER")) {
+                cpu_set_t set;
+                CPU_ZERO(&set);
+                CPU_SET(std::atoi(cpu), &set);
+                pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
+            }
+            Run();
+        });
+        {
+            std::unique_lock lock{mutex};
+            cv.wait(lock, [this] { return started; });
+        }
+        if (ok) {
+            spec_thread = std::thread([this] {
+                pthread_setname_np(pthread_self(), "NativeSpec");
+                SpeculativeWorker();
+            });
+        }
+        return ok;
+    }
+
+    /// SDL event watch (main thread): tracks this window's pixel size.
+    static bool SDLCALL WatchWindow(void* self, SDL_Event* event) {
+        auto* b = static_cast<VulkanShadowBackend*>(self);
+        if (event->type == SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED && b->window &&
+            event->window.windowID == SDL_GetWindowID(b->window)) {
+            b->window_w = static_cast<u32>(std::max(event->window.data1, 0));
+            b->window_h = static_cast<u32>(std::max(event->window.data2, 0));
+        }
+        return true;
+    }
+
+    ~VulkanShadowBackend() override {
+        SDL_RemoveEventWatch(&VulkanShadowBackend::WatchWindow, this);
+        {
+            std::scoped_lock lock{spec_mutex};
+            spec_quit = true;
+        }
+        spec_cv.notify_all();
+        if (spec_thread.joinable()) {
+            spec_thread.join();
+        }
+        {
+            std::scoped_lock lock{mutex};
+            quit = true;
+        }
+        cv.notify_all();
+        idle_cv.notify_all();
+        if (thread.joinable()) {
+            thread.join();
+        }
+        if (window) {
+            SDL_DestroyWindow(window);
+        }
+    }
+
+    void Submit(const Core::NvnHost::SubmitData& submit) override {
+        const auto& commands = submit.commands;
+        building.lists.insert(building.lists.end(), submit.lists.begin(), submit.lists.end());
+        if (KartRe::Enabled() && submit_count > 2350 && submit_logs < 40) {
+            std::string seq;
+            for (size_t i = 0; i < commands.size(); ++i) {
+                const Command* c = commands[i];
+                if (c->op == Op::BlendColor && c->rgba[0] > 0.1f && c->rgba[0] < 0.31f) {
+                    seq += fmt::format(" [{}:color {:.3}]", i, c->rgba[0]);
+                }
+                if (c->op == Op::BindBlend && c->raw == 0x61026102110c0000ULL) {
+                    seq += fmt::format(" [{}:constblend]", i);
+                }
+            }
+            if (!seq.empty()) {
+                ++submit_logs;
+                KartRe::Log("submit #{} into frame-building (cmds so far {}) n={}:{}", submit_count, building.commands.size(),
+                            commands.size(), seq);
+            }
+        }
+        ++submit_count;
+        const auto t_submit = std::chrono::steady_clock::now();
+        u64 snap_bytes = 0, snap_ns = 0;
+        building.commands.reserve(building.commands.size() + commands.size());
+        ++building.submits;
+        // The same buffer bound by many draws is read once per submit: guest memory cannot change while this call runs,
+        // so every bind of that range shares one copy (and, downstream, one upload and one descriptor set).
+        snap_dedupe.clear();
+        for (const Command* c : commands) {
+            building.commands.push_back({c});
+            building.guest_draws += c->op == Op::Draw;
+            FrameCommand& copy = building.commands.back();
+            if (c->op == Op::UpdateUniformBuffer && c->address) {
+                // Seed for the in-stream update shadow: the buffer as of submit time.
+                const u64 bytes = std::min<u64>(c->size ? c->size : 0x10000, 0x10000);
+                const size_t at = building.snapshot.grow((bytes + 15) & ~u64{15});
+                const auto t_snap = std::chrono::steady_clock::now();
+                Core::NvnHost::ReadGpuMemoryInSubmit(c->address, building.snapshot.data() + at, bytes);
+                snap_ns += static_cast<u64>((std::chrono::steady_clock::now() - t_snap).count());
+                snap_bytes += bytes;
+                copy.snap = at + 1;
+                copy.snap_size = bytes;
+            } else if (c->op == Op::CopyBufferToTexture && c->address && c->words.size() >= 10) {
+                // The source is rewritten every frame (movie planes): copy it now.
+                const u64 bytes = CopySourceBytes(*c);
+                if (bytes && bytes <= (64u << 20)) {
+                    const size_t at = building.snapshot.grow((bytes + 15) & ~u64{15});
+                    Core::NvnHost::ReadGpuMemoryInSubmit(c->address, building.snapshot.data() + at, bytes);
+                    copy.snap = at + 1;
+                    copy.snap_size = bytes;
+                }
+            } else if (c->op == Op::BindVertexBuffer && c->address && c->size && c->size <= kVertexSnapshotMax) {
+                // Small vertex buffers are per-frame CPU data (particle and effect
+                // instances): the game rewrites them before the render thread runs.
+                const u64 bytes = c->size;
+                const auto [at, fresh] = SnapshotOnce(snap_dedupe, c->address, bytes);
+                if (fresh) {
+                    Core::NvnHost::ReadGpuMemoryInSubmit(c->address, building.snapshot.data() + at, bytes);
+                }
+                copy.snap = at + 1;
+                copy.snap_size = bytes;
+            } else if ((c->op == Op::BindUniformBuffer || c->op == Op::BindStorageBuffer) && c->address) {
+                const u64 bytes = std::min<u64>(c->size ? c->size : 0x10000, 0x10000);
+                const auto [at, fresh] = SnapshotOnce(snap_dedupe, c->address, bytes);
+                if (fresh) {
+                    const auto t_snap = std::chrono::steady_clock::now();
+                    Core::NvnHost::ReadGpuMemoryInSubmit(c->address, building.snapshot.data() + at, bytes);
+                    snap_ns += static_cast<u64>((std::chrono::steady_clock::now() - t_snap).count());
+                    snap_bytes += bytes;
+                }
+                copy.snap = at + 1;
+                copy.snap_size = bytes;
+            }
+        }
+        submit_ns += static_cast<u64>((std::chrono::steady_clock::now() - t_submit).count());
+        submit_snap_ns += snap_ns;
+        submit_snap_bytes += snap_bytes;
+        ++submit_snap_count;
+    }
+
+    /// Offset of the snapshot copy of [address, address + bytes) within this submit; fresh when the caller must fill it.
+    struct SnapSeen {
+        u64 address = 0, bytes = 0;
+        size_t at = 0;
+    };
+    std::pair<size_t, bool> SnapshotOnce(std::unordered_map<u64, SnapSeen>& seen, u64 address, u64 bytes) {
+        const u64 key = address * 0x9E3779B97F4A7C15ULL ^ bytes;
+        if (const auto it = seen.find(key); it != seen.end() && it->second.address == address && it->second.bytes == bytes) {
+            return {it->second.at, false};
+        }
+        const size_t at = building.snapshot.grow((bytes + 15) & ~u64{15});
+        seen[key] = {address, bytes, at};
+        return {at, true};
+    }
+
+    void Present(const TextureDesc& texture, u32) override {
+        if (++presents_seen % 300 == 0) {
+            LOG_INFO(Frontend, "nvn-host vulkan: submit per frame {:.2f} ms (snapshots {:.2f} ms, {:.1f} MB, {:.0f} binds)",
+                     static_cast<double>(submit_ns) / 300e6, static_cast<double>(submit_snap_ns) / 300e6,
+                     static_cast<double>(submit_snap_bytes) / 300e6, static_cast<double>(submit_snap_count) / 300.0);
+            submit_ns = submit_snap_ns = submit_snap_bytes = submit_snap_count = 0;
+        }
+        building.present = texture;
+        building.queued = std::chrono::steady_clock::now();
+        {
+            std::scoped_lock lock{mutex};
+            // Shadow mode never stalls the game: keep at most two frames queued and
+            // drop the oldest. As the only renderer (exclusive mode) nothing is
+            // dropped - one-time passes such as the color LUT live in single frames -
+            // and Throttle() paces the game instead.
+            if (!Core::NvnHost::Exclusive() && queue.size() >= 2) {
+                queue.pop_front();
+                ++dropped;
+            }
+            last_snapshot_size = building.snapshot.size();
+            queue.push_back(std::move(building));
+        }
+        building = {};
+        building.snapshot.reserve(last_snapshot_size + (last_snapshot_size >> 2) + (1u << 20));
+        cv.notify_one();
+    }
+
+    /// Bytes a buffer-to-texture copy reads: rows at the row stride (packed when
+    /// 0), slices at the image stride.
+    static u64 CopySourceBytes(const Command& c) {
+        const auto info = MapFormat(c.colors.empty() ? 0 : c.colors[0].format);
+        if (!info || info->depth) {
+            return 0;
+        }
+        const u64 texel = TexelClass(info->format) & 0xFF;
+        const u64 w = c.words[3], h = c.words[4], d = c.words[5];
+        const u64 row = c.words[8] ? c.words[8] : w * texel;
+        const u64 image = c.words[9] ? c.words[9] : row * h;
+        return image * (d - 1) + row * (h - 1) + w * texel;
+    }
+
+    void Throttle() override {
+        if (!Core::NvnHost::Exclusive()) {
+            return;
+        }
+        const auto t0 = std::chrono::steady_clock::now();
+        std::unique_lock lock{mutex};
+        // Like a two-deep swap queue; the timeout keeps a stuck renderer from
+        // freezing the game for good.
+        idle_cv.wait_for(lock, std::chrono::seconds(2), [this] { return quit || queue.size() <= 1; });
+        throttle_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                            std::chrono::steady_clock::now() - t0).count());
+    }
+
+private:
+    // ------------------------------------------------------------------ thread
+    void Run() {
+        ok = Init();
+        {
+            std::scoped_lock lock{mutex};
+            started = true;
+        }
+        cv.notify_all();
+        if (!ok) {
+            return;
+        }
+        while (true) {
+            Frame frame;
+            {
+                std::unique_lock lock{mutex};
+                cv.wait(lock, [this] { return quit || !queue.empty(); });
+                if (quit) {
+                    break;
+                }
+                frame = std::move(queue.front());
+                queue.pop_front();
+            }
+            idle_cv.notify_all();
+            const auto t_start = std::chrono::steady_clock::now();
+            Render(frame);
+            // KARTRECOMP_RENDER_PAD_MS=<ms>: experiment, makes every frame take that much longer on the render thread.
+            static const double pad_ms = [] {
+                const char* v = std::getenv("KARTRECOMP_RENDER_PAD_MS");
+                return v ? std::atof(v) : 0.0;
+            }();
+            if (pad_ms > 0) {
+                const auto until = std::chrono::steady_clock::now() + std::chrono::duration<double, std::milli>(pad_ms);
+                while (std::chrono::steady_clock::now() < until) {
+                }
+            }
+            // KARTRECOMP_FRAME_TRACE=<first frame>: one line per frame for 240 frames - when the guest presented it
+            // relative to the last one, how long it sat queued, and how long the render thread took.
+            static const long trace_from = [] {
+                const char* v = std::getenv("KARTRECOMP_FRAME_TRACE");
+                return v ? std::atol(v) : -1L;
+            }();
+            static auto last_queued = frame.queued;
+            if (trace_from >= 0 && static_cast<long>(frames) >= trace_from && static_cast<long>(frames) < trace_from + 240) {
+                const auto ms = [](auto d) { return std::chrono::duration<double, std::milli>(d).count(); };
+                LOG_INFO(Frontend, "frame trace {}: guest interval {:.1f} ms, queued {:.1f} ms, render {:.1f} ms, draws {}",
+                         frames, ms(frame.queued - last_queued), ms(t_start - frame.queued),
+                         ms(std::chrono::steady_clock::now() - t_start), frame.guest_draws);
+            }
+            last_queued = frame.queued;
+        }
+        Shutdown();
+    }
+
+    bool Fail(const char* what) {
+        LOG_ERROR(Frontend, "nvn-host vulkan: {}", what);
+        return false;
+    }
+
+    // ------------------------------------------------------------------- setup
+    bool InitWindowAndSurface() {
+        // Exclusive mode: this is the game's window. Shadow mode: a debug window
+        // beside the emulated output.
+        const bool exclusive = Core::NvnHost::Exclusive();
+        window = SDL_CreateWindow(exclusive ? "Mario Kart 8 Deluxe - KartRecomp" : "KartRecomp - native GPU (shadow)",
+                                  exclusive ? 1280 : 960, exclusive ? 720 : 540,
+                                  SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE |
+                                      (exclusive && start_fullscreen ? SDL_WINDOW_FULLSCREEN : 0));
+        if (!window) {
+            return Fail(SDL_GetError());
+        }
+        vk.vkGetInstanceProcAddr =
+            reinterpret_cast<PFN_vkGetInstanceProcAddr>(SDL_Vulkan_GetVkGetInstanceProcAddr());
+        if (!vk.vkGetInstanceProcAddr) {
+            return Fail("no vkGetInstanceProcAddr");
+        }
+        vk.vkCreateInstance = reinterpret_cast<PFN_vkCreateInstance>(
+            vk.vkGetInstanceProcAddr(nullptr, "vkCreateInstance"));
+        Uint32 ext_count = 0;
+        const char* const* exts = SDL_Vulkan_GetInstanceExtensions(&ext_count);
+        VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+        app.pApplicationName = "KartRecomp native GPU";
+        app.apiVersion = VK_API_VERSION_1_3;
+        VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+        ici.pApplicationInfo = &app;
+        // VK_EXT_swapchain_colorspace (when the loader has it) lists the HDR / wide-gamut surface formats a compositor offers.
+        std::vector<const char*> instance_exts(exts, exts + ext_count);
+        {
+            const auto enumerate = reinterpret_cast<PFN_vkEnumerateInstanceExtensionProperties>(
+                vk.vkGetInstanceProcAddr(nullptr, "vkEnumerateInstanceExtensionProperties"));
+            u32 n = 0;
+            if (enumerate && enumerate(nullptr, &n, nullptr) == VK_SUCCESS && n) {
+                std::vector<VkExtensionProperties> props(n);
+                enumerate(nullptr, &n, props.data());
+                for (const auto& e : props) {
+                    if (std::strcmp(e.extensionName, "VK_EXT_swapchain_colorspace") == 0) {
+                        instance_exts.push_back("VK_EXT_swapchain_colorspace");
+                        have_colorspace_ext = true;
+                    }
+                }
+            }
+        }
+        ici.enabledExtensionCount = static_cast<u32>(instance_exts.size());
+        ici.ppEnabledExtensionNames = instance_exts.data();
+        if (vk.vkCreateInstance(&ici, nullptr, &instance) != VK_SUCCESS) {
+            return Fail("vkCreateInstance failed");
+        }
+#define KR_LOAD_I(fn) vk.fn = reinterpret_cast<PFN_##fn>(vk.vkGetInstanceProcAddr(instance, #fn));
+        KR_VK_INSTANCE_FNS(KR_LOAD_I)
+#undef KR_LOAD_I
+        {
+            int w = 0, h = 0;
+            SDL_GetWindowSizeInPixels(window, &w, &h);
+            window_w = static_cast<u32>(std::max(w, 0));
+            window_h = static_cast<u32>(std::max(h, 0));
+            SDL_AddEventWatch(&VulkanShadowBackend::WatchWindow, this);
+        }
+        if (!SDL_Vulkan_CreateSurface(window, instance, nullptr, &surface)) {
+            return Fail(SDL_GetError());
+        }
+        return true;
+    }
+
+    bool Init() {
+        u32 count = 0;
+        vk.vkEnumeratePhysicalDevices(instance, &count, nullptr);
+        std::vector<VkPhysicalDevice> devices(count);
+        vk.vkEnumeratePhysicalDevices(instance, &count, devices.data());
+        for (VkPhysicalDevice pd : devices) {
+            u32 qcount = 0;
+            vk.vkGetPhysicalDeviceQueueFamilyProperties(pd, &qcount, nullptr);
+            std::vector<VkQueueFamilyProperties> qprops(qcount);
+            vk.vkGetPhysicalDeviceQueueFamilyProperties(pd, &qcount, qprops.data());
+            for (u32 i = 0; i < qcount; ++i) {
+                VkBool32 present = VK_FALSE;
+                vk.vkGetPhysicalDeviceSurfaceSupportKHR(pd, i, surface, &present);
+                if ((qprops[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) && present) {
+                    physical = pd;
+                    family = i;
+                    break;
+                }
+            }
+            if (physical) {
+                break;
+            }
+        }
+        if (!physical) {
+            return Fail("no device can render and present to this window");
+        }
+        VkPhysicalDeviceProperties props;
+        vk.vkGetPhysicalDeviceProperties(physical, &props);
+        vk.vkGetPhysicalDeviceMemoryProperties(physical, &memory_props);
+        ubo_align = std::max<u64>(props.limits.minUniformBufferOffsetAlignment, 16);
+        timestamp_period = props.limits.timestampPeriod;
+        ssbo_align = std::max<u64>(props.limits.minStorageBufferOffsetAlignment, 16);
+
+        // The translated SPIR-V uses whatever the profile allowed (int8/16/64,
+        // fp16, ...): enable every feature the device supports.
+        VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+        VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+        VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+        VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+        f2.pNext = &f11;
+        f11.pNext = &f12;
+        f12.pNext = &f13;
+        vk.vkGetPhysicalDeviceFeatures2(physical, &f2);
+        if (!f13.dynamicRendering) {
+            return Fail("device lacks dynamic rendering");
+        }
+        f2.features.robustBufferAccess = VK_FALSE;
+        anisotropy_supported = f2.features.samplerAnisotropy == VK_TRUE;
+        f13.robustImageAccess = VK_FALSE;
+
+        const float priority = 1.0f;
+        VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+        qci.queueFamilyIndex = family;
+        qci.queueCount = 1;
+        qci.pQueuePriorities = &priority;
+        // Extensions NVIDIA's NGX (DLSS) needs on the device; enabled only where the driver lists them (NVIDIA GPUs), so the DLSS
+        // plugin can run. Harmless elsewhere: they are simply absent.
+        std::vector<const char*> dev_exts{VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+        {
+            u32 n = 0;
+            vk.vkEnumerateDeviceExtensionProperties(physical, nullptr, &n, nullptr);
+            std::vector<VkExtensionProperties> have(n);
+            vk.vkEnumerateDeviceExtensionProperties(physical, nullptr, &n, have.data());
+            for (const char* want : {"VK_NVX_binary_import", "VK_NVX_image_view_handle", "VK_KHR_push_descriptor"}) {
+                if (std::any_of(have.begin(), have.end(), [&](const auto& e) { return std::strcmp(e.extensionName, want) == 0; })) {
+                    dev_exts.push_back(want);
+                }
+            }
+        }
+        VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+        dci.pNext = &f2;
+        dci.queueCreateInfoCount = 1;
+        dci.pQueueCreateInfos = &qci;
+        dci.enabledExtensionCount = static_cast<u32>(dev_exts.size());
+        dci.ppEnabledExtensionNames = dev_exts.data();
+        if (vk.vkCreateDevice(physical, &dci, nullptr, &device) != VK_SUCCESS) {
+            return Fail("vkCreateDevice failed");
+        }
+#define KR_LOAD_D(fn) vk.fn = reinterpret_cast<PFN_##fn>(vk.vkGetDeviceProcAddr(device, #fn));
+        KR_VK_DEVICE_FNS(KR_LOAD_D)
+#undef KR_LOAD_D
+        vk.vkGetDeviceQueue(device, family, 0, &queue_handle);
+        VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        cpci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        cpci.queueFamilyIndex = family;
+        vk.vkCreateCommandPool(device, &cpci, nullptr, &pool);
+        VkCommandBufferAllocateInfo cbai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cbai.commandPool = pool;
+        cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cbai.commandBufferCount = 1;
+        vk.vkAllocateCommandBuffers(device, &cbai, &cmd);
+        VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        vk.vkCreateFence(device, &fci, nullptr, &fence);
+        VkSemaphoreCreateInfo sci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        vk.vkCreateSemaphore(device, &sci, nullptr, &acquired);
+        vk.vkCreateSemaphore(device, &sci, nullptr, &rendered);
+        {
+            VkQueryPoolCreateInfo gqci{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+            gqci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+            gqci.queryCount = 4;
+            vk.vkCreateQueryPool(device, &gqci, nullptr, &gpu_queries);
+        }
+        vk.vkAllocateCommandBuffers(device, &cbai, &cmd2);
+        vk.vkCreateFence(device, &fci, nullptr, &fence2);
+        vk.vkCreateSemaphore(device, &sci, nullptr, &acquired2);
+        vk.vkCreateSemaphore(device, &sci, nullptr, &rendered2);
+        if (!CreateUploadRing() || !CreateDescriptorPool() || !CreateSamplers() ||
+            !CreateDummyTextures() || !CreateSwapchain()) {
+            return false;
+        }
+        LoadPipelineCache();
+        LOG_INFO(Frontend, "nvn-host vulkan: shadow window on {}", props.deviceName);
+        return true;
+    }
+
+    std::optional<u32> FindMemory(u32 type_bits, VkMemoryPropertyFlags want) {
+        for (u32 i = 0; i < memory_props.memoryTypeCount; ++i) {
+            if ((type_bits & (1u << i)) &&
+                (memory_props.memoryTypes[i].propertyFlags & want) == want) {
+                return i;
+            }
+        }
+        return std::nullopt;
+    }
+
+    bool CreateUploadRing() {
+        VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        bci.size = kRingSize;
+        bci.usage = VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+                    VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                    VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+        if (vk.vkCreateBuffer(device, &bci, nullptr, &ring) != VK_SUCCESS) {
+            return Fail("upload ring buffer");
+        }
+        VkMemoryRequirements req;
+        vk.vkGetBufferMemoryRequirements(device, ring, &req);
+        const auto type = FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                             VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        if (!type) {
+            return Fail("no host-visible memory");
+        }
+        VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = *type;
+        if (vk.vkAllocateMemory(device, &mai, nullptr, &ring_memory) != VK_SUCCESS) {
+            return Fail("upload ring memory");
+        }
+        vk.vkBindBufferMemory(device, ring, ring_memory, 0);
+        void* mapped = nullptr;
+        vk.vkMapMemory(device, ring_memory, 0, kRingSize, 0, &mapped);
+        ring_ptr = static_cast<u8*>(mapped);
+        return true;
+    }
+
+    bool CreateDescriptorPool() {
+        const VkDescriptorPoolSize sizes[] = {
+            {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 65536},
+            {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 16384},
+            {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 65536},
+        };
+        VkDescriptorPoolCreateInfo dpci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        dpci.maxSets = 8192;
+        dpci.poolSizeCount = static_cast<u32>(std::size(sizes));
+        dpci.pPoolSizes = sizes;
+        return vk.vkCreateDescriptorPool(device, &dpci, nullptr, &descriptor_pool) == VK_SUCCESS ||
+               Fail("descriptor pool");
+    }
+
+    bool CreateSamplers() {
+        VkSamplerCreateInfo sci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        sci.magFilter = VK_FILTER_LINEAR;
+        sci.minFilter = VK_FILTER_LINEAR;
+        sci.mipmapMode = VK_SAMPLER_MIPMAP_MODE_LINEAR;
+        sci.addressModeU = sci.addressModeV = sci.addressModeW = VK_SAMPLER_ADDRESS_MODE_REPEAT;
+        sci.maxLod = VK_LOD_CLAMP_NONE;
+        if (vk.vkCreateSampler(device, &sci, nullptr, &sampler) != VK_SUCCESS) {
+            return Fail("sampler");
+        }
+        sci.compareEnable = VK_TRUE;
+        sci.compareOp = VK_COMPARE_OP_LESS_OR_EQUAL;
+        sci.addressModeU = sci.addressModeV = sci.addressModeW =
+            VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        return vk.vkCreateSampler(device, &sci, nullptr, &shadow_sampler) == VK_SUCCESS ||
+               Fail("shadow sampler");
+    }
+
+    /// Texture LOD bias for the 3D scene, two parts.
+    /// Per output resolution step, 1080p being the default: -1.0 for each step above it (1440p -1, 4K -2), whatever the
+    /// upscaler. The steps are the overlay's resolutions (1080, 1440, 2160), not a log curve.
+    /// Per render scale: a scene rendered at a fraction of the output picks mip levels for the lower resolution, so a temporal
+    /// upscaler gets less detail than the output could hold; shift by log2(ratio), and half a step more with jitter.
+    float SceneLodBias() const {
+        static const bool res_steps = [] { const char* v = std::getenv("KARTRECOMP_LOD_RES"); return !v || *v != '0'; }();
+        if (post_phase) return 0.0f;
+        float bias = 0.0f;
+        if (res_steps && out_height > 1080) {
+            bias -= out_height > 1440 ? 2.0f : 1.0f;
+        }
+        if (split_mode && upscaler.Enabled() && scene_ratio < 0.999f) {
+            bias += std::log2(std::max(scene_ratio, 0.1f)) - (jitter_frame ? 0.5f : 0.0f);
+        }
+        return std::round(std::max(bias, -3.0f) * 4.0f) / 4.0f;
+    }
+
+    /// Whether a guest texture is a surface material (colour map on a model): small 2D colour formats. The LOD shift is for these
+    /// only. Applied to everything it broke the lighting and shadows (baked light-map atlases, shadow masks, normal maps and
+    /// look-up tables are data, and the game picks their detail level for itself).
+    static bool IsMaterialTexture(const TextureDesc& t) {
+        if (!t.valid || t.target != 1 || t.width > 2048 || t.height > 2048) return false;
+        switch (t.format) {
+        case 37: case 56:         // RGBA8, sRGB
+        case 65: case 66: case 67: case 68: // BC1, BC2, BC3
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    /// The game's sampler (TSC) for a texture handle (sampler ID in bits 20..31),
+    /// as a cached Vulkan sampler. Falls back to the default sampler when the
+    /// descriptor cannot be read.
+    VkSampler GameSampler(u64 handle, bool depth_compare, bool lod_zero = false, bool material = false) {
+        static const bool old_shadow = [] {
+            const char* t = std::getenv("KARTRECOMP_NATIVE_SIMPLE");
+            return t && std::strstr(t, "oldshadow");
+        }();
+        if (depth_compare && old_shadow) {
+            return shadow_sampler;
+        }
+        Tegra::Texture::TSCEntry tsc{};
+        const u32 id = static_cast<u32>((handle >> 20) & 0xFFF);
+        if (!Core::NvnHost::ReadSamplerDescriptor(id, &tsc)) {
+            return depth_compare ? shadow_sampler : sampler;
+        }
+        u64 key = tsc.raw[0] * 0x9E3779B97F4A7C15ULL ^ tsc.raw[1] * 0xC2B2AE3D27D4EB4FULL ^
+                  tsc.raw[2] * 31 ^ tsc.raw[3] ^ (depth_compare ? 1 : 0) ^ (lod_zero ? 2 : 0);
+        // Textures of the 3D scene sample sharper when it renders below the output resolution (see SceneLodBias).
+        const float lod_shift = !material || depth_compare || lod_zero || tsc.mipmap_filter == Tegra::Texture::TextureMipmapFilter::None
+                                    ? 0.0f : SceneLodBias();
+        key ^= static_cast<u64>(static_cast<s64>(std::lround(lod_shift * 4.0f)) + 64) * 0xD6E8FEB86659FD93ULL;
+        if (const auto it = game_samplers.find(key); it != game_samplers.end()) {
+            return it->second;
+        }
+        using namespace Tegra::Texture;
+        // Same mapping as suyu's MaxwellToVK (GL-style "clamp" is border for linear).
+        const bool linear_mag = tsc.mag_filter == TextureFilter::Linear;
+        const auto wrap = [linear_mag](WrapMode m) {
+            switch (m) {
+            case WrapMode::Wrap: return VK_SAMPLER_ADDRESS_MODE_REPEAT;
+            case WrapMode::Mirror: return VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT;
+            case WrapMode::ClampToEdge: return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+            case WrapMode::Border: return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER;
+            case WrapMode::Clamp:
+                return linear_mag ? VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER
+                                  : VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+            default: return VK_SAMPLER_ADDRESS_MODE_MIRROR_CLAMP_TO_EDGE;
+            }
+        };
+        const auto filter = [](TextureFilter f) {
+            return f == TextureFilter::Nearest ? VK_FILTER_NEAREST : VK_FILTER_LINEAR;
+        };
+        VkSamplerCreateInfo sci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        sci.magFilter = filter(tsc.mag_filter);
+        sci.minFilter = filter(tsc.min_filter);
+        sci.mipmapMode = tsc.mipmap_filter == TextureMipmapFilter::Linear ? VK_SAMPLER_MIPMAP_MODE_LINEAR
+                                                                           : VK_SAMPLER_MIPMAP_MODE_NEAREST;
+        sci.addressModeU = wrap(tsc.wrap_u);
+        sci.addressModeV = wrap(tsc.wrap_v);
+        sci.addressModeW = wrap(tsc.wrap_p);
+        sci.mipLodBias = tsc.LodBias() + lod_shift;
+        // No mipmap filter means level 0 only (minLod 0, maxLod 0.25, as suyu does).
+        const bool no_mips = tsc.mipmap_filter == TextureMipmapFilter::None;
+        sci.minLod = no_mips ? 0.0f : tsc.MinLod();
+        sci.maxLod = no_mips ? 0.25f : std::max(tsc.MaxLod(), sci.minLod);
+        if (lod_zero) {
+            sci.minLod = 0.0f;
+            sci.maxLod = 0.0f;
+        }
+        const float aniso = tsc.MaxAnisotropy();
+        if (anisotropy_supported && aniso > 1.0f) {
+            sci.anisotropyEnable = VK_TRUE;
+            sci.maxAnisotropy = std::min(aniso, 16.0f);
+        }
+        if (depth_compare) {
+            KartRe::Log("compare sampler: tsc enabled={} func={} wrap={},{} filter {} {} raw {:016x} {:016x}",
+                        tsc.depth_compare_enabled.Value(), static_cast<u32>(tsc.depth_compare_func.Value()),
+                        static_cast<u32>(tsc.wrap_u.Value()), static_cast<u32>(tsc.wrap_v.Value()),
+                        static_cast<u32>(tsc.mag_filter.Value()), static_cast<u32>(tsc.min_filter.Value()),
+                        tsc.raw[0], tsc.raw[1]);
+            sci.compareEnable = VK_TRUE;
+            static constexpr VkCompareOp ops[] = {
+                VK_COMPARE_OP_NEVER,         VK_COMPARE_OP_LESS,      VK_COMPARE_OP_EQUAL,
+                VK_COMPARE_OP_LESS_OR_EQUAL, VK_COMPARE_OP_GREATER,   VK_COMPARE_OP_NOT_EQUAL,
+                VK_COMPARE_OP_GREATER_OR_EQUAL, VK_COMPARE_OP_ALWAYS,
+            };
+            sci.compareOp = tsc.depth_compare_enabled ? ops[static_cast<u32>(tsc.depth_compare_func.Value()) & 7]
+                                                      : VK_COMPARE_OP_LESS_OR_EQUAL;
+            if (const char* t = std::getenv("KARTRECOMP_NATIVE_SIMPLE"); t && std::strstr(t, "cmpgreater")) {
+                sci.compareOp = VK_COMPARE_OP_GREATER_OR_EQUAL;
+            }
+        }
+        // Border colors: the closest standard one (custom colors need an extension).
+        const auto bc = tsc.BorderColor();
+        const bool opaque = bc[3] > 0.5f;
+        const bool white = bc[0] > 0.5f && bc[1] > 0.5f && bc[2] > 0.5f;
+        sci.borderColor = opaque ? (white ? VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE : VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK)
+                                 : VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK;
+        VkSampler out = VK_NULL_HANDLE;
+        if (vk.vkCreateSampler(device, &sci, nullptr, &out) != VK_SUCCESS) {
+            out = depth_compare ? shadow_sampler : sampler;
+        } else {
+            game_samplers.emplace(key, out);
+        }
+        return out;
+    }
+
+    /// White stand-ins until real texture upload exists: one per view type.
+    bool CreateDummyTextures() {
+        const auto make = [&](VkImageViewType view_type, u32 layers, VkImageCreateFlags flags,
+                              VkImageType type, u32 depth, Image& out) {
+            VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+            ici.flags = flags;
+            ici.imageType = type;
+            ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+            ici.extent = {1, 1, depth};
+            ici.mipLevels = 1;
+            ici.arrayLayers = layers;
+            ici.samples = VK_SAMPLE_COUNT_1_BIT;
+            ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+            ici.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+            if (vk.vkCreateImage(device, &ici, nullptr, &out.image) != VK_SUCCESS) {
+                return false;
+            }
+            VkMemoryRequirements req;
+            vk.vkGetImageMemoryRequirements(device, out.image, &req);
+            VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            mai.allocationSize = req.size;
+            mai.memoryTypeIndex =
+                FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT).value_or(0);
+            vk.vkAllocateMemory(device, &mai, nullptr, &out.memory);
+            vk.vkBindImageMemory(device, out.image, out.memory, 0);
+            VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+            vci.image = out.image;
+            vci.viewType = view_type;
+            vci.format = VK_FORMAT_R8G8B8A8_UNORM;
+            vci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, layers};
+            vk.vkCreateImageView(device, &vci, nullptr, &out.sample_view);
+            out.info = {VK_FORMAT_R8G8B8A8_UNORM, false};
+            out.width = out.height = 1;
+            dummy_layers.push_back({out.image, layers});
+            return true;
+        };
+        // Depth stand-in for compare samplers (shadow maps): cleared to 1.0 so every
+        // compare passes, i.e. unshadowed, until real shadow cascades are bound.
+        {
+            VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+            ici.imageType = VK_IMAGE_TYPE_2D;
+            ici.format = VK_FORMAT_D32_SFLOAT;
+            ici.extent = {1, 1, 1};
+            ici.mipLevels = 1;
+            ici.arrayLayers = 1;
+            ici.samples = VK_SAMPLE_COUNT_1_BIT;
+            ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+            ici.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+            vk.vkCreateImage(device, &ici, nullptr, &dummy_depth.image);
+            VkMemoryRequirements req;
+            vk.vkGetImageMemoryRequirements(device, dummy_depth.image, &req);
+            VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            mai.allocationSize = req.size;
+            mai.memoryTypeIndex =
+                FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT).value_or(0);
+            vk.vkAllocateMemory(device, &mai, nullptr, &dummy_depth.memory);
+            vk.vkBindImageMemory(device, dummy_depth.image, dummy_depth.memory, 0);
+            VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+            vci.image = dummy_depth.image;
+            vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+            vci.format = VK_FORMAT_D32_SFLOAT;
+            vci.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1};
+            vk.vkCreateImageView(device, &vci, nullptr, &dummy_depth.sample_view);
+            vci.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            vk.vkCreateImageView(device, &vci, nullptr, &dummy_depth_array_view);
+            dummy_depth.info = {VK_FORMAT_D32_SFLOAT, true};
+        }
+        return (make(VK_IMAGE_VIEW_TYPE_2D, 1, 0, VK_IMAGE_TYPE_2D, 1, dummy_2d) &&
+                make(VK_IMAGE_VIEW_TYPE_2D_ARRAY, 1, 0, VK_IMAGE_TYPE_2D, 1, dummy_2d_array) &&
+                make(VK_IMAGE_VIEW_TYPE_CUBE, 6, VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT,
+                     VK_IMAGE_TYPE_2D, 1, dummy_cube) &&
+                make(VK_IMAGE_VIEW_TYPE_CUBE_ARRAY, 6, VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT,
+                     VK_IMAGE_TYPE_2D, 1, dummy_cube_array) &&
+                make(VK_IMAGE_VIEW_TYPE_3D, 1, 0, VK_IMAGE_TYPE_3D, 1, dummy_3d)) ||
+               Fail("dummy textures");
+    }
+
+    void DestroyPresentPipelines() {
+        if (ov_pipeline) vk.vkDestroyPipeline(device, ov_pipeline, nullptr);
+        ov_pipeline = VK_NULL_HANDLE;
+        if (hdr_pipeline) vk.vkDestroyPipeline(device, hdr_pipeline, nullptr);
+        hdr_pipeline = VK_NULL_HANDLE;
+        hdr_failed = false;
+    }
+
+    bool CreateSwapchain() {
+        VkSurfaceCapabilitiesKHR caps;
+        vk.vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physical, surface, &caps);
+        u32 nformats = 0;
+        vk.vkGetPhysicalDeviceSurfaceFormatsKHR(physical, surface, &nformats, nullptr);
+        std::vector<VkSurfaceFormatKHR> formats(nformats);
+        vk.vkGetPhysicalDeviceSurfaceFormatsKHR(physical, surface, &nformats, formats.data());
+        static bool formats_logged = false;
+        if (!formats_logged) {
+            formats_logged = true;
+            std::string list;
+            for (const auto& f : formats) list += fmt::format(" {}/{}", static_cast<int>(f.format), static_cast<int>(f.colorSpace));
+            LOG_INFO(Frontend, "surface formats (format/colour space; colour space 0 = sRGB, 1000104002 = scRGB linear, 1000104008 = HDR10 PQ){}{}",
+                     list, have_colorspace_ext ? "" : " [VK_EXT_swapchain_colorspace not available]");
+        }
+        VkSurfaceFormatKHR chosen = formats.empty() ? VkSurfaceFormatKHR{} : formats[0];
+        for (const auto& f : formats) {
+            if (f.format == VK_FORMAT_B8G8R8A8_UNORM || f.format == VK_FORMAT_R8G8B8A8_UNORM) {
+                chosen = f;
+                break;
+            }
+        }
+        // HDR10: 10-bit with the ST 2084 (PQ) colour space, when the compositor offers it.
+        hdr_supported = false;
+        VkSurfaceFormatKHR hdr_choice{};
+        for (const auto& f : formats) {
+            if (f.colorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT && (f.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || f.format == VK_FORMAT_A2R10G10B10_UNORM_PACK32)) {
+                hdr_supported = true;
+                hdr_choice = f;
+                if (f.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32) break;
+            }
+        }
+        const bool want_hdr = hdr_supported && overlay && overlay->Settings().hdr;
+        if (want_hdr) chosen = hdr_choice;
+        if (overlay) overlay->SetHdrAvailable(hdr_supported);
+        hdr_active = want_hdr;
+        if (swap_format != VK_FORMAT_UNDEFINED && swap_format != chosen.format) {
+            DestroyPresentPipelines(); // built for the old swapchain format
+        }
+        u32 nmodes = 0;
+        vk.vkGetPhysicalDeviceSurfacePresentModesKHR(physical, surface, &nmodes, nullptr);
+        std::vector<VkPresentModeKHR> modes(nmodes);
+        vk.vkGetPhysicalDeviceSurfacePresentModesKHR(physical, surface, &nmodes, modes.data());
+        // Mailbox when available (the default), or the overlay's choice: FIFO, immediate.
+        const int want_mode = overlay ? overlay->Settings().present_mode : 0;
+        VkPresentModeKHR mode = VK_PRESENT_MODE_FIFO_KHR;
+        for (auto m : modes) {
+            if ((want_mode == 0 && m == VK_PRESENT_MODE_MAILBOX_KHR) ||
+                (want_mode == 2 && m == VK_PRESENT_MODE_IMMEDIATE_KHR)) {
+                mode = m;
+            }
+        }
+        swap_format = chosen.format;
+        for (auto& [image, view] : swap_views) {
+            vk.vkDestroyImageView(device, view, nullptr);
+        }
+        swap_views.clear();
+        extent = caps.currentExtent;
+        if (extent.width == 0xFFFFFFFF) {
+            // Wayland leaves the size to us: the window's pixel size, which the
+            // main thread's event watch keeps current (no SDL calls from here).
+            const u32 w = window_w.load() ? window_w.load() : 1920, h = window_h.load() ? window_h.load() : 1080;
+            extent = {std::clamp(w, caps.minImageExtent.width, caps.maxImageExtent.width),
+                      std::clamp(h, caps.minImageExtent.height, caps.maxImageExtent.height)};
+        }
+        if (extent.width == 0 || extent.height == 0) {
+            return true;
+        }
+        VkSwapchainCreateInfoKHR sci{VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+        sci.surface = surface;
+        sci.minImageCount = std::max(caps.minImageCount, 2u);
+        if (caps.maxImageCount) {
+            sci.minImageCount = std::min(sci.minImageCount + 1, caps.maxImageCount);
+        }
+        sci.imageFormat = chosen.format;
+        sci.imageColorSpace = chosen.colorSpace;
+        sci.imageExtent = extent;
+        sci.imageArrayLayers = 1;
+        sci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+        sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        sci.preTransform = caps.currentTransform;
+        sci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+        sci.presentMode = mode;
+        sci.clipped = VK_TRUE;
+        sci.oldSwapchain = swapchain;
+        VkSwapchainKHR next = VK_NULL_HANDLE;
+        if (vk.vkCreateSwapchainKHR(device, &sci, nullptr, &next) != VK_SUCCESS) {
+            return Fail("vkCreateSwapchainKHR failed");
+        }
+        if (swapchain) {
+            vk.vkDestroySwapchainKHR(device, swapchain, nullptr);
+        }
+        swapchain = next;
+        u32 n = 0;
+        vk.vkGetSwapchainImagesKHR(device, swapchain, &n, nullptr);
+        swap_images.resize(n);
+        vk.vkGetSwapchainImagesKHR(device, swapchain, &n, swap_images.data());
+        return true;
+    }
+
+    // ------------------------------------------------------------ resources
+    /// Native image for a guest texture, created on first use, kept in GENERAL.
+    /// Resolution scale, applied to the game's screen-size render targets the way suyu's texture cache does.
+    /// `cur_scale` is the scale new and resized targets get right now: the launcher's setting, or, with the
+    /// overlay's render scale, a low scene scale before the upscale point and the output scale after it.
+    static bool ScaleActive(float scale) { return std::fabs(scale - 1.0f) > 1e-4f; }
+    static u32 ScaleDim(u32 v, float scale) {
+        return v == 0 ? 0u : std::max(1u, static_cast<u32>(std::lround(static_cast<double>(v) * scale)));
+    }
+
+    Image* GetImage(const TextureDesc& t, bool create = true, bool render_target = false) {
+        if (!t.valid || t.width == 0 || t.height == 0) {
+            return nullptr;
+        }
+        const auto info = MapFormat(t.format);
+        if (!info) {
+            ++unsupported_formats;
+            return nullptr;
+        }
+        const ImageKey key{t.pool, t.offset, TexelClass(info->format), t.width, t.height};
+        if (post_phase && up_alias && key == tm_key) {
+            return up_alias; // after the upscale point the 3D composite is the upscaled image
+        }
+        if (const auto it = images.find(key); it != images.end()) {
+            Image& existing = it->second;
+            if (create && render_target && existing.scalable) {
+                const bool want = ScaleActive(cur_scale);
+                if (existing.scaled != want || (want && std::fabs(existing.scale - cur_scale) > 1e-4f)) {
+                    ResizeImageScale(existing);
+                }
+            }
+            return &existing;
+        }
+        if (!create) {
+            return nullptr;
+        }
+        Image img;
+        img.info = *info;
+        img.guest_width = t.width;
+        img.guest_height = t.height;
+        // Rescaled like suyu: single-level 2D/array targets taller than 288 rows.
+        // The bloom chain (480x272, rendered level by level) is rescaled too: at the game's size it is a blocky, shimmering
+        // 1/4-resolution image, which shows up as aliasing around bright edges.
+        static const bool scale_bloom = [] { const char* v = std::getenv("KARTRECOMP_BLOOM_SCALE"); return !v || *v != '0'; }();
+        const bool bloom_chain = scale_bloom && render_target && t.target == 1 && t.width == 480 && t.height == 272;
+        img.scalable = render_target && (t.target == 1 || t.target == 4) && ((t.levels <= 1 && t.height > 288) || bloom_chain);
+        img.scaled = img.scalable && ScaleActive(cur_scale);
+        img.scale = img.scaled ? cur_scale : 1.0f;
+        img.width = img.scaled ? ScaleDim(t.width, cur_scale) : t.width;
+        img.height = img.scaled ? ScaleDim(t.height, cur_scale) : t.height;
+        {
+            // The game renders mip chains level by level (bloom: 480x272, 5 levels).
+            u32 max_levels = 1;
+            while ((std::max(img.width, img.height) >> max_levels) > 0) ++max_levels;
+            img.levels = std::clamp<u32>(t.levels, 1, max_levels);
+        }
+        // NVN texture targets: 4 2D array, 6 2D multisample array, 8 cube, 9 cube array.
+        if (t.target == 4 || t.target == 6 || t.target == 8 || t.target == 9) {
+            img.layers = std::clamp<u32>(t.depth, 1, 2048);
+        }
+        if (t.target == 8 && img.layers < 6) img.layers = 6;
+        // NVN target 2: 3D. Rendered slice by slice through 2D views (the color
+        // grading LUT is an 8x8x8 target drawn once per course, a slice per slot).
+        const bool is_3d = t.target == 2 && !info->depth;
+        if (is_3d) img.depth = std::clamp<u32>(t.depth, 1, 2048);
+        img.cube = (t.target == 8 || t.target == 9) && img.layers % 6 == 0 && t.width == t.height;
+        if (img.layers > 1) {
+            KartRe::Log("layered render target: {}x{} fmt {} target {} layers {} pool={:#x} off={:#x}",
+                        t.width, t.height, t.format, t.target, img.layers, t.pool, t.offset);
+        }
+        if (!AllocImageStorage(img, &*info, is_3d)) {
+            return nullptr;
+        }
+        auto [it, _] = images.emplace(key, img);
+        pending_init.push_back(&it->second);
+        if (t.width <= 4 && t.height <= 4) {
+            KartRe::Log("tiny render target created: {}x{} fmt {} pool={:#x} off={:#x} (frame {})",
+                        t.width, t.height, t.format, t.pool, t.offset, frames);
+        }
+        return &it->second;
+    }
+
+    /// Creates the VkImage, its memory and its views for `img` (size, levels, layers already set).
+    bool AllocImageStorage(Image& img, const FormatInfo* info, bool is_3d) {
+        VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ici.flags = (info->depth ? 0 : VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) |
+                    (img.cube ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0) |
+                    (is_3d ? VK_IMAGE_CREATE_2D_ARRAY_COMPATIBLE_BIT : 0);
+        ici.imageType = is_3d ? VK_IMAGE_TYPE_3D : VK_IMAGE_TYPE_2D;
+        ici.format = info->format;
+        ici.extent = {img.width, img.height, img.depth};
+        ici.mipLevels = img.levels;
+        ici.arrayLayers = img.layers;
+        ici.samples = VK_SAMPLE_COUNT_1_BIT;
+        ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ici.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                    VK_IMAGE_USAGE_SAMPLED_BIT |
+                    (info->compressed ? 0
+                     : info->depth    ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT
+                                      : VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT);
+        if (info->compressed) ici.flags &= ~VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+        if (vk.vkCreateImage(device, &ici, nullptr, &img.image) != VK_SUCCESS) {
+            return false;
+        }
+        VkMemoryRequirements req;
+        vk.vkGetImageMemoryRequirements(device, img.image, &req);
+        const auto type = FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = type.value_or(0);
+        if (!type || vk.vkAllocateMemory(device, &mai, nullptr, &img.memory) != VK_SUCCESS) {
+            vk.vkDestroyImage(device, img.image, nullptr);
+            return false;
+        }
+        if (info->depth && std::getenv("KARTRECOMP_DEPTH_LOG")) {
+            LOG_INFO(Frontend, "depth image {}x{} (guest {}x{}) layers {} scaled {} scale {:.2f} fmt {}", img.width, img.height, img.guest_width, img.guest_height, img.layers, img.scaled ? 1 : 0, img.scale, static_cast<int>(info->format));
+        }
+        vk.vkBindImageMemory(device, img.image, img.memory, 0);
+        VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vci.image = img.image;
+        vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vci.format = info->format;
+        vci.subresourceRange = Range(img);
+        vci.subresourceRange.layerCount = 1;
+        if (is_3d) vci.viewType = VK_IMAGE_VIEW_TYPE_3D;
+        vk.vkCreateImageView(device, &vci, nullptr, &img.sample_view); // all levels, layer 0
+        vci.viewType = VK_IMAGE_VIEW_TYPE_2D; // attachments: one slice of a 3D image
+        vci.subresourceRange.levelCount = 1;
+        vk.vkCreateImageView(device, &vci, nullptr, &img.attach_view); // level 0
+        if (info->depth) {
+            vk.vkDestroyImageView(device, img.sample_view, nullptr);
+            vci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+            vk.vkCreateImageView(device, &vci, nullptr, &img.sample_view);
+        }
+        return true;
+    }
+
+    /// A screen-size render target whose scale no longer matches the current one (the overlay's render scale, or
+    /// the switch between the scene's and the output's scale): recreated in place, contents not kept.
+    void ResizeImageScale(Image& img) {
+        const bool want = ScaleActive(cur_scale);
+        Image old = img;
+        TextureCopyRetire(old);
+        img.views.clear();
+        img.sample_views.clear();
+        img.image = VK_NULL_HANDLE;
+        img.memory = VK_NULL_HANDLE;
+        img.attach_view = img.sample_view = VK_NULL_HANDLE;
+        img.scaled = want;
+        img.scale = want ? cur_scale : 1.0f;
+        img.width = want ? ScaleDim(img.guest_width, cur_scale) : img.guest_width;
+        img.height = want ? ScaleDim(img.guest_height, cur_scale) : img.guest_height;
+        if (!AllocImageStorage(img, &img.info, img.depth > 1)) {
+            LOG_ERROR(Frontend, "nvn-host vulkan: could not resize a render target");
+            img = old;
+            retired.pop_back();
+            return;
+        }
+        pending_init.erase(std::remove(pending_init.begin(), pending_init.end(), &img), pending_init.end());
+        Barrier(img.image, Range(img), VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+        ++scale_resizes;
+    }
+
+    /// A render pass asked for mip level `level` of an image created with fewer levels (the first
+    /// description of a texture the game renders level by level can say one level): recreate it with
+    /// `levels`, keeping level 0 and every layer, and retire the old storage once the GPU is done.
+    void GrowImageLevels(Image* img, u32 levels) {
+        if (levels <= img->levels) return;
+        Image old = *img;
+        TextureCopyRetire(old);
+        img->levels = levels;
+        img->views.clear();
+        img->sample_views.clear();
+        img->image = VK_NULL_HANDLE;
+        img->memory = VK_NULL_HANDLE;
+        img->attach_view = img->sample_view = VK_NULL_HANDLE;
+        if (!AllocImageStorage(*img, &img->info, img->depth > 1)) {
+            LOG_ERROR(Frontend, "nvn-host vulkan: could not grow an image to {} levels", levels);
+            *img = old; // keep the old one (its handles were only queued, never destroyed yet)
+            retired.pop_back();
+            return;
+        }
+        const VkImageSubresourceRange all{img->info.depth ? static_cast<VkImageAspectFlags>(VK_IMAGE_ASPECT_DEPTH_BIT)
+                                                          : static_cast<VkImageAspectFlags>(VK_IMAGE_ASPECT_COLOR_BIT),
+                                          0, levels, 0, img->layers};
+        Barrier(img->image, all, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+        VkImageCopy copy{};
+        copy.srcSubresource = {all.aspectMask, 0, 0, img->layers};
+        copy.dstSubresource = copy.srcSubresource;
+        copy.extent = {img->width, img->height, img->depth};
+        MemoryBarrier();
+        vk.vkCmdCopyImage(cmd, old.image, VK_IMAGE_LAYOUT_GENERAL, img->image, VK_IMAGE_LAYOUT_GENERAL, 1, &copy);
+        MemoryBarrier();
+        LOG_INFO(Frontend, "nvn-host vulkan: image {}x{} grown to {} mip levels", img->guest_width, img->guest_height,
+                 levels);
+    }
+
+    /// Queues an image's old storage for destruction after the frame that may still use it.
+    void TextureCopyRetire(const Image& old) {
+        SampledTexture t;
+        t.image = old.image;
+        t.memory = old.memory;
+        int fake = 1000;
+        if (old.attach_view) t.views[fake++] = old.attach_view;
+        if (old.sample_view && old.sample_view != old.attach_view) t.views[fake++] = old.sample_view;
+        for (const auto& [k, v] : old.views) t.views[fake++] = v;
+        for (const auto& [k, v] : old.sample_views) t.views[fake++] = v;
+        retired.push_back(std::move(t));
+    }
+
+    Image* FindImageByStorage(const TextureDesc& t) {
+        if (!t.valid || t.pool == 0) {
+            return nullptr;
+        }
+        const auto lo = images.lower_bound(ImageKey{t.pool, t.offset, 0, 0, 0});
+        for (auto it = lo; it != images.end() && std::get<0>(it->first) == t.pool &&
+                           std::get<1>(it->first) == t.offset;
+             ++it) {
+            if (it->second.guest_width == t.width && it->second.guest_height == t.height) {
+                return &it->second;
+            }
+        }
+        return nullptr;
+    }
+
+    /// View of a color image in another same-size format (aliasing); base views
+    /// for the creation format and for depth images.
+    VkImageView ViewFor(Image* img, VkFormat format, u32 level = 0, u32 layer = 0) {
+        if (!img) {
+            return VK_NULL_HANDLE;
+        }
+        if (format == VK_FORMAT_UNDEFINED || img->info.depth) {
+            format = img->info.format;
+        }
+        level = std::min(level, img->levels - 1);
+        layer = std::min(layer, std::max(img->layers, img->depth >> level) - 1);
+        if (format == img->info.format && level == 0 && layer == 0) {
+            return img->attach_view;
+        }
+        if (const auto it = img->views.find({format, level, layer}); it != img->views.end()) {
+            return it->second;
+        }
+        VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vci.image = img->image;
+        vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vci.format = format;
+        vci.subresourceRange = Range(*img);
+        vci.subresourceRange.baseMipLevel = level;
+        vci.subresourceRange.levelCount = 1;
+        vci.subresourceRange.baseArrayLayer = layer;
+        vci.subresourceRange.layerCount = 1;
+        VkImageView view = VK_NULL_HANDLE;
+        vk.vkCreateImageView(device, &vci, nullptr, &view);
+        img->views[{format, level, layer}] = view;
+        return view;
+    }
+
+    /// Sampling view over all mip levels, in the format the texture is read as.
+    /// Null when the image cannot be viewed that way (cube view of a non-cube).
+    static u32 PackSwizzle(const VkComponentMapping& m) {
+        return static_cast<u32>(m.r) | static_cast<u32>(m.g) << 8 | static_cast<u32>(m.b) << 16 |
+               static_cast<u32>(m.a) << 24;
+    }
+
+    VkImageView SampleViewFor(Image* img, VkFormat format,
+                              VkImageViewType type = VK_IMAGE_VIEW_TYPE_2D,
+                              VkComponentMapping swizzle = {}, u32 base_level = 0,
+                              u32 level_count = ~0u) {
+        base_level = std::min(base_level, img->levels - 1);
+        level_count = std::clamp(level_count, 1u, img->levels - base_level);
+        const bool all_levels = base_level == 0 && level_count == img->levels;
+        const bool identity = swizzle.r <= VK_COMPONENT_SWIZZLE_IDENTITY && swizzle.g <= VK_COMPONENT_SWIZZLE_IDENTITY &&
+                              swizzle.b <= VK_COMPONENT_SWIZZLE_IDENTITY && swizzle.a <= VK_COMPONENT_SWIZZLE_IDENTITY;
+        if (img->info.depth || format == VK_FORMAT_UNDEFINED) {
+            format = img->info.format;
+        }
+        const bool is_3d = img->depth > 1;
+        if ((type == VK_IMAGE_VIEW_TYPE_3D) != is_3d) {
+            return VK_NULL_HANDLE; // a 3D image is only sampled as 3D, and only it is
+        }
+        if ((type == VK_IMAGE_VIEW_TYPE_2D || is_3d) && format == img->info.format && identity && all_levels) {
+            return img->sample_view;
+        }
+        const bool cube_view = type == VK_IMAGE_VIEW_TYPE_CUBE || type == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY;
+        if (cube_view && !img->cube) {
+            return VK_NULL_HANDLE;
+        }
+        // Key: swizzle in the low 32 bits... levels folded into the format slot's
+        // companion: (base, count) packed above bit 32 of a u64 would need a new
+        // key type, so use a separate map for non-default level ranges.
+        const u32 packed = (identity ? 0 : PackSwizzle(swizzle)) ^ (base_level << 4) ^ (level_count << 12) ^
+                           (all_levels ? 0 : 0x80000000u);
+        if (const auto it = img->sample_views.find({format, type, packed}); it != img->sample_views.end()) {
+            return it->second;
+        }
+        VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vci.image = img->image;
+        vci.viewType = type;
+        vci.format = format;
+        if (!identity && !img->info.depth) vci.components = swizzle;
+        vci.subresourceRange = Range(*img);
+        if (img->info.depth) {
+            vci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+        }
+        vci.subresourceRange.baseMipLevel = base_level;
+        vci.subresourceRange.levelCount = level_count;
+        if (type == VK_IMAGE_VIEW_TYPE_2D) vci.subresourceRange.layerCount = 1;
+        if (type == VK_IMAGE_VIEW_TYPE_CUBE) vci.subresourceRange.layerCount = 6;
+        if (type == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY) {
+            vci.subresourceRange.layerCount = img->layers - img->layers % 6;
+        }
+        VkImageView view = VK_NULL_HANDLE;
+        vk.vkCreateImageView(device, &vci, nullptr, &view);
+        img->sample_views[{format, type, packed}] = view;
+        return view;
+    }
+
+    static VkImageSubresourceRange Range(const Image& img) {
+        VkImageSubresourceRange r{};
+        r.aspectMask = img.info.depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+        if (img.info.format == VK_FORMAT_D32_SFLOAT_S8_UINT) {
+            r.aspectMask |= VK_IMAGE_ASPECT_STENCIL_BIT;
+        }
+        r.levelCount = img.levels;
+        r.layerCount = img.layers;
+        return r;
+    }
+
+    void Barrier(VkImage image, VkImageSubresourceRange range, VkImageLayout from,
+                 VkImageLayout to) {
+        VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        b.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        b.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        b.oldLayout = from;
+        b.newLayout = to;
+        b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.image = image;
+        b.subresourceRange = range;
+        vk.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1,
+                                &b);
+    }
+
+    void MemoryBarrier() {
+        VkMemoryBarrier b{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        b.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        b.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        vk.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &b, 0, nullptr, 0,
+                                nullptr);
+    }
+
+    void Prepare(Image* img) {
+        for (auto it = pending_init.begin(); it != pending_init.end(); ++it) {
+            if (*it == img) {
+                if (rendering) {
+                    EndRendering(); // barriers are not allowed inside the pass
+                }
+                Barrier(img->image, Range(*img), VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+                pending_init.erase(it);
+                return;
+            }
+        }
+    }
+
+    /// Bump allocation in this frame's upload ring; nullopt when full.
+    std::optional<u64> Allocate(u64 size, u64 align) {
+        const u64 offset = (ring_head + align - 1) & ~(align - 1);
+        if (offset + size > kRingSize) {
+            ++ring_overflows;
+            return std::nullopt;
+        }
+        ring_head = offset + size;
+        return offset;
+    }
+
+    std::optional<u64> UploadGpu(u64 gpu, u64 size, u64 align) {
+        Profile::Scope ps{prof, Profile::Upload};
+        // Within a frame the same guest range reads the same bytes (memory is read
+        // once, at record time): particles and effects reuse one vertex buffer and
+        // one set of constants for hundreds of draws, so upload each range once.
+        const u64 cache_key = gpu * 0x9E3779B97F4A7C15ULL ^ size;
+        if (const auto it = upload_cache.find(cache_key);
+            it != upload_cache.end() && it->second.gpu == gpu && it->second.size == size && it->second.offset % align == 0) {
+            ++upload_cache_hits;
+            return it->second.offset;
+        }
+        upload_bytes += size;
+        const auto offset = Allocate(std::max<u64>(size, 4), align);
+        if (!offset) {
+            return std::nullopt;
+        }
+        if (!Core::NvnHost::ReadGpuMemory(gpu, ring_ptr + *offset, size)) {
+            std::memset(ring_ptr + *offset, 0, size);
+            ++unmapped_reads;
+            if (unmapped_logged.size() < 40 && unmapped_logged.insert(gpu >> 16).second) {
+                KartRe::Log("unmapped read gpu={:#x} size={:#x}", gpu, size);
+            }
+        }
+        upload_cache[cache_key] = {gpu, size, *offset};
+        return offset;
+    }
+
+    void EnsureDumpImage(u32 w, u32 h) {
+        if (dump_image && dump_w == w && dump_h == h) {
+            return;
+        }
+        VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ici.imageType = VK_IMAGE_TYPE_2D;
+        ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+        ici.extent = {w, h, 1};
+        ici.mipLevels = 1;
+        ici.arrayLayers = 1;
+        ici.samples = VK_SAMPLE_COUNT_1_BIT;
+        ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ici.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        vk.vkCreateImage(device, &ici, nullptr, &dump_image);
+        VkMemoryRequirements req;
+        vk.vkGetImageMemoryRequirements(device, dump_image, &req);
+        VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT).value_or(0);
+        VkDeviceMemory mem;
+        vk.vkAllocateMemory(device, &mai, nullptr, &mem);
+        vk.vkBindImageMemory(device, dump_image, mem, 0);
+        dump_w = w;
+        dump_h = h;
+    }
+
+    // ------------------------------------------------------------ draw state
+    struct DrawState {
+        std::vector<u64> program;
+        std::vector<u32> attribs;
+        std::vector<u32> streams; // stride, divisor pairs
+        struct Range {
+            u64 address = 0, size = 0;
+            u64 snapshot = 0; ///< offset + 1 into Frame::snapshot, or 0
+        };
+        std::array<Range, 16> vertex_buffers{};
+        std::array<std::array<Range, 16>, 6> uniforms{};
+        std::array<std::array<u64, 32>, 6> textures{};
+        u64 depth_stencil = 0x22; // NVN defaults: depth write on, LESS, test off
+        u64 color = 0x0803'0000;
+        u32 channel_mask = 0xFFFF'FFFF;
+        std::array<u64, 8> blend{};
+        u32 polygon = 0x14; // fill, CCW, no culling
+        u32 polygon_offset = 0; ///< NVN offset enables (4 = fill), from the state's setter
+        float bias_factor = 0, bias_units = 0, bias_clamp = 0;
+        bool depth_clamp = false;            ///< SetDepthClamp: no near/far clipping
+        float blend_color[4]{};              ///< SetBlendColor (dynamic state)
+        float depth_near = 0, depth_far = 1; ///< SetDepthRange
+        bool discard = false; // rasterizer discard: draws produce no fragments
+        u64 compute_program = 0;
+        std::array<std::array<Range, 16>, 6> storage{};
+        s32 viewport[4]{0, 0, 1920, 1080};
+        s32 scissor[4]{0, 0, 1920, 1080};
+        std::vector<Image*> colors;
+        std::vector<VkFormat> color_formats; ///< format each target is used as (aliasing)
+        std::vector<u32> color_levels;       ///< mip level each target renders into
+        std::vector<u32> color_layers;       ///< array layer each target renders into
+        struct BcCopy {
+            Image* proxy;
+            Image* bc;
+            u32 level, layer;
+        };
+        std::vector<BcCopy> bc_copies;       ///< compressed targets rendered through proxies
+        Image* depth = nullptr;
+        u32 depth_layer = 0;
+    };
+
+    /// Render targets of a SetRenderTargets into the draw state (images created
+    /// on first use). Shared by the frame and its pipeline pre-pass.
+    void ApplyRenderTargets(DrawState& st, const Command& c, bool report) {
+        st.colors.clear();
+        st.color_formats.clear();
+        st.color_levels.clear();
+        st.color_layers.clear();
+        st.bc_copies.clear();
+        for (size_t ci = 0; ci < c.colors.size(); ++ci) {
+            const auto& t = c.colors[ci];
+            const u32 view_fmt = ci < c.color_view_formats.size() ? c.color_view_formats[ci] : 0;
+            if (const auto tf = MapFormat(t.format); t.valid && tf && tf->compressed) {
+                // Render into a block-sized RGBA32UI proxy of this level, copied into
+                // the compressed image when the pass ends.
+                const u32 level = ci < c.color_levels.size() ? c.color_levels[ci] : 0;
+                const u32 layer = ci < c.color_layers.size() ? c.color_layers[ci] : 0;
+                Image* bc = GetImage(t, true, false);
+                TextureDesc proxy = t;
+                proxy.format = 47;
+                proxy.width = std::max(1u, ((t.width >> level) + 3) / 4);
+                proxy.height = std::max(1u, ((t.height >> level) + 3) / 4);
+                proxy.levels = 1;
+                proxy.offset = t.offset ^ (0x8000'0000'0000'0000ULL | (u64{level} << 56)); // own key
+                Image* px = GetImage(proxy, true, false);
+                st.colors.push_back(px);
+                st.color_formats.push_back(VK_FORMAT_R32G32B32A32_UINT);
+                st.color_levels.push_back(0);
+                st.color_layers.push_back(layer);
+                if (bc && px) st.bc_copies.push_back({px, bc, level, layer});
+                continue;
+            }
+            st.colors.push_back(GetImage(t, true, true));
+            if (report && st.colors.back() && t.levels > st.colors.back()->levels) {
+                // The game renders this texture level by level, so it has more levels than its first use said.
+                u32 max_levels = 1;
+                while ((std::max(st.colors.back()->width, st.colors.back()->height) >> max_levels) > 0) ++max_levels;
+                GrowImageLevels(st.colors.back(), std::min(t.levels, max_levels));
+            }
+            if (report && st.colors.back()) {
+                const u32 want_level = ci < c.color_levels.size() ? c.color_levels[ci] : 0;
+                if (want_level >= st.colors.back()->levels &&
+                    mip_clamp_logged.insert((t.pool << 8) ^ t.offset ^ want_level).second) {
+                    LOG_WARNING(Frontend,
+                                "nvn-host vulkan: render target {}x{} f{} wants mip level {} but the image has {} level(s) "
+                                "(this pass's texture says {} levels): it is drawn into level {} instead",
+                                t.width, t.height, t.format, want_level, st.colors.back()->levels, t.levels,
+                                st.colors.back()->levels - 1);
+                }
+            }
+            const auto mapped = MapFormat(view_fmt ? view_fmt : t.format);
+            st.color_formats.push_back(mapped ? mapped->format : VK_FORMAT_UNDEFINED);
+            st.color_levels.push_back(ci < c.color_levels.size() ? c.color_levels[ci] : 0);
+            st.color_layers.push_back(ci < c.color_layers.size() ? c.color_layers[ci] : 0);
+            if (report && !st.colors.back() && t.valid && null_formats.insert(t.format).second) {
+                KartRe::Log("render target with unmapped NVN format {} ({}x{}x{} levels {} target {}) view format {} level {} layer {}",
+                            t.format, t.width, t.height, t.depth, t.levels, t.target,
+                            ci < c.color_view_formats.size() ? c.color_view_formats[ci] : 0,
+                            ci < c.color_levels.size() ? c.color_levels[ci] : 0,
+                            ci < c.color_layers.size() ? c.color_layers[ci] : 0);
+                LOG_WARNING(Frontend, "nvn-host vulkan: render target format {} not mapped", t.format);
+            }
+            if (report && !t.valid) ++invalid_target_slots;
+            if (report && t.valid && KartRe::Enabled() &&
+                rt_shapes_logged.insert(fmt::format("{}x{}x{} f{} t{} {:x}/{:x}", t.width, t.height, t.depth,
+                                                    t.format, t.target, t.pool, t.offset)).second) {
+                KartRe::Log("render target first used: frame {} slot {} {}x{}x{} f{} t{} pool={:#x} off={:#x}",
+                            frames, ci, t.width, t.height, t.depth, t.format, t.target, t.pool, t.offset);
+            }
+        }
+        st.depth = GetImage(c.depth, true, true);
+        st.depth_layer = c.depth_layer;
+        if (report && c.depth.valid && KartRe::Enabled() &&
+            rt_shapes_logged.insert(fmt::format("depth {}x{}x{} f{} t{} {:x}/{:x} layer {}", c.depth.width,
+                                                c.depth.height, c.depth.depth, c.depth.format, c.depth.target,
+                                                c.depth.pool, c.depth.offset, c.depth_layer)).second) {
+            KartRe::Log("depth target first used: frame {} {}x{}x{} f{} t{} pool={:#x} off={:#x} layer {} image layers {}",
+                        frames, c.depth.width, c.depth.height, c.depth.depth, c.depth.format, c.depth.target,
+                        c.depth.pool, c.depth.offset, c.depth_layer, st.depth ? st.depth->layers : 0);
+        }
+        if (st.depth && !st.depth->info.depth) {
+            st.depth = nullptr;
+        }
+    }
+
+    /// Vertex input for a draw: the attributes the vertex shader reads, and one
+    /// binding per vertex stream they use, in first-use order.
+    struct VertexLayout {
+        std::vector<VkVertexInputAttributeDescription> attrs;
+        std::vector<VkVertexInputBindingDescription> binds;
+        std::vector<u32> streams; ///< NVN stream of each binding
+    };
+
+    static VertexLayout ComputeVertexLayout(const ProgramEntry::Stage& vs, const DrawState& st) {
+        VertexLayout out;
+        if (vs.stage != Shader::Stage::VertexB) {
+            return out;
+        }
+        std::array<s32, 16> stream_binding;
+        stream_binding.fill(-1);
+        for (u32 i = 0; i < 32; ++i) {
+            if (!vs.info.loads.Generic(i)) {
+                continue;
+            }
+            const u32 word = i < st.attribs.size() ? st.attribs[i] : 0;
+            const u32 stream = word & 0x1F;
+            const u32 offset = (word >> 7) & 0x3FFF;
+            // The format field is wider than 6 bits: packed normals use
+            // RGB10A2SN (105), which a 6-bit read turned into RGBA16F (41).
+            const VkFormat format = MapVertexFormat((word >> 21) & 0xFF);
+            if (format == VK_FORMAT_UNDEFINED || stream >= 16) {
+                continue;
+            }
+            if (stream_binding[stream] < 0) {
+                const u32 stride = stream * 2 < st.streams.size() ? st.streams[stream * 2] : 0;
+                const u32 divisor = stream * 2 + 1 < st.streams.size() ? st.streams[stream * 2 + 1] : 0;
+                stream_binding[stream] = static_cast<s32>(out.binds.size());
+                out.binds.push_back({static_cast<u32>(out.binds.size()), stride,
+                                     divisor ? VK_VERTEX_INPUT_RATE_INSTANCE : VK_VERTEX_INPUT_RATE_VERTEX});
+                out.streams.push_back(stream);
+            }
+            out.attrs.push_back({i, static_cast<u32>(stream_binding[stream]), format, offset});
+        }
+        return out;
+    }
+
+    // ------------------------------------------------------------- programs
+    /// Hardware cbuf 1 for an NVN shader: its data address plus the u32 at +0x700
+    /// of the shader's control section. Matches the emulated GPU's cbuf 1 binds
+    /// for every one of 508 shaders checked (the constants follow the code,
+    /// 256-byte aligned); the data address itself is only right when that is 0.
+    static u64 ConstantsAddress(u64 data) {
+        u32 offset = 0;
+        if (const u64 control = Core::NvnHost::ShaderControlAddress(data)) {
+            Core::NvnHost::ReadGuestMemory(control + 0x700, &offset, sizeof(offset));
+        }
+        return data + offset;
+    }
+
+    using TextureTable = std::array<std::array<u64, 32>, 6>;
+
+    static std::vector<u64> ProgramKey(const std::vector<u64>& stages, const DrawState& st) {
+        std::vector<u64> key = stages;
+        if (const u32 mask = UintOutputMask(st)) {
+            key.push_back(~0ULL);
+            key.push_back(mask);
+        }
+        return key;
+    }
+
+    /// Bit i: color target i is an unsigned-integer format (shader outputs uint).
+    static u32 UintOutputMask(const DrawState& st) {
+        u32 mask = 0;
+        for (size_t i = 0; i < st.color_formats.size() && i < 8; ++i) {
+            switch (st.color_formats[i]) {
+            case VK_FORMAT_R32G32B32A32_UINT: case VK_FORMAT_R32G32_UINT: case VK_FORMAT_R32_UINT:
+            case VK_FORMAT_R16G16B16A16_UINT: case VK_FORMAT_R8G8B8A8_UINT:
+                mask |= 1u << i;
+                break;
+            default: break;
+            }
+        }
+        return mask;
+    }
+
+    ProgramEntry* GetProgram(const std::vector<u64>& stages, const DrawState& st) {
+        // Integer-output variants get their own entry (key = stages + marker + mask).
+        const u32 uint_mask = UintOutputMask(st);
+        const std::vector<u64> keyed = ProgramKey(stages, st);
+        const std::vector<u64>& datas = keyed;
+        if (const auto it = programs.find(datas); it != programs.end()) {
+            if (it->second.speculative) {
+                if (SpeculationHolds(it->second, st.textures)) {
+                    it->second.speculative = false;
+                } else {
+                    DestroyProgram(it->second);
+                    it->second = BuildProgram(stages, st.textures, uint_mask);
+                    ++speculation_misses;
+                    if (!it->second.ok) ++program_failures;
+                }
+            }
+            return &it->second;
+        }
+        ProgramEntry& entry = programs[datas];
+        entry = BuildProgram(stages, st.textures, uint_mask);
+        if (!entry.ok) {
+            ++program_failures;
+        }
+        return &entry;
+    }
+
+    /// A speculative program is right when every texture slot its translation
+    /// asked about still reads as 2D with the real bindings.
+    static bool SpeculationHolds(const ProgramEntry& e, const TextureTable& textures) {
+        for (const auto& [stage, slot] : e.texture_queries) {
+            const u32 raw = static_cast<u32>(textures[stage][slot]);
+            if (Core::NvnHost::TextureTypeForHandle(raw) != Shader::TextureType::Color2D) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void DestroyProgram(ProgramEntry& e) {
+        for (auto& st : e.stages) vk.vkDestroyShaderModule(device, st.module, nullptr);
+        if (e.layout) vk.vkDestroyPipelineLayout(device, e.layout, nullptr);
+        if (e.set_layout) vk.vkDestroyDescriptorSetLayout(device, e.set_layout, nullptr);
+        e = {};
+    }
+
+    /// Hash of the first 1 KB of each stage's code (enough to tell programs apart).
+    static u64 CodeHash(const std::vector<u64>& datas) {
+        u64 h = 0;
+        std::array<u8, 0x400> code{};
+        for (const u64 data : datas) {
+            code.fill(0);
+            Core::NvnHost::ReadGpuMemory(data, code.data(), code.size());
+            h = h * 0x9E3779B97F4A7C15ULL ^ HashBytes(code.data(), code.size());
+        }
+        return h;
+    }
+
+    void OnProgram(const std::vector<u64>& datas) override {
+        {
+            std::scoped_lock lock{spec_mutex};
+            if (spec_quit) {
+                return;
+            }
+            spec_queue.push_back(datas);
+        }
+        spec_cv.notify_one();
+    }
+
+    /// Background translation of programs as the game creates them (during
+    /// loading screens), so a course's first frame finds them built.
+    void SpeculativeWorker() {
+        while (true) {
+            std::vector<u64> datas;
+            {
+                std::unique_lock lock{spec_mutex};
+                spec_cv.wait(lock, [this] { return spec_quit || !spec_queue.empty(); });
+                if (spec_quit) {
+                    return;
+                }
+                datas = std::move(spec_queue.front());
+                spec_queue.pop_front();
+            }
+            // Programs are recreated with the same addresses; only new code matters.
+            const u64 hash = CodeHash(datas);
+            if (const auto it = spec_hash.find(datas); it != spec_hash.end() && it->second == hash) {
+                continue;
+            }
+            spec_hash[datas] = hash;
+            ProgramEntry e = BuildProgram(datas, TextureTable{});
+            e.speculative = true;
+            std::scoped_lock lock{spec_mutex};
+            spec_done.emplace_back(std::move(datas), std::move(e));
+        }
+    }
+
+    /// Takes the worker's finished programs (render thread, frame start).
+    void MergeSpeculative() {
+        std::vector<std::pair<std::vector<u64>, ProgramEntry>> done;
+        {
+            std::scoped_lock lock{spec_mutex};
+            done.swap(spec_done);
+        }
+        for (auto& [datas, e] : done) {
+            if (!e.ok) {
+                DestroyProgram(e);
+                continue;
+            }
+            if (const auto it = programs.find(datas); it != programs.end()) {
+                if (it->second.code_hash == e.code_hash) {
+                    DestroyProgram(e);
+                    continue;
+                }
+                // New code at old addresses: retire the old program and its
+                // pipelines (keys start with the entry's address). Kept alive
+                // until shutdown since an in-flight frame may still use them.
+                const ProgramEntry* old = &it->second;
+                for (auto p = pipelines.begin(); p != pipelines.end();) {
+                    if (p->first.size() >= sizeof(old) && std::memcmp(p->first.data(), &old, sizeof(old)) == 0) {
+                        retired_pipelines.push_back(p->second);
+                        p = pipelines.erase(p);
+                    } else {
+                        ++p;
+                    }
+                }
+                retired_programs.push_back(std::move(it->second));
+                programs.erase(it);
+                ++programs_replaced;
+            }
+            programs.emplace(std::move(datas), std::move(e));
+            ++speculative_built;
+        }
+    }
+
+    /// Translates the frame's not-yet-built programs on several threads before
+    /// the frame is recorded: a course's first frame brings a few hundred, which
+    /// serially stalled the render thread for 300+ ms. Each program is translated
+    /// with the texture handles bound at its first draw, as GetProgram would.
+    void PrebuildPrograms(const Frame& frame) {
+        TextureTable textures{};
+        std::vector<u64> bound;
+        std::vector<std::pair<std::vector<u64>, TextureTable>> jobs;
+        std::set<std::vector<u64>> queued;
+        std::set<u32> seen_ids;
+        std::set<u64> tex_keys;
+        std::vector<std::pair<u64, Tegra::Texture::TICEntry>> tex_jobs;
+        for (const FrameCommand& fc : frame.commands) {
+            const Command& c = *fc.cmd;
+            switch (c.op) {
+            case Op::BindProgram:
+                if (!(c.stage == 0x20 && c.shaders.size() == 1)) bound = c.shaders;
+                break;
+            case Op::BindTexture:
+                if (c.stage < 6 && c.index < 32) textures[c.stage][c.index] = c.handle;
+                if (c.handle && seen_ids.insert(static_cast<u32>(c.handle & 0xFFFFF)).second) {
+                    QueueTexturePrefetch(static_cast<u32>(c.handle & 0xFFFFF), tex_jobs, tex_keys);
+                }
+                break;
+            case Op::Draw:
+                if (bound.empty()) break;
+                if (const auto it = programs.find(bound); it != programs.end() && it->second.speculative) {
+                    if (SpeculationHolds(it->second, textures)) {
+                        it->second.speculative = false;
+                    } else {
+                        DestroyProgram(it->second);
+                        programs.erase(it);
+                        ++speculation_misses;
+                    }
+                }
+                if (!programs.contains(bound) && queued.insert(bound).second) {
+                    jobs.emplace_back(bound, textures);
+                }
+                break;
+            default:
+                break;
+            }
+        }
+        static const bool no_prefetch = std::getenv("KARTRECOMP_NATIVE_NOPREFETCH") != nullptr;
+        if (!no_prefetch) {
+            Profile::Scope ps{prof, Profile::PrebuildTextures};
+            PrefetchTextures(tex_jobs);
+        }
+        static const bool no_parallel = std::getenv("KARTRECOMP_NATIVE_NOPARALLEL") != nullptr;
+        if (jobs.size() < 2 || no_parallel) {
+            return; // one program: building it inline costs the same
+        }
+        const u32 workers = std::clamp<u32>(std::thread::hardware_concurrency() / 2, 1, 8);
+        std::vector<ProgramEntry> results(jobs.size());
+        std::atomic<size_t> next{0};
+        std::vector<std::thread> builders;
+        for (u32 w = 0; w < std::min<size_t>(workers, jobs.size()); ++w) {
+            builders.emplace_back([&] {
+                for (size_t i; (i = next.fetch_add(1)) < jobs.size();) {
+                    results[i] = BuildProgram(jobs[i].first, jobs[i].second);
+                }
+            });
+        }
+        for (auto& t : builders) t.join();
+        for (size_t i = 0; i < jobs.size(); ++i) {
+            if (!results[i].ok) ++program_failures;
+            programs.emplace(std::move(jobs[i].first), std::move(results[i]));
+        }
+    }
+
+    /// Compiles the frame's new pipelines on worker threads before recording: a
+    /// course's first frame needs a few hundred, which serially cost several
+    /// hundred ms in the driver. Walks the frame with the same state handling as
+    /// the recording loop, so the keys are the ones Draw will look up.
+    void PrebuildPipelines(const Frame& frame) {
+        struct Job {
+            std::string key;
+            const ProgramEntry* prog;
+            DrawState st;
+            VkPrimitiveTopology topology;
+            VertexLayout layout;
+        };
+        std::vector<Job> jobs;
+        std::set<std::string> queued;
+        DrawState st = persistent_state;
+        for (const FrameCommand& fc : frame.commands) {
+            const Command& c = *fc.cmd;
+            switch (c.op) {
+            case Op::SetRenderTargets:
+                if (hud_cmd && &c == hud_cmd) PrepareUpscalePoint(c);
+                ApplyRenderTargets(st, c, false);
+                break;
+            case Op::BindProgram:
+                if (!(c.stage == 0x20 && c.shaders.size() == 1)) st.program = c.shaders;
+                break;
+            case Op::BindVertexAttribs: st.attribs = c.words; break;
+            case Op::BindVertexStreams: st.streams = c.words; break;
+            case Op::BindDepthStencil: st.depth_stencil = c.raw; break;
+            case Op::BindColor: st.color = c.raw; break;
+            case Op::BindChannelMask: st.channel_mask = static_cast<u32>(c.raw); break;
+            case Op::BindBlend: st.blend[c.raw & 7] = c.raw; break;
+            case Op::BindPolygon:
+                st.polygon = static_cast<u32>(c.raw);
+                st.polygon_offset = c.index;
+                break;
+            case Op::PolygonOffset:
+                st.bias_factor = c.rgba[0];
+                st.bias_units = c.rgba[1];
+                st.bias_clamp = c.rgba[2];
+                break;
+            case Op::DepthClamp: st.depth_clamp = c.index != 0; break;
+            case Op::BlendColor: std::copy(std::begin(c.rgba), std::end(c.rgba), st.blend_color); break;
+            case Op::DepthRange:
+                st.depth_near = c.rgba[0];
+                st.depth_far = c.rgba[1];
+                break;
+            case Op::RasterizerDiscard: st.discard = c.index != 0; break;
+            case Op::Draw: {
+                if (st.discard || st.program.empty() || c.draw == DrawKind::Other) break;
+                const auto it = programs.find(ProgramKey(st.program, st));
+                if (it == programs.end() || !it->second.ok || it->second.unsupported_resources) break;
+                const auto topology = MapTopology(static_cast<u32>(c.args[0]));
+                if (!topology) break;
+                VertexLayout layout = ComputeVertexLayout(it->second.stages.front(), st);
+                std::string key = PipelineKey(it->second, st, *topology, layout.attrs, layout.binds);
+                if (pipelines.contains(key) || !queued.insert(key).second) break;
+                jobs.push_back({std::move(key), &it->second, st, *topology, std::move(layout)});
+                break;
+            }
+            default: break;
+            }
+        }
+        static const bool no_parallel = std::getenv("KARTRECOMP_NATIVE_NOPARALLEL") != nullptr;
+        if (jobs.size() < 2 || no_parallel) {
+            return;
+        }
+        std::vector<VkPipeline> results(jobs.size());
+        std::atomic<size_t> next{0};
+        std::vector<std::thread> workers;
+        const u32 count = std::clamp<u32>(std::thread::hardware_concurrency() / 2, 1, 8);
+        for (u32 w = 0; w < std::min<size_t>(count, jobs.size()); ++w) {
+            workers.emplace_back([&] {
+                for (size_t i; (i = next.fetch_add(1)) < jobs.size();) {
+                    const Job& j = jobs[i];
+                    results[i] = CreatePipeline(*j.prog, j.st, j.topology, j.layout.attrs, j.layout.binds);
+                }
+            });
+        }
+        for (auto& t : workers) t.join();
+        for (size_t i = 0; i < jobs.size(); ++i) {
+            if (!results[i]) ++pipeline_failures;
+            pipelines.emplace(std::move(jobs[i].key), results[i]);
+        }
+    }
+
+    /// A texture the frame binds that is neither uploaded yet nor a native render
+    /// target: decode it ahead of recording.
+    void QueueTexturePrefetch(u32 id, std::vector<std::pair<u64, Tegra::Texture::TICEntry>>& jobs,
+                              std::set<u64>& keys) {
+        Tegra::Texture::TICEntry tic{};
+        if (!Core::NvnHost::ReadTextureDescriptor(id, &tic)) {
+            return;
+        }
+        const u64 key = TicKey(tic);
+        if (sampled.contains(key) || !keys.insert(key).second) {
+            return;
+        }
+        const TextureDesc t = Core::NvnHost::LookupTextureId(id);
+        if (GetImage(t, false) || FindImageByStorage(t)) {
+            return;
+        }
+        jobs.emplace_back(key, tic);
+    }
+
+    /// Decodes new textures on worker threads (reading and unswizzling a
+    /// course's textures serially cost a couple hundred ms on its first frame),
+    /// then creates them here in order.
+    void PrefetchTextures(const std::vector<std::pair<u64, Tegra::Texture::TICEntry>>& jobs) {
+        deferred_keys.clear();
+        if (jobs.size() < 2) {
+            return;
+        }
+        // A course's first frame wants ~600 textures (500 MB decoded). Taking them all in one frame is a 150 ms stall, so a
+        // burst is spread over a few frames: about `budget_ms` of work per frame, the rest shown with a stand-in for now and
+        // decoded in the background meanwhile (KARTRECOMP_NATIVE_TEX_BUDGET_MS, 0 = everything at once).
+        static const double budget_ms = [] {
+            const char* v = std::getenv("KARTRECOMP_NATIVE_TEX_BUDGET_MS");
+            return v ? std::atof(v) : 20.0;
+        }();
+        const auto start = std::chrono::steady_clock::now();
+        const auto elapsed_ms = [&] { return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count(); };
+        const u32 count = std::clamp<u32>(std::thread::hardware_concurrency(), 1, 16);
+        const size_t chunk = std::max<size_t>(count, 16);
+        size_t done = 0;
+        size_t taken = 0;
+        double decode_ms = 0, create_ms = 0;
+        u64 decoded_bytes = 0;
+        while (done < jobs.size()) {
+            const size_t end = std::min(jobs.size(), done + chunk);
+            const auto t0 = std::chrono::steady_clock::now();
+            std::vector<DecodedTexture> decoded(end - done);
+            std::vector<char> have(end - done, 0);
+            for (size_t i = done; i < end; ++i) {
+                have[i - done] = TakePredecoded(jobs[i].first, jobs[i].second, decoded[i - done]) ? 1 : 0;
+                taken += have[i - done];
+            }
+            std::atomic<size_t> next{done};
+            std::vector<std::thread> workers;
+            for (u32 w = 0; w < std::min<size_t>(count, end - done); ++w) {
+                workers.emplace_back([&] {
+                    for (size_t i; (i = next.fetch_add(1)) < end;) {
+                        if (have[i - done]) continue; // decoded ahead of time in the background
+                        decoded[i - done] = DecodeTexture(jobs[i].second);
+                    }
+                });
+            }
+            for (auto& t : workers) t.join();
+            const auto t1 = std::chrono::steady_clock::now();
+            for (size_t i = done; i < end; ++i) {
+                decoded_bytes += decoded[i - done].output.size();
+                SampledTexture tex = CreateTexture(jobs[i].second, decoded[i - done]);
+                decoded[i - done] = {}; // release the CPU copy early
+                if (tex.ok || tex.format == VK_FORMAT_UNDEFINED) {
+                    sampled.emplace(jobs[i].first, std::move(tex));
+                }
+            }
+            const auto t2 = std::chrono::steady_clock::now();
+            decode_ms += std::chrono::duration<double, std::milli>(t1 - t0).count();
+            create_ms += std::chrono::duration<double, std::milli>(t2 - t1).count();
+            done = end;
+            if (budget_ms > 0 && done < jobs.size() && elapsed_ms() > budget_ms) {
+                break;
+            }
+        }
+        if (done < jobs.size()) {
+            // The rest wait for a later frame's budget, and are decoded then, from the data as it is at that time.
+            for (size_t i = done; i < jobs.size(); ++i) deferred_keys.insert(jobs[i].first);
+            ++textures_deferred_frames;
+        }
+        if (decode_ms + create_ms > 25.0 || done < jobs.size()) {
+            LOG_INFO(Frontend, "texture prefetch: {}/{} textures, {:.1f} MB, decode {:.1f} ms (threads), create {:.1f} ms, {} decoded ahead",
+                     done, jobs.size(), static_cast<double>(decoded_bytes) / 1048576.0, decode_ms, create_ms, taken);
+        }
+    }
+
+    /// Translates one NVN program and creates its Vulkan objects. Thread-safe:
+    /// touches no backend state besides the (thread-safe) device.
+    ProgramEntry BuildProgram(const std::vector<u64>& datas, const TextureTable& textures,
+                              u32 uint_outputs = 0) const {
+        ProgramEntry entry;
+        const Core::NvnHost::GpuReader reader = [](u64 gpu, void* out, size_t size) {
+            return Core::NvnHost::ReadGpuMemory(gpu, out, size);
+        };
+        // Texture handles bound for this (first) draw shape the translation:
+        // cbuf 2 holds one 8-byte handle per NVN slot.
+        std::vector<std::pair<int, u32>> queries;
+        const Core::NvnHost::CbufQuery cbuf = [&textures, &queries](int stage, u32 index, u32 offset) -> u32 {
+            if (index != 2 || stage < 0 || stage >= 6 || offset < kTextureHandleBase ||
+                TextureSlot(offset) >= 32) {
+                return 0;
+            }
+            queries.emplace_back(stage, TextureSlot(offset));
+            const u64 handle = textures[stage][TextureSlot(offset)];
+            return static_cast<u32>(offset % 8 == 0 ? handle : handle >> 32);
+        };
+        const auto translated = Core::NvnHost::TranslateProgramStages(reader, datas, cbuf, uint_outputs);
+        std::sort(queries.begin(), queries.end());
+        queries.erase(std::unique(queries.begin(), queries.end()), queries.end());
+        entry.texture_queries = std::move(queries);
+        entry.code_hash = CodeHash(datas);
+        for (const auto& t : translated) {
+            if (!t.ok) {
+                entry.error = t.error;
+                return entry;
+            }
+        }
+        // Descriptor layout in the order suyu's emitter numbers bindings:
+        // per stage, uniform buffers, storage buffers, texel buffers, images
+        // buffers, textures, images.
+        std::vector<VkDescriptorSetLayoutBinding> bindings;
+        u32 binding = 0;
+        for (size_t si = 0; si < translated.size(); ++si) {
+            const auto& t = translated[si];
+            VkShaderModuleCreateInfo smci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            smci.codeSize = t.spirv.size() * sizeof(u32);
+            smci.pCode = t.spirv.data();
+            VkShaderModule module = VK_NULL_HANDLE;
+            if (vk.vkCreateShaderModule(device, &smci, nullptr, &module) != VK_SUCCESS) {
+                entry.error = "vkCreateShaderModule failed";
+                return entry;
+            }
+            entry.stages.push_back({t.stage, module, t.info, t.data, t.spirv, ConstantsAddress(t.data)});
+            const VkShaderStageFlags stage_flag = VkStage(t.stage);
+            const auto add = [&](VkDescriptorType type, const auto& list) {
+                for (u32 i = 0; i < list.size(); ++i) {
+                    bindings.push_back({binding, type, list[i].count, stage_flag, nullptr});
+                    entry.descriptors.push_back(
+                        {type, binding, list[i].count, static_cast<int>(si), i});
+                    ++binding;
+                }
+            };
+            add(VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, t.info.constant_buffer_descriptors);
+            add(VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, t.info.storage_buffers_descriptors);
+            add(VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, t.info.texture_buffer_descriptors);
+            add(VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER, t.info.image_buffer_descriptors);
+            add(VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, t.info.texture_descriptors);
+            add(VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, t.info.image_descriptors);
+            if (!t.info.texture_buffer_descriptors.empty() ||
+                !t.info.image_buffer_descriptors.empty() || !t.info.image_descriptors.empty()) {
+                entry.unsupported_resources = true;
+            }
+        }
+        VkDescriptorSetLayoutCreateInfo dslci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        dslci.bindingCount = static_cast<u32>(bindings.size());
+        dslci.pBindings = bindings.data();
+        vk.vkCreateDescriptorSetLayout(device, &dslci, nullptr, &entry.set_layout);
+        const VkPushConstantRange push{VK_SHADER_STAGE_ALL_GRAPHICS, 0, kPushSize};
+        VkPipelineLayoutCreateInfo plci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        plci.setLayoutCount = 1;
+        plci.pSetLayouts = &entry.set_layout;
+        plci.pushConstantRangeCount = 1;
+        plci.pPushConstantRanges = &push;
+        vk.vkCreatePipelineLayout(device, &plci, nullptr, &entry.layout);
+        entry.ok = true;
+        return entry;
+    }
+
+    void EndRendering() {
+        if (rendering) {
+            vk.vkCmdEndRendering(cmd);
+            rendering = false;
+            MemoryBarrier();
+            for (const auto& bcc : pass_bc_copies) {
+                Prepare(bcc.bc);
+                VkImageCopy r{};
+                r.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, std::min(bcc.layer, bcc.proxy->layers - 1), 1};
+                r.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, std::min(bcc.level, bcc.bc->levels - 1),
+                                    std::min(bcc.layer, bcc.bc->layers - 1), 1};
+                r.extent = {bcc.proxy->width, bcc.proxy->height, 1};
+                vk.vkCmdCopyImage(cmd, bcc.proxy->image, VK_IMAGE_LAYOUT_GENERAL, bcc.bc->image,
+                                  VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+                ++bc_copies_done;
+            }
+            if (!pass_bc_copies.empty()) MemoryBarrier();
+            pass_bc_copies.clear();
+            if (dump_frame && pass_draws > 0 && pass_depth &&
+                (pass_colors.empty() || !pass_colors[0]) && depth_dumps < 4) {
+                ++depth_dumps;
+                ReadbackDepth(pass_depth, fmt::format("pass{:03}_draws{}_depth_layer{}", pass_index, pass_draws,
+                                                      pass_depth_layer),
+                              pass_depth_layer);
+            }
+            if (dump_frame && pass_draws > 0 && !pass_colors.empty() && pass_colors[0] &&
+                !pass_colors[0]->info.depth && pass_colors[0]->guest_width >= 480 && dumps.size() < 120) {
+                const VkFormat used = pass_color_format;
+                const bool rgba8_view = used != pass_colors[0]->info.format &&
+                                        (used == VK_FORMAT_R8G8B8A8_UNORM || used == VK_FORMAT_R8G8B8A8_SRGB ||
+                                         used == VK_FORMAT_B8G8R8A8_UNORM || used == VK_FORMAT_A8B8G8R8_UNORM_PACK32);
+                const auto name = fmt::format("pass{:03}_draws{}{}", pass_index, pass_draws,
+                                              pass_color_layer ? fmt::format("_layer{}", pass_color_layer) : "");
+                if (rgba8_view) {
+                    ReadbackRaw(pass_colors[0], name + "_asRGBA8", pass_color_layer);
+                } else {
+                    ReadbackImage(pass_colors[0], name + (pass_color_level ? fmt::format("_mip{}", pass_color_level) : ""),
+                                  640, 360, pass_color_layer, pass_color_level);
+                }
+            }
+            ++pass_index;
+        }
+    }
+
+    /// Debug: copy an image (converted to RGBA8, at most 1920x1080) into the ring
+    /// for writing as PPM after this frame's fence.
+    /// Debug (KARTRECOMP_NATIVE_PICK=x,y in 1920x1080 coordinates): in a dump
+    /// frame, read one pixel of color target 0 after every full-size draw, so the
+    /// log tells which draws wrote that pixel and with what.
+    void PickAfterDraw(const DrawState& st, const ProgramEntry& prog) {
+        static const std::optional<std::pair<s32, s32>> pick = []() -> std::optional<std::pair<s32, s32>> {
+            const char* v = std::getenv("KARTRECOMP_NATIVE_PICK");
+            s32 x = 0, y = 0;
+            if (!v || std::sscanf(v, "%d,%d", &x, &y) != 2) return std::nullopt;
+            return std::make_pair(x, y);
+        }();
+        // KARTRECOMP_NATIVE_PICK_W=<guest width>: pick in targets of that width instead
+        // (coordinates scaled to the target and its mip level).
+        static const u32 pick_width = [] {
+            const char* v = std::getenv("KARTRECOMP_NATIVE_PICK_W");
+            return v ? static_cast<u32>(std::atoi(v)) : 1920u;
+        }();
+        if (!pick || st.colors.empty() || !st.colors[0] || st.colors[0]->info.depth ||
+            st.colors[0]->guest_width != pick_width || picks.size() >= 3000) {
+            return;
+        }
+        Image* img = st.colors[0];
+        const u32 texel = TexelClass(img->info.format) & 0xFF;
+        const auto off = Allocate(16, 16);
+        if (!off) return;
+        // Copies are not allowed while rendering: suspend, copy, resume.
+        vk.vkCmdEndRendering(cmd);
+        rendering = false;
+        MemoryBarrier();
+        VkBufferImageCopy copy{};
+        copy.bufferOffset = *off;
+        const u32 layer = st.color_layers.empty() ? 0 : std::min(st.color_layers[0], img->layers - 1);
+        copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, layer, 1};
+        const u32 level = st.color_levels.empty() ? 0 : std::min(st.color_levels[0], img->levels - 1);
+        copy.imageSubresource.mipLevel = level;
+        const s32 px = (img->scaled ? static_cast<s32>(ScaleDim(static_cast<u32>(pick->first), img->scale)) : pick->first) >> level;
+        const s32 py = (img->scaled ? static_cast<s32>(ScaleDim(static_cast<u32>(pick->second), img->scale)) : pick->second) >> level;
+        copy.imageOffset = {std::min(px, static_cast<s32>(std::max(1u, img->width >> level)) - 1),
+                            std::min(py, static_cast<s32>(std::max(1u, img->height >> level)) - 1), 0};
+        copy.imageExtent = {1, 1, 1};
+        vk.vkCmdCopyImageToBuffer(cmd, img->image, VK_IMAGE_LAYOUT_GENERAL, ring, 1, &copy);
+        MemoryBarrier();
+        const u32 saved_draws = pass_draws;
+        DrawState resume = st;
+        BeginRendering(resume);
+        pass_draws = saved_draws;
+        std::string desc = fmt::format("pass{:03} draw{} vk{} layer{} view_fmt{} ds={:#x} blend0={:#x} mask={:#x} poly={:#x} prog",
+                                       pass_index, pass_draws, static_cast<int>(img->info.format), layer,
+                                       st.color_formats.empty() ? 0 : static_cast<int>(st.color_formats[0]),
+                                       st.depth_stencil, st.blend[0], st.channel_mask, st.polygon);
+        for (const auto& sg : prog.stages) desc += fmt::format(" {}:{:#x}", static_cast<int>(sg.stage), sg.data);
+        for (int stage = 0; stage < 5; ++stage) {
+            for (u32 slot = 0; slot < 32; ++slot) {
+                const u64 h = st.textures[stage][slot];
+                if (!h) continue;
+                const u32 id = static_cast<u32>(h & 0xFFFFF);
+                Tegra::Texture::TICEntry tic{};
+                std::string what = "?";
+                if (Core::NvnHost::ReadTextureDescriptor(id, &tic)) {
+                    const VideoCommon::ImageInfo info{tic};
+                    what = fmt::format("pf{} {}x{}x{} t{}", static_cast<int>(info.format), info.size.width,
+                                       info.size.height, info.resources.layers,
+                                       static_cast<int>(tic.texture_type.Value()));
+                }
+                desc += fmt::format(" | s{}t{} id={:#x} {}", stage, slot, id, what);
+            }
+        }
+        picks.push_back({*off, texel, std::move(desc)});
+    }
+
+    /// Debug: a D16/D32 depth image's level 0 / layer 0 as a grey PPM (written via
+    /// the same dump list: stored as RGBA8 with depth in the top byte).
+    void ReadbackDepth(Image* img, const std::string& name, u32 layer = 0) {
+        const bool d16 = img->info.format == VK_FORMAT_D16_UNORM;
+        if (!d16 && img->info.format != VK_FORMAT_D32_SFLOAT) return;
+        const u64 texel = d16 ? 2 : 4;
+        const auto off = Allocate(static_cast<u64>(img->width) * img->height * texel, 256);
+        if (!off) return;
+        Prepare(img);
+        VkBufferImageCopy copy{};
+        copy.bufferOffset = *off;
+        copy.imageSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, std::min(layer, img->layers - 1), 1};
+        copy.imageExtent = {img->width, img->height, 1};
+        vk.vkCmdCopyImageToBuffer(cmd, img->image, VK_IMAGE_LAYOUT_GENERAL, ring, 1, &copy);
+        MemoryBarrier();
+        depth_readbacks.push_back({name, *off, img->width, img->height, d16});
+    }
+
+    /// Debug: raw copy of a 4-byte-texel image's level 0, for targets the game
+    /// wrote through an RGBA8 view of a differently-typed image (aliasing): a blit
+    /// would convert from the image's own format and show garbage.
+    void ReadbackRaw(Image* img, const std::string& name, u32 layer) {
+        if (img->info.depth || TexelClass(img->info.format) != 4 || raw_dump_count >= 16) {
+            return;
+        }
+        const auto off = Allocate(static_cast<u64>(img->width) * img->height * 4, 256);
+        if (!off) {
+            return;
+        }
+        ++raw_dump_count;
+        Prepare(img);
+        VkBufferImageCopy copy{};
+        copy.bufferOffset = *off;
+        copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, std::min(layer, img->layers - 1), 1};
+        copy.imageExtent = {img->width, img->height, 1};
+        vk.vkCmdCopyImageToBuffer(cmd, img->image, VK_IMAGE_LAYOUT_GENERAL, ring, 1, &copy);
+        MemoryBarrier();
+        dumps.push_back({fmt::format("{}_{}x{}_vk{}", name, img->width, img->height,
+                                     static_cast<int>(img->info.format)),
+                         {*off, {img->width, img->height}}});
+    }
+
+    void ReadbackImage(Image* img, const std::string& name, u32 max_w = 640, u32 max_h = 360,
+                       u32 layer = 0, u32 level = 0) {
+        level = std::min(level, img->levels - 1);
+        if (img->info.depth) {
+            return;
+        }
+        const u32 w = std::min<u32>(img->width, max_w), h = std::min<u32>(img->height, max_h);
+        const auto off = Allocate(static_cast<u64>(w) * h * 4, 256);
+        if (!off) {
+            return;
+        }
+        Prepare(img);
+        EnsureDumpImage(w, h);
+        VkImageSubresourceRange r{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        Barrier(dump_image, r, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+        VkImageBlit blit{};
+        blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, level, std::min(layer, img->layers - 1), 1};
+        blit.srcOffsets[1] = {static_cast<int>(std::max(1u, img->width >> level)),
+                              static_cast<int>(std::max(1u, img->height >> level)), 1};
+        blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        blit.dstOffsets[1] = {static_cast<int>(w), static_cast<int>(h), 1};
+        vk.vkCmdBlitImage(cmd, img->image, VK_IMAGE_LAYOUT_GENERAL, dump_image,
+                          VK_IMAGE_LAYOUT_GENERAL, 1, &blit, VK_FILTER_NEAREST);
+        MemoryBarrier();
+        VkBufferImageCopy copy{};
+        copy.bufferOffset = *off;
+        copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        copy.imageExtent = {w, h, 1};
+        vk.vkCmdCopyImageToBuffer(cmd, dump_image, VK_IMAGE_LAYOUT_GENERAL, ring, 1, &copy);
+        MemoryBarrier();
+        dumps.push_back({fmt::format("{}_{}x{}_vk{}", name, img->width, img->height,
+                                     static_cast<int>(img->info.format)),
+                         {*off, {w, h}}});
+    }
+
+    bool BeginRendering(DrawState& st) {
+        if (rendering) {
+            return true;
+        }
+        std::array<VkRenderingAttachmentInfo, 8> color_infos{};
+        u32 width = UINT32_MAX, height = UINT32_MAX;
+        u32 count = 0;
+        for (size_t i = 0; i < st.colors.size() && i < 8; ++i) {
+            VkRenderingAttachmentInfo& a = color_infos[i];
+            a.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+            Image* img = st.colors[i];
+            if (img) {
+                Prepare(img);
+                const u32 level = i < st.color_levels.size() ? std::min(st.color_levels[i], img->levels - 1) : 0;
+                a.imageView = ViewFor(img, i < st.color_formats.size() ? st.color_formats[i]
+                                                                       : VK_FORMAT_UNDEFINED,
+                                      level, i < st.color_layers.size() ? st.color_layers[i] : 0);
+                a.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+                a.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+                a.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+                width = std::min(width, std::max(1u, img->width >> level));
+                height = std::min(height, std::max(1u, img->height >> level));
+            }
+            count = static_cast<u32>(i + 1);
+        }
+        VkRenderingAttachmentInfo depth_info{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+        if (st.depth) {
+            Prepare(st.depth);
+            depth_info.imageView = ViewFor(st.depth, VK_FORMAT_UNDEFINED, 0, st.depth_layer);
+            depth_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+            depth_info.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+            depth_info.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+            width = std::min(width, st.depth->width);
+            height = std::min(height, st.depth->height);
+        }
+        if (width == UINT32_MAX) {
+            return false; // nothing to render into
+        }
+        VkRenderingInfo ri{VK_STRUCTURE_TYPE_RENDERING_INFO};
+        ri.renderArea = {{0, 0}, {width, height}};
+        ri.layerCount = 1;
+        ri.colorAttachmentCount = count;
+        ri.pColorAttachments = color_infos.data();
+        const bool has_stencil = st.depth && st.depth->info.format == VK_FORMAT_D32_SFLOAT_S8_UINT;
+        ri.pDepthAttachment = st.depth ? &depth_info : nullptr;
+        ri.pStencilAttachment = has_stencil ? &depth_info : nullptr;
+        vk.vkCmdBeginRendering(cmd, &ri);
+        rendering = true;
+        pass_colors = st.colors;
+        pass_bc_copies = st.bc_copies;
+        pass_depth = st.depth;
+        pass_depth_layer = st.depth_layer;
+        pass_scale = 1.0f;
+        for (Image* img : st.colors) {
+            if (img && img->scaled) pass_scale = img->scale;
+        }
+        if (st.depth && st.depth->scaled) pass_scale = st.depth->scale;
+        pass_color_format = st.color_formats.empty() ? VK_FORMAT_UNDEFINED : st.color_formats[0];
+        pass_color_layer = st.color_layers.empty() ? 0 : st.color_layers[0];
+        pass_color_level = st.color_levels.empty() ? 0 : st.color_levels[0];
+        pass_draws = 0;
+        render_width = width;
+        render_height = height;
+        return true;
+    }
+
+    VkPipeline GetPipeline(ProgramEntry& prog, const DrawState& st, VkPrimitiveTopology topology,
+                           const std::vector<VkVertexInputAttributeDescription>& attrs,
+                           const std::vector<VkVertexInputBindingDescription>& binds) {
+        Profile::Scope ps{prof, Profile::Pipelines};
+        std::string key = PipelineKey(prog, st, topology, attrs, binds);
+        if (const auto it = pipelines.find(key); it != pipelines.end()) {
+            return it->second;
+        }
+        const VkPipeline pipeline = CreatePipeline(prog, st, topology, attrs, binds);
+        if (!pipeline) ++pipeline_failures;
+        pipelines.emplace(std::move(key), pipeline);
+        return pipeline;
+    }
+
+    /// Debug (KARTRECOMP_NATIVE_SIMPLE=smunflip): render shadow-map passes (depth
+    /// only, D16) without the viewport flip. Off by default: the emulated GPU's
+    /// registers show shadow passes use the same negative viewport scale_y as every
+    /// other pass. (Missing kart shadows were the mask's TIC swizzle, not this.)
+    static bool IsShadowMapPass(const DrawState& st) {
+        static const bool unflip = [] {
+            const char* t = std::getenv("KARTRECOMP_NATIVE_SIMPLE");
+            return t && std::strstr(t, "smunflip");
+        }();
+        if (!unflip) return false;
+        for (const Image* img : st.colors) {
+            if (img) return false;
+        }
+        return st.depth && st.depth->info.format == VK_FORMAT_D16_UNORM;
+    }
+
+    /// Everything that shapes a pipeline object.
+    static std::string PipelineKey(const ProgramEntry& prog, const DrawState& st, VkPrimitiveTopology topology,
+                                   const std::vector<VkVertexInputAttributeDescription>& attrs,
+                                   const std::vector<VkVertexInputBindingDescription>& binds) {
+        std::string key;
+        const auto put = [&key](const void* p, size_t n) {
+            key.append(static_cast<const char*>(p), n);
+        };
+        const ProgramEntry* prog_ptr = &prog;
+        put(&prog_ptr, sizeof(prog_ptr));
+        put(&topology, sizeof(topology));
+        for (const auto& a : attrs) put(&a, sizeof(a));
+        for (const auto& b : binds) put(&b, sizeof(b));
+        put(&st.depth_stencil, sizeof(st.depth_stencil));
+        put(&st.color, sizeof(st.color));
+        put(&st.channel_mask, sizeof(st.channel_mask));
+        put(st.blend.data(), sizeof(st.blend));
+        put(&st.polygon, sizeof(st.polygon));
+        const bool bias = (st.polygon_offset & 4) != 0;
+        put(&bias, sizeof(bias));
+        put(&st.depth_clamp, sizeof(st.depth_clamp));
+        const bool shadow_map = IsShadowMapPass(st);
+        put(&shadow_map, sizeof(shadow_map));
+        for (size_t i = 0; i < st.colors.size(); ++i) {
+            const VkFormat f = st.colors[i] ? st.color_formats[i] : VK_FORMAT_UNDEFINED;
+            put(&f, sizeof(f));
+        }
+        const VkFormat depth_format = st.depth ? st.depth->info.format : VK_FORMAT_UNDEFINED;
+        put(&depth_format, sizeof(depth_format));
+        return key;
+    }
+
+    /// Thread-safe: reads only its arguments and the (thread-safe) device.
+    VkPipeline CreatePipeline(const ProgramEntry& prog, const DrawState& st, VkPrimitiveTopology topology,
+                              const std::vector<VkVertexInputAttributeDescription>& attrs,
+                              const std::vector<VkVertexInputBindingDescription>& binds) const {
+        const VkFormat depth_format = st.depth ? st.depth->info.format : VK_FORMAT_UNDEFINED;
+        std::vector<VkPipelineShaderStageCreateInfo> stages;
+        for (const auto& s : prog.stages) {
+            VkPipelineShaderStageCreateInfo ssci{VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+            ssci.stage = VkStage(s.stage);
+            ssci.module = s.module;
+            ssci.pName = "main";
+            stages.push_back(ssci);
+        }
+        VkPipelineVertexInputStateCreateInfo vis{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        vis.vertexBindingDescriptionCount = static_cast<u32>(binds.size());
+        vis.pVertexBindingDescriptions = binds.data();
+        vis.vertexAttributeDescriptionCount = static_cast<u32>(attrs.size());
+        vis.pVertexAttributeDescriptions = attrs.data();
+        VkPipelineInputAssemblyStateCreateInfo ias{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        ias.topology = topology;
+        ias.primitiveRestartEnable =
+            topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP || topology == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP;
+        VkPipelineViewportStateCreateInfo vps{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        vps.viewportCount = 1;
+        vps.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        rs.polygonMode = VK_POLYGON_MODE_FILL;
+        const u32 cull = st.polygon & 3;
+        rs.cullMode = cull == 1 ? VK_CULL_MODE_FRONT_BIT
+                      : cull == 2 ? VK_CULL_MODE_BACK_BIT
+                      : cull == 3 ? VK_CULL_MODE_FRONT_AND_BACK
+                                  : VK_CULL_MODE_NONE;
+        // NVN polygon bit 2 = CCW. The emulated GPU confirms the mapping: the game
+        // always runs hardware front face CCW with a negative viewport scale_y and
+        // upper-left origin, which suyu (and this backend) express as Vulkan CCW
+        // with a negative-height viewport. Getting it wrong also inverts
+        // gl_FrontFacing, which two-sided materials use to flip their normals.
+        // Unflipped (shadow-map) passes see the opposite winding.
+        const bool ccw = ((st.polygon >> 2) & 1) != IsShadowMapPass(st);
+        rs.frontFace = ccw ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+        rs.lineWidth = 1.0f;
+        // Polygon offset (fill): decals pull forward (units -4, slope -1), shadow
+        // maps push back (units 100+). Values are dynamic state, set per draw.
+        rs.depthBiasEnable = (st.polygon_offset & 4) ? VK_TRUE : VK_FALSE;
+        // NVN depth clamp = Maxwell's "no Z clip + clamp" (shadow maps keep casters
+        // in front of the light's near plane).
+        rs.depthClampEnable = st.depth_clamp ? VK_TRUE : VK_FALSE;
+
+        VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+        if (st.depth) {
+            ds.depthTestEnable = (st.depth_stencil & 1) ? VK_TRUE : VK_FALSE;
+            ds.depthWriteEnable = ((st.depth_stencil >> 1) & 1) ? VK_TRUE : VK_FALSE;
+            ds.depthCompareOp = MapCompare(static_cast<u32>((st.depth_stencil >> 4) & 0xF));
+        }
+        std::array<VkPipelineColorBlendAttachmentState, 8> blends{};
+        std::vector<VkFormat> color_formats;
+        for (size_t i = 0; i < st.colors.size() && i < 8; ++i) {
+            color_formats.push_back(st.colors[i] ? st.color_formats[i] : VK_FORMAT_UNDEFINED);
+            auto& b = blends[i];
+            b.colorWriteMask = (st.channel_mask >> (4 * i)) & 0xF;
+            const bool enable = ((st.color >> 8) >> i) & 1;
+            const u64 raw = st.blend[i];
+            if (enable && raw != 0) {
+                b.blendEnable = VK_TRUE;
+                b.srcColorBlendFactor = MapBlendFactor(static_cast<u32>((raw >> 32) & 0xFF));
+                b.dstColorBlendFactor = MapBlendFactor(static_cast<u32>((raw >> 40) & 0xFF));
+                b.srcAlphaBlendFactor = MapBlendFactor(static_cast<u32>((raw >> 48) & 0xFF));
+                b.dstAlphaBlendFactor = MapBlendFactor(static_cast<u32>((raw >> 56) & 0xFF));
+                b.colorBlendOp = MapBlendOp(static_cast<u32>((raw >> 24) & 0xF));
+                b.alphaBlendOp = MapBlendOp(static_cast<u32>((raw >> 28) & 0xF));
+            }
+        }
+        VkPipelineColorBlendStateCreateInfo cbs{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        cbs.attachmentCount = static_cast<u32>(color_formats.size());
+        cbs.pAttachments = blends.data();
+        const VkDynamicState dyn[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                      VK_DYNAMIC_STATE_DEPTH_BIAS, VK_DYNAMIC_STATE_BLEND_CONSTANTS};
+        VkPipelineDynamicStateCreateInfo dys{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dys.dynamicStateCount = 4;
+        dys.pDynamicStates = dyn;
+        VkPipelineRenderingCreateInfo prci{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+        prci.colorAttachmentCount = static_cast<u32>(color_formats.size());
+        prci.pColorAttachmentFormats = color_formats.data();
+        prci.depthAttachmentFormat = depth_format;
+        prci.stencilAttachmentFormat =
+            depth_format == VK_FORMAT_D32_SFLOAT_S8_UINT ? depth_format : VK_FORMAT_UNDEFINED;
+        VkGraphicsPipelineCreateInfo gpci{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        gpci.pNext = &prci;
+        gpci.stageCount = static_cast<u32>(stages.size());
+        gpci.pStages = stages.data();
+        gpci.pVertexInputState = &vis;
+        gpci.pInputAssemblyState = &ias;
+        gpci.pViewportState = &vps;
+        gpci.pRasterizationState = &rs;
+        gpci.pMultisampleState = &ms;
+        gpci.pDepthStencilState = &ds;
+        gpci.pColorBlendState = &cbs;
+        gpci.pDynamicState = &dys;
+        gpci.layout = prog.layout;
+        // Debug overrides: KARTRECOMP_NATIVE_SIMPLE=depth,cull,blend,mask (or "all").
+        static const std::string simple = [] {
+            const char* v = std::getenv("KARTRECOMP_NATIVE_SIMPLE");
+            return std::string{v ? v : ""};
+        }();
+        const auto off = [](std::string_view what) {
+            return simple == "all" || simple == "1" || simple.find(what) != std::string::npos;
+        };
+        if (off("depth")) {
+            ds.depthTestEnable = VK_FALSE;
+            ds.depthWriteEnable = VK_FALSE;
+        }
+        if (off("noclamp")) rs.depthClampEnable = VK_FALSE;
+        if (off("nobias")) rs.depthBiasEnable = VK_FALSE;
+        if (off("cull")) {
+            rs.cullMode = VK_CULL_MODE_NONE;
+        }
+        for (auto& b : blends) {
+            if (off("blend")) b.blendEnable = VK_FALSE;
+            if (off("mask")) b.colorWriteMask = 0xF;
+        }
