+                    "view={:#x} region={},{},{} {}x{}x{} flags={:#x}",
+                    ctx.x[1], dst.valid, dst.target, dst.format, dst.width, dst.height, dst.depth,
+                    dst.levels, dst.pool, dst.offset, ctx.x[3], region[0], region[1], region[2],
+                    region[3], region[4], region[5], Arg32(ctx, 5));
