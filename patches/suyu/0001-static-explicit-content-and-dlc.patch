+    for (std::size_t p = 0; p < 4; ++p) {
+        current[p] = code_of(p);
+    }
+    std::scoped_lock lock{state.lock};
+    if (!state.published || state.devices != names || state.current != current) {
+        state.devices = std::move(names);
+        state.current = current;
+        state.published = true;
+        ++state.version;
+    }
+}
