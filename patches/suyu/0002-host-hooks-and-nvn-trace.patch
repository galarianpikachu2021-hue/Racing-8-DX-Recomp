diff --git a/src/core/file_sys/kart_text_patch.cpp b/src/core/file_sys/kart_text_patch.cpp
new file mode 100644
index 0000000000..5c5550a499
--- /dev/null
+++ b/src/core/file_sys/kart_text_patch.cpp
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/file_sys/kart_text_patch.h"
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "common/logging/log.h"
+#include "core/file_sys/vfs/vfs.h"
+#include "core/file_sys/vfs/vfs_vector.h"
+
+namespace FileSys::KartText {
+namespace {
+
+// Menu.msbt label of the main menu's Toy-Con button ("Toy-Con" in English; every language has it).
+constexpr char kLabel[] = "2180";
+constexpr char16_t kText[] = u"Mods";
+
+u32 U32(const std::vector<u8>& d, size_t at) {
+    u32 v = 0;
+    if (at + 4 <= d.size()) std::memcpy(&v, d.data() + at, 4);
+    return v;
+}
+u16 U16(const std::vector<u8>& d, size_t at) {
+    u16 v = 0;
+    if (at + 2 <= d.size()) std::memcpy(&v, d.data() + at, 2);
+    return v;
+}
+
+/// Rewrites the label's string in the MSBT at [base, end) in place. The string keeps its slot (the TXT2 offsets do not move): the
+/// new text and its terminator fill the front, zeros the rest. False when the label is missing or its slot is too small.
+bool PatchMsbt(std::vector<u8>& d, size_t base, size_t end) {
+    if (end - base < 0x20 || std::memcmp(d.data() + base, "MsgStdBn", 8) != 0 || U16(d, base + 8) != 0xFEFF) return false;
+    const u16 sections = U16(d, base + 0x0E);
+    size_t pos = base + 0x20;
+    bool found = false;
+    u32 index = 0;
+    size_t txt2 = 0, txt2_size = 0;
+    for (u16 s = 0; s < sections && pos + 16 <= end; ++s) {
+        const u32 size = U32(d, pos + 4);
+        const size_t body = pos + 16;
+        if (body + size > end) return false;
+        if (std::memcmp(d.data() + pos, "LBL1", 4) == 0) {
+            const u32 groups = U32(d, body);
+            for (u32 g = 0; g < groups && !found; ++g) {
+                const u32 count = U32(d, body + 4 + g * 8);
+                size_t p = body + U32(d, body + 8 + g * 8);
+                for (u32 k = 0; k < count && p < body + size; ++k) {
+                    const u8 len = d[p];
+                    if (len == sizeof(kLabel) - 1 && std::memcmp(d.data() + p + 1, kLabel, len) == 0) {
+                        index = U32(d, p + 1 + len);
+                        found = true;
+                        break;
+                    }
+                    p += 1 + len + 4;
+                }
+            }
+        } else if (std::memcmp(d.data() + pos, "TXT2", 4) == 0) {
+            txt2 = body;
+            txt2_size = size;
+        }
+        pos = body + ((size + 15) & ~size_t{15});
+    }
+    if (!found || txt2 == 0) return false;
+    const u32 n = U32(d, txt2);
+    if (index >= n) return false;
+    const size_t from = txt2 + U32(d, txt2 + 4 + index * 4);
+    const size_t to = index + 1 < n ? txt2 + U32(d, txt2 + 8 + index * 4) : txt2 + txt2_size;
+    if (to <= from || to - from < sizeof(kText)) return false; // sizeof includes the terminator
+    std::memset(d.data() + from, 0, to - from);
+    std::memcpy(d.data() + from, kText, sizeof(kText));
+    return true;
+}
+
+/// The Menu.msbt member of a message archive (uncompressed SARC), patched; false when it could not be.
+bool PatchSarc(std::vector<u8>& d) {
+    if (d.size() < 0x28 || std::memcmp(d.data(), "SARC", 4) != 0 || U16(d, 6) != 0xFEFF ||
+        std::memcmp(d.data() + 0x14, "SFAT", 4) != 0) {
+        return false;
+    }
+    const u32 data_off = U32(d, 0x0C);
+    const u16 count = U16(d, 0x1A);
+    const size_t nodes = 0x20, names = nodes + count * 16 + 8;
+    if (names > d.size() || std::memcmp(d.data() + nodes + count * 16, "SFNT", 4) != 0) return false;
+    for (u16 i = 0; i < count; ++i) {
+        const size_t node = nodes + i * 16;
+        const u32 attr = U32(d, node + 4);
+        if (attr >> 24 != 1) continue;
+        const size_t name = names + (attr & 0xFFFFFF) * 4;
+        if (name + 10 > d.size() || std::strncmp(reinterpret_cast<const char*>(d.data() + name), "Menu.msbt", 10) != 0) continue;
+        const size_t start = data_off + U32(d, node + 8), end = data_off + U32(d, node + 12);
+        return end <= d.size() && start < end && PatchMsbt(d, start, end);
+    }
+    return false;
+}
+
+} // namespace
+
+VirtualDir MakeMenuTextLayer(const VirtualDir& romfs) {
+    const VirtualDir ui = romfs ? romfs->GetSubdirectory("UI") : nullptr;
+    if (!ui) return nullptr;
+    std::vector<VirtualDir> langs;
+    for (const auto& lang : ui->GetSubdirectories()) {
+        const VirtualFile file = lang->GetFile("message.sarc");
+        if (!file) continue;
+        std::vector<u8> bytes = file->ReadAllBytes();
+        if (!PatchSarc(bytes)) {
+            LOG_WARNING(Loader, "kart-recomp: main menu text not changed for {}", lang->GetName());
+            continue;
+        }
+        auto patched = std::make_shared<VectorVfsFile>(std::move(bytes), "message.sarc");
+        langs.push_back(std::make_shared<VectorVfsDirectory>(std::vector<VirtualFile>{patched}, std::vector<VirtualDir>{},
+                                                             lang->GetName()));
+    }
+    if (langs.empty()) return nullptr;
+    LOG_INFO(Loader, "kart-recomp: main menu Toy-Con button renamed to Mods ({} languages)", langs.size());
+    auto ui_layer = std::make_shared<VectorVfsDirectory>(std::vector<VirtualFile>{}, std::move(langs), "UI");
+    return std::make_shared<VectorVfsDirectory>(std::vector<VirtualFile>{}, std::vector<VirtualDir>{ui_layer}, "romfs");
+}
+
+} // namespace FileSys::KartText
