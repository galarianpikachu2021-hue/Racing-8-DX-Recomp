+/// Vertex buffers up to this size are captured at submit (dynamic per-frame data).
+constexpr u64 kVertexSnapshotMax = 256u << 10;
+
+/// Graphics stages' driver cbuf 0: storage buffer descriptors start here.
+constexpr u64 kStorageDescriptorBase = 0x110;
