+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: Vulkan backend for nvn-host (shadow stage).
+//
+// Executes the reconstructed NVN frames natively in its own window: shaders are
+// translated from the game's Maxwell code, resources come from guest memory or
+// native render targets, and the game's window texture is presented. Beside the
+// emulated output (shadow mode) or as the only renderer (exclusive mode); see
+// docs/NATIVE_GPU.md in kart-recomp.
+#pragma once
+
+#include <memory>
+
+#include "core/nvn_host/nvn_host.h"
+
+namespace KartRecomp {
+
+/// Null when Vulkan or the window could not be set up; the reason is logged.
+/// fullscreen: open the window fullscreen (exclusive mode, suyu-cmd -f).
+std::unique_ptr<Core::NvnHost::Backend> CreateVulkanShadowBackend(bool fullscreen = false);
+
+} // namespace KartRecomp
diff --git a/src/suyu_cmd/sampling_profiler.cpp b/src/suyu_cmd/sampling_profiler.cpp
new file mode 100644
index 0000000000..d24d64b03b
--- /dev/null
+++ b/src/suyu_cmd/sampling_profiler.cpp
@@ -0,0 +1,202 @@
+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "suyu_cmd/sampling_profiler.h"
+
+#ifdef __linux__
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <link.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <sys/uio.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include "common/logging/log.h"
+
+namespace SuyuCmd {
+namespace {
+
+constexpr int kCallers = 6;
+constexpr int kStackWords = 256;
+
+struct Sample {
+    int thread;
+    unsigned long long t_ms;
+    unsigned long long ip;
+    unsigned long long callers[kCallers];
+};
+
+constexpr size_t kMaxSamples = 1u << 21;
+Sample* g_samples = nullptr;
+std::atomic<size_t> g_count{0};
+unsigned long long g_text_lo = 0;
+unsigned long long g_text_hi = 0;
+
+void OnSample(int, siginfo_t* info, void* raw) {
+    const size_t i = g_count.fetch_add(1, std::memory_order_relaxed);
+    if (i >= kMaxSamples) {
+        return;
+    }
+    const auto* uc = static_cast<ucontext_t*>(raw);
+    Sample& s = g_samples[i];
+    s.thread = info->si_value.sival_int;
+    timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    s.t_ms = static_cast<unsigned long long>(now.tv_sec) * 1000 + static_cast<unsigned long long>(now.tv_nsec) / 1000000;
+    s.ip = static_cast<unsigned long long>(uc->uc_mcontext.gregs[REG_RIP]);
+    // process_vm_readv fails instead of faulting when the copy runs past the top of
+    // a (fiber) stack; the read is cut short at the first unmapped page.
+    unsigned long long sp[kStackWords];
+    iovec local{sp, sizeof(sp)};
+    iovec remote{reinterpret_cast<void*>(uc->uc_mcontext.gregs[REG_RSP]), sizeof(sp)};
+    const ssize_t got = process_vm_readv(getpid(), &local, 1, &remote, 1, 0);
+    const int words = got > 0 ? static_cast<int>(got / 8) : 0;
+    int n = 0;
+    for (int w = 0; w < words && n < kCallers; ++w) {
+        const unsigned long long v = sp[w];
+        if (v >= g_text_lo && v < g_text_hi) {
+            s.callers[n++] = v;
+        }
+    }
+    for (; n < kCallers; ++n) {
+        s.callers[n] = 0;
+    }
+}
+
+int FindExecutable(dl_phdr_info* info, size_t, void*) {
+    // The first entry is the executable itself.
+    for (int i = 0; i < info->dlpi_phnum; ++i) {
+        const auto& ph = info->dlpi_phdr[i];
+        if (ph.p_type == PT_LOAD && (ph.p_flags & PF_X)) {
+            g_text_lo = info->dlpi_addr + ph.p_vaddr;
+            g_text_hi = g_text_lo + ph.p_memsz;
+        }
+    }
+    return 1;
+}
+
+std::string ReadComm(const std::string& task) {
+    std::ifstream in(task + "/comm");
+    std::string name;
+    std::getline(in, name);
+    return name;
+}
+
+void Run(double start_s, double seconds, bool wall) {
+    std::this_thread::sleep_for(std::chrono::duration<double>(start_s));
+    struct Timer {
+        timer_t id;
+        int tid;
+        std::string name;
+    };
+    std::vector<Timer> timers;
+    const int self = static_cast<int>(syscall(SYS_gettid));
+    for (const auto& entry : std::filesystem::directory_iterator("/proc/self/task")) {
+        const int tid = std::atoi(entry.path().filename().c_str());
+        if (tid == self) {
+            continue;
+        }
+        // Thread CPU clock for another thread: MAKE_THREAD_CPUCLOCK(tid, CPUCLOCK_SCHED).
+        const clockid_t clock = wall ? CLOCK_MONOTONIC : static_cast<clockid_t>((~tid << 3) | 4 | 2);
+        sigevent ev{};
+        ev.sigev_notify = SIGEV_THREAD_ID;
+        ev.sigev_signo = SIGPROF;
+        ev.sigev_value.sival_int = static_cast<int>(timers.size());
+        ev._sigev_un._tid = tid;
+        timer_t id;
+        if (timer_create(clock, &ev, &id) != 0) {
+            continue;
+        }
+        timers.push_back({id, tid, ReadComm(entry.path().string())});
+    }
+    itimerspec spec{};
+    spec.it_interval.tv_nsec = 1'000'000;
+    spec.it_value.tv_nsec = 1'000'000;
+    for (auto& t : timers) {
+        timer_settime(t.id, 0, &spec, nullptr);
+    }
+    LOG_INFO(Frontend, "profiler: sampling {} threads for {:.0f} s ({})", timers.size(), seconds,
+             wall ? "wall time" : "CPU time");
+    std::this_thread::sleep_for(std::chrono::duration<double>(seconds));
+    for (auto& t : timers) {
+        timer_delete(t.id);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+
+    const char* out_env = std::getenv("KARTRECOMP_PROFILE_OUT");
+    const std::string out_path = out_env ? out_env : "profile.txt";
+    FILE* out = std::fopen(out_path.c_str(), "w");
+    if (!out) {
+        return;
+    }
+    std::fprintf(out, "# mode %s seconds %.1f\n", wall ? "wall" : "cpu", seconds);
+    for (size_t i = 0; i < timers.size(); ++i) {
+        std::fprintf(out, "T %zu %d %s\n", i, timers[i].tid, timers[i].name.c_str());
+    }
+    {
+        std::ifstream maps("/proc/self/maps");
+        std::string line;
+        while (std::getline(maps, line)) {
+            if (line.find(" r-xp ") != std::string::npos) {
+                std::fprintf(out, "M %s\n", line.c_str());
+            }
+        }
+    }
+    const size_t n = std::min(g_count.load(), kMaxSamples);
+    const unsigned long long t_base = n ? g_samples[0].t_ms : 0;
+    for (size_t i = 0; i < n; ++i) {
+        const Sample& s = g_samples[i];
+        std::fprintf(out, "S2 %d %llu %llx", s.thread, s.t_ms - t_base, s.ip);
+        for (int c = 0; c < kCallers && s.callers[c]; ++c) {
+            std::fprintf(out, " %llx", s.callers[c]);
+        }
+        std::fputc('\n', out);
+    }
+    std::fclose(out);
+    LOG_INFO(Frontend, "profiler: wrote {} samples to {}", n, out_path);
+}
+
+} // namespace
+
+void StartSamplingProfiler() {
+    const char* env = std::getenv("KARTRECOMP_PROFILE");
+    if (!env) {
+        return;
+    }
+    double start_s = 60;
+    double seconds = 20;
+    char mode[16] = {};
+    std::sscanf(env, "%lf,%lf,%15s", &start_s, &seconds, mode);
+    const bool wall = std::strcmp(mode, "wall") == 0;
+    g_samples = new Sample[kMaxSamples];
+    dl_iterate_phdr(FindExecutable, nullptr);
+    struct sigaction sa{};
+    sa.sa_sigaction = OnSample;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGPROF, &sa, nullptr);
+    std::thread(Run, start_s, seconds, wall).detach();
+}
+
+} // namespace SuyuCmd
+
+#else
+
+namespace SuyuCmd {
+void StartSamplingProfiler() {}
+} // namespace SuyuCmd
+
+#endif
