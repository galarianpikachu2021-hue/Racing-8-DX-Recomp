+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the console's service message format (HIPC transport + CMIF commands), read and written natively
+// (docs/NATIVE_ENGINE.md, "native services").
+//
+// A game thread sends a service request by writing a message into the first 0x100 bytes of its thread-local area and calling
+// SendSyncRequest; the reply is written back into the same place. The message is:
+//   word 0: type (bits 0-15: 4 request, 5 control, 6/7 the same with context, 2 close), number of X / A / B / W buffer
+//           descriptors (4 bits each from bit 16)
+//   word 1: size of the raw data in words (bits 0-9), C buffer mode (bits 10-13), handle descriptor present (bit 31)
+//   [handle descriptor: send process id (bit 0), copy handle count (bits 1-4), move handle count (bits 5-8); then the process id
+//    (8 bytes) when sent, the copy handles, the move handles]
+//   X descriptors (8 bytes each), A, B, W descriptors (12 bytes each)
+//   raw data, starting at the next 16-byte boundary: [domain header (16 bytes) when the session is a domain]
+//           "SFCI", version, command id (u64), arguments...  (replies: "SFCO", version, result (u64), values...)
+//           [domain input object ids after the arguments; domain output object ids after the reply values]
+//   C descriptors (8 bytes each) after the raw data.
+//
+// Request parses one message; Reply writes one. Standard library only (tests: tests/test_hipc.cpp).
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace KartRuntime::Hipc {
+
+constexpr size_t MessageSize = 0x100;
+constexpr uint32_t MagicIn = 0x49434653;  // "SFCI"
+constexpr uint32_t MagicOut = 0x4F434653; // "SFCO"
+
+enum class Type : uint16_t { Close = 2, Request = 4, Control = 5, RequestWithContext = 6, ControlWithContext = 7 };
+enum class DomainCommand : uint8_t { SendMessage = 1, CloseObject = 2 };
+enum class Control : uint32_t { ConvertToDomain = 0, CopyFromDomain = 1, Clone = 2, QueryPointerBufferSize = 3, CloneEx = 4 };
+
+struct Buffer {
+    uint64_t address = 0;
+    uint64_t size = 0;
+    uint32_t extra = 0; ///< X: the descriptor's index ("counter"); A/B/W: the mapping flags
+};
+
+/// One parsed request.
+struct Request {
+    Type type{};
+    bool valid = false;
+    bool has_pid = false;
+    uint64_t pid = 0;
+    std::vector<uint32_t> copy_handles, move_handles;
+    std::vector<Buffer> x, a, b, w, c;
+    uint32_t c_mode = 0; ///< 0 none, 1 inline, 2 one descriptor, n>2: n-2 descriptors
+    // Domain sessions only.
+    bool has_domain = false;
+    DomainCommand domain_command{};
+    uint32_t object_id = 0;
+    std::vector<uint32_t> input_objects;
+    // CMIF payload.
+    uint32_t command = 0;
+    std::vector<uint8_t> data; ///< the arguments after the "SFCI" header
+
+    /// Reads a message. `domain`: the session is a domain (request messages carry the domain header).
+    static Request Parse(const uint8_t* msg, bool domain) {
+        Request r;
+        uint32_t w[MessageSize / 4];
+        std::memcpy(w, msg, MessageSize);
+        size_t i = 0;
+        r.type = static_cast<Type>(w[0] & 0xFFFF);
+        const uint32_t nx = (w[0] >> 16) & 15, na = (w[0] >> 20) & 15, nb = (w[0] >> 24) & 15, nw = (w[0] >> 28) & 15;
+        const uint32_t data_words = w[1] & 0x3FF;
+        r.c_mode = (w[1] >> 10) & 15;
+        const bool handles = (w[1] >> 31) != 0;
+        i = 2;
+        if (r.type == Type::Close) {
+            r.valid = true;
+            return r;
+        }
+        if (handles) {
+            const uint32_t h = w[i++];
+            r.has_pid = h & 1;
+            const uint32_t ncopy = (h >> 1) & 15, nmove = (h >> 5) & 15;
+            if (r.has_pid) {
+                r.pid = w[i] | (uint64_t{w[i + 1]} << 32);
+                i += 2;
+            }
+            for (uint32_t k = 0; k < ncopy && i < 64; ++k) r.copy_handles.push_back(w[i++]);
+            for (uint32_t k = 0; k < nmove && i < 64; ++k) r.move_handles.push_back(w[i++]);
+        }
+        for (uint32_t k = 0; k < nx && i + 1 < 64; ++k, i += 2) {
+            const uint32_t d = w[i];
+            Buffer bf;
+            bf.extra = (d & 0x3F) | (((d >> 9) & 7) << 9);
+            bf.address = w[i + 1] | (uint64_t((d >> 12) & 15) << 32) | (uint64_t((d >> 6) & 7) << 36);
+            bf.size = d >> 16;
+            r.x.push_back(bf);
+        }
+        auto abw = [&](uint32_t n, std::vector<Buffer>& out) {
+            for (uint32_t k = 0; k < n && i + 2 < 64; ++k, i += 3) {
+                const uint32_t f = w[i + 2];
+                Buffer bf;
+                bf.size = w[i] | (uint64_t((f >> 24) & 15) << 32);
+                bf.address = w[i + 1] | (uint64_t((f >> 28) & 15) << 32) | (uint64_t((f >> 2) & 7) << 36);
+                bf.extra = f & 3;
+                out.push_back(bf);
+            }
+        };
+        abw(na, r.a);
+        abw(nb, r.b);
+        abw(nw, r.w);
+        const size_t raw_start = i;
+        const size_t c_start = raw_start + data_words;
+        size_t p = (i + 3) & ~size_t{3};
+        if (domain && (r.type == Type::Request || r.type == Type::RequestWithContext)) {
+            if (p + 4 > 64) return r;
+            r.has_domain = true;
+            r.domain_command = static_cast<DomainCommand>(w[p] & 0xFF);
+            const uint32_t nobj = (w[p] >> 8) & 0xFF;
+            const uint32_t payload_bytes = w[p] >> 16;
+            r.object_id = w[p + 1];
+            p += 4;
+            if (r.domain_command == DomainCommand::CloseObject) {
+                r.valid = true;
+                return r;
+            }
+            const size_t obj_at = p + payload_bytes / 4;
+            for (uint32_t k = 0; k < nobj && obj_at + k < 64; ++k) r.input_objects.push_back(w[obj_at + k]);
+            if (payload_bytes < 16 || p + payload_bytes / 4 > 64) return r;
+            if (w[p] != MagicIn) return r;
+            r.command = w[p + 2];
+            r.data.assign(msg + (p + 4) * 4, msg + p * 4 + payload_bytes);
+        } else {
+            if (p + 4 > 64) return r;
+            if (w[p] != MagicIn) return r;
+            r.command = w[p + 2];
+            // The arguments run to the end of the raw data (minus the header and the alignment padding).
+            const size_t end = std::min<size_t>(c_start, 64);
+            if (end > p + 4) r.data.assign(msg + (p + 4) * 4, msg + end * 4);
+        }
+        if (r.c_mode >= 2) {
+            const uint32_t nc = r.c_mode == 2 ? 1 : r.c_mode - 2;
+            for (uint32_t k = 0; k < nc && c_start + 2 * k + 1 < 64; ++k) {
+                const uint32_t lo = w[c_start + 2 * k], hi = w[c_start + 2 * k + 1];
+                r.c.push_back({lo | (uint64_t(hi & 0xFFFF) << 32), hi >> 16, 0});
+            }
+        }
+        r.valid = true;
+        return r;
+    }
+};
+
+/// One reply, written over the request.
+struct Reply {
+    uint32_t result = 0;
+    std::vector<uint8_t> data; ///< values after the result
+    std::vector<uint32_t> copy_handles, move_handles;
+    std::vector<uint32_t> out_objects; ///< domain object ids (domain sessions only)
+
+    /// Each value at its natural alignment (as the SDK reads them: a bool then a u32 puts the u32 at offset 4).
+    template <typename T>
+    void Push(const T& v) {
+        const size_t at = (data.size() + alignof(T) - 1) / alignof(T) * alignof(T);
+        data.resize(at + sizeof(T));
+        std::memcpy(data.data() + at, &v, sizeof(T));
+    }
+    /// Pads the values to a multiple of `align` bytes (the SDK reads 8-byte values at aligned places).
+    void Align(size_t align) { data.resize((data.size() + align - 1) / align * align); }
+
+    /// Writes the message. `domain`: the request came with a domain header (the reply then carries one).
+    void Write(uint8_t* msg, bool domain) const {
+        uint32_t w[MessageSize / 4]{};
+        const size_t value_words = (data.size() + 3) / 4;
+        // Raw data: 16 bytes of alignment padding + [domain header] + "SFCO" header (16) + values + [object ids].
+        const uint32_t raw_words = static_cast<uint32_t>(4 + (domain ? 4 + out_objects.size() : 0) + 4 + value_words);
+        w[0] = 0;
+        w[1] = raw_words;
+        size_t i = 2;
+        if (!copy_handles.empty() || !move_handles.empty()) {
+            w[1] |= 1u << 31;
+            w[i++] = static_cast<uint32_t>(copy_handles.size() << 1 | move_handles.size() << 5);
+            for (const uint32_t h : copy_handles) w[i++] = h;
+            for (const uint32_t h : move_handles) w[i++] = h;
+        }
+        i = (i + 3) & ~size_t{3};
+        if (domain) {
+            w[i] = static_cast<uint32_t>(out_objects.size());
+            i += 4;
+        }
+        w[i] = MagicOut;
+        w[i + 1] = 0;
+        w[i + 2] = result;
+        w[i + 3] = 0;
+        i += 4;
+        if (!data.empty()) std::memcpy(&w[i], data.data(), std::min(data.size(), (64 - i) * 4));
+        i += value_words;
+        if (domain)
+            for (const uint32_t o : out_objects) w[i++] = o;
+        std::memcpy(msg, w, MessageSize);
+    }
+};
+
+/// Reads arguments in order, each at its natural alignment (as the SDK lays them out).
+class Args {
+public:
+    explicit Args(const std::vector<uint8_t>& d) : data{d} {}
+    template <typename T>
+    T Pop() {
+        pos = (pos + alignof(T) - 1) / alignof(T) * alignof(T);
+        T v{};
+        if (pos + sizeof(T) <= data.size()) std::memcpy(&v, data.data() + pos, sizeof(T));
+        pos += sizeof(T);
+        return v;
+    }
+    template <typename T>
+    T PopRaw() { // packed structures: no alignment
+        T v{};
+        if (pos + sizeof(T) <= data.size()) std::memcpy(&v, data.data() + pos, sizeof(T));
+        pos += sizeof(T);
+        return v;
+    }
+    void Skip(size_t n) { pos += n; }
+
+private:
+    const std::vector<uint8_t>& data;
+    size_t pos = 0;
+};
+
+} // namespace KartRuntime::Hipc
diff --git a/src/kart_runtime/native_fs.h b/src/kart_runtime/native_fs.h
new file mode 100644
index 0000000000..6fcddd551f
--- /dev/null
+++ b/src/kart_runtime/native_fs.h
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the game's read-only content files through the console SDK's nn::fs calls, natively
+// (docs/NATIVE_ENGINE.md, "native file system").
+//
+// The game mounts its content ("rom:") and opens, reads, sizes and lists files there with nn::fs::OpenFile / ReadFile /
+// GetFileSize / GetEntryType / OpenDirectory / ReadDirectory. On the console the SDK parses the RomFS image itself and reads it
+// through the file system service. Here those calls are answered from a host tree (`Tree`: the game's RomFS with mods applied,
+// given by the engine), with the SDK's rules: "<mount>:/path" names, file and directory handles, the result codes the game
+// checks, and the 0x310-byte directory entries. Paths on other mounts (save data, add-on content) are not ours: the caller
+// lets the SDK handle them.
+//
+// Standard library only (tests: tests/test_native_fs.cpp).
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace KartRuntime {
+
+class NativeFs {
+public:
+    /// The content tree. Paths are normalised: no mount name, components joined by '/', no leading '/' ("" = the root).
+    class Tree {
+    public:
+        struct Entry {
+            std::string name;
+            bool directory = false;
+            uint64_t size = 0;
+        };
+        virtual ~Tree() = default;
+        /// An id for the file at `path`, or -1 when there is no such file.
+        virtual int64_t OpenFile(const std::string& path) = 0;
+        virtual void CloseFile(int64_t id) = 0;
+        virtual uint64_t FileSize(int64_t id) = 0;
+        /// Reads up to `size` bytes at `offset`; returns how many were read.
+        virtual uint64_t ReadFile(int64_t id, uint64_t offset, void* out, uint64_t size) = 0;
+        virtual bool IsDirectory(const std::string& path) = 0;
+        /// The directory's subdirectories, then its files (the SDK's RomFS order). False when it is not a directory.
+        virtual bool List(const std::string& path, std::vector<Entry>& out) = 0;
+    };
+
+    // nn::Result values (module 2 = fs).
+    static constexpr uint32_t ResultSuccess = 0;
+    static constexpr uint32_t ResultPathNotFound = 2 | (1u << 9);
+    static constexpr uint32_t ResultOutOfRange = 2 | (3001u << 9);
+    static constexpr uint32_t ResultInvalidOpenMode = 2 | (6200u << 9);
+    static constexpr uint32_t ResultUnsupportedOperation = 2 | (6300u << 9);
+
+    /// Handle values never collide with the SDK's (which are game heap addresses, below 2^39).
+    static constexpr uint64_t HandleTag = 0x4B52000000000000ull; // "KR"
+    static bool IsOurs(uint64_t handle) { return (handle & 0xFFFF000000000000ull) == HandleTag; }
+
+    static constexpr size_t EntrySize = 0x310; ///< nn::fs::DirectoryEntry
+    static constexpr size_t EntryNameMax = 0x300;
+
+    /// MountRom: `name` now refers to `tree`.
+    void Mount(const std::string& name, std::shared_ptr<Tree> tree) {
+        std::scoped_lock lk{mutex};
+        mounts[name] = std::move(tree);
+    }
+    bool Unmount(const std::string& name) {
+        std::scoped_lock lk{mutex};
+        return mounts.erase(name) != 0;
+    }
+
+    /// True when `path` names one of our mounts ("rom:/..."); the caller passes other paths to the SDK.
+    bool Handles(std::string_view path) {
+        std::scoped_lock lk{mutex};
+        return Find(path, nullptr) != nullptr;
+    }
+
+    uint32_t OpenFile(std::string_view path, int mode, uint64_t* out_handle) {
+        std::scoped_lock lk{mutex};
+        std::string rel;
+        const std::shared_ptr<Tree> tree = Find(path, &rel);
+        if (!tree) return ResultPathNotFound;
+        if (mode & ~7) return ResultInvalidOpenMode;
+        if (mode & 6) return ResultUnsupportedOperation; // write / append on read-only content
+        const int64_t id = tree->OpenFile(rel);
+        if (id < 0) return ResultPathNotFound;
+        const uint64_t h = HandleTag | ++next_handle;
+        files[h] = {tree, id};
+        *out_handle = h;
+        return ResultSuccess;
+    }
+
+    void CloseFile(uint64_t handle) {
+        std::scoped_lock lk{mutex};
+        if (auto it = files.find(handle); it != files.end()) {
+            it->second.tree->CloseFile(it->second.id);
+            files.erase(it);
+        }
+    }
+
+    uint32_t GetFileSize(uint64_t handle, int64_t* out) {
+        std::scoped_lock lk{mutex};
+        const auto it = files.find(handle);
+        if (it == files.end()) return ResultUnsupportedOperation;
+        *out = static_cast<int64_t>(it->second.tree->FileSize(it->second.id));
+        return ResultSuccess;
+    }
+
+    /// ReadFile with a read-size result: reads what is there (0 at the end); an offset past the end is out of range.
+    uint32_t ReadFile(uint64_t handle, int64_t offset, void* out, uint64_t size, uint64_t* out_read) {
+        File f;
+        {
+            std::scoped_lock lk{mutex};
+            const auto it = files.find(handle);
+            if (it == files.end()) return ResultUnsupportedOperation;
+            f = it->second;
+        }
+        const uint64_t file_size = f.tree->FileSize(f.id);
+        if (offset < 0 || static_cast<uint64_t>(offset) > file_size) return ResultOutOfRange;
+        const uint64_t want = std::min<uint64_t>(size, file_size - static_cast<uint64_t>(offset));
+        *out_read = want ? f.tree->ReadFile(f.id, static_cast<uint64_t>(offset), out, want) : 0;
+        return ResultSuccess;
+    }
+
+    /// ReadFile without a read-size result: the whole range must be in the file.
+    uint32_t ReadFileExact(uint64_t handle, int64_t offset, void* out, uint64_t size) {
+        uint64_t read = 0;
+        if (const uint32_t r = ReadFile(handle, offset, out, size, &read); r != ResultSuccess) return r;
+        return read == size ? ResultSuccess : ResultOutOfRange;
+    }
+
+    /// GetEntryType: 0 = directory, 1 = file.
+    uint32_t GetEntryType(std::string_view path, int* out_type) {
+        std::scoped_lock lk{mutex};
+        std::string rel;
+        const std::shared_ptr<Tree> tree = Find(path, &rel);
+        if (!tree) return ResultPathNotFound;
+        if (tree->IsDirectory(rel)) {
+            *out_type = 0;
+            return ResultSuccess;
+        }
+        const int64_t id = tree->OpenFile(rel);
+        if (id < 0) return ResultPathNotFound;
+        tree->CloseFile(id);
+        *out_type = 1;
+        return ResultSuccess;
+    }
+
+    /// OpenDirectory: mode bit 0 = directories, bit 1 = files.
+    uint32_t OpenDirectory(std::string_view path, int mode, uint64_t* out_handle) {
+        std::scoped_lock lk{mutex};
+        std::string rel;
+        const std::shared_ptr<Tree> tree = Find(path, &rel);
+        if (!tree) return ResultPathNotFound;
+        if ((mode & 3) == 0 || (mode & ~0x80000003)) return ResultInvalidOpenMode;
+        std::vector<Tree::Entry> all;
+        if (!tree->List(rel, all)) return ResultPathNotFound;
+        Dir d;
+        for (auto& e : all) {
+            if ((e.directory && (mode & 1)) || (!e.directory && (mode & 2))) d.entries.push_back(std::move(e));
+        }
+        const uint64_t h = HandleTag | ++next_handle;
+        dirs[h] = std::move(d);
+        *out_handle = h;
+        return ResultSuccess;
+    }
+
+    /// ReadDirectory: up to `max` entries into `out` (EntrySize bytes each); `*out_count` = how many (0 when all were read).
+    uint32_t ReadDirectory(uint64_t handle, uint8_t* out, int64_t max, int64_t* out_count) {
+        std::scoped_lock lk{mutex};
+        const auto it = dirs.find(handle);
+        if (it == dirs.end()) return ResultUnsupportedOperation;
+        Dir& d = it->second;
+        int64_t n = 0;
+        while (n < max && d.next < d.entries.size()) {
+            const auto& e = d.entries[d.next++];
+            uint8_t* p = out + static_cast<size_t>(n) * EntrySize;
+            std::memset(p, 0, EntrySize);
+            std::memcpy(p, e.name.data(), std::min(e.name.size(), EntryNameMax));
+            p[0x304] = e.directory ? 0 : 1;
+            const int64_t size = e.directory ? 0 : static_cast<int64_t>(e.size);
+            std::memcpy(p + 0x308, &size, sizeof(size));
+            ++n;
+        }
+        *out_count = n;
+        return ResultSuccess;
+    }
+
+    void CloseDirectory(uint64_t handle) {
+        std::scoped_lock lk{mutex};
+        dirs.erase(handle);
+    }
+
+    size_t OpenCount() {
+        std::scoped_lock lk{mutex};
+        return files.size() + dirs.size();
+    }
+
+    /// "rom:/a//b/./c/../d" -> mount "rom", path "a/b/d". False when there is no "<name>:" prefix.
+    static bool Split(std::string_view path, std::string* mount, std::string* rel) {
+        const size_t colon = path.find(':');
+        if (colon == std::string_view::npos || colon == 0) return false;
+        *mount = std::string{path.substr(0, colon)};
+        std::vector<std::string_view> parts;
+        std::string_view rest = path.substr(colon + 1);
+        while (!rest.empty()) {
+            const size_t slash = rest.find_first_of("/\\");
+            const std::string_view part = rest.substr(0, slash);
+            rest = slash == std::string_view::npos ? std::string_view{} : rest.substr(slash + 1);
+            if (part.empty() || part == ".") continue;
+            if (part == "..") {
+                if (!parts.empty()) parts.pop_back();
+                continue;
+            }
+            parts.push_back(part);
+        }
+        rel->clear();
+        for (size_t i = 0; i < parts.size(); ++i) {
+            if (i) rel->push_back('/');
+            rel->append(parts[i]);
+        }
+        return true;
+    }
+
+private:
+    struct File {
+        std::shared_ptr<Tree> tree;
+        int64_t id = -1;
+    };
+    struct Dir {
+        std::vector<Tree::Entry> entries;
+        size_t next = 0;
+    };
+
+    std::shared_ptr<Tree> Find(std::string_view path, std::string* rel) {
+        std::string mount, r;
+        if (!Split(path, &mount, &r)) return nullptr;
+        const auto it = mounts.find(mount);
+        if (it == mounts.end()) return nullptr;
+        if (rel) *rel = std::move(r);
+        return it->second;
+    }
+
+    std::mutex mutex;
+    std::map<std::string, std::shared_ptr<Tree>> mounts;
+    std::map<uint64_t, File> files;
+    std::map<uint64_t, Dir> dirs;
+    uint64_t next_handle = 0;
+};
+
+} // namespace KartRuntime
diff --git a/src/kart_runtime/native_kernel.h b/src/kart_runtime/native_kernel.h
new file mode 100644
index 0000000000..43f996ab22
--- /dev/null
+++ b/src/kart_runtime/native_kernel.h
@@ -0,0 +1,551 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the kernel objects a game sees through handles - service sessions, events - and waiting on them
+// (docs/NATIVE_ENGINE.md, "native services").
+//
+// Handles: the console kernel's handles are (linear id << 15 | table index) with the top two bits clear; ours have bit 30 set,
+// so they can live next to the emulated kernel's while services move over one at a time (`IsNative`).
+// Sessions: a session leads to one service object, or - after ConvertToDomain - to a table of objects addressed by id
+// ("domain"), as on the console. Requests are answered synchronously on the calling thread.
+// Events: the readable side of a console event: signalled by its service, cleared by ResetSignal (or by the service), waited
+// on with WaitSynchronization together with other events.
+//
+// Standard library only (tests: tests/test_native_kernel.cpp).
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+#include "hipc.h"
+
+namespace KartRuntime {
+
+// Result codes (module 1 = kernel).
+namespace KernelResult {
+constexpr uint32_t Success = 0;
+constexpr uint32_t TimedOut = 0xEA01;
+constexpr uint32_t Cancelled = 0xEC01;
+constexpr uint32_t OutOfRange = 0xEE01;
+constexpr uint32_t InvalidHandle = 0xE401;
+constexpr uint32_t InvalidState = 0xFA01;
+constexpr uint32_t SessionClosed = 0xF601;
+} // namespace KernelResult
+
+/// Result codes of the service framework (module 10 = cmif).
+namespace CmifResult {
+constexpr uint32_t UnknownCommand = 0x25A0A; // 10 | (301 << 9)
+constexpr uint32_t InvalidObject = 0x1A80A;  // 10 | (212 << 9)
+} // namespace CmifResult
+
+enum class ObjectType { Event, Service, Session, SharedMemory, Thread, TransferMemory, Other };
+
+/// Objects behind handles. Types are told apart by `Type()` (the engine builds without RTTI).
+class KernelObject : public std::enable_shared_from_this<KernelObject> {
+public:
+    virtual ~KernelObject() = default;
+    virtual const char* Kind() const = 0;
+    virtual ObjectType Type() const = 0;
+    virtual bool IsWaitable() const { return false; }
+};
+
+class NativeKernel;
+
+/// A waitable object (events).
+class Waitable : public KernelObject {
+public:
+    bool IsSignaled() const;
+    bool IsWaitable() const override { return true; }
+
+protected:
+    friend class NativeKernel;
+    friend class Event;
+    explicit Waitable(NativeKernel& k) : kernel{k} {}
+    NativeKernel& kernel;
+    bool signaled = false; ///< guarded by the kernel's wait lock
+};
+
+/// The readable side of an event, plus Signal/Clear for its service.
+class Event : public Waitable {
+public:
+    explicit Event(NativeKernel& k, std::string n = {}) : Waitable{k}, name{std::move(n)} {}
+    const char* Kind() const override { return "event"; }
+    static constexpr ObjectType StaticType = ObjectType::Event;
+    ObjectType Type() const override { return StaticType; }
+    void Signal();
+    void Clear();
+    const std::string name;
+};
+
+class Service;
+
+/// What a service sees of one request: the parsed message, guest memory, and the reply it fills in.
+class Context {
+public:
+    Context(NativeKernel& k, const Hipc::Request& r) : kernel{k}, request{r}, args{r.data} {}
+    NativeKernel& kernel;
+    const Hipc::Request& request;
+    Hipc::Args args;
+    Hipc::Reply reply;
+    uint32_t Command() const { return request.command; }
+    uint64_t Pid() const { return request.pid; }
+
+    template <typename T>
+    T Pop() { return args.Pop<T>(); }
+    template <typename T>
+    void Push(const T& v) { reply.Push(v); }
+    void SetResult(uint32_t r) { reply.result = r; }
+
+    /// An input buffer: A (mapped) or X (pointer) number `i` - the "auto select" rule: whichever has a size.
+    std::vector<uint8_t> ReadBuffer(size_t i = 0) const;
+    /// An output buffer: B (mapped) or C (receive list) number `i`; returns how many bytes were written.
+    size_t WriteBuffer(const void* src, size_t size, size_t i = 0);
+    size_t WriteBufferSize(size_t i = 0) const;
+    uint64_t ReadBufferAddress(size_t i = 0) const;
+
+    /// A new interface object: a domain object id when the session is a domain, otherwise a new session (move handle).
+    void PushInterface(std::shared_ptr<Service> s);
+    /// A copy handle to `o` (events, shared memory).
+    void PushCopyObject(std::shared_ptr<KernelObject> o);
+    /// A move handle (raw kernel handle produced elsewhere, e.g. by the emulated kernel).
+    /// An interface object passed in by the client: a domain object id, or a session handle (move) on a plain session.
+    std::shared_ptr<Service> InputObject(size_t i = 0);
+    void PushMoveHandle(uint32_t h) { reply.move_handles.push_back(h); }
+    void PushCopyHandle(uint32_t h) { reply.copy_handles.push_back(h); }
+
+    // Set by the kernel while it runs the request.
+    struct SessionState* session = nullptr;
+    bool domain = false;
+};
+
+/// A service object (an IPC interface). Commands by id; unknown ones answer "unknown command".
+class Service : public KernelObject {
+public:
+    using Handler = std::function<void(Context&)>;
+    explicit Service(std::string n) : name{std::move(n)} {}
+    const char* Kind() const override { return "service"; }
+    static constexpr ObjectType StaticType = ObjectType::Service;
+    ObjectType Type() const override { return StaticType; }
+    const std::string name;
+
+    void Handle(Context& ctx) {
+        std::unique_lock lk{mutex, std::defer_lock};
+        if (serialize) lk.lock();
+        if (const auto it = handlers.find(ctx.Command()); it != handlers.end()) {
+            ctx.SetResult(0);
+            if (on_call) on_call(name, ctx.Command());
+            it->second(ctx);
+            ++calls;
+            if (ctx.reply.result != 0 && on_error) on_error(name, ctx.Command(), ctx.reply.result);
+        } else {
+            ctx.SetResult(CmifResult::UnknownCommand);
+            ++unknown;
+            if (on_unknown) on_unknown(name, ctx.Command());
+        }
+    }
+    void On(uint32_t cmd, Handler h) { handlers[cmd] = std::move(h); }
+    /// A command that only answers success (the game only needs the call to succeed).
+    void Ok(uint32_t cmd) { handlers[cmd] = [](Context&) {}; }
+    bool Has(uint32_t cmd) const { return handlers.contains(cmd); }
+
+    uint64_t calls = 0, unknown = 0;
+    bool serialize = true; ///< one request at a time (the console's services are single-threaded per session)
+    static inline std::function<void(const std::string&, uint32_t)> on_unknown, on_call;
+    /// A command that answered an error result (diagnostics).
+    static inline std::function<void(const std::string&, uint32_t, uint32_t)> on_error;
+
+private:
+    std::mutex mutex;
+    std::map<uint32_t, Handler> handlers;
+};
+
+struct SessionState {
+    std::shared_ptr<Service> target;     ///< plain session
+    bool domain = false;
+    std::map<uint32_t, std::shared_ptr<Service>> objects; ///< domain objects by id
+    uint32_t next_object = 1;
+    bool closed = false;
+    std::mutex mutex;
+};
+
+/// A client session handle's object.
+class Session : public KernelObject {
+public:
+    explicit Session(std::shared_ptr<SessionState> s) : state{std::move(s)} {}
+    const char* Kind() const override { return "session"; }
+    static constexpr ObjectType StaticType = ObjectType::Session;
+    ObjectType Type() const override { return StaticType; }
+    std::shared_ptr<SessionState> state;
+};
+
+class NativeKernel {
+public:
+    struct Hooks {
+        std::function<bool(uint64_t addr, void* out, size_t n)> read;        ///< guest memory
+        std::function<bool(uint64_t addr, const void* in, size_t n)> write;  ///< guest memory
+        std::function<void()> before_block, after_block; ///< a thread is about to wait / has stopped waiting
+        std::function<uint64_t()> process_id;            ///< the calling thread's process id (the kernel sends it, not the game)
+    };
+    explicit NativeKernel(Hooks h) : hooks{std::move(h)} {}
+
+    /// Runs `f` (a host call that may block, e.g. a socket receive) as a wait of the calling thread, so the scheduler lets other
+    /// game threads run on its core meanwhile.
+    template <typename F>
+    auto Blocking(F&& f) {
+        if (hooks.before_block) hooks.before_block();
+        struct After {
+            const Hooks& h;
+            ~After() { if (h.after_block) h.after_block(); }
+        } after{hooks};
+        return f();
+    }
+
+    /// Next to the emulated kernel, runtime handles carry bit 30 so the two kinds can be told apart (IsNative). As the game's only
+    /// kernel (GameKernel) they must not: the SDK's lock words keep the owner thread's handle and use bit 30 as their "waiters"
+    /// flag, so a handle with bit 30 makes every lock look unowned and contended (SetPlainHandles; handles are then small
+    /// numbers, as on the console).
+    static constexpr uint32_t HandleBit = 1u << 30;
+    static bool IsNative(uint32_t handle) { return (handle & 0xC0000000u) == HandleBit; }
+    void SetPlainHandles() { handle_bit = 0; }
+    bool Owns(uint32_t handle) const { return handle != 0 && (handle & 0xC0000000u) == handle_bit; }
+
+    // ---- handle table
+    uint32_t Add(std::shared_ptr<KernelObject> o) {
+        std::scoped_lock lk{table_mutex};
+        uint32_t index = 0;
+        if (!free_slots.empty()) {
+            index = *free_slots.begin();
+            free_slots.erase(free_slots.begin());
+        } else {
+            index = static_cast<uint32_t>(table.size());
+            table.emplace_back();
+        }
+        table[index] = std::move(o);
+        return handle_bit | (index + 1);
+    }
+    std::shared_ptr<KernelObject> Get(uint32_t handle) {
+        std::scoped_lock lk{table_mutex};
+        if (!Owns(handle)) return nullptr;
+        const uint32_t index = (handle & ~handle_bit) - 1;
+        return index < table.size() ? table[index] : nullptr;
+    }
+    template <typename T>
+    std::shared_ptr<T> GetAs(uint32_t handle) {
+        std::shared_ptr<KernelObject> o = Get(handle);
+        if (!o) return nullptr;
+        if constexpr (std::is_same_v<T, Waitable>) {
+            if (!o->IsWaitable()) return nullptr;
+        } else {
+            if (o->Type() != T::StaticType) return nullptr;
+        }
+        return std::static_pointer_cast<T>(o);
+    }
+    bool Close(uint32_t handle) {
+        std::shared_ptr<KernelObject> dropped; // released outside the lock
+        std::scoped_lock lk{table_mutex};
+        if (!Owns(handle)) return false;
+        const uint32_t index = (handle & ~handle_bit) - 1;
+        if (index >= table.size() || !table[index]) return false;
+        dropped = std::move(table[index]);
+        free_slots.insert(index);
+        return true;
+    }
+    /// The process is gone: every object behind a handle is released (services finish their work, e.g. the audio renderer).
+    void CloseAll() {
+        std::vector<std::shared_ptr<KernelObject>> dropped;
+        {
+            std::scoped_lock lk{table_mutex};
+            dropped.swap(table);
+            free_slots.clear();
+        }
+        dropped.clear();
+    }
+    size_t HandleCount() {
+        std::scoped_lock lk{table_mutex};
+        return table.size() - free_slots.size();
+    }
+
+    /// A new session to `service`: the client handle.
+    uint32_t OpenSession(std::shared_ptr<Service> service) {
+        auto st = std::make_shared<SessionState>();
+        st->target = std::move(service);
+        return Add(std::make_shared<Session>(std::move(st)));
+    }
+
+    /// SendSyncRequest on one of our sessions: reads the message at `msg` (0x100 bytes, host copy of the thread's TLS), answers
+    /// it, writes the reply back. Returns the system call result.
+    uint32_t SendSyncRequest(uint32_t handle, uint8_t* msg) {
+        const auto session = GetAs<Session>(handle);
+        if (!session) return KernelResult::InvalidHandle;
+        SessionState& st = *session->state;
+        const bool domain = st.domain;
+        Hipc::Request req = Hipc::Request::Parse(msg, domain);
+        if (!req.valid) return KernelResult::InvalidState;
+        if (req.has_pid && hooks.process_id) req.pid = hooks.process_id();
+        if (req.type == Hipc::Type::Close) {
+            // The server side goes; the client closes its handle itself afterwards (CloseHandle), as on the console.
+            std::shared_ptr<Service> gone;
+            std::map<uint32_t, std::shared_ptr<Service>> gone_objects;
+            {
+                std::scoped_lock lk{st.mutex};
+                gone = std::move(st.target);
+                gone_objects.swap(st.objects);
+                st.closed = true;
+            }
+            Hipc::Reply{}.Write(msg, false);
+            return KernelResult::Success;
+        }
+        if (st.closed) return KernelResult::SessionClosed;
+        Context ctx{*this, req};
+        ctx.session = &st;
+        ctx.domain = domain && req.has_domain;
+        if (req.type == Hipc::Type::Control || req.type == Hipc::Type::ControlWithContext) {
+            HandleControl(ctx, handle, st);
+            ctx.reply.Write(msg, false);
+            return KernelResult::Success;
+        }
+        std::shared_ptr<Service> target;
+        if (domain) {
+            std::scoped_lock lk{st.mutex};
+            if (req.has_domain && req.domain_command == Hipc::DomainCommand::CloseObject) {
+                std::shared_ptr<Service> gone; // released after the lock
+                if (auto it = st.objects.find(req.object_id); it != st.objects.end()) {
+                    gone = std::move(it->second);
+                    st.objects.erase(it);
+                }
+                Hipc::Reply r;
+                r.Write(msg, false);
+                return KernelResult::Success;
+            }
+            if (const auto it = st.objects.find(req.object_id); it != st.objects.end()) target = it->second;
+        } else {
+            target = st.target;
+        }
+        if (!target) {
+            ctx.SetResult(CmifResult::InvalidObject);
+            if (on_invalid_object) on_invalid_object(handle, req.object_id, req.command, domain);
+        } else {
+            target->Handle(ctx);
+        }
+        ctx.reply.Write(msg, ctx.domain);
+        return KernelResult::Success;
+    }
+
+    // ---- waiting
+    /// WaitSynchronization: index of a signalled object, or TimedOut / Cancelled. timeout_ns < 0: forever; 0: poll.
+    uint32_t WaitAny(uint64_t thread_id, const std::vector<std::shared_ptr<Waitable>>& objs, int64_t timeout_ns, int32_t* out_index) {
+        using Clock = std::chrono::steady_clock;
+        const auto deadline = timeout_ns > 0 ? Clock::now() + std::chrono::nanoseconds(timeout_ns) : Clock::time_point::max();
+        std::unique_lock lk{wait_mutex};
+        if (cancel_pending.erase(thread_id) || terminated.contains(thread_id)) return KernelResult::Cancelled;
+        for (size_t i = 0; i < objs.size(); ++i) {
+            if (objs[i]->signaled) {
+                *out_index = static_cast<int32_t>(i);
+                return KernelResult::Success;
+            }
+        }
+        if (timeout_ns == 0) return KernelResult::TimedOut;
+        Waiter me;
+        me.thread_id = thread_id;
+        for (const auto& o : objs) waiters[o.get()].push_back(&me);
+        by_thread[thread_id] = &me;
+        uint32_t result = KernelResult::TimedOut;
+        if (hooks.before_block) {
+            lk.unlock();
+            hooks.before_block();
+            lk.lock();
+        }
+        for (;;) {
+            if (me.cancelled) {
+                result = KernelResult::Cancelled;
+                break;
+            }
+            bool found = false;
+            for (size_t i = 0; i < objs.size(); ++i) {
+                if (objs[i]->signaled) {
+                    *out_index = static_cast<int32_t>(i);
+                    result = KernelResult::Success;
+                    found = true;
+                    break;
+                }
+            }
+            if (found) break;
+            if (deadline == Clock::time_point::max()) {
+                me.cv.wait(lk);
+            } else if (me.cv.wait_until(lk, deadline) == std::cv_status::timeout) {
+                // One last look, then give up.
+                for (size_t i = 0; i < objs.size(); ++i)
+                    if (objs[i]->signaled) {
+                        *out_index = static_cast<int32_t>(i);
+                        result = KernelResult::Success;
+                        found = true;
+                        break;
+                    }
+                if (!found) result = me.cancelled ? KernelResult::Cancelled : KernelResult::TimedOut;
+                break;
+            }
+        }
+        for (const auto& o : objs) {
+            auto& list = waiters[o.get()];
+            list.erase(std::remove(list.begin(), list.end(), &me), list.end());
+            if (list.empty()) waiters.erase(o.get());
+        }
+        by_thread.erase(thread_id);
+        lk.unlock();
+        if (hooks.after_block) hooks.after_block();
+        return result;
+    }
+
+    /// CancelSynchronization: the thread's current wait ends with Cancelled; when it is not waiting, its next wait does (unless
+    /// `remember` is false: then the caller keeps that state itself). True when a wait was ended.
+    bool CancelWait(uint64_t thread_id, bool remember = true) {
+        std::scoped_lock lk{wait_mutex};
+        if (const auto it = by_thread.find(thread_id); it != by_thread.end()) {
+            it->second->cancelled = true;
+            it->second->cv.notify_one();
+            return true;
+        }
+        if (remember) cancel_pending.insert(thread_id);
+        return false;
+    }
+    /// A thread that is being terminated: end its wait, and every later one, at once.
+    void Terminate(uint64_t thread_id) {
+        std::scoped_lock lk{wait_mutex};
+        terminated.insert(thread_id);
+        if (const auto it = by_thread.find(thread_id); it != by_thread.end()) {
+            it->second->cancelled = true;
+            it->second->cv.notify_one();
+        }
+    }
+    size_t Waiting() {
+        std::scoped_lock lk{wait_mutex};
+        return by_thread.size();
+    }
+
+    /// A request named an object the session does not have (diagnostics).
+    std::function<void(uint32_t handle, uint32_t object, uint32_t command, bool domain)> on_invalid_object;
+
+    bool Read(uint64_t addr, void* out, size_t n) { return hooks.read && hooks.read(addr, out, n); }
+    bool Write(uint64_t addr, const void* in, size_t n) { return hooks.write && hooks.write(addr, in, n); }
+
+private:
+    friend class Waitable;
+    friend class Event;
+    struct Waiter {
+        uint64_t thread_id = 0;
+        bool cancelled = false;
+        std::condition_variable cv;
+    };
+
+    void SetSignaled(Waitable* o, bool s) {
+        std::scoped_lock lk{wait_mutex};
+        o->signaled = s;
+        if (!s) return;
+        if (const auto it = waiters.find(o); it != waiters.end())
+            for (Waiter* w : it->second) w->cv.notify_one();
+    }
+
+    void HandleControl(Context& ctx, uint32_t handle, SessionState& st) {
+        switch (static_cast<Hipc::Control>(ctx.Command())) {
+        case Hipc::Control::ConvertToDomain: {
+            std::scoped_lock lk{st.mutex};
+            uint32_t id = 0;
+            if (!st.domain) {
+                st.domain = true;
+                id = st.next_object++;
+                st.objects[id] = st.target;
+            }
+            ctx.Push<uint32_t>(id);
+            break;
+        }
+        case Hipc::Control::Clone:
+        case Hipc::Control::CloneEx: {
+            // A second client handle to the same session (same domain table).
+            const auto obj = Get(handle);
+            ctx.PushMoveHandle(Add(obj));
+            break;
+        }
+        case Hipc::Control::QueryPointerBufferSize:
+            ctx.Push<uint16_t>(0x8000);
+            break;
+        default:
+            ctx.SetResult(CmifResult::UnknownCommand);
+            break;
+        }
+    }
+
+    Hooks hooks;
+    uint32_t handle_bit = HandleBit;
+    std::mutex table_mutex;
+    std::vector<std::shared_ptr<KernelObject>> table;
+    std::set<uint32_t> free_slots;
+
+    std::mutex wait_mutex;
+    std::map<const Waitable*, std::vector<Waiter*>> waiters;
+    std::map<uint64_t, Waiter*> by_thread;
+    std::set<uint64_t> cancel_pending, terminated;
+};
+
+inline bool Waitable::IsSignaled() const { return signaled; }
+inline void Event::Signal() { kernel.SetSignaled(this, true); }
+inline void Event::Clear() { kernel.SetSignaled(this, false); }
+
+inline std::vector<uint8_t> Context::ReadBuffer(size_t i) const {
+    const Hipc::Buffer* b = nullptr;
+    if (i < request.a.size() && request.a[i].size) b = &request.a[i];
+    else if (i < request.x.size()) b = &request.x[i];
+    if (!b) return {};
+    std::vector<uint8_t> out(b->size);
+    if (!out.empty() && !kernel.Read(b->address, out.data(), out.size())) out.clear();
+    return out;
+}
+inline uint64_t Context::ReadBufferAddress(size_t i) const {
+    if (i < request.a.size() && request.a[i].size) return request.a[i].address;
+    return i < request.x.size() ? request.x[i].address : 0;
+}
+inline size_t Context::WriteBufferSize(size_t i) const {
+    if (i < request.b.size() && request.b[i].size) return request.b[i].size;
+    return i < request.c.size() ? request.c[i].size : 0;
+}
+inline size_t Context::WriteBuffer(const void* src, size_t size, size_t i) {
+    const Hipc::Buffer* b = nullptr;
+    if (i < request.b.size() && request.b[i].size) b = &request.b[i];
+    else if (i < request.c.size()) b = &request.c[i];
+    if (!b) return 0;
+    size = std::min<size_t>(size, b->size);
+    return size && kernel.Write(b->address, src, size) ? size : 0;
+}
+inline void Context::PushInterface(std::shared_ptr<Service> s) {
+    if (domain && session) {
+        std::scoped_lock lk{session->mutex};
+        const uint32_t id = session->next_object++;
+        session->objects[id] = std::move(s);
+        reply.out_objects.push_back(id);
+    } else {
+        reply.move_handles.push_back(kernel.OpenSession(std::move(s)));
+    }
+}
+inline std::shared_ptr<Service> Context::InputObject(size_t i) {
+    if (domain && session) {
+        if (i >= request.input_objects.size()) return nullptr;
+        std::scoped_lock lk{session->mutex};
+        const auto it = session->objects.find(request.input_objects[i]);
+        return it == session->objects.end() ? nullptr : it->second;
+    }
+    if (i >= request.move_handles.size()) return nullptr;
+    const auto s = kernel.GetAs<Session>(request.move_handles[i]);
+    return s ? s->state->target : nullptr;
+}
+inline void Context::PushCopyObject(std::shared_ptr<KernelObject> o) {
+    reply.copy_handles.push_back(kernel.Add(std::move(o)));
+}
+
+} // namespace KartRuntime
