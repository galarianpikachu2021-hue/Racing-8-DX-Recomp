index 0000000000..e1eacc7ed6
--- /dev/null
+++ b/src/core/hle/kernel/native_bsd.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the socket service ("bsd:u", "bsd:s") answered by the runtime. The sockets are suyu's socket library
+// (core/hle/service/sockets/bsd_sockets: host sockets, or room proxy sockets while the engine is in a multiplayer room, which is
+// how local wireless play reaches the other members); this replaces only the service around it. The game opens it when it enters
+// Wireless Play (without it the game stopped there with 2021-0007).
+#include <atomic>
+#include <memory>
+#include <vector>
+
+#include "common/logging.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/sockets/bsd_sockets.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using namespace Service::Sockets;
+using KartRuntime::Context;
+using KartRuntime::Service;
+
+void PushResult(Context& c, s32 ret, Errno err) {
+    static std::atomic<int> logged{0};
+    if (err != Errno::SUCCESS && err != Errno::AGAIN && logged.fetch_add(1) < 50)
+        LOG_INFO(Service, "sockets: command {} -> {} errno {}", c.Command(), ret, static_cast<u32>(err));
+    c.Push<s32>(ret);
+    c.Push<u32>(static_cast<u32>(err));
+}
+/// Calls that answer 0 / -1 and errno.
+void PushErrno(Context& c, Errno err) { PushResult(c, err == Errno::SUCCESS ? 0 : -1, err); }
+
+std::vector<u8> OutBuffer(Context& c, size_t i = 0) { return std::vector<u8>(c.WriteBufferSize(i)); }
+
+} // namespace
+
+std::shared_ptr<Service> MakeSocketService(const char* name) {
+    auto& t = BsdSockets::Shared();
+    auto s = std::make_shared<Service>(name);
+    // Sockets block (receive, poll, accept): calls are not serialized, as on the console, and a blocking call is a wait of the
+    // calling thread.
+    s->serialize = false;
+    s->On(0, [](Context& c) { c.Push<s32>(0); }); // RegisterClient(config, pid, transfer memory) -> errno
+    s->Ok(1);                                      // StartMonitoring
+    s->On(2, [&t](Context& c) {                    // Socket(domain, type, protocol)
+        const u32 domain = c.Pop<u32>(), type = c.Pop<u32>(), protocol = c.Pop<u32>();
+        const auto [fd, err] = t.SocketImpl(static_cast<Domain>(domain), static_cast<Type>(type), static_cast<Protocol>(protocol));
+        PushResult(c, fd, err);
+    });
+    s->On(5, [](Context& c) { PushResult(c, 0, Errno::SUCCESS); }); // Select (as suyu: nothing ready)
+    s->On(6, [&t](Context& c) { // Poll(nfds, timeout ms; fds in, fds out)
+        const s32 nfds = c.Pop<s32>(), timeout = c.Pop<s32>();
+        const auto in = c.ReadBuffer(0);
+        auto out = OutBuffer(c);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.PollImpl(out, in, nfds, timeout); });
+        if (!out.empty()) c.WriteBuffer(out.data(), out.size(), 0);
+        PushResult(c, ret, err);
+    });
+    s->On(8, [&t](Context& c) { // Recv(fd, flags)
+        const s32 fd = c.Pop<s32>();
+        const u32 flags = c.Pop<u32>();
+        auto message = OutBuffer(c);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.RecvImpl(fd, flags, message); });
+        if (ret > 0) c.WriteBuffer(message.data(), static_cast<size_t>(ret), 0);
+        PushResult(c, ret, err);
+    });
+    s->On(9, [&t](Context& c) { // RecvFrom(fd, flags) -> message (0), address (1)
+        const s32 fd = c.Pop<s32>();
+        const u32 flags = c.Pop<u32>();
+        auto message = OutBuffer(c, 0);
+        auto addr = OutBuffer(c, 1);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.RecvFromImpl(fd, flags, message, addr); });
+        if (ret > 0) c.WriteBuffer(message.data(), static_cast<size_t>(ret), 0);
+        if (!addr.empty()) c.WriteBuffer(addr.data(), addr.size(), 1);
+        PushResult(c, ret, err);
+        c.Push<u32>(static_cast<u32>(addr.size()));
+    });
+    const auto send = [&t](Context& c, bool with_flags) { // Send(fd, flags) / Write(fd)
+        const s32 fd = c.Pop<s32>();
+        const u32 flags = with_flags ? c.Pop<u32>() : 0;
+        const auto message = c.ReadBuffer(0);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.SendImpl(fd, flags, message); });
+        PushResult(c, ret, err);
+    };
+    s->On(10, [send](Context& c) { send(c, true); });
+    s->On(24, [send](Context& c) { send(c, false); });
+    s->On(11, [&t](Context& c) { // SendTo(fd, flags; message 0, address 1)
+        const s32 fd = c.Pop<s32>();
+        const u32 flags = c.Pop<u32>();
+        const auto message = c.ReadBuffer(0);
+        const auto addr = c.ReadBuffer(1);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.SendToImpl(fd, flags, message, addr); });
+        PushResult(c, ret, err);
+    });
+    s->On(12, [&t](Context& c) { // Accept(fd) -> new fd, address
+        const s32 fd = c.Pop<s32>();
+        auto addr = OutBuffer(c);
+        const auto [ret, err] = c.kernel.Blocking([&] { return t.AcceptImpl(fd, addr); });
+        if (!addr.empty()) c.WriteBuffer(addr.data(), addr.size(), 0);
+        PushResult(c, ret, err);
+        c.Push<u32>(static_cast<u32>(addr.size()));
+    });
+    s->On(13, [&t](Context& c) { // Bind(fd; address)
+        const s32 fd = c.Pop<s32>();
+        const auto addr = c.ReadBuffer(0);
+        if (addr.size() < 16) return PushErrno(c, Errno::INVAL);
+        PushErrno(c, t.BindImpl(fd, addr));
+    });
+    s->On(14, [&t](Context& c) { // Connect(fd; address)
+        const s32 fd = c.Pop<s32>();
+        const auto addr = c.ReadBuffer(0);
+        if (addr.size() < 16) return PushErrno(c, Errno::INVAL);
+        PushErrno(c, c.kernel.Blocking([&] { return t.ConnectImpl(fd, addr); }));
+    });
+    const auto name_of = [&t](Context& c, bool peer) { // GetPeerName / GetSockName(fd) -> address
+        const s32 fd = c.Pop<s32>();
+        auto addr = OutBuffer(c);
+        if (addr.size() < sizeof(SockAddrIn)) return PushErrno(c, Errno::INVAL), c.Push<u32>(0);
+        const Errno err = peer ? t.GetPeerNameImpl(fd, addr) : t.GetSockNameImpl(fd, addr);
+        c.WriteBuffer(addr.data(), addr.size(), 0);
+        PushErrno(c, err);
+        c.Push<u32>(static_cast<u32>(addr.size()));
+    };
+    s->On(15, [name_of](Context& c) { name_of(c, true); });
+    s->On(16, [name_of](Context& c) { name_of(c, false); });
+    s->On(17, [&t](Context& c) { // GetSockOpt(fd, level, name) -> value
+        const s32 fd = c.Pop<s32>();
+        const u32 level = c.Pop<u32>();
+        const auto name = static_cast<OptName>(c.Pop<u32>());
+        auto value = OutBuffer(c);
+        const Errno err = t.GetSockOptImpl(fd, level, name, value);
+        if (!value.empty()) c.WriteBuffer(value.data(), value.size(), 0);
+        PushErrno(c, err);
+        c.Push<u32>(static_cast<u32>(value.size()));
+    });
+    s->On(18, [&t](Context& c) { // Listen(fd, backlog)
+        const s32 fd = c.Pop<s32>(), backlog = c.Pop<s32>();
+        PushErrno(c, t.ListenImpl(fd, backlog));
+    });
+    s->On(20, [&t](Context& c) { // Fcntl(fd, cmd, arg)
+        const s32 fd = c.Pop<s32>(), cmd = c.Pop<s32>(), arg = c.Pop<s32>();
+        const auto [ret, err] = t.FcntlImpl(fd, static_cast<FcntlCmd>(cmd), arg);
+        PushResult(c, ret, err);
+    });
+    s->On(21, [&t](Context& c) { // SetSockOpt(fd, level, name; value)
+        const s32 fd = c.Pop<s32>();
+        const u32 level = c.Pop<u32>();
+        const auto name = static_cast<OptName>(c.Pop<u32>());
+        const auto value = c.ReadBuffer(0);
+        if (value.size() < sizeof(u32) && level == static_cast<u32>(SocketLevel::SOCKET)) return PushErrno(c, Errno::INVAL);
+        PushErrno(c, t.SetSockOptImpl(fd, level, name, value));
+    });
+    s->On(22, [&t](Context& c) { // Shutdown(fd, how)
+        const s32 fd = c.Pop<s32>(), how = c.Pop<s32>();
+        PushErrno(c, t.ShutdownImpl(fd, how));
+    });
+    s->On(25, [](Context& c) { PushResult(c, 0, Errno::SUCCESS); }); // Read (as suyu: stub)
+    s->On(26, [&t](Context& c) { PushErrno(c, t.CloseImpl(c.Pop<s32>())); });
+    s->On(27, [&t](Context& c) { // DuplicateSocket(fd, reserved)
+        const auto r = t.DuplicateSocketImpl(c.Pop<s32>());
+        if (const auto* fd = std::get_if<s32>(&r)) PushResult(c, *fd, Errno::SUCCESS);
+        else PushResult(c, 0, std::get<Errno>(r));
+    });
+    s->On(31, [](Context& c) { PushErrno(c, Errno::SUCCESS); }); // EventFd (as suyu: stub)
+    return s;
+}
+
+} // namespace Kernel::NativeServices
