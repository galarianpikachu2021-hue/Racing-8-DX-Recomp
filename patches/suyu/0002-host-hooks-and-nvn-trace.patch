diff --git a/src/core/arm/recomp/sdk_trace.cpp b/src/core/arm/recomp/sdk_trace.cpp
new file mode 100644
index 0000000000..8603bf77ee
--- /dev/null
+++ b/src/core/arm/recomp/sdk_trace.cpp
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/sdk_trace.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "common/fs/path_util.h"
+#include "common/logging/log.h"
+#include "core/arm/recomp/host_hooks.h"
+
+namespace Core::SdkTrace {
+namespace {
+
+struct Entry {
+    std::string name;
+    std::atomic<u64> calls{0};
+    std::atomic<u64> from_main{0};
+    u64 reported_from_main = 0; ///< from_main at the previous report (report thread only)
+};
+
+std::vector<std::unique_ptr<Entry>> g_entries;
+std::mutex g_lock;
+std::atomic<u64> g_main_begin{0}, g_main_end{0};
+std::once_flag g_report_thread;
+
+template <typename T>
+bool ReadAt(std::span<const u8> image, u64 offset, T& out) {
+    if (offset + sizeof(T) > image.size()) return false;
+    std::memcpy(&out, image.data() + offset, sizeof(T));
+    return true;
+}
+
+} // namespace
+
+std::vector<std::pair<std::string, u64>> ExportedFunctions(std::span<const u8> image) {
+    std::vector<std::pair<std::string, u64>> out;
+    u32 mod0 = 0;
+    if (!ReadAt(image, 4, mod0) || mod0 + 8 > image.size() || std::memcmp(image.data() + mod0, "MOD0", 4) != 0) return out;
+    s32 dyn_rel = 0;
+    ReadAt(image, mod0 + 4, dyn_rel);
+    u64 dyn = mod0 + static_cast<s64>(dyn_rel);
+    u64 symtab = 0, strtab = 0, hash = 0, strsz = 0;
+    for (;; dyn += 16) {
+        s64 tag = 0;
+        u64 val = 0;
+        if (!ReadAt(image, dyn, tag) || !ReadAt(image, dyn + 8, val) || tag == 0) break;
+        if (tag == 4) hash = val;        // DT_HASH
+        else if (tag == 5) strtab = val; // DT_STRTAB
+        else if (tag == 6) symtab = val; // DT_SYMTAB
+        else if (tag == 10) strsz = val; // DT_STRSZ
+    }
+    if (!symtab || !strtab || !hash) return out;
+    u32 count = 0;
+    ReadAt(image, hash + 4, count); // nchain = number of symbols
+    for (u32 i = 0; i < count; ++i) {
+        const u64 sym = symtab + static_cast<u64>(i) * 24;
+        u32 name_off = 0;
+        u8 info = 0;
+        u16 shndx = 0;
+        u64 value = 0;
+        if (!ReadAt(image, sym, name_off) || !ReadAt(image, sym + 4, info) || !ReadAt(image, sym + 6, shndx) ||
+            !ReadAt(image, sym + 8, value))
+            break;
+        if (shndx == 0 || (info & 0xF) != 2 /* STT_FUNC */ || name_off >= strsz || value == 0) continue;
+        const char* s = reinterpret_cast<const char*>(image.data() + strtab + name_off);
+        out.emplace_back(std::string{s, strnlen(s, image.size() - (strtab + name_off))}, value);
+    }
+    return out;
+}
+
+namespace {
+
+void WriteReport() {
+    std::vector<Entry*> list;
+    {
+        std::scoped_lock lock{g_lock};
+        for (auto& e : g_entries) list.push_back(e.get());
+    }
+    std::sort(list.begin(), list.end(), [](const Entry* a, const Entry* b) { return a->from_main.load() > b->from_main.load(); });
+    const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "sdk_trace.txt";
+    std::ofstream out(path, std::ios::trunc);
+    out << "# from_main all from_main_last_10s name  (sdk exports called at least once)\n";
+    for (Entry* e : list) {
+        const u64 all = e->calls.load(), main = e->from_main.load();
+        if (all == 0) continue;
+        out << main << ' ' << all << ' ' << (main - e->reported_from_main) << ' ' << e->name << '\n';
+        e->reported_from_main = main;
+    }
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_SDK_TRACE");
+        return v && *v == '1';
+    }();
+    return on;
+}
+
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name) {
+    (void)system;
+    if (!Enabled()) return;
+    if (name == "main") {
+        g_main_begin = load_base;
+        g_main_end = load_base + image.size();
+        return;
+    }
+    if (name != "sdk") return;
+    const auto functions = ExportedFunctions(image);
+    for (const auto& [fn, offset] : functions) {
+        auto owned = std::make_unique<Entry>();
+        owned->name = fn;
+        Entry* entry = owned.get();
+        {
+            std::scoped_lock lock{g_lock};
+            g_entries.push_back(std::move(owned));
+        }
+        RecompHooks::Install(load_base + offset, [entry](RecompHooks::HookContext& ctx) {
+            entry->calls.fetch_add(1, std::memory_order_relaxed);
+            const u64 lr = ctx.x[30];
+            if (lr >= g_main_begin.load(std::memory_order_relaxed) && lr < g_main_end.load(std::memory_order_relaxed))
+                entry->from_main.fetch_add(1, std::memory_order_relaxed);
+            return false; // observe only
+        });
+    }
+    LOG_INFO(Core_ARM, "SDK trace: {} exported functions of sdk hooked; report in sdk_trace.txt every 10 s", functions.size());
+    std::call_once(g_report_thread, [] {
+        std::thread([] {
+            for (;;) {
+                std::this_thread::sleep_for(std::chrono::seconds(10));
+                WriteReport();
+            }
+        }).detach();
+    });
+}
+
+} // namespace Core::SdkTrace
