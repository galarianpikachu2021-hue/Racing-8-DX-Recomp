+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: user accounts ("acc:u0", "acc:u1") and add-on content ("aoc:u") (docs/NATIVE_ENGINE.md, "native services").
+// The users are the engine's profiles (their ids name the save data, so they must stay the same); add-on content is the list of
+// DLC the engine found among the player's files.
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "../native_kernel.h"
+
+namespace KartRuntime::Services {
+
+struct UserProfile {
+    std::array<uint8_t, 16> uuid{};
+    std::string name;
+    uint64_t timestamp = 0;
+};
+
+struct AccountConfig {
+    std::vector<UserProfile> users; ///< every user; the first one is the one playing ("open")
+    uint64_t account_id = 0;        ///< what GetAccountId reports for the playing user
+};
+
+struct AddOnConfig {
+    uint64_t base_id = 0;              ///< GetAddOnContentBaseId
+    std::vector<uint32_t> contents;    ///< add-on content indices the game may mount
+};
+
+inline std::shared_ptr<Service> MakeAccount(const char* name, const AccountConfig& cfg) {
+    struct ProfileBase {
+        std::array<uint8_t, 16> uuid;
+        uint64_t timestamp;
+        std::array<char, 0x20> name;
+    };
+    static_assert(sizeof(ProfileBase) == 0x38);
+    auto base_of = [](const UserProfile& u) {
+        ProfileBase b{};
+        b.uuid = u.uuid;
+        b.timestamp = u.timestamp;
+        std::memcpy(b.name.data(), u.name.data(), std::min(u.name.size(), b.name.size()));
+        return b;
+    };
+    auto find = [cfg](const std::array<uint8_t, 16>& id) -> const UserProfile* {
+        for (const auto& u : cfg.users)
+            if (u.uuid == id) return &u;
+        return nullptr;
+    };
+    auto list = [](Context& c, const std::vector<UserProfile>& users) {
+        std::array<std::array<uint8_t, 16>, 8> ids{}; // 8 slots, unused ones zero
+        for (size_t i = 0; i < users.size() && i < ids.size(); ++i) ids[i] = users[i].uuid;
+        c.WriteBuffer(ids.data(), sizeof(ids), 0);
+    };
+    std::vector<UserProfile> open;
+    if (!cfg.users.empty()) open.push_back(cfg.users.front());
+    const std::array<uint8_t, 16> last = open.empty() ? std::array<uint8_t, 16>{} : open.front().uuid;
+    const uint64_t hash = cfg.account_id;
+
+    auto s = std::make_shared<Service>(name);
+    s->On(0, [cfg](Context& c) { c.Push<uint32_t>(static_cast<uint32_t>(cfg.users.size())); }); // GetUserCount
+    s->On(1, [find](Context& c) { c.Push<uint8_t>(find(c.Pop<std::array<uint8_t, 16>>()) != nullptr); }); // GetUserExistence
+    s->On(2, [cfg, list](Context& c) { list(c, cfg.users); });                                     // ListAllUsers
+    s->On(3, [open, list](Context& c) { list(c, open); });                                          // ListOpenUsers
+    s->On(4, [last](Context& c) { c.Push(last); });                                                 // GetLastOpenedUser
+    s->On(5, [find, base_of](Context& c) { // GetProfile(uuid)
+        const UserProfile* u = find(c.Pop<std::array<uint8_t, 16>>());
+        const UserProfile user = u ? *u : UserProfile{};
+        auto p = std::make_shared<Service>("IProfile");
+        p->On(0, [user, base_of](Context& pc) { // Get: base + user data
+            std::array<uint8_t, 0x80> data{};
+            pc.WriteBuffer(data.data(), data.size(), 0);
+            pc.Push(base_of(user));
+        });
+        p->On(1, [user, base_of](Context& pc) { pc.Push(base_of(user)); }); // GetBase
+        p->On(10, [](Context& pc) { pc.Push<uint32_t>(0); });               // GetImageSize: no picture
+        p->On(11, [](Context& pc) { pc.Push<uint32_t>(0); });               // LoadImage
+        c.PushInterface(p);
+    });
+    s->On(50, [](Context& c) { c.Push<uint8_t>(0); }); // IsUserRegistrationRequestPermitted
+    s->On(51, [last](Context& c) { c.Push(last); });   // TrySelectUserWithoutInteraction
+    s->Ok(100);                                        // InitializeApplicationInfo
+    s->On(101, [hash](Context& c) { // GetBaasAccountManagerForApplication(uuid)
+        auto m = std::make_shared<Service>("IManagerForApplication");
+        m->Ok(0);                                                // CheckAvailability
+        m->On(1, [hash](Context& mc) { mc.Push<uint64_t>(hash); }); // GetAccountId
+        auto cache = [hash](Context& mc) { // GetNintendoAccountUserResourceCacheForApplication: an empty record
+            std::vector<uint8_t> base(0x68);
+            mc.WriteBuffer(base.data(), base.size(), 0);
+            if (mc.WriteBufferSize(1)) {
+                std::vector<uint8_t> extra(mc.WriteBufferSize(1));
+                mc.WriteBuffer(extra.data(), extra.size(), 1);
+            }
+            mc.Push<uint64_t>(hash);
+        };
+        m->On(130, cache);
+        m->On(136, cache);
+        m->Ok(160); // StoreOpenContext
+        c.PushInterface(m);
+    });
+    s->Ok(110); // StoreSaveDataThumbnail
+    s->Ok(111); // ClearSaveDataThumbnail
+    s->Ok(140); // InitializeApplicationInfoRestricted
+    s->Ok(150); // IsUserAccountSwitchLocked... (result only)
+    return s;
+}
+
+inline std::shared_ptr<Service> MakeAddOnContent(NativeKernel& kernel, const AddOnConfig& cfg) {
+    auto changed = std::make_shared<Event>(kernel, "aoc list changed");
+    auto s = std::make_shared<Service>("aoc:u");
+    s->On(2, [cfg](Context& c) { c.Push<uint32_t>(static_cast<uint32_t>(cfg.contents.size())); }); // CountAddOnContent
+    s->On(3, [cfg](Context& c) { // ListAddOnContent(offset, count)
+        const auto offset = c.Pop<uint32_t>();
+        const auto count = c.Pop<uint32_t>();
+        if (offset > cfg.contents.size()) return c.SetResult(0x1F4E3); // aoc: invalid argument
+        const size_t n = std::min<size_t>({cfg.contents.size() - offset, count, c.WriteBufferSize(0) / 4});
+        c.WriteBuffer(cfg.contents.data() + offset, n * 4, 0);
+        c.Push<uint32_t>(static_cast<uint32_t>(n));
+    });
+    s->On(5, [cfg](Context& c) { c.Push<uint64_t>(cfg.base_id); }); // GetAddOnContentBaseId
+    s->Ok(7);                                                       // PrepareAddOnContent
+    s->On(8, [changed](Context& c) { c.PushCopyObject(changed); }); // GetAddOnContentListChangedEvent
+    s->On(10, [changed](Context& c) { c.PushCopyObject(changed); }); // ...WithProcessId
+    s->Ok(11);                                                      // NotifyMountAddOnContent
+    s->Ok(12);                                                      // NotifyUnmountAddOnContent
+    s->Ok(50);                                                      // CheckAddOnContentMountStatus
+    return s;
+}
