+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: NVN API tracer, the first step toward native graphics.
+//
+// The game reaches its graphics driver only through nvnBootstrapLoader and the
+// procedure addresses it hands out (nvnDeviceGetProcAddress). Hooking those two
+// gives the name of every NVN entry point the game resolves, and a counting hook
+// on each resolved address shows which ones it actually calls and how often.
+// That list is the exact API surface a native Vulkan/Metal/GLES backend must
+// implement.
+//
+// Enabled with KARTRECOMP_NVN_TRACE=1. Writes <log dir>/nvn_trace.txt.
+#pragma once
+
+#include <span>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::NvnTrace {
+
+bool Enabled();
+
+/// Called by the NSO loader with each module's image before it is mapped.
+/// Finds a defined nvnBootstrapLoader in the module's dynamic symbols.
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base,
+                     std::string_view name);
+
+/// Writes the report now (also done periodically while tracing).
+void WriteReport();
+
+} // namespace Core::NvnTrace
