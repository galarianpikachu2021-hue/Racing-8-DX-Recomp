+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: reverse-engineering aid. KARTRECOMP_HOOK_TRACE="1acb0,4910c8" logs every entry of those blocks of the `main` module
+// (offsets from its load base) with x0..x7, the caller and any readable text the arguments point at. Blocks only reach the host
+// dispatcher when the recompiled code returns to it between blocks: run with SUYU_RECOMP_CHAIN_BUDGET=1 (slow, analysis only).
+// Output: <log dir>/hook_trace.txt.
+#pragma once
+
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::KartHookTrace {
+
+/// KARTRECOMP_BLOCK_COVERAGE=1: every block of `main` is logged the first time it runs, with a millisecond timestamp, the caller and
+/// x0..x3, to <log dir>/block_first_hits.txt (run with SUYU_RECOMP_CHAIN_BUDGET=1). Comparing the time line with a scripted run shows
+/// which code a menu action ran for the first time.
+bool CoverageEnabled();
+void CoverageHit(u64 pc, u64 lr, const u64* x);
+
+/// Native block hooks (generated code built with tools/recomp/add_block_hooks.py): the module's hook map byte for `pc` is switched on.
+u64 MainBase();
+void NoteHookAddress(u64 pc);
+
+/// KARTRECOMP_STRING_WATCH=<prefix>: every time the dispatcher is entered, x0..x3 are checked for a pointer to text starting with the prefix;
+/// the first hits are logged to <log dir>/string_watch.txt with the entry pc, the caller and the text (finds who passes a given kind of name).
+bool StringWatchEnabled();
+void StringWatch(Core::System& system, u64 pc, const u64* x);
+
+/// Called for each module as it is loaded, before NoteModule: the NSO build ID, so hooks go only into the game build they were found in.
+void NoteBuildId(std::string_view name, const u8* build_id);
+
+/// Called for each module as it is loaded.
+void NoteModule(Core::System& system, std::string_view name, u64 load_base);
+
+} // namespace Core::KartHookTrace
diff --git a/src/core/arm/recomp/native_hid.cpp b/src/core/arm/recomp/native_hid.cpp
new file mode 100644
index 0000000000..68e8b5a69b
--- /dev/null
+++ b/src/core/arm/recomp/native_hid.cpp
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/native_hid.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "common/kart_overlay.h"
+#include "common/logging/log.h"
+#include "common/settings.h"
+#include "core/arm/recomp/host_hooks.h"
+#include "core/arm/recomp/sdk_trace.h"
+#include "core/core.h"
+#include "core/memory.h"
+#include "hid_core/frontend/emulated_controller.h"
+#include "hid_core/hid_core.h"
+#include "hid_core/hid_types.h"
+
+namespace Core::NativeHid {
+namespace {
+
+using Core::HID::NpadButton;
+using Core::HID::NpadStyleIndex;
+
+/// nn::hid::NpadFullKeyState and its siblings (NpadHandheldState, NpadJoyDualState, ...): the hid service's NPadGenericState.
+struct NpadState {
+    s64 sampling_number;
+    u64 buttons;
+    s32 l_x, l_y, r_x, r_y;
+    u32 attributes; ///< bit 0 connected, bit 1 wired, bit 2 left Joy-Con connected, bit 3 left wired, bit 4/5 right
+    u32 reserved;
+};
+static_assert(sizeof(NpadState) == 0x28);
+
+/// nn::hid::NpadStyleTag bit for a controller type (hid_types.h NpadStyleTag).
+u32 StyleBit(NpadStyleIndex type) {
+    switch (type) {
+    case NpadStyleIndex::Fullkey: return 1u << 0;
+    case NpadStyleIndex::Handheld: return 1u << 1;
+    case NpadStyleIndex::JoyconDual: return 1u << 2;
+    case NpadStyleIndex::JoyconLeft: return 1u << 3;
+    case NpadStyleIndex::JoyconRight: return 1u << 4;
+    case NpadStyleIndex::GameCube: return 1u << 5;
+    default: return 0;
+    }
+}
+
+/// The controller object behind an npad id (Player1..8 = 0..7, Handheld = 0x20, Other = 0x10), or null.
+Core::HID::EmulatedController* Controller(Core::System& system, u32 id) {
+    if (id > 7 && id != 0x10 && id != 0x20) return nullptr;
+    return system.HIDCore().GetEmulatedController(static_cast<Core::HID::NpadIdType>(id));
+}
+
+/// The state the hid service would publish for this controller (npad.cpp RequestPadStateUpdate + OnUpdate), for a read of
+/// `wanted` (the style of the GetNpadState overload): zeroed with no attributes when the controller has another style.
+NpadState Read(Core::HID::EmulatedController* c, NpadStyleIndex wanted) {
+    NpadState s{};
+    // The service's sampling counter advances every update (about every 4 ms); a time-based count behaves the same for the game.
+    static const auto start = std::chrono::steady_clock::now();
+    s.sampling_number = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count() / 4000;
+    if (!c || !c->IsConnected()) return s;
+    const NpadStyleIndex type = c->GetNpadStyleIndex();
+    if (type != wanted) return s;
+    const auto buttons = c->GetNpadButtons();
+    const auto sticks = c->GetSticks();
+    constexpr u64 right_mask = static_cast<u64>(NpadButton::A | NpadButton::B | NpadButton::X | NpadButton::Y | NpadButton::StickR |
+                                                NpadButton::R | NpadButton::ZR | NpadButton::Plus | NpadButton::StickRLeft |
+                                                NpadButton::StickRUp | NpadButton::StickRRight | NpadButton::StickRDown);
+    constexpr u64 left_mask = static_cast<u64>(NpadButton::Left | NpadButton::Up | NpadButton::Right | NpadButton::Down |
+                                               NpadButton::StickL | NpadButton::L | NpadButton::ZL | NpadButton::Minus |
+                                               NpadButton::StickLLeft | NpadButton::StickLUp | NpadButton::StickLRight |
+                                               NpadButton::StickLDown);
+    const u64 raw = static_cast<u64>(buttons.raw);
+    if (type != NpadStyleIndex::JoyconLeft) {
+        s.buttons |= raw & right_mask;
+        s.r_x = sticks.right.x;
+        s.r_y = sticks.right.y;
+    }
+    if (type != NpadStyleIndex::JoyconRight) {
+        s.buttons |= raw & left_mask;
+        s.l_x = sticks.left.x;
+        s.l_y = sticks.left.y;
+    }
+    if (type == NpadStyleIndex::JoyconLeft || type == NpadStyleIndex::JoyconDual) {
+        s.buttons |= raw & static_cast<u64>(NpadButton::LeftSL | NpadButton::LeftSR);
+    }
+    if (type == NpadStyleIndex::JoyconRight || type == NpadStyleIndex::JoyconDual) {
+        s.buttons |= raw & static_cast<u64>(NpadButton::RightSL | NpadButton::RightSR);
+    }
+    // Connection attributes as the service sets them per style (npad.cpp OnUpdate).
+    switch (type) {
+    case NpadStyleIndex::Fullkey: s.attributes = 0b11; break;           // connected, wired
+    case NpadStyleIndex::Handheld: s.attributes = 0b11'1111; break;     // connected, wired, both Joy-Cons connected and wired
+    case NpadStyleIndex::JoyconDual: s.attributes = 0b01'0101; break;   // connected, left and right connected
+    case NpadStyleIndex::JoyconLeft: s.attributes = 0b00'0101; break;   // connected, left connected
+    case NpadStyleIndex::JoyconRight: s.attributes = 0b01'0001; break;  // connected, right connected
+    default: s.attributes = 0b1; break;
+    }
+    return s;
+}
+
+/// nn::hid::SixAxisSensorState (hid_types.h): 0x60 bytes.
+struct SixAxisState {
+    s64 delta_time;
+    s64 sampling_number;
+    float accel[3], gyro[3], rotation[3], orientation[3][3];
+    u32 attribute; ///< bit 0 connected
+    u32 reserved;
+};
+static_assert(sizeof(SixAxisState) == 0x60);
+
+/// Motion sensors the game has started (nn::hid::StartSixAxisSensor), by handle: the service reports "at rest" for the others.
+std::atomic<u32> g_started_handles[16];
+
+bool SensorStarted(u32 handle) {
+    for (const auto& h : g_started_handles)
+        if (h.load(std::memory_order_relaxed) == handle) return true;
+    return false;
+}
+
+/// The state the hid service would publish for a six-axis handle (six_axis.cpp OnUpdate).
+SixAxisState ReadMotion(Core::System& system, u32 handle) {
+    SixAxisState s{};
+    s.delta_time = 5'000'000; // 5 ms, as the service reports
+    static const auto start = std::chrono::steady_clock::now();
+    s.sampling_number = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count() / 5;
+    s.accel[2] = -1.0f; // at rest, lying flat
+    s.orientation[0][0] = s.orientation[1][1] = s.orientation[2][2] = 1.0f;
+    s.attribute = 1;
+    const u32 npad_id = (handle >> 8) & 0xFF, device = (handle >> 16) & 0xFF; // {style index, npad id, device index, pad}
+    auto* c = Controller(system, npad_id);
+    if (!c || !c->IsConnected() || !SensorStarted(handle) || !Settings::values.motion_enabled.GetValue()) return s;
+    const auto motions = c->GetMotions();
+    const auto& m = motions[device == 1 && c->GetNpadStyleIndex() != NpadStyleIndex::Fullkey ? 1 : 0];
+    for (int i = 0; i < 3; ++i) {
+        s.accel[i] = m.accel[i];
+        s.gyro[i] = m.gyro[i];
+        s.rotation[i] = m.rotation[i];
+        for (int j = 0; j < 3; ++j) s.orientation[i][j] = m.orientation[i][j];
+    }
+    return s;
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_HID");
+        return v && *v == '1';
+    }();
+    return on;
+}
+
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name) {
+    if (!Enabled() || name != "sdk") return;
+    std::map<std::string, u64> exports;
+    for (const auto& [fn, offset] : SdkTrace::ExportedFunctions(image)) exports.emplace(fn, load_base + offset);
+    Core::System* sys = &system;
+    int installed = 0;
+
+    if (const auto it = exports.find("_ZN2nn3hid15GetNpadStyleSetERKj"); it != exports.end()) {
+        RecompHooks::Install(it->second, [sys](RecompHooks::HookContext& ctx) {
+            auto& mem = sys->ApplicationMemory();
+            const u32 id = mem.Read32(ctx.x[0]);
+            const auto* c = Controller(*sys, id);
+            ctx.x[0] = c && c->IsConnected() ? StyleBit(c->GetNpadStyleIndex()) : 0;
+            ctx.pc = ctx.x[30];
+            return true;
+        });
+        ++installed;
+    }
+    const std::pair<const char*, NpadStyleIndex> reads[] = {
+        {"_ZN2nn3hid12GetNpadStateEPNS0_16NpadFullKeyStateERKj", NpadStyleIndex::Fullkey},
+        {"_ZN2nn3hid12GetNpadStateEPNS0_17NpadHandheldStateERKj", NpadStyleIndex::Handheld},
+        {"_ZN2nn3hid12GetNpadStateEPNS0_16NpadJoyDualStateERKj", NpadStyleIndex::JoyconDual},
+        {"_ZN2nn3hid12GetNpadStateEPNS0_16NpadJoyLeftStateERKj", NpadStyleIndex::JoyconLeft},
+        {"_ZN2nn3hid12GetNpadStateEPNS0_17NpadJoyRightStateERKj", NpadStyleIndex::JoyconRight},
+    };
+    for (const auto& [symbol, style] : reads) {
+        const auto it = exports.find(symbol);
+        if (it == exports.end()) continue;
+        RecompHooks::Install(it->second, [sys, style](RecompHooks::HookContext& ctx) {
+            auto& mem = sys->ApplicationMemory();
+            const u64 out = ctx.x[0];
+            const u32 id = mem.Read32(ctx.x[1]);
+            const NpadState s = Read(Controller(*sys, id), style);
+            KartOverlay::DiagPadReads().fetch_add(1, std::memory_order_relaxed);
+            mem.WriteBlock(out, &s, sizeof(s));
+            ctx.pc = ctx.x[30];
+            return true;
+        });
+        ++installed;
+    }
+    // Motion: the start/stop calls still go to the service too (observed only); the reads are answered here.
+    if (const auto it = exports.find("_ZN2nn3hid18StartSixAxisSensorERKNS0_19SixAxisSensorHandleE"); it != exports.end()) {
+        RecompHooks::Install(it->second, [sys](RecompHooks::HookContext& ctx) {
+            const u32 handle = sys->ApplicationMemory().Read32(ctx.x[0]);
+            if (SensorStarted(handle)) return false;
+            for (auto& h : g_started_handles) {
+                u32 empty = 0;
+                if (h.compare_exchange_strong(empty, handle)) break;
+            }
+            return false;
+        });
+        ++installed;
+    }
+    if (const auto it = exports.find("_ZN2nn3hid17StopSixAxisSensorERKNS0_19SixAxisSensorHandleE"); it != exports.end()) {
+        RecompHooks::Install(it->second, [sys](RecompHooks::HookContext& ctx) {
+            const u32 handle = sys->ApplicationMemory().Read32(ctx.x[0]);
+            for (auto& h : g_started_handles) {
+                u32 mine = handle;
+                h.compare_exchange_strong(mine, 0);
+            }
+            return false;
+        });
+        ++installed;
+    }
+    if (const auto it = exports.find("_ZN2nn3hid22GetSixAxisSensorStatesEPNS0_18SixAxisSensorStateEiRKNS0_19SixAxisSensorHandleE");
+        it != exports.end()) {
+        RecompHooks::Install(it->second, [sys](RecompHooks::HookContext& ctx) {
+            auto& mem = sys->ApplicationMemory();
+            const s32 count = static_cast<s32>(ctx.x[1]);
+            if (count < 1) {
+                ctx.x[0] = 0;
+            } else {
+                const SixAxisState st = ReadMotion(*sys, mem.Read32(ctx.x[2]));
+                mem.WriteBlock(ctx.x[0], &st, sizeof(st));
+                ctx.x[0] = 1; // newest state only
+            }
+            ctx.pc = ctx.x[30];
+            return true;
+        });
+        ++installed;
+    }
+    // Touch screen: the PC game has none (nothing feeds the emulated one either): one state with no touches.
+    for (int n = 1; n <= 16; ++n) {
+        const std::string symbol = "_ZN2nn3hid20GetTouchScreenStatesILm" + std::to_string(n) + "EEEiPNS0_16TouchScreenStateIXT_EEEi";
+        const auto it = exports.find(symbol);
+        if (it == exports.end()) continue;
+        const u64 size = 0x10 + static_cast<u64>(n) * 0x28;
+        RecompHooks::Install(it->second, [sys, size](RecompHooks::HookContext& ctx) {
+            auto& mem = sys->ApplicationMemory();
+            if (static_cast<s32>(ctx.x[1]) < 1) {
+                ctx.x[0] = 0;
+            } else {
+                std::vector<u8> zero(size, 0);
+                static const auto start = std::chrono::steady_clock::now();
+                const s64 sampling =
+                    std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count() / 4;
+                std::memcpy(zero.data(), &sampling, sizeof(sampling));
+                mem.WriteBlock(ctx.x[0], zero.data(), size);
+                ctx.x[0] = 1;
+            }
+            ctx.pc = ctx.x[30];
+            return true;
+        });
+        ++installed;
+    }
+    LOG_INFO(Core_ARM, "native hid: {} nn::hid functions answered from the controller objects (KARTRECOMP_NATIVE_HID=1)", installed);
+}
+
+} // namespace Core::NativeHid
diff --git a/src/core/arm/recomp/native_hid.h b/src/core/arm/recomp/native_hid.h
new file mode 100644
index 0000000000..bf85c754dc
--- /dev/null
+++ b/src/core/arm/recomp/native_hid.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: native controller input for the game (native-engine plan, phase 2; docs/NATIVE_ENGINE.md).
+//
+// The game reads its controllers through nn::hid::GetNpadStyleSet and nn::hid::GetNpadState (once or twice a frame per player). On
+// the console those read the hid service's shared memory, which the emulated hid service fills from our controller objects
+// (hid_core EmulatedController: SDL pads, keyboard, controller profiles, TAS, the overlay's input block). With
+// KARTRECOMP_NATIVE_HID=1 the two calls are answered from those controller objects directly, with the same state layout and button
+// masks as the hid service, so the game no longer reads input through the emulated service.
+#pragma once
+
+#include <span>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::NativeHid {
+
+bool Enabled();
+
+/// Called by the NSO loader with each module's image before it is mapped; hooks the nn::hid read functions of "sdk".
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name);
+
+} // namespace Core::NativeHid
diff --git a/src/core/arm/recomp/native_libc.cpp b/src/core/arm/recomp/native_libc.cpp
new file mode 100644
index 0000000000..83d2c202ce
--- /dev/null
+++ b/src/core/arm/recomp/native_libc.cpp
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/native_libc.h"
+#if defined(__linux__)
+#include <sys/mman.h>
+#endif
+#include <atomic>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "common/logging/log.h"
+#include "core/arm/recomp/host_hooks.h"
+#include "core/arm/recomp/sdk_trace.h"
+#include "core/core.h"
+#include "core/memory.h"
+
+namespace Core::NativeLibc {
+namespace {
+
+constexpr u64 kPage = 0x1000;
+
+/// Guest memory as host spans, page by page. Every function here first checks that the whole range is mapped (else the guest code
+/// runs, which faults the way the game expects), then works on host pointers.
+struct Guest {
+    Core::Memory::Memory& mem;
+
+    /// Host pointer for [va, va+len) when it stays inside one page; null when unmapped.
+    u8* Page(u64 va) { return mem.GetPointerSilent(va); }
+
+    bool Mapped(u64 va, u64 len) {
+        if (len == 0) return true;
+        for (u64 p = va & ~(kPage - 1); p < va + len; p += kPage)
+            if (!Page(p)) return false;
+        return true;
+    }
+
+    /// Calls fn(host pointer, guest address, length) for each page-sized piece of [va, va+len).
+    template <typename F>
+    void Pieces(u64 va, u64 len, F&& fn) {
+        while (len) {
+            const u64 n = std::min<u64>(len, kPage - (va & (kPage - 1)));
+            fn(Page(va), va, n);
+            va += n;
+            len -= n;
+        }
+    }
+};
+
+bool Return(RecompHooks::HookContext& ctx, u64 value) {
+    ctx.x[0] = value;
+    ctx.pc = ctx.x[30];
+    return true;
+}
+
+// memcpy/memmove: copy through a host buffer when the ranges overlap or are large and fragmented; one page piece at a time
+// otherwise. Pieces of the source and destination may sit at different host addresses, so the copy walks both.
+void Copy(Guest& g, u64 dst, u64 src, u64 n) {
+    const bool overlap = src < dst + n && dst < src + n;
+    if (overlap || n > 4 * kPage) {
+        std::vector<u8> tmp(n);
+        u64 off = 0;
+        g.Pieces(src, n, [&](u8* p, u64, u64 len) { std::memcpy(tmp.data() + off, p, len); off += len; });
+        off = 0;
+        g.Pieces(dst, n, [&](u8* p, u64, u64 len) { std::memcpy(p, tmp.data() + off, len); off += len; });
+        return;
+    }
+    while (n) {
+        const u64 len = std::min({n, kPage - (src & (kPage - 1)), kPage - (dst & (kPage - 1))});
+        std::memcpy(g.Page(dst), g.Page(src), len);
+        dst += len;
+        src += len;
+        n -= len;
+    }
+}
+
+/// Length of the guest C string at va, or -1 when it runs into an unmapped page or past `limit` bytes.
+s64 StrLen(Guest& g, u64 va, u64 limit = u64{1} << 20) {
+    u64 n = 0;
+    while (n < limit) {
+        const u8* p = g.Page(va + n);
+        if (!p) return -1;
+        const u64 room = kPage - ((va + n) & (kPage - 1));
+        const void* z = std::memchr(p, 0, room);
+        if (z) return static_cast<s64>(n + (static_cast<const u8*>(z) - p));
+        n += room;
+    }
+    return -1;
+}
+
+int ByteDiff(u8 a, u8 b) { return static_cast<int>(a) - static_cast<int>(b); }
+
+} // namespace
+
+bool Enabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_LIBC");
+        return v && *v == '1';
+    }();
+    return on;
+}
+
+/// Zero punch (on; KARTRECOMP_ZERO_PUNCH=0 turns it off): a memset of a large range to zero gives the whole pages inside it back
+/// to the system instead of writing zeros into them (the game's memory file reads as zeros where it has no pages). The game
+/// clears hundreds of megabytes of heap it then leaves untouched: in a race 865 MB of its 1696 MB were all-zero pages, and the
+/// engine's memory use went from 3.5 GB to 2.5 GB with this, at no measurable CPU cost.
+static bool ZeroPunch() {
+    static const bool on = [] {
+#if defined(__linux__)
+        const char* v = std::getenv("KARTRECOMP_ZERO_PUNCH");
+        return !(v && *v == '0');
+#else
+        return false;
+#endif
+    }();
+    return on;
+}
+
+#if defined(__linux__)
+/// Zero-fills [dst, dst+n): whole pages are released (MADV_REMOVE on the shared memory file), the edges are written.
+static void ZeroFill(Guest& g, u64 dst, u64 n) {
+    static std::atomic<u64> released{0}, reported{0};
+    u8* run = nullptr;
+    u64 run_len = 0;
+    const auto flush = [&] {
+        if (run_len && madvise(run, run_len, MADV_REMOVE) != 0) std::memset(run, 0, run_len);
+        else released.fetch_add(run_len, std::memory_order_relaxed);
+        run = nullptr;
+        run_len = 0;
+    };
+    g.Pieces(dst, n, [&](u8* p, u64, u64 len) {
+        if (len != kPage) { // a partial page at either end
+            flush();
+            std::memset(p, 0, len);
+            return;
+        }
+        if (run && run + run_len == p) run_len += kPage;
+        else {
+            flush();
+            run = p;
+            run_len = kPage;
+        }
+    });
+    flush();
+    const u64 total = released.load(std::memory_order_relaxed);
+    if (total - reported.load(std::memory_order_relaxed) >= (256ull << 20)) {
+        reported.store(total, std::memory_order_relaxed);
+        LOG_INFO(Core_ARM, "zero punch: {} MB of zero-filled game memory released so far", total >> 20);
+    }
+}
+#endif
+
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name) {
+    if ((!Enabled() && !ZeroPunch()) || name != "sdk") return;
+    std::map<std::string, u64> exports;
+    for (const auto& [fn, offset] : SdkTrace::ExportedFunctions(image)) exports.emplace(fn, load_base + offset);
+    int installed = 0;
+    const auto hook = [&](const char* fn, RecompHooks::HookFn handler) {
+        const auto it = exports.find(fn);
+        if (it == exports.end()) return;
+        RecompHooks::Install(it->second, std::move(handler));
+        ++installed;
+    };
+    Core::System* sys = &system;
+#if defined(__linux__)
+    if (ZeroPunch() && !Enabled()) {
+        // Only large zero fills are taken over; every other memset runs the game's own code.
+        hook("memset", [sys](RecompHooks::HookContext& ctx) {
+            const u64 dst = ctx.x[0], n = ctx.x[2];
+            if ((ctx.x[1] & 0xFF) != 0 || n < (256u << 10)) return false;
+            Guest g{sys->ApplicationMemory()};
+            if (!g.Mapped(dst, n)) return false;
+            ZeroFill(g, dst, n);
+            return Return(ctx, dst);
+        });
+        LOG_INFO(Core_ARM, "zero punch: large zero fills release their pages ({} hook)", installed);
+        return;
+    }
+#endif
+
+    const auto memcpy_hook = [sys](RecompHooks::HookContext& ctx) {
+        Guest g{sys->ApplicationMemory()};
+        const u64 dst = ctx.x[0], src = ctx.x[1], n = ctx.x[2];
+        if (!g.Mapped(dst, n) || !g.Mapped(src, n)) return false;
+        Copy(g, dst, src, n);
+        return Return(ctx, dst);
+    };
+    for (const char* fn : {"memcpy", "__memcpy_device", "memmove", "__memmove_device"}) hook(fn, memcpy_hook);
+
+    hook("memset", [sys](RecompHooks::HookContext& ctx) {
+        Guest g{sys->ApplicationMemory()};
+        const u64 dst = ctx.x[0], n = ctx.x[2];
+        if (!g.Mapped(dst, n)) return false;
+        const int c = static_cast<int>(ctx.x[1] & 0xFF);
+        g.Pieces(dst, n, [c](u8* p, u64, u64 len) { std::memset(p, c, len); });
+        return Return(ctx, dst);
+    });
+
+    hook("memcmp", [sys](RecompHooks::HookContext& ctx) {
+        Guest g{sys->ApplicationMemory()};
+        u64 a = ctx.x[0], b = ctx.x[1], n = ctx.x[2];
+        if (!g.Mapped(a, n) || !g.Mapped(b, n)) return false;
+        while (n) {
+            const u64 len = std::min({n, kPage - (a & (kPage - 1)), kPage - (b & (kPage - 1))});
+            const u8* pa = g.Page(a);
+            const u8* pb = g.Page(b);
+            for (u64 i = 0; i < len; ++i)
+                if (pa[i] != pb[i]) return Return(ctx, static_cast<u64>(static_cast<s64>(ByteDiff(pa[i], pb[i]))));
+            a += len;
+            b += len;
+            n -= len;
+        }
+        return Return(ctx, 0);
+    });
+
+    hook("strlen", [sys](RecompHooks::HookContext& ctx) {
+        Guest g{sys->ApplicationMemory()};
+        const s64 n = StrLen(g, ctx.x[0]);
+        if (n < 0) return false;
+        return Return(ctx, static_cast<u64>(n));
+    });
+
+    hook("strcmp", [sys](RecompHooks::HookContext& ctx) {
+        Guest g{sys->ApplicationMemory()};
+        u64 a = ctx.x[0], b = ctx.x[1];
+        for (u64 done = 0; done < (u64{1} << 20);) {
+            const u8* pa = g.Page(a);
+            const u8* pb = g.Page(b);
+            if (!pa || !pb) return false;
+            const u64 len = std::min(kPage - (a & (kPage - 1)), kPage - (b & (kPage - 1))); // bytes left in both pages
+            for (u64 i = 0; i < len; ++i)
+                if (pa[i] != pb[i] || pa[i] == 0) return Return(ctx, static_cast<u64>(static_cast<s64>(ByteDiff(pa[i], pb[i]))));
+            a += len;
+            b += len;
+            done += len;
+        }
+        return false;
+    });
+
+    LOG_INFO(Core_ARM, "native libc: {} C library functions of sdk answered by host code (KARTRECOMP_NATIVE_LIBC=1)", installed);
+}
+
+} // namespace Core::NativeLibc
diff --git a/src/core/arm/recomp/native_libc.h b/src/core/arm/recomp/native_libc.h
new file mode 100644
index 0000000000..b5cd0c5fe2
--- /dev/null
+++ b/src/core/arm/recomp/native_libc.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: native C library for the game (native-engine plan, phase 1; docs/NATIVE_ENGINE.md).
+//
+// The sdk module carries the C library the game uses (memcpy, memset, strcmp, ...). The game calls these about 300,000 times a second
+// in a race, each time through the host dispatcher into recompiled ARM code that goes through the guest memory helpers. With
+// KARTRECOMP_NATIVE_LIBC=1 those calls from the game are answered by host code working directly on guest memory instead. A call
+// touching an unmapped page falls back to the game's own code, so the behaviour on bad pointers is unchanged.
+#pragma once
+
+#include <span>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::NativeLibc {
+
+bool Enabled();
+
+/// Called by the NSO loader with each module's image before it is mapped; hooks the C library functions of "sdk".
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base, std::string_view name);
+
+} // namespace Core::NativeLibc
diff --git a/src/core/arm/recomp/nvn_trace.cpp b/src/core/arm/recomp/nvn_trace.cpp
new file mode 100644
index 0000000000..dd70859f8d
--- /dev/null
+++ b/src/core/arm/recomp/nvn_trace.cpp
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/nvn_trace.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/fs/path_util.h"
+#include "common/logging/log.h"
+#include "core/arm/recomp/host_hooks.h"
+#include "core/nvn_host/nvn_host.h"
+#include "core/core.h"
+#include "core/memory.h"
+
+namespace Core::NvnTrace {
+namespace {
+
+struct Entry {
+    std::string name;
+    u64 address = 0;
+    std::atomic<u64> calls{0};
+    bool is_present = false;
+    bool is_draw = false;
+};
+
+// ---- Frame-level capture -------------------------------------------------
+// Every frame: one CSV row (calls, draws). Every `capture_every` frames: a full
+// argument dump of `capture_frames` frames. Configured by
+// KARTRECOMP_NVN_CAPTURE="every=3600,frames=2" (defaults shown; every=0 disables dumps).
+struct CallRecord {
+    u64 frame;
+    u64 thread;
+    const Entry* entry;
+    u64 x[8];
+    u64 v[4];
+};
+
+struct Capture {
+    u64 every = 3600;
+    u64 frames = 2;
+    std::mutex lock;
+    std::atomic<u64> frame{0};
+    std::atomic<u64> frame_calls{0};
+    std::atomic<u64> frame_draws{0};
+    std::atomic<bool> recording{false};
+    u64 recording_until = 0;
+    std::vector<CallRecord> records;
+    std::ofstream csv;
+};
+
+Capture& GetCapture() {
+    static Capture capture;
+    static const bool configured = [] {
+        Capture& c = capture;
+        if (const char* cfg = std::getenv("KARTRECOMP_NVN_CAPTURE")) {
+            std::string_view v{cfg};
+            for (size_t pos = 0; pos < v.size();) {
+                const size_t end = std::min(v.find(',', pos), v.size());
+                const auto item = v.substr(pos, end - pos);
+                const auto eq = item.find('=');
+                if (eq != std::string_view::npos) {
+                    const u64 n = std::strtoull(std::string(item.substr(eq + 1)).c_str(), nullptr, 10);
+                    if (item.substr(0, eq) == "every") c.every = n;
+                    if (item.substr(0, eq) == "frames") c.frames = n;
+                }
+                pos = end + 1;
+            }
+        }
+        return true;
+    }();
+    (void)configured;
+    return capture;
+}
+
+u64 HostThreadId() {
+    static std::atomic<u64> next{1};
+    thread_local const u64 id = next.fetch_add(1);
+    return id;
+}
+
+void FlushCaptureLocked(Capture& c) {
+    if (c.records.empty()) {
+        return;
+    }
+    const u64 first = c.records.front().frame;
+    const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) /
+                      ("nvn_capture_" + std::to_string(first) + ".txt");
+    std::ofstream out(path, std::ios::trunc);
+    out << "# frame thread name x0..x7 | v0..v3 (low 64 bits; f32 pairs and f64 shown)\n";
+    char line[512];
+    for (const auto& r : c.records) {
+        int n = std::snprintf(line, sizeof(line), "%llu t%llu %s",
+                              static_cast<unsigned long long>(r.frame),
+                              static_cast<unsigned long long>(r.thread), r.entry->name.c_str());
+        for (u64 x : r.x) {
+            n += std::snprintf(line + n, sizeof(line) - n, " %llx", static_cast<unsigned long long>(x));
+        }
+        n += std::snprintf(line + n, sizeof(line) - n, " |");
+        for (u64 v : r.v) {
+            float f[2];
+            std::memcpy(f, &v, sizeof(f));
+            n += std::snprintf(line + n, sizeof(line) - n, " %g", static_cast<double>(f[0]));
+        }
+        out << line << '\n';
+    }
+    c.records.clear();
+}
+
+void OnCall(Entry* entry, RecompHooks::HookContext& ctx) {
+    auto& c = GetCapture();
+    c.frame_calls.fetch_add(1, std::memory_order_relaxed);
+    if (entry->is_draw) {
+        c.frame_draws.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (c.recording.load(std::memory_order_relaxed)) {
+        CallRecord r{c.frame.load(std::memory_order_relaxed), HostThreadId(), entry, {}, {}};
+        std::memcpy(r.x, ctx.x, sizeof(r.x));
+        for (int i = 0; i < 4; ++i) {
+            r.v[i] = ctx.v[i][0];
+        }
+        std::scoped_lock lock{c.lock};
+        c.records.push_back(r);
+    }
+    if (!entry->is_present) {
+        return;
+    }
+    // Frame boundary.
+    std::scoped_lock lock{c.lock};
+    const u64 frame = c.frame.fetch_add(1) + 1;
+    if (!c.csv.is_open()) {
+        c.csv.open(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_frames.csv",
+                   std::ios::trunc);
+        c.csv << "frame,calls,draws,present_thread\n";
+    }
+    c.csv << frame - 1 << ',' << c.frame_calls.exchange(0) << ',' << c.frame_draws.exchange(0)
+          << ",t" << HostThreadId() << '\n';
+    if ((frame & 0xFF) == 0) {
+        c.csv.flush();
+    }
+    if (c.recording && frame >= c.recording_until) {
+        c.recording = false;
+        FlushCaptureLocked(c);
+    }
+    if (!c.recording && c.every != 0 && frame % c.every == 0) {
+        c.recording = true;
+        c.recording_until = frame + c.frames;
+        c.records.reserve(400000);
+    }
+}
+
+std::mutex g_lock;
+// Stable storage: hooks capture raw pointers into these entries.
+std::vector<std::unique_ptr<Entry>> g_entries;
+std::unordered_map<u64, Entry*> g_by_address;
+std::atomic<u64> g_total_calls{0};
+std::chrono::steady_clock::time_point g_last_report{};
+std::atomic<bool> g_report_pending{false};
+
+template <typename T>
+bool ReadAt(std::span<const u8> image, u64 offset, T& out) {
+    if (offset + sizeof(T) > image.size()) {
+        return false;
+    }
+    std::memcpy(&out, image.data() + offset, sizeof(T));
+    return true;
+}
+
+/// Module-relative address of a defined dynamic symbol, or 0.
+u64 FindDefinedSymbol(std::span<const u8> image, std::string_view wanted) {
+    u32 mod0 = 0;
+    if (!ReadAt(image, 4, mod0) || mod0 + 8 > image.size() ||
+        std::memcmp(image.data() + mod0, "MOD0", 4) != 0) {
+        return 0;
+    }
+    s32 dyn_rel = 0;
+    ReadAt(image, mod0 + 4, dyn_rel);
+    u64 dyn = mod0 + static_cast<s64>(dyn_rel);
+    u64 symtab = 0, strtab = 0, hash = 0, strsz = 0;
+    for (;; dyn += 16) {
+        s64 tag = 0;
+        u64 val = 0;
+        if (!ReadAt(image, dyn, tag) || !ReadAt(image, dyn + 8, val) || tag == 0) {
+            break;
+        }
+        switch (tag) {
+        case 4: hash = val; break;   // DT_HASH
+        case 5: strtab = val; break; // DT_STRTAB
+        case 6: symtab = val; break; // DT_SYMTAB
+        case 10: strsz = val; break; // DT_STRSZ
+        default: break;
+        }
+    }
+    if (!symtab || !strtab || !hash) {
+        return 0;
+    }
+    u32 count = 0;
+    ReadAt(image, hash + 4, count); // nchain = number of symbols
+    for (u32 i = 0; i < count; ++i) {
+        const u64 sym = symtab + static_cast<u64>(i) * 24;
+        u32 name_off = 0;
+        u16 shndx = 0;
+        u64 value = 0;
+        if (!ReadAt(image, sym, name_off) || !ReadAt(image, sym + 6, shndx) ||
+            !ReadAt(image, sym + 8, value)) {
+            break;
+        }
+        if (shndx == 0 || name_off >= strsz) {
+            continue;
+        }
+        const char* s = reinterpret_cast<const char*>(image.data() + strtab + name_off);
+        const size_t max = image.size() - (strtab + name_off);
+        if (std::string_view{s, strnlen(s, max)} == wanted) {
+            return value;
+        }
+    }
+    return 0;
+}
+
+void MaybeReport() {
+    const auto now = std::chrono::steady_clock::now();
+    std::scoped_lock lock{g_lock};
+    if (now - g_last_report < std::chrono::seconds(10)) {
+        return;
+    }
+    g_last_report = now;
+    g_report_pending = true;
+}
+
+/// Counting hook on one resolved NVN entry point. Observe-only.
+void Track(Core::System& system, const std::string& name, u64 address) {
+    if (address == 0) {
+        return;
+    }
+    Entry* entry = nullptr;
+    {
+        std::scoped_lock lock{g_lock};
+        if (g_by_address.contains(address)) {
+            return;
+        }
+        auto owned = std::make_unique<Entry>();
+        owned->name = name;
+        owned->address = address;
+        owned->is_present = name == "nvnQueuePresentTexture";
+        owned->is_draw = name.starts_with("nvnCommandBufferDraw");
+        entry = owned.get();
+        g_entries.push_back(std::move(owned));
+        g_by_address[address] = entry;
+    }
+    (void)system;
+    RecompHooks::Install(address, [entry](RecompHooks::HookContext& ctx) {
+        entry->calls.fetch_add(1, std::memory_order_relaxed);
+        OnCall(entry, ctx);
+        if ((g_total_calls.fetch_add(1, std::memory_order_relaxed) & 0xFFFF) == 0) {
+            MaybeReport();
+        }
+        if (g_report_pending.exchange(false)) {
+            WriteReport();
+        }
+        return false;
+    });
+}
+
+/// Resolver hook: entry reads the requested name, the return watch reads the
+/// address the guest driver produced for it. name_reg is the argument register
+/// holding the C string (x0 for the bootstrap loader, x1 for GetProcAddress).
+void HookResolver(Core::System& system, u64 address, int name_reg, std::string label);
+
+void OnResolved(Core::System& system, const std::string& name, u64 result) {
+    static std::atomic<int> shown{0};
+    if (shown.fetch_add(1) < 12) {
+        LOG_INFO(Core_ARM, "NVN resolve {} -> {:#x}", name, result);
+    }
+    if (name == "nvnDeviceGetProcAddress") {
+        HookResolver(system, result, 1, name);
+    }
+    // Native NVN shadow first, so its hooks run before the counter on shared addresses.
+    if (NvnHost::Enabled()) {
+        NvnHost::OnResolved(name, result);
+    }
+    if (Enabled()) {
+        Track(system, name, result);
+    }
+}
+
+void HookResolver(Core::System& system, u64 address, int name_reg, std::string label) {
+    if (address == 0) {
+        return;
+    }
+    {
+        std::scoped_lock lock{g_lock};
+        static std::unordered_map<u64, bool> resolvers;
+        if (resolvers[address]) {
+            return;
+        }
+        resolvers[address] = true;
+    }
+    LOG_INFO(Core_ARM, "NVN trace: hooking {} at {:#x}", label, address);
+    RecompHooks::Install(address, [&system, name_reg](RecompHooks::HookContext& ctx) {
+        const std::string name = ctx.system.ApplicationMemory().ReadCString(ctx.x[name_reg], 128);
+        RecompHooks::TrapReturn(ctx, [&system, name](RecompHooks::HookContext& ret) {
+            OnResolved(system, name, ret.x[0]);
+        });
+        return false;
+    });
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("KARTRECOMP_NVN_TRACE");
+        return v && *v && *v != '0';
+    }();
+    return enabled;
+}
+
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base,
+                     std::string_view name) {
+    if (!Enabled() && !NvnHost::Enabled()) {
+        return;
+    }
+    const u64 bootstrap = FindDefinedSymbol(image, "nvnBootstrapLoader");
+    if (bootstrap == 0) {
+        return;
+    }
+    LOG_INFO(Core_ARM, "NVN trace: nvnBootstrapLoader defined in {} at {:#x}", name,
+             load_base + bootstrap);
+    HookResolver(system, load_base + bootstrap, 0, "nvnBootstrapLoader");
+}
+
+void WriteReport() {
+    std::vector<std::pair<u64, const Entry*>> rows;
+    {
+        std::scoped_lock lock{g_lock};
+        for (const auto& e : g_entries) {
+            rows.emplace_back(e->calls.load(std::memory_order_relaxed), e.get());
+        }
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+        return a.first != b.first ? a.first > b.first : a.second->name < b.second->name;
+    });
+    size_t called = 0;
+    for (const auto& r : rows) {
+        called += r.first != 0;
+    }
+    const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_trace.txt";
+    std::ofstream out(path, std::ios::trunc);
+    out << "=== NVN TRACE ===\n"
+        << "resolved entry points : " << rows.size() << "\n"
+        << "called at least once  : " << called << "\n"
+        << "total calls           : " << g_total_calls.load() << "\n"
+        << "--- calls  address  name ---\n";
+    for (const auto& [calls, e] : rows) {
+        char line[256];
+        std::snprintf(line, sizeof(line), "%12llu  %#012llx  %s\n",
+                      static_cast<unsigned long long>(calls),
+                      static_cast<unsigned long long>(e->address), e->name.c_str());
+        out << line;
+    }
+}
+
+} // namespace Core::NvnTrace
diff --git a/src/core/arm/recomp/nvn_trace.h b/src/core/arm/recomp/nvn_trace.h
new file mode 100644
index 0000000000..5129cdb53e
--- /dev/null
+++ b/src/core/arm/recomp/nvn_trace.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: NVN API tracer, the first step toward native graphics.
+//
+// The game reaches its graphics driver only through nvnBootstrapLoader and the
+// procedure addresses it hands out (nvnDeviceGetProcAddress). Hooking those two
+// gives the name of every NVN entry point the game resolves, and a counting hook
+// on each resolved address shows which ones it actually calls and how often.
+// That list is the exact API surface a native Vulkan/Metal/GLES backend must
+// implement.
+//
+// Enabled with KARTRECOMP_NVN_TRACE=1. Writes <log dir>/nvn_trace.txt.
+#pragma once
+
+#include <span>
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::NvnTrace {
+
+bool Enabled();
+
+/// Called by the NSO loader with each module's image before it is mapped.
+/// Finds a defined nvnBootstrapLoader in the module's dynamic symbols.
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base,
+                     std::string_view name);
+
+/// Writes the report now (also done periodically while tracing).
+void WriteReport();
+
+} // namespace Core::NvnTrace
