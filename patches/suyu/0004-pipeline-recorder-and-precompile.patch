+/// An NSO's segments text, ro, data, LZ4-decoded and concatenated (not at their memory offsets): the buffer build-list.py's
+/// "exefs:<name>" offsets index. Empty, with one log line, if the file is missing or malformed: its pipelines are then skipped.
+std::vector<u8> ReadNsoSegments(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    const std::vector<u8> nso((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    const auto u32_at = [&nso](size_t at) {
+        u32 v;
+        std::memcpy(&v, nso.data() + at, 4);
+        return v;
+    };
+    std::vector<u8> out;
+    bool ok = nso.size() >= 0x100 && std::memcmp(nso.data(), "NSO0", 4) == 0;
+    for (u32 k = 0; ok && k < 3; ++k) {
+        const u32 file_offset = u32_at(0x10 + 0x10 * k), size = u32_at(0x18 + 0x10 * k), packed = u32_at(0x60 + 4 * k);
+        const bool compressed = (u32_at(0xC) >> k & 1) != 0;
+        const u64 stored = compressed ? packed : size;
+        if (u64{file_offset} + stored > nso.size()) {
+            ok = false;
+            break;
+        }
+        const size_t at = out.size();
+        out.resize(at + size);
+        if (compressed) {
+            ok = Common::Compression::DecompressDataLZ4(out.data() + at, size, nso.data() + file_offset, packed) ==
+                 static_cast<int>(size);
+        } else {
+            std::memcpy(out.data() + at, nso.data() + file_offset, size);
+        }
+    }
+    if (!ok) {
+        LOG_WARNING(Frontend, "precompile: executable {} {}: the pipelines using its shaders are skipped",
+                    Common::FS::PathToUTF8String(path), nso.empty() ? "not found" : "is not a readable NSO");
+        return {};
+    }
+    return out;
+}
+
+/// KARTRECOMP_PRECOMPILE=<list>, at install time: the native backend, in a hidden window, creates the list's pipelines from the
+/// game files into its pipeline cache (KartRecomp::PrecompilePipelines), then the process exits; the game is never loaded.
+/// romfs: the game's RomFS (base + update), null without --content-base; KARTRECOMP_ROMFS_DIR (decrypted installs) wins.
+[[noreturn]] void PrecompileAndExit(const std::string& list, const FileSys::VirtualFile& romfs,
+                                    const FileSys::VirtualFilesystem& vfs) {
+    const auto exit_with = [](int code) {
+        std::fflush(nullptr);
+        Common::Log::Stop(); // flushes the log: _Exit skips it (no static destructors, as in DumpRomfsAndExit)
+        std::_Exit(code);
+    };
+    FileSys::VirtualDir root;
+    if (const char* dir = std::getenv("KARTRECOMP_ROMFS_DIR"); dir && *dir) {
+        std::error_code ec;
+        if (std::filesystem::is_directory(dir, ec)) root = vfs->OpenDirectory(dir, FileSys::OpenMode::Read); // opens missing ones too
+    } else if (romfs) {
+        root = FileSys::ExtractRomFS(romfs);
+    }
+    if (!root) {
+        std::fprintf(stderr, "precompile: no game RomFS (give --content-base and --content-update, or KARTRECOMP_ROMFS_DIR)\n");
+        exit_with(2);
+    }
+    auto backend = KartRecomp::CreateVulkanShadowBackend(false, KartRecomp::MakeSdlSurface(true));
+    if (!backend) {
+        LOG_WARNING(Frontend, "precompile: no Vulkan backend with a hidden window, trying a visible one");
+        backend = KartRecomp::CreateVulkanShadowBackend(false);
+    }
+    if (!backend) {
+        std::fprintf(stderr, "precompile: no usable Vulkan device (see the log)\n");
+        exit_with(3);
+    }
+    // "exefs:<name>": shaders embedded in the game's executable, from the NSOs the setup exported.
+    const char* exefs_env = std::getenv("KARTRECOMP_PRECOMPILE_EXEFS");
+    const std::filesystem::path exefs_dir = exefs_env && *exefs_env
+        ? std::filesystem::path(exefs_env)
+        : Common::FS::GetSuyuPath(Common::FS::SuyuPath::CacheDir) / "export" / "nso";
+    std::mutex read_mutex;
+    const int code = KartRecomp::PrecompilePipelines(*backend, list, [&](const std::string& path) {
+        if (path.starts_with("exefs:")) return ReadNsoSegments(exefs_dir / path.substr(6));
+        std::scoped_lock lock{read_mutex}; // the RomFS reads through the NSP's decryption layers: one reader at a time
+        const FileSys::VirtualFile file = root->GetFileRelative(path);
+        return file ? file->ReadAllBytes() : std::vector<u8>{};
+    });
+    exit_with(code);
+}
