+                        ctx.x[2], ctx.x[3], ctx.x[4], ctx.x[5], ctx.x[6]);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindStorageBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindStorageBuffer, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
+        c.address = ctx.x[3];
+        c.size = ctx.x[4];
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindTexture"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindTexture, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
