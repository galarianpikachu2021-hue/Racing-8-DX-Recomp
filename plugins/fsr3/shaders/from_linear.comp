// kart-recomp FSR 3 plugin: FSR's linear RGBA16F result back to the host's sRGB-encoded output image (A2B10G10R10).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgb10_a2) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; int pass_through; } p;
vec3 linear_to_srgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= p.size.x || px.y >= p.size.y) return;
    vec3 c = texelFetch(src, px, 0).rgb;
    imageStore(dst, px, vec4(p.pass_through != 0 ? clamp(c, 0.0, 1.0) : linear_to_srgb(c), 1.0));
}
