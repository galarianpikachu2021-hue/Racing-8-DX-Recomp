+#!/usr/bin/env bash
+# Builds and runs kart_runtime's tests on their own (no emulator, no CMake): proof that the runtime stands alone.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+out="${1:-$(mktemp -d)}"
+for t in "$here"/test_*.cpp; do
+  n="$(basename "$t" .cpp)"
+  "${CXX:-g++}" -std=c++20 -O2 -Wall -Wextra -Werror -pthread ${CXXFLAGS:-} "$t" -o "$out/$n"
+  "$out/$n"
+done
diff --git a/src/kart_runtime/tests/test_address_space.cpp b/src/kart_runtime/tests/test_address_space.cpp
new file mode 100644
index 0000000000..bd490d35af
--- /dev/null
+++ b/src/kart_runtime/tests/test_address_space.cpp
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tests for kart_runtime/address_space.h: the kernel's rules for a process's memory as a game uses them, with a fake host
+// mapping that keeps a page table over real bytes (so aliases are checked by reading the same data at two addresses).
+#include "../address_space.h"
+
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <unordered_map>
+
+using namespace KartRuntime;
+
+namespace {
+
+constexpr uint64_t Page = AddressSpace::PageSize;
+
+class FakeBackend final : public AddressSpace::Backend {
+public:
+    explicit FakeBackend(size_t backing_size) : backing(backing_size) {}
+    void Map(uint64_t va, uint64_t size, uint64_t phys, uint32_t perm) override {
+        for (uint64_t o = 0; o < size; o += Page) pages[(va + o) / Page] = {phys + o, perm};
+    }
+    void Unmap(uint64_t va, uint64_t size) override {
+        for (uint64_t o = 0; o < size; o += Page) pages.erase((va + o) / Page);
+    }
+    void Protect(uint64_t va, uint64_t size, uint32_t perm) override {
+        for (uint64_t o = 0; o < size; o += Page) pages.at((va + o) / Page).perm = perm;
+    }
+    bool Write(uint64_t va, const void* data, size_t n) {
+        const auto it = pages.find(va / Page);
+        if (it == pages.end() || !(it->second.perm & MemPerm::Write)) return false;
+        std::memcpy(backing.data() + it->second.phys + va % Page, data, n);
+        return true;
+    }
+    bool Read(uint64_t va, void* data, size_t n) {
+        const auto it = pages.find(va / Page);
+        if (it == pages.end() || !(it->second.perm & MemPerm::Read)) return false;
+        std::memcpy(data, backing.data() + it->second.phys + va % Page, n);
+        return true;
+    }
+    struct P {
+        uint64_t phys;
+        uint32_t perm;
+    };
+    std::vector<uint8_t> backing;
+    std::unordered_map<uint64_t, P> pages;
+};
+
+AddressSpace::Layout GameLayout() {
+    AddressSpace::Layout l;
+    l.space_start = 0;
+    l.space_size = 0x80'0000'0000;
+    l.code_start = 0x800'0000;
+    l.code_size = 0x7f'f800'0000;
+    l.heap_start = 0x21'0360'0000;
+    l.heap_size = 0x2'0000'0000;
+    l.alias_start = 0x11'0360'0000;
+    l.alias_size = 0x10'0000'0000;
+    l.stack_start = 0x10'8360'0000;
+    l.stack_size = 0x8000'0000;
+    l.kmap_start = 0x8360'0000;
+    l.kmap_size = 0x10'0000'0000;
+    return l;
+}
+
+} // namespace
+
+int main() {
+    FakeBackend host(64 << 20);
+    PhysicalAllocator phys(0, 64 << 20);
+    AddressSpace as(GameLayout(), host, phys);
+
+    // Empty space: one free block, the rest inaccessible.
+    auto info = as.Query(0x1234000);
+    assert(info.state == MemState::Free && info.base_address == 0 && info.size == 0x80'0000'0000);
+    info = as.Query(0x80'0000'0000);
+    assert(info.state == MemState::Inaccessible && info.base_address == 0x80'0000'0000 && info.base_address + info.size == 0);
+
+    // Code: text R-X, data RW (as the loader maps a module).
+    assert(as.MapNew(0x8000'0000, 0x10000, MemState::Code, MemPerm::ReadExecute) == 0);
+    assert(as.MapNew(0x8001'0000, 0x4000, MemState::CodeData, MemPerm::ReadWrite) == 0);
+    info = as.Query(0x8000'8000);
+    assert(info.base_address == 0x8000'0000 && info.size == 0x10000 && info.state == MemState::Code && info.permission == MemPerm::ReadExecute);
+    assert(as.MapNew(0x8000'f000, 0x2000, MemState::Code, MemPerm::Read) == MemResult::InvalidCurrentMemory); // overlap
+    std::printf("code: mapped, queried, overlap refused\n");
+
+    // Heap: grows and shrinks in 2 MiB steps.
+    uint64_t heap = 0;
+    assert(as.SetHeapSize(0x10'0000, &heap) == MemResult::InvalidSize);
+    assert(as.SetHeapSize(0x40'0000, &heap) == 0 && heap == 0x21'0360'0000);
+    assert(host.Write(heap + 0x123, "abc", 3));
+    assert(as.SetHeapSize(0x80'0000, &heap) == 0);
+    info = as.Query(heap + 0x50'0000);
+    assert(info.state == MemState::Normal && info.base_address == heap && info.size == 0x80'0000); // the two steps look like one
+    char got[4]{};
+    assert(host.Read(heap + 0x123, got, 3) && std::memcmp(got, "abc", 3) == 0);
+    assert(as.SetHeapSize(0x20'0000, &heap) == 0);
+    assert(as.Query(heap + 0x20'0000).state == MemState::Free);
+    assert(phys.Used() == 0x10000 + 0x4000 + 0x20'0000);
+    std::printf("heap: grow, shrink, contents kept, pages freed\n");
+
+    // Alias (thread stacks): the source is locked and hidden, the destination shows the same bytes.
+    const uint64_t stack = 0x10'8360'0000;
+    assert(as.MapAlias(0x9000'0000, heap, 0x4000) == MemResult::InvalidMemoryRegion); // destination outside the stack region
+    assert(as.MapAlias(stack, heap, 0x4000) == 0);
+    info = as.Query(heap);
+    assert(info.attribute == MemAttr::Locked && info.permission == MemPerm::None && info.size == 0x4000);
+    assert(!host.Read(heap + 0x123, got, 3));
+    assert(host.Read(stack + 0x123, got, 3) && std::memcmp(got, "abc", 3) == 0);
+    assert(as.Query(stack).state == MemState::Stack);
+    assert(as.MapAlias(stack + 0x10000, heap, 0x4000) == MemResult::InvalidCurrentMemory); // already locked
+    assert(as.Unmap(heap, 0x4000, MemState::Normal) == MemResult::InvalidCurrentMemory);     // locked memory stays
+    assert(as.UnmapAlias(stack, heap, 0x4000) == 0);
+    assert(as.Query(stack).state == MemState::Free && as.Query(heap).attribute == 0 && as.Query(heap).permission == MemPerm::ReadWrite);
+    assert(host.Read(heap + 0x123, got, 3));
+    info = as.Query(heap);
+    assert(info.size == 0x20'0000); // whole again
+    std::printf("alias: lock, hide, share, refuse, undo\n");
+
+    // Attributes (the GPU driver marks memory uncached).
+    assert(as.SetAttribute(heap, 0x10000, MemAttr::Uncached, MemAttr::Uncached) == 0);
+    assert(as.Query(heap).attribute == MemAttr::Uncached && as.Query(heap).size == 0x10000);
+    assert(as.SetAttribute(heap, 0x10000, MemAttr::Uncached, 0) == 0);
+    assert(as.Query(heap).attribute == 0 && as.Query(heap).size == 0x20'0000);
+    assert(as.SetAttribute(0x8000'0000, Page, MemAttr::Uncached, MemAttr::Uncached) == MemResult::InvalidCurrentMemory); // code
+    assert(as.SetAttribute(heap, Page, MemAttr::Locked, MemAttr::Locked) == MemResult::InvalidCombination);
+    assert(as.SetAttribute(0x8001'0000, Page, MemAttr::PermissionLocked, MemAttr::PermissionLocked) == 0);
+    std::printf("attributes: uncached on data, refused on code, bad masks\n");
+
+    // Transfer memory (audio work buffer) and device locks (GPU driver).
+    assert(as.LockTransfer(heap + 0x10000, 0x10000, MemPerm::None) == 0);
+    assert(as.Query(heap + 0x10000).attribute == MemAttr::Locked && !host.Write(heap + 0x10000, "x", 1));
+    assert(as.UnlockTransfer(heap + 0x10000, 0x10000) == 0 && host.Write(heap + 0x10000, "x", 1));
+    assert(as.LockDevice(heap, 0x8000) == 0 && as.LockDevice(heap, 0x4000) == 0);
+    info = as.Query(heap);
+    assert(info.device_count == 2 && info.size == 0x4000 && (info.attribute & MemAttr::DeviceShared));
+    assert(as.UnlockDevice(heap, 0x4000) == 0 && as.UnlockDevice(heap, 0x8000) == 0);
+    assert(as.Query(heap).device_count == 0 && as.Query(heap).size == 0x20'0000);
+    std::printf("transfer and device locks\n");
+
+    // Shared memory: pages owned elsewhere, mapped and unmapped without freeing them.
+    const auto shared = *phys.Allocate(0x40000);
+    const uint64_t used = phys.Used();
+    const auto where = as.FindFree(GameLayout().alias_start, GameLayout().alias_size, 0x40000);
+    assert(where && as.MapPhysical(*where, 0x40000, shared, MemState::Shared, MemPerm::Read) == 0);
+    assert(as.Query(*where).state == MemState::Shared && as.PhysicalOf(*where + 0x1234) == shared + 0x1234);
+    assert(as.Unmap(*where, 0x40000, MemState::Normal) == MemResult::InvalidCurrentMemory);
+    assert(as.Unmap(*where, 0x40000, MemState::Shared) == 0 && phys.Used() == used);
+    std::printf("shared memory\n");
+
+    // Everything unmapped: back to one free block, no pages in use but the shared one.
+    assert(as.SetHeapSize(0, &heap) == 0);
+    assert(as.Unmap(0x8000'0000, 0x10000, MemState::Code) == 0);
+    assert(as.Unmap(0x8001'0000, 0x4000, MemState::CodeData) == MemResult::InvalidCurrentMemory); // permission-locked
+    assert(as.SetAttribute(0x8001'0000, Page, MemAttr::PermissionLocked, 0) == 0);
+    assert(as.Unmap(0x8001'0000, 0x4000, MemState::CodeData) == 0);
+    assert(as.BlockCount() == 1 && phys.Used() == 0x40000 && host.pages.empty());
+    // A heap larger than any single free run: built from several runs, read back across the seam.
+    {
+        FakeBackend host2(16 << 20);
+        PhysicalAllocator pool;
+        pool.AddRange(0, 4 << 20);
+        pool.AddRange(8 << 20, 4 << 20);
+        AddressSpace as2(GameLayout(), host2, pool);
+        uint64_t h = 0;
+        assert(as2.SetHeapSize(6 << 20, &h) == 0 && pool.Used() == (6u << 20));
+        assert(host2.Write(h + (4 << 20) - 2, "se", 2) && host2.Write(h + (4 << 20), "am", 2)); // the helper copies within one page
+        char buf[5]{};
+        assert(host2.Read(h + (4 << 20) - 2, buf, 2) && host2.Read(h + (4 << 20), buf + 2, 2) && std::memcmp(buf, "seam", 4) == 0);
+        assert(as2.Query(h).size == (6u << 20)); // one heap to the game
+        assert(as2.SetHeapSize(10 << 20, &h) == MemResult::OutOfMemory);
+        assert(as2.SetHeapSize(0, &h) == 0 && pool.Used() == 0);
+    }
+    std::printf("heap from several physical runs\n");
+    std::printf("address_space: all tests passed\n");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_core_scheduler.cpp b/src/kart_runtime/tests/test_core_scheduler.cpp
new file mode 100644
index 0000000000..78b15c88ec
--- /dev/null
+++ b/src/kart_runtime/tests/test_core_scheduler.cpp
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Standalone test of KartRuntime::CoreScheduler (no test framework: exits non-zero with a message on failure).
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+#include "../core_scheduler.h"
+
+using KartRuntime::CoreScheduler;
+using namespace std::chrono_literals;
+
+#define CHECK(cond)                                                                    \
+    do {                                                                               \
+        if (!(cond)) {                                                                 \
+            std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #cond);     \
+            std::exit(1);                                                              \
+        }                                                                              \
+    } while (0)
+
+// Many threads on few cores doing short bursts: never two running on one core.
+static void OnePerCore() {
+    constexpr int kCores = 3, kThreads = 24, kRounds = 400;
+    CoreScheduler s{kCores};
+    std::atomic<int> on_core[kCores]{};
+    std::atomic<long> bursts{0};
+    std::vector<std::thread> pool;
+    for (int i = 0; i < kThreads; ++i) {
+        pool.emplace_back([&, i] {
+            auto t = s.Create(i % kCores, 40 + i % 5);
+            for (int r = 0; r < kRounds; ++r) {
+                s.Acquire(t.get());
+                CHECK(on_core[t->Core()].fetch_add(1) == 0);
+                for (volatile int spin = 0; spin < 200; spin = spin + 1) {}
+                if (r % 7 == 0) {
+                    on_core[t->Core()].fetch_sub(1);
+                    s.Yield(t.get()); // may hand the core over and come back
+                    CHECK(on_core[t->Core()].fetch_add(1) == 0);
+                }
+                CHECK(on_core[t->Core()].fetch_sub(1) == 1);
+                bursts.fetch_add(1);
+                s.Release(t.get());
+            }
+        });
+    }
+    for (auto& th : pool) th.join();
+    CHECK(bursts.load() == static_cast<long>(kThreads) * kRounds);
+    for (int c = 0; c < kCores; ++c) CHECK(s.Running(c) == nullptr);
+}
+
+// Waiters are served best priority first, then in arrival order.
+static void PriorityOrder() {
+    CoreScheduler s{1};
+    auto holder = s.Create(0, 10);
+    s.Acquire(holder.get());
+    std::vector<int> order;
+    std::mutex order_lock;
+    std::vector<std::thread> pool;
+    const int priorities[] = {50, 20, 50, 30, 20};
+    for (int i = 0; i < 5; ++i) {
+        pool.emplace_back([&, i] {
+            auto t = s.Create(0, priorities[i]);
+            s.Acquire(t.get());
+            {
+                std::scoped_lock lk{order_lock};
+                order.push_back(i);
+            }
+            s.Release(t.get());
+        });
+        std::this_thread::sleep_for(30ms); // arrival order = i
+    }
+    CHECK(!s.PreemptRequested(holder.get())); // nobody waiting is better than priority 10
+    s.Release(holder.get());
+    for (auto& th : pool) th.join();
+    const std::vector<int> want{1, 4, 3, 0, 2}; // 20 (first), 20 (second), 30, 50 (first), 50 (second)
+    CHECK(order == want);
+}
+
+// A better-priority arrival asks the running thread to yield; an equal one does not, but Yield lets it in.
+static void Preemption() {
+    CoreScheduler s{1};
+    auto low = s.Create(0, 40);
+    s.Acquire(low.get());
+    std::atomic<int> stage{0};
+    std::thread high([&] {
+        auto t = s.Create(0, 10);
+        s.Acquire(t.get());
+        stage = 1;
+        s.Release(t.get());
+    });
+    while (!s.PreemptRequested(low.get())) std::this_thread::sleep_for(1ms);
+    CHECK(stage == 0); // still waiting: preemption is a request
+    s.Yield(low.get());
+    CHECK(stage == 1); // the better thread ran before we came back
+    CHECK(s.Running(0) == low.get());
+    high.join();
+
+    std::thread equal([&] {
+        auto t = s.Create(0, 40);
+        s.Acquire(t.get());
+        stage = 2;
+        s.Release(t.get());
+    });
+    std::this_thread::sleep_for(50ms);
+    CHECK(!s.PreemptRequested(low.get()) && stage == 1);
+    s.Yield(low.get()); // equal priority: takes its turn on a yield
+    CHECK(stage == 2);
+    s.Release(low.get());
+    equal.join();
+}
+
+// Raising a waiter's priority above the running thread requests preemption; moving a waiter to an idle core runs it.
+static void PriorityAndCoreChanges() {
+    CoreScheduler s{2};
+    auto a = s.Create(0, 30);
+    s.Acquire(a.get());
+    std::atomic<bool> ran{false};
+    std::unique_ptr<CoreScheduler::Thread> b = s.Create(0, 50);
+    std::thread other([&] {
+        s.Acquire(b.get());
+        ran = true;
+        s.Release(b.get());
+    });
+    std::this_thread::sleep_for(50ms);
+    CHECK(!ran && !s.PreemptRequested(a.get()));
+    s.SetPriority(b.get(), 5);
+    CHECK(s.PreemptRequested(a.get()));
+    s.SetPriority(b.get(), 50);
+    s.SetCore(b.get(), 1); // core 1 is idle: b runs there without a taking a break
+    other.join();
+    CHECK(ran && s.Running(0) == a.get());
+    s.Release(a.get());
+}
+
+// Moving a RUNNING thread: it keeps its core (and reports it) until it yields, so no other thread executes with that core
+// number meanwhile (the game indexes per-core buffers by it); after the yield it runs on the new core.
+static void MoveRunningThread() {
+    CoreScheduler s{2, true};
+    auto a = s.Create(0, 30);
+    s.Acquire(a.get());
+    std::atomic<bool> b_ran{false};
+    auto b = s.Create(0, 30); // same core, same priority: waits behind a
+    std::thread other([&] {
+        s.Acquire(b.get());
+        b_ran = true;
+        s.Release(b.get());
+    });
+    std::this_thread::sleep_for(50ms);
+    s.SetCore(a.get(), 1);
+    CHECK(s.PreemptRequested(a.get()));
+    CHECK(a->Core() == 0 && s.Running(0) == a.get()); // still core 0's thread until it yields
+    std::this_thread::sleep_for(50ms);
+    CHECK(!b_ran); // core 0 was not handed on while a still ran
+    s.Yield(a.get()); // the safe point: a moves to core 1 (idle), b gets core 0
+    CHECK(a->Core() == 1 && s.Running(1) == a.get());
+    other.join();
+    CHECK(b_ran);
+    // A move asked for while running, then a wait (Release): the next Acquire is on the new core.
+    s.SetCore(a.get(), 0);
+    s.Release(a.get());
+    CHECK(a->Core() == 0);
+    s.Acquire(a.get());
+    CHECK(s.Running(0) == a.get());
+    // A wait inside a host call (keep_core): the thread comes back to the same core; the move happens at its next yield.
+    s.SetCore(a.get(), 1);
+    s.Release(a.get(), true);
+    CHECK(a->Core() == 0);
+    s.Acquire(a.get());
+    CHECK(s.Running(0) == a.get() && s.PreemptRequested(a.get()));
+    s.Yield(a.get());
+    CHECK(a->Core() == 1 && s.Running(1) == a.get());
+    s.Release(a.get());
+}
+
+int main() {
+    OnePerCore();
+    PriorityOrder();
+    Preemption();
+    PriorityAndCoreChanges();
+    MoveRunningThread();
+    std::puts("core_scheduler: all tests passed");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_direct_memory.cpp b/src/kart_runtime/tests/test_direct_memory.cpp
new file mode 100644
index 0000000000..bbaebea55b
--- /dev/null
+++ b/src/kart_runtime/tests/test_direct_memory.cpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime test: direct memory's fault handler on a small arena.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "../direct_memory.h"
+
+#if defined(__linux__) && defined(__x86_64__)
+namespace {
+constexpr std::uint64_t kSize = 64 * 0x1000;
+constexpr std::uint64_t kMapped = 50 * 0x1000; // one game page that exists, read-only
+
+bool IsMapped(std::uint64_t address) {
+    return (address & ~std::uint64_t{0xfff}) == kMapped;
+}
+
+#define CHECK(x)                                                                                                                 \
+    do {                                                                                                                         \
+        if (!(x)) {                                                                                                              \
+            std::printf("FAILED %s:%d: %s\n", __FILE__, __LINE__, #x);                                                           \
+            std::exit(1);                                                                                                        \
+        }                                                                                                                        \
+    } while (0)
+} // namespace
+
+int main() {
+    using namespace KartRuntime::DirectMemory;
+    auto* arena = static_cast<std::uint8_t*>(mmap(nullptr, kSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    CHECK(arena != MAP_FAILED);
+    CHECK(mmap(arena + kMapped, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != MAP_FAILED);
+    arena[kMapped + 5] = 42;
+    CHECK(mprotect(arena + kMapped, 0x1000, PROT_READ) == 0);
+    CHECK(Install(arena, kSize, &IsMapped));
+    volatile std::uint8_t* mem = arena;
+    Stats& stats = GetStats();
+
+    // Reads of unmapped memory give zeros; the page faults once.
+    volatile std::uint64_t* null_object = reinterpret_cast<volatile std::uint64_t*>(arena + 0x100);
+    CHECK(*null_object == 0);
+    CHECK(null_object[1] == 0);
+    CHECK(stats.unmapped_reads.load() == 1);
+    CHECK(stats.last_unmapped.load() == 0x100);
+
+    // Writes to unmapped memory are dropped, on a page read before and on a fresh one.
+    *null_object = 0x1234;
+    CHECK(*null_object == 0);
+    mem[3 * 0x1000 + 7] = 9;
+    CHECK(mem[3 * 0x1000 + 7] == 0);
+    CHECK(stats.unmapped_writes.load() == 2);
+
+    // A write across two unmapped pages: both halves dropped.
+    *reinterpret_cast<volatile std::uint64_t*>(arena + 5 * 0x1000 - 4) = ~std::uint64_t{0}; // unaligned on purpose (x86)
+    for (int i = -4; i < 4; ++i) CHECK(mem[5 * 0x1000 + i] == 0);
+    CHECK(stats.unmapped_writes.load() == 4);
+
+    // A page that keeps taking writes becomes a sink: the writes stop faulting, and ZeroSinks empties it.
+    const std::uint64_t writes_before = stats.unmapped_writes.load();
+    for (int i = 0; i < 1000; ++i) mem[20 * 0x1000 + (i & 0xff)] = static_cast<std::uint8_t>(i | 1);
+    CHECK(stats.sink_pages.load() == 1);
+    CHECK(stats.unmapped_writes.load() - writes_before <= 16);
+    CHECK(mem[20 * 0x1000 + 5] != 0);
+    ZeroSinks();
+    for (int i = 0; i < 256; ++i) CHECK(mem[20 * 0x1000 + i] == 0);
+    mem[20 * 0x1000 + 9] = 3; // still a sink: no fault, emptied again
+    ZeroSinks();
+    CHECK(mem[20 * 0x1000 + 9] == 0);
+    CHECK(stats.sink_pages.load() == 1);
+
+    // A writer walking upwards through unmapped memory: the sink range grows ahead of it, so almost no write faults, and it
+    // stops at the mapped page (which is opened, not swallowed).
+    const std::uint64_t walk_before = stats.unmapped_writes.load();
+    for (std::uint64_t a = 21 * 0x1000; a < 40 * 0x1000; a += 4) *reinterpret_cast<volatile std::uint32_t*>(arena + a) = 0xdead;
+    CHECK(stats.unmapped_writes.load() - walk_before < 200);
+    ZeroSinks();
+    for (std::uint64_t a = 21 * 0x1000; a < 40 * 0x1000; a += 0x400) CHECK(mem[a] == 0);
+    CHECK(mem[kMapped + 5] == 42);
+
+    // A mapped page the game may not write is opened, and keeps its contents and the write.
+    mem[kMapped + 6] = 7;
+    CHECK(mem[kMapped + 5] == 42 && mem[kMapped + 6] == 7);
+    CHECK(stats.opened_pages.load() == 1);
+    CHECK(stats.last_opened.load() == kMapped + 6);
+    std::printf("test_direct_memory: ok\n");
+    return 0;
+}
+#else
+int main() {
+    std::printf("test_direct_memory: skipped (no fault handler on this platform)\n");
+    return KartRuntime::DirectMemory::Install(nullptr, 0, nullptr) ? 1 : 0;
+}
+#endif
diff --git a/src/kart_runtime/tests/test_game_kernel.cpp b/src/kart_runtime/tests/test_game_kernel.cpp
new file mode 100644
index 0000000000..9bc40a8729
--- /dev/null
+++ b/src/kart_runtime/tests/test_game_kernel.cpp
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tests for kart_runtime/game_kernel.h: game threads on virtual cores with a scripted executor (each step of a thread's
+// "code" sets its registers and makes a system call), over a fake memory backend with real bytes.
+#include "../game_kernel.h"
+
+#include <cassert>
+#include <cstdio>
+#include <map>
+#include <unordered_map>
+
+using namespace KartRuntime;
+
+namespace {
+
+constexpr uint64_t Page = AddressSpace::PageSize;
+
+class Backend final : public AddressSpace::Backend {
+public:
+    Backend() : bytes(64 << 20) {}
+    void Map(uint64_t va, uint64_t size, uint64_t phys, uint32_t) override {
+        std::scoped_lock lk{m};
+        for (uint64_t o = 0; o < size; o += Page) pages[(va + o) / Page] = phys + o;
+    }
+    void Unmap(uint64_t va, uint64_t size) override {
+        std::scoped_lock lk{m};
+        for (uint64_t o = 0; o < size; o += Page) pages.erase((va + o) / Page);
+    }
+    void Protect(uint64_t, uint64_t, uint32_t) override {}
+    uint8_t* Host(uint64_t va) {
+        std::scoped_lock lk{m};
+        const auto it = pages.find(va / Page);
+        return it == pages.end() ? nullptr : bytes.data() + it->second + va % Page;
+    }
+    std::vector<uint8_t> bytes;
+    std::mutex m;
+    std::unordered_map<uint64_t, uint64_t> pages;
+};
+
+AddressSpace::Layout Layout() {
+    AddressSpace::Layout l;
+    l.space_size = 0x80'0000'0000;
+    l.code_start = 0x800'0000;
+    l.code_size = 0x7f'f800'0000;
+    l.heap_start = 0x21'0360'0000;
+    l.heap_size = 0x2'0000'0000;
+    l.alias_start = 0x11'0360'0000;
+    l.alias_size = 0x10'0000'0000;
+    l.stack_start = 0x10'8360'0000;
+    l.stack_size = 0x8000'0000;
+    l.kmap_start = 0x8360'0000;
+    l.kmap_size = 0x10'0000'0000;
+    return l;
+}
+
+/// A thread's code: steps, each setting registers and returning a system call number (after the call, the next step sees the
+/// results in x0, x1...).
+using Step = std::function<int(ThreadContext&)>;
+
+class ScriptExecutor final : public Executor {
+public:
+    std::map<uint64_t, std::vector<Step>> programs; ///< by entry pc
+    int Run(GuestThread& t, int) override {
+        if (!t.executor_data) {
+            std::scoped_lock lk{m};
+            t.executor_data = &state[&t];
+            state[&t].program = &programs.at(t.ctx.pc);
+        }
+        auto& s = *static_cast<State*>(t.executor_data);
+        if (s.next >= s.program->size()) return 0x0A; // falls off the end: ExitThread
+        return (*s.program)[s.next++](t.ctx);
+    }
+    void Interrupt(int) override {}
+
+private:
+    struct State {
+        const std::vector<Step>* program = nullptr;
+        size_t next = 0;
+    };
+    std::mutex m;
+    std::map<GuestThread*, State> state;
+};
+
+} // namespace
+
+int main() {
+    Backend backend;
+    PhysicalAllocator phys(0, 64 << 20);
+    AddressSpace mem(Layout(), backend, phys);
+    GameKernel* gk = nullptr;
+    NativeKernel handles{{
+        [&](uint64_t a, void* out, size_t n) {
+            for (size_t i = 0; i < n; ++i) {
+                uint8_t* p = backend.Host(a + i);
+                if (!p) return false;
+                static_cast<uint8_t*>(out)[i] = *p;
+            }
+            return true;
+        },
+        [&](uint64_t a, const void* in, size_t n) {
+            for (size_t i = 0; i < n; ++i) {
+                uint8_t* p = backend.Host(a + i);
+                if (!p) return false;
+                *p = static_cast<const uint8_t*>(in)[i];
+            }
+            return true;
+        },
+        [&] { gk->BeginWait(); },
+        [&] { gk->EndWait(); },
+        [] { return uint64_t{0x51}; },
+    }};
+    SyncArbiter sync{{
+        [&](uint64_t a) { return reinterpret_cast<uint32_t*>(backend.Host(a)); },
+        [&] { gk->BeginWait(); },
+        [&] { gk->EndWait(); },
+    }};
+    CoreScheduler sched{4, true};
+    ScriptExecutor exec;
+    GameKernel::Config cfg;
+    cfg.program_id = 0x0100152000022000;
+    cfg.entry = 0x8000'0000;
+    cfg.main_core = 0;
+    cfg.total_memory = 0xcd50'0000;
+    GameKernel kernel{cfg, mem, handles, sync, sched, exec};
+    gk = &kernel;
+    sync.Unlock(0); // (no-op: keeps the arbiter's lazy state initialised the same way in every run)
+
+    // Shared state the scripts record into.
+    std::atomic<int> child_ran{0};
+    std::atomic<uint64_t> heap{0}, child_handle{0}, word{0}, info_total{0}, main_core{9}, moved_core{9};
+    std::atomic<uint32_t> wait_result{1}, wait_index{9}, query_state{0}, shm_result{1};
+    uint64_t child_id = 0, self_id = 0;
+
+    const uint64_t child_entry = 0x8000'1000, sleeper_entry = 0x8000'2000;
+    // Child: report, wait on an address until main signals it, exit.
+    exec.programs[child_entry] = {
+        [&](ThreadContext& c) {
+            child_ran = 1;
+            c.x[1] = GameKernel::CurrentThreadHandle;
+            return 0x25; // GetThreadId
+        },
+        [&](ThreadContext& c) {
+            child_id = c.x[1];
+            c.x[0] = word.load();
+            c.x[1] = 2; // WaitIfEqual
+            c.x[2] = 0;
+            c.x[3] = ~uint64_t{0}; // forever
+            return 0x34;
+        },
+    };
+    // Sleeper: waits forever on its own handle-less object... (a thread that only ends by shutdown).
+    std::atomic<uint64_t> sleeper_core{9};
+    exec.programs[sleeper_entry] = {
+        [&](ThreadContext&) { return 0x10; }, // GetCurrentProcessorNumber: the core its mask chose before it started
+        [&](ThreadContext& c) {
+            sleeper_core = c.x[0];
+            c.x[0] = 60'000'000'000; // 60 s
+            return 0x0B;
+        },
+    };
+    exec.programs[cfg.entry] = {
+        [&](ThreadContext& c) { // the main thread's handle came in x1
+            c.x[1] = GameKernel::CurrentThreadHandle;
+            return 0x25;
+        },
+        [&](ThreadContext& c) {
+            self_id = c.x[1];
+            c.x[1] = 0x400000;
+            return 0x01; // SetHeapSize
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            heap = c.x[1];
+            word = heap + 0x100;
+            // Child stack: alias 0x4000 of heap into the stack region, as the SDK does.
+            c.x[0] = Layout().stack_start + 0x1000'0000;
+            c.x[1] = heap + 0x10000;
+            c.x[2] = 0x4000;
+            return 0x04; // MapMemory
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            c.x[1] = child_entry;
+            c.x[2] = 0;
+            c.x[3] = Layout().stack_start + 0x1000'4000;
+            c.x[4] = 44;
+            c.x[5] = 1; // another core (main spins below while it waits for the child)
+            return 0x08; // CreateThread
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            child_handle = c.x[1];
+            c.x[0] = c.x[1];
+            return 0x09; // StartThread
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            return 0x10; // GetCurrentProcessorNumber
+        },
+        [&](ThreadContext& c) {
+            main_core = c.x[0];
+            // Let the child reach its wait, then signal it.
+            while (sync.Waiting() == 0) std::this_thread::yield();
+            c.x[0] = word.load();
+            c.x[1] = 0; // Signal
+            c.x[2] = 0;
+            c.x[3] = 1;
+            return 0x35;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            // Wait for the child to end: the handle list in the heap.
+            const uint32_t h = static_cast<uint32_t>(child_handle.load());
+            std::memcpy(backend.Host(heap + 0x200), &h, 4);
+            c.x[1] = heap + 0x200;
+            c.x[2] = 1;
+            c.x[3] = 5'000'000'000;
+            return 0x18;
+        },
+        [&](ThreadContext& c) {
+            wait_result = static_cast<uint32_t>(c.x[0]);
+            wait_index = static_cast<uint32_t>(c.x[1]);
+            c.x[0] = heap + 0x300; // QueryMemory into the heap
+            c.x[2] = Layout().stack_start + 0x1000'0000;
+            return 0x06;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            MemoryInfo info{};
+            std::memcpy(&info, backend.Host(heap + 0x300), sizeof(info));
+            query_state = info.state;
+            c.x[1] = 6; // TotalMemorySize
+            c.x[2] = GameKernel::CurrentProcessHandle;
+            c.x[3] = 0;
+            return 0x29;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            info_total = c.x[1];
+            c.x[0] = GameKernel::CurrentThreadHandle;
+            c.x[1] = static_cast<uint64_t>(-1);
+            c.x[2] = 0b0100; // core 2 only
+            return 0x0F; // SetThreadCoreMask
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            return 0x10;
+        },
+        [&](ThreadContext& c) {
+            moved_core = c.x[0];
+            // Transfer memory locks the pages; a second lock is refused.
+            c.x[1] = heap + 0x20000;
+            c.x[2] = 0x10000;
+            c.x[3] = 0;
+            return 0x15;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            assert(mem.Query(heap + 0x20000).attribute == MemAttr::Locked);
+            c.x[0] = c.x[1];
+            return 0x16; // CloseHandle: unlocked
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0 && mem.Query(heap + 0x20000).attribute == 0);
+            // A thread that sleeps a minute: shutdown must end it.
+            c.x[1] = sleeper_entry;
+            c.x[3] = Layout().stack_start + 0x2000'0000;
+            c.x[4] = 50;
+            c.x[5] = 1;
+            return 0x08;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            child_handle = c.x[1];
+            // Created for core 1, moved to core 2 before it starts (as the game does with its workers).
+            c.x[0] = c.x[1];
+            c.x[1] = static_cast<uint64_t>(-1);
+            c.x[2] = 0b100;
+            return 0x0F;
+        },
+        [&](ThreadContext& c) {
+            assert(c.x[0] == 0);
+            c.x[0] = child_handle.load();
+            return 0x09;
+        },
+        [&](ThreadContext& c) {
+            shm_result = static_cast<uint32_t>(c.x[0]);
+            return 0x0A; // ExitThread
+        },
+    };
+
+    assert(kernel.StartMain() == 0);
+    while (!kernel.MainThread()->ended) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(child_ran == 1 && child_id != self_id && child_id >= 0x60);
+    assert(wait_result == 0 && wait_index == 0);
+    assert(query_state == MemState::Stack);
+    assert(info_total == 0xcd50'0000);
+    assert(main_core == 0 && moved_core == 2);
+    assert(shm_result == 0);
+    std::printf("threads: create, start, ids, address wait + signal, wait for a thread's end, core moves\n");
+    std::printf("memory calls: heap, alias stack, query into guest memory, transfer lock + close\n");
+
+    // The sleeper is still asleep; shutdown ends it at once.
+    while (sleeper_core == 9) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(sleeper_core == 2);
+    std::printf("core mask set before the start: the thread starts on that core\n");
+    assert(kernel.LiveThreads() == 1);
+    const auto t0 = std::chrono::steady_clock::now();
+    kernel.Shutdown();
+    assert(std::chrono::steady_clock::now() - t0 < std::chrono::seconds(5));
+    assert(kernel.LiveThreads() == 0);
+    std::printf("shutdown: a sleeping thread ends at once\n");
+    std::printf("game_kernel: all tests passed\n");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_native_fs.cpp b/src/kart_runtime/tests/test_native_fs.cpp
new file mode 100644
index 0000000000..adf06efe2d
--- /dev/null
+++ b/src/kart_runtime/tests/test_native_fs.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tests for kart_runtime/native_fs.h: nn::fs rules (paths, handles, results, directory entries) over an in-memory tree.
+#include "../native_fs.h"
+
+#include <cassert>
+#include <cstdio>
+
+using KartRuntime::NativeFs;
+
+namespace {
+
+class FakeTree : public NativeFs::Tree {
+public:
+    std::map<std::string, std::string> files{{"Course/a.bin", "0123456789"}, {"Course/b.bin", "xy"}, {"top.txt", "hello"}};
+    std::vector<std::string> dirs{"", "Course", "Course/Empty"};
+    std::map<int64_t, std::string> open;
+    int64_t next = 0;
+
+    int64_t OpenFile(const std::string& p) override {
+        const auto it = files.find(p);
+        if (it == files.end()) return -1;
+        open[next] = p;
+        return next++;
+    }
+    void CloseFile(int64_t id) override { open.erase(id); }
+    uint64_t FileSize(int64_t id) override { return files[open.at(id)].size(); }
+    uint64_t ReadFile(int64_t id, uint64_t off, void* out, uint64_t size) override {
+        const std::string& d = files[open.at(id)];
+        const uint64_t n = std::min<uint64_t>(size, d.size() - off);
+        std::memcpy(out, d.data() + off, n);
+        return n;
+    }
+    bool IsDirectory(const std::string& p) override { return std::find(dirs.begin(), dirs.end(), p) != dirs.end(); }
+    bool List(const std::string& p, std::vector<Entry>& out) override {
+        if (!IsDirectory(p)) return false;
+        const std::string prefix = p.empty() ? "" : p + "/";
+        for (const auto& d : dirs)
+            if (!d.empty() && d.starts_with(prefix) && d.find('/', prefix.size()) == std::string::npos && d != p)
+                out.push_back({d.substr(prefix.size()), true, 0});
+        for (const auto& [f, data] : files)
+            if (f.starts_with(prefix) && f.find('/', prefix.size()) == std::string::npos)
+                out.push_back({f.substr(prefix.size()), false, data.size()});
+        return true;
+    }
+};
+
+} // namespace
+
+int main() {
+    NativeFs fs;
+    auto tree = std::make_shared<FakeTree>();
+    fs.Mount("rom", tree);
+
+    std::string mount, rel;
+    assert(NativeFs::Split("rom:/a//b/./c/../d", &mount, &rel) && mount == "rom" && rel == "a/b/d");
+    assert(NativeFs::Split("rom:/", &mount, &rel) && rel.empty());
+    assert(!NativeFs::Split("/no/mount", &mount, &rel));
+    assert(fs.Handles("rom:/top.txt") && !fs.Handles("save:/x") && !fs.Handles("plain"));
+
+    uint64_t h = 0;
+    assert(fs.OpenFile("rom:/Course/a.bin", 1, &h) == NativeFs::ResultSuccess && NativeFs::IsOurs(h));
+    assert(!NativeFs::IsOurs(0x0000'0080'1234'5678ull));
+    int64_t size = 0;
+    assert(fs.GetFileSize(h, &size) == 0 && size == 10);
+    char buf[16]{};
+    uint64_t read = 0;
+    assert(fs.ReadFile(h, 4, buf, 16, &read) == 0 && read == 6 && std::memcmp(buf, "456789", 6) == 0);
+    assert(fs.ReadFile(h, 10, buf, 4, &read) == 0 && read == 0);                 // at the end: nothing, no error
+    assert(fs.ReadFile(h, 11, buf, 4, &read) == NativeFs::ResultOutOfRange);    // past the end
+    assert(fs.ReadFileExact(h, 8, buf, 2) == 0 && buf[0] == '8');
+    assert(fs.ReadFileExact(h, 8, buf, 3) == NativeFs::ResultOutOfRange);
+    fs.CloseFile(h);
+    assert(tree->open.empty());
+
+    assert(fs.OpenFile("rom:/Course/missing.bin", 1, &h) == NativeFs::ResultPathNotFound);
+    assert(fs.OpenFile("rom:/Course", 1, &h) == NativeFs::ResultPathNotFound); // a directory
+    assert(fs.OpenFile("rom:/top.txt", 3, &h) == NativeFs::ResultUnsupportedOperation);
+
+    int type = -1;
+    assert(fs.GetEntryType("rom:/Course", &type) == 0 && type == 0);
+    assert(fs.GetEntryType("rom:/Course/b.bin", &type) == 0 && type == 1);
+    assert(fs.GetEntryType("rom:/nothing", &type) == NativeFs::ResultPathNotFound);
+    assert(tree->open.empty());
+
+    uint64_t d = 0;
+    assert(fs.OpenDirectory("rom:/Course", 3, &d) == 0 && NativeFs::IsOurs(d));
+    std::vector<uint8_t> entries(NativeFs::EntrySize * 2);
+    int64_t count = 0;
+    assert(fs.ReadDirectory(d, entries.data(), 2, &count) == 0 && count == 2);
+    assert(std::string(reinterpret_cast<char*>(entries.data())) == "Empty" && entries[0x304] == 0); // directories first
+    assert(std::string(reinterpret_cast<char*>(entries.data() + NativeFs::EntrySize)) == "a.bin");
+    assert(entries[NativeFs::EntrySize + 0x304] == 1);
+    int64_t esize = 0;
+    std::memcpy(&esize, entries.data() + NativeFs::EntrySize + 0x308, 8);
+    assert(esize == 10);
+    assert(fs.ReadDirectory(d, entries.data(), 2, &count) == 0 && count == 1); // b.bin
+    assert(fs.ReadDirectory(d, entries.data(), 2, &count) == 0 && count == 0);
+    fs.CloseDirectory(d);
+    assert(fs.OpenDirectory("rom:/", 2, &d) == 0); // files only
+    assert(fs.ReadDirectory(d, entries.data(), 2, &count) == 0 && count == 1);
+    assert(std::string(reinterpret_cast<char*>(entries.data())) == "top.txt");
+    fs.CloseDirectory(d);
+    assert(fs.OpenDirectory("rom:/top.txt", 3, &d) == NativeFs::ResultPathNotFound);
+    assert(fs.OpenCount() == 0);
+
+    // A file stays readable after its mount is gone (the tree is kept alive by the open file).
+    assert(fs.OpenFile("rom:/top.txt", 1, &h) == 0);
+    fs.Unmount("rom");
+    assert(fs.ReadFileExact(h, 0, buf, 5) == 0 && std::memcmp(buf, "hello", 5) == 0);
+    fs.CloseFile(h);
+    assert(!fs.Handles("rom:/top.txt"));
+    std::printf("native_fs: all tests passed\n");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_native_kernel.cpp b/src/kart_runtime/tests/test_native_kernel.cpp
new file mode 100644
index 0000000000..d10bf1aba3
--- /dev/null
+++ b/src/kart_runtime/tests/test_native_kernel.cpp
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tests for kart_runtime/hipc.h and native_kernel.h: messages laid out as the console SDK writes them (the same layout libnx's
+// cmif.h documents), sessions, domains, buffers, events and waits.
+#include "../native_kernel.h"
+
+#include <cassert>
+#include <cstdio>
+#include <thread>
+
+using namespace KartRuntime;
+
+namespace {
+
+std::vector<uint8_t> guest(0x10000);
+
+NativeKernel MakeKernel() {
+    return NativeKernel{{
+        [](uint64_t a, void* out, size_t n) {
+            if (a < 0x1000 || a + n > 0x1000 + guest.size()) return false;
+            std::memcpy(out, guest.data() + (a - 0x1000), n);
+            return true;
+        },
+        [](uint64_t a, const void* in, size_t n) {
+            if (a < 0x1000 || a + n > 0x1000 + guest.size()) return false;
+            std::memcpy(guest.data() + (a - 0x1000), in, n);
+            return true;
+        },
+        {},
+        {},
+        [] { return uint64_t{0x51}; },
+    }};
+}
+
+/// A request as the SDK builds it (libnx cmifMakeRequest layout).
+struct Builder {
+    uint32_t w[64]{};
+    size_t i = 2;
+    uint32_t type = 4;
+    std::vector<uint32_t> copies;
+    bool pid = false;
+    std::vector<std::pair<uint64_t, uint32_t>> xs, as, bs, cs;
+    std::vector<uint8_t> args;
+    bool domain = false;
+    uint32_t object = 0;
+    uint8_t domain_cmd = 1;
+    uint32_t cmd = 0;
+
+    void Build(uint8_t* msg) {
+        std::memset(w, 0, sizeof(w));
+        i = 2;
+        w[0] = type | (uint32_t(xs.size()) << 16) | (uint32_t(as.size()) << 20) | (uint32_t(bs.size()) << 24);
+        if (pid || !copies.empty()) {
+            w[1] |= 1u << 31;
+            w[i++] = (pid ? 1 : 0) | uint32_t(copies.size() << 1);
+            if (pid) i += 2;
+            for (auto h : copies) w[i++] = h;
+        }
+        for (auto [addr, size] : xs) {
+            w[i++] = (size << 16) | (uint32_t((addr >> 36) & 7) << 6) | (uint32_t((addr >> 32) & 15) << 12);
+            w[i++] = uint32_t(addr);
+        }
+        for (auto* list : {&as, &bs})
+            for (auto [addr, size] : *list) {
+                w[i++] = size;
+                w[i++] = uint32_t(addr);
+                w[i++] = (uint32_t((addr >> 36) & 7) << 2) | (uint32_t((addr >> 32) & 15) << 28);
+            }
+        const size_t raw = i;
+        size_t p = (i + 3) & ~size_t{3};
+        const size_t payload = 16 + args.size();
+        if (domain) {
+            w[p] = domain_cmd | (uint32_t(payload) << 16);
+            w[p + 1] = object;
+            p += 4;
+        }
+        w[p] = Hipc::MagicIn;
+        w[p + 2] = cmd;
+        if (!args.empty()) std::memcpy(&w[p + 4], args.data(), args.size());
+        const size_t end = p + 4 + (args.size() + 3) / 4;
+        w[1] |= uint32_t(end - raw + 4);
+        if (!cs.empty()) {
+            w[1] |= uint32_t(cs.size() == 1 ? 2 : cs.size() + 2) << 10;
+            size_t c = raw + (w[1] & 0x3FF);
+            for (auto [addr, size] : cs) {
+                w[c++] = uint32_t(addr);
+                w[c++] = uint32_t(addr >> 32) | (size << 16);
+            }
+        }
+        std::memcpy(msg, w, sizeof(w));
+    }
+};
+
+/// Reads a reply as the SDK does (libnx cmifParseResponse): result, values, handles, out objects.
+struct Parsed {
+    uint32_t result = 0;
+    std::vector<uint32_t> copies, moves, objects;
+    const uint8_t* values = nullptr;
+};
+Parsed ParseReply(const uint8_t* msg, bool domain, size_t value_size, size_t objects) {
+    uint32_t w[64];
+    std::memcpy(w, msg, sizeof(w));
+    Parsed r;
+    size_t i = 2;
+    if (w[1] >> 31) {
+        const uint32_t h = w[i++];
+        for (uint32_t k = 0; k < ((h >> 1) & 15); ++k) r.copies.push_back(w[i++]);
+        for (uint32_t k = 0; k < ((h >> 5) & 15); ++k) r.moves.push_back(w[i++]);
+    }
+    i = (i + 3) & ~size_t{3};
+    if (domain) {
+        assert(w[i] == objects);
+        i += 4;
+    }
+    assert(w[i] == Hipc::MagicOut);
+    r.result = w[i + 2];
+    r.values = msg + (i + 4) * 4;
+    for (size_t k = 0; k < objects; ++k) r.objects.push_back(w[i + 4 + (value_size + 3) / 4 + k]);
+    return r;
+}
+
+void TestMessages() {
+    NativeKernel k = MakeKernel();
+    auto svc = std::make_shared<Service>("test");
+    svc->On(7, [](Context& ctx) {
+        const auto a = ctx.Pop<uint32_t>();
+        const auto b = ctx.Pop<uint64_t>(); // 8-aligned: skips 4 bytes of padding
+        ctx.Push<uint64_t>(a + b);
+    });
+    svc->On(8, [](Context& ctx) { // echo the input buffer into the output buffer, reversed
+        auto in = ctx.ReadBuffer(0);
+        std::reverse(in.begin(), in.end());
+        ctx.Push<uint32_t>(static_cast<uint32_t>(ctx.WriteBuffer(in.data(), in.size(), 0)));
+    });
+    const uint32_t h = k.OpenSession(svc);
+    assert(NativeKernel::IsNative(h) && !NativeKernel::IsNative(0x0001'8001));
+
+    uint8_t msg[0x100];
+    Builder b;
+    b.cmd = 7;
+    b.args = {5, 0, 0, 0, 0, 0, 0, 0, 10, 0, 0, 0, 0, 0, 0, 0};
+    b.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == 0);
+    auto r = ParseReply(msg, false, 8, 0);
+    uint64_t v = 0;
+    std::memcpy(&v, r.values, 8);
+    assert(r.result == 0 && v == 15);
+
+    // X in, C out (pointer buffers), and A in, B out (mapped buffers) through the same "auto" accessors.
+    std::memcpy(guest.data() + 0x100, "abcdef", 6);
+    for (int mapped = 0; mapped < 2; ++mapped) {
+        Builder c;
+        c.cmd = 8;
+        if (mapped) {
+            c.as = {{0x1100, 6}};
+            c.bs = {{0x1200, 16}};
+        } else {
+            c.xs = {{0x1100, 6}};
+            c.cs = {{0x1200, 16}};
+        }
+        c.Build(msg);
+        assert(k.SendSyncRequest(h, msg) == 0);
+        r = ParseReply(msg, false, 4, 0);
+        uint32_t n = 0;
+        std::memcpy(&n, r.values, 4);
+        assert(r.result == 0 && n == 6 && std::memcmp(guest.data() + 0x200, "fedcba", 6) == 0);
+        std::memset(guest.data() + 0x200, 0, 6);
+    }
+
+    // Values sit at their natural alignment.
+    svc->On(10, [](Context& ctx) {
+        ctx.Push<uint8_t>(1);
+        ctx.Push<uint32_t>(6);
+    });
+    Builder ab;
+    ab.cmd = 10;
+    ab.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == 0);
+    r = ParseReply(msg, false, 8, 0);
+    assert(r.values[0] == 1 && r.values[4] == 6);
+
+    // The process id is the kernel's, whatever the message holds.
+    svc->On(9, [](Context& ctx) { ctx.Push<uint64_t>(ctx.Pid()); });
+    Builder pb;
+    pb.cmd = 9;
+    pb.pid = true;
+    pb.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == 0);
+    r = ParseReply(msg, false, 8, 0);
+    std::memcpy(&v, r.values, 8);
+    assert(v == 0x51);
+
+    b.cmd = 99;
+    b.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == 0);
+    assert(ParseReply(msg, false, 0, 0).result == CmifResult::UnknownCommand);
+    assert(svc->unknown == 1);
+    std::printf("messages: arguments, pointer and mapped buffers, unknown commands\n");
+}
+
+void TestDomains() {
+    NativeKernel k = MakeKernel();
+    auto root = std::make_shared<Service>("root");
+    auto child_calls = std::make_shared<int>(0);
+    root->On(0, [child_calls](Context& ctx) {
+        auto child = std::make_shared<Service>("child");
+        child->On(1, [child_calls](Context& c) {
+            ++*child_calls;
+            c.Push<uint32_t>(0xC0FFEE);
+        });
+        ctx.PushInterface(child);
+    });
+    const uint32_t h = k.OpenSession(root);
+    uint8_t msg[0x100];
+
+    // Plain session: the interface comes back as a move handle to a new session.
+    Builder b;
+    b.cmd = 0;
+    b.Build(msg);
+    k.SendSyncRequest(h, msg);
+    auto r = ParseReply(msg, false, 0, 0);
+    assert(r.result == 0 && r.moves.size() == 1 && NativeKernel::IsNative(r.moves[0]));
+    Builder c;
+    c.cmd = 1;
+    c.Build(msg);
+    k.SendSyncRequest(r.moves[0], msg);
+    r = ParseReply(msg, false, 4, 0);
+    assert(r.result == 0 && *child_calls == 1);
+
+    // Control: convert to domain, query pointer buffer size.
+    Builder ctl;
+    ctl.type = 5;
+    ctl.cmd = 0;
+    ctl.Build(msg);
+    k.SendSyncRequest(h, msg);
+    r = ParseReply(msg, false, 4, 0);
+    uint32_t root_id = 0;
+    std::memcpy(&root_id, r.values, 4);
+    assert(r.result == 0 && root_id == 1);
+    ctl.cmd = 3;
+    ctl.Build(msg);
+    k.SendSyncRequest(h, msg);
+    assert(ParseReply(msg, false, 2, 0).result == 0);
+
+    // Domain: the interface comes back as an object id after the values.
+    Builder d;
+    d.domain = true;
+    d.object = root_id;
+    d.cmd = 0;
+    d.Build(msg);
+    k.SendSyncRequest(h, msg);
+    r = ParseReply(msg, true, 0, 1);
+    assert(r.result == 0 && r.objects.size() == 1 && r.objects[0] == 2 && r.moves.empty());
+    d.object = r.objects[0];
+    d.cmd = 1;
+    d.Build(msg);
+    k.SendSyncRequest(h, msg);
+    r = ParseReply(msg, true, 4, 0);
+    uint32_t v = 0;
+    std::memcpy(&v, r.values, 4);
+    assert(r.result == 0 && v == 0xC0FFEE && *child_calls == 2);
+    // Close the object; a request to it then fails.
+    d.domain_cmd = 2;
+    d.Build(msg);
+    k.SendSyncRequest(h, msg);
+    d.domain_cmd = 1;
+    d.Build(msg);
+    k.SendSyncRequest(h, msg);
+    assert(ParseReply(msg, true, 0, 0).result == CmifResult::InvalidObject);
+
+    // Close message on the session: the service side goes, the handle stays until CloseHandle.
+    const size_t before = k.HandleCount();
+    Builder close;
+    close.type = 2;
+    close.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == 0);
+    assert(k.HandleCount() == before && k.Get(h));
+    d.Build(msg);
+    assert(k.SendSyncRequest(h, msg) == KernelResult::SessionClosed);
+    assert(k.Close(h) && k.HandleCount() == before - 1 && !k.Get(h));
+    std::printf("domains: sessions, object ids, control messages, close\n");
+}
+
+void TestEvents() {
+    NativeKernel k = MakeKernel();
+    auto e1 = std::make_shared<Event>(k, "a"), e2 = std::make_shared<Event>(k, "b");
+    int32_t index = -1;
+    assert(k.WaitAny(1, {e1, e2}, 0, &index) == KernelResult::TimedOut);
+    e2->Signal();
+    assert(k.WaitAny(1, {e1, e2}, -1, &index) == 0 && index == 1);
+    assert(k.WaitAny(1, {e1, e2}, -1, &index) == 0 && index == 1); // stays signalled until cleared
+    e2->Clear();
+    // A signal from another thread wakes the waiter.
+    std::thread t{[&] {
+        while (k.Waiting() == 0) std::this_thread::yield();
+        e1->Signal();
+    }};
+    assert(k.WaitAny(1, {e1, e2}, -1, &index) == 0 && index == 0);
+    t.join();
+    e1->Clear();
+    // Timeout.
+    const auto t0 = std::chrono::steady_clock::now();
+    assert(k.WaitAny(1, {e1}, 10'000'000, &index) == KernelResult::TimedOut);
+    assert(std::chrono::steady_clock::now() - t0 >= std::chrono::milliseconds(9));
+    // Cancel: during the wait, and before it (the next wait ends at once).
+    uint32_t got = 0;
+    std::thread w{[&] { got = k.WaitAny(5, {e1}, -1, &index); }};
+    while (k.Waiting() == 0) std::this_thread::yield();
+    k.CancelWait(5);
+    w.join();
+    assert(got == KernelResult::Cancelled);
+    k.CancelWait(6);
+    assert(k.WaitAny(6, {e1}, -1, &index) == KernelResult::Cancelled);
+    assert(k.WaitAny(6, {e1}, 0, &index) == KernelResult::TimedOut);
+    k.Terminate(7);
+    assert(k.WaitAny(7, {e1}, -1, &index) == KernelResult::Cancelled);
+    // Handles for events.
+    const uint32_t h = k.Add(e1);
+    assert(k.GetAs<Event>(h) == e1 && !k.GetAs<Session>(h));
+    assert(k.Close(h) && !k.Close(h));
+    assert(k.Waiting() == 0);
+    std::printf("events: signal, clear, wait any, timeout, cancel, terminate\n");
+}
+
+} // namespace
+
+int main() {
+    TestMessages();
+    TestDomains();
+    TestEvents();
+    std::printf("native_kernel: all tests passed\n");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_sync_arbiter.cpp b/src/kart_runtime/tests/test_sync_arbiter.cpp
new file mode 100644
index 0000000000..0ee9d49577
--- /dev/null
+++ b/src/kart_runtime/tests/test_sync_arbiter.cpp
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Tests for kart_runtime/sync_arbiter.h: the console's lock / condition variable / address-wait protocol (as the SDK's user-mode
+// side drives it) on many host threads.
+#include "../sync_arbiter.h"
+
+#include <cassert>
+#include <cstdio>
+#include <thread>
+#include <vector>
+
+using KartRuntime::SyncArbiter;
+
+namespace {
+
+uint32_t memory[64];
+std::atomic<int> blocks{0}, unblocks{0};
+
+SyncArbiter MakeArbiter() {
+    return SyncArbiter{{
+        [](uint64_t a) -> uint32_t* { return a >= 0x1000 && a < 0x1000 + sizeof(memory) ? &memory[(a - 0x1000) / 4] : nullptr; },
+        [] { blocks++; },
+        [] { unblocks++; },
+    }};
+}
+
+uint32_t* Word(uint64_t a) { return &memory[(a - 0x1000) / 4]; }
+
+// The SDK's mutex (nn::os::SdkMutex / InternalCriticalSection): fast path in user mode, system calls when contended.
+void Lock(SyncArbiter& arb, uint64_t addr, uint32_t tag, int prio) {
+    uint32_t* w = Word(addr);
+    for (;;) {
+        uint32_t cur = 0;
+        if (__atomic_compare_exchange_n(w, &cur, tag, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+        if ((cur & ~SyncArbiter::HandleWaitMask) == tag) return; // owned (handed over)
+        const uint32_t marked = cur | SyncArbiter::HandleWaitMask;
+        if (cur != marked && !__atomic_compare_exchange_n(w, &cur, marked, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) continue;
+        arb.LockWait(tag, addr, marked & ~SyncArbiter::HandleWaitMask, tag, prio);
+        if ((__atomic_load_n(w, __ATOMIC_ACQUIRE) & ~SyncArbiter::HandleWaitMask) == tag) return;
+    }
+}
+
+void Unlock(SyncArbiter& arb, uint64_t addr, uint32_t tag) {
+    uint32_t* w = Word(addr);
+    uint32_t cur = tag;
+    if (__atomic_compare_exchange_n(w, &cur, 0, false, __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return;
+    arb.Unlock(addr);
+}
+
+void TestMutex() {
+    auto arb = MakeArbiter();
+    constexpr uint64_t lock = 0x1000;
+    long counter = 0;
+    std::vector<std::thread> ts;
+    for (int t = 0; t < 12; ++t) {
+        ts.emplace_back([&, t] {
+            const uint32_t tag = 0x100 + t;
+            for (int i = 0; i < 20000; ++i) {
+                Lock(arb, lock, tag, 44 + (t % 3));
+                const long c = counter;
+                if ((i & 63) == 0) std::this_thread::yield();
+                counter = c + 1;
+                Unlock(arb, lock, tag);
+            }
+        });
+    }
+    for (auto& t : ts) t.join();
+    assert(counter == 12 * 20000);
+    assert(*Word(lock) == 0);
+    assert(arb.Waiting() == 0);
+    std::printf("mutex: %ld increments, %d blocking waits\n", counter, blocks.load());
+}
+
+void TestConditionVariable() {
+    auto arb = MakeArbiter();
+    constexpr uint64_t lock = 0x1010, key = 0x1014;
+    int queue = 0, produced = 0, consumed = 0;
+    constexpr int kItems = 20000;
+    std::vector<std::thread> ts;
+    for (int c = 0; c < 4; ++c) {
+        ts.emplace_back([&, c] {
+            const uint32_t tag = 0x200 + c;
+            for (;;) {
+                Lock(arb, lock, tag, 44);
+                while (queue == 0 && consumed < kItems) {
+                    arb.ConditionWait(tag, lock, key, tag, 44, -1);
+                    Lock(arb, lock, tag, 44); // owned already when woken with the lock; else take it
+                }
+                if (consumed >= kItems) {
+                    Unlock(arb, lock, tag);
+                    arb.ConditionSignal(key, -1);
+                    return;
+                }
+                --queue;
+                __atomic_store_n(&consumed, consumed + 1, __ATOMIC_RELEASE);
+                Unlock(arb, lock, tag);
+            }
+        });
+    }
+    for (int p = 0; p < 2; ++p) {
+        ts.emplace_back([&, p] {
+            const uint32_t tag = 0x300 + p;
+            for (;;) {
+                Lock(arb, lock, tag, 44);
+                if (produced >= kItems) {
+                    Unlock(arb, lock, tag);
+                    return;
+                }
+                ++queue;
+                ++produced;
+                const bool signal = __atomic_load_n(Word(key), __ATOMIC_ACQUIRE) != 0;
+                Unlock(arb, lock, tag);
+                if (signal) arb.ConditionSignal(key, 1);
+            }
+        });
+    }
+    // Wake everyone at the end.
+    for (int i = 0; i < 200 && __atomic_load_n(&consumed, __ATOMIC_ACQUIRE) < kItems; ++i) std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    arb.ConditionSignal(key, -1);
+    for (auto& t : ts) t.join();
+    assert(consumed == kItems && produced == kItems && queue == 0);
+    assert(arb.Waiting() == 0);
+    std::printf("condition variable: %d items through 2 producers / 4 consumers\n", consumed);
+
+    // Timeout: nobody signals.
+    const auto t0 = std::chrono::steady_clock::now();
+    Lock(arb, lock, 0x400, 44);
+    const auto r = arb.ConditionWait(0x400, lock, key, 0x400, 44, 20'000'000);
+    assert(r == SyncArbiter::Result::TimedOut);
+    assert(std::chrono::steady_clock::now() - t0 >= std::chrono::milliseconds(19));
+    assert(*Word(lock) == 0); // released by the wait
+    assert(arb.Waiting() == 0);
+    assert(arb.ConditionWait(0x400, lock, key, 0x400, 44, 0) == SyncArbiter::Result::TimedOut);
+}
+
+void TestPriorityOrder() {
+    auto arb = MakeArbiter();
+    constexpr uint64_t addr = 0x1020;
+    *Word(addr) = 0;
+    std::vector<int> order;
+    std::mutex order_lock;
+    std::vector<std::thread> ts;
+    const int prios[] = {50, 30, 40, 30, 20};
+    for (int i = 0; i < 5; ++i) {
+        ts.emplace_back([&, i] {
+            assert(arb.AddressWait(7, addr, SyncArbiter::WaitType::Equal, 0, prios[i], -1) == SyncArbiter::Result::Success);
+            std::scoped_lock lk{order_lock};
+            order.push_back(prios[i]);
+        });
+        while (arb.Waiting() < static_cast<size_t>(i + 1)) std::this_thread::yield();
+    }
+    for (int i = 0; i < 5; ++i) {
+        arb.AddressSignal(addr, SyncArbiter::SignalType::Signal, 0, 1);
+        while (true) {
+            std::scoped_lock lk{order_lock};
+            if (order.size() == static_cast<size_t>(i + 1)) break;
+        }
+    }
+    for (auto& t : ts) t.join();
+    const std::vector<int> expect{20, 30, 30, 40, 50};
+    assert(order == expect);
+    std::printf("address arbiter: woken best priority first\n");
+}
+
+void TestArbiterRules() {
+    auto arb = MakeArbiter();
+    constexpr uint64_t a = 0x1030;
+    using R = SyncArbiter::Result;
+    *Word(a) = 5;
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::Equal, 4, 44, -1) == R::InvalidState);
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::LessThan, 5, 44, -1) == R::InvalidState);
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::LessThan, 6, 44, 0) == R::TimedOut);
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::DecrementAndLessThan, 6, 44, 0) == R::TimedOut);
+    assert(*Word(a) == 4);
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::DecrementAndLessThan, 4, 44, 0) == R::InvalidState);
+    assert(*Word(a) == 4);
+    assert(arb.AddressSignal(a, SyncArbiter::SignalType::IncrementIfEqual, 3, 1) == R::InvalidState);
+    assert(arb.AddressSignal(a, SyncArbiter::SignalType::IncrementIfEqual, 4, 1) == R::Success);
+    assert(*Word(a) == 5);
+    // Modify by waiting count: nobody waiting -> value + 1.
+    assert(arb.AddressSignal(a, SyncArbiter::SignalType::ModifyByWaitingCountIfEqual, 5, 1) == R::Success);
+    assert(*Word(a) == 6);
+    // Two waiting, wake one -> one other left, not fewer than count (1) -> value unchanged; wake all -> value - 2.
+    std::vector<std::thread> ts;
+    for (int i = 0; i < 2; ++i) ts.emplace_back([&] { arb.AddressWait(7, a, SyncArbiter::WaitType::Equal, 6, 44, -1); });
+    while (arb.Waiting() < 2) std::this_thread::yield();
+    assert(arb.AddressSignal(a, SyncArbiter::SignalType::ModifyByWaitingCountIfEqual, 6, 1) == R::Success);
+    assert(*Word(a) == 6);
+    while (arb.Waiting() != 1) std::this_thread::yield();
+    assert(arb.AddressSignal(a, SyncArbiter::SignalType::ModifyByWaitingCountIfEqual, 6, 1) == R::Success);
+    assert(*Word(a) == 5); // the last waiter: no others -> value - 1
+    for (auto& t : ts) t.join();
+    // Timed wait expires and leaves no waiter behind.
+    assert(arb.AddressWait(7, a, SyncArbiter::WaitType::Equal, 5, 44, 5'000'000) == R::TimedOut);
+    assert(arb.Waiting() == 0);
+    assert(arb.AddressWait(7, 0x9000, SyncArbiter::WaitType::Equal, 0, 44, -1) == R::InvalidCurrentMemory);
+    std::printf("address arbiter: kernel rules for every wait and signal type\n");
+}
+
+void TestCancel() {
+    auto arb = MakeArbiter();
+    constexpr uint64_t a = 0x1040;
+    *Word(a) = 0;
+    using R = SyncArbiter::Result;
+    R got = R::Success;
+    std::thread t{[&] { got = arb.AddressWait(42, a, SyncArbiter::WaitType::Equal, 0, 44, -1); }};
+    while (arb.Waiting() < 1) std::this_thread::yield();
+    arb.Cancel(42);
+    t.join();
+    assert(got == R::Cancelled && arb.Waiting() == 0);
+    assert(arb.AddressWait(42, a, SyncArbiter::WaitType::Equal, 0, 44, -1) == R::Cancelled); // later waits end at once
+    const auto t0 = std::chrono::steady_clock::now();
+    assert(arb.Sleep(5, 10'000'000) == R::Success);
+    assert(std::chrono::steady_clock::now() - t0 >= std::chrono::milliseconds(9));
+    std::thread s{[&] { got = arb.Sleep(43, 10'000'000'000); }};
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    arb.Cancel(43);
+    s.join();
+    assert(got == R::Cancelled && arb.Waiting() == 0);
+    std::printf("cancel: a terminating thread's wait or sleep ends\n");
+}
+
+} // namespace
+
+int main() {
+    TestMutex();
+    TestConditionVariable();
+    TestPriorityOrder();
+    TestArbiterRules();
+    TestCancel();
+    assert(blocks.load() == unblocks.load());
+    std::printf("sync_arbiter: all tests passed (%d blocks)\n", blocks.load());
+    return 0;
+}
