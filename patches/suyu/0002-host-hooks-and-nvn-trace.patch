+        s.copy_row_stride[ctx.x[0]] = ctx.x[1];
+    };
+    h["nvnCommandBufferSetCopyImageStride"] = [](HookContext& ctx, State& s) {
+        s.copy_image_stride[ctx.x[0]] = ctx.x[1];
+    };
+    // (cmdbuf, source buffer address, texture, view, NVNcopyRegion, flags). The
+    // game streams its menu movies this way: a Y and a UV plane every frame.
+    h["nvnCommandBufferCopyBufferToTexture"] = [](HookContext& ctx, State& s) {
+        const TextureDesc dst = ResolveTexture(ctx, s, ctx.x[2]);
+        s32 region[6]{};
+        Mem(ctx).ReadBlock(ctx.x[4], region, sizeof(region));
+        u32 level = 0, layer = 0;
+        if (ctx.x[3]) {
+            u32 view_words[8]{};
+            Mem(ctx).ReadBlock(ctx.x[3], view_words, sizeof(view_words));
+            if (view_words[0] & 1) level = (view_words[0] >> 8) & 0xFF;
+            if (view_words[0] & 2) layer = view_words[1] & 0xFFFF;
+            KartRe::Log("copy-b2t view words {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x}",
+                        view_words[0], view_words[1], view_words[2], view_words[3], view_words[4],
+                        view_words[5], view_words[6], view_words[7]);
+        }
+        if (dst.valid && region[3] > 0 && region[4] > 0) {
+            Command c{.op = Op::CopyBufferToTexture};
+            c.address = ctx.x[1];
+            c.colors.push_back(dst);
