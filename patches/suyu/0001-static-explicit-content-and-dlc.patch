+/// Sampled-texture formats: suyu's PixelFormat (decoded from the TIC) -> Vulkan.
+VkFormat MapPixelFormat(VideoCore::Surface::PixelFormat f) {
+    using P = VideoCore::Surface::PixelFormat;
+    switch (f) {
+    case P::A8B8G8R8_UNORM: return VK_FORMAT_A8B8G8R8_UNORM_PACK32;
+    case P::A8B8G8R8_SNORM: return VK_FORMAT_A8B8G8R8_SNORM_PACK32;
+    case P::A8B8G8R8_SRGB: return VK_FORMAT_A8B8G8R8_SRGB_PACK32;
+    case P::A8B8G8R8_UINT: return VK_FORMAT_A8B8G8R8_UINT_PACK32;
+    case P::B8G8R8A8_UNORM: return VK_FORMAT_B8G8R8A8_UNORM;
+    case P::B8G8R8A8_SRGB: return VK_FORMAT_B8G8R8A8_SRGB;
+    // 16-bit formats as suyu stores them on hosts without B5G6R5/A4B4G4R4 sampling:
+    // the swaps are applied in the view swizzle (FixSwizzle).
+    case P::R5G6B5_UNORM: return VK_FORMAT_R5G6B5_UNORM_PACK16;
+    case P::B5G6R5_UNORM: return VK_FORMAT_R5G6B5_UNORM_PACK16;
+    case P::A1R5G5B5_UNORM: return VK_FORMAT_A1R5G5B5_UNORM_PACK16;
+    case P::A4B4G4R4_UNORM: return VK_FORMAT_R4G4B4A4_UNORM_PACK16;
+    case P::A2B10G10R10_UNORM: return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+    case P::B10G11R11_FLOAT: return VK_FORMAT_B10G11R11_UFLOAT_PACK32;
+    case P::R8_UNORM: return VK_FORMAT_R8_UNORM;
+    case P::R8_SNORM: return VK_FORMAT_R8_SNORM;
+    case P::R8_UINT: return VK_FORMAT_R8_UINT;
+    case P::R8G8_UNORM: return VK_FORMAT_R8G8_UNORM;
+    case P::R8G8_SNORM: return VK_FORMAT_R8G8_SNORM;
+    case P::R16_FLOAT: return VK_FORMAT_R16_SFLOAT;
+    case P::R16_UNORM: return VK_FORMAT_R16_UNORM;
+    case P::R16G16_FLOAT: return VK_FORMAT_R16G16_SFLOAT;
+    case P::R16G16_UNORM: return VK_FORMAT_R16G16_UNORM;
+    case P::R16G16B16A16_FLOAT: return VK_FORMAT_R16G16B16A16_SFLOAT;
+    case P::R16G16B16A16_UNORM: return VK_FORMAT_R16G16B16A16_UNORM;
+    case P::R32_FLOAT: return VK_FORMAT_R32_SFLOAT;
+    case P::R32_UINT: return VK_FORMAT_R32_UINT;
+    case P::R32G32_FLOAT: return VK_FORMAT_R32G32_SFLOAT;
+    case P::R32G32B32A32_FLOAT: return VK_FORMAT_R32G32B32A32_SFLOAT;
+    case P::BC1_RGBA_UNORM: return VK_FORMAT_BC1_RGBA_UNORM_BLOCK;
+    case P::BC1_RGBA_SRGB: return VK_FORMAT_BC1_RGBA_SRGB_BLOCK;
+    case P::BC2_UNORM: return VK_FORMAT_BC2_UNORM_BLOCK;
+    case P::BC2_SRGB: return VK_FORMAT_BC2_SRGB_BLOCK;
+    case P::BC3_UNORM: return VK_FORMAT_BC3_UNORM_BLOCK;
+    case P::BC3_SRGB: return VK_FORMAT_BC3_SRGB_BLOCK;
+    case P::BC4_UNORM: return VK_FORMAT_BC4_UNORM_BLOCK;
+    case P::BC4_SNORM: return VK_FORMAT_BC4_SNORM_BLOCK;
+    case P::BC5_UNORM: return VK_FORMAT_BC5_UNORM_BLOCK;
+    case P::BC5_SNORM: return VK_FORMAT_BC5_SNORM_BLOCK;
+    case P::BC6H_UFLOAT: return VK_FORMAT_BC6H_UFLOAT_BLOCK;
+    case P::BC6H_SFLOAT: return VK_FORMAT_BC6H_SFLOAT_BLOCK;
+    case P::BC7_UNORM: return VK_FORMAT_BC7_UNORM_BLOCK;
+    case P::BC7_SRGB: return VK_FORMAT_BC7_SRGB_BLOCK;
+    case P::D32_FLOAT: return VK_FORMAT_D32_SFLOAT;
+    case P::D16_UNORM: return VK_FORMAT_D16_UNORM;
+    default:
+        // ASTC is decoded to RGBA8 on the CPU at upload (see DecodeTexture).
+        if (VideoCore::Surface::IsPixelFormatASTC(f)) {
+            return VideoCore::Surface::IsPixelFormatSRGB(f) ? VK_FORMAT_R8G8B8A8_SRGB
+                                                            : VK_FORMAT_R8G8B8A8_UNORM;
+        }
+        return VK_FORMAT_UNDEFINED;
+    }
+}
