+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the engine side of the runtime's file system service (kart_runtime/services/filesystem.h): save data folders and
+// system archives through suyu's file-system library (save data factory, NCA/RomFS readers, synthesized archives), the same
+// objects the emulated "fsp-srv" used.
+#include <cstring>
+#include <memory>
+
+#include "common/logging/log.h"
+#include "core/core.h"
+#include "core/file_sys/fs_directory.h"
+#include "core/file_sys/fsa/fs_i_directory.h"
+#include "core/file_sys/fsa/fs_i_file.h"
+#include "core/file_sys/fsa/fs_i_filesystem.h"
+#include "core/file_sys/content_archive.h"
+#include "core/file_sys/patch_manager.h"
+#include "core/file_sys/romfs_factory.h"
+#include "core/file_sys/savedata_factory.h"
+#include "core/file_sys/system_archive/system_archive.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/filesystem/filesystem.h"
+#include "core/hle/service/filesystem/romfs_controller.h"
+#include "core/hle/service/filesystem/save_data_controller.h"
+#include "kart_runtime/services/filesystem.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using namespace KartRuntime::Services;
+
+class File final : public FsFile {
+public:
+    explicit File(FileSys::VirtualFile f) : impl{std::move(f)} {}
+    uint32_t Read(int64_t offset, void* out, uint64_t size, uint64_t* out_read) override {
+        size_t got = 0;
+        const Result r = impl.Read(&got, offset, out, size);
+        *out_read = got;
+        return r.raw;
+    }
+    uint32_t Write(int64_t offset, const void* in, uint64_t size, bool flush) override {
+        return impl.Write(offset, in, size, flush ? FileSys::WriteOption::Flush : FileSys::WriteOption::None).raw;
+    }
+    uint32_t Flush() override { return impl.Flush().raw; }
+    uint32_t SetSize(int64_t size) override { return impl.SetSize(size).raw; }
+    uint32_t GetSize(int64_t* out) override { return impl.GetSize(out).raw; }
+
+private:
+    FileSys::Fsa::IFile impl;
+};
+
+class Directory final : public FsDirectory {
+public:
+    Directory(FileSys::VirtualDir d, FileSys::OpenDirectoryMode mode) : impl{std::move(d), mode} {}
+    uint32_t Read(uint8_t* out, int64_t max, int64_t* out_count) override {
+        static_assert(sizeof(FileSys::DirectoryEntry) == 0x310);
+        return impl.Read(out_count, reinterpret_cast<FileSys::DirectoryEntry*>(out), max).raw;
+    }
+    uint32_t GetEntryCount(int64_t* out) override { return impl.GetEntryCount(out).raw; }
+
+private:
+    FileSys::Fsa::IDirectory impl;
+};
+
+class FileSystem final : public FsFileSystem {
+public:
+    FileSystem(Core::System& s, FileSys::VirtualDir dir, FileSys::StorageId id) : system{s}, impl{std::move(dir)}, storage{id} {}
+    uint32_t CreateFile(const std::string& p, int64_t size) override { return impl.CreateFile(FileSys::Path(p.c_str()), size).raw; }
+    uint32_t DeleteFile(const std::string& p) override { return impl.DeleteFile(FileSys::Path(p.c_str())).raw; }
+    uint32_t CreateDirectory(const std::string& p) override { return impl.CreateDirectory(FileSys::Path(p.c_str())).raw; }
+    uint32_t DeleteDirectory(const std::string& p) override { return impl.DeleteDirectory(FileSys::Path(p.c_str())).raw; }
+    uint32_t DeleteDirectoryRecursively(const std::string& p) override { return impl.DeleteDirectoryRecursively(FileSys::Path(p.c_str())).raw; }
+    uint32_t CleanDirectoryRecursively(const std::string& p) override { return impl.CleanDirectoryRecursively(FileSys::Path(p.c_str())).raw; }
+    uint32_t RenameFile(const std::string& a, const std::string& b) override { return impl.RenameFile(FileSys::Path(a.c_str()), FileSys::Path(b.c_str())).raw; }
+    uint32_t GetEntryType(const std::string& p, uint32_t* out) override {
+        FileSys::DirectoryEntryType t{};
+        const Result r = impl.GetEntryType(&t, FileSys::Path(p.c_str()));
+        *out = static_cast<uint32_t>(t);
+        return r.raw;
+    }
+    uint32_t OpenFile(const std::string& p, uint32_t mode, std::shared_ptr<FsFile>* out) override {
+        FileSys::VirtualFile f;
+        const Result r = impl.OpenFile(&f, FileSys::Path(p.c_str()), static_cast<FileSys::OpenMode>(mode));
+        if (r.IsSuccess()) *out = std::make_shared<File>(std::move(f));
+        return r.raw;
+    }
+    uint32_t OpenDirectory(const std::string& p, uint32_t mode, std::shared_ptr<FsDirectory>* out) override {
+        FileSys::VirtualDir d;
+        const Result r = impl.OpenDirectory(&d, FileSys::Path(p.c_str()), static_cast<FileSys::OpenDirectoryMode>(mode));
+        if (r.IsSuccess()) *out = std::make_shared<Directory>(std::move(d), static_cast<FileSys::OpenDirectoryMode>(mode));
+        return r.raw;
+    }
+    uint32_t Commit() override { return 0; } // writes reach the save folder directly (as the emulated service answered)
+    uint32_t GetFreeSpace(int64_t* out) override {
+        *out = static_cast<int64_t>(system.GetFileSystemController().GetFreeSpaceSize(storage));
+        return 0;
+    }
+    uint32_t GetTotalSpace(int64_t* out) override {
+        *out = static_cast<int64_t>(system.GetFileSystemController().GetTotalSpaceSize(storage));
+        return 0;
+    }
+    uint32_t GetFileTimeStampRaw(const std::string& p, std::array<uint8_t, 0x20>* out) override {
+        FileSys::FileTimeStampRaw t{};
+        const Result r = impl.GetFileTimeStampRaw(&t, FileSys::Path(p.c_str()));
+        static_assert(sizeof(t) == 0x20);
+        std::memcpy(out->data(), &t, sizeof(t));
+        return r.raw;
+    }
+
+private:
+    Core::System& system;
+    FileSys::Fsa::IFileSystem impl;
+    FileSys::StorageId storage;
+};
+
+class Storage final : public FsStorage {
+public:
+    explicit Storage(FileSys::VirtualFile f) : file{std::move(f)} {}
+    uint32_t Read(int64_t offset, void* out, uint64_t size) override {
+        // Reads what is there (the rest of the window stays zero), as the file system service does: the SDK reads whole blocks
+        // past the end of an archive.
+        std::memset(out, 0, size);
+        if (size) file->Read(static_cast<u8*>(out), size, static_cast<size_t>(offset));
+        return 0;
+    }
+    uint32_t GetSize(int64_t* out) override {
+        *out = static_cast<int64_t>(file->GetSize());
+        return 0;
+    }
+
+private:
+    FileSys::VirtualFile file;
+};
+
+class Backend final : public FsBackend {
+public:
+    explicit Backend(Core::System& s) : system{s} {}
+
+    uint32_t SetProcess(uint64_t pid) override {
+        return system.GetFileSystemController().OpenProcess(&program_id, &save_data, &romfs, pid).raw;
+    }
+    uint32_t OpenSaveData(uint8_t space, const std::array<uint8_t, 0x40>& attribute, std::shared_ptr<FsFileSystem>* out) override {
+        if (!save_data) return ::ResultUnknown.raw;
+        FileSys::SaveDataAttribute attr{};
+        static_assert(sizeof(attr) == 0x40);
+        std::memcpy(&attr, attribute.data(), sizeof(attr));
+        FileSys::VirtualDir dir;
+        const auto space_id = static_cast<FileSys::SaveDataSpaceId>(space);
+        if (const Result r = save_data->OpenSaveData(&dir, space_id, attr); r.IsError()) return r.raw;
+        FileSys::StorageId id = FileSys::StorageId::NandUser;
+        if (space_id == FileSys::SaveDataSpaceId::SdSystem || space_id == FileSys::SaveDataSpaceId::SdUser) id = FileSys::StorageId::SdCard;
+        else if (space_id == FileSys::SaveDataSpaceId::System || space_id == FileSys::SaveDataSpaceId::ProperSystem ||
+                 space_id == FileSys::SaveDataSpaceId::SafeMode)
+            id = FileSys::StorageId::NandSystem;
+        *out = std::make_shared<FileSystem>(system, std::move(dir), id);
+        return 0;
+    }
+    uint32_t OpenDataStorage(uint8_t storage_id, uint64_t data_id, std::shared_ptr<FsStorage>* out) override {
+        if (!romfs) return ::ResultUnknown.raw;
+        const auto sid = static_cast<FileSys::StorageId>(storage_id);
+        auto data = romfs->OpenRomFS(data_id, sid, FileSys::ContentRecordType::Data);
+        if (!data) {
+            // No such archive among the player's files: the engine's stand-in, if it has one (fonts, Mii data).
+            if (auto archive = FileSys::SystemArchive::SynthesizeSystemArchive(data_id)) {
+                *out = std::make_shared<Storage>(std::move(archive));
+                return 0;
+            }
+            LOG_ERROR(Service_FS, "native services: no data storage {:016X} (storage {:02X})", data_id, storage_id);
+            return ::ResultUnknown.raw;
+        }
+        const FileSys::PatchManager pm{data_id, system.GetFileSystemController(), system.GetContentProvider()};
+        auto base = romfs->OpenBaseNca(data_id, sid, FileSys::ContentRecordType::Data);
+        *out = std::make_shared<Storage>(pm.PatchRomFS(base.get(), std::move(data), FileSys::ContentRecordType::Data));
+        return 0;
+    }
+    uint32_t CreateSaveData(const std::array<uint8_t, 0x40>& attribute, const std::array<uint8_t, 0x40>&) override {
+        if (!save_data) return ::ResultUnknown.raw;
+        FileSys::SaveDataAttribute attr{};
+        std::memcpy(&attr, attribute.data(), sizeof(attr));
+        FileSys::VirtualDir dir;
+        return save_data->CreateSaveData(&dir, FileSys::SaveDataSpaceId::User, attr).raw;
+    }
+
+private:
+    Core::System& system;
+    Service::FileSystem::ProgramId program_id{};
+    std::shared_ptr<Service::FileSystem::SaveDataController> save_data;
+    std::shared_ptr<Service::FileSystem::RomFsController> romfs;
+};
+
+} // namespace
+
+std::shared_ptr<FsBackend> MakeFsBackend(Core::System& system) {
+    return std::make_shared<Backend>(system);
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_hid_service.cpp b/src/core/hle/kernel/native_hid_service.cpp
new file mode 100644
index 0000000000..87681b42c2
--- /dev/null
+++ b/src/core/hle/kernel/native_hid_service.cpp
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the controller service ("hid") answered by the runtime. The controller state - which pads and styles the game
+// supports, Joy-Con assignment, motion, rumble, and the shared memory the SDK reads - is hid_core's resource manager (the input
+// library); this replaces the service around it. The game reads its buttons and sticks through the native controller reads
+// (core/arm/recomp/native_hid.cpp); its rumble goes from here straight to the controllers.
+#include <memory>
+#include <vector>
+
+#include "common/logging/log.h"
+#include "core/core.h"
+#include "core/hle/kernel/k_handle_table.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_readable_event.h"
+#include "core/hle/kernel/k_shared_memory.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_game.h"
+#include "core/hle/kernel/native_services.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/services.h"
+#include "core/hle/service/sm/sm.h"
+#include "hid_core/hid_result.h"
+#include "hid_core/hid_types.h"
+#include "hid_core/hid_util.h"
+#include "hid_core/resource_manager.h"
+#include "hid_core/resources/npad/npad.h"
+#include "hid_core/resources/npad/npad_vibration.h"
+#include "hid_core/resources/six_axis/six_axis.h"
+#include "hid_core/resources/touch_screen/touch_screen.h"
+#include "hid_core/resources/vibration/vibration_device.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using namespace Service::HID;
+using KartRuntime::Context;
+using KartRuntime::Service;
+using Core::HID::NpadIdType;
+
+/// An emulated kernel object (shared memory, an event of the input library) handed to the game as a copy handle.
+void PushKernelObject(KernelCore& kernel, Context& c, KSharedMemory* object) {
+    if (object && NativeGame::Process()) return c.PushCopyHandle(NativeGame::AddSharedMemory(*object));
+    Handle h{};
+    if (!object || GetCurrentProcess(kernel).GetHandleTable().Add(kernel, &h, object).IsError()) return c.SetResult(0xD201);
+    c.PushCopyHandle(h);
+}
+
+/// The "applet resource user id" argument: the service takes the sender's process id from the kernel (the value in the
+/// message is skipped), as the emulated service did.
+u64 PopAruid(Context& c) {
+    c.Pop<u64>();
+    return c.Pid();
+}
+
+void Check(Context& c, Result r) {
+    if (r.IsError()) c.SetResult(r.raw);
+}
+
+std::shared_ptr<Service> AppletResource(KernelCore& kernel, std::shared_ptr<ResourceManager> rm, u64 aruid) {
+    auto s = std::make_shared<Service>("IAppletResource");
+    s->On(0, [&kernel, rm, aruid](Context& c) { // GetSharedMemoryHandle
+        Kernel::KSharedMemory* mem = nullptr;
+        if (const Result r = rm->GetSharedMemoryHandle(&mem, aruid); r.IsError()) return c.SetResult(r.raw);
+        PushKernelObject(kernel, c, mem);
+    });
+    return s;
+}
+
+std::shared_ptr<Service> VibrationDeviceList(std::shared_ptr<ResourceManager> rm) {
+    struct State {
+        std::mutex m;
+        std::vector<Core::HID::VibrationDeviceHandle> list;
+    };
+    auto st = std::make_shared<State>();
+    auto s = std::make_shared<Service>("IActiveVibrationDeviceList");
+    s->On(0, [rm, st](Context& c) { // ActivateVibrationDevice(handle)
+        const auto h = c.Pop<Core::HID::VibrationDeviceHandle>();
+        std::scoped_lock lk{st->m};
+        if (const Result r = IsVibrationHandleValid(h); r.IsError()) return c.SetResult(r.raw);
+        for (const auto& e : st->list)
+            if (e.device_index == h.device_index && e.npad_id == h.npad_id && e.npad_type == h.npad_type) return;
+        if (st->list.size() >= 0x100) return c.SetResult(ResultVibrationDeviceIndexOutOfRange.raw);
+        Check(c, rm->GetVibrationDevice(h)->Activate());
+        st->list.push_back(h);
+    });
+    return s;
+}
+
+std::shared_ptr<Service> HidServer(KernelCore& kernel, std::shared_ptr<ResourceManager> rm) {
+    auto s = std::make_shared<Service>("hid");
+    auto npad = [rm] { return rm->GetNpad(); };
+    s->On(0, [&kernel, rm](Context& c) { // CreateAppletResource(aruid)
+        const auto aruid = PopAruid(c);
+        rm->CreateAppletResource(aruid);
+        c.PushInterface(AppletResource(kernel, rm, aruid));
+    });
+    s->On(11, [rm](Context& c) { // ActivateTouchScreen(aruid)
+        const auto aruid = PopAruid(c);
+        if (const Result r = rm->GetTouchScreen()->Activate(); r.IsError()) return c.SetResult(r.raw);
+        Check(c, rm->GetTouchScreen()->Activate(aruid));
+    });
+    s->On(66, [rm](Context& c) { // StartSixAxisSensor(handle, aruid)
+        const auto h = c.Pop<Core::HID::SixAxisSensorHandle>();
+        Check(c, rm->GetSixAxis()->SetSixAxisEnabled(h, true));
+    });
+    s->On(67, [rm](Context& c) { // StopSixAxisSensor(handle, aruid)
+        const auto h = c.Pop<Core::HID::SixAxisSensorHandle>();
+        Check(c, rm->GetSixAxis()->SetSixAxisEnabled(h, false));
+    });
+    s->On(69, [rm](Context& c) { // EnableSixAxisSensorFusion(enabled, handle, aruid)
+        const bool enabled = c.Pop<u8>() != 0;
+        const auto h = c.Pop<Core::HID::SixAxisSensorHandle>();
+        Check(c, rm->GetSixAxis()->SetSixAxisFusionEnabled(h, enabled));
+    });
+    s->On(82, [rm](Context& c) { // IsSixAxisSensorAtRest(handle, aruid)
+        const auto h = c.Pop<Core::HID::SixAxisSensorHandle>();
+        bool rest = false;
+        if (const Result r = rm->GetSixAxis()->IsSixAxisSensorAtRest(h, rest); r.IsError()) return c.SetResult(r.raw);
+        c.Push<u8>(rest);
+    });
+    s->On(100, [&kernel, npad](Context& c) { // SetSupportedNpadStyleSet(style set, aruid)
+        const auto style = c.Pop<Core::HID::NpadStyleSet>();
+        const auto aruid = PopAruid(c);
+        Check(c, npad()->SetSupportedNpadStyleSet(kernel, aruid, style));
+    });
+    s->On(101, [&kernel, npad](Context& c) { // GetSupportedNpadStyleSet(aruid)
+        const auto aruid = PopAruid(c);
+        Core::HID::NpadStyleSet style{};
+        if (const Result r = npad()->GetSupportedNpadStyleSet(kernel, aruid, style); r.IsError()) return c.SetResult(r.raw);
+        c.Push(style);
+    });
+    s->On(102, [&kernel, npad](Context& c) { // SetSupportedNpadIdType(aruid, ids)
+        const auto aruid = PopAruid(c);
+        const auto raw = c.ReadBuffer(0);
+        std::vector<NpadIdType> ids(raw.size() / sizeof(NpadIdType));
+        std::memcpy(ids.data(), raw.data(), ids.size() * sizeof(NpadIdType));
+        Check(c, npad()->SetSupportedNpadIdType(kernel, aruid, ids));
+    });
+    s->On(103, [npad](Context& c) { // ActivateNpad(aruid)
+        const auto aruid = PopAruid(c);
+        npad()->SetRevision(aruid, NpadRevision::Revision0);
+        Check(c, npad()->Activate(aruid));
+    });
+    s->Ok(104); // DeactivateNpad: nothing since 10.0.0
+    s->On(106, [&kernel, npad](Context& c) { // AcquireNpadStyleSetUpdateEventHandle(npad id, aruid, unknown)
+        const auto id = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        Kernel::KReadableEvent* event = nullptr;
+        if (const Result r = npad()->AcquireNpadStyleSetUpdateEventHandle(kernel, aruid, &event, id); r.IsError()) return c.SetResult(r.raw);
+        c.PushCopyHandle(MirrorKernelEvent(kernel, event)); // the game waits on it natively
+    });
+    s->On(107, [&kernel, npad](Context& c) { // DisconnectNpad(npad id, aruid)
+        const auto id = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        Check(c, npad()->DisconnectNpad(kernel, aruid, id));
+    });
+    s->On(108, [](Context& c) { // GetPlayerLedPattern(npad id)
+        static constexpr u64 patterns[]{0b0001, 0b0011, 0b0111, 0b1111, 0b1001, 0b0101, 0b1101, 0b0110};
+        const auto id = static_cast<u32>(c.Pop<NpadIdType>());
+        c.Push<u64>(id < 8 ? patterns[id] : 0);
+    });
+    s->On(109, [npad](Context& c) { // ActivateNpadWithRevision(revision, aruid)
+        const auto revision = static_cast<NpadRevision>(c.Pop<s32>());
+        const auto aruid = PopAruid(c);
+        npad()->SetRevision(aruid, revision);
+        Check(c, npad()->Activate(aruid));
+    });
+    s->On(120, [npad](Context& c) { // SetNpadJoyHoldType(aruid, hold type)
+        const auto aruid = PopAruid(c);
+        const auto hold = static_cast<NpadJoyHoldType>(c.Pop<u64>());
+        Check(c, npad()->SetNpadJoyHoldType(aruid, hold));
+    });
+    s->On(121, [npad](Context& c) { // GetNpadJoyHoldType(aruid)
+        const auto aruid = PopAruid(c);
+        NpadJoyHoldType hold{};
+        if (const Result r = npad()->GetNpadJoyHoldType(aruid, hold); r.IsError()) return c.SetResult(r.raw);
+        c.Push<u64>(static_cast<u64>(hold));
+    });
+    auto single = [&kernel, npad](Context& c, bool with_device) { // SetNpadJoyAssignmentModeSingle(ByDefault)
+        const auto id = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        const auto device = with_device ? static_cast<NpadJoyDeviceType>(c.Pop<u64>()) : NpadJoyDeviceType::Left;
+        NpadIdType new_id{};
+        npad()->SetNpadMode(kernel, aruid, new_id, id, device, NpadJoyAssignmentMode::Single);
+    };
+    s->On(122, [single](Context& c) { single(c, false); });
+    s->On(123, [single](Context& c) { single(c, true); });
+    s->On(124, [&kernel, npad](Context& c) { // SetNpadJoyAssignmentModeDual(npad id, aruid)
+        const auto id = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        NpadIdType new_id{};
+        npad()->SetNpadMode(kernel, aruid, new_id, id, {}, NpadJoyAssignmentMode::Dual);
+    });
+    s->On(125, [&kernel, npad](Context& c) { // MergeSingleJoyAsDualJoy(id 1, id 2, aruid)
+        const auto a = c.Pop<NpadIdType>();
+        const auto b = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        Check(c, npad()->MergeSingleJoyAsDualJoy(kernel, aruid, a, b));
+    });
+    s->Ok(126); // StartLrAssignmentMode
+    s->Ok(127); // StopLrAssignmentMode
+    s->On(128, [&kernel, npad](Context& c) { // SetNpadHandheldActivationMode(aruid, mode)
+        const auto aruid = PopAruid(c);
+        const auto mode = static_cast<NpadHandheldActivationMode>(c.Pop<u64>());
+        if (mode >= NpadHandheldActivationMode::MaxActivationMode) return;
+        Check(c, npad()->SetNpadHandheldActivationMode(kernel, aruid, mode));
+    });
+    s->On(130, [&kernel, npad](Context& c) { // SwapNpadAssignment(id 1, id 2, aruid)
+        const auto a = c.Pop<NpadIdType>();
+        const auto b = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        Check(c, npad()->SwapNpadAssignment(kernel, aruid, a, b));
+    });
+    s->On(131, [npad](Context& c) { // IsUnintendedHomeButtonInputProtectionEnabled(npad id, aruid)
+        const auto id = c.Pop<NpadIdType>();
+        const auto aruid = PopAruid(c);
+        if (!IsNpadIdValid(id)) return c.SetResult(ResultInvalidNpadId.raw);
+        bool enabled = false;
+        if (const Result r = npad()->IsUnintendedHomeButtonInputProtectionEnabled(enabled, aruid, id); r.IsError()) return c.SetResult(r.raw);
+        c.Push<u8>(enabled);
+    });
+    s->On(200, [rm](Context& c) { // GetVibrationDeviceInfo(handle)
+        const auto h = c.Pop<Core::HID::VibrationDeviceHandle>();
+        Core::HID::VibrationDeviceInfo info{};
+        if (const Result r = rm->GetVibrationDeviceInfo(info, h); r.IsError()) return c.SetResult(r.raw);
+        c.Push(info);
+    });
+    s->On(201, [rm](Context& c) { // SendVibrationValue(handle, value, aruid)
+        const auto h = c.Pop<Core::HID::VibrationDeviceHandle>();
+        const auto v = c.Pop<Core::HID::VibrationValue>();
+        const auto aruid = PopAruid(c);
+        rm->SendVibrationValue(aruid, h, v);
+    });
+    s->On(202, [rm](Context& c) { // GetActualVibrationValue(handle, aruid)
+        const auto h = c.Pop<Core::HID::VibrationDeviceHandle>();
+        const auto aruid = PopAruid(c);
+        bool active = false;
+        if (const Result r = rm->IsVibrationAruidActive(aruid, active); r.IsError()) return c.SetResult(r.raw);
+        Core::HID::VibrationValue v = Core::HID::DEFAULT_VIBRATION_VALUE;
+        if (active) {
+            if (const Result r = IsVibrationHandleValid(h); r.IsError()) return c.SetResult(r.raw);
+            NpadVibrationDevice* device = rm->GetNSVibrationDevice(h);
+            if (!device || device->GetActualVibrationValue(v).IsError()) v = Core::HID::DEFAULT_VIBRATION_VALUE;
+        }
+        c.Push(v);
+    });
+    s->On(203, [rm](Context& c) { c.PushInterface(VibrationDeviceList(rm)); }); // CreateActiveVibrationDeviceList
+    s->On(204, [rm](Context& c) { // PermitVibration(can vibrate)
+        Check(c, rm->GetNpad()->GetVibrationHandler()->SetVibrationMasterVolume(c.Pop<u8>() ? 1.0f : 0.0f));
+    });
+    s->On(205, [rm](Context& c) { // IsVibrationPermitted
+        f32 volume = 0;
+        if (const Result r = rm->GetNpad()->GetVibrationHandler()->GetVibrationMasterVolume(volume); r.IsError()) return c.SetResult(r.raw);
+        c.Push<u8>(volume > 0.0f);
+    });
+    s->On(206, [rm](Context& c) { // SendVibrationValues(aruid, handles, values)
+        const auto aruid = PopAruid(c);
+        const auto raw_handles = c.ReadBuffer(0);
+        const auto raw_values = c.ReadBuffer(1);
+        const size_t n = raw_handles.size() / sizeof(Core::HID::VibrationDeviceHandle);
+        if (n != raw_values.size() / sizeof(Core::HID::VibrationValue)) return c.SetResult(ResultVibrationArraySizeMismatch.raw);
+        for (size_t i = 0; i < n; ++i) {
+            Core::HID::VibrationDeviceHandle h{};
+            Core::HID::VibrationValue v{};
+            std::memcpy(&h, raw_handles.data() + i * sizeof(h), sizeof(h));
+            std::memcpy(&v, raw_values.data() + i * sizeof(v), sizeof(v));
+            if (const Result r = rm->SendVibrationValue(aruid, h, v); r.IsError()) return c.SetResult(r.raw);
+        }
+    });
+    return s;
+}
+
+} // namespace
+
+std::shared_ptr<Service> MakeHidService(KernelCore& kernel) {
+    auto rm = ::Service::GetHidResourceManager(kernel.System());
+    if (!rm) return nullptr;
+    return HidServer(kernel, std::move(rm));
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_ldn.cpp b/src/core/hle/kernel/native_ldn.cpp
new file mode 100644
index 0000000000..4458fe3833
--- /dev/null
+++ b/src/core/hle/kernel/native_ldn.cpp
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: local wireless ("ldn:u") answered by the runtime, carried over a multiplayer room. The network logic (access
+// point / station state, node lists, advertise data, the LDN packets) is suyu's LANDiscovery library, and the transport is
+// suyu's room client (network/room_member, ENet); this replaces only the service around them (docs/NATIVE_ENGINE.md,
+// "Multiplayer rooms"). Without a joined room the game sees what a console in airplane mode reports.
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <span>
+#include <vector>
+
+#include "common/logging.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/ldn/lan_discovery.h"
+#include "core/hle/service/ldn/ldn_results.h"
+#include "core/hle/service/ldn/ldn_types.h"
+#include "core/internal_network/network.h"
+#include "core/internal_network/network_interface.h"
+#include "kart_runtime/native_kernel.h"
+#include "network/network.h"
+#include "network/room_member.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using namespace Service::LDN;
+using KartRuntime::Context;
+using KartRuntime::Event;
+using KartRuntime::NativeKernel;
+using KartRuntime::Service;
+
+/// One IUserLocalCommunicationService: its LANDiscovery, the room callback feeding it and the state-change event.
+struct LocalCommunication {
+    explicit LocalCommunication(NativeKernel& k) : state_change{std::make_shared<Event>(k, "ldn state change")} {}
+    ~LocalCommunication() { Unbind(); }
+
+    void Unbind() {
+        if (!bound) return;
+        if (auto member = Network::GetRoomMember().lock()) member->Unbind(packet_handle);
+        bound = false;
+    }
+
+    uint32_t Initialize() {
+        if (!Network::GetSelectedNetworkInterface()) return ResultAirplaneModeEnabled.raw;
+        auto member = Network::GetRoomMember().lock();
+        if (!member) {
+            LOG_WARNING(Service_LDN, "local wireless: no room client (the room network was not started)");
+            return ResultAirplaneModeEnabled.raw;
+        }
+        Unbind();
+        packet_handle = member->BindOnLdnPacketReceived([this](const Network::LDNPacket& p) { discovery.ReceivePacket(p); });
+        bound = true;
+        const auto event = state_change;
+        discovery.Initialize([event] { event->Signal(); });
+        initialized = true;
+        LOG_INFO(Service_LDN, "local wireless initialised ({})", member->IsConnected() ? "in a room" : "no room joined");
+        return 0;
+    }
+
+    uint32_t Finalize() {
+        Unbind();
+        initialized = false;
+        return discovery.Finalize().raw;
+    }
+
+    LANDiscovery discovery;
+    std::shared_ptr<Event> state_change;
+    Network::RoomMember::CallbackHandle<Network::LDNPacket> packet_handle;
+    bool bound = false, initialized = false;
+};
+
+std::shared_ptr<Service> UserLocalCommunication(NativeKernel& kernel) {
+    auto l = std::make_shared<LocalCommunication>(kernel);
+    auto s = std::make_shared<Service>("IUserLocalCommunicationService");
+    // A scan waits a second for replies from the room; LANDiscovery locks its own state, so the game's other calls (state polls
+    // from its main thread) are not held up behind a scan, and the scan is a wait of the scanning thread.
+    s->serialize = false;
+    // The service object owns the state: the handlers keep `l` alive as long as the session.
+    s->On(0, [l](Context& c) { c.Push<u32>(static_cast<u32>(l->initialized ? l->discovery.GetState() : State::Error)); });
+    s->On(1, [l](Context& c) { // GetNetworkInfo -> pointer buffer
+        NetworkInfo info{};
+        const Result r = l->discovery.GetNetworkInfo(info);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.WriteBuffer(&info, sizeof(info), 0);
+    });
+    s->On(2, [](Context& c) { // GetIpv4Address: the room's fake address while in a room
+        const auto iface = Network::GetSelectedNetworkInterface();
+        if (!iface) return c.SetResult(ResultNoIpAddress.raw);
+        Ipv4Address address = Network::TranslateIPv4(iface->ip_address);
+        Ipv4Address mask = Network::TranslateIPv4(iface->subnet_mask);
+        if (auto member = Network::GetRoomMember().lock(); member && member->IsConnected()) address = member->GetFakeIpAddress();
+        std::reverse(address.begin(), address.end());
+        std::reverse(mask.begin(), mask.end());
+        c.Push(address);
+        c.Push(mask);
+    });
+    s->On(3, [l](Context& c) { c.Push<s16>(static_cast<s16>(l->discovery.GetDisconnectReason())); });
+    s->On(4, [l](Context& c) { // GetSecurityParameter
+        NetworkInfo info{};
+        const Result r = l->discovery.GetNetworkInfo(info);
+        if (r.IsError()) return c.SetResult(r.raw);
+        SecurityParameter out{};
+        out.session_id = info.network_id.session_id;
+        std::memcpy(out.data.data(), info.ldn.security_parameter.data(), sizeof(out.data));
+        c.Push(out);
+    });
+    s->On(5, [l](Context& c) { // GetNetworkConfig
+        NetworkInfo info{};
+        const Result r = l->discovery.GetNetworkInfo(info);
+        if (r.IsError()) return c.SetResult(r.raw);
+        NetworkConfig out{};
+        out.intent_id = info.network_id.intent_id;
+        out.channel = info.common.channel;
+        out.node_count_max = info.ldn.node_count_max;
+        out.local_communication_version = info.ldn.nodes[0].local_communication_version;
+        c.Push(out);
+    });
+    s->On(100, [l](Context& c) { c.PushCopyObject(l->state_change); }); // AttachStateChangeEvent
+    s->On(101, [l](Context& c) { // GetNetworkInfoLatestUpdate -> info (pointer 0), node updates (pointer 1)
+        const size_t count = c.WriteBufferSize(1) / sizeof(NodeLatestUpdate);
+        if (count == 0) return c.SetResult(ResultBadInput.raw);
+        NetworkInfo info{};
+        std::vector<NodeLatestUpdate> updates(count);
+        const Result r = l->discovery.GetNetworkInfo(info, updates);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.WriteBuffer(&info, sizeof(info), 0);
+        c.WriteBuffer(updates.data(), updates.size() * sizeof(NodeLatestUpdate), 1);
+    });
+    const auto scan = [l](Context& c) { // Scan / ScanPrivate(channel, filter) -> count, networks
+        c.Pop<s16>(); // channel
+        const auto filter = c.Pop<ScanFilter>();
+        const size_t room = c.WriteBufferSize(0) / sizeof(NetworkInfo);
+        if (room == 0) return c.SetResult(ResultBadInput.raw);
+        std::vector<NetworkInfo> found(room);
+        s16 count = 0;
+        const Result r = c.kernel.Blocking([&] { return l->discovery.Scan(found, count, filter); });
+        if (r.IsError()) return c.SetResult(r.raw);
+        if (count > 0) c.WriteBuffer(found.data(), static_cast<size_t>(count) * sizeof(NetworkInfo), 0);
+        c.Push<s16>(count);
+    };
+    s->On(102, scan);
+    s->On(103, scan);
+    s->Ok(104); // SetWirelessControllerRestriction
+    s->Ok(106); // SetProtocol
+    s->On(200, [l](Context& c) { c.SetResult(l->discovery.OpenAccessPoint().raw); });
+    s->On(201, [l](Context& c) { c.SetResult(l->discovery.CloseAccessPoint().raw); });
+    s->On(202, [l](Context& c) { // CreateNetwork
+        const auto cfg = c.Pop<CreateNetworkConfig>();
+        c.SetResult(l->discovery.CreateNetwork(cfg.security_config, cfg.user_config, cfg.network_config).raw);
+    });
+    s->On(203, [l](Context& c) { // CreateNetworkPrivate (the address list is not used over a room)
+        const auto cfg = c.Pop<CreateNetworkConfigPrivate>();
+        c.SetResult(l->discovery.CreateNetwork(cfg.security_config, cfg.user_config, cfg.network_config).raw);
+    });
+    s->On(204, [l](Context& c) { c.SetResult(l->discovery.DestroyNetwork().raw); });
+    s->On(206, [l](Context& c) { // SetAdvertiseData
+        const auto data = c.ReadBuffer(0);
+        c.SetResult(l->discovery.SetAdvertiseData(std::span<const u8>{data}).raw);
+    });
+    s->Ok(207); // SetStationAcceptPolicy
+    s->Ok(208); // AddAcceptFilterEntry
+    s->On(300, [l](Context& c) { c.SetResult(l->discovery.OpenStation().raw); });
+    s->On(301, [l](Context& c) { c.SetResult(l->discovery.CloseStation().raw); });
+    s->On(302, [l](Context& c) { // Connect(data, network info in a pointer buffer)
+        const auto data = c.Pop<ConnectNetworkData>();
+        const auto raw = c.ReadBuffer(0);
+        if (raw.size() < sizeof(NetworkInfo)) return c.SetResult(ResultBadInput.raw);
+        NetworkInfo info{};
+        std::memcpy(&info, raw.data(), sizeof(info));
+        c.SetResult(l->discovery.Connect(info, data.user_config, static_cast<u16>(data.local_communication_version)).raw);
+    });
+    s->On(304, [l](Context& c) { c.SetResult(l->discovery.Disconnect().raw); });
+    s->On(400, [l](Context& c) { c.SetResult(l->Initialize()); });  // Initialize(pid)
+    s->On(401, [l](Context& c) { c.SetResult(l->Finalize()); });    // Finalize
+    s->On(402, [l](Context& c) { c.SetResult(l->Initialize()); });  // Initialize2(version, pid)
+    return s;
+}
+
+} // namespace
+
+std::shared_ptr<Service> MakeLocalCommunicationService(NativeKernel& runtime, const char* name) {
+    auto s = std::make_shared<Service>(name);
+    s->On(0, [&runtime](Context& c) { c.PushInterface(UserLocalCommunication(runtime)); }); // CreateUserLocalCommunicationService
+    return s;
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_mii.cpp b/src/core/hle/kernel/native_mii.cpp
new file mode 100644
index 0000000000..4a85402ceb
--- /dev/null
+++ b/src/core/hle/kernel/native_mii.cpp
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the Mii database service ("mii:e", "mii:u") answered by the runtime. The database itself (the console's Mii data
+// file, random and default Miis, conversions) is suyu's Mii library (MiiManager); this replaces only the service around it.
+#include <memory>
+#include <span>
+#include <vector>
+
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/mii/mii_manager.h"
+#include "core/hle/service/mii/mii_result.h"
+#include "core/hle/service/mii/types/char_info.h"
+#include "core/hle/service/mii/types/core_data.h"
+#include "core/hle/service/mii/types/raw_data.h"
+#include "core/hle/service/mii/types/store_data.h"
+#include "core/hle/service/mii/types/ver3_store_data.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using namespace Service::Mii;
+using KartRuntime::Context;
+using KartRuntime::Service;
+
+/// A getter that fills the output buffer with `T` records.
+template <typename T>
+void GetInto(Context& c, MiiManager& m, DatabaseSessionMetadata& md) {
+    const auto flag = static_cast<SourceFlag>(c.Pop<u32>());
+    std::vector<T> out(c.WriteBufferSize(0) / sizeof(T));
+    u32 count = 0;
+    const Result r = m.Get(md, std::span<T>{out}, count, flag);
+    if (r.IsError()) return c.SetResult(r.raw);
+    if (count) c.WriteBuffer(out.data(), count * sizeof(T), 0);
+    c.Push<u32>(count);
+}
+
+std::shared_ptr<Service> Database(std::shared_ptr<MiiManager> m, bool is_system) {
+    auto md = std::make_shared<DatabaseSessionMetadata>();
+    m->Initialize(*md);
+    auto s = std::make_shared<Service>("IDatabaseService");
+    s->On(0, [m, md](Context& c) { c.Push<u8>(m->IsUpdated(*md, static_cast<SourceFlag>(c.Pop<u32>()))); });
+    s->On(1, [m](Context& c) { c.Push<u8>(m->IsFullDatabase()); });
+    s->On(2, [m, md](Context& c) { c.Push<u32>(m->GetCount(*md, static_cast<SourceFlag>(c.Pop<u32>()))); });
+    s->On(3, [m, md](Context& c) { GetInto<CharInfoElement>(c, *m, *md); });
+    s->On(4, [m, md](Context& c) { GetInto<CharInfo>(c, *m, *md); });
+    s->On(5, [m, md](Context& c) { // UpdateLatest(char info, source flag)
+        const auto in = c.Pop<CharInfo>();
+        const auto flag = static_cast<SourceFlag>(c.Pop<u32>());
+        CharInfo out{};
+        const Result r = m->UpdateLatest(*md, out, in, flag);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.Push(out);
+    });
+    s->On(6, [m](Context& c) { // BuildRandom(age, gender, race)
+        const auto age = static_cast<Age>(c.Pop<u32>());
+        const auto gender = static_cast<Gender>(c.Pop<u32>());
+        const auto race = static_cast<Race>(c.Pop<u32>());
+        if (age > Age::All || gender > Gender::All || race > Race::All) return c.SetResult(ResultInvalidArgument.raw);
+        CharInfo out{};
+        m->BuildRandom(out, age, gender, race);
+        c.Push(out);
+    });
+    s->On(7, [m](Context& c) { // BuildDefault(index)
+        const auto index = c.Pop<s32>();
+        if (index < 0 || index >= static_cast<s32>(RawData::DefaultMii.size())) return c.SetResult(ResultInvalidArgument.raw);
+        CharInfo out{};
+        m->BuildDefault(out, static_cast<u32>(index));
+        c.Push(out);
+    });
+    s->On(8, [m, md](Context& c) { GetInto<StoreDataElement>(c, *m, *md); });
+    s->On(9, [m, md](Context& c) { GetInto<StoreData>(c, *m, *md); });
+    s->On(11, [m](Context& c) { // FindIndex(create id, is special)
+        const auto id = c.Pop<Common::UUID>();
+        const bool special = c.Pop<u8>() != 0;
+        c.Push<s32>(m->FindIndex(id, special));
+    });
+    s->On(21, [m, md](Context& c) { // GetIndex(char info)
+        const auto info = c.Pop<CharInfo>();
+        s32 index = -1;
+        const Result r = m->GetIndex(*md, info, index);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.Push(index);
+    });
+    s->On(22, [m, md](Context& c) { m->SetInterfaceVersion(*md, c.Pop<u32>()); });
+    s->On(23, [m](Context& c) { // Convert(v3 store data)
+        const auto v3 = c.Pop<Ver3StoreData>();
+        CharInfo out{};
+        const Result r = m->ConvertV3ToCharInfo(out, v3);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.Push(out);
+    });
+    s->On(24, [m](Context& c) { // ConvertCoreDataToCharInfo
+        const auto core = c.Pop<CoreData>();
+        CharInfo out{};
+        const Result r = m->ConvertCoreDataToCharInfo(out, core);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.Push(out);
+    });
+    s->On(25, [m](Context& c) { // ConvertCharInfoToCoreData
+        const auto info = c.Pop<CharInfo>();
+        CoreData out{};
+        const Result r = m->ConvertCharInfoToCoreData(out, info);
+        if (r.IsError()) return c.SetResult(r.raw);
+        c.Push(out);
+    });
+    (void)is_system;
+    return s;
+}
+
+} // namespace
+
+std::shared_ptr<Service> MakeMiiService(const char* name, bool is_system) {
+    static auto manager = std::make_shared<MiiManager>();
+    auto s = std::make_shared<Service>(name);
+    s->On(0, [is_system](Context& c) { c.PushInterface(Database(manager, is_system)); }); // GetDatabaseService
+    return s;
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_nvdrv_service.cpp b/src/core/hle/kernel/native_nvdrv_service.cpp
new file mode 100644
index 0000000000..a903b68ecc
--- /dev/null
+++ b/src/core/hle/kernel/native_nvdrv_service.cpp
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the GPU driver service ("nvdrv") answered by the runtime. The driver devices themselves - graphics memory handles
+// (nvmap), GPU address spaces, syncpoints and their events, the GPU channel, the video decoder - are suyu's driver code (the
+// nvdrv module and its NvCore container), used as a library; this replaces the service around them.
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "common/string_util.h"
+#include "core/core.h"
+#include "core/hle/kernel/k_event.h"
+#include "core/hle/kernel/k_handle_table.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_readable_event.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_game.h"
+#include "core/hle/kernel/native_services.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/nvdrv/core/container.h"
+#include "core/hle/service/nvdrv/nvdata.h"
+#include "core/hle/service/nvdrv/nvdrv.h"
+#include "core/hle/service/nvdrv/nvdrv_interface.h"
+#include "core/hle/service/sm/sm.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using KartRuntime::Context;
+using KartRuntime::Service;
+using ::Service::Nvidia::DeviceFD;
+using ::Service::Nvidia::Ioctl;
+using ::Service::Nvidia::NvResult;
+
+std::shared_ptr<Service> Driver(KernelCore& kernel, std::shared_ptr<::Service::Nvidia::Module> nv, const char* name) {
+    struct State {
+        bool initialized = false;
+        ::Service::Nvidia::NvCore::SessionId session{};
+    };
+    auto st = std::make_shared<State>();
+    auto s = std::make_shared<Service>(name);
+    auto result = [](Context& c, NvResult r) { c.Push<u32>(static_cast<u32>(r)); };
+    s->On(0, [nv, st, result](Context& c) { // Open(device path) -> fd, result
+        if (!st->initialized) {
+            c.Push<DeviceFD>(0);
+            return result(c, NvResult::NotInitialized);
+        }
+        const auto raw = c.ReadBuffer(0);
+        const std::string path = Common::StringFromBuffer(raw);
+        if (path == "/dev/nvhost-prof-gpu") {
+            c.Push<DeviceFD>(0);
+            return result(c, NvResult::NotSupported);
+        }
+        const DeviceFD fd = nv->Open(path, st->session);
+        c.Push<DeviceFD>(fd);
+        result(c, fd != ::Service::Nvidia::INVALID_NVDRV_FD ? NvResult::Success : NvResult::FileOperationFailed);
+    });
+    auto ioctl = [nv, st, result](Context& c, int kind) {
+        const auto fd = c.Pop<DeviceFD>();
+        const auto command = c.Pop<Ioctl>();
+        if (!st->initialized) return result(c, NvResult::NotInitialized);
+        const auto in = c.ReadBuffer(0);
+        std::vector<u8> out(c.WriteBufferSize(0));
+        NvResult r{};
+        if (kind == 1) {
+            r = nv->Ioctl1(fd, command, in, out);
+        } else if (kind == 2) {
+            const auto inline_in = c.ReadBuffer(1);
+            r = nv->Ioctl2(fd, command, in, inline_in, out);
+        } else {
+            std::vector<u8> inline_out(c.WriteBufferSize(1));
+            r = nv->Ioctl3(fd, command, in, out, inline_out);
+            if (command.is_out != 0 && !inline_out.empty()) c.WriteBuffer(inline_out.data(), inline_out.size(), 1);
+        }
+        if (command.is_out != 0 && !out.empty()) c.WriteBuffer(out.data(), out.size(), 0);
+        result(c, r);
+    };
+    s->On(1, [ioctl](Context& c) { ioctl(c, 1); });
+    s->On(11, [ioctl](Context& c) { ioctl(c, 2); });
+    s->On(12, [ioctl](Context& c) { ioctl(c, 3); });
+    s->On(2, [nv, st, result](Context& c) { // Close(fd)
+        const auto fd = c.Pop<DeviceFD>();
+        if (!st->initialized) return result(c, NvResult::NotInitialized);
+        result(c, nv->Close(fd));
+    });
+    s->On(3, [&kernel, nv, st, result](Context& c) { // Initialize(transfer memory size; process, transfer memory)
+        if (!st->initialized) {
+            if (c.request.copy_handles.empty()) return result(c, NvResult::BadParameter);
+            if (KProcess* game = NativeGame::Process()) {
+                st->session = nv->GetContainer().OpenSession(game);
+            } else {
+                KScopedAutoObject process = GetCurrentProcess(kernel).GetHandleTable().GetObject<KProcess>(kernel, c.request.copy_handles[0]);
+                if (process.IsNull()) return result(c, NvResult::BadParameter);
+                st->session = nv->GetContainer().OpenSession(process.GetPointerUnsafe());
+            }
+            st->initialized = true;
+        }
+        result(c, NvResult::Success);
+    });
+    s->On(4, [&kernel, nv, st, result](Context& c) { // QueryEvent(fd, event id) -> event, result
+        const auto fd = c.Pop<DeviceFD>();
+        const auto id = c.Pop<u32>();
+        if (!st->initialized) return result(c, NvResult::NotInitialized);
+        Kernel::KEvent* event = nullptr;
+        const NvResult r = nv->QueryEvent(fd, id, event);
+        if (r == NvResult::Success && event) c.PushCopyHandle(MirrorKernelEvent(kernel, &event->GetReadableEvent()));
+        result(c, r);
+    });
+    s->On(6, [result](Context& c) { result(c, NvResult::Success); }); // GetStatus
+    s->On(8, [result](Context& c) { result(c, NvResult::Success); }); // SetAruid
+    s->Ok(9);                                                          // DumpGraphicsMemoryInfo
+    s->Ok(13);                                                         // SetGraphicsFirmwareMemoryMarginEnabled
+    return s;
+}
+
+} // namespace
+
+std::shared_ptr<Service> MakeNvdrvService(KernelCore& kernel, const char* name) {
+    auto iface = kernel.System().ServiceManager().GetService<::Service::Nvidia::NVDRV>("nvdrv", true);
+    if (!iface) return nullptr;
+    return Driver(kernel, iface->GetModule(), name);
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_services.cpp b/src/core/hle/kernel/native_services.cpp
new file mode 100644
index 0000000000..77eac02b7d
--- /dev/null
+++ b/src/core/hle/kernel/native_services.cpp
@@ -0,0 +1,440 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/hle/kernel/native_services.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <map>
+#include <tuple>
+#include <mutex>
+#include <array>
+#include <set>
+#include <unordered_map>
+#include <algorithm>
+#include <sstream>
+
+#include "common/logging/log.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_thread.h"
+#include "core/hle/kernel/k_readable_event.h"
+#include "core/hle/kernel/k_client_port.h"
+#include "core/hle/kernel/k_client_session.h"
+#include "core/hle/kernel/k_handle_table.h"
+#include "core/hle/service/sm/sm.h"
+#include "core/core.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_game.h"
+#include "core/hle/kernel/native_threads.h"
+#include "kart_runtime/game_kernel.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/kernel/svc_results.h"
+#include "core/memory.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using KartRuntime::NativeKernel;
+
+std::atomic<KernelCore*> g_kernel{nullptr};
+std::atomic<u64> g_native_waits{0}, g_emulated_waits{0}, g_native_resets{0};
+thread_local bool t_host_wait = false;
+
+Result ToResult(u32 r) {
+    return Result{r};
+}
+
+/// The services asked for: KARTRECOMP_NATIVE_SERVICES = "0" (none), "all" (default on Linux) or a comma list of names.
+bool Wanted(const std::string& name) {
+    static const std::set<std::string> list = [] {
+        std::set<std::string> out;
+        const char* v = std::getenv("KARTRECOMP_NATIVE_SERVICES");
+#ifdef __linux__
+        if (!v) v = "all";
+#endif
+        if (!v || std::strcmp(v, "0") == 0) return out;
+        std::istringstream in{v};
+        for (std::string item; std::getline(in, item, ',');)
+            if (!item.empty()) out.insert(item);
+        return out;
+    }();
+    return list.contains("all") || list.contains(name);
+}
+
+} // namespace
+
+// KARTRECOMP_NATIVE_SERVICES_TRACE: calls per service command, listed at shutdown.
+std::mutex g_call_count_lock;
+std::map<std::pair<std::string, u32>, u64> g_call_counts;
+
+NativeKernel& Runtime(KernelCore& kernel) {
+    // Lives to the end of the process: its objects hold the engine's library parts, which must not be destroyed after the
+    // engine itself (process exit).
+    static NativeKernel& runtime = *new NativeKernel{{
+        [](u64 addr, void* out, size_t n) {
+            KernelCore* k = g_kernel.load(std::memory_order_acquire);
+            if (!k) return false;
+            auto& mem = NativeGame::Process() ? NativeGame::Process()->GetMemory() : GetCurrentMemory(*k);
+            if (!mem.IsValidVirtualAddressRange(addr, n)) return false;
+            mem.ReadBlock(addr, out, n);
+            return true;
+        },
+        [](u64 addr, const void* in, size_t n) {
+            KernelCore* k = g_kernel.load(std::memory_order_acquire);
+            if (!k) return false;
+            auto& mem = NativeGame::Process() ? NativeGame::Process()->GetMemory() : GetCurrentMemory(*k);
+            if (!mem.IsValidVirtualAddressRange(addr, n)) return false;
+            mem.WriteBlock(addr, in, n);
+            return true;
+        },
+        [] {
+            if (NativeGame::OnGameThread()) return NativeGame::Kernel()->BeginWait();
+            t_host_wait = NativeThreads::BeginHostWait();
+        },
+        [] {
+            if (NativeGame::OnGameThread()) return NativeGame::Kernel()->EndWait();
+            if (t_host_wait) NativeThreads::EndHostWait();
+            t_host_wait = false;
+        },
+        []() -> u64 {
+            if (KProcess* game = NativeGame::Process()) return game->GetProcessId();
+            KernelCore* k = g_kernel.load(std::memory_order_acquire);
+            KProcess* p = k ? GetCurrentProcessPointer(*k) : nullptr;
+            return p ? p->GetProcessId() : 0;
+        },
+    }};
+    static std::once_flag once;
+    std::call_once(once, [&] {
+        g_kernel.store(&kernel, std::memory_order_release);
+        // As the game's only kernel, handles look like the console's (no marker bit: it is the lock words' waiters flag).
+        if (NativeGame::Enabled()) runtime.SetPlainHandles();
+        runtime.on_invalid_object = [](u32 handle, u32 object, u32 command, bool domain) {
+            LOG_WARNING(Service, "native services: request {} on handle {:08X} names object {} the session does not have (domain {})", command, handle, object, domain);
+        };
+        KartRuntime::Service::on_unknown = [](const std::string& service, u32 cmd) {
+            static std::mutex m;
+            static std::set<std::pair<std::string, u32>> seen;
+            std::scoped_lock lk{m};
+            if (seen.emplace(service, cmd).second)
+                LOG_WARNING(Service, "native services: {} command {} is not implemented (answered 'unknown command')", service, cmd);
+        };
+        KartRuntime::Service::on_error = [](const std::string& service, u32 cmd, u32 result) {
+            static std::mutex m;
+            static std::map<std::tuple<std::string, u32, u32>, u32> seen;
+            std::scoped_lock lk{m};
+            if (seen[{service, cmd, result}]++ < 3)
+                LOG_INFO(Service, "native services: {} command {} answered {:#x} ({:04}-{:04})", service, cmd, result,
+                         2000 + (result & 0x1ff), (result >> 9) & 0x1fff);
+        };
+        if (std::getenv("KARTRECOMP_NATIVE_SERVICES_TRACE")) {
+            KartRuntime::Service::on_call = [](const std::string& service, u32 cmd) {
+                auto& m = g_call_count_lock;
+                auto& counts = g_call_counts;
+                std::scoped_lock lk{m};
+                static const bool all = std::getenv("KARTRECOMP_NATIVE_SERVICES_TRACE")[0] == '2';
+                const u64 n = counts[{service, cmd}]++;
+                if (n == 0) LOG_INFO(Service, "native services: first {} command {}", service, cmd);
+                else if (all && n < 40) LOG_INFO(Service, "native services: {} command {} (call {})", service, cmd, n + 1);
+            };
+        }
+    });
+    return runtime;
+}
+
+bool Enabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_SERVICES");
+#ifdef __linux__
+        return !(v && std::strcmp(v, "0") == 0);
+#else
+        return v && std::strcmp(v, "0") != 0;
+#endif
+    }();
+    return on;
+}
+
+bool ServiceWanted(const std::string& name) {
+    return Enabled() && Wanted(name);
+}
+
+bool IsNative(Svc::Handle handle) {
+    return NativeKernel::IsNative(handle);
+}
+
+std::optional<u32> OpenService(KernelCore& kernel, const std::string& name) {
+    if (!Enabled() || !Wanted(name)) return std::nullopt;
+    auto& runtime = Runtime(kernel);
+    std::shared_ptr<KartRuntime::Service> service = MakeService(runtime, kernel, name);
+    if (!service) return std::nullopt;
+    static std::mutex m;
+    static std::set<std::string> logged;
+    {
+        std::scoped_lock lk{m};
+        if (logged.insert(name).second) LOG_INFO(Service, "native services: {} is answered by the runtime", name);
+    }
+    return runtime.OpenSession(std::move(service));
+}
+
+/// The service manager ("sm:"): GetService hands out a runtime session for the runtime's services and, for any other name, a
+/// session to the emulated service (until there are none: it logs which).
+std::optional<u32> ConnectToNamedPort(KernelCore& kernel, const std::string& name) {
+    if (!Enabled() || name != "sm:" || !ServiceWanted("sm:")) return std::nullopt;
+    auto& runtime = Runtime(kernel);
+    auto sm = std::make_shared<KartRuntime::Service>("sm:");
+    sm->Ok(0); // Initialize (RegisterClient)
+    sm->On(1, [&kernel](KartRuntime::Context& c) { // GetService(name)
+        const auto raw = c.Pop<std::array<char, 8>>();
+        std::string service;
+        for (const char ch : raw)
+            if (ch >= ' ' && ch <= '~') service.push_back(ch);
+        if (const auto h = OpenService(kernel, service)) return c.PushMoveHandle(*h);
+        // Not a runtime service: a session to the emulated one.
+        Kernel::KClientPort* port{};
+        if (const Result r = kernel.System().ServiceManager().GetServicePort(&port, service); r.IsError()) {
+            LOG_ERROR(Service, "native services: unknown service {}", service);
+            return c.SetResult(r.raw);
+        }
+        Kernel::KClientSession* session{};
+        if (const Result r = port->CreateSession(kernel, &session); r.IsError()) return c.SetResult(r.raw);
+        Svc::Handle h{};
+        const Result r = GetCurrentProcess(kernel).GetHandleTable().Add(kernel, &h, session);
+        session->Close(kernel);
+        if (r.IsError()) return c.SetResult(r.raw);
+        static std::mutex m;
+        static std::set<std::string> logged;
+        std::scoped_lock lk{m};
+        if (logged.insert(service).second) LOG_WARNING(Service, "native services: {} is still the emulated service", service);
+        c.PushMoveHandle(h);
+    });
+    LOG_INFO(Service, "native services: the service manager is the runtime's");
+    return runtime.OpenSession(std::move(sm));
+}
+
+Result SendSyncRequest(KernelCore& kernel, Svc::Handle handle) {
+    auto& runtime = Runtime(kernel);
+    KThread& thread = GetCurrentThread(kernel);
+    auto& memory = GetCurrentMemory(kernel);
+    const u64 tls = GetInteger(thread.GetTlsAddress());
+    u8 msg[KartRuntime::Hipc::MessageSize];
+    memory.ReadBlock(tls, msg, sizeof(msg));
+    // KARTRECOMP_NATIVE_SERVICES_DUMP=<file>: every request and reply (first 24 words) with the session handle.
+    static std::FILE* dump = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_SERVICES_DUMP");
+        return v && *v ? std::fopen(v, "w") : nullptr;
+    }();
+    static std::mutex dump_lock;
+    auto words = [&] {
+        std::string out;
+        for (int i = 0; i < 24; ++i) out += fmt::format("{:08X} ", reinterpret_cast<const u32*>(msg)[i]);
+        return out;
+    };
+    if (dump) {
+        std::scoped_lock lk{dump_lock};
+        std::fprintf(dump, "%08X > %s\n", handle, words().c_str());
+    }
+    const u32 r = runtime.SendSyncRequest(handle, msg);
+    if (dump) {
+        std::scoped_lock lk{dump_lock};
+        std::fprintf(dump, "%08X < %X %s\n", handle, r, words().c_str());
+        std::fflush(dump);
+    }
+    if (r != 0) LOG_ERROR(Service, "native services: request on handle {:08X} failed with {:X}", handle, r);
+    if (r == 0) memory.WriteBlock(tls, msg, sizeof(msg));
+    return ToResult(r);
+}
+
+Result CloseHandle(KernelCore& kernel, Svc::Handle handle) {
+    return Runtime(kernel).Close(handle) ? ResultSuccess : ResultInvalidHandle;
+}
+
+namespace {
+/// A runtime event that stands for an emulated one (see MirrorKernelEvent).
+class KernelEventMirror final : public KartRuntime::Event {
+public:
+    KernelEventMirror(KartRuntime::NativeKernel& k, KernelCore& kc, KReadableEvent* e) : Event{k, "kernel event"}, kernel{kc}, source{e} {
+        source->Open(kernel);
+    }
+    ~KernelEventMirror() override;
+    KernelCore& kernel;
+    KReadableEvent* source;
+};
+
+std::mutex g_mirrors_lock;
+std::atomic<bool> g_have_mirrors{false};
+std::unordered_map<KReadableEvent*, std::vector<KernelEventMirror*>> g_mirrors;
+
+KernelEventMirror::~KernelEventMirror() {
+    {
+        std::scoped_lock lk{g_mirrors_lock};
+        auto& list = g_mirrors[source];
+        list.erase(std::remove(list.begin(), list.end(), this), list.end());
+        if (list.empty()) g_mirrors.erase(source);
+    }
+    source->Close(kernel);
+}
+} // namespace
+
+u32 MirrorKernelEvent(KernelCore& kernel, KReadableEvent* event) {
+    auto& runtime = Runtime(kernel);
+    auto mirror = std::make_shared<KernelEventMirror>(runtime, kernel, event);
+    {
+        std::scoped_lock lk{g_mirrors_lock};
+        g_mirrors[event].push_back(mirror.get());
+        g_have_mirrors.store(true, std::memory_order_release);
+        // The state under the registry lock: a signal from now on reaches the mirror.
+        if (event->IsSignaledUnlocked(kernel)) mirror->Signal();
+    }
+    return runtime.Add(std::move(mirror));
+}
+
+void OnKernelEvent(KReadableEvent* event, bool signaled) {
+    if (!g_have_mirrors.load(std::memory_order_acquire)) return;
+    std::scoped_lock lk{g_mirrors_lock};
+    const auto it = g_mirrors.find(event);
+    if (it == g_mirrors.end()) return;
+    for (KernelEventMirror* m : it->second) {
+        if (signaled) m->Signal();
+        else m->Clear();
+    }
+}
+
+void OnRuntimeReset(KernelCore& kernel, KartRuntime::Event& event) {
+    if (event.name == "kernel event") (void)static_cast<KernelEventMirror&>(event).source->Reset(kernel);
+}
+
+KProcess& GameProcess(KernelCore& kernel) {
+    if (KProcess* game = NativeGame::Process()) return *game;
+    return GetCurrentProcess(kernel);
+}
+
+Result ClearEvent(KernelCore& kernel, Svc::Handle handle) {
+    // ClearEvent succeeds whether or not the event was signalled (ResetSignal answers "invalid state" then).
+    const Result r = ResetSignal(kernel, handle);
+    return r == ResultInvalidState ? ResultSuccess : r;
+}
+
+Result ResetSignal(KernelCore& kernel, Svc::Handle handle) {
+    auto event = Runtime(kernel).GetAs<KartRuntime::Event>(handle);
+    if (!event) return ResultInvalidHandle;
+    if (!event->IsSignaled()) return ResultInvalidState;
+    event->Clear();
+    g_native_resets.fetch_add(1, std::memory_order_relaxed);
+    if (event->name == "kernel event") {
+        // The emulated event is reset too (its service reads that state).
+        (void)static_cast<KernelEventMirror*>(event.get())->source->Reset(kernel);
+    }
+    return ResultSuccess;
+}
+
+namespace {
+// "This thread has ended" as a runtime event, made when the game first waits for the thread (the game waits for its worker
+// threads to end with WaitSynchronization on their handles).
+std::mutex g_thread_end_lock;
+std::unordered_map<KThread*, std::shared_ptr<KartRuntime::Event>> g_thread_end;
+
+std::shared_ptr<KartRuntime::Event> ThreadEndEvent(KernelCore& kernel, KThread* thread) {
+    std::scoped_lock lk{g_thread_end_lock};
+    if (thread->IsSignaled(kernel)) {
+        // Ended already (OnThreadEnded ran before anyone waited): a signalled event for this wait only, NOT kept in the map. Kept,
+        // it outlived the thread: thread objects are reused, and the next thread on this object then looked ended from its start -
+        // the game's wait for it returned at once and it unmapped the stack of a thread still running (a jump to 0 when a race
+        // ended and the game replaced its worker threads).
+        g_thread_end.erase(thread);
+        auto ended = std::make_shared<KartRuntime::Event>(Runtime(kernel), "thread end");
+        ended->Signal();
+        return ended;
+    }
+    auto& e = g_thread_end[thread];
+    if (!e || e->IsSignaled()) e = std::make_shared<KartRuntime::Event>(Runtime(kernel), "thread end"); // never a stale one
+    return e;
+}
+} // namespace
+
+void OnThreadEnded(KThread* thread) {
+    std::shared_ptr<KartRuntime::Event> e;
+    {
+        std::scoped_lock lk{g_thread_end_lock};
+        const auto it = g_thread_end.find(thread);
+        if (it == g_thread_end.end()) return;
+        e = std::move(it->second);
+        g_thread_end.erase(it); // thread objects are reused
+    }
+    e->Signal();
+}
+
+Result WaitSynchronization(KernelCore& kernel, s32* out_index, const Svc::Handle* handles, s32 count, s64 timeout_ns, bool* handled) {
+    *handled = false;
+    // Every handle becomes a runtime waitable: a runtime object, or an emulated thread's "ended" event. A wait that names any
+    // other emulated object is left to the emulated kernel (none in the game: it is logged there).
+    std::vector<std::shared_ptr<KartRuntime::Waitable>> objs;
+    {
+        auto& runtime = Runtime(kernel);
+        auto& table = GetCurrentProcess(kernel).GetHandleTable();
+        for (s32 i = 0; i < count; ++i) {
+            if (IsNative(handles[i])) {
+                auto w = runtime.GetAs<KartRuntime::Waitable>(handles[i]);
+                if (!w) {
+                    *handled = true;
+                    return ResultInvalidHandle;
+                }
+                objs.push_back(std::move(w));
+                continue;
+            }
+            KScopedAutoObject thread = table.GetObject<KThread>(kernel, handles[i]);
+            if (thread.IsNull()) {
+                g_emulated_waits.fetch_add(1, std::memory_order_relaxed);
+                return ResultSuccess;
+            }
+            objs.push_back(ThreadEndEvent(kernel, thread.GetPointerUnsafe()));
+        }
+    }
+    *handled = true;
+    g_native_waits.fetch_add(1, std::memory_order_relaxed);
+    // A CancelSynchronization that came while the thread was not waiting is kept by the thread (as the kernel does): it ends
+    // this wait at once.
+    KThread* self = GetCurrentThreadPointer(kernel);
+    if (self->IsWaitCancelled()) {
+        self->ClearWaitCancelled();
+        return ResultCancelled;
+    }
+    s32 index = -1;
+    const u32 r = Runtime(kernel).WaitAny(self->GetId(), objs, timeout_ns, &index);
+    objs.clear();
+    if (r == KartRuntime::KernelResult::Success) *out_index = index;
+    if (r == KartRuntime::KernelResult::Cancelled) {
+        // A thread being terminated never returns to the game (on the console it stops in the kernel): exit here, as the
+        // emulated kernel's run loop would before the next instruction. Otherwise it was CancelSynchronization.
+        if (GetCurrentThreadPointer(kernel)->IsTerminationRequested()) GetCurrentThread(kernel).Exit(kernel);
+        return ResultCancelled;
+    }
+    return ToResult(r);
+}
+
+bool CancelSynchronization(KernelCore& kernel, KThread* thread) {
+    if (!Enabled() || !thread) return false;
+    // Ends a native wait in progress; otherwise the emulated kernel's WaitCancel keeps the request on the thread.
+    return Runtime(kernel).CancelWait(thread->GetId(), false);
+}
+
+void Shutdown(KernelCore& kernel) {
+    if (!Enabled()) return;
+    // Handles stay valid (game threads may still be finishing a request); what must stop before the engine's own services
+    // go is stopped here.
+    StopAudioRenderers();
+    if (std::getenv("KARTRECOMP_NATIVE_SERVICES_TRACE")) {
+        std::scoped_lock lk{g_call_count_lock};
+        for (const auto& [key, n] : g_call_counts) LOG_INFO(Service, "native services: count {} command {}: {}", key.first, key.second, n);
+    }
+    LOG_INFO(Service, "native services: waits answered by the runtime {}, by the emulated kernel {}; runtime event resets {}",
+             g_native_waits.load(), g_emulated_waits.load(), g_native_resets.load());
+    (void)kernel;
+}
+
+void OnTerminateRequested(KernelCore& kernel, KThread* thread) {
+    if (!Enabled() || !thread) return;
+    Runtime(kernel).Terminate(thread->GetId());
+}
+
+} // namespace Kernel::NativeServices
