diff --git a/src/core/arm/recomp/host_hooks.cpp b/src/core/arm/recomp/host_hooks.cpp
new file mode 100644
index 0000000000..11a0a8b666
--- /dev/null
+++ b/src/core/arm/recomp/host_hooks.cpp
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <array>
+#include "core/arm/recomp/host_hooks.h"
+#include "core/arm/recomp/kart_hook_trace.h"
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <shared_mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace Core::RecompHooks {
+namespace {
+
+struct ReturnWatch {
+    u64 sp;
+    std::function<void(HookContext&)> fn;
+};
+
+std::atomic<bool> g_active{false};
+
+// Lock-free prefilter for Dispatch, which runs on every dispatcher iteration of
+// every guest thread: one bit per (pc >> 2) bucket. Bits are only ever set
+// (a stale bit just costs a map lookup), so readers never take g_lock for the
+// overwhelming majority of addresses, which are not hooked.
+constexpr size_t kFilterWords = 1u << 14; // 1M buckets, 128 KiB
+std::array<std::atomic<u64>, kFilterWords> g_filter{};
+
+size_t FilterIndex(u64 pc) {
+    return static_cast<size_t>((pc >> 2) ^ (pc >> 22)) & (kFilterWords * 64 - 1);
+}
+
+void FilterAdd(u64 pc) {
+    const size_t i = FilterIndex(pc);
+    g_filter[i >> 6].fetch_or(u64{1} << (i & 63), std::memory_order_release);
+}
+
+bool FilterMayContain(u64 pc) {
+    const size_t i = FilterIndex(pc);
+    return (g_filter[i >> 6].load(std::memory_order_acquire) >> (i & 63)) & 1;
+}
+std::shared_mutex g_lock;
+// Immutable once published: Dispatch takes a reference instead of copying.
+std::unordered_map<u64, std::shared_ptr<const std::vector<HookFn>>> g_hooks;
+std::unordered_map<u64, std::vector<ReturnWatch>> g_returns;
+
+// Return traps live in a range no guest module maps, aligned like code.
+constexpr u64 kTrapBase = 0xFFFF'FFFE'0000'0000ULL;
+constexpr u64 kTrapSlots = 1ULL << 20;
+struct ReturnTrap {
+    u64 real_lr;
+    std::function<void(HookContext&)> fn;
+};
+std::unordered_map<u64, ReturnTrap> g_traps;
+u64 g_next_trap = 0;
+
+void Refresh() {
+    g_active.store(!g_hooks.empty() || !g_returns.empty() || !g_traps.empty(),
+                   std::memory_order_release);
+}
+
+} // namespace
+
+void Install(u64 pc, HookFn fn) {
+    std::unique_lock lock{g_lock};
+    FilterAdd(pc);
+    KartHookTrace::NoteHookAddress(pc);
+    auto& slot = g_hooks[pc];
+    auto next = slot ? std::make_shared<std::vector<HookFn>>(*slot) : std::make_shared<std::vector<HookFn>>();
+    next->push_back(std::move(fn));
+    slot = std::move(next);
+    Refresh();
+}
+
+void Remove(u64 pc) {
+    std::unique_lock lock{g_lock};
+    g_hooks.erase(pc);
+    Refresh();
+}
+
+void Clear() {
+    std::unique_lock lock{g_lock};
+    g_hooks.clear();
+    g_returns.clear();
+    Refresh();
+}
+
+void OnReturn(u64 return_pc, u64 sp, std::function<void(HookContext&)> fn) {
+    std::unique_lock lock{g_lock};
+    FilterAdd(return_pc);
+    g_returns[return_pc].push_back({sp, std::move(fn)});
+    Refresh();
+}
+
+void TrapReturn(HookContext& ctx, std::function<void(HookContext&)> fn) {
+    std::unique_lock lock{g_lock};
+    u64 trap = 0;
+    for (u64 tries = 0; tries < kTrapSlots; ++tries) {
+        trap = kTrapBase + (g_next_trap++ % kTrapSlots) * 4;
+        if (!g_traps.contains(trap)) {
+            break;
+        }
+    }
+    g_traps[trap] = {ctx.x[30], std::move(fn)};
+    ctx.x[30] = trap;
+    Refresh();
+}
+
+bool Active() {
+    return g_active.load(std::memory_order_acquire);
+}
+
+bool Dispatch(HookContext& ctx) {
+    const u64 pc = ctx.pc;
+    if (pc >= kTrapBase && pc < kTrapBase + kTrapSlots * 4) {
+        ReturnTrap trap;
+        {
+            std::unique_lock lock{g_lock};
+            const auto it = g_traps.find(pc);
+            if (it == g_traps.end()) {
+                return false; // not ours; let the dispatcher report it
+            }
+            trap = std::move(it->second);
+            g_traps.erase(it);
+            Refresh();
+        }
+        if (trap.fn) {
+            trap.fn(ctx);
+        }
+        ctx.pc = trap.real_lr;
+        return true;
+    }
+    if (!FilterMayContain(pc)) {
+        return false;
+    }
+    std::function<void(HookContext&)> on_return;
+    std::shared_ptr<const std::vector<HookFn>> hooks;
+    bool has_return = false;
+    {
+        std::shared_lock lock{g_lock};
+        has_return = g_returns.contains(pc);
+        const auto it = g_hooks.find(pc);
+        if (!has_return && it == g_hooks.end()) {
+            return false;
+        }
+        if (it != g_hooks.end()) {
+            hooks = it->second;
+        }
+    }
+    // Return watches are matched by stack pointer, so a block reached by some
+    // other path (or by another thread) does not consume them.
+    if (has_return) {
+        std::unique_lock lock{g_lock};
+        if (const auto it = g_returns.find(pc); it != g_returns.end()) {
+            auto& watches = it->second;
+            for (auto w = watches.begin(); w != watches.end(); ++w) {
+                if (w->sp == ctx.x[31]) {
+                    on_return = std::move(w->fn);
+                    watches.erase(w);
+                    break;
+                }
+            }
+            if (watches.empty()) {
+                g_returns.erase(it);
+            }
+            Refresh();
+        }
+    }
+    if (on_return) {
+        on_return(ctx);
+    }
+    // Observers run in install order; the first hook that handles the call ends it.
+    if (!hooks) {
+        return false;
+    }
+    for (const auto& hook : *hooks) {
+        if (hook(ctx)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace Core::RecompHooks
diff --git a/src/core/arm/recomp/host_hooks.h b/src/core/arm/recomp/host_hooks.h
new file mode 100644
index 0000000000..5887608b55
--- /dev/null
+++ b/src/core/arm/recomp/host_hooks.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: host hooks for the static recompiler's dispatcher.
+//
+// A hook is host code bound to a guest address. Every time the dispatcher is
+// about to enter the block at that address, the hook runs first. It either
+// observes and lets the guest code run (returns false), or replaces the guest
+// function outright (returns true after setting x0 and pc, usually pc = x30).
+//
+// This is the seam for native subsystems: an NVN call can be traced here today,
+// and answered by a host Vulkan/Metal/GLES implementation later, with no
+// emulated GPU in between. Only calls that come back through the dispatcher are
+// seen; in practice that is every cross-module call (game -> SDK).
+#pragma once
+
+#include <functional>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::RecompHooks {
+
+struct HookContext {
+    u64* x;    ///< x0..x30, x31 = SP
+    u64& pc;
+    Core::System& system;
+    u64 (*v)[2]; ///< v0..v31, low half first (floating-point arguments live in v0..v7)
+};
+
+/// True when the hook fully handled the call and set pc itself.
+using HookFn = std::function<bool(HookContext&)>;
+
+/// Adds a hook; several may share an address and run in install order.
+void Install(u64 pc, HookFn fn);
+/// Removes every hook at pc.
+void Remove(u64 pc);
+void Clear();
+
+/// One-shot hook on a function's return: runs when the dispatcher reaches
+/// return_pc with the stack pointer back at sp, then removes itself. Observes
+/// only; x0 holds the callee's result.
+void OnReturn(u64 return_pc, u64 sp, std::function<void(HookContext&)> fn);
+
+/// Forces the current call to return through the dispatcher: replaces the
+/// guest return address (x30) with a trap address no module owns, so the
+/// callee's RET cannot chain straight back into the caller. When the trap is
+/// reached, fn runs with x0 = the result, then execution resumes at the real
+/// return address. Call from an entry hook only.
+void TrapReturn(HookContext& ctx, std::function<void(HookContext&)> fn);
+
+/// Fast check for the dispatcher; false until the first hook is installed.
+bool Active();
+
+/// Runs the hooks bound to pc. True when one of them handled the call.
+bool Dispatch(HookContext& ctx);
+
+} // namespace Core::RecompHooks
diff --git a/src/core/arm/recomp/kart_hook_trace.cpp b/src/core/arm/recomp/kart_hook_trace.cpp
new file mode 100644
index 0000000000..3f2edca302
--- /dev/null
+++ b/src/core/arm/recomp/kart_hook_trace.cpp
@@ -0,0 +1,480 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/kart_hook_trace.h"
+
+#include <atomic>
+#include <chrono>
+#include <vector>
+#include <memory>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <thread>
+#include <string>
+
+#include "common/fs/path_util.h"
+#include "common/kart_overlay.h"
+#include "common/logging/log.h"
+#include "core/arm/recomp/host_hooks.h"
+#include "core/core.h"
+#include "core/memory.h"
+
+namespace Core::KartHookTrace {
+namespace {
+
+std::mutex g_lock;
+std::ofstream g_out;
+
+std::string TextAt(Core::Memory::Memory& mem, u64 addr) {
+    if (addr < 0x10000 || !mem.IsValidVirtualAddressRange(addr, 1)) return {};
+    std::string s;
+    for (int i = 0; i < 48; ++i) {
+        if (!mem.IsValidVirtualAddressRange(addr + i, 1)) return {};
+        const char c = static_cast<char>(mem.Read8(addr + i));
+        if (c == 0) break;
+        if (c < 0x20 || c > 0x7e) return {};
+        s.push_back(c);
+    }
+    return s.size() >= 3 ? s : std::string{};
+}
+
+u64 g_main_base = 0;
+u64 g_cov_rows = 0;
+std::vector<u8> g_seen;
+std::ofstream g_cov;
+std::chrono::steady_clock::time_point g_start = std::chrono::steady_clock::now();
+const bool g_cov_enabled = [] {
+    const char* e = std::getenv("KARTRECOMP_BLOCK_COVERAGE");
+    return e && *e && *e != '0';
+}();
+
+} // namespace
+
+extern "C" uint8_t g_main_hookmap[] __attribute__((weak));
+constexpr u64 kHookMapEntries = 0x400000;
+
+u64 MainBase() { return g_main_base; }
+
+void NoteHookAddress(u64 pc) {
+    if (g_main_base == 0 || pc < g_main_base || !g_main_hookmap) return;
+    const u64 idx = (pc - g_main_base) >> 2;
+    if (idx < kHookMapEntries) g_main_hookmap[idx] = 1;
+}
+
+namespace {
+const char* g_watch_prefix = std::getenv("KARTRECOMP_STRING_WATCH");
+std::ofstream g_watch_out;
+std::atomic<int> g_watch_hits{0};
+} // namespace
+
+bool StringWatchEnabled() { return g_watch_prefix && *g_watch_prefix; }
+
+void StringWatch(Core::System& system, u64 pc, const u64* x) {
+    if (g_watch_hits.load() > 3000) return;
+    auto& mem = system.ApplicationMemory();
+    const size_t n = std::strlen(g_watch_prefix);
+    for (int i = 0; i < 4; ++i) {
+        const u64 p = x[i];
+        if (p < 0x10000 || !mem.IsValidVirtualAddressRange(p, 64)) continue;
+        char buf[64];
+        mem.ReadBlock(p, buf, sizeof buf);
+        if (std::strncmp(buf, g_watch_prefix, n) != 0) continue;
+        buf[63] = 0;
+        std::scoped_lock lock{g_lock};
+        if (!g_watch_out.is_open()) g_watch_out.open(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "string_watch.txt", std::ios::trunc);
+        g_watch_out << std::hex << "pc=" << pc << " (main+" << (g_main_base && pc >= g_main_base ? pc - g_main_base : 0) << ") lr=" << x[30]
+                    << " (main+" << (g_main_base && x[30] >= g_main_base ? x[30] - g_main_base : 0) << ") x" << std::dec << i << "=\"" << buf << "\"\n";
+        // The call chain by frame pointers (x29 -> [fp] = caller's fp, [fp+8] = return address), main-relative.
+        g_watch_out << "   chain:";
+        u64 fp = x[29];
+        for (int depth = 0; depth < 12 && fp >= 0x10000 && mem.IsValidVirtualAddressRange(fp, 16); ++depth) {
+            const u64 ret = mem.Read64(fp + 8);
+            g_watch_out << ' ' << (g_main_base && ret >= g_main_base && ret < g_main_base + 0xc00000 ? ret - g_main_base : ret);
+            const u64 next = mem.Read64(fp);
+            if (next <= fp) break;
+            fp = next;
+        }
+        g_watch_out << std::dec << "\n";
+        g_watch_out.flush();
+        ++g_watch_hits;
+    }
+}
+
+bool CoverageEnabled() { return g_cov_enabled && g_main_base != 0; }
+
+void CoverageHit(u64 pc, u64 lr, const u64* x) {
+    if (pc < g_main_base) return;
+    const u64 off = (pc - g_main_base) >> 2;
+    if (off >= g_seen.size() || g_seen[off]) return;
+    g_seen[off] = 1;
+    std::scoped_lock lock{g_lock};
+    if (!g_cov.is_open()) {
+        g_cov.open(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "block_first_hits.txt", std::ios::trunc);
+    }
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - g_start).count();
+    char row[160];
+    std::snprintf(row, sizeof row, "%lld %llx lr=%llx x0=%llx x1=%llx x2=%llx x3=%llx\n", static_cast<long long>(ms),
+                  static_cast<unsigned long long>(pc - g_main_base), static_cast<unsigned long long>(lr - g_main_base),
+                  static_cast<unsigned long long>(x[0]), static_cast<unsigned long long>(x[1]), static_cast<unsigned long long>(x[2]),
+                  static_cast<unsigned long long>(x[3]));
+    g_cov << row;
+    if ((++g_cov_rows & 255) == 0) g_cov.flush();
+}
+
+namespace {
+
+// ---- Race HUD map placement ---------------------------------------------------------------------------------------------------
+// Common/Mush/UI.bin ("IUIU" ...) holds one 140-byte record per course index at 0x24 + 140*index (map scale / offsets...). The spare course
+// indices 2..15 have the default identity record, which puts the minimap in the middle of the screen, so the extra cup copies a normal
+// course's record over the ones it uses. The loaded copy is found by its header.
+std::mutex g_cup_lock;
+std::vector<std::string> g_cup_tracks; ///< the running extra cup's track folders (CT_xx), set at Grand Prix start
+constexpr u64 kUiRecordSize = 140, kUiRecordsAt = 0x24, kUiTemplateIndex = 16;
+std::mutex g_ui_lock;
+std::vector<u64> g_ui_copies;
+bool g_ui_scanned = false;
+std::atomic<bool> g_ui_scanning{false};
+
+// The 8 spare "stand-in" music labels of an extra cup: the labels' stream file names live once in the sound archive's file table as
+// "<label>.bfstm"; those strings are overwritten with CT_xx file names for the duration of the cup (labels of result / replay music, never
+// used while racing). Index k (0..3): N label, F label.
+const char* const kStandInN[4] = {"pBGM_ANIMAL_RESULT_SPRING", "pBGM_ANIMAL_RESULT_SUMMER", "pBGM_ANIMAL_RESULT_AUTUMN", "pBGM_ANIMAL_RESULT_WINTER"};
+const char* const kStandInF[4] = {"pBGM_WU_OCEAN_REPLAY", "pBGM_WU_METRO_REPLAY", "pBGM_WU_SNOW_MOUNTAIN_REPLAY", "pBGM_GC_BABYPARK_REPLAY"};
+std::vector<u64> g_bfstm_at[8];       ///< guest addresses of each stand-in's "<label>.bfstm" string
+std::string g_bfstm_original[8];
+bool g_bfstm_patched = false;
+
+void ScanUiBin(Core::Memory::Memory& mem) {
+    static const u8 sig[16] = {0x49, 0x55, 0x49, 0x55, 0x68, 0x43, 0, 0, 1, 0, 0x14, 0, 0xe8, 0x03, 0, 0};
+    std::string names[8];
+    for (int k = 0; k < 4; ++k) {
+        names[k] = std::string(kStandInN[k]) + ".bfstm";
+        names[4 + k] = std::string(kStandInF[k]) + ".bfstm";
+    }
+    std::vector<u64> found;
+    std::vector<u64> bfstm[8];
+    std::vector<u8> chunk(0x1000 + 64);
+    // Probe every 64 KiB, then walk that window page by page (a page is 4 KiB; the overlap catches a match across a page edge).
+    for (u64 a = 0x200000; a < 0x8000000000ULL; a += 0x10000) {
+        if (!mem.IsValidVirtualAddress(a)) continue;
+        for (u64 page = a; page < a + 0x10000; page += 0x1000) {
+            if (!mem.IsValidVirtualAddress(page)) continue;
+            const u64 len = mem.IsValidVirtualAddress(page + 0x1000) ? 0x1000 + 64 : 0x1000;
+            mem.ReadBlock(page, chunk.data(), len);
+            for (u64 i = 0; i < 0x1000 && i < len; ++i) {
+                const u8 c = chunk[i];
+                if (c == 0x49 && i + sizeof sig <= len && std::memcmp(&chunk[i], sig, sizeof sig) == 0) found.push_back(page + i);
+                if (c == 'p' && i + 6 <= len && chunk[i + 1] == 'B' && chunk[i + 2] == 'G' && chunk[i + 3] == 'M') {
+                    for (int n = 0; n < 8; ++n) {
+                        if (i + names[n].size() + 1 <= len && std::memcmp(&chunk[i], names[n].c_str(), names[n].size() + 1) == 0) bfstm[n].push_back(page + i);
+                    }
+                }
+            }
+        }
+    }
+    std::scoped_lock lock{g_ui_lock};
+    g_ui_copies = std::move(found);
+    for (int n = 0; n < 8; ++n) g_bfstm_at[n] = std::move(bfstm[n]);
+    g_ui_scanned = true;
+    LOG_INFO(Core_ARM, "extra cup: {} copy(ies) of UI.bin, stand-in stream names found {}/{}/{}/{} {}/{}/{}/{}", g_ui_copies.size(), g_bfstm_at[0].size(),
+             g_bfstm_at[1].size(), g_bfstm_at[2].size(), g_bfstm_at[3].size(), g_bfstm_at[4].size(), g_bfstm_at[5].size(), g_bfstm_at[6].size(),
+             g_bfstm_at[7].size());
+}
+
+/// Points the stand-in labels' stream files at the extra cup's tracks (tracks[k] -> "pBGM_<track>_N.bfstm" / "_F.bfstm").
+void PatchBgmFiles(Core::Memory::Memory& mem, const std::vector<std::string>& tracks) {
+    std::scoped_lock lock{g_ui_lock};
+    for (int n = 0; n < 8; ++n) {
+        if (static_cast<size_t>(n % 4) >= tracks.size()) continue;
+        const std::string wanted = "pBGM_" + tracks[static_cast<size_t>(n % 4)] + (n < 4 ? "_N.bfstm" : "_F.bfstm");
+        for (const u64 at : g_bfstm_at[n]) {
+            if (g_bfstm_original[n].empty()) {
+                g_bfstm_original[n] = std::string(n < 4 ? kStandInN[n] : kStandInF[n - 4]) + ".bfstm";
+            }
+            mem.WriteBlock(at, wanted.c_str(), wanted.size() + 1);
+        }
+    }
+    g_bfstm_patched = true;
+}
+
+void RestoreBgmFiles(Core::Memory::Memory& mem) {
+    std::scoped_lock lock{g_ui_lock};
+    if (!g_bfstm_patched) return;
+    for (int n = 0; n < 8; ++n) {
+        for (const u64 at : g_bfstm_at[n]) mem.WriteBlock(at, g_bfstm_original[n].c_str(), g_bfstm_original[n].size() + 1);
+    }
+    g_bfstm_patched = false;
+}
+
+void StartUiScan(Core::System& system) {
+    if (g_ui_scanning.exchange(true)) return;
+    std::thread([&system] { ScanUiBin(system.ApplicationMemory()); }).detach();
+}
+
+void PatchUiMaps(Core::Memory::Memory& mem, size_t tracks) {
+    {
+        std::unique_lock lock{g_ui_lock};
+        if (!g_ui_scanned) {
+            lock.unlock();
+            ScanUiBin(mem); // not found yet (no cup screen was seen): scan now
+        }
+    }
+    std::scoped_lock lock{g_ui_lock};
+    for (const u64 base : g_ui_copies) {
+        u8 record[kUiRecordSize];
+        mem.ReadBlock(base + kUiRecordsAt + kUiRecordSize * kUiTemplateIndex, record, kUiRecordSize);
+        for (size_t k = 0; k < tracks; ++k) mem.WriteBlock(base + kUiRecordsAt + kUiRecordSize * (2 + k), record, kUiRecordSize);
+    }
+}
+
+// ---- Grand Prix course list override (prototype for extra cups) ---------------------------------------------------------------
+// main+0x4f7f7c is the block right after the Grand Prix setup loop copied the chosen cup's four table entries into the race list
+// (raceinfo = [sp], list at raceinfo+0x143c, 16-byte entries: u32 course index (= enum id - 1), u64 {0xffffffff, label}, byte at +0xc).
+// KARTRECOMP_TEST_CUP="17,19,21,22" (course indices) replaces the four courses of the next Grand Prix. The normal course table is not
+// touched; only the copy in the race list is.
+void InstallModHooks(Core::System& system, u64 load_base) {
+    // Main menu (TitleSelect page, handler main+0x4d5d58): event 0x68 is the Toy-Con button, whose case (main+0x4d6234, reached
+    // through the handler's jump table, so via the dispatcher) sends a "Labo" telemetry event and switches to the Labo page.
+    // The button is labelled "Mods" now (core/file_sys/kart_text_patch.cpp): leave the handler as for an ignored event
+    // (main+0x4d63b4 restores the frame and returns) and open the overlay's Mods page instead.
+    RecompHooks::Install(load_base + 0x4d6234, [load_base](RecompHooks::HookContext& ctx) {
+        ctx.pc = load_base + 0x4d63b4;
+        KartOverlay::OpenModsPage();
+        LOG_INFO(Core_ARM, "main menu: Mods button");
+        return true;
+    });
+    if (const char* alias = std::getenv("KARTRECOMP_CT_ALIAS"); alias && *alias && *alias != '0') {
+        // The 14 spare course ids 3..16 ("Reserved01..14") become CT_00..CT_13: the name table's entries are overwritten in place as soon
+        // as the table exists (it is built lazily by the first call of the name getter, main+0x1acb0), before the startup loops that
+        // derive picture / course paths from the names.
+        auto done = std::make_shared<std::atomic<bool>>(false);
+        RecompHooks::Install(load_base + 0x1acb0, [done, load_base](RecompHooks::HookContext& ctx) {
+            if (done->load()) return false;
+            auto& mem = ctx.system.ApplicationMemory();
+            const u64 var = mem.Read64(load_base + 0x12f5258); // address of the static that holds the table pointer
+            const u64 table = var ? mem.Read64(var) : 0;
+            if (table < 0x10000) return false; // not built yet
+            for (u32 id = 3; id <= 16; ++id) {
+                const u64 str = mem.Read64(table + 8ULL * id);
+                char name[16];
+                std::snprintf(name, sizeof name, "CT_%02u", id - 3);
+                if (str >= 0x10000) mem.WriteBlock(str, name, std::strlen(name) + 1);
+            }
+            done->store(true);
+            LOG_INFO(Core_ARM, "extra courses: ids 3..16 renamed CT_00..CT_13");
+            return false;
+        });
+    }
+    // Extra cup from a file: "extra_cup.txt" in the working directory lists up to 4 track folder names ("CT_00 CT_01 CT_02 CT_03",
+    // CTGP DX's hex numbering). At the next Grand Prix start the spare ids 3..6 are renamed to those folders in the name table and the
+    // four race-list entries become course indices 2..5. The file is read each time, so it can be changed between races.
+    RecompHooks::Install(load_base + 0x4910c8, [&system](RecompHooks::HookContext&) {
+        if (std::ifstream("extra_cups.txt")) StartUiScan(system); // the cup screen is up: find UI.bin while the player chooses
+        return false;
+    });
+    RecompHooks::Install(load_base + 0x4f7f7c, [load_base](RecompHooks::HookContext& ctx) {
+        std::ifstream f("extra_cup.txt");
+        std::istringstream from_env{std::getenv("KARTRECOMP_EXTRA_CUP") ? std::getenv("KARTRECOMP_EXTRA_CUP") : ""}; // tests
+        std::istream& in = f ? static_cast<std::istream&>(f) : static_cast<std::istream&>(from_env);
+        std::vector<std::string> tracks;
+        for (std::string t; in >> t && tracks.size() < 4;) tracks.push_back(t);
+        if (tracks.empty()) return false;
+        auto& mem = ctx.system.ApplicationMemory();
+        const u64 var = mem.Read64(load_base + 0x12f5258);
+        const u64 table = var ? mem.Read64(var) : 0;
+        const u64 raceinfo = mem.Read64(ctx.x[31]);
+        if (table < 0x10000 || raceinfo < 0x10000) return false;
+        for (size_t k = 0; k < tracks.size(); ++k) {
+            const u64 str = mem.Read64(table + 8ULL * (3 + k));
+            if (str < 0x10000) continue;
+            std::string name = tracks[k].substr(0, 10);
+            mem.WriteBlock(str, name.c_str(), name.size() + 1);
+            mem.Write32(raceinfo + 0x143c + 16 * k, static_cast<u32>(2 + k));
+            // The entry's name label (+8): CTGP's track names are new labels 21000 + track number (see tools/ctgp/messages.py).
+            if (name.size() == 5 && name.compare(0, 3, "CT_") == 0) {
+                mem.Write32(raceinfo + 0x143c + 16 * k + 8, 21000u + static_cast<u32>(std::strtoul(name.c_str() + 3, nullptr, 16)));
+            }
+        }
+        PatchUiMaps(mem, tracks.size());
+        {
+            std::scoped_lock cup_lock{g_cup_lock};
+            g_cup_tracks = tracks;
+        }
+        PatchBgmFiles(mem, tracks);
+        LOG_INFO(Core_ARM, "extra cup: {} courses from extra_cup.txt", tracks.size());
+        return false;
+    });
+    // Race music: main+0x7ee84 is SetBgm(controller, course index); it reads the 32-byte record `index` of the per-course BGM database
+    // ([db+0x78], pool-relative label offsets: +0 = "_N" label, +0x14 = "_F" (final lap) label). The spare indices 2..5 have empty labels,
+    // so no race music starts. Before the function reads its record, write the extra cup's labels (pBGM_CT_xx_N / _F, CTGP DX's stream names)
+    // into the zero bytes inside the spare records (+6..+0x13) and point the record at them.
+    RecompHooks::Install(load_base + 0x7ee84, [load_base](RecompHooks::HookContext& ctx) {
+        const u32 idx = static_cast<u32>(ctx.x[1]);
+        auto& mem = ctx.system.ApplicationMemory();
+        if (idx < 2 || idx > 5) {
+            RestoreBgmFiles(mem); // a normal race: the stand-in labels get their own streams back
+            return false;
+        }
+        std::string track;
+        {
+            std::scoped_lock cup_lock{g_cup_lock};
+            if (idx - 2 >= g_cup_tracks.size()) return false;
+            track = g_cup_tracks[idx - 2];
+        }
+        const u64 g = mem.Read64(load_base + 0x12f4d98);
+        const u64 o = g ? mem.Read64(g) : 0;
+        const u64 db = o ? mem.Read64(o + 0xa0) : 0;
+        const u64 recs = db ? mem.Read64(db + 0x78) : 0;
+        const u64 pool_var = mem.Read64(load_base + 0x12f62a8);
+        const u64 pool = pool_var ? mem.Read64(pool_var) : 0;
+        if (!recs || !pool) return false;
+        // Scratch for the two label strings: the unused spare records 6..15 (320 bytes), 64 bytes per track slot.
+        const u64 scratch = recs + 32ULL * 6 + 64ULL * (idx - 2);
+        const std::string n = kStandInN[idx - 2], f = kStandInF[idx - 2];
+        mem.WriteBlock(scratch, n.c_str(), n.size() + 1);
+        mem.WriteBlock(scratch + 32, f.c_str(), f.size() + 1);
+        const u64 rec = recs + 32ULL * idx;
+        mem.Write32(rec, static_cast<u32>(scratch - pool));
+        mem.Write32(rec + 0x14, static_cast<u32>(scratch + 32 - pool));
+        LOG_INFO(Core_ARM, "extra cup: race music {} -> {} / {}", track, n, f);
+        return false;
+    });
+    if (std::getenv("KARTRECOMP_BGM_PROBE")) {
+        // The per-course BGM database used by main+0x7ee84 (SetBgm(controller, course index)): 32-byte records at [db+0x78], count u16 at
+        // [db+0xd4], first dword = offset of the label in the string pool [*[GOT 0x12f62a8]]. Log it the first time it is used.
+        auto once = std::make_shared<std::atomic<bool>>(false);
+        RecompHooks::Install(load_base + 0x7ee84, [once, load_base](RecompHooks::HookContext& ctx) {
+            if (once->exchange(true)) return false;
+            auto& mem = ctx.system.ApplicationMemory();
+            const u64 g = mem.Read64(load_base + 0x12f4d98);
+            const u64 o = g ? mem.Read64(g) : 0;
+            const u64 db = o ? mem.Read64(o + 0xa0) : 0;
+            const u64 recs = db ? mem.Read64(db + 0x78) : 0;
+            const u64 pool_var = mem.Read64(load_base + 0x12f62a8);
+            const u64 pool = pool_var ? mem.Read64(pool_var) : 0;
+            LOG_INFO(Core_ARM, "bgm probe: db={:#x} recs={:#x} count={} pool={:#x} idx={}", db, recs, db ? mem.Read16(db + 0xd4) : 0, pool,
+                     static_cast<u32>(ctx.x[1]));
+            for (const u32 i : {0u, 1u, 2u, 3u, 5u, 16u, 27u, 28u}) {
+                if (!recs) break;
+                const u64 r = recs + 32ULL * i;
+                const u32 off = mem.Read32(r);
+                std::string label = pool && off ? TextAt(mem, pool + off) : std::string{"-"};
+                char row[160];
+                std::snprintf(row, sizeof row, "rec %u @%llx: off=%x %08x %08x %08x %08x %08x %08x %08x '%s'", i, static_cast<unsigned long long>(r), off,
+                              mem.Read32(r + 4), mem.Read32(r + 8), mem.Read32(r + 12), mem.Read32(r + 16), mem.Read32(r + 20),
+                              mem.Read32(r + 24), mem.Read32(r + 28), label.c_str());
+                LOG_INFO(Core_ARM, "bgm probe: {}", row);
+            }
+            return false;
+        });
+    }
+    const char* spec = std::getenv("KARTRECOMP_TEST_CUP");
+    if (!spec || !*spec) return;
+    auto courses = std::make_shared<std::vector<u32>>();
+    std::istringstream list{spec};
+    for (std::string item; std::getline(list, item, ',');) courses->push_back(static_cast<u32>(std::strtoul(item.c_str(), nullptr, 0)));
+    RecompHooks::Install(load_base + 0x4f7f7c, [courses](RecompHooks::HookContext& ctx) {
+        auto& mem = ctx.system.ApplicationMemory();
+        const u64 raceinfo = mem.Read64(ctx.x[31]);
+        if (raceinfo < 0x10000) return false;
+        for (size_t k = 0; k < 4 && k < courses->size(); ++k) {
+            mem.Write32(raceinfo + 0x143c + 16 * k, (*courses)[k]);
+        }
+        LOG_INFO(Core_ARM, "extra cup: race list replaced ({} courses)", courses->size());
+        return false;
+    });
+    (void)system;
+}
+
+} // namespace
+
+void NoteModule(Core::System& system, std::string_view name, u64 load_base) {
+    if (name == "main") {
+        g_main_base = load_base;
+        if (g_cov_enabled) {
+            g_seen.assign(0x1000000 >> 2, 0); // 16 MiB of code is more than main has
+            if (g_main_hookmap) std::memset(g_main_hookmap, 1, kHookMapEntries); // every block reports itself
+        }
+    }
+    if (name == "main") {
+        InstallModHooks(system, load_base);
+    }
+    const char* spec = std::getenv("KARTRECOMP_HOOK_TRACE");
+    if (!spec || name != "main") return;
+    {
+        std::scoped_lock lock{g_lock};
+        if (!g_out.is_open()) {
+            const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "hook_trace.txt";
+            g_out.open(path, std::ios::trunc);
+        }
+    }
+    std::istringstream list{spec};
+    std::string item;
+    while (std::getline(list, item, ',')) {
+        if (item.empty()) continue;
+        // "a-b" hooks every 4-byte address in the range (only block starts are ever reached).
+        const auto dash = item.find('-');
+        const u64 first = std::strtoull(item.c_str(), nullptr, 16);
+        const u64 last = dash == std::string::npos ? first : std::strtoull(item.c_str() + dash + 1, nullptr, 16);
+        for (u64 off = first; off <= last; off += 4) {
+        const u64 pc = load_base + off;
+        RecompHooks::Install(pc, [off, load_base, hits = std::make_shared<std::atomic<int>>(0)](RecompHooks::HookContext& ctx) {
+            static const int cap = std::getenv("KARTRECOMP_HOOK_TRACE_CAP") ? std::atoi(std::getenv("KARTRECOMP_HOOK_TRACE_CAP")) : 12;
+            if (hits->fetch_add(1) >= cap) return false; // the first few entries of each block are enough
+            std::scoped_lock lock{g_lock};
+            char row[160];
+            std::snprintf(row, sizeof row, "%llx lr=%llx", static_cast<unsigned long long>(off),
+                          static_cast<unsigned long long>(ctx.x[30] - load_base));
+            g_out << row;
+            auto& mem = ctx.system.ApplicationMemory();
+            for (const int i : {0, 1, 2, 3, 4, 5, 6, 7, 19, 20, 21, 22}) {
+                std::snprintf(row, sizeof row, " x%d=%llx", i, static_cast<unsigned long long>(ctx.x[i]));
+                g_out << row;
+                if (const auto t = TextAt(mem, ctx.x[i]); !t.empty()) g_out << "(\"" << t << "\")";
+            }
+            // KARTRECOMP_TRACE_DEREF="0x50,0x28": text at *(x0 + off) for each offset (object fields that hold a name pointer).
+            static const char* deref = std::getenv("KARTRECOMP_TRACE_DEREF");
+            if (deref && ctx.x[0] > 0x10000) {
+                std::istringstream offs{deref};
+                for (std::string o; std::getline(offs, o, ',');) {
+                    // "i0x1a0" = text stored inline at x0+0x1a0
+                    if (!o.empty() && o[0] == 'i') {
+                        const u64 at = ctx.x[0] + std::strtoull(o.c_str() + 1, nullptr, 0);
+                        g_out << " [x0+" << o.substr(1) << "]=\"" << TextAt(mem, at) << "\"";
+                        continue;
+                    }
+                    // "I0x1a8>0x10" = text stored inline at *(x0+0x1a8)+0x10
+                    if (!o.empty() && o[0] == 'I') {
+                        const auto gt = o.find('>');
+                        const u64 outer = mem.Read64(ctx.x[0] + std::strtoull(o.c_str() + 1, nullptr, 0));
+                        if (gt != std::string::npos && outer > 0x10000) {
+                            g_out << " [" << o.substr(1) << "]=\"" << TextAt(mem, outer + std::strtoull(o.c_str() + gt + 1, nullptr, 0)) << "\"";
+                        }
+                        continue;
+                    }
+                    // "0x50" = *(x0+0x50); "0x50>0x10" = *(*(x0+0x50)+0x10)
+                    const auto arrow = o.find('>');
+                    u64 field = ctx.x[0] + std::strtoull(o.c_str(), nullptr, 0);
+                    if (!mem.IsValidVirtualAddressRange(field, 8)) continue;
+                    if (arrow != std::string::npos) {
+                        const u64 inner = mem.Read64(field);
+                        field = inner + std::strtoull(o.c_str() + arrow + 1, nullptr, 0);
+                        if (inner < 0x10000 || !mem.IsValidVirtualAddressRange(field, 8)) continue;
+                    }
+                    const u64 p = mem.Read64(field);
+                    g_out << " [x0+" << o << "]=" << std::hex << p << std::dec;
+                    if (const auto t = TextAt(mem, p); !t.empty()) g_out << "(\"" << t << "\")";
+                }
+            }
+            g_out << '\n';
+            g_out.flush();
+            return false; // observe only
+        });
+        }
+        LOG_INFO(Core_ARM, "hook trace: main+{:#x}..{:#x}", first, last);
+    }
+}
+
+} // namespace Core::KartHookTrace
diff --git a/src/core/arm/recomp/kart_hook_trace.h b/src/core/arm/recomp/kart_hook_trace.h
new file mode 100644
index 0000000000..ed741ed5aa
--- /dev/null
+++ b/src/core/arm/recomp/kart_hook_trace.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: reverse-engineering aid. KARTRECOMP_HOOK_TRACE="1acb0,4910c8" logs every entry of those blocks of the `main` module
+// (offsets from its load base) with x0..x7, the caller and any readable text the arguments point at. Blocks only reach the host
+// dispatcher when the recompiled code returns to it between blocks: run with SUYU_RECOMP_CHAIN_BUDGET=1 (slow, analysis only).
+// Output: <log dir>/hook_trace.txt.
+#pragma once
+
+#include <string_view>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Core::KartHookTrace {
+
+/// KARTRECOMP_BLOCK_COVERAGE=1: every block of `main` is logged the first time it runs, with a millisecond timestamp, the caller and
+/// x0..x3, to <log dir>/block_first_hits.txt (run with SUYU_RECOMP_CHAIN_BUDGET=1). Comparing the time line with a scripted run shows
+/// which code a menu action ran for the first time.
+bool CoverageEnabled();
+void CoverageHit(u64 pc, u64 lr, const u64* x);
+
+/// Native block hooks (generated code built with tools/recomp/add_block_hooks.py): the module's hook map byte for `pc` is switched on.
+u64 MainBase();
+void NoteHookAddress(u64 pc);
+
+/// KARTRECOMP_STRING_WATCH=<prefix>: every time the dispatcher is entered, x0..x3 are checked for a pointer to text starting with the prefix;
+/// the first hits are logged to <log dir>/string_watch.txt with the entry pc, the caller and the text (finds who passes a given kind of name).
+bool StringWatchEnabled();
+void StringWatch(Core::System& system, u64 pc, const u64* x);
+
+/// Called for each module as it is loaded.
+void NoteModule(Core::System& system, std::string_view name, u64 load_base);
+
+} // namespace Core::KartHookTrace
diff --git a/src/core/arm/recomp/nvn_trace.cpp b/src/core/arm/recomp/nvn_trace.cpp
new file mode 100644
index 0000000000..dd70859f8d
--- /dev/null
+++ b/src/core/arm/recomp/nvn_trace.cpp
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/arm/recomp/nvn_trace.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/fs/path_util.h"
+#include "common/logging/log.h"
+#include "core/arm/recomp/host_hooks.h"
+#include "core/nvn_host/nvn_host.h"
+#include "core/core.h"
+#include "core/memory.h"
+
+namespace Core::NvnTrace {
+namespace {
+
+struct Entry {
+    std::string name;
+    u64 address = 0;
+    std::atomic<u64> calls{0};
+    bool is_present = false;
+    bool is_draw = false;
+};
+
+// ---- Frame-level capture -------------------------------------------------
+// Every frame: one CSV row (calls, draws). Every `capture_every` frames: a full
+// argument dump of `capture_frames` frames. Configured by
+// KARTRECOMP_NVN_CAPTURE="every=3600,frames=2" (defaults shown; every=0 disables dumps).
+struct CallRecord {
+    u64 frame;
+    u64 thread;
+    const Entry* entry;
+    u64 x[8];
+    u64 v[4];
+};
+
+struct Capture {
+    u64 every = 3600;
+    u64 frames = 2;
+    std::mutex lock;
+    std::atomic<u64> frame{0};
+    std::atomic<u64> frame_calls{0};
+    std::atomic<u64> frame_draws{0};
+    std::atomic<bool> recording{false};
+    u64 recording_until = 0;
+    std::vector<CallRecord> records;
+    std::ofstream csv;
+};
+
+Capture& GetCapture() {
+    static Capture capture;
+    static const bool configured = [] {
+        Capture& c = capture;
+        if (const char* cfg = std::getenv("KARTRECOMP_NVN_CAPTURE")) {
+            std::string_view v{cfg};
+            for (size_t pos = 0; pos < v.size();) {
+                const size_t end = std::min(v.find(',', pos), v.size());
+                const auto item = v.substr(pos, end - pos);
+                const auto eq = item.find('=');
+                if (eq != std::string_view::npos) {
+                    const u64 n = std::strtoull(std::string(item.substr(eq + 1)).c_str(), nullptr, 10);
+                    if (item.substr(0, eq) == "every") c.every = n;
+                    if (item.substr(0, eq) == "frames") c.frames = n;
+                }
+                pos = end + 1;
+            }
+        }
+        return true;
+    }();
+    (void)configured;
+    return capture;
+}
+
+u64 HostThreadId() {
+    static std::atomic<u64> next{1};
+    thread_local const u64 id = next.fetch_add(1);
+    return id;
+}
+
+void FlushCaptureLocked(Capture& c) {
+    if (c.records.empty()) {
+        return;
+    }
+    const u64 first = c.records.front().frame;
+    const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) /
+                      ("nvn_capture_" + std::to_string(first) + ".txt");
+    std::ofstream out(path, std::ios::trunc);
+    out << "# frame thread name x0..x7 | v0..v3 (low 64 bits; f32 pairs and f64 shown)\n";
+    char line[512];
+    for (const auto& r : c.records) {
+        int n = std::snprintf(line, sizeof(line), "%llu t%llu %s",
+                              static_cast<unsigned long long>(r.frame),
+                              static_cast<unsigned long long>(r.thread), r.entry->name.c_str());
+        for (u64 x : r.x) {
+            n += std::snprintf(line + n, sizeof(line) - n, " %llx", static_cast<unsigned long long>(x));
+        }
+        n += std::snprintf(line + n, sizeof(line) - n, " |");
+        for (u64 v : r.v) {
+            float f[2];
+            std::memcpy(f, &v, sizeof(f));
+            n += std::snprintf(line + n, sizeof(line) - n, " %g", static_cast<double>(f[0]));
+        }
+        out << line << '\n';
+    }
+    c.records.clear();
+}
+
+void OnCall(Entry* entry, RecompHooks::HookContext& ctx) {
+    auto& c = GetCapture();
+    c.frame_calls.fetch_add(1, std::memory_order_relaxed);
+    if (entry->is_draw) {
+        c.frame_draws.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (c.recording.load(std::memory_order_relaxed)) {
+        CallRecord r{c.frame.load(std::memory_order_relaxed), HostThreadId(), entry, {}, {}};
+        std::memcpy(r.x, ctx.x, sizeof(r.x));
+        for (int i = 0; i < 4; ++i) {
+            r.v[i] = ctx.v[i][0];
+        }
+        std::scoped_lock lock{c.lock};
+        c.records.push_back(r);
+    }
+    if (!entry->is_present) {
+        return;
+    }
+    // Frame boundary.
+    std::scoped_lock lock{c.lock};
+    const u64 frame = c.frame.fetch_add(1) + 1;
+    if (!c.csv.is_open()) {
+        c.csv.open(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_frames.csv",
+                   std::ios::trunc);
+        c.csv << "frame,calls,draws,present_thread\n";
+    }
+    c.csv << frame - 1 << ',' << c.frame_calls.exchange(0) << ',' << c.frame_draws.exchange(0)
+          << ",t" << HostThreadId() << '\n';
+    if ((frame & 0xFF) == 0) {
+        c.csv.flush();
+    }
+    if (c.recording && frame >= c.recording_until) {
+        c.recording = false;
+        FlushCaptureLocked(c);
+    }
+    if (!c.recording && c.every != 0 && frame % c.every == 0) {
+        c.recording = true;
+        c.recording_until = frame + c.frames;
+        c.records.reserve(400000);
+    }
+}
+
+std::mutex g_lock;
+// Stable storage: hooks capture raw pointers into these entries.
+std::vector<std::unique_ptr<Entry>> g_entries;
+std::unordered_map<u64, Entry*> g_by_address;
+std::atomic<u64> g_total_calls{0};
+std::chrono::steady_clock::time_point g_last_report{};
+std::atomic<bool> g_report_pending{false};
+
+template <typename T>
+bool ReadAt(std::span<const u8> image, u64 offset, T& out) {
+    if (offset + sizeof(T) > image.size()) {
+        return false;
+    }
+    std::memcpy(&out, image.data() + offset, sizeof(T));
+    return true;
+}
+
+/// Module-relative address of a defined dynamic symbol, or 0.
+u64 FindDefinedSymbol(std::span<const u8> image, std::string_view wanted) {
+    u32 mod0 = 0;
+    if (!ReadAt(image, 4, mod0) || mod0 + 8 > image.size() ||
+        std::memcmp(image.data() + mod0, "MOD0", 4) != 0) {
+        return 0;
+    }
+    s32 dyn_rel = 0;
+    ReadAt(image, mod0 + 4, dyn_rel);
+    u64 dyn = mod0 + static_cast<s64>(dyn_rel);
+    u64 symtab = 0, strtab = 0, hash = 0, strsz = 0;
+    for (;; dyn += 16) {
+        s64 tag = 0;
+        u64 val = 0;
+        if (!ReadAt(image, dyn, tag) || !ReadAt(image, dyn + 8, val) || tag == 0) {
+            break;
+        }
+        switch (tag) {
+        case 4: hash = val; break;   // DT_HASH
+        case 5: strtab = val; break; // DT_STRTAB
+        case 6: symtab = val; break; // DT_SYMTAB
+        case 10: strsz = val; break; // DT_STRSZ
+        default: break;
+        }
+    }
+    if (!symtab || !strtab || !hash) {
+        return 0;
+    }
+    u32 count = 0;
+    ReadAt(image, hash + 4, count); // nchain = number of symbols
+    for (u32 i = 0; i < count; ++i) {
+        const u64 sym = symtab + static_cast<u64>(i) * 24;
+        u32 name_off = 0;
+        u16 shndx = 0;
+        u64 value = 0;
+        if (!ReadAt(image, sym, name_off) || !ReadAt(image, sym + 6, shndx) ||
+            !ReadAt(image, sym + 8, value)) {
+            break;
+        }
+        if (shndx == 0 || name_off >= strsz) {
+            continue;
+        }
+        const char* s = reinterpret_cast<const char*>(image.data() + strtab + name_off);
+        const size_t max = image.size() - (strtab + name_off);
+        if (std::string_view{s, strnlen(s, max)} == wanted) {
+            return value;
+        }
+    }
+    return 0;
+}
+
+void MaybeReport() {
+    const auto now = std::chrono::steady_clock::now();
+    std::scoped_lock lock{g_lock};
+    if (now - g_last_report < std::chrono::seconds(10)) {
+        return;
+    }
+    g_last_report = now;
+    g_report_pending = true;
+}
+
+/// Counting hook on one resolved NVN entry point. Observe-only.
+void Track(Core::System& system, const std::string& name, u64 address) {
+    if (address == 0) {
+        return;
+    }
+    Entry* entry = nullptr;
+    {
+        std::scoped_lock lock{g_lock};
+        if (g_by_address.contains(address)) {
+            return;
+        }
+        auto owned = std::make_unique<Entry>();
+        owned->name = name;
+        owned->address = address;
+        owned->is_present = name == "nvnQueuePresentTexture";
+        owned->is_draw = name.starts_with("nvnCommandBufferDraw");
+        entry = owned.get();
+        g_entries.push_back(std::move(owned));
+        g_by_address[address] = entry;
+    }
+    (void)system;
+    RecompHooks::Install(address, [entry](RecompHooks::HookContext& ctx) {
+        entry->calls.fetch_add(1, std::memory_order_relaxed);
+        OnCall(entry, ctx);
+        if ((g_total_calls.fetch_add(1, std::memory_order_relaxed) & 0xFFFF) == 0) {
+            MaybeReport();
+        }
+        if (g_report_pending.exchange(false)) {
+            WriteReport();
+        }
+        return false;
+    });
+}
+
+/// Resolver hook: entry reads the requested name, the return watch reads the
+/// address the guest driver produced for it. name_reg is the argument register
+/// holding the C string (x0 for the bootstrap loader, x1 for GetProcAddress).
+void HookResolver(Core::System& system, u64 address, int name_reg, std::string label);
+
+void OnResolved(Core::System& system, const std::string& name, u64 result) {
+    static std::atomic<int> shown{0};
+    if (shown.fetch_add(1) < 12) {
+        LOG_INFO(Core_ARM, "NVN resolve {} -> {:#x}", name, result);
+    }
+    if (name == "nvnDeviceGetProcAddress") {
+        HookResolver(system, result, 1, name);
+    }
+    // Native NVN shadow first, so its hooks run before the counter on shared addresses.
+    if (NvnHost::Enabled()) {
+        NvnHost::OnResolved(name, result);
+    }
+    if (Enabled()) {
+        Track(system, name, result);
+    }
+}
+
+void HookResolver(Core::System& system, u64 address, int name_reg, std::string label) {
+    if (address == 0) {
+        return;
+    }
+    {
+        std::scoped_lock lock{g_lock};
+        static std::unordered_map<u64, bool> resolvers;
+        if (resolvers[address]) {
+            return;
+        }
+        resolvers[address] = true;
+    }
+    LOG_INFO(Core_ARM, "NVN trace: hooking {} at {:#x}", label, address);
+    RecompHooks::Install(address, [&system, name_reg](RecompHooks::HookContext& ctx) {
+        const std::string name = ctx.system.ApplicationMemory().ReadCString(ctx.x[name_reg], 128);
+        RecompHooks::TrapReturn(ctx, [&system, name](RecompHooks::HookContext& ret) {
+            OnResolved(system, name, ret.x[0]);
+        });
+        return false;
+    });
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("KARTRECOMP_NVN_TRACE");
+        return v && *v && *v != '0';
+    }();
+    return enabled;
+}
+
+void NoteModuleImage(Core::System& system, std::span<const u8> image, u64 load_base,
+                     std::string_view name) {
+    if (!Enabled() && !NvnHost::Enabled()) {
+        return;
+    }
+    const u64 bootstrap = FindDefinedSymbol(image, "nvnBootstrapLoader");
+    if (bootstrap == 0) {
+        return;
+    }
+    LOG_INFO(Core_ARM, "NVN trace: nvnBootstrapLoader defined in {} at {:#x}", name,
+             load_base + bootstrap);
+    HookResolver(system, load_base + bootstrap, 0, "nvnBootstrapLoader");
+}
+
+void WriteReport() {
+    std::vector<std::pair<u64, const Entry*>> rows;
+    {
+        std::scoped_lock lock{g_lock};
+        for (const auto& e : g_entries) {
+            rows.emplace_back(e->calls.load(std::memory_order_relaxed), e.get());
+        }
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+        return a.first != b.first ? a.first > b.first : a.second->name < b.second->name;
+    });
+    size_t called = 0;
+    for (const auto& r : rows) {
+        called += r.first != 0;
+    }
+    const auto path = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_trace.txt";
+    std::ofstream out(path, std::ios::trunc);
+    out << "=== NVN TRACE ===\n"
+        << "resolved entry points : " << rows.size() << "\n"
+        << "called at least once  : " << called << "\n"
+        << "total calls           : " << g_total_calls.load() << "\n"
+        << "--- calls  address  name ---\n";
+    for (const auto& [calls, e] : rows) {
+        char line[256];
+        std::snprintf(line, sizeof(line), "%12llu  %#012llx  %s\n",
+                      static_cast<unsigned long long>(calls),
+                      static_cast<unsigned long long>(e->address), e->name.c_str());
+        out << line;
+    }
+}
