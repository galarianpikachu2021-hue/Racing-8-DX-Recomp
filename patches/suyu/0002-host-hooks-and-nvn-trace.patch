+// kart-recomp (exporter --fast-entry): every block is two functions. blk_X_f(c, entry) is the body; entry 0 starts at the first
+// instruction, and chained branches and native calls call it with 0. blk_X(c) is what the block index holds: it works the entry
+// out from c->pc (the dispatcher and indirect branches can enter in the middle of a block) and calls the body. A chained edge
+// then pays neither the entry check (three loads and a compare) nor the store of c->pc: the pc is only written on the paths
+// that go back to the dispatcher.
+inline bool g_fast_entry = false;
 inline std::string ChainTo(u64 t) {
-    char b[256];
+    char b[384];
+    if (g_fast_entry && g_chain_blocks && g_chain_mod && g_chain_blocks->count(t)) {
+        char nm[64];
