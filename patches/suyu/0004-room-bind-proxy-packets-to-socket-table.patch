+// The room client is created after the game is loaded (suyu_cmd calls Network::Init() after system.Load()), but this
+// table is built while loading, so the constructor above may find no room client and never bind the room's packets.
+// The game's sockets then receive nothing and Wireless Play drops the connection a few seconds after it is made.
+// Bind on first use instead.
+void BsdSockets::EnsureProxyBinding() {
+    bool expected = false;
+    if (!proxy_bound.compare_exchange_strong(expected, true)) {
+        return;
+    }
+    if (auto room_member = Network::GetRoomMember().lock()) {
+        proxy_packet_received = room_member->BindOnProxyPacketReceived(
+            [this](const Network::ProxyPacket& packet) { OnProxyPacketReceived(packet); });
+        LOG_INFO(Service, "bsd: room packets bound to the socket table");
+    } else {
+        proxy_bound = false;
+    }
+}
+
 BsdSockets::~BsdSockets() {
     if (auto room_member = Network::GetRoomMember().lock()) {
         room_member->Unbind(proxy_packet_received);
@@ -69,6 +88,7 @@ BsdSockets::~BsdSockets() {
 }
 
 std::pair<s32, Errno> BsdSockets::SocketImpl(Domain domain, Type type, Protocol protocol) {
