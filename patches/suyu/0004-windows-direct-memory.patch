+    const u64 writes = stats.unmapped_writes;
+    const u64 sinks = stats.sink_pages;
+    for (u64 i = 0; i < 32; ++i) {
+        Store64(dm.arena + 0x4000 + i * 8, i + 1);
+    }
+    REQUIRE(Load64(dm.arena + 0x4000) == 0);
+    REQUIRE(stats.unmapped_writes.load() == writes + 32);
+    REQUIRE(stats.sink_pages.load() == sinks);
+}
+
+TEST_CASE("DirectMemory: a game page without write permission is opened", "[direct_memory]") {
+    DirectMemoryArena dm;
+    dm.Map(0x9000, 0, 0x1000);
+    dm.mem.Protect(0x9000, 0x1000, Common::MemoryPermission::Read); // Map itself always maps read-write
+    auto& stats = DM::GetStats();
+    const u64 opened = stats.opened_pages;
+    Store64(dm.arena + 0x9008, 77);
+    REQUIRE(Load64(dm.arena + 0x9008) == 77);
+    REQUIRE(stats.opened_pages.load() == opened + 1);
+}
+
+TEST_CASE("DirectMemory: a fault on a game page that permits the access is retried as is", "[direct_memory]") {
+    // The race "fault on a free page, then the game's Map finishes": the handler sees a game page that allows the access.
+    DirectMemoryArena dm;
+    dm.Map(0xb000, 0, 0x2000);
+    dm.mem.Protect(0xc000, 0x1000, Common::MemoryPermission::Read);
+    auto& stats = DM::GetStats();
+    const u64 opened = stats.opened_pages;
+    REQUIRE(ForgeFault(dm.arena + 0xb010, 1) == EXCEPTION_CONTINUE_EXECUTION); // write to a read-write page
+    REQUIRE(ForgeFault(dm.arena + 0xc010, 0) == EXCEPTION_CONTINUE_EXECUTION); // read of a read-only page
+    REQUIRE(stats.opened_pages.load() == opened);
+    REQUIRE(PageProtection(dm.mem, 0xc000) == PAGE_READONLY); // not opened for good by a read
+}
+
+TEST_CASE("DirectMemory: a fault outside the arena goes to the next handler", "[direct_memory]") {
+    DirectMemoryArena dm;
+    auto* const outside = static_cast<u8*>(VirtualAlloc(nullptr, 0x1000, MEM_RESERVE, PAGE_NOACCESS));
+    REQUIRE(outside != nullptr);
+    const bool caught = ReadFaultReachesCaller(outside);
+    VirtualFree(outside, 0, MEM_RELEASE);
+    REQUIRE(caught);
+}
+
+TEST_CASE("DirectMemory: a read waits for a game Map in flight", "[direct_memory]") {
+    DirectMemoryArena dm;
+    Store64(dm.mem.BackingBasePointer() + 0x5000, 0xc0ffee);
+    g_dm_mapped[0xa] = true; // the page table says mapped, the arena has no view yet
+    auto& stats = DM::GetStats();
+    const u64 reads = stats.unmapped_reads;
+    std::atomic<u64> seen{0};
+    std::atomic<bool> done{false};
+    std::thread reader([&] {
+        seen = Load64(dm.arena + 0xa000);
+        done = true;
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    const bool done_early = done;
+    dm.mem.Map(0xa000, 0x5000, 0x1000, PERMS, HEAP);
+    reader.join();
+    REQUIRE_FALSE(done_early);
+    REQUIRE(seen.load() == 0xc0ffee);
+    REQUIRE(stats.unmapped_reads.load() == reads);
+}
+TEST_CASE("DirectMemory: a write across two free pages steps with both slots", "[direct_memory]") {
+    DirectMemoryArena dm;
+    auto& stats = DM::GetStats();
+    const u64 writes = stats.unmapped_writes;
+    Store64(dm.arena + 0xdffc, 0x1122334455667788);
+    REQUIRE(stats.unmapped_writes.load() == writes + 2);
+    REQUIRE(Load64(dm.arena + 0xdff8) == 0);
+    REQUIRE(Load64(dm.arena + 0xe000) == 0);
+    Store64(dm.arena + 0xdffc, 1); // the slots were given back
+    REQUIRE(stats.unmapped_writes.load() == writes + 4);
+}
+
+TEST_CASE("DirectMemory: a page faulting again while it is stepped reuses its slot", "[direct_memory]") {
+    // Two threads write the same free page: the other's single step puts the zero page back before this instruction ran, so
+    // it faults on the page again, then on the second page it straddles.
+    DirectMemoryArena dm;
+    auto ops = dm.mem.HandlerOps();
+    REQUIRE(ForgeFault(dm.arena + 0xfffc, 1) == EXCEPTION_CONTINUE_EXECUTION);
+    REQUIRE(ops.map_zero(ops.ctx, 0xf000));
+    REQUIRE(ForgeFault(dm.arena + 0xfffc, 1) == EXCEPTION_CONTINUE_EXECUTION);
+    const LONG second_page = ForgeFault(dm.arena + 0x10000, 1);
+    REQUIRE(ForgeSingleStep() == EXCEPTION_CONTINUE_EXECUTION);
+    REQUIRE(second_page == EXCEPTION_CONTINUE_EXECUTION);
+    REQUIRE(PageProtection(dm.mem, 0xf000) == PAGE_READONLY);
+    REQUIRE(PageProtection(dm.mem, 0x10000) == PAGE_READONLY);
+}
+
+TEST_CASE("DirectMemory: a Map that never comes stops the retries", "[direct_memory]") {
+    DirectMemoryArena dm;
+    DM::Detail::g_retry_limit_ms = 100;
+    g_dm_mapped[0x21] = true; // the page table says mapped, the arena never gets a view
+    auto& stats = DM::GetStats();
+    const auto start = std::chrono::steady_clock::now();
+    LONG result = EXCEPTION_CONTINUE_EXECUTION;
+    while (result == EXCEPTION_CONTINUE_EXECUTION && std::chrono::steady_clock::now() - start < std::chrono::seconds(3)) {
+        result = ForgeFault(dm.arena + 0x21008, 0);
+    }
+    REQUIRE(result == EXCEPTION_CONTINUE_SEARCH);
+    REQUIRE(std::chrono::steady_clock::now() - start >= std::chrono::milliseconds(80)); // tick granularity
+    REQUIRE(stats.retry_giveups.load() == 1);
+    REQUIRE(stats.last_giveup.load() == 0x21008);
+
+    // A retry after a pause starts a new window: the earlier retries worked, they just never said so.
+    REQUIRE(ForgeFault(dm.arena + 0x21008, 0) == EXCEPTION_CONTINUE_EXECUTION);
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    REQUIRE(ForgeFault(dm.arena + 0x21008, 0) == EXCEPTION_CONTINUE_EXECUTION);
+
+    // A real read: given up, the fault reaches the code that made it.
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    REQUIRE(ReadFaultReachesCaller(dm.arena + 0x21010));
+    REQUIRE(stats.retry_giveups.load() == 2);
+}
+#endif
