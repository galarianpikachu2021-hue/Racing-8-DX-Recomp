+#!/usr/bin/env bash
+# Builds and runs kart_runtime's tests on their own (no emulator, no CMake): proof that the runtime stands alone.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+out="${1:-$(mktemp -d)}"
+for t in "$here"/test_*.cpp; do
+  n="$(basename "$t" .cpp)"
+  "${CXX:-g++}" -std=c++20 -O2 -Wall -Wextra -Werror -pthread ${CXXFLAGS:-} "$t" -o "$out/$n"
+  "$out/$n"
+done
diff --git a/src/kart_runtime/tests/test_core_scheduler.cpp b/src/kart_runtime/tests/test_core_scheduler.cpp
new file mode 100644
index 0000000000..e3e1ccc18e
--- /dev/null
+++ b/src/kart_runtime/tests/test_core_scheduler.cpp
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Standalone test of KartRuntime::CoreScheduler (no test framework: exits non-zero with a message on failure).
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+#include "../core_scheduler.h"
+
+using KartRuntime::CoreScheduler;
+using namespace std::chrono_literals;
+
+#define CHECK(cond)                                                                    \
+    do {                                                                               \
+        if (!(cond)) {                                                                 \
+            std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #cond);     \
+            std::exit(1);                                                              \
+        }                                                                              \
+    } while (0)
+
+// Many threads on few cores doing short bursts: never two running on one core.
+static void OnePerCore() {
+    constexpr int kCores = 3, kThreads = 24, kRounds = 400;
+    CoreScheduler s{kCores};
+    std::atomic<int> on_core[kCores]{};
+    std::atomic<long> bursts{0};
+    std::vector<std::thread> pool;
+    for (int i = 0; i < kThreads; ++i) {
+        pool.emplace_back([&, i] {
+            auto t = s.Create(i % kCores, 40 + i % 5);
+            for (int r = 0; r < kRounds; ++r) {
+                s.Acquire(t.get());
+                CHECK(on_core[t->Core()].fetch_add(1) == 0);
+                for (volatile int spin = 0; spin < 200; spin = spin + 1) {}
+                if (r % 7 == 0) {
+                    on_core[t->Core()].fetch_sub(1);
+                    s.Yield(t.get()); // may hand the core over and come back
+                    CHECK(on_core[t->Core()].fetch_add(1) == 0);
+                }
+                CHECK(on_core[t->Core()].fetch_sub(1) == 1);
+                bursts.fetch_add(1);
+                s.Release(t.get());
+            }
+        });
+    }
+    for (auto& th : pool) th.join();
+    CHECK(bursts.load() == static_cast<long>(kThreads) * kRounds);
+    for (int c = 0; c < kCores; ++c) CHECK(s.Running(c) == nullptr);
+}
+
+// Waiters are served best priority first, then in arrival order.
+static void PriorityOrder() {
+    CoreScheduler s{1};
+    auto holder = s.Create(0, 10);
+    s.Acquire(holder.get());
+    std::vector<int> order;
+    std::mutex order_lock;
+    std::vector<std::thread> pool;
+    const int priorities[] = {50, 20, 50, 30, 20};
+    for (int i = 0; i < 5; ++i) {
+        pool.emplace_back([&, i] {
+            auto t = s.Create(0, priorities[i]);
+            s.Acquire(t.get());
+            {
+                std::scoped_lock lk{order_lock};
+                order.push_back(i);
+            }
+            s.Release(t.get());
+        });
+        std::this_thread::sleep_for(30ms); // arrival order = i
+    }
+    CHECK(!s.PreemptRequested(holder.get())); // nobody waiting is better than priority 10
+    s.Release(holder.get());
+    for (auto& th : pool) th.join();
+    const std::vector<int> want{1, 4, 3, 0, 2}; // 20 (first), 20 (second), 30, 50 (first), 50 (second)
+    CHECK(order == want);
+}
+
+// A better-priority arrival asks the running thread to yield; an equal one does not, but Yield lets it in.
+static void Preemption() {
+    CoreScheduler s{1};
+    auto low = s.Create(0, 40);
+    s.Acquire(low.get());
+    std::atomic<int> stage{0};
+    std::thread high([&] {
+        auto t = s.Create(0, 10);
+        s.Acquire(t.get());
+        stage = 1;
+        s.Release(t.get());
+    });
+    while (!s.PreemptRequested(low.get())) std::this_thread::sleep_for(1ms);
+    CHECK(stage == 0); // still waiting: preemption is a request
+    s.Yield(low.get());
+    CHECK(stage == 1); // the better thread ran before we came back
+    CHECK(s.Running(0) == low.get());
+    high.join();
+
+    std::thread equal([&] {
+        auto t = s.Create(0, 40);
+        s.Acquire(t.get());
+        stage = 2;
+        s.Release(t.get());
+    });
+    std::this_thread::sleep_for(50ms);
+    CHECK(!s.PreemptRequested(low.get()) && stage == 1);
+    s.Yield(low.get()); // equal priority: takes its turn on a yield
+    CHECK(stage == 2);
+    s.Release(low.get());
+    equal.join();
+}
+
+// Raising a waiter's priority above the running thread requests preemption; moving a waiter to an idle core runs it.
+static void PriorityAndCoreChanges() {
+    CoreScheduler s{2};
+    auto a = s.Create(0, 30);
+    s.Acquire(a.get());
+    std::atomic<bool> ran{false};
+    std::unique_ptr<CoreScheduler::Thread> b = s.Create(0, 50);
+    std::thread other([&] {
+        s.Acquire(b.get());
+        ran = true;
+        s.Release(b.get());
+    });
+    std::this_thread::sleep_for(50ms);
+    CHECK(!ran && !s.PreemptRequested(a.get()));
+    s.SetPriority(b.get(), 5);
+    CHECK(s.PreemptRequested(a.get()));
+    s.SetPriority(b.get(), 50);
+    s.SetCore(b.get(), 1); // core 1 is idle: b runs there without a taking a break
+    other.join();
+    CHECK(ran && s.Running(0) == a.get());
+    s.Release(a.get());
+}
+
+int main() {
+    OnePerCore();
+    PriorityOrder();
+    Preemption();
+    PriorityAndCoreChanges();
+    std::puts("core_scheduler: all tests passed");
+    return 0;
+}
diff --git a/src/kart_runtime/tests/test_direct_memory.cpp b/src/kart_runtime/tests/test_direct_memory.cpp
new file mode 100644
index 0000000000..bbaebea55b
--- /dev/null
+++ b/src/kart_runtime/tests/test_direct_memory.cpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime test: direct memory's fault handler on a small arena.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "../direct_memory.h"
+
+#if defined(__linux__) && defined(__x86_64__)
+namespace {
+constexpr std::uint64_t kSize = 64 * 0x1000;
+constexpr std::uint64_t kMapped = 50 * 0x1000; // one game page that exists, read-only
+
+bool IsMapped(std::uint64_t address) {
+    return (address & ~std::uint64_t{0xfff}) == kMapped;
+}
+
+#define CHECK(x)                                                                                                                 \
+    do {                                                                                                                         \
+        if (!(x)) {                                                                                                              \
+            std::printf("FAILED %s:%d: %s\n", __FILE__, __LINE__, #x);                                                           \
+            std::exit(1);                                                                                                        \
+        }                                                                                                                        \
+    } while (0)
+} // namespace
+
+int main() {
+    using namespace KartRuntime::DirectMemory;
+    auto* arena = static_cast<std::uint8_t*>(mmap(nullptr, kSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    CHECK(arena != MAP_FAILED);
+    CHECK(mmap(arena + kMapped, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != MAP_FAILED);
+    arena[kMapped + 5] = 42;
+    CHECK(mprotect(arena + kMapped, 0x1000, PROT_READ) == 0);
+    CHECK(Install(arena, kSize, &IsMapped));
+    volatile std::uint8_t* mem = arena;
+    Stats& stats = GetStats();
+
+    // Reads of unmapped memory give zeros; the page faults once.
+    volatile std::uint64_t* null_object = reinterpret_cast<volatile std::uint64_t*>(arena + 0x100);
+    CHECK(*null_object == 0);
+    CHECK(null_object[1] == 0);
+    CHECK(stats.unmapped_reads.load() == 1);
+    CHECK(stats.last_unmapped.load() == 0x100);
+
+    // Writes to unmapped memory are dropped, on a page read before and on a fresh one.
+    *null_object = 0x1234;
+    CHECK(*null_object == 0);
+    mem[3 * 0x1000 + 7] = 9;
+    CHECK(mem[3 * 0x1000 + 7] == 0);
+    CHECK(stats.unmapped_writes.load() == 2);
+
+    // A write across two unmapped pages: both halves dropped.
+    *reinterpret_cast<volatile std::uint64_t*>(arena + 5 * 0x1000 - 4) = ~std::uint64_t{0}; // unaligned on purpose (x86)
+    for (int i = -4; i < 4; ++i) CHECK(mem[5 * 0x1000 + i] == 0);
+    CHECK(stats.unmapped_writes.load() == 4);
+
+    // A page that keeps taking writes becomes a sink: the writes stop faulting, and ZeroSinks empties it.
+    const std::uint64_t writes_before = stats.unmapped_writes.load();
+    for (int i = 0; i < 1000; ++i) mem[20 * 0x1000 + (i & 0xff)] = static_cast<std::uint8_t>(i | 1);
+    CHECK(stats.sink_pages.load() == 1);
+    CHECK(stats.unmapped_writes.load() - writes_before <= 16);
+    CHECK(mem[20 * 0x1000 + 5] != 0);
+    ZeroSinks();
+    for (int i = 0; i < 256; ++i) CHECK(mem[20 * 0x1000 + i] == 0);
+    mem[20 * 0x1000 + 9] = 3; // still a sink: no fault, emptied again
+    ZeroSinks();
+    CHECK(mem[20 * 0x1000 + 9] == 0);
+    CHECK(stats.sink_pages.load() == 1);
+
+    // A writer walking upwards through unmapped memory: the sink range grows ahead of it, so almost no write faults, and it
+    // stops at the mapped page (which is opened, not swallowed).
+    const std::uint64_t walk_before = stats.unmapped_writes.load();
