@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "suyu_cmd/native_gpu/texture_pack.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-function"
+#pragma GCC diagnostic ignored "-Wextra"
+#pragma GCC diagnostic ignored "-Wshadow"
+#pragma GCC diagnostic ignored "-Wmissing-declarations"
+#pragma GCC diagnostic ignored "-Wunused"
+#pragma GCC diagnostic ignored "-Wmissing-field-initializers"
+#define STB_IMAGE_STATIC
+#define STB_IMAGE_IMPLEMENTATION
+#include "stb_image.h"
+#define STB_IMAGE_WRITE_STATIC
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+#pragma GCC diagnostic pop
+
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+#include "common/logging/log.h"
+
+namespace KartRecomp {
+namespace {
+
+/// The first run of 16 hex digits in a file name, or false.
+bool ParseHash(const std::string& name, uint64_t& hash) {
+    for (size_t i = 0; i + 16 <= name.size(); ++i) {
+        bool ok = true;
+        for (size_t k = 0; k < 16 && ok; ++k) {
+            ok = std::isxdigit(static_cast<unsigned char>(name[i + k])) != 0;
+        }
+        if (ok) {
+            hash = std::strtoull(name.substr(i, 16).c_str(), nullptr, 16);
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
+
+TexturePack& TexturePack::Instance() {
+    static TexturePack pack;
+    return pack;
+}
+
+TexturePack::TexturePack() {
+    namespace fs = std::filesystem;
+    // <user>/load/textures (suyu's own LoadDir points at the exe's mods folder in this build, so build it from the
+    // dump directory's parent), or KARTRECOMP_TEXTURE_PACK=<dir>.
+    fs::path load = Common::FS::GetSuyuPath(Common::FS::SuyuPath::DumpDir).parent_path() / "load" / "textures";
+    if (const char* custom = std::getenv("KARTRECOMP_TEXTURE_PACK")) {
+        load = custom;
+    }
+    std::error_code ec;
+    if (fs::is_directory(load, ec)) {
+        for (const auto& entry : fs::recursive_directory_iterator(load, ec)) {
+            if (!entry.is_regular_file() || entry.path().extension() != ".png") continue;
+            uint64_t hash = 0;
+            if (ParseHash(entry.path().filename().string(), hash)) {
+                index[hash] = entry.path();
+            }
+        }
+        LOG_INFO(Frontend, "texture pack: {} replacement(s) in {}", index.size(), load.string());
+    }
+    if (std::getenv("KARTRECOMP_TEXTURE_DUMP") != nullptr) {
+        dump = true;
+        dump_dir = Common::FS::GetSuyuPath(Common::FS::SuyuPath::DumpDir) / "textures";
+        fs::create_directories(dump_dir, ec);
+        LOG_INFO(Frontend, "texture pack: dumping textures to {}", dump_dir.string());
+    }
+}
+
+bool TexturePack::Load(uint64_t hash, PackImage& out) const {
+    const auto it = index.find(hash);
+    if (it == index.end()) return false;
+    int w = 0, h = 0, channels = 0;
+    unsigned char* data = stbi_load(it->second.string().c_str(), &w, &h, &channels, 4);
+    if (!data || w <= 0 || h <= 0) {
+        LOG_WARNING(Frontend, "texture pack: cannot read {}", it->second.string());
+        if (data) stbi_image_free(data);
+        return false;
+    }
+    out.width = static_cast<uint32_t>(w);
+    out.height = static_cast<uint32_t>(h);
+    out.rgba.assign(data, data + static_cast<size_t>(w) * h * 4);
+    stbi_image_free(data);
+    return true;
+}
+
+void TexturePack::Dump(uint64_t hash, uint32_t width, uint32_t height, const std::string& tag, const uint8_t* rgba) {
+    {
+        std::scoped_lock lock{dump_lock};
+        if (!dumped.insert(hash).second) return;
+    }
+    const auto path = dump_dir / fmt::format("{:016x}_{}x{}_{}.png", hash, width, height, tag);
+    stbi_write_png(path.string().c_str(), static_cast<int>(width), static_cast<int>(height), 4, rgba,
+                   static_cast<int>(width) * 4);
+}
+
+void TexturePack::BuildMips(const PackImage& base, std::vector<uint8_t>& out,
+                            std::vector<std::array<uint32_t, 3>>& levels) {
+    out.clear();
+    levels.clear();
+    uint32_t w = base.width, h = base.height;
+    out.insert(out.end(), base.rgba.begin(), base.rgba.end());
+    levels.push_back({w, h, 0});
+    size_t prev = 0;
+    while (w > 1 || h > 1) {
+        const uint32_t nw = std::max(1u, w / 2), nh = std::max(1u, h / 2);
+        const size_t at = out.size();
+        out.resize(at + static_cast<size_t>(nw) * nh * 4);
+        for (uint32_t y = 0; y < nh; ++y) {
+            for (uint32_t x = 0; x < nw; ++x) {
+                const uint32_t x0 = std::min(x * 2, w - 1), x1 = std::min(x * 2 + 1, w - 1);
+                const uint32_t y0 = std::min(y * 2, h - 1), y1 = std::min(y * 2 + 1, h - 1);
+                for (uint32_t c = 0; c < 4; ++c) {
+                    const uint32_t sum = out[prev + (static_cast<size_t>(y0) * w + x0) * 4 + c] +
+                                         out[prev + (static_cast<size_t>(y0) * w + x1) * 4 + c] +
+                                         out[prev + (static_cast<size_t>(y1) * w + x0) * 4 + c] +
+                                         out[prev + (static_cast<size_t>(y1) * w + x1) * 4 + c];
+                    out[at + (static_cast<size_t>(y) * nw + x) * 4 + c] = static_cast<uint8_t>((sum + 2) / 4);
+                }
+            }
+        }
+        levels.push_back({nw, nh, static_cast<uint32_t>(at)});
+        prev = at;
+        w = nw;
+        h = nh;
+    }
+}
+
+} // namespace KartRecomp
diff --git a/src/suyu_cmd/native_gpu/texture_pack.h b/src/suyu_cmd/native_gpu/texture_pack.h
new file mode 100644
index 0000000000..e8bd970ace
--- /dev/null
+++ b/src/suyu_cmd/native_gpu/texture_pack.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: custom textures for the native renderer (a texture pack, e.g. a 4K UI).
+//
+//   KARTRECOMP_TEXTURE_DUMP=1   writes every colour texture the game uploads, once, as an RGBA8 PNG:
+//                               <user>/dump/textures/<hash16>_<w>x<h>_<tag>.png
+//   <user>/load/textures/       any *.png whose name contains a 16-hex-digit hash replaces that texture,
+//                               at any size (a 4x version of the same picture lands in the same place:
+//                               the game samples by UV)
+//
+// The hash is the CityHash64 of the texture's guest bytes (what the dump names say). Only block-linear 2D colour
+// pictures (RGBA8/BGRA8, BC1/2/3/7, ASTC) are dumped or replaced; pitch-linear textures (the text glyph cache, video
+// frames), cube maps, arrays and 3D textures are left alone. Replacements get a box-filtered mip chain.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace KartRecomp {
+
+struct PackImage {
+    uint32_t width = 0, height = 0;
+    std::vector<uint8_t> rgba; ///< tightly packed RGBA8
+};
+
+class TexturePack {
+public:
+    static TexturePack& Instance();
+
+    bool Enabled() const { return !index.empty(); }
+    bool DumpEnabled() const { return dump; }
+    /// The replacement for a guest texture hash; false when there is none (or it can't be read).
+    bool Load(uint64_t hash, PackImage& out) const;
+    /// Writes the picture once per hash (`rgba` is width x height RGBA8).
+    void Dump(uint64_t hash, uint32_t width, uint32_t height, const std::string& tag, const uint8_t* rgba);
+    /// Box-filtered mip chain down to 1x1: `out` holds the levels back to back, `levels` their {w, h, offset}.
+    static void BuildMips(const PackImage& base, std::vector<uint8_t>& out,
+                          std::vector<std::array<uint32_t, 3>>& levels);
+
+private:
+    TexturePack();
+    std::unordered_map<uint64_t, std::filesystem::path> index;
+    bool dump = false;
+    std::filesystem::path dump_dir;
+    std::mutex dump_lock;
+    std::unordered_set<uint64_t> dumped;
+};
+
+} // namespace KartRecomp
diff --git a/src/suyu_cmd/native_gpu/upscaler.cpp b/src/suyu_cmd/native_gpu/upscaler.cpp
new file mode 100644
index 0000000000..e0db87d7c2
--- /dev/null
+++ b/src/suyu_cmd/native_gpu/upscaler.cpp
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "suyu_cmd/native_gpu/upscaler.h"
+
+#include <dlfcn.h>
+
+#include <filesystem>
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include "common/logging/log.h"
+
+namespace KartRecomp {
+namespace {
+
+// Built-in "passthrough": at equal sizes it copies colour to the output; otherwise it blits
+// with linear filtering. It exists to exercise the hook and as the baseline for comparisons.
+struct Passthrough {
+    KrUpscalerDevice dev{};
+    PFN_vkCmdBlitImage blit = nullptr;
+    PFN_vkCmdCopyImage copy = nullptr;
+    uint32_t rw = 0, rh = 0, ow = 0, oh = 0;
+};
+
+void* PassthroughCreate(const KrUpscalerDevice* d) {
+    auto* p = new Passthrough;
+    p->dev = *d;
+    p->blit = reinterpret_cast<PFN_vkCmdBlitImage>(d->get_device_proc_addr(d->device, "vkCmdBlitImage"));
+    p->copy = reinterpret_cast<PFN_vkCmdCopyImage>(d->get_device_proc_addr(d->device, "vkCmdCopyImage"));
+    if (!p->blit || !p->copy) {
+        delete p;
+        return nullptr;
+    }
+    return p;
+}
+
+int PassthroughConfigure(void* inst, uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh, VkFormat) {
+    auto* p = static_cast<Passthrough*>(inst);
+    p->rw = rw;
+    p->rh = rh;
+    p->ow = ow;
+    p->oh = oh;
+    return 0;
+}
+
+void PassthroughDispatch(void* inst, const KrUpscalerFrame* f) {
+    auto* p = static_cast<Passthrough*>(inst);
+    if (!f->color || !f->output) {
+        return;
+    }
+    VkImageBlit region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = region.srcSubresource;
+    region.srcOffsets[1] = {static_cast<int32_t>(f->render_width), static_cast<int32_t>(f->render_height), 1};
+    region.dstOffsets[1] = {static_cast<int32_t>(f->output_width), static_cast<int32_t>(f->output_height), 1};
+    p->blit(f->cmd, f->color, VK_IMAGE_LAYOUT_GENERAL, f->output, VK_IMAGE_LAYOUT_GENERAL, 1, &region,
+            VK_FILTER_LINEAR);
+}
+
+void PassthroughDestroy(void* inst) {
+    delete static_cast<Passthrough*>(inst);
+}
+
+const KrUpscalerApi kPassthrough{KR_UPSCALER_ABI_VERSION, "passthrough", PassthroughCreate, PassthroughConfigure,
+                                 PassthroughDispatch, PassthroughDestroy};
+
+} // namespace
+
+UpscalerHost::~UpscalerHost() {
+    Unload();
+}
+
+void UpscalerHost::Unload() {
+    if (api && instance) {
+        api->destroy(instance);
+    }
+    // The library stays mapped: a plugin pulls in its own dependencies (Vulkan loader helpers, static objects with exit-time
+    // destructors), and unloading it made the process crash on exit.
+    api = nullptr;
+    instance = nullptr;
+    library = nullptr;
+    cfg_rw = cfg_rh = cfg_ow = cfg_oh = 0;
+    cfg_fmt = VK_FORMAT_UNDEFINED;
+}
+
+bool UpscalerHost::Init(const KrUpscalerDevice& device) {
+    const char* want = std::getenv("KARTRECOMP_UPSCALER");
+    return want && *want && Select(device, want);
+}
+
+bool UpscalerHost::Select(const KrUpscalerDevice& device, const std::string& name) {
+    Unload();
+    if (name.empty() || name == "off") {
+        return false;
+    }
+    if (name == "passthrough") {
+        api = &kPassthrough;
+    } else {
+        const char* lib_env = std::getenv("KARTRECOMP_UPSCALER_LIB");
+        const std::string path = lib_env ? lib_env : "plugins/libkr_upscaler_" + name + ".so";
+        library = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!library) {
+            LOG_ERROR(Frontend, "upscaler '{}': cannot load {} ({})", name, path, dlerror());
+            return false;
+        }
+        const auto get = reinterpret_cast<KrUpscalerGetApi>(dlsym(library, "kr_upscaler_get_api"));
+        api = get ? get() : nullptr;
+        if (!api || api->abi_version != KR_UPSCALER_ABI_VERSION) {
+            LOG_ERROR(Frontend, "upscaler '{}': {} has no compatible kr_upscaler_get_api", name, path);
+            Unload();
+            return false;
+        }
+    }
+    instance = api->create(&device);
+    if (!instance) {
+        LOG_ERROR(Frontend, "upscaler '{}': this GPU or driver can't run it", api->name);
+        Unload();
+        return false;
+    }
+    LOG_INFO(Frontend, "upscaler '{}' ready", api->name);
+    return true;
+}
+
+bool UpscalerHost::Configure(uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh, VkFormat fmt) {
+    if (!Enabled()) {
+        return false;
+    }
+    if (rw == cfg_rw && rh == cfg_rh && ow == cfg_ow && oh == cfg_oh && fmt == cfg_fmt) {
+        return true;
+    }
+    if (api->configure(instance, rw, rh, ow, oh, fmt) != 0) {
+        LOG_ERROR(Frontend, "upscaler '{}': configure {}x{} -> {}x{} failed", api->name, rw, rh, ow, oh);
+        return false;
+    }
+    cfg_rw = rw;
+    cfg_rh = rh;
+    cfg_ow = ow;
+    cfg_oh = oh;
+    cfg_fmt = fmt;
+    return true;
+}
+
+void UpscalerHost::Dispatch(const KrUpscalerFrame& frame) {
+    if (Enabled()) {
+        api->dispatch(instance, &frame);
+    }
+}
+
+FrameGenHost::~FrameGenHost() {
+    Unload();
+}
+
+void FrameGenHost::Unload() {
+    if (api && instance) {
+        api->destroy(instance);
+    }
+    api = nullptr; // the library stays mapped, as with the upscaler plugins
+    instance = nullptr;
+    library = nullptr;
+    cfg_rw = cfg_rh = cfg_ow = cfg_oh = 0;
+    cfg_fmt = VK_FORMAT_UNDEFINED;
+}
+
+std::vector<std::string> FrameGenHost::Discover() {
+    std::vector<std::string> names;
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator("plugins", ec)) {
+        const std::string file = entry.path().filename().string();
+        if (file.rfind("libkr_framegen_", 0) == 0 && entry.path().extension() == ".so") {
+            names.push_back(file.substr(15, file.size() - 15 - 3));
+        }
+    }
+    return names;
+}
+
+bool FrameGenHost::Select(const KrUpscalerDevice& device, const std::string& name) {
+    Unload();
+    if (name.empty() || name == "builtin") {
+        return false;
+    }
+    const std::string path = "plugins/libkr_framegen_" + name + ".so";
+    library = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!library) {
+        LOG_ERROR(Frontend, "frame generation '{}': cannot load {} ({})", name, path, dlerror());
+        return false;
+    }
+    const auto get = reinterpret_cast<KrFrameGenGetApi>(dlsym(library, "kr_framegen_get_api"));
+    api = get ? get() : nullptr;
+    if (!api || api->abi_version != KR_FRAMEGEN_ABI_VERSION) {
+        LOG_ERROR(Frontend, "frame generation '{}': {} has no compatible kr_framegen_get_api", name, path);
+        Unload();
+        return false;
+    }
+    instance = api->create(&device);
+    if (!instance) {
+        LOG_ERROR(Frontend, "frame generation '{}': this GPU or driver can't run it", api->name);
+        Unload();
+        return false;
+    }
+    LOG_INFO(Frontend, "frame generation '{}' ready", api->name);
+    return true;
+}
+
+bool FrameGenHost::Configure(uint32_t rw, uint32_t rh, uint32_t ow, uint32_t oh, VkFormat fmt) {
+    if (!Enabled()) {
+        return false;
+    }
+    if (rw == cfg_rw && rh == cfg_rh && ow == cfg_ow && oh == cfg_oh && fmt == cfg_fmt) {
+        return true;
+    }
+    if (api->configure(instance, rw, rh, ow, oh, fmt) != 0) {
+        LOG_ERROR(Frontend, "frame generation '{}': configure {}x{} -> {}x{} failed", api->name, rw, rh, ow, oh);
+        return false;
+    }
+    cfg_rw = rw;
+    cfg_rh = rh;
+    cfg_ow = ow;
+    cfg_oh = oh;
+    cfg_fmt = fmt;
+    return true;
+}
+
+bool FrameGenHost::Dispatch(const KrFrameGenFrame& frame) {
+    return Enabled() && api->dispatch(instance, &frame) == 0;
+}
+
+} // namespace KartRecomp
diff --git a/src/suyu_cmd/native_gpu/upscaler.h b/src/suyu_cmd/native_gpu/upscaler.h
new file mode 100644
index 0000000000..9407f3a6c5
--- /dev/null
+++ b/src/suyu_cmd/native_gpu/upscaler.h
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: hook for temporal upscalers (FSR 3.1/4, DLSS, XeSS) and frame generators.
+//
+// The native renderer calls Upscaler::Dispatch once per frame at the point where the
+// scene is finished and post-processing has not started: HDR scene colour, depth, a
+// motion-vector image (zeros until motion vectors exist), this frame's camera jitter and
+// the output image. Backends are either built in (passthrough) or loaded at run time from
+// a shared library, so the game binary carries no third-party SDK code:
+//
+//   KARTRECOMP_UPSCALER=<name>      passthrough (default when set), or the name of a plugin
+//   KARTRECOMP_UPSCALER_LIB=<path>  plugin library (default: ./plugins/libkr_upscaler_<name>.so)
+//
+// A plugin exports `const KrUpscalerApi* kr_upscaler_get_api(void)`. See docs/UPSCALER.md.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <vulkan/vulkan.h>
+
+extern "C" {
+
+#define KR_UPSCALER_ABI_VERSION 1
+
+typedef struct KrUpscalerDevice {
+    VkInstance instance;
+    VkPhysicalDevice physical;
+    VkDevice device;
+    VkQueue queue;
+    uint32_t queue_family;
+    PFN_vkGetInstanceProcAddr get_instance_proc_addr;
+    PFN_vkGetDeviceProcAddr get_device_proc_addr;
+} KrUpscalerDevice;
+
+/// One frame. All images are in VK_IMAGE_LAYOUT_GENERAL and idle when Dispatch is
+/// called; the plugin records into `cmd` (already recording, outside a render pass).
+typedef struct KrUpscalerFrame {
+    VkCommandBuffer cmd;
+    VkImage color;        ///< HDR scene colour, render_width x render_height
+    VkImageView color_view;
+    VkFormat color_format;
+    VkImage depth;        ///< scene depth (reverse-Z not assumed: see depth_inverted)
+    VkImageView depth_view;
+    VkFormat depth_format;  ///< VK_FORMAT_UNDEFINED when there is no depth
+    /// The 3D scene's HDR colour (before post-processing) as it was before any alpha-blended draw, and the same colour after them,
+    /// both at the render size; null when the frame had no alpha-blended 3D draws. Upscalers derive a "reactive mask" (where
+    /// translucent effects make history untrustworthy) from the pair.
+    VkImage opaque_color;
+    VkImageView opaque_color_view;
+    VkImage scene_color;
+    VkImageView scene_color_view;
+    VkFormat scene_color_format;
+    /// R8, render size, 0..0.9: how little the camera-derived motion vector explains this pixel (animated characters, effects: no
+    /// motion data of their own). A natural reactive mask; null when unavailable.
+    VkImage mismatch_mask;
+    VkImageView mismatch_mask_view;
+    VkImage motion;       ///< RG16F motion vectors in pixels (prev = cur + mv); zeros = static
+    VkImageView motion_view;
+    VkImage output;       ///< upscaled colour, output_width x output_height, same format as color
+    VkImageView output_view;
+    uint32_t render_width, render_height;
+    uint32_t output_width, output_height;
+    float jitter_x, jitter_y;   ///< this frame's sub-pixel jitter, in render pixels
+    float delta_time_ms;
+    float camera_near, camera_far, camera_fov_y; ///< 0 when unknown
+    float sharpness;            ///< 0..1
+    float exposure;             ///< pre-exposure multiplier (1 = none)
+    uint32_t reset;             ///< 1 after a cut: drop the history
+    uint32_t depth_inverted;
+    uint64_t frame_index;
+} KrUpscalerFrame;
+
+typedef struct KrUpscalerApi {
+    uint32_t abi_version; ///< KR_UPSCALER_ABI_VERSION
+    const char* name;
+    /// Returns an opaque instance, or null when the GPU or driver can't run this backend.
+    void* (*create)(const KrUpscalerDevice* device);
+    /// (Re)configure for a size; returns 0 on success.
+    int (*configure)(void* instance, uint32_t render_w, uint32_t render_h, uint32_t out_w, uint32_t out_h,
+                     VkFormat color_format);
+    void (*dispatch)(void* instance, const KrUpscalerFrame* frame);
+    void (*destroy)(void* instance);
+} KrUpscalerApi;
+
+typedef const KrUpscalerApi* (*KrUpscalerGetApi)(void);
+
+
+// ---------------------------------------------------------------------------------------------------------- frame generation
+// A frame-generation backend (FSR 3 frame interpolation, FSR 4 / DLSS 4 where their SDKs allow it, or the host's built-in
+// interpolator) is a plugin too: a library `plugins/libkr_framegen_<name>.so`, or any upscaler plugin, exporting
+// `const KrFrameGenApi* kr_framegen_get_api(void)`. For each game frame the host hands it the previous and the current 3D image
+// (output size, display-referred, HUD not drawn yet), the motion vectors and depth the upscaler used, the camera, and an output
+// image to fill with the frame that goes between them. The host lays the HUD over the result, presents it, waits half a frame
+// and presents the real frame.
+
+#define KR_FRAMEGEN_ABI_VERSION 1
+
+/// All images are in VK_IMAGE_LAYOUT_GENERAL and idle on entry; record into `cmd` (recording, outside a render pass) and leave
+/// everything in GENERAL.
+typedef struct KrFrameGenFrame {
+    VkCommandBuffer cmd;
+    VkImage prev_color;        ///< previous frame's 3D image, output_width x output_height
+    VkImageView prev_color_view;
+    VkImage cur_color;         ///< this frame's 3D image, same size and format
+    VkImageView cur_color_view;
+    VkFormat color_format;
+    VkImage depth;             ///< scene depth at the render size (null when there is none)
+    VkImageView depth_view;
+    VkFormat depth_format;
+    VkImage motion;            ///< RG16F, render size: motion in render pixels, prev = cur + mv
+    VkImageView motion_view;
+    VkImage output;            ///< the generated frame: VK_FORMAT_R16G16B16A16_SFLOAT, output size, storage + sampled + transfer
+    VkImageView output_view;
+    uint32_t render_width, render_height;
+    uint32_t output_width, output_height;
+    float interpolation_t;     ///< where between prev (0) and cur (1) the frame sits; 0.5 for 2x
+    float jitter_x, jitter_y;  ///< this frame's camera jitter in render pixels (already removed from color; for the backend's own use)
+    float delta_time_ms;       ///< game frame time
+    float camera_near, camera_far, camera_fov_y; ///< 0 when unknown
+    float view_proj[16];       ///< this frame's view-projection rows (clip = row . (world, 1); game clip space, y up, depth 0..1), zeros when unknown
+    float prev_view_proj[16];
+    uint32_t reset;            ///< 1 after a cut: do not interpolate across it (the host skips such frames; set for backends that track state)
+    uint32_t depth_inverted;
+    uint64_t frame_index;
+} KrFrameGenFrame;
+
+typedef struct KrFrameGenApi {
+    uint32_t abi_version; ///< KR_FRAMEGEN_ABI_VERSION
+    const char* name;
+    void* (*create)(const KrUpscalerDevice* device); ///< null when the GPU or driver can't run it
+    int (*configure)(void* instance, uint32_t render_w, uint32_t render_h, uint32_t out_w, uint32_t out_h, VkFormat color_format);
+    /// Returns 0 when `output` was written; anything else makes the host fall back to presenting the real frame alone.
+    int (*dispatch)(void* instance, const KrFrameGenFrame* frame);
+    void (*destroy)(void* instance);
+} KrFrameGenApi;
+
+typedef const KrFrameGenApi* (*KrFrameGenGetApi)(void);
+
+} // extern "C"
+
+namespace KartRecomp {
+
+/// A loaded backend. Null api = disabled.
+class UpscalerHost {
+public:
+    ~UpscalerHost();
+    /// Reads KARTRECOMP_UPSCALER; returns false (and stays disabled) if unset or the backend fails.
+    bool Init(const KrUpscalerDevice& device);
+    /// Switches backend at run time ("off" or empty unloads): "passthrough" or a plugin name.
+    bool Select(const KrUpscalerDevice& device, const std::string& name);
+    void Unload();
+    bool Enabled() const { return api != nullptr && instance != nullptr; }
+    const char* Name() const { return api ? api->name : "none"; }
+    bool Configure(uint32_t render_w, uint32_t render_h, uint32_t out_w, uint32_t out_h, VkFormat fmt);
+    void Dispatch(const KrUpscalerFrame& frame);
+
+private:
+    const KrUpscalerApi* api = nullptr;
+    void* instance = nullptr;
+    void* library = nullptr;
+    uint32_t cfg_rw = 0, cfg_rh = 0, cfg_ow = 0, cfg_oh = 0;
+    VkFormat cfg_fmt = VK_FORMAT_UNDEFINED;
+};
+
+/// A loaded frame-generation backend. Null api = the built-in interpolator (or none).
+class FrameGenHost {
+public:
+    ~FrameGenHost();
+    /// Names of the frame-generation plugins found in ./plugins (libkr_framegen_<name>.so).
+    static std::vector<std::string> Discover();
+    /// "builtin" or empty unloads; otherwise loads plugins/libkr_framegen_<name>.so.
+    bool Select(const KrUpscalerDevice& device, const std::string& name);
+    void Unload();
+    bool Enabled() const { return api != nullptr && instance != nullptr; }
+    const char* Name() const { return api ? api->name : "built-in"; }
+    bool Configure(uint32_t render_w, uint32_t render_h, uint32_t out_w, uint32_t out_h, VkFormat fmt);
+    /// True when the backend wrote frame.output.
+    bool Dispatch(const KrFrameGenFrame& frame);
+
+private:
+    const KrFrameGenApi* api = nullptr;
+    void* instance = nullptr;
+    void* library = nullptr;
+    uint32_t cfg_rw = 0, cfg_rh = 0, cfg_ow = 0, cfg_oh = 0;
+    VkFormat cfg_fmt = VK_FORMAT_UNDEFINED;
+};
+
+} // namespace KartRecomp
