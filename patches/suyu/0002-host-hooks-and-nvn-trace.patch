+    // Queue
+    h["nvnQueueSubmitCommands"] = [](HookContext& ctx, State& s) {
+        const auto t0 = std::chrono::steady_clock::now();
+        SubmitData flat;
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 256; ++i) {
+            Flatten(s, Mem(ctx).Read64(ctx.x[2] + i * 8), flat, 0);
+        }
+        const auto t1 = std::chrono::steady_clock::now();
+        s.submit_flatten_ns += static_cast<u64>((t1 - t0).count());
+        for (size_t i = 0; i < s.backends.size(); ++i) {
+            const auto tb = std::chrono::steady_clock::now();
+            s.backends[i]->Submit(flat);
+            s.submit_backend_ns[std::min<size_t>(i, 3)] += static_cast<u64>((std::chrono::steady_clock::now() - tb).count());
+        }
+    };
+    h["nvnQueuePresentTexture"] = [](HookContext& ctx, State& s) {
+        const auto it = s.windows.find(ctx.x[1]);
+        const u32 index = Arg32(ctx, 2);
+        TextureDesc t;
+        if (it != s.windows.end() && index < it->second.size()) {
+            t = it->second[index];
+        }
+        for (auto& b : s.backends) {
+            b->Present(t, index);
+        }
+    };
+    // Programs (tracked by address: bound programs are the objects SetShaders configured)
+    h["nvnProgramSetShaders"] = [](HookContext& ctx, State& s) {
