+                std::string hex;
+                for (u32 w : words) hex += fmt::format(" {:x}", w);
+                KartRe::Log("nvn-control data={:#x}{}", data, hex);
+            }
+        }
+        if (datas.size() >= 2) { // graphics (compute programs have one stage)
+            for (auto& b : s.backends) {
+                b->OnProgram(datas);
+            }
+        }
