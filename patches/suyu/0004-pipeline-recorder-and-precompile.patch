+/// SHA-1 as 40 hex digits. KARTRECOMP_RECORD_PIPELINES names stage code by it for offline tools; the engine links no SHA-1.
+std::string Sha1Hex(const u8* data, size_t size) {
+    std::vector<u8> msg(data, data + size);
+    msg.push_back(0x80);
+    while (msg.size() % 64 != 56) msg.push_back(0);
+    const u64 bits = u64{size} * 8;
+    for (int i = 7; i >= 0; --i) msg.push_back(static_cast<u8>(bits >> (i * 8)));
+    u32 h[5] = {0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0};
+    for (size_t at = 0; at < msg.size(); at += 64) {
+        u32 w[80];
+        for (int i = 0; i < 16; ++i) {
+            const u8* p = &msg[at + 4 * i];
+            w[i] = u32{p[0]} << 24 | u32{p[1]} << 16 | u32{p[2]} << 8 | u32{p[3]};
+        }
+        for (int i = 16; i < 80; ++i) w[i] = std::rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+        u32 a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+        for (int i = 0; i < 80; ++i) {
+            const u32 f = i < 20 ? (b & c) | (~b & d) : i < 40 ? b ^ c ^ d : i < 60 ? (b & c) | (b & d) | (c & d) : b ^ c ^ d;
+            const u32 k = i < 20 ? 0x5A827999u : i < 40 ? 0x6ED9EBA1u : i < 60 ? 0x8F1BBCDCu : 0xCA62C1D6u;
+            const u32 t = std::rotl(a, 5) + f + e + k + w[i];
+            e = d;
+            d = c;
+            c = std::rotl(b, 30);
+            b = a;
+            a = t;
+        }
+        h[0] += a, h[1] += b, h[2] += c, h[3] += d, h[4] += e;
+    }
+    return fmt::format("{:08x}{:08x}{:08x}{:08x}{:08x}", h[0], h[1], h[2], h[3], h[4]);
+}
+
+/// KARTRECOMP_RECORD_PIPELINES=<file>: one line per distinct pipeline created, to build the shipped precompile list offline
+/// (format at RecordPipeline). Empty when unset, or when the SHA-1 fails its known answer.
+const std::string& RecordPipelinesPath() {
+    static const std::string path = [] {
+        const char* v = std::getenv("KARTRECOMP_RECORD_PIPELINES");
+        if (!v || !*v) return std::string{};
+        const u8 abc[] = {'a', 'b', 'c'};
+        if (Sha1Hex(abc, sizeof(abc)) != "a9993e364706816aba3e25717850c26c9cd0d89d") {
+            LOG_ERROR(Frontend, "nvn-host vulkan: SHA-1 self-check failed, KARTRECOMP_RECORD_PIPELINES ignored");
+            return std::string{};
+        }
+        return std::string{v};
+    }();
+    return path;
+}
+
+/// Yaz0 (Nintendo LZ77) stream at `at` of `in`: its decompressed bytes, empty when it is not one or is cut short.
+std::vector<u8> Yaz0Decode(const std::vector<u8>& in, size_t at = 0) {
+    if (in.size() < at + 16 || std::memcmp(in.data() + at, "Yaz0", 4) != 0) return {};
+    const u8* h = in.data() + at + 4;
+    const size_t size = size_t{h[0]} << 24 | size_t{h[1]} << 16 | size_t{h[2]} << 8 | h[3];
+    std::vector<u8> out;
+    out.reserve(size);
+    size_t i = at + 16;
+    while (out.size() < size) {
+        if (i >= in.size()) return {};
+        const u8 code = in[i++];
+        for (int bit = 7; bit >= 0 && out.size() < size; --bit) {
+            if (code >> bit & 1) {
+                if (i >= in.size()) return {};
+                out.push_back(in[i++]);
+                continue;
+            }
+            if (i + 2 > in.size()) return {};
+            const u8 b1 = in[i++], b2 = in[i++];
+            const size_t dist = (size_t{b1 & 0xFu} << 8 | b2) + 1;
+            size_t n = b1 >> 4;
+            if (n == 0) {
+                if (i >= in.size()) return {};
+                n = size_t{in[i++]} + 0x12;
+            } else {
+                n += 2;
+            }
+            if (dist > out.size()) return {};
+            for (; n && out.size() < size; --n) out.push_back(out[out.size() - dist]);
+        }
+    }
+    return out;
+}
+
+/// Known answer for Yaz0Decode: two literals, then a 4-byte copy from 2 back (overlapping).
+bool Yaz0SelfCheck() {
+    const std::vector<u8> in{'Y', 'a', 'z', '0', 0, 0, 0, 6, 0, 0, 0, 0, 0, 0, 0, 0, 0xC0, 'a', 'b', 0x20, 0x01};
+    const std::vector<u8> want{'a', 'b', 'a', 'b', 'a', 'b'};
+    return Yaz0Decode(in) == want;
+}
