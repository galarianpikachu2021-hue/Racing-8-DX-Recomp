+                    return false;
+                }
+                buffer_infos.push_back({ring, *off, bytes});
+                w.pBufferInfo = &buffer_infos.back();
+                w.descriptorCount = 1;
+            } else if (d.type == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER) {
+                const auto& td = stage.info.texture_descriptors[d.desc_index];
+                if (slot_logs < 60 || (dump_frame && pass_index > 30)) {
+                    ++slot_logs;
+                    std::string bound;
+                    for (u32 b = 0; b < 32; ++b) {
+                        if (st.textures[nvn_stage][b]) bound += fmt::format("{}:{:x} ", b, st.textures[nvn_stage][b]);
+                    }
+                    KartRe::Log("texdesc pass{:03} stage={} cbuf={} off={:#x} shift={} sec={} sec_cbuf={} "
+                                "sec_off={:#x} type={} depth={} count={} | bound {}",
+                                pass_index, nvn_stage, td.cbuf_index, td.cbuf_offset, td.shift_left,
+                                td.has_secondary, td.secondary_cbuf_index, td.secondary_cbuf_offset,
+                                static_cast<int>(td.type), td.is_depth, td.count, bound);
+                }
+                const size_t first_info = image_infos.size();
+                for (u32 e = 0; e < d.count; ++e) {
+                    image_infos.push_back(ResolveTexture(st, nvn_stage, td, e));
+                    if (last_resolve_scaled && std::fabs(last_resolve_scale - pass_scale) < 1e-4f &&
+                        texture_bit < 32 * texture_scaled_bits.size()) {
+                        texture_scaled_bits[texture_bit / 32] |= 1u << (texture_bit % 32);
+                    }
+                    ++texture_bit;
+                }
+                w.pImageInfo = &image_infos[first_info];
+            }
+            writes.push_back(w);
+        }
+        {
+            std::string key;
+            const auto put = [&key](const void* p, size_t n) { key.append(static_cast<const char*>(p), n); };
+            put(&prog->set_layout, sizeof(prog->set_layout));
+            for (const auto& w : writes) {
+                put(&w.dstBinding, sizeof(w.dstBinding));
+                put(&w.descriptorType, sizeof(w.descriptorType));
+                for (u32 k = 0; k < w.descriptorCount; ++k) {
+                    if (w.pBufferInfo) put(&w.pBufferInfo[k], sizeof(VkDescriptorBufferInfo));
+                    if (w.pImageInfo) put(&w.pImageInfo[k], sizeof(VkDescriptorImageInfo));
+                }
+            }
+            if (const auto it = descriptor_cache.find(key); it != descriptor_cache.end()) {
+                set = it->second;
+                ++descriptor_cache_hits;
+            } else {
+                VkDescriptorSetAllocateInfo dsai{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+                dsai.descriptorPool = descriptor_pool;
+                dsai.descriptorSetCount = 1;
+                dsai.pSetLayouts = &prog->set_layout;
+                if (vk.vkAllocateDescriptorSets(device, &dsai, &set) != VK_SUCCESS) {
+                    ++skip_descriptors;
+                    return false;
+                }
+                for (auto& w : writes) w.dstSet = set;
+                vk.vkUpdateDescriptorSets(device, static_cast<u32>(writes.size()), writes.data(), 0, nullptr);
+                descriptor_cache.emplace(std::move(key), set);
+            }
+        }
+
+        if (hit_deferred) {
+            hit_deferred = false;
+            ++skip_deferred;
+            return false;
+        }
+        if (!BeginRendering(st)) {
+            ++skip_no_target;
+            return false;
+        }
+        CaptureOpaqueColor(st);
+        const VkPipeline pipeline = GetPipeline(*prog, st, *topology, attrs, binds);
+        if (!pipeline) {
+            return false;
+        }
+
+        vk.vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+        vk.vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, prog->layout, 0, 1, &set, 0,
+                                   nullptr);
+        std::array<u8, kPushSize> push{};
+        // Resolution scaling (suyu's rescaling pass in the shaders): which textures
+        // are scaled images, and the scale of the pass being rendered.
+        std::memcpy(push.data() + Shader::Backend::SPIRV::RESCALING_LAYOUT_WORDS_OFFSET,
+                    texture_scaled_bits.data(), sizeof(texture_scaled_bits));
+        const float down_factor = 1.0f / pass_scale;
+        std::memcpy(push.data() + Shader::Backend::SPIRV::RESCALING_LAYOUT_DOWN_FACTOR_OFFSET,
+                    &down_factor, sizeof(down_factor));
+        const float area[4] = {static_cast<float>(render_width), static_cast<float>(render_height),
+                               0.0f, 0.0f};
+        std::memcpy(push.data() + sizeof(Shader::Backend::SPIRV::RescalingLayout), area, sizeof(area));
+        vk.vkCmdPushConstants(cmd, prog->layout, VK_SHADER_STAGE_ALL_GRAPHICS, 0, kPushSize,
+                              push.data());
+        // The game sets NVN window origin mode 1 (upper-left) and the Switch presents its
+        // window buffer with no transform (checked on the emulated path: transform 0).
+        // Vulkan maps NDC y=-1 to row 0, so flip with a negative-height viewport.
+        const float vs = pass_scale;
+        const bool flip = !IsShadowMapPass(st);
+        VkViewport vp{static_cast<float>(st.viewport[0]) * vs,
+                      static_cast<float>(flip ? st.viewport[1] + st.viewport[3] : st.viewport[1]) * vs,
+                      static_cast<float>(st.viewport[2]) * vs,
+                      (flip ? -1.0f : 1.0f) * static_cast<float>(st.viewport[3]) * vs,
+                      std::clamp(st.depth_near, 0.0f, 1.0f), std::clamp(st.depth_far, 0.0f, 1.0f)};
+        // Camera jitter for upscalers (KARTRECOMP_JITTER=1, or fixed:<px> to test): the scene's
+        // passes (a color target plus a depth target, no shadow maps) get their viewport shifted by
+        // a fraction of a pixel, which moves everything drawn like a jittered projection would.
+        // HUD, post-processing and menus have no depth target and stay put.
+        if (jitter_frame && !st.colors.empty() && st.colors[0] && st.depth && st.depth->info.format != VK_FORMAT_D16_UNORM) {
+            vp.x += jitter_x; // render pixels, whatever the scale
+            vp.y += jitter_y;
+            ++jitter_draws;
+        } else if (jitter_frame && !st.colors.empty() && st.colors[0] && st.colors[0]->guest_width == current_frame->present.width &&
+                   !post_phase) {
+            ++jitter_skipped_draws; // a screen-size colour pass that isn't jittered (no depth target)
+            if (jitter_skip_logs < 12 && std::getenv("KARTRECOMP_JITTER_LOG")) {
+                ++jitter_skip_logs;
+                LOG_INFO(Frontend, "jitter: unjittered screen-size draw in pass {} (colour fmt {}, depth {}), draw {}", pass_index,
+                         static_cast<int>(st.colors[0]->info.format), st.depth ? static_cast<int>(st.depth->info.format) : 0, pass_draws);
+            }
+        }
+        vk.vkCmdSetViewport(cmd, 0, 1, &vp);
+        const auto sc_scale = [&](s32 v) { return static_cast<s32>(ScaleDim(static_cast<u32>(std::max(0, v)), pass_scale)); };
+        VkRect2D sc{{std::max(0, sc_scale(st.scissor[0])), std::max(0, sc_scale(st.scissor[1]))},
+                    {static_cast<u32>(std::max(1, sc_scale(st.scissor[2]))),
+                     static_cast<u32>(std::max(1, sc_scale(st.scissor[3])))}};
+        vk.vkCmdSetScissor(cmd, 0, 1, &sc);
+        // Same conversion as suyu (NVN units are already the hardware's halved value).
+        vk.vkCmdSetDepthBias(cmd, st.bias_units, st.bias_clamp, st.bias_factor);
+        vk.vkCmdSetBlendConstants(cmd, st.blend_color);
+        if (KartRe::Enabled() && !st.colors.empty() && st.colors[0] && chain_logs < 60) {
+            const u32 lw = std::max(1u, st.colors[0]->guest_width >> (st.color_levels.empty() ? 0 : st.color_levels[0]));
+            const u32 lh = std::max(1u, st.colors[0]->guest_height >> (st.color_levels.empty() ? 0 : st.color_levels[0]));
+            if ((lw == 60 && lh == 34) || (lw == 120 && lh == 68) || (lw == 240 && lh == 136) || (lw == 30 && lh == 17)) {
+                ++chain_logs;
+                KartRe::Log("nat-chain rt={}x{} color={:#x} blend0={:#x} const {} {} {} {} fs={:#x}", lw, lh, st.color,
+                            st.blend[0], st.blend_color[0], st.blend_color[1], st.blend_color[2], st.blend_color[3],
+                            prog->stages.back().data + 0x30);
+            }
+        }
+        if (dump_frame && st.blend[0] == 0x61026102110c0000ULL && blendc_logs < 20) {
+            ++blendc_logs;
+            KartRe::Log("dumpframe pass{:03} const-blend draw: color state {:#x} (blend mask {:#x}) blend color {} {} {} {}",
+                        pass_index, st.color, (st.color >> 8) & 0xFF, st.blend_color[0], st.blend_color[1],
+                        st.blend_color[2], st.blend_color[3]);
+        }
+        if (!vb_buffers.empty()) {
+            vk.vkCmdBindVertexBuffers(cmd, 0, static_cast<u32>(vb_buffers.size()), vb_buffers.data(),
+                                      vb_offsets.data());
+        }
+        if (indexed) {
+            vk.vkCmdBindIndexBuffer(cmd, ring, index_offset, vk_index);
+            vk.vkCmdDrawIndexed(cmd, count, instance_count, 0, base_vertex, base_instance);
+        } else {
+            vk.vkCmdDraw(cmd, count, instance_count, first, base_instance);
+        }
+        ++draws_executed;
+        ++pass_draws;
+        if (dump_frame) {
+            PickAfterDraw(st, *prog);
+        }
+        for (Image* img : st.colors) {
+            if (img && std::find(drawn_targets.begin(), drawn_targets.end(), img) == drawn_targets.end()) {
+                drawn_targets.push_back(img);
+            }
+        }
+        return true;
+    }
+
+    /// Texture for one sampler descriptor element: a native render target when
+    /// the game samples one, otherwise a white stand-in of the right type.
+    VkDescriptorImageInfo ResolveTexture(const DrawState& st, int nvn_stage,
+                                         const Shader::TextureDescriptor& td, u32 element) {
+        last_resolve_scaled = false;
+        static const bool white_bloom = [] {
+            const char* t = std::getenv("KARTRECOMP_NATIVE_SIMPLE");
+            return t && std::strstr(t, "whitebloom");
+        }();
+        if (white_bloom && st.blend[0] == 0x61026102110c0000ULL) {
+            return {sampler, dummy_2d.sample_view, VK_IMAGE_LAYOUT_GENERAL};
+        }
+        VkDescriptorImageInfo info{td.is_depth ? shadow_sampler : sampler, VK_NULL_HANDLE,
+                                   VK_IMAGE_LAYOUT_GENERAL};
+        const u32 slot = TextureSlot(td.cbuf_offset) + element;
+        VkImageViewType native_type = VK_IMAGE_VIEW_TYPE_MAX_ENUM;
+        switch (td.type) {
+        case Shader::TextureType::Color2D: native_type = VK_IMAGE_VIEW_TYPE_2D; break;
+        case Shader::TextureType::ColorArray2D: native_type = VK_IMAGE_VIEW_TYPE_2D_ARRAY; break;
+        case Shader::TextureType::ColorCube: native_type = VK_IMAGE_VIEW_TYPE_CUBE; break;
+        case Shader::TextureType::ColorArrayCube: native_type = VK_IMAGE_VIEW_TYPE_CUBE_ARRAY; break;
+        case Shader::TextureType::Color3D: native_type = VK_IMAGE_VIEW_TYPE_3D; break;
+        default: break;
+        }
+        if (td.cbuf_index == 2 && slot < 32 && native_type != VK_IMAGE_VIEW_TYPE_MAX_ENUM) {
+            const u64 handle = st.textures[nvn_stage][slot];
+            if (handle != 0) {
+                const TextureDesc t = Core::NvnHost::LookupTextureId(static_cast<u32>(handle & 0xFFFFF));
+                Image* img = GetImage(t, false);
+                if (!img) {
+                    // A view of a native target in another format: same storage, same size.
+                    img = FindImageByStorage(t);
+                }
+                if (dump_frame) {
+                    KartRe::Log("dumpframe pass{:03} tex slot={} id={:#x} desc valid={} {}x{} fmt {} "
+                                "pool={:#x} off={:#x} -> {}",
+                                pass_index, slot, handle & 0xFFFFF, t.valid, t.width, t.height,
+                                t.format, t.pool, t.offset,
+                                img ? fmt::format("native {}x{} vk{}", img->width, img->height,
+                                                  static_cast<int>(img->info.format))
+                                    : std::string{"no native image"});
+                }
+                // Depth targets may be read as plain textures (deferred lighting
+                // reconstructs positions from depth): sample their depth aspect.
+                // Only a compare sampler needs a depth image.
+                if (dump_frame && t.width <= 4 && t.height <= 4) {
+                    u8 bytes[64]{};
+                    Tegra::Texture::TICEntry tic{};
+                    const bool have_tic = Core::NvnHost::ReadTextureDescriptor(static_cast<u32>(handle & 0xFFFFF), &tic);
+                    if (have_tic) Core::NvnHost::ReadGpuMemory(tic.Address(), bytes, sizeof(bytes));
+                    std::string hex;
+                    for (u8 b : bytes) hex += fmt::format("{:02x}", b);
+                    KartRe::Log("tiny texture id={:#x} {}x{} fmt {} pool={:#x} off={:#x} native={} gpu={:#x} bytes {}",
+                                handle & 0xFFFFF, t.width, t.height, t.format, t.pool, t.offset, img != nullptr,
+                                have_tic ? tic.Address() : 0, hex);
+                }
+                if (img && t.width >= 2048 && big_logged.insert(handle & 0xFFFFF).second) {
+                    KartRe::Log("big texture resolved to a native image: id={:#x} {}x{} fmt {} pool={:#x} off={:#x}",
+                                handle & 0xFFFFF, t.width, t.height, t.format, t.pool, t.offset);
+                }
+                if (img && (img->info.depth || !td.is_depth)) {
+                    const auto as = MapFormat(t.format);
+                    // The texture's own channel swizzle (TIC), e.g. views that read a
+                    // G-buffer or light buffer with channels rearranged.
+                    VkComponentMapping swz{};
+                    u32 base_level = 0, level_count = ~0u;
+                    bool pinned_lod = false;
+                    if (Tegra::Texture::TICEntry tic{};
+                        Core::NvnHost::ReadTextureDescriptor(static_cast<u32>(handle & 0xFFFFF), &tic)) {
+                        // The view's mip range (bloom samples one level of its chain).
+                        base_level = tic.res_min_mip_level;
+                        level_count = tic.res_max_mip_level - tic.res_min_mip_level + 1;
+                        // A sampler pinned to one LOD (the bloom chain reads level N+1
+                        // while rendering level N of the same image): view only that
+                        // level, so the view never overlaps the attachment.
+                        if (Tegra::Texture::TSCEntry tsc{};
+                            Core::NvnHost::ReadSamplerDescriptor(static_cast<u32>((handle >> 20) & 0xFFF), &tsc) &&
+                            tsc.mipmap_filter != Tegra::Texture::TextureMipmapFilter::None &&
+                            tsc.MinLod() == tsc.MaxLod() && tsc.LodBias() == 0.0f) {
+                            const u32 lod = static_cast<u32>(tsc.MinLod());
+                            if (static_cast<float>(lod) == tsc.MinLod() && lod < level_count) {
+                                base_level += lod;
+                                level_count = 1;
+                                pinned_lod = true;
+                            }
+                        }
+                        if (dump_frame && img->levels > 1 && img->guest_width == 480 && miprange_logs < 100) {
+                            ++miprange_logs;
+                            Tegra::Texture::TSCEntry tsc{};
+                            Core::NvnHost::ReadSamplerDescriptor(static_cast<u32>((handle >> 20) & 0xFFF), &tsc);
+                            KartRe::Log("dumpframe pass{:03} mip view id={:#x} tic levels {}..{} (image {}) tsc lod {}..{} bias {} mipfilter {} rendering level {}",
+                                        pass_index, handle & 0xFFFFF, base_level, tic.res_max_mip_level.Value(), img->levels,
+                                        tsc.MinLod(), tsc.MaxLod(), tsc.LodBias(), static_cast<u32>(tsc.mipmap_filter.Value()),
+                                        st.color_levels.empty() ? 0 : st.color_levels[0]);
+                        }
+                        const VideoCommon::ImageInfo ti{tic};
+                        swz = FixSwizzle(ti.format, {MapSwizzle(tic.x_source), MapSwizzle(tic.y_source),
+                                                     MapSwizzle(tic.z_source), MapSwizzle(tic.w_source)});
+                        if (swz.r == VK_COMPONENT_SWIZZLE_R && swz.g == VK_COMPONENT_SWIZZLE_G &&
+                            swz.b == VK_COMPONENT_SWIZZLE_B && swz.a == VK_COMPONENT_SWIZZLE_A) {
+                            swz = {};
+                        }
+                        if (dump_frame && (swz.r || swz.g || swz.b || swz.a) && swizzle_logs < 200) {
+                            ++swizzle_logs;
+                            KartRe::Log("native texture swizzle id={:#x} {}x{} fmt {} -> {} {} {} {}", handle & 0xFFFFF,
+                                        t.width, t.height, t.format, static_cast<int>(swz.r), static_cast<int>(swz.g),
+                                        static_cast<int>(swz.b), static_cast<int>(swz.a));
+                        }
+                    }
+                    const VkImageView view = SampleViewFor(
+                        img, img->info.depth ? img->info.format : (as ? as->format : img->info.format),
+                        native_type, swz, base_level, level_count);
+                    if (view) {
+                        Prepare(img);
+                        info.imageView = view;
+                        // The view starts at the pinned level: sample it at LOD 0.
+                        info.sampler = pinned_lod ? GameSampler(handle, td.is_depth, true) : GameSampler(handle, td.is_depth);
+                        last_resolve_scaled = img->scaled;
+                        last_resolve_scale = img->scale;
+                        ++textures_native;
+                        return info;
+                    }
+                }
+            }
+        }
+        // Not a native render target: upload it from guest memory via its TIC.
+        if (td.cbuf_index == 2 && slot < 32 && !td.is_depth) {
+            const u64 handle = st.textures[nvn_stage][slot];
+            // Debug: KARTRECOMP_NATIVE_WHITE=w[,w...] replaces guest textures of
+            // those widths with the white stand-in (isolates a bad upload).
+            // "pfN" entries match textures 4000+ wide of PixelFormat N (lightmap atlases).
+            static const std::vector<std::string> white_specs = [] {
+                std::vector<std::string> out;
+                if (const char* v = std::getenv("KARTRECOMP_NATIVE_WHITE")) {
+                    std::string all = v;
+                    for (size_t a = 0; a <= all.size();) {
+                        const size_t b = std::min(all.find(',', a), all.size());
+                        if (b > a) out.push_back(all.substr(a, b - a));
+                        a = b + 1;
+                    }
+                }
+                return out;
+            }();
+            bool forced_white = false;
+            if (handle != 0 && !white_specs.empty()) {
+                Tegra::Texture::TICEntry tic{};
+                if (Core::NvnHost::ReadTextureDescriptor(static_cast<u32>(handle & 0xFFFFF), &tic)) {
+                    const VideoCommon::ImageInfo ti{tic};
+                    for (const auto& spec : white_specs) {
+                        if (spec.starts_with("pf")) {
+                            forced_white |= ti.size.width >= 4000 &&
+                                            static_cast<int>(ti.format) == std::atoi(spec.c_str() + 2);
+                        } else {
+                            forced_white |= ti.size.width == static_cast<u32>(std::atoi(spec.c_str()));
+                        }
+                    }
+                }
+            }
+            if (handle != 0 && !forced_white) {
+                if (const VkImageView view = GetSampledView(static_cast<u32>(handle & 0xFFFFF), td.type)) {
+                    if (dump_frame && td.type == Shader::TextureType::Color3D) {
+                        Tegra::Texture::TICEntry tic{};
+                        Core::NvnHost::ReadTextureDescriptor(static_cast<u32>(handle & 0xFFFFF), &tic);
+                        const TextureDesc td3 = Core::NvnHost::LookupTextureId(static_cast<u32>(handle & 0xFFFFF));
+                        KartRe::Log("3d slot uploaded: slot={} id={:#x} gpu={:#x} desc {}x{}x{} f{} t{} pool={:#x} off={:#x}",
+                                    slot, handle & 0xFFFFF, tic.Address(), td3.width, td3.height, td3.depth,
+                                    td3.format, td3.target, td3.pool, td3.offset);
+                    }
+                    info.imageView = view;
+                    info.sampler = GameSampler(handle, false, false,
+                                               IsMaterialTexture(Core::NvnHost::LookupTextureId(static_cast<u32>(handle & 0xFFFFF))));
+                    ++textures_uploaded;
+                    return info;
+                }
+            }
+        }
+        if (dump_frame && td.type == Shader::TextureType::Color3D) {
+            KartRe::Log("3d slot resolved to dummy: slot={} handle={:#x}", slot,
+                        slot < 32 ? st.textures[nvn_stage][slot] : 0);
+        }
+        ++textures_dummy;
+        {
+            const char* reason = "upload/view failed";
+            if (td.cbuf_index != 2) reason = "not cbuf2 (bindless)";
+            else if (slot >= 32) reason = "slot>=32";
+            else if (st.textures[nvn_stage][slot] == 0) reason = "no handle bound";
+            else if (td.is_depth) reason = "depth compare texture";
+            ++dummy_reasons[fmt::format("{} type={}", reason, static_cast<int>(td.type))];
+        }
+        info.sampler = sampler;
+        switch (td.type) {
+        case Shader::TextureType::ColorArray2D: info.imageView = dummy_2d_array.sample_view; break;
+        case Shader::TextureType::ColorCube: info.imageView = dummy_cube.sample_view; break;
+        case Shader::TextureType::ColorArrayCube: info.imageView = dummy_cube_array.sample_view; break;
+        case Shader::TextureType::Color3D: info.imageView = dummy_3d.sample_view; break;
+        default: info.imageView = dummy_2d.sample_view; break;
+        }
+        if (td.is_depth) {
+            info.sampler = shadow_sampler;
+            info.imageView = td.type == Shader::TextureType::ColorArray2D ? dummy_depth_array_view
+                                                                           : dummy_depth.sample_view;
+        }
+        return info;
+    }
+
+    static u64 TicKey(const Tegra::Texture::TICEntry& tic) {
+        const auto* w = reinterpret_cast<const u64*>(&tic);
+        return w[0] * 0x9E3779B97F4A7C15ULL ^ w[1] * 0xC2B2AE3D27D4EB4FULL ^ w[2] * 31 ^ w[3];
+    }
+
+    /// View of a guest texture for a sampler of the given type; uploads on first
+    /// use. Null when the texture cannot be uploaded yet (falls back to a stand-in).
+    VkImageView GetSampledView(u32 id, Shader::TextureType type) {
+        Tegra::Texture::TICEntry tic{};
+        if (!Core::NvnHost::ReadTextureDescriptor(id, &tic)) {
+            if (view_fail_logged.insert(0x8000'0000'0000'0000ULL | id).second) {
+                KartRe::Log("sampled view: TIC {:#x} unreadable (shader type {})", id, static_cast<int>(type));
+            }
+            return VK_NULL_HANDLE;
+        }
+        const auto log_fail = [&](const char* why, u64 key) {
+            if (view_fail_logged.insert(key).second && view_fail_logged.size() < 400) {
+                const VideoCommon::ImageInfo info{tic};
+                KartRe::Log("sampled view failed ({}): id={:#x} shader type {} gpu={:#x} tic_type={} "
+                            "format={} {}x{}x{} levels={} layers={}",
+                            why, id, static_cast<int>(type), tic.Address(),
+                            static_cast<int>(tic.texture_type.Value()), static_cast<int>(info.format),
+                            info.size.width, info.size.height, info.size.depth, info.resources.levels,
+                            info.resources.layers);
+            }
+        };
+        const u64 key = TicKey(tic);
+        auto it = sampled.find(key);
+        if (it == sampled.end() && tic.Width() >= 2048 && big_logged.insert(key).second) {
+            const VideoCommon::ImageInfo info{tic};
+            KartRe::Log("big texture first use: id={:#x} gpu={:#x} tic {}x{} info {}x{}x{} type={} pf={} "
+                        "levels={} block_h={} shader type {}",
+                        id, tic.Address(), tic.Width(), tic.Height(), info.size.width, info.size.height,
+                        info.resources.layers, static_cast<int>(info.type), static_cast<int>(info.format),
+                        info.resources.levels, info.block.height, static_cast<int>(type));
+        }
+        if (it == sampled.end() && deferred_keys.contains(key) && defer_ok) {
+            // Part of a texture burst, created within a later frame's budget. The draw that wants it is skipped for now:
+            // a few frames of missing objects are far less jarring than white stand-in surfaces. Only draws into the main
+            // screen image qualify: off-screen passes (the game renders its reflection probe once, at the race start) must
+            // never be skipped or they stay empty, so they create what they need at once.
+            hit_deferred = true;
+            return VK_NULL_HANDLE;
+        }
+        if (it == sampled.end()) {
+            SampledTexture tex = UploadTexture(tic);
+            if (!tex.ok && tex.format == VK_FORMAT_UNDEFINED) {
+                // Unsupported format: remember, so it is not retried every draw.
+                it = sampled.emplace(key, tex).first;
+            } else if (!tex.ok) {
+                return VK_NULL_HANDLE; // ring full this frame: retry next frame
+            } else {
+                it = sampled.emplace(key, tex).first;
+            }
+        }
+        Profile::Scope ps_tex{prof, Profile::TexCheck};
+        // CPU-updated textures are re-hashed: small ones every frame, larger ones
+        // every 8th frame (staggered by key), which keeps the cost bounded.
+        const bool check_now = it->second.guest_size <= (16u << 10) || ((frames + (key >> 7)) & 7) == 0;
+        // Up to 4 MB: video frames (640x360 RGBA8, written by the video decoder) are
+        // the large case. Lightmaps and other big static textures are never rechecked.
+        if (it->second.ok && it->second.guest_size <= (4u << 20) && it->second.checked_frame != frames &&
+            check_now) {
+            it->second.checked_frame = frames;
+            std::vector<u8> now(it->second.guest_size);
+            Core::NvnHost::ReadGpuMemory(it->second.gpu_address, now.data(), now.size());
+            if (HashBytes(now.data(), now.size()) != it->second.content_hash) {
+                SampledTexture fresh = UploadTexture(tic);
+                if (fresh.ok) {
+                    RetireTexture(it->second);
+                    it->second = fresh;
+                    ++textures_refreshed;
+                }
+            }
+        }
+        SampledTexture& tex = it->second;
+        tex.last_used = frames;
+        if (!tex.ok) {
+            log_fail("upload", key);
+            return VK_NULL_HANDLE;
+        }
+        VkImageViewType view_type = VK_IMAGE_VIEW_TYPE_2D;
+        switch (type) {
+        case Shader::TextureType::ColorArray2D: view_type = VK_IMAGE_VIEW_TYPE_2D_ARRAY; break;
+        case Shader::TextureType::ColorCube: view_type = VK_IMAGE_VIEW_TYPE_CUBE; break;
+        case Shader::TextureType::ColorArrayCube: view_type = VK_IMAGE_VIEW_TYPE_CUBE_ARRAY; break;
+        case Shader::TextureType::Color3D: view_type = VK_IMAGE_VIEW_TYPE_3D; break;
+        default: break;
+        }
+        // The shader's view type must be compatible with how the image was made.
+        if ((view_type == VK_IMAGE_VIEW_TYPE_3D) != tex.is_3d ||
+            ((view_type == VK_IMAGE_VIEW_TYPE_CUBE || view_type == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY) &&
+             (!tex.cube || tex.layers % 6 != 0))) {
+            ++texture_view_mismatch;
+            log_fail("view type", key ^ 1);
+            return VK_NULL_HANDLE;
+        }
+        if (const auto v = tex.views.find(view_type); v != tex.views.end()) {
+            return v->second;
+        }
+        VkImageViewCreateInfo vci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vci.image = tex.image;
+        vci.viewType = view_type;
+        vci.format = tex.format;
+        vci.components = tex.swizzle;
+        u32 layers = tex.layers;
+        if (view_type == VK_IMAGE_VIEW_TYPE_2D || view_type == VK_IMAGE_VIEW_TYPE_3D) layers = 1;
+        if (view_type == VK_IMAGE_VIEW_TYPE_CUBE) layers = 6;
+        vci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, tex.levels, 0, layers};
+        VkImageView view = VK_NULL_HANDLE;
+        vk.vkCreateImageView(device, &vci, nullptr, &view);
+        tex.views[view_type] = view;
+        return view;
+    }
+
+    /// Destroys a replaced texture once the GPU is done with the frame using it.
+    void RetireTexture(SampledTexture& t) {
+        retired.push_back(t);
+    }
+
+    /// A one-off host-visible buffer holding `size` bytes of `data`, freed by
+    /// DestroyRetired once the frame that copies from it has finished.
+    std::optional<VkBuffer> CreateStaging(const void* data, u64 size) {
+        VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        bci.size = size;
+        bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+        VkBuffer buffer = VK_NULL_HANDLE;
+        if (vk.vkCreateBuffer(device, &bci, nullptr, &buffer) != VK_SUCCESS) {
+            return std::nullopt;
+        }
+        VkMemoryRequirements req;
+        vk.vkGetBufferMemoryRequirements(device, buffer, &req);
+        const auto type = FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                             VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = type.value_or(0);
+        VkDeviceMemory memory = VK_NULL_HANDLE;
+        if (!type || vk.vkAllocateMemory(device, &mai, nullptr, &memory) != VK_SUCCESS) {
+            vk.vkDestroyBuffer(device, buffer, nullptr);
+            return std::nullopt;
+        }
+        vk.vkBindBufferMemory(device, buffer, memory, 0);
+        void* mapped = nullptr;
+        vk.vkMapMemory(device, memory, 0, size, 0, &mapped);
+        std::memcpy(mapped, data, size);
+        vk.vkUnmapMemory(device, memory);
+        staging_retired.push_back({buffer, memory});
+        return buffer;
+    }
+
+    void DestroyRetired() {
+        for (auto& [buffer, memory] : staging_retired_prev) {
+            vk.vkDestroyBuffer(device, buffer, nullptr);
+            vk.vkFreeMemory(device, memory, nullptr);
+        }
+        staging_retired_prev = std::move(staging_retired);
+        staging_retired.clear();
+        for (auto& t : retired_prev) {
+            for (auto& [type, v] : t.views) vk.vkDestroyImageView(device, v, nullptr);
+            vk.vkDestroyImage(device, t.image, nullptr);
+            vk.vkFreeMemory(device, t.memory, nullptr);
+        }
+        retired_prev = std::move(retired);
+        retired.clear();
+    }
+
+    SampledTexture UploadTexture(const Tegra::Texture::TICEntry& tic) {
+        SampledTexture tex = UploadTextureInner(tic);
+        if (!tex.ok && upload_fail_logs < 60) {
+            ++upload_fail_logs;
+            const VideoCommon::ImageInfo info{tic};
+            KartRe::Log("texture upload failed: gpu={:#x} type={} format={} {}x{}x{} levels={} layers={} "
+                        "vkfmt={} tic_type={}",
+                        tic.Address(), static_cast<int>(info.type), static_cast<int>(info.format),
+                        info.size.width, info.size.height, info.size.depth, info.resources.levels,
+                        info.resources.layers, static_cast<int>(tex.format),
+                        static_cast<int>(tic.texture_type.Value()));
+        }
+        return tex;
+    }
+
+    /// Debug (KARTRECOMP_NATIVE_TEXDUMP=width): decode level 0 / layer 0 of BC1/BC3
+    /// guest textures of that width on the CPU (one texel per 4x4 block) and write
+    /// it as native_dump/tex_<gpu>_<w>x<h>_pf<format>.ppm.
+    void DebugDumpTexture(const Tegra::Texture::TICEntry& tic, const VideoCommon::ImageInfo& info,
+                          const std::vector<u8>& data,
+                          const boost::container::small_vector<VideoCommon::BufferImageCopy, 16>& copies) const {
+        static const u32 want = [] {
+            const char* v = std::getenv("KARTRECOMP_NATIVE_TEXDUMP");
+            return v ? static_cast<u32>(std::strtoul(v, nullptr, 10)) : 0u;
+        }();
+        using P = VideoCore::Surface::PixelFormat;
+        const bool bc1 = info.format == P::BC1_RGBA_UNORM || info.format == P::BC1_RGBA_SRGB;
+        const bool bc3 = info.format == P::BC3_UNORM || info.format == P::BC3_SRGB;
+        if (want == 0 || info.size.width < want || copies.empty()) {
+            return;
+        }
+        if (!bc1 && !bc3) {
+            // Uncompressed 4-byte texels: level 0 bytes as RGB.
+            if (VideoCore::Surface::BytesPerBlock(info.format) != 4) return;
+            const auto& c0 = copies[0];
+            const u32 w = info.size.width, h = info.size.height;
+            const u32 row = c0.buffer_row_length ? c0.buffer_row_length : w;
+            const auto dir = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "native_dump";
+            std::filesystem::create_directories(dir);
+            static std::atomic<int> n{0};
+            std::ofstream out(dir / fmt::format("tex_{:x}_{}x{}_pf{}_{}.ppm", tic.Address(), w, h,
+                                                static_cast<int>(info.format), n++),
+                              std::ios::binary);
+            out << "P6\n" << w << " " << h << "\n255\n";
+            u64 nonzero = 0;
+            for (u32 y = 0; y < h; ++y) {
+                for (u32 x = 0; x < w; ++x) {
+                    const u64 at = c0.buffer_offset + (static_cast<u64>(y) * row + x) * 4;
+                    const u8* px = at + 4 <= data.size() ? data.data() + at : nullptr;
+                    const u8 rgb[3]{px ? px[0] : u8{0}, px ? px[1] : u8{0}, px ? px[2] : u8{0}};
+                    nonzero += px && (px[0] | px[1] | px[2]);
+                    out.write(reinterpret_cast<const char*>(rgb), 3);
+                }
+            }
+            LOG_INFO(Frontend, "nvn-host vulkan: texdump {}x{} pf{} type {} nonzero texels {}", w, h,
+                     static_cast<int>(info.format), static_cast<int>(info.type), nonzero);
+            return;
+        }
+        const auto& c0 = copies[0];
+        const u32 bw = (info.size.width + 3) / 4, bh = (info.size.height + 3) / 4;
+        const u32 block = bc1 ? 8 : 16;
+        const u32 row_blocks = c0.buffer_row_length ? (c0.buffer_row_length + 3) / 4 : bw;
+        const auto dir = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "native_dump";
+        std::filesystem::create_directories(dir);
+        std::ofstream out(dir / fmt::format("tex_{:x}_{}x{}_pf{}.ppm", tic.Address(), info.size.width,
+                                            info.size.height, static_cast<int>(info.format)),
+                          std::ios::binary);
+        const u32 step = std::max<u32>(1, bw / 1024);
+        out << "P6\n" << bw / step << " " << bh / step << "\n255\n";
+        u64 nonzero = 0;
+        for (u32 by = 0; by + step <= bh; by += step) {
+            for (u32 bx = 0; bx + step <= bw; bx += step) {
+                const u64 at = c0.buffer_offset + (static_cast<u64>(by) * row_blocks + bx) * block + (bc3 ? 8 : 0);
+                u8 rgb[3]{};
+                if (at + 2 <= data.size()) {
+                    u16 c;
+                    std::memcpy(&c, data.data() + at, 2);
+                    rgb[0] = static_cast<u8>(((c >> 11) & 31) * 255 / 31);
+                    rgb[1] = static_cast<u8>(((c >> 5) & 63) * 255 / 63);
+                    rgb[2] = static_cast<u8>((c & 31) * 255 / 31);
+                    nonzero += c != 0;
+                }
+                out.write(reinterpret_cast<const char*>(rgb), 3);
+            }
+        }
+        KartRe::Log("texdump gpu={:#x} {}x{} pf{} levels={} layers={} copies={} row_len={} img_h={} "
+                    "nonzero blocks {} (block_height {} tile_width {})",
+                    tic.Address(), info.size.width, info.size.height, static_cast<int>(info.format),
+                    info.resources.levels, info.resources.layers, copies.size(), c0.buffer_row_length,
+                    c0.buffer_image_height, nonzero, info.block.height, info.tile_width_spacing);
+        LOG_INFO(Frontend, "nvn-host vulkan: texdump {}x{} pf{} nonzero blocks {}", info.size.width,
+                 info.size.height, static_cast<int>(info.format), nonzero);
+    }
+
+    /// CPU half of a texture upload; thread-safe.
+    DecodedTexture DecodeTexture(const Tegra::Texture::TICEntry& tic) const {
+        DecodedTexture d;
+        d.info = VideoCommon::ImageInfo{tic};
+        const auto& info = d.info;
+        if (MapPixelFormat(info.format) == VK_FORMAT_UNDEFINED || info.type == VideoCommon::ImageType::Buffer ||
+            info.type == VideoCommon::ImageType::e1D || info.num_samples > 1) {
+            return d;
+        }
+        if (info.type == VideoCommon::ImageType::Linear) {
+            return DecodeLinearTexture(tic, std::move(d));
+        }
+        d.guest_size = VideoCommon::CalculateGuestSizeInBytes(info);
+        if (d.guest_size == 0 || d.guest_size > (64u << 20)) {
+            d.status = DecodedTexture::Status::TooLarge;
+            return d;
+        }
+        std::vector<u8> input(d.guest_size);
+        if (!Core::NvnHost::ReadGpuMemory(tic.Address(), input.data(), input.size())) {
+            d.status = DecodedTexture::Status::Unmapped;
+            return d;
+        }
+        d.content_hash = HashBytes(input.data(), input.size());
+        // Host size: generous upper bound (unswizzled is never larger than guest).
+        d.output.resize(static_cast<size_t>(d.guest_size) * 2 + 4096);
+        // Block-linear unswizzle never touches the memory manager (only the
+        // pitch-linear path, excluded above, reads through it).
+        alignas(Tegra::MemoryManager) static unsigned char no_mm[sizeof(Tegra::MemoryManager)];
+        d.copies = VideoCommon::UnswizzleImage(*reinterpret_cast<Tegra::MemoryManager*>(no_mm),
+                                               tic.Address(), info, input, d.output);
+        for (const auto& c : d.copies) {
+            d.host_size = std::max<size_t>(d.host_size, c.buffer_offset + c.buffer_size);
+        }
+        DebugDumpTexture(tic, info, d.output, d.copies);
+        if (VideoCore::Surface::IsPixelFormatASTC(info.format)) {
+            // No ASTC on desktop GPUs: decode each level to tightly packed RGBA8.
+            const struct {
+                u32 width, height;
+            } tile{VideoCore::Surface::DefaultBlockWidth(info.format),
+                   VideoCore::Surface::DefaultBlockHeight(info.format)};
+            u64 total = 0;
+            for (const auto& c : d.copies) {
+                total += static_cast<u64>(c.image_extent.width) * c.image_extent.height *
+                         c.image_extent.depth * c.image_subresource.num_layers * 4;
+            }
+            std::vector<u8> rgba(total);
+            u64 at = 0;
+            for (auto& c : d.copies) {
+                const u64 size = static_cast<u64>(c.image_extent.width) * c.image_extent.height *
+                                 c.image_extent.depth * c.image_subresource.num_layers * 4;
+                Tegra::Texture::ASTC::Decompress(std::span<const u8>(d.output).subspan(c.buffer_offset),
+                                                 c.image_extent.width, c.image_extent.height,
+                                                 c.image_subresource.num_layers * c.image_extent.depth,
+                                                 tile.width, tile.height, std::span<u8>(rgba).subspan(at, size));
+                c.buffer_offset = at;
+                c.buffer_size = size;
+                c.buffer_row_length = 0;
+                c.buffer_image_height = 0;
+                at += size;
+            }
+            d.output = std::move(rgba);
+            d.host_size = total;
+        }
+        ApplyTexturePack(d);
+        d.status = DecodedTexture::Status::Ok;
+        return d;
+    }
+
+    /// Texture pack (texture_pack.h): dumps a colour picture as PNG and/or swaps in the pack's replacement.
+    void ApplyTexturePack(DecodedTexture& d) const {
+        auto& pack = TexturePack::Instance();
+        if (!pack.Enabled() && !pack.DumpEnabled()) return;
+        using P = VideoCore::Surface::PixelFormat;
+        auto& info = d.info;
+        if (info.type != VideoCommon::ImageType::e2D || info.resources.layers != 1 || d.copies.empty() ||
+            d.content_hash == 0 || info.size.width == 0 || info.size.height == 0) {
+            return;
+        }
+        enum class Kind { None, Rgba, Bgra, Bc1, Bc2, Bc3, Bc7, Astc } kind = Kind::None;
+        const char* tag = "";
+        switch (info.format) {
+        case P::A8B8G8R8_UNORM: case P::A8B8G8R8_SRGB: kind = Kind::Rgba; tag = "rgba"; break;
+        case P::B8G8R8A8_UNORM: case P::B8G8R8A8_SRGB: kind = Kind::Bgra; tag = "bgra"; break;
+        case P::BC1_RGBA_UNORM: case P::BC1_RGBA_SRGB: kind = Kind::Bc1; tag = "bc1"; break;
+        case P::BC2_UNORM: case P::BC2_SRGB: kind = Kind::Bc2; tag = "bc2"; break;
+        case P::BC3_UNORM: case P::BC3_SRGB: kind = Kind::Bc3; tag = "bc3"; break;
+        case P::BC7_UNORM: case P::BC7_SRGB: kind = Kind::Bc7; tag = "bc7"; break;
+        default:
+            if (VideoCore::Surface::IsPixelFormatASTC(info.format)) {
+                kind = Kind::Astc;
+                tag = "astc";
+            }
+            break;
+        }
+        if (kind == Kind::None) return;
+        const u32 w = info.size.width, h = info.size.height;
+        if (pack.DumpEnabled()) {
+            const auto& c0 = d.copies[0];
+            const u8* src = d.output.data() + c0.buffer_offset;
+            std::vector<u8> rgba(static_cast<size_t>(w) * h * 4);
+            bool decoded = true;
+            if (kind == Kind::Rgba || kind == Kind::Bgra || kind == Kind::Astc) {
+                const u32 row = (c0.buffer_row_length && kind != Kind::Astc) ? c0.buffer_row_length : w;
+                for (u32 y = 0; y < h; ++y) {
+                    std::memcpy(rgba.data() + static_cast<size_t>(y) * w * 4, src + static_cast<size_t>(y) * row * 4,
+                                static_cast<size_t>(w) * 4);
+                }
+                if (kind == Kind::Bgra) {
+                    for (size_t i = 0; i < rgba.size(); i += 4) std::swap(rgba[i], rgba[i + 2]);
+                }
+            } else {
+                const u32 bw = (w + 3) / 4, bh = (h + 3) / 4;
+                const u32 row_blocks = c0.buffer_row_length ? (c0.buffer_row_length + 3) / 4 : bw;
+                const size_t block_bytes = kind == Kind::Bc1 ? 8 : 16;
+                for (u32 by = 0; by < bh; ++by) {
+                    for (u32 bx = 0; bx < bw; ++bx) {
+                        const u8* block = src + (static_cast<size_t>(by) * row_blocks + bx) * block_bytes;
+                        switch (kind) {
+                        case Kind::Bc1: bcn::DecodeBc1(block, rgba.data(), bx * 4, by * 4, w, h); break;
+                        case Kind::Bc2: bcn::DecodeBc2(block, rgba.data(), bx * 4, by * 4, w, h); break;
+                        case Kind::Bc3: bcn::DecodeBc3(block, rgba.data(), bx * 4, by * 4, w, h); break;
+                        case Kind::Bc7: bcn::DecodeBc7(block, rgba.data(), bx * 4, by * 4, w, h); break;
+                        default: decoded = false; break;
+                        }
+                    }
+                }
+            }
+            if (decoded) pack.Dump(d.content_hash, w, h, tag, rgba.data());
+        }
+        PackImage img;
+        if (!pack.Enabled() || !pack.Load(d.content_hash, img)) return;
+        std::vector<u8> mips;
+        std::vector<std::array<u32, 3>> levels;
+        TexturePack::BuildMips(img, mips, levels);
+        info.format = VideoCore::Surface::IsPixelFormatSRGB(info.format) ? P::A8B8G8R8_SRGB : P::A8B8G8R8_UNORM;
+        info.size.width = img.width;
+        info.size.height = img.height;
+        info.resources.levels = static_cast<s32>(levels.size());
+        d.copies.clear();
+        for (size_t i = 0; i < levels.size(); ++i) {
+            VideoCommon::BufferImageCopy c{};
+            c.buffer_offset = levels[i][2];
+            c.buffer_size = static_cast<size_t>(levels[i][0]) * levels[i][1] * 4;
+            c.buffer_row_length = 0;
+            c.buffer_image_height = 0;
+            c.image_subresource.base_level = static_cast<s32>(i);
+            c.image_subresource.base_layer = 0;
+            c.image_subresource.num_layers = 1;
+            c.image_offset = {0, 0, 0};
+            c.image_extent = {levels[i][0], levels[i][1], 1};
+            d.copies.push_back(c);
+        }
+        d.output = std::move(mips);
+        d.host_size = d.output.size();
+    }
+
+    /// Pitch-linear 2D textures (one level): the CPU writes these directly, e.g.
+    /// the font glyph cache behind every menu and HUD string, and video frames.
+    /// Rows are read at the TIC pitch and packed tightly.
+    DecodedTexture DecodeLinearTexture(const Tegra::Texture::TICEntry& tic, DecodedTexture d) const {
+        const auto& info = d.info;
+        const u32 bw = VideoCore::Surface::DefaultBlockWidth(info.format);
+        const u32 bh = VideoCore::Surface::DefaultBlockHeight(info.format);
+        const u32 bpb = VideoCore::Surface::BytesPerBlock(info.format);
+        const u32 row_bytes = (info.size.width + bw - 1) / bw * bpb;
+        const u32 rows = (info.size.height + bh - 1) / bh;
+        const u32 pitch = info.pitch;
+        if (pitch < row_bytes || static_cast<u64>(pitch) * rows > (64u << 20)) {
+            d.status = DecodedTexture::Status::TooLarge;
+            return d;
+        }
+        d.guest_size = pitch * rows;
+        std::vector<u8> input(d.guest_size);
+        if (!Core::NvnHost::ReadGpuMemory(tic.Address(), input.data(), input.size())) {
+            d.status = DecodedTexture::Status::Unmapped;
+            return d;
+        }
+        d.content_hash = HashBytes(input.data(), input.size());
+        d.output.resize(static_cast<size_t>(row_bytes) * rows);
+        for (u32 y = 0; y < rows; ++y) {
+            std::memcpy(d.output.data() + static_cast<size_t>(y) * row_bytes,
+                        input.data() + static_cast<size_t>(y) * pitch, row_bytes);
+        }
+        VideoCommon::BufferImageCopy c{};
+        c.buffer_offset = 0;
+        c.buffer_size = d.output.size();
+        c.buffer_row_length = 0;
+        c.buffer_image_height = 0;
+        c.image_subresource = {.base_level = 0, .base_layer = 0, .num_layers = 1};
+        c.image_offset = {0, 0, 0};
+        c.image_extent = {info.size.width, info.size.height, 1};
+        d.copies.push_back(c);
+        d.host_size = d.output.size();
+        d.status = DecodedTexture::Status::Ok;
+        return d;
+    }
+
+    SampledTexture UploadTextureInner(const Tegra::Texture::TICEntry& tic) {
+        DecodedTexture d;
+        if (!TakePredecoded(TicKey(tic), tic, d)) d = DecodeTexture(tic);
+        return CreateTexture(tic, d);
+    }
+
+    // ------------------------------------------------------------------------------ background texture pre-decoding
+    // A course's textures are registered in the descriptor pool while it loads, but first used all at once on its first frame
+    // (hundreds of MB to decode: a 150 ms stall). Idle worker threads decode newly registered descriptors ahead of time; the
+    // result is used only if a sample of the guest bytes still matches (the data may still be streaming in).
+    u64 SampleGuest(const Tegra::Texture::TICEntry& tic, u32 guest_size) const {
+        if (guest_size == 0) return 0;
+        u64 h = guest_size * 0x9E3779B97F4A7C15ULL;
+        bool any = false;
+        constexpr u32 kChunks = 16, kBytes = 128;
+        u8 buf[kBytes];
+        for (u32 k = 0; k < kChunks; ++k) {
+            const u64 off = guest_size > kBytes ? (static_cast<u64>(guest_size - kBytes) * k) / (kChunks - 1) : 0;
+            if (!Core::NvnHost::ReadGpuMemory(tic.Address() + off, buf, std::min<u32>(kBytes, guest_size))) return 0;
+            h = HashBytes(buf, std::min<u32>(kBytes, guest_size)) ^ (h * 31);
+            for (u32 b = 0; b < std::min<u32>(kBytes, guest_size) && !any; ++b) any = buf[b] != 0;
+        }
+        return any ? (h | 1) : 0; // 0 = nothing there yet
+    }
+
+    bool TakePredecoded(u64 key, const Tegra::Texture::TICEntry& tic, DecodedTexture& out) {
+        std::unique_lock lock{pre_lock};
+        const auto it = predecoded.find(key);
+        if (it == predecoded.end()) return false;
+        PreEntry entry = std::move(it->second);
+        predecoded.erase(it);
+        predecoded_bytes -= entry.tex.output.size();
+        lock.unlock();
+        if (SampleGuest(tic, entry.tex.guest_size) != entry.sample) return false; // changed since: decode again
+        out = std::move(entry.tex);
+        ++predecode_hits;
+        return true;
+    }
+
+    void PredecodeWorker() {
+        setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), 10);
+        while (true) {
+            std::pair<u64, Tegra::Texture::TICEntry> job;
+            {
+                std::unique_lock lock{pre_qlock};
+                pre_cv.wait(lock, [&] { return pre_stop || !pre_queue.empty(); });
+                if (pre_stop) return;
+                job = pre_queue.front();
+                pre_queue.pop_front();
+            }
+            if (predecoded_bytes.load() > kPredecodeCap) continue; // full: the textures are decoded on demand as before
+            const auto info = VideoCommon::ImageInfo{job.second};
+            const u32 guest_size = static_cast<u32>(VideoCommon::CalculateGuestSizeInBytes(info));
+            const u64 before = SampleGuest(job.second, guest_size);
+            if (before == 0) {
+                // The data isn't there yet (still loading): let the scanner offer this descriptor again later.
+                std::scoped_lock lock{pre_qlock};
+                pre_retry.push_back(job.first);
+                continue;
+            }
+            DecodedTexture d = DecodeTexture(job.second);
+            if (d.status != DecodedTexture::Status::Ok) continue;
+            if (SampleGuest(job.second, d.guest_size) != before) {
+                std::scoped_lock lock{pre_qlock};
+                pre_retry.push_back(job.first); // changed while decoding: streaming in
+                continue;
+            }
+            std::scoped_lock lock{pre_lock};
+            predecoded_bytes += d.output.size();
+            predecoded[job.first] = PreEntry{std::move(d), before, frames};
+        }
+    }
+
+    /// Render thread, once per frame: looks at a slice of the descriptor pool for textures nobody has decoded yet.
+    void ScanTextureDescriptors() {
+        // Opt-in (KARTRECOMP_NATIVE_PREDECODE=1): a texture decoded ahead of time can be a stale copy of one the game is still filling
+        // in (reflections on Link's bike went dark), and sampled textures are cached by descriptor, so it is off by default.
+        static const bool off = std::getenv("KARTRECOMP_NATIVE_PREDECODE") == nullptr;
+        if (off || (frames & 1)) return;
+        const u32 count = Core::NvnHost::TextureDescriptorCount();
+        if (count == 0) return;
+        if (pre_threads.empty()) {
+            const u32 n = std::clamp<u32>(std::thread::hardware_concurrency() / 4, 2, 4);
+            for (u32 i = 0; i < n; ++i) pre_threads.emplace_back([this] { PredecodeWorker(); });
+        }
+        {
+            std::scoped_lock lock{pre_qlock};
+            for (const u64 key : pre_retry) pre_seen.erase(key);
+            pre_retry.clear();
+        }
+        u32 queued = 0;
+        for (u32 k = 0; k < 256; ++k) {
+            const u32 id = pre_scan++ % count;
+            Tegra::Texture::TICEntry tic{};
+            if (!Core::NvnHost::ReadTextureDescriptor(id, &tic) || tic.Address() == 0) continue;
+            const u64 key = TicKey(tic);
+            if (sampled.contains(key) || !pre_seen.insert(key).second) continue;
+            const auto info = VideoCommon::ImageInfo{tic};
+            if (MapPixelFormat(info.format) == VK_FORMAT_UNDEFINED || info.type == VideoCommon::ImageType::Buffer ||
+                info.type == VideoCommon::ImageType::e1D || info.type == VideoCommon::ImageType::Linear ||
+                info.num_samples > 1) {
+                continue;
+            }
+            std::scoped_lock lock{pre_qlock};
+            if (pre_queue.size() < 4096) {
+                pre_queue.emplace_back(key, tic);
+                ++queued;
+            }
+        }
+        if (queued) pre_cv.notify_all();
+        if ((frames & 0x3FF) == 0) {
+            // Anything decoded ahead and never used in a minute goes (and may be queued again by a later descriptor change).
+            std::scoped_lock lock{pre_lock};
+            for (auto it = predecoded.begin(); it != predecoded.end();) {
+                if (frames - it->second.frame > 3600) {
+                    predecoded_bytes -= it->second.tex.output.size();
+                    pre_seen.erase(it->first);
+                    it = predecoded.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+        }
+    }
+
+    /// GPU half: creates the image and records the copy (render thread only).
+    SampledTexture CreateTexture(const Tegra::Texture::TICEntry& tic, DecodedTexture& d) {
+        SampledTexture tex;
+        const auto& info = d.info;
+        tex.format = MapPixelFormat(info.format);
+        switch (d.status) {
+        case DecodedTexture::Status::Ok: break;
+        case DecodedTexture::Status::Unsupported:
+            tex.format = VK_FORMAT_UNDEFINED;
+            ++textures_unsupported;
+            return tex;
+        case DecodedTexture::Status::Unmapped:
+            ++unmapped_reads;
+            [[fallthrough]];
+        case DecodedTexture::Status::TooLarge:
+            tex.format = VK_FORMAT_UNDEFINED;
+            return tex;
+        }
+        tex.gpu_address = tic.Address();
+        tex.guest_size = d.guest_size;
+        tex.content_hash = d.content_hash;
+        tex.checked_frame = frames;
+        const size_t host_size = d.host_size;
+        const auto& copies = d.copies;
+        // Small uploads share the frame ring; larger ones get their own staging
+        // buffer, so a course's first frame (hundreds of MB of textures) cannot
+        // starve the ring that the frame's own draws need.
+        VkBuffer src_buffer = ring;
+        u64 src_offset = 0;
+        if (const auto staging = host_size <= (1u << 20) ? Allocate(host_size, 16) : std::nullopt) {
+            std::memcpy(ring_ptr + *staging, d.output.data(), host_size);
+            src_offset = *staging;
+        } else if (const auto own = CreateStaging(d.output.data(), host_size)) {
+            src_buffer = *own;
+        } else {
+            return tex; // ok=false with a format: retry next frame
+        }
+
+        const bool is_3d = info.type == VideoCommon::ImageType::e3D;
+        const auto ttype = tic.texture_type.Value();
+        tex.cube = ttype == Tegra::Texture::TextureType::TextureCubemap ||
+                   ttype == Tegra::Texture::TextureType::TextureCubeArray;
+        tex.is_3d = is_3d;
+        tex.levels = static_cast<u32>(info.resources.levels);
+        tex.layers = is_3d ? 1 : static_cast<u32>(info.resources.layers);
+        tex.swizzle = FixSwizzle(info.format, {MapSwizzle(tic.x_source), MapSwizzle(tic.y_source),
+                                               MapSwizzle(tic.z_source), MapSwizzle(tic.w_source)});
+        VkImageCreateInfo ici{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ici.flags = (tex.cube && tex.layers % 6 == 0) ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0;
+        ici.imageType = is_3d ? VK_IMAGE_TYPE_3D : VK_IMAGE_TYPE_2D;
+        ici.format = tex.format;
+        ici.extent = {info.size.width, info.size.height, is_3d ? info.size.depth : 1};
+        ici.mipLevels = tex.levels;
+        ici.arrayLayers = tex.layers;
+        ici.samples = VK_SAMPLE_COUNT_1_BIT;
+        ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ici.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        if (vk.vkCreateImage(device, &ici, nullptr, &tex.image) != VK_SUCCESS) {
+            tex.format = VK_FORMAT_UNDEFINED;
+            return tex;
+        }
+        VkMemoryRequirements req;
+        vk.vkGetImageMemoryRequirements(device, tex.image, &req);
+        VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = FindMemory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT).value_or(0);
+        tex.bytes = req.size;
+        tex.last_used = frames;
+        if (vk.vkAllocateMemory(device, &mai, nullptr, &tex.memory) != VK_SUCCESS) {
+            vk.vkDestroyImage(device, tex.image, nullptr);
+            tex.format = VK_FORMAT_UNDEFINED;
+            return tex;
+        }
+        vk.vkBindImageMemory(device, tex.image, tex.memory, 0);
+        const VkImageSubresourceRange all{VK_IMAGE_ASPECT_COLOR_BIT, 0, tex.levels, 0, tex.layers};
+        const bool was_rendering = rendering;
+        if (was_rendering) {
+            // Copies are not allowed inside a render pass; resume afterwards.
+            EndRendering();
+        }
+        Barrier(tex.image, all, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+        std::vector<VkBufferImageCopy> regions;
+        for (const auto& c : copies) {
+            VkBufferImageCopy r{};
+            r.bufferOffset = src_offset + c.buffer_offset;
+            r.bufferRowLength = c.buffer_row_length;
+            r.bufferImageHeight = c.buffer_image_height;
+            r.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, static_cast<u32>(c.image_subresource.base_level),
+                                  is_3d ? 0u : static_cast<u32>(c.image_subresource.base_layer),
+                                  is_3d ? 1u : static_cast<u32>(c.image_subresource.num_layers)};
+            r.imageOffset = {c.image_offset.x, c.image_offset.y, c.image_offset.z};
+            r.imageExtent = {c.image_extent.width, c.image_extent.height, c.image_extent.depth};
+            regions.push_back(r);
+        }
+        vk.vkCmdCopyBufferToImage(cmd, src_buffer, tex.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                                  static_cast<u32>(regions.size()), regions.data());
+        Barrier(tex.image, all, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL);
+        (void)was_rendering;
+        tex.ok = true;
+        ++textures_created;
+        return tex;
+    }
+
+    /// NVN buffer-to-texture copy: into a native image of the destination (created
+    /// on first use), which sampling then finds ahead of any guest-memory upload.
+    void CopyBufferToTexture(const FrameCommand& fc) {
+        const Command& c = *fc.cmd;
+        if (!fc.snap || !current_frame || c.colors.empty() || c.words.size() < 10) {
+            return;
+        }
+        Image* img = GetImage(c.colors[0]);
+        if (!img || img->info.depth) {
+            return;
+        }
+        EndRendering();
+        Prepare(img);
+        const u64 bytes = fc.snap_size;
+        VkBuffer src = ring;
+        u64 src_offset = 0;
+        const u8* data = current_frame->snapshot.data() + (fc.snap - 1);
+        if (const auto at = bytes <= (1u << 20) ? Allocate(bytes, 16) : std::nullopt) {
+            std::memcpy(ring_ptr + *at, data, bytes);
+            src_offset = *at;
+        } else if (const auto own = CreateStaging(data, bytes)) {
+            src = *own;
+        } else {
+            return;
+        }
+        const u32 texel = TexelClass(img->info.format) & 0xFF;
+        VkBufferImageCopy r{};
+        r.bufferOffset = src_offset;
+        r.bufferRowLength = c.words[8] ? c.words[8] / texel : 0;
+        r.bufferImageHeight = c.words[9] && c.words[8] ? c.words[9] / c.words[8] : 0;
+        const u32 level = std::min(c.words[6], img->levels - 1);
+        r.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, level,
+                              img->depth > 1 ? 0u : std::min(c.words[7], img->layers - 1), 1};
+        r.imageOffset = {static_cast<s32>(c.words[0]), static_cast<s32>(c.words[1]),
+                         img->depth > 1 ? static_cast<s32>(c.words[2]) : 0};
+        r.imageExtent = {c.words[3], c.words[4], img->depth > 1 ? c.words[5] : 1u};
+        vk.vkCmdCopyBufferToImage(cmd, src, img->image, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+        MemoryBarrier();
+        ++buffer_copies;
+    }
+
+    /// Compute dispatch. Bring-up: translate and describe each compute program once.
+    void Dispatch(DrawState& st, const Command& c) {
+        if (!st.compute_program) {
+            return;
+        }
+        if (!compute_seen.insert(st.compute_program).second) {
+            return;
+        }
+        std::array<u32, 3> wg{32, 1, 1};
+        if (const u64 control = Core::NvnHost::ShaderControlAddress(st.compute_program)) {
+            Core::NvnHost::ReadGuestMemory(control + 0x748, wg.data(), sizeof(wg));
+        }
+        const Core::NvnHost::GpuReader reader = [](u64 gpu, void* out, size_t size) {
+            return Core::NvnHost::ReadGpuMemory(gpu, out, size);
+        };
+        const auto t = Core::NvnHost::TranslateComputeShader(reader, st.compute_program, wg, 0);
+        std::string cbufs, ssbos, texs, ubos, bound;
+        for (const auto& cb : t.info.constant_buffer_descriptors)
+            cbufs += fmt::format(" c{}(used {:#x})", cb.index, t.info.constant_buffer_used_sizes[cb.index]);
+        for (const auto& sb : t.info.storage_buffers_descriptors)
+            ssbos += fmt::format(" [c{}+{:#x} {}]", sb.cbuf_index, sb.cbuf_offset, sb.is_written ? "W" : "R");
+        for (const auto& td : t.info.texture_descriptors)
+            texs += fmt::format(" [c{}+{:#x} type{}]", td.cbuf_index, td.cbuf_offset, static_cast<int>(td.type));
+        for (u32 i = 0; i < 16; ++i) {
+            if (st.uniforms[5][i].address) ubos += fmt::format(" u{}={:#x}/{:#x}", i, st.uniforms[5][i].address, st.uniforms[5][i].size);
+            if (st.storage[5][i].address) bound += fmt::format(" s{}={:#x}/{:#x}", i, st.storage[5][i].address, st.storage[5][i].size);
+        }
+        KartRe::Log("compute program={:#x} wg={}x{}x{} groups={}x{}x{} ok={} err={} cbufs:{} ssbos:{} tex:{} | "
+                    "bound ubo:{} ssbo:{} images:{} gmem:{}",
+                    st.compute_program, wg[0], wg[1], wg[2], c.args[0], c.args[1], c.args[2], t.ok,
+                    t.error, cbufs, ssbos, texs, ubos, bound, t.info.image_descriptors.size(),
+                    t.info.uses_global_memory);
+    }
