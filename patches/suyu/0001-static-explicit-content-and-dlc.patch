+    /// Sets the speed limit for this run only (percent 0 = unlimited), remembering the configured one.
+    static void ApplySpeedLimit(int percent) {
+        auto& original = KartOverlay::SpeedOriginalValue();
+        if (!original.saved) {
+            original = {true, Settings::values.use_speed_limit.GetValue(), Settings::values.speed_limit.GetValue()};
+        }
+        Settings::values.use_speed_limit.SetValue(percent != 0);
+        if (percent != 0) {
+            Settings::values.speed_limit.SetValue(static_cast<u16>(percent));
+        }
+    }
