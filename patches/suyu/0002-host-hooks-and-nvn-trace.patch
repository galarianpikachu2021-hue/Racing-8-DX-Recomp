+u64 DesiredLanguage(Core::System& system) {
+    const FileSys::PatchManager pm{system.GetApplicationProcessProgramID(), system.GetFileSystemController(), system.GetContentProvider()};
+    auto control = pm.GetControlMetadata();
+    if (!control.first) {
+        const FileSys::PatchManager upd{FileSys::GetUpdateTitleID(system.GetApplicationProcessProgramID()), system.GetFileSystemController(),
+                                        system.GetContentProvider()};
+        control = upd.GetControlMetadata();
+    }
+    const u32 supported = control.first ? control.first->GetSupportedLanguages() : 0;
+    const auto code = Service::Set::GetLanguageCodeFromIndex(static_cast<size_t>(Settings::values.language_index.GetValue()));
+    const auto app = Service::NS::ConvertToApplicationLanguage(code);
+    if (!app) return 0;
+    const auto* priority = Service::NS::GetApplicationLanguagePriorityList(*app);
+    if (!priority) return 0;
+    for (const auto lang : *priority) {
+        const u32 flag = Service::NS::GetSupportedLanguageFlag(lang);
+        if (supported == 0 || (supported & flag) == flag) {
+            const auto out = Service::NS::ConvertToLanguageCode(lang);
+            return out ? static_cast<u64>(*out) : 0;
+        }
+    }
+    return 0;
+}
+
+std::array<char, 0x10> DisplayVersion(Core::System& system) {
+    std::array<char, 0x10> out{};
+    std::string v = system.GetApplicationDisplayVersionOverride();
+    if (v.empty()) {
+        const FileSys::PatchManager pm{system.GetApplicationProcessProgramID(), system.GetFileSystemController(), system.GetContentProvider()};
+        auto control = pm.GetControlMetadata();
+        if (!control.first) {
+            const FileSys::PatchManager upd{FileSys::GetUpdateTitleID(system.GetApplicationProcessProgramID()), system.GetFileSystemController(),
+                                            system.GetContentProvider()};
+            control = upd.GetControlMetadata();
+        }
+        if (control.first) v = control.first->GetVersionString();
+    }
+    std::memcpy(out.data(), v.data(), std::min(v.size(), out.size()));
+    return out;
+}
+
+/// The engine's controller reconfiguration for the controller applet (what the emulator's default controller applet did).
+AppletHooks::ControllerResult ControllerApplet(Core::System& system, const AppletHooks::ControllerArgs& a) {
+    auto& hid = system.HIDCore();
+    LOG_INFO(Service_AM, "native services: controller applet min {} max {} single {} styles {:#x}", a.min_players, a.max_players, a.single, a.style_set);
+    const size_t min_players = a.single ? 1 : static_cast<size_t>(std::max(a.min_players, 1));
+    const bool pro = a.style_set & 1, handheld = a.style_set & 2, dual = a.style_set & 4, left = a.style_set & 8, right = a.style_set & 16;
+    hid.GetEmulatedController(Core::HID::NpadIdType::Handheld)->Disconnect();
+    for (size_t index = 0; index < hid.available_controllers - 2; ++index) {
+        auto* controller = hid.GetEmulatedControllerByIndex(index);
+        controller->Disconnect();
+        if (index >= min_players) continue;
+        if (pro || a.style_set == 0) controller->SetNpadStyleIndex(Core::HID::NpadStyleIndex::Fullkey);
+        else if (dual) controller->SetNpadStyleIndex(Core::HID::NpadStyleIndex::JoyconDual);
+        else if (left && right) controller->SetNpadStyleIndex(index % 2 == 0 ? Core::HID::NpadStyleIndex::JoyconLeft : Core::HID::NpadStyleIndex::JoyconRight);
+        else if (index == 0 && a.single && handheld && !Settings::IsDockedMode()) controller->SetNpadStyleIndex(Core::HID::NpadStyleIndex::Handheld);
+        else continue;
+        controller->Connect(true);
+    }
+    return {a.single ? int8_t{1} : hid.GetPlayerCount(), static_cast<u32>(hid.GetFirstNpadId())};
+}
+
+/// The web applet: the game's offline pages are extracted once into the cache folder and opened in the system browser, web
+/// addresses are opened directly (what the engine's frontend web applet did).
+std::pair<u32, std::string> WebApplet(Core::System& system, const AppletHooks::WebRequest& r) {
+    if (r.shim_kind == 5) {
+        const bool opened = g_open_url && g_open_url(r.url);
+        LOG_INFO(Service_AM, "native services: web page {} opened in the system browser: {}", r.url, opened);
+        return {2, r.url}; // exit requested (as the frontend applet answered for web pages)
+    }
+    static constexpr std::array<const char*, 3> kinds{"manual", "legal_information", "system_data"};
+    const u32 kind = r.document_kind >= 1 && r.document_kind <= 3 ? r.document_kind : 1;
+    const u64 title = kind == 1 ? system.GetApplicationProcessProgramID() : r.title_id;
+    const auto cache = Common::FS::GetSuyuPath(Common::FS::SuyuPath::CacheDir) / fmt::format("offline_web_applet_{}/{:016X}", kinds[kind - 1], title);
+    const auto document = Common::FS::ConcatPathSafe(cache, fmt::format("{}{}", kind == 1 ? "html-document/" : "", r.document_path));
+    std::string page = Common::FS::PathToUTF8String(document);
+    if (const auto q = page.find_first_of("?#"); q != std::string::npos) page.resize(q);
+    if (!Common::FS::Exists(page)) {
+        FileSys::VirtualFile romfs;
+        const auto type = kind == 1 ? FileSys::ContentRecordType::HtmlDocument : kind == 2 ? FileSys::ContentRecordType::LegalInformation : FileSys::ContentRecordType::Data;
+        if (const auto nca = system.GetContentProvider().GetEntry(title, type)) {
+            const FileSys::PatchManager pm{title, system.GetFileSystemController(), system.GetContentProvider()};
+            romfs = pm.PatchRomFS(nca.get(), nca->GetRomFS(), type);
+        } else if (kind == 1) {
+            system.GetAppLoader().ReadManualRomFS(romfs);
+        }
+        if (!romfs) return {4, {}}; // window closed: nothing to show
+        const auto dir = system.GetFilesystem()->CreateDirectory(Common::FS::PathToUTF8String(cache), FileSys::OpenMode::ReadWrite);
+        FileSys::VfsRawCopyD(FileSys::ExtractRomFS(romfs), dir);
+    }
+    const std::string url = "file://" + Common::FS::PathToUTF8String(document);
+    const bool opened = g_open_url && g_open_url(url);
+    LOG_INFO(Service_AM, "native services: game page {} opened in the system browser: {}", url, opened);
+    return {0, url};
+}
+
+std::shared_ptr<KartRuntime::Service> MakeApplets(KartRuntime::NativeKernel& runtime, KernelCore& kernel) {
+    Core::System& system = kernel.System();
+    AppletHooks h;
+    h.aruid = GameProcess(kernel).GetProcessId();
+    {
+        struct {
+            u32 magic = 0xC79497CA;
+            u32 is_account_selected = 1;
+            Common::UUID user{};
+            std::array<u8, 0x70> pad{};
+        } lp;
+        if (const auto uuid = system.GetProfileManager().GetUser(static_cast<s32>(Settings::values.current_user))) lp.user = *uuid;
+        static_assert(sizeof(lp) == 0x88);
+        h.preselected_user.resize(sizeof(lp));
+        std::memcpy(h.preselected_user.data(), &lp, sizeof(lp));
+    }
+    h.desired_language = DesiredLanguage(system);
+    h.display_version = DisplayVersion(system);
+    h.docked = [] { return Settings::IsDockedMode(); };
+    h.performance_mode = [&system] { return static_cast<u32>(system.GetAPMController().GetCurrentPerformanceMode()); };
+    h.exit_locked = [&system](bool locked) { system.SetExitLocked(locked); };
+    h.log = [](const std::string& m) { LOG_INFO(Service_AM, "native services: {}", m); };
+    h.terminate_result = [](u32 r) { LOG_WARNING(Service_AM, "native services: the game set its terminate result {:#x} ({:04}-{:04})", r, (r & 0x1FF) + 2000, (r >> 9) & 0x1FFF); };
+    const u64 aruid = h.aruid;
+    if (ServiceWanted("vi:m")) {
+        // The display service is the runtime's too: the layer is made there.
+        auto* display = &NativeDisplay(runtime);
+        h.create_layer = [display](u64* out) {
+            *out = display->CreateLayer();
+            return true;
+        };
+    }
+#ifndef KARTRECOMP_DROP_UNUSED_SERVICES
+    else h.create_layer = [&system, aruid](u64* out) {
+        // The game's layer on the default display (the display service still makes the window's buffer queue).
+        std::shared_ptr<Service::VI::IApplicationDisplayService> display;
+        auto root = system.ServiceManager().GetService<Service::VI::IManagerRootService>("vi:m", true);
+        if (!root || root->GetDisplayService(&display, Service::VI::Policy::Compositor) != ResultSuccess || !display) return false;
+        const auto container = display->GetContainer();
+        u64 display_id = 0;
+        if (container->OpenDisplay(&display_id, Service::VI::DisplayName{"Default"}) != ResultSuccess) return false;
+        if (container->CreateManagedLayer(out, display_id, aruid) != ResultSuccess) return false;
+        (void)container->SetLayerVisibility(*out, true);
+        return true;
+    };
+#else
+    (void)aruid;
+#endif
+    h.controller_applet = [&system](const AppletHooks::ControllerArgs& a) { return ControllerApplet(system, a); };
+    h.web_applet = [&system](const AppletHooks::WebRequest& r) { return WebApplet(system, r); };
+    static KartRuntime::Services::Applets& applets = *new KartRuntime::Services::Applets{runtime, std::move(h)}; // kept to process exit
+    g_applets = &applets;
+    return applets.Root("appletOE");
+}
