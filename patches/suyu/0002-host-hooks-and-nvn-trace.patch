+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/hle/kernel/native_sync.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+
+#include "common/logging/log.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_thread.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_game.h"
+#include "core/hle/kernel/native_threads.h"
+#include "kart_runtime/game_kernel.h"
+#include "core/hle/kernel/svc_results.h"
+#include "core/memory.h"
+#include "kart_runtime/sync_arbiter.h"
+
+namespace Kernel::NativeSync {
+namespace {
+
+using KartRuntime::SyncArbiter;
+
+std::atomic<KernelCore*> g_kernel{nullptr};
+std::atomic<bool> g_used{false};
+
+SyncArbiter& Arbiter(KernelCore& kernel, bool uses_memory = true) {
+    // The words are the calling thread's process memory (every caller is a thread of the game's process).
+    static SyncArbiter arbiter{{
+        [](u64 address) -> u32* {
+            KernelCore* k = g_kernel.load(std::memory_order_acquire);
+            if (KProcess* game = NativeGame::Process()) return reinterpret_cast<u32*>(game->GetMemory().GetPointerSilent(address));
+            return k ? reinterpret_cast<u32*>(GetCurrentMemory(*k).GetPointerSilent(address)) : nullptr;
+        },
+        [] {
+            // A game thread of the runtime's kernel gives its virtual core up; a kernel thread its emulated one.
+            if (NativeGame::OnGameThread()) NativeGame::Kernel()->BeginWait();
+            else NativeThreads::BeginHostWait();
+        },
+        [] {
+            if (NativeGame::OnGameThread()) NativeGame::Kernel()->EndWait();
+            else NativeThreads::EndHostWait();
+        },
+    }};
+    if (!g_used.exchange(true, std::memory_order_acq_rel)) {
+        g_kernel.store(&kernel, std::memory_order_release);
+        LOG_INFO(Kernel, "native sync: locks, condition variables, address waits and sleeps are answered by the runtime");
+    } else if (!g_kernel.load(std::memory_order_acquire)) {
+        g_kernel.store(&kernel, std::memory_order_release);
+    }
+    // One process only: the queues are keyed by address. Say so if a second process ever uses the calls on memory. (The
+    // service threads' own processes only sleep, which touches no memory.)
+    if (!uses_memory) return arbiter;
+    static std::atomic<KProcess*> first{nullptr};
+    KProcess* process = GetCurrentProcessPointer(kernel);
+    KProcess* expected = nullptr;
+    if (process && !first.compare_exchange_strong(expected, process) && expected != process) {
+        static std::atomic<bool> warned{false};
+        if (!warned.exchange(true))
+            LOG_CRITICAL(Kernel, "native sync: a second process ({} \"{}\", first {} \"{}\") uses the synchronisation calls", process->GetProcessId(), process->GetName(), expected->GetProcessId(), expected->GetName());
+    }
+    return arbiter;
+}
+
+} // namespace
+
+KartRuntime::SyncArbiter& Instance(KernelCore& kernel) {
+    return Arbiter(kernel, false);
+}
+
+namespace {
+
+Result ToResult(SyncArbiter::Result r) {
+    switch (r) {
+    case SyncArbiter::Result::Success:
+        return ResultSuccess;
+    case SyncArbiter::Result::TimedOut:
+        return ResultTimedOut;
+    case SyncArbiter::Result::InvalidState:
+        return ResultInvalidState;
+    case SyncArbiter::Result::InvalidCurrentMemory:
+        return ResultInvalidCurrentMemory;
+    case SyncArbiter::Result::Cancelled:
+        return ResultTerminationRequested;
+    }
+    return ResultInvalidState;
+}
+
+int Priority(KernelCore& kernel) {
+    return GetCurrentThreadPointer(kernel)->GetPriority();
+}
+
+u64 Id(KernelCore& kernel) {
+    return GetCurrentThreadPointer(kernel)->GetId();
+}
+
+
+} // namespace
+
+bool Enabled() {
+    static const bool on = [] {
+        if (!NativeThreads::Enabled()) return false; // a blocked fiber's host thread would stop a whole emulated core
+        const char* v = std::getenv("KARTRECOMP_NATIVE_SYNC");
+#ifdef __linux__
+        return !(v && *v == '0');
+#else
+        return v && *v == '1';
+#endif
+    }();
+    return on;
+}
+
+void OnTerminateRequested(KernelCore& kernel, KThread* thread) {
+    if (!Enabled() || !g_used.load(std::memory_order_relaxed)) return;
+    Arbiter(kernel).Cancel(thread->GetId());
+}
+
+Result ArbitrateLock(KernelCore& kernel, Svc::Handle owner, u64 address, u32 tag) {
+    return ToResult(Arbiter(kernel).LockWait(Id(kernel), address, owner, tag, Priority(kernel)));
+}
+
+Result ArbitrateUnlock(KernelCore& kernel, u64 address) {
+    return ToResult(Arbiter(kernel).Unlock(address));
+}
+
+Result WaitProcessWideKeyAtomic(KernelCore& kernel, u64 address, u64 cv_key, u32 tag, s64 timeout_ns) {
+    return ToResult(Arbiter(kernel).ConditionWait(Id(kernel), address, cv_key, tag, Priority(kernel), timeout_ns));
+}
+
+void SignalProcessWideKey(KernelCore& kernel, u64 cv_key, s32 count) {
+    Arbiter(kernel).ConditionSignal(cv_key, count);
+}
+
+void Sleep(KernelCore& kernel, s64 ns) {
+    Arbiter(kernel, false).Sleep(Id(kernel), ns);
+}
+
+Result WaitForAddress(KernelCore& kernel, u64 address, Svc::ArbitrationType type, s32 value, s64 timeout_ns) {
+    SyncArbiter::WaitType t = SyncArbiter::WaitType::Equal;
+    switch (type) {
+    case Svc::ArbitrationType::WaitIfLessThan:
+        t = SyncArbiter::WaitType::LessThan;
+        break;
+    case Svc::ArbitrationType::DecrementAndWaitIfLessThan:
+        t = SyncArbiter::WaitType::DecrementAndLessThan;
+        break;
+    case Svc::ArbitrationType::WaitIfEqual:
+        t = SyncArbiter::WaitType::Equal;
+        break;
+    }
+    return ToResult(Arbiter(kernel).AddressWait(Id(kernel), address, t, value, Priority(kernel), timeout_ns));
+}
+
+Result SignalToAddress(KernelCore& kernel, u64 address, Svc::SignalType type, s32 value, s32 count) {
+    SyncArbiter::SignalType t = SyncArbiter::SignalType::Signal;
+    switch (type) {
+    case Svc::SignalType::Signal:
+        t = SyncArbiter::SignalType::Signal;
+        break;
+    case Svc::SignalType::SignalAndIncrementIfEqual:
+        t = SyncArbiter::SignalType::IncrementIfEqual;
+        break;
+    case Svc::SignalType::SignalAndModifyByWaitingCountIfEqual:
+        t = SyncArbiter::SignalType::ModifyByWaitingCountIfEqual;
+        break;
+    }
+    return ToResult(Arbiter(kernel).AddressSignal(address, t, value, count));
+}
+
+} // namespace Kernel::NativeSync
