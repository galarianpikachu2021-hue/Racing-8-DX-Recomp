+constexpr u32 kPushSize = static_cast<u32>(sizeof(Shader::Backend::SPIRV::RescalingLayout) +
+                                           sizeof(Shader::Backend::SPIRV::RenderAreaLayout));
+
+/// Render-thread time per category, reported as per-frame averages.
+struct Profile {
+    enum Slot { Wait, Record, TexCheck, Upload, Descriptors, Pipelines, Submit, DrawTotal, IndexScan,
+                PreDescriptors, Prebuild, PrebuildTextures, PrebuildPipelines, Count };
+    std::array<u64, Count> ns{};
+    struct Scope {
+        Profile& p;
+        Slot slot;
+        std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+        ~Scope() {
+            p.ns[slot] += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                               std::chrono::steady_clock::now() - start)
+                                               .count());
+        }
+    };
+};
