+    // Vertex input. Attribute states are 4 bytes, stream states 8 (stride, divisor).
+    h["nvnCommandBufferBindVertexAttribState"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexAttribs};
