+std::function<void()> g_frame_displayed;
+
+/// Native queue: set by a hook that must wait (outside the model lock) before returning to the game.
+thread_local std::chrono::steady_clock::time_point t_wait_until{};
+
+/// Writes guest memory by GPU address through the memory pools (native queue's counter reports). Lock held.
+bool WriteGpu(State& s, u64 gpu, const void* data, size_t size) {
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    if (!system) return false;
+    std::shared_lock lock{s.range_lock};
+    auto it = std::upper_bound(s.ranges.begin(), s.ranges.end(), gpu, [](u64 a, const State::Range& r) { return a < r.base; });
+    for (int back = 0; back < 16 && it != s.ranges.begin(); ++back) {
+        --it;
+        if (gpu + size <= it->base + it->size && gpu >= it->base) {
+            return system->ApplicationMemory().WriteBlock(it->storage + (gpu - it->base), data, size);
+        }
+    }
+    return false;
+}
+
+/// The GPU timer, as the GPU writes it into reports (Tegra::GPU::GetTicks).
+u64 GpuTicks(Core::System& system) {
+    u64 tick = system.CoreTiming().GetGPUTicks();
+    const Settings::GpuOverclock overclock = Settings::values.fast_gpu_time.GetValue();
+    if (overclock != Settings::GpuOverclock::Normal) tick /= 256 * u64(overclock);
+    return tick;
+}
+
+// NVNmemoryPool: up to three GPU mappings of the storage, each written by the
+// driver at init as a (descriptor pointer, GPU base) pair. Learned from MK8D by
+// matching texture GPU addresses (+0x80 of NVNtexture) against these fields.
+constexpr u64 kPoolGpuMappings[3] = {0x40, 0x50, 0x60};
+
+bool LooksLikeGpuBase(u64 v) {
+    // Mappings are page aligned and sit in the low tens of GB of the GPU VA space.
+    return v >= 0x1'0000'0000ULL && v < 0x10'0000'0000ULL && (v & 0xFFF) == 0;
+}
+
+// NVN shader data starts with a 0x30-byte prefix; the Maxwell program (SPH) follows.
+constexpr u64 kNvnShaderPrefix = 0x30;
+
+/// GPU address -> guest memory, through the memory pools' storage.
+/// Reads [gpu, gpu+size) through the memory pools. Pieces that are not mapped to
+/// CPU-visible storage read as zero. True when at least the first byte was
+/// mapped. (Uniform and shader-constant reads are often sized generously and run
+/// past the end of a small pool; refusing those whole lost real data.)
+/// Publishes a TIC/TSC pool's guest address for lock-free descriptor reads.
+static void PublishDescriptorPool(State& s, const State::DescriptorPool& p, std::atomic<u64>& base,
+                                  std::atomic<u32>& count) {
+    const auto it = s.pools.find(p.memory_pool);
+    if (it == s.pools.end() || it->second.storage == 0) {
+        base = 0;
+        count = 0;
+        return;
+    }
+    base = it->second.storage + p.offset;
+    count = p.count;
+}
+
+static bool ReadPublishedDescriptor(State& s, const std::atomic<u64>& base, const std::atomic<u32>& count,
+                                    u32 id, void* out32) {
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    const u64 b = base.load(std::memory_order_acquire);
+    if (!system || b == 0 || id >= count.load(std::memory_order_acquire)) {
+        return false;
+    }
+    return system->ApplicationMemory().ReadBlock(b + u64{id} * 32, out32, 32);
+}
+
+/// Rebuilds State::ranges from the pools (call with State::lock held, after
+/// any change to a pool's storage or GPU mappings).
+void RebuildRanges(State& s) {
+    std::vector<State::Range> ranges;
+    ranges.reserve(s.pools.size() * 2);
+    for (const auto& [obj, pool] : s.pools) {
+        if (pool.storage == 0 || pool.size == 0) {
+            continue; // GPU-only pool: no CPU bytes to read
+        }
+        for (const u64 base : pool.gpu_bases) {
+            ranges.push_back({base, pool.size, pool.storage});
+        }
+    }
+    std::sort(ranges.begin(), ranges.end(), [](const auto& a, const auto& b) { return a.base < b.base; });
+    std::unique_lock lock{s.range_lock};
+    s.ranges = std::move(ranges);
+}
+
+bool ReadGpu(State& s, u64 gpu, void* out, size_t size, bool /*lock_held*/ = false) {
+    // A few recent hits per thread; otherwise a binary search under a shared lock.
+    // Ranges never move once a pool is initialized.
+    thread_local std::array<State::Range, 8> recent{};
+    thread_local u32 next_slot = 0;
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    auto* dst = static_cast<u8*>(out);
+    bool first_mapped = false;
+    size_t done = 0;
+    while (done < size) {
+        const u64 addr = gpu + done;
+        const State::Range* hit = nullptr;
+        for (const auto& r : recent) {
+            if (r.size && addr >= r.base && addr < r.base + r.size) {
+                hit = &r;
+                break;
+            }
+        }
+        State::Range found{};
+        if (!hit) {
+            std::shared_lock lock{s.range_lock};
+            auto it = std::upper_bound(s.ranges.begin(), s.ranges.end(), addr,
+                                       [](u64 a, const State::Range& r) { return a < r.base; });
+            // Mappings can nest: look back a few ranges for one that contains addr.
+            for (int back = 0; back < 16 && it != s.ranges.begin(); ++back) {
+                --it;
+                if (addr < it->base + it->size) {
+                    found = *it;
+                    break;
+                }
+            }
+            if (found.size) {
+                recent[next_slot] = found;
+                next_slot = (next_slot + 1) % recent.size();
+                hit = &found;
+            }
+        }
+        if (!hit || !system) {
+            std::memset(dst + done, 0, size - done);
+            break;
+        }
+        const size_t chunk = std::min<size_t>(size - done, hit->base + hit->size - addr);
+        if (!system->ApplicationMemory().ReadBlock(hit->storage + (addr - hit->base), dst + done, chunk)) {
+            std::memset(dst + done, 0, chunk);
+        } else if (done == 0) {
+            first_mapped = true;
+        }
+        done += chunk;
+    }
+    return first_mapped;
+}
+
+void ShaderWorker() {
+    auto& s = S();
+    const GpuReader reader = [](u64 gpu, void* out, size_t size) {
+        return ReadGpuMemory(gpu, out, size); // takes the model lock
+    };
+    while (true) {
+        u64 program;
+        {
+            std::unique_lock lock{s.lock};
+            s.shader_cv.wait(lock, [&s] { return !s.shader_queue.empty(); });
+            program = s.shader_queue.front();
+            s.shader_queue.pop_front();
+        }
+        const TranslatedShader t =
+            TranslateShader(reader, program, static_cast<u32>(kNvnShaderPrefix));
+        KartRe::Log("nvn-xlate program={:#x} ok={} stage={} error={}", program + kNvnShaderPrefix, t.ok,
+                    static_cast<int>(t.stage), t.error);
+        std::scoped_lock lock{s.lock};
+        if (t.ok) {
+            ++s.shaders_ok;
+            ++s.shader_stages[static_cast<int>(t.stage)];
+        } else {
+            ++s.shaders_failed;
+            ++s.shader_errors[t.error];
+        }
+    }
+}
+
+// ---- Statistics backend (shadow stage default) ------------------------------
+
+class StatsBackend final : public Backend {
+public:
+    void Submit(const SubmitData& submit) override {
+        ++submits;
+        for (const Command* c : submit.commands) {
+            ++ops[static_cast<int>(c->op)];
+            if (c->op == Op::SetRenderTargets) {
+                for (const auto& t : c->colors) {
+                    if (t.valid) {
+                        targets.insert({t.width, t.height, t.format});
+                        storages.insert({t.pool, t.offset});
+                    } else {
+                        ++unresolved_targets;
+                    }
+                }
+            }
+        }
+    }
+    void Present(const TextureDesc& t, u32 window_index) override {
+        ++frames;
+        last_present = t;
+        last_index = window_index;
+        if (frames % 600 == 0) {
+            Write();
+        }
+    }
+
+private:
+    void Write() {
+        auto& s = S();
+        std::ofstream out(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_host.txt",
+                          std::ios::trunc);
+        out << "=== nvn-host shadow ===\n"
+            << "frames presented : " << frames << "\n"
+            << "submits          : " << submits << "\n"
+            << "commands         : set_rt " << ops[0] << ", clear_color " << ops[1]
+            << ", clear_ds " << ops[2] << ", draw " << ops[3] << ", dispatch " << ops[4] << "\n"
+            << "memory pools     : " << s.pools.size() << "\n"
+            << "texture objects  : " << s.textures.size() << "\n"
+            << "command lists    : " << s.lists.size() << "\n"
+            << "windows          : " << s.windows.size() << "\n"
+            << "resolved calls   : " << s.resolved_calls << "\n"
+            << "missing handles  : submit " << s.missing_handles << ", call " << s.missing_call_handles << "\n"
+            << "struct decoder   : " << s.decode_matches << " match / " << s.decode_mismatches
+            << " mismatch at init; " << s.decoded_lookups << " lookups decoded from copies\n";
+        {
+            u64 mapped = 0;
+            for (const auto& [obj, pool] : s.pools) {
+                mapped += pool.gpu_base != 0;
+            }
+            out << "pools with GPU base: " << mapped << " / " << s.pools.size() << "\n";
+            out << "pool GPU base (+0x50) vs texture-derived: " << s.pool_base_agree << " agree / "
+                << s.pool_base_disagree << " disagree\n";
+            out << "pool struct offsets holding the GPU base:";
+            for (const auto& [off, n] : s.pool_base_offsets) {
+                out << " +" << std::hex << off << std::dec << " x" << n;
+            }
+            out << "\n";
+            out << "shaders          : " << s.shaders_ok << " translated to SPIR-V, "
+                << s.shaders_failed << " failed, " << s.shader_queue.size() << " queued\n";
+            for (const auto& [stage, n] : s.shader_stages) {
+                out << "  stage " << stage << ": " << n << "\n";
+            }
+            for (const auto& [err, n] : s.shader_errors) {
+                out << "  error x" << n << ": " << err << "\n";
+            }
+        }
+        out << "last present     : window texture #" << last_index << " " << last_present.width
+            << "x" << last_present.height << " format " << last_present.format << " pool "
+            << std::hex << last_present.pool << " offset " << last_present.offset << std::dec
+            << (last_present.valid ? "" : " (unresolved)") << "\n";
+        out << "color target storages: " << storages.size()
+            << ", unresolved binds: " << unresolved_targets << "\n";
+        out << "distinct color targets (w x h fmt): " << targets.size() << "\n";
+        for (const auto& [w, h, f] : targets) {
+            out << "  " << w << "x" << h << " fmt " << f << "\n";
+        }
+    }
+
+    u64 frames = 0, submits = 0;
+    u64 ops[32]{}; // indexed by Op; keep larger than the enum
+    std::set<std::tuple<u32, u32, u32>> targets;
+    std::set<std::pair<u64, u64>> storages;
+    u64 unresolved_targets = 0;
+    TextureDesc last_present;
+    u32 last_index = 0;
+};
+
+// ---- Handlers -----------------------------------------------------------------
+
+using Handler = std::function<void(HookContext&, State&)>;
+
+void TextureBuilderField(std::map<std::string, Handler>& h, const char* name,
+                         u32 TextureDesc::*field) {
+    h[name] = [field](HookContext& ctx, State& s) {
+        s.texture_builders[ctx.x[0]].*field = Arg32(ctx, 1);
+    };
+}
+
+u16 EntryIndex(State& s, const std::string& name) {
+    s.entry_names.push_back(name);
+    return static_cast<u16>(s.entry_names.size() - 1);
+}
+
+std::map<std::string, Handler> BuildHandlers() {
+    std::map<std::string, Handler> h;
+
+    // Memory pools
+    h["nvnMemoryPoolBuilderSetDefaults"] = [](HookContext& ctx, State& s) {
+        s.pool_builders[ctx.x[0]] = {};
+    };
+    h["nvnMemoryPoolBuilderSetStorage"] = [](HookContext& ctx, State& s) {
+        auto& b = s.pool_builders[ctx.x[0]];
+        b.storage = ctx.x[1];
+        b.size = ctx.x[2];
+    };
+    h["nvnMemoryPoolBuilderSetFlags"] = [](HookContext& ctx, State& s) {
+        s.pool_builders[ctx.x[0]].flags = Arg32(ctx, 1);
+    };
+    h["nvnMemoryPoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.pools[ctx.x[0]] = s.pool_builders[ctx.x[1]];
+        // The driver writes the pool's GPU base into the struct during init
+        // (+0x50, learned from texture-derived bases; cross-checked below).
+        RecompHooks::TrapReturn(ctx, [pool = ctx.x[0]](HookContext& ret) {
+            u64 bases[3];
+            for (int i = 0; i < 3; ++i) {
+                bases[i] = Mem(ret).Read64(pool + kPoolGpuMappings[i]);
+            }
+            auto& st = S();
+            std::scoped_lock lock{st.lock};
+            if (const auto it = st.pools.find(pool); it != st.pools.end()) {
+                it->second.gpu_bases.clear();
+                for (u64 b : bases) {
+                    if (LooksLikeGpuBase(b)) {
+                        it->second.gpu_bases.push_back(b);
+                    }
+                }
+                it->second.gpu_base = it->second.gpu_bases.empty() ? 0 : it->second.gpu_bases[0];
+                RebuildRanges(st);
+            }
+        });
+    };
+    h["nvnMemoryPoolFinalize"] = [](HookContext& ctx, State& s) {
+        s.pools.erase(ctx.x[0]);
+        RebuildRanges(s);
+    };
+
+    // Texture builders and textures
+    h["nvnTextureBuilderSetDefaults"] = [](HookContext& ctx, State& s) {
+        s.texture_builders[ctx.x[0]] = {};
+    };
+    TextureBuilderField(h, "nvnTextureBuilderSetTarget", &TextureDesc::target);
+    TextureBuilderField(h, "nvnTextureBuilderSetFormat", &TextureDesc::format);
+    TextureBuilderField(h, "nvnTextureBuilderSetWidth", &TextureDesc::width);
+    TextureBuilderField(h, "nvnTextureBuilderSetHeight", &TextureDesc::height);
+    TextureBuilderField(h, "nvnTextureBuilderSetDepth", &TextureDesc::depth);
+    TextureBuilderField(h, "nvnTextureBuilderSetLevels", &TextureDesc::levels);
+    TextureBuilderField(h, "nvnTextureBuilderSetSamples", &TextureDesc::samples);
+    TextureBuilderField(h, "nvnTextureBuilderSetFlags", &TextureDesc::flags);
+    h["nvnTextureBuilderSetSize2D"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.width = Arg32(ctx, 1);
+        b.height = Arg32(ctx, 2);
+    };
+    h["nvnTextureBuilderSetSize3D"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.width = Arg32(ctx, 1);
+        b.height = Arg32(ctx, 2);
+        b.depth = Arg32(ctx, 3);
+    };
+    h["nvnTextureBuilderSetStorage"] = [](HookContext& ctx, State& s) {
+        auto& b = s.texture_builders[ctx.x[0]];
+        b.pool = ctx.x[1];
+        b.offset = ctx.x[2];
+    };
+    h["nvnTextureInitialize"] = [](HookContext& ctx, State& s) {
+        TextureDesc d = s.texture_builders[ctx.x[1]];
+        d.valid = true;
+        s.textures[ctx.x[0]] = d;
+        // Calibrate the struct decoder against what the builder said.
+        RecompHooks::TrapReturn(ctx, [tex = ctx.x[0], d](HookContext& ret) {
+            const TextureDesc decoded = DecodeTextureStruct(Mem(ret), tex);
+            auto& st = S();
+            (decoded == d ? st.decode_matches : st.decode_mismatches)++;
+            // The struct also carries the storage's GPU address, which gives the
+            // pool's GPU base: what GPU-address -> guest-memory translation needs.
+            const u64 gpu = Mem(ret).Read64(tex + kTextureGpuAddress);
+            std::scoped_lock lock{st.lock};
+            if (const auto it = st.pools.find(d.pool); it != st.pools.end() && gpu > d.offset) {
+                auto& bases = it->second.gpu_bases;
+                const u64 derived = gpu - d.offset;
+                const bool agree = std::find(bases.begin(), bases.end(), derived) != bases.end();
+                (agree ? st.pool_base_agree : st.pool_base_disagree)++;
+                if (!agree && it->second.size != 0) {
+                    bases.push_back(derived); // a mapping the struct decode missed
+                    RebuildRanges(st);
+                }
+            }
+        });
+    };
+    h["nvnTextureFinalize"] = [](HookContext& ctx, State& s) { s.textures.erase(ctx.x[0]); };
+
+    // Window
+    h["nvnWindowBuilderSetTextures"] = [](HookContext& ctx, State& s) {
+        std::vector<TextureDesc> list;
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 8; ++i) {
+            list.push_back(ResolveTexture(ctx, s, Mem(ctx).Read64(ctx.x[2] + i * 8)));
+        }
+        s.window_builders[ctx.x[0]] = std::move(list);
+    };
+    h["nvnWindowSetCrop"] = [](HookContext& ctx, State& s) {
+        const s32 x = static_cast<s32>(Arg32(ctx, 1)), y = static_cast<s32>(Arg32(ctx, 2));
+        const s32 w = static_cast<s32>(Arg32(ctx, 3)), hgt = static_cast<s32>(Arg32(ctx, 4));
+        for (auto& b : s.backends) {
+            b->OnWindowCrop(x, y, w, hgt);
+        }
+    };
+    h["nvnWindowInitialize"] = [](HookContext& ctx, State& s) {
+        s.windows[ctx.x[0]] = s.window_builders[ctx.x[1]];
+        LOG_INFO(Core_ARM, "nvn-host: window {:#x} with {} textures", ctx.x[0],
+                 s.windows[ctx.x[0]].size());
+    };
+
+    // Command recording
+    h["nvnCommandBufferBeginRecording"] = [](HookContext& ctx, State& s) {
+        auto& list = s.recording[ctx.x[0]];
+        list.clear();
+        s.recording_generation.fetch_add(1, std::memory_order_release);
+        if (const auto it = s.recorded_size.find(ctx.x[0]); it != s.recorded_size.end()) list.reserve(it->second + it->second / 8);
+    };
+    h["nvnCommandBufferSetRenderTargets"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::SetRenderTargets};
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 8; ++i) {
+            c.colors.push_back(ResolveTexture(ctx, s, Mem(ctx).Read64(ctx.x[2] + i * 8)));
+            // NVNtextureView (learned from its setters): word0 = flags (bit0 levels,
+            // bit1 layers, bit2 format, ...) | base level << 8 | level count << 16;
+            // word1 = base layer | layer count << 16; word2 = format override.
+            u32 level = 0, view_format = 0, layer = 0;
+            if (ctx.x[3]) {
+                if (const u64 view = Mem(ctx).Read64(ctx.x[3] + i * 8)) {
+                    const u32 w0 = Mem(ctx).Read32(view);
+                    if (w0 & 1) level = (w0 >> 8) & 0xFF;
+                    if (w0 & 2) layer = Mem(ctx).Read32(view + 4) & 0xFFFF;
+                    if (w0 & 4) view_format = Mem(ctx).Read32(view + 8);
+                }
+            }
+            c.color_levels.push_back(level);
+            c.color_view_formats.push_back(view_format);
+            c.color_layers.push_back(layer);
+            if (KartRe::Enabled() && ctx.x[3]) {
+                static std::atomic<int> shown{0};
+                const u64 view = Mem(ctx).Read64(ctx.x[3] + i * 8);
+                const auto& tt = c.colors.back();
+                if (view && (tt.width == 960 || tt.width == 480) && shown.fetch_add(1) < 400) {
+                    u32 w[12]{};
+                    Mem(ctx).ReadBlock(view, w, sizeof(w));
+                    const auto& t = c.colors.back();
+                    KartRe::Log("rt-view levels={} {}x{} f{} slot {} view {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} "
+                                "{:08x} {:08x} {:08x} {:08x}",
+                                t.levels, t.width, t.height, t.format, i, w[0], w[1], w[2], w[3], w[4], w[5],
+                                w[6], w[7], w[8], w[9]);
+                }
+            }
+        }
+        if (ctx.x[4] != 0) {
+            c.depth = ResolveTexture(ctx, s, ctx.x[4]);
+            if (ctx.x[5] != 0 && (Mem(ctx).Read32(ctx.x[5]) & 2)) {
+                c.depth_layer = Mem(ctx).Read32(ctx.x[5] + 4) & 0xFFFF;
+            }
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferClearColor"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::ClearColor};
+        c.index = Arg32(ctx, 1);
+        for (int i = 0; i < 4; ++i) {
+            const u32 bits = Mem(ctx).Read32(ctx.x[2] + i * 4);
+            std::memcpy(&c.rgba[i], &bits, sizeof(float));
+        }
+        c.mask = Arg32(ctx, 3);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferClearDepthStencil"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::ClearDepthStencil};
+        c.depth_value = ArgF(ctx, 0);
+        c.mask = Arg32(ctx, 1);
+        c.stencil_value = Arg32(ctx, 2);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    // CallCommands is expanded at record time: the nested lists exist already.
+    h["nvnCommandBufferCallCommands"] = [](HookContext& ctx, State& s) {
+        const auto it = s.recording.find(ctx.x[0]);
+        if (it == s.recording.end()) {
+            return;
+        }
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 256; ++i) {
+            const u64 handle = Mem(ctx).Read64(ctx.x[2] + i * 8);
+            if (const auto l = s.lists.find(handle); l != s.lists.end() && l->second) {
+                Command c{.op = Op::Call};
+                c.call = l->second; // shared, expanded at submit
+                it->second.push_back(std::move(c));
+            } else {
+                ++s.missing_call_handles;
+            }
+        }
+    };
+
+    h["nvnCommandBufferReportCounter"] = [](HookContext& ctx, State& s) {
+        static const bool probe = std::getenv("KARTRECOMP_NVN_COUNTER_PROBE") != nullptr;
+        if (probe && s.counter_probe.size() < 100000) s.counter_probe.emplace_back(Arg32(ctx, 1), ctx.x[2], s.probe_frame);
+        if (NativeQueue()) {
+            Command c{.op = Op::ReportCounter};
+            c.index = Arg32(ctx, 1);
+            c.address = ctx.x[2];
+            Append(s, ctx.x[0], std::move(c));
+        }
+    };
+    // Native queue: the GPU work is the native renderer's, which takes each submission as it comes, so a sync is done as soon
+    // as it is fenced (the emulated GPU's Null renderer signalled as soon as it had read the commands: the same for the game).
+    h["nvnSyncWait"] = [](HookContext& ctx, State&) {
+        if (NativeQueue()) ctx.x[0] = 0; // NVN_SYNC_WAIT_RESULT_ALREADY_SIGNALED
+    };
+    h["nvnQueueWaitSync"] = [](HookContext& ctx, State&) {
+        if (NativeQueue()) ctx.x[0] = 1; // NVN_TRUE
+    };
+    h["nvnQueueFenceSync"] = [](HookContext&, State&) {};
+    h["nvnQueueFlush"] = [](HookContext&, State&) {};
+    h["nvnQueueFinish"] = [](HookContext&, State&) {};
+    h["nvnWindowAcquireTexture"] = [](HookContext& ctx, State& s) {
+        if (!NativeQueue()) return;
+        // The window's textures in turn (the display queue's order for a game that presents every texture it acquires).
+        const auto it = s.windows.find(ctx.x[0]);
+        const u32 count = it == s.windows.end() || it->second.empty() ? 2u : static_cast<u32>(it->second.size());
+        u32& next = s.window_next[ctx.x[0]];
+        const u32 index = next % count;
+        next = (index + 1) % count;
+        Mem(ctx).Write32(ctx.x[2], index);
+        ctx.x[0] = 0; // NVN_WINDOW_ACQUIRE_TEXTURE_RESULT_SUCCESS
+        // Pacing: with `count` textures, one is on screen and at most count - 2 may wait to be shown when the next is handed out.
+        const auto now = std::chrono::steady_clock::now();
+        while (!s.display_times.empty() && s.display_times.front() <= now) s.display_times.pop_front();
+        const size_t may_wait = count >= 2 ? count - 2 : 0;
+        static const bool no_pacing = std::getenv("KARTRECOMP_NVN_NO_PACING") != nullptr; // experiments: never wait here
+        if (!no_pacing && s.display_times.size() > may_wait) t_wait_until = s.display_times[s.display_times.size() - may_wait - 1];
+    };
+
+    // Queue
+    h["nvnQueueSubmitCommands"] = [](HookContext& ctx, State& s) {
+        const auto t0 = std::chrono::steady_clock::now();
+        SubmitData flat;
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 256; ++i) {
+            Flatten(s, Mem(ctx).Read64(ctx.x[2] + i * 8), flat, 0);
+        }
+        const auto t1 = std::chrono::steady_clock::now();
+        s.submit_flatten_ns += static_cast<u64>((t1 - t0).count());
+        if (NativeQueue()) {
+            // Counter reports: what the GPU wrote for this game (value 0, then the GPU time) when the submission is taken.
+            for (const Command* c : flat.commands) {
+                if (c->op != Op::ReportCounter) continue;
+                const u64 report[2]{0, GpuTicks(ctx.system)};
+                WriteGpu(s, c->address, report, sizeof(report));
+            }
+        }
+        for (size_t i = 0; i < s.backends.size(); ++i) {
+            const auto tb = std::chrono::steady_clock::now();
+            s.backends[i]->Submit(flat);
+            s.submit_backend_ns[std::min<size_t>(i, 3)] += static_cast<u64>((std::chrono::steady_clock::now() - tb).count());
+        }
+    };
+    h["nvnQueuePresentTexture"] = [](HookContext& ctx, State& s) {
+        ++s.probe_frame;
+        if (NativeQueue()) {
+            // The display clock: this frame is shown one refresh after the previous one, or now if the game is late.
+            static const auto period = std::chrono::nanoseconds{1000000000 / [] {
+                int hz = 60;
+                if (const char* v = std::getenv("KARTRECOMP_VSYNC_HZ")) hz = std::clamp(std::atoi(v), 30, 360);
+                return hz;
+            }()};
+            const auto now = std::chrono::steady_clock::now();
+            auto shown = s.display_times.empty() ? now : std::max(now, s.display_times.back() + period);
+            if (s.display_times.empty() && s.last_shown + period > now) shown = s.last_shown + period;
+            s.display_times.push_back(shown);
+            s.last_shown = shown;
+            ctx.system.GetPerfStats().EndGameFrame();
+        }
+        if (!s.counter_probe.empty()) {
+            std::vector<std::tuple<u32, u64, u64>> keep;
+            for (const auto& [type, addr, frame] : s.counter_probe) {
+                if (frame + 3 > s.probe_frame) {
+                    keep.emplace_back(type, addr, frame);
+                    continue;
+                }
+                u64 v[2]{};
+                ReadGpu(s, addr, v, sizeof(v), true);
+                const u64 value_key = v[0] > 1000000 ? 1000000 : v[0];
+                if (++s.probe_seen[{type, value_key}] == 1 || (s.probe_logged < 60 && s.probe_frame % 600 == 0)) {
+                    ++s.probe_logged;
+                    LOG_INFO(Core_ARM, "nvn counter probe: type={:#x} addr={:#x} value={:#x} time={:#x} frame={}", type, addr, v[0], v[1], frame);
+                }
+            }
+            s.counter_probe = std::move(keep);
+        }
+        const auto it = s.windows.find(ctx.x[1]);
+        const u32 index = Arg32(ctx, 2);
+        TextureDesc t;
+        if (it != s.windows.end() && index < it->second.size()) {
+            t = it->second[index];
+        }
+        for (auto& b : s.backends) {
+            b->Present(t, index);
+        }
+    };
+    // Programs (tracked by address: bound programs are the objects SetShaders configured)
+    h["nvnProgramSetShaders"] = [](HookContext& ctx, State& s) {
+        std::vector<u64> datas;
+        const u32 count = Arg32(ctx, 1);
+        for (u32 i = 0; i < count && i < 6; ++i) {
+            const u64 data = Mem(ctx).Read64(ctx.x[2] + i * 16); // NVN shader data address
+            datas.push_back(data);
+            s.shader_controls[data] = Mem(ctx).Read64(ctx.x[2] + i * 16 + 8);
+            if (s.shaders_seen.insert(data).second && KartRe::Enabled()) {
+                s.shader_queue.push_back(data); // statistics worker (RE runs only)
+                s.shader_cv.notify_one();
+            }
+            KartRe::Log("nvn-shader program={:#x} i={} data={:#x}", ctx.x[0], i, data);
+            if (KartRe::Enabled() && count == 1) {
+                const u64 control = Mem(ctx).Read64(ctx.x[2] + i * 16 + 8);
+                u32 words[1024];
+                Mem(ctx).ReadBlock(control, words, sizeof(words));
+                std::string hex;
+                for (u32 w : words) hex += fmt::format(" {:x}", w);
+                KartRe::Log("nvn-control data={:#x}{}", data, hex);
+            }
+        }
+        if (datas.size() >= 2) { // graphics (compute programs have one stage)
+            for (auto& b : s.backends) {
+                b->OnProgram(datas);
+            }
+        }
+        s.programs[ctx.x[0]] = std::move(datas);
+    };
+    h["nvnProgramFinalize"] = [](HookContext& ctx, State& s) { s.programs.erase(ctx.x[0]); };
+    h["nvnCommandBufferBindProgram"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindProgram};
+        if (const auto it = s.programs.find(ctx.x[1]); it != s.programs.end()) {
+            c.shaders = it->second;
+        }
+        c.stage = Arg32(ctx, 2);
+        if (c.stage & 0x20) {
+            std::string datas;
+            for (u64 d : c.shaders) datas += fmt::format(" {:#x}", d);
+            KartRe::Log("nvn-bind-compute program={:#x} datas{}", ctx.x[1], datas);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+
+    // Vertex input. Attribute states are 4 bytes, stream states 8 (stride, divisor).
+    h["nvnCommandBufferBindVertexAttribState"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexAttribs};
+        const u32 count = std::min<u32>(Arg32(ctx, 1), 32);
+        c.words.resize(count);
+        Mem(ctx).ReadBlock(ctx.x[2], c.words.data(), count * 4);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindVertexStreamState"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexStreams};
+        const u32 count = std::min<u32>(Arg32(ctx, 1), 32);
+        c.words.resize(count * 2);
+        Mem(ctx).ReadBlock(ctx.x[2], c.words.data(), count * 8);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindVertexBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexBuffer, .index = Arg32(ctx, 1)};
+        c.address = ctx.x[2];
+        c.size = ctx.x[3];
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindUniformBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindUniformBuffer, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
+        c.address = ctx.x[3];
+        c.size = ctx.x[4];
+        Append(s, ctx.x[0], std::move(c));
+        KartRe::Log("nvn-ubo stage={} slot={} gpu={:#x} size={:#x}", c.stage, c.index, c.address, c.size);
+    };
+    // Copy strides are command buffer state, set before the copies that use them.
+    h["nvnCommandBufferSetCopyRowStride"] = [](HookContext& ctx, State& s) {
+        s.copy_row_stride[ctx.x[0]] = ctx.x[1];
+    };
+    h["nvnCommandBufferSetCopyImageStride"] = [](HookContext& ctx, State& s) {
+        s.copy_image_stride[ctx.x[0]] = ctx.x[1];
+    };
+    // (cmdbuf, source buffer address, texture, view, NVNcopyRegion, flags). The
+    // game streams its menu movies this way: a Y and a UV plane every frame.
+    h["nvnCommandBufferCopyBufferToTexture"] = [](HookContext& ctx, State& s) {
+        const TextureDesc dst = ResolveTexture(ctx, s, ctx.x[2]);
+        s32 region[6]{};
+        Mem(ctx).ReadBlock(ctx.x[4], region, sizeof(region));
+        u32 level = 0, layer = 0;
+        if (ctx.x[3]) {
+            u32 view_words[8]{};
+            Mem(ctx).ReadBlock(ctx.x[3], view_words, sizeof(view_words));
+            if (view_words[0] & 1) level = (view_words[0] >> 8) & 0xFF;
+            if (view_words[0] & 2) layer = view_words[1] & 0xFFFF;
+            KartRe::Log("copy-b2t view words {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x}",
+                        view_words[0], view_words[1], view_words[2], view_words[3], view_words[4],
+                        view_words[5], view_words[6], view_words[7]);
+        }
+        if (dst.valid && region[3] > 0 && region[4] > 0) {
+            Command c{.op = Op::CopyBufferToTexture};
+            c.address = ctx.x[1];
+            c.colors.push_back(dst);
+            const auto stride = [&ctx](const auto& map) -> u32 {
+                const auto it = map.find(ctx.x[0]);
+                return it == map.end() ? 0 : static_cast<u32>(it->second);
+            };
+            c.words = {static_cast<u32>(region[0]), static_cast<u32>(region[1]), static_cast<u32>(region[2]),
+                       static_cast<u32>(region[3]), static_cast<u32>(region[4]),
+                       static_cast<u32>(std::max(region[5], 1)), level, layer, stride(s.copy_row_stride),
+                       stride(s.copy_image_stride)};
+            c.index = Arg32(ctx, 5); // flags
+            Append(s, ctx.x[0], std::move(c));
+        }
+        KartRe::Log("copy-b2t src={:#x} dst valid={} target={} fmt={} {}x{}x{} levels={} pool={:#x} off={:#x} "
+                    "view={:#x} region={},{},{} {}x{}x{} flags={:#x}",
+                    ctx.x[1], dst.valid, dst.target, dst.format, dst.width, dst.height, dst.depth,
+                    dst.levels, dst.pool, dst.offset, ctx.x[3], region[0], region[1], region[2],
+                    region[3], region[4], region[5], Arg32(ctx, 5));
+    };
+    // Uniform data embedded in the command stream: applied to the buffer when the
+    // GPU reaches this point, so later draws in the same frame see the new values.
+    h["nvnCommandBufferUpdateUniformBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::UpdateUniformBuffer};
+        c.address = ctx.x[1];
+        c.size = ctx.x[2];
+        c.raw = ctx.x[3];
+        const u64 bytes = std::min<u64>(ctx.x[4], 0x10000);
+        c.bytes.resize(bytes);
+        Mem(ctx).ReadBlock(ctx.x[5], c.bytes.data(), bytes);
+        static std::atomic<int> shown{0};
+        if (shown.fetch_add(1) < 30) {
+            KartRe::Log("update-ubo x1={:#x} x2={:#x} x3={:#x} x4={:#x} x5={:#x} x6={:#x}", ctx.x[1],
+                        ctx.x[2], ctx.x[3], ctx.x[4], ctx.x[5], ctx.x[6]);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindStorageBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindStorageBuffer, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
+        c.address = ctx.x[3];
+        c.size = ctx.x[4];
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindTexture"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindTexture, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
+        c.handle = ctx.x[3];
+        Append(s, ctx.x[0], std::move(c));
+    };
+
+    // Render state objects are engine copies: decoded from their bytes.
+    const auto bind_raw = [](Op op, bool wide) {
+        return [op, wide](HookContext& ctx, State& s) {
+            Command c{.op = op};
+            c.raw = wide ? Mem(ctx).Read64(ctx.x[1]) : Mem(ctx).Read32(ctx.x[1]);
+            Append(s, ctx.x[0], std::move(c));
+        };
+    };
+    h["nvnCommandBufferBindDepthStencilState"] = bind_raw(Op::BindDepthStencil, true);
+    h["nvnCommandBufferBindColorState"] = bind_raw(Op::BindColor, true);
+    h["nvnCommandBufferBindChannelMaskState"] = bind_raw(Op::BindChannelMask, false);
+    h["nvnCommandBufferBindBlendState"] = bind_raw(Op::BindBlend, true);
+    // The polygon state's offset enables are tracked from their setter (by
+    // state object) rather than decoded: c.index = NVN enables (1 point, 2 line,
+    // 4 fill). The game uses them for decals and shadow maps.
+    h["nvnPolygonStateSetPolygonOffsetEnables"] = [](HookContext& ctx, State& s) {
+        s.polygon_offset_enables[ctx.x[0]] = static_cast<u32>(ctx.x[1]);
+    };
+    h["nvnPolygonStateSetDefaults"] = [](HookContext& ctx, State& s) {
+        s.polygon_offset_enables.erase(ctx.x[0]);
+    };
+    h["nvnCommandBufferBindPolygonState"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindPolygon};
+        c.raw = Mem(ctx).Read32(ctx.x[1]);
+        const auto it = s.polygon_offset_enables.find(ctx.x[1]);
+        c.index = it == s.polygon_offset_enables.end() ? 0 : it->second;
+        Append(s, ctx.x[0], std::move(c));
+    };
+    // (cmdbuf, const float color[4]): the blend constant (bloom upsampling adds
+    // each level scaled by it).
+    h["nvnCommandBufferSetBlendColor"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BlendColor};
+        for (int i = 0; i < 4; ++i) {
+            const u32 bits = Mem(ctx).Read32(ctx.x[1] + i * 4);
+            std::memcpy(&c.rgba[i], &bits, sizeof(float));
+        }
+        static std::set<std::array<float, 4>> shown;
+        if (KartRe::Enabled() && shown.size() < 60 && shown.insert({c.rgba[0], c.rgba[1], c.rgba[2], c.rgba[3]}).second) {
+            KartRe::Log("blend-color cmd={:#x} recording={} -> {} {} {} {}", ctx.x[0], s.recording.contains(ctx.x[0]),
+                        c.rgba[0], c.rgba[1], c.rgba[2], c.rgba[3]);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferSetDepthClamp"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::DepthClamp};
+        c.index = Arg32(ctx, 1) & 1;
+        Append(s, ctx.x[0], std::move(c));
+    };
+    // (cmdbuf, near, far)
+    h["nvnCommandBufferSetDepthRange"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::DepthRange};
+        c.rgba[0] = ArgF(ctx, 0);
+        c.rgba[1] = ArgF(ctx, 1);
+        static std::set<std::pair<float, float>> shown;
+        if (KartRe::Enabled() && shown.size() < 20 && shown.emplace(c.rgba[0], c.rgba[1]).second) {
+            KartRe::Log("depth-range args {} {}", c.rgba[0], c.rgba[1]);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    // (cmdbuf, factor, units, clamp): rgba = {factor, units, clamp}.
+    h["nvnCommandBufferSetPolygonOffsetClamp"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::PolygonOffset};
+        c.rgba[0] = ArgF(ctx, 0);
+        c.rgba[1] = ArgF(ctx, 1);
+        c.rgba[2] = ArgF(ctx, 2);
+        static std::set<std::tuple<float, float, float>> shown;
+        if (KartRe::Enabled() && shown.size() < 40 && shown.emplace(c.rgba[0], c.rgba[1], c.rgba[2]).second) {
+            KartRe::Log("polygon-offset args {} {} {}", c.rgba[0], c.rgba[1], c.rgba[2]);
+        }
+        Append(s, ctx.x[0], std::move(c));
+    };
+    const auto rect = [](Op op) {
+        return [op](HookContext& ctx, State& s) {
+            Command c{.op = op};
+            for (int i = 0; i < 4; ++i) {
+                c.rect[i] = static_cast<s32>(ctx.x[1 + i]);
+            }
+            Append(s, ctx.x[0], std::move(c));
+        };
+    };
+    h["nvnCommandBufferSetViewport"] = rect(Op::Viewport);
+    // Array forms: (cb, first, count, const float* xywh) / (cb, first, count, const int* xywh).
+    // Only index 0 matters to the single-viewport backend.
+    h["nvnCommandBufferSetViewports"] = [](HookContext& ctx, State& s) {
+        if (Arg32(ctx, 1) != 0 || Arg32(ctx, 2) == 0) return;
+        float f[4]{};
+        Mem(ctx).ReadBlock(ctx.x[3], f, sizeof(f));
+        Command c{.op = Op::Viewport};
+        for (int i = 0; i < 4; ++i) c.rect[i] = static_cast<s32>(f[i]);
+        KartRe::Log("set-viewports {} {} {} {}", f[0], f[1], f[2], f[3]);
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferSetScissors"] = [](HookContext& ctx, State& s) {
+        if (Arg32(ctx, 1) != 0 || Arg32(ctx, 2) == 0) return;
+        Command c{.op = Op::Scissor};
+        Mem(ctx).ReadBlock(ctx.x[3], c.rect, sizeof(c.rect));
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnDeviceSetWindowOriginMode"] = [](HookContext& ctx, State& s) {
+        s.window_origin = static_cast<int>(Arg32(ctx, 1));
+        LOG_INFO(Core_ARM, "nvn-host: window origin mode {}", s.window_origin);
+    };
+    h["nvnCommandBufferSetRasterizerDiscard"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::RasterizerDiscard, .index = Arg32(ctx, 1) & 1};
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferSetScissor"] = rect(Op::Scissor);
+
+    // Descriptor pools: TIC/TSC entries live in a memory pool at (pool, offset).
+    h["nvnTexturePoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.texture_pool = {ctx.x[1], ctx.x[2], Arg32(ctx, 3)};
+        PublishDescriptorPool(s, s.texture_pool, s.tic_base, s.tic_count);
+        KartRe::Log("texture-pool-init pool={:#x} mempool={:#x} offset={:#x} count={}", ctx.x[0],
+                    ctx.x[1], ctx.x[2], Arg32(ctx, 3));
+        LOG_INFO(Core_ARM, "nvn-host: texture pool mempool={:#x} offset={:#x} count={}", ctx.x[1],
+                 ctx.x[2], Arg32(ctx, 3));
+    };
+    h["nvnSamplerPoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.sampler_pool = {ctx.x[1], ctx.x[2], Arg32(ctx, 3)};
+        PublishDescriptorPool(s, s.sampler_pool, s.tsc_base, s.tsc_count);
+        LOG_INFO(Core_ARM, "nvn-host: sampler pool mempool={:#x} offset={:#x} count={}", ctx.x[1],
+                 ctx.x[2], Arg32(ctx, 3));
+    };
+    // Texture pool: handles carry the registered ID.
+    h["nvnTexturePoolRegisterTexture"] = [](HookContext& ctx, State& s) {
+        const TextureDesc d = ResolveTexture(ctx, s, ctx.x[2]);
+        std::unique_lock lock{s.texture_id_lock};
+        s.texture_ids[Arg32(ctx, 1)] = d;
+    };
+    return h;
+}
+
+/// Exclusive mode replaces these NVN command-buffer calls outright: nvn-host
+/// records them for the native backend and returns to the game without running
+/// the guest driver, so neither the driver (pushbuffer encoding) nor the
+/// emulated GPU (decoding it, to draw nothing) does the work. Sync, queries,
+/// conditional rendering, copies and recording begin/end stay on the driver.
+/// KARTRECOMP_NATIVE_KEEP_NVN=1 keeps everything on the driver.
+bool Replaced(const std::string& name) {
+    static const bool keep = std::getenv("KARTRECOMP_NATIVE_KEEP_NVN") != nullptr;
+    if (keep || !Exclusive()) {
+        return false;
+    }
+    if (NativeQueue()) {
+        static const std::set<std::string> queue{
+            "nvnQueueSubmitCommands", "nvnQueueFlush",      "nvnQueueFinish",          "nvnQueuePresentTexture",
+            "nvnQueueFenceSync",      "nvnQueueWaitSync",   "nvnSyncWait",             "nvnWindowAcquireTexture",
+            "nvnCommandBufferReportCounter",
+        };
+        if (queue.contains(name)) return true;
+    }
+    static const std::set<std::string> names{
+        "nvnCommandBufferBindUniformBuffer", "nvnCommandBufferBindTexture",
+        "nvnCommandBufferBindProgram", "nvnCommandBufferBindVertexBuffer",
+        "nvnCommandBufferSetRenderTargets", "nvnCommandBufferBindColorState",
+        "nvnCommandBufferSetViewport", "nvnCommandBufferBindBlendState",
+        "nvnCommandBufferBindVertexStreamState", "nvnCommandBufferBindVertexAttribState",
+        "nvnCommandBufferSetBlendColor", "nvnCommandBufferBindChannelMaskState",
+        "nvnCommandBufferDrawElements", "nvnCommandBufferSetScissor",
+        "nvnCommandBufferBindDepthStencilState", "nvnCommandBufferBindPolygonState",
+        "nvnCommandBufferDrawElementsInstanced", "nvnCommandBufferUpdateUniformBuffer",
+        "nvnCommandBufferDrawElementsBaseVertex", "nvnCommandBufferClearColor",
+        "nvnCommandBufferSetPolygonOffsetClamp", "nvnCommandBufferSetDepthClamp",
+        "nvnCommandBufferSetRasterizerDiscard", "nvnCommandBufferBindStorageBuffer",
+        "nvnCommandBufferDrawArraysInstanced", "nvnCommandBufferClearDepthStencil",
+        "nvnCommandBufferDrawArrays", "nvnCommandBufferSetViewports",
+        "nvnCommandBufferSetScissors", "nvnCommandBufferSetDepthRange",
+        // Pure state the native backend does not model yet and the (Null) emulated
+        // GPU does not need.
+        "nvnCommandBufferSetStencilRef", "nvnCommandBufferSetStencilValueMask",
+        "nvnCommandBufferSetStencilMask", "nvnCommandBufferSetDepthBounds",
+        "nvnCommandBufferBindMultisampleState", "nvnCommandBufferSetPointSize",
+        "nvnCommandBufferSetLineWidth",
+    };
+    return names.contains(name);
+}
+
+/// Returns from a replaced NVN call (all are void): resume at the caller.
+bool ReturnFromCall(HookContext& ctx) {
+    ctx.pc = ctx.x[30];
+    return true;
+}
+
+/// Handlers that must also see the return value.
+void InstallReturnHandlers(const std::string& name, u64 address) {
+    if (name == "nvnCommandBufferEndRecording") {
+        RecompHooks::Install(address, [](HookContext& ctx) {
+            const u64 cmdbuf = ctx.x[0];
+            RecompHooks::TrapReturn(ctx, [cmdbuf](HookContext& ret) {
+                auto& s = S();
+                std::scoped_lock lock{s.lock};
+                auto node = s.recording.extract(cmdbuf);
+                s.recording_generation.fetch_add(1, std::memory_order_release);
+                if (!node.empty()) {
+                    s.recorded_size[cmdbuf] = node.mapped().size();
+                    s.lists[ret.x[0]] = std::make_shared<const std::vector<Command>>(std::move(node.mapped()));
+                }
+            });
+            return false;
+        });
+    } else if (name == "nvnMemoryPoolGetBufferAddress") {
+        RecompHooks::Install(address, [](HookContext& ctx) {
+            const u64 pool = ctx.x[0];
+            RecompHooks::TrapReturn(ctx, [pool](HookContext& ret) {
+                auto& s = S();
+                std::scoped_lock lock{s.lock};
+                if (const auto it = s.pools.find(pool); it != s.pools.end()) {
+                    it->second.gpu_base = ret.x[0];
+                }
+            });
+            return false;
+        });
+    }
+}
+
+bool IsDraw(const std::string& name) {
+    return name.starts_with("nvnCommandBufferDraw");
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool enabled = [] {
+        // The native renderer is the renderer. "shadow" (development) runs it beside the old output; "off" is for tools that
+        // start the game without a picture.
+        const char* v = std::getenv("KARTRECOMP_NATIVE_GPU");
+        if (std::getenv("KARTRECOMP_VERIFY_BOOT")) return false; // the launcher's test boot has no display
+        return !(v && std::strcmp(v, "off") == 0);
+    }();
+    return enabled;
+}
+
+void SetFrameDisplayed(std::function<void()> callback) {
+    g_frame_displayed = std::move(callback);
+}
+
+bool NativeQueue() {
+    static const bool on = [] {
+        // On by default on Linux (KARTRECOMP_NATIVE_QUEUE=0 turns it off); elsewhere only when asked for.
+        const char* v = std::getenv("KARTRECOMP_NATIVE_QUEUE");
+#ifdef __linux__
+        return Exclusive() && !(v && *v == '0');
+#else
+        return Exclusive() && v && *v == '1';
+#endif
+    }();
+    return on;
+}
+
+bool Exclusive() {
+    static const bool exclusive = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_GPU");
+        if (std::getenv("KARTRECOMP_VERIFY_BOOT")) return false;
+        return !(v && (std::strcmp(v, "shadow") == 0 || std::strcmp(v, "off") == 0));
+    }();
+    return exclusive;
+}
+
+/// 32-byte hardware descriptor (TIC/TSC) number id of a descriptor pool. Lock held.
+
+
+bool ReadGpuMemoryInSubmit(u64 gpu_address, void* out, size_t size) {
+    return ReadGpu(S(), gpu_address, out, size, true);
+}
+
+bool ReadGpuMemory(u64 gpu_address, void* out, size_t size) {
+    const bool ok = ReadGpu(S(), gpu_address, out, size);
+    if (!ok && KartRe::Enabled()) {
+        static std::atomic<int> shown{0};
+        if (shown.fetch_add(1) < 20) {
+            auto& s = S();
+            std::scoped_lock lock{s.lock};
+            for (const auto& [obj, pool] : s.pools) {
+                for (const u64 base : pool.gpu_bases) {
+                    if (gpu_address >= base && gpu_address < base + pool.size) {
+                        KartRe::Log("unmapped-detail gpu={:#x}+{:#x} in pool {:#x} base={:#x} size={:#x} "
+                                    "storage={:#x} flags={:#x}",
+                                    gpu_address, size, obj, base, pool.size, pool.storage, pool.flags);
+                    }
+                }
+            }
+        }
+    }
+    return ok;
+}
+
+bool ReadGuestMemory(u64 address, void* out, size_t size) {
+    auto& s = S();
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    return system && system->ApplicationMemory().ReadBlock(address, out, size);
+}
+
+int WindowOriginMode() {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    return s.window_origin;
+}
+
+u64 ShaderControlAddress(u64 shader_data) {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    const auto it = s.shader_controls.find(shader_data);
+    return it == s.shader_controls.end() ? 0 : it->second;
+}
+
+bool ReadTextureDescriptor(u32 id, void* out32) {
+    auto& s = S();
+    return ReadPublishedDescriptor(s, s.tic_base, s.tic_count, id, out32);
+}
+
+u32 TextureDescriptorCount() {
+    return S().tic_count.load(std::memory_order_acquire);
+}
+
+bool ReadSamplerDescriptor(u32 id, void* out32) {
+    auto& s = S();
+    return ReadPublishedDescriptor(s, s.tsc_base, s.tsc_count, id, out32);
+}
+
+TextureDesc LookupTextureId(u32 id) {
+    auto& s = S();
+    std::shared_lock lock{s.texture_id_lock};
+    const auto it = s.texture_ids.find(id);
+    return it == s.texture_ids.end() ? TextureDesc{} : it->second;
+}
+
+void ShutdownBackends() {
+    std::vector<std::unique_ptr<Backend>> doomed;
+    {
+        auto& s = S();
+        std::scoped_lock lock{s.lock};
+        doomed.swap(s.backends);
+    }
+    doomed.clear(); // outside the lock: render threads may still be reading the model
+}
+
+void AddBackend(std::unique_ptr<Backend> backend) {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    s.backends.push_back(std::move(backend));
+}
+
+void OnResolved(const std::string& name, u64 address) {
+    KartRe::Log("onresolved {} {:#x}", name, address);
+    ++S().resolved_calls;
+    if (address == 0) {
+        return;
+    }
+    static const auto handlers = BuildHandlers();
+    auto& s = S();
+    {
+        // The game resolves some entry points twice (bootstrap loader and
+        // GetProcAddress); hook each address once or every call counts double.
+        static std::set<u64> installed;
+        std::scoped_lock lock{s.lock};
+        if (!installed.insert(address).second) {
+            return;
+        }
+        static bool stats_added = false;
+        if (!stats_added) {
+            // Off when the native renderer plays the game: it looks at every command and rewrites a log file every 10 s, for nothing
+            // the player needs. KARTRECOMP_NVN_STATS=1 brings it back.
+            if (KartRe::Enabled() || !Exclusive() || std::getenv("KARTRECOMP_NVN_STATS")) {
+                s.backends.push_back(std::make_unique<StatsBackend>());
+            }
+            stats_added = true;
+            // Translation statistics only; the Vulkan backend translates what it draws.
+            if (KartRe::Enabled()) {
+                std::thread(ShaderWorker).detach();
+            }
+        }
+    }
+    KartRe::Log("resolved {} {:#x}", name, address);
+    InstallReturnHandlers(name, address);
+    // RE: generic argument + struct log for state setters and binders.
+    if (KartRe::Enabled() &&
+        (name.find("State") != std::string::npos || name.starts_with("nvnTextureView") ||
+         name == "nvnCommandBufferSetRenderTargets" || name == "nvnCommandBufferBindVertexBuffer" ||
+         name == "nvnCommandBufferSetViewport" || name == "nvnCommandBufferSetScissor" ||
+         name == "nvnCommandBufferBindProgram" || name == "nvnCommandBufferBindStorageBuffer" ||
+         name == "nvnDeviceGetTextureHandle" || name == "nvnTexturePoolRegisterTexture" ||
+         name.starts_with("nvnSamplerBuilder") || name == "nvnSamplerInitialize" ||
+         name == "nvnSamplerPoolRegisterSampler")) {
+        auto counter = std::make_shared<std::atomic<int>>(0);
+        RecompHooks::Install(address, [name, counter](HookContext& ctx) {
+            if (counter->fetch_add(1) >= 400) {
+                return false;
+            }
+            const bool array_bind = name.find("BindVertex") != std::string::npos &&
+                                    name.find("State") != std::string::npos;
+            const u64 ptr = array_bind ? ctx.x[2] : (name.find("Bind") != std::string::npos ? ctx.x[1] : ctx.x[0]);
+            u32 w[12]{};
+            Mem(ctx).ReadBlock(ptr, w, sizeof(w));
+            float f[4];
+            for (int i = 0; i < 4; ++i) {
+                f[i] = ArgF(ctx, i);
+            }
+            KartRe::Log("state {} x0={:#x} x1={:#x} x2={:#x} x3={:#x} x4={:#x} x5={:#x} | v {} {} {} {} | "
+                        "[{:#x}] {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} "
+                        "{:08x} {:08x}",
+                        name, ctx.x[0], ctx.x[1], ctx.x[2], ctx.x[3], ctx.x[4], ctx.x[5], f[0], f[1],
+                        f[2], f[3], ptr, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9],
+                        w[10], w[11]);
+            return false;
+        });
+    }
+    if (IsDraw(name) || name == "nvnCommandBufferDispatchCompute") {
+        u16 entry;
+        {
+            std::scoped_lock lock{s.lock};
+            entry = EntryIndex(s, name);
+        }
+        const Op op = IsDraw(name) ? Op::Draw : Op::Dispatch;
+        const DrawKind kind = name == "nvnCommandBufferDrawElements"             ? DrawKind::Elements
+                              : name == "nvnCommandBufferDrawElementsInstanced"  ? DrawKind::ElementsInstanced
+                              : name == "nvnCommandBufferDrawElementsBaseVertex" ? DrawKind::ElementsBaseVertex
+                              : name == "nvnCommandBufferDrawArrays"             ? DrawKind::Arrays
+                              : name == "nvnCommandBufferDrawArraysInstanced"    ? DrawKind::ArraysInstanced
+                                                                                 : DrawKind::Other;
+        const bool replaced = Replaced(name);
+        RecompHooks::Install(address, [entry, op, kind, replaced](HookContext& ctx) {
+            auto& st = S();
+            Command c{.op = op, .entry = entry, .draw = kind};
+            std::memcpy(c.args, ctx.x + 1, sizeof(c.args));
+            if (op == Op::Dispatch) {
+                KartRe::Log("nvn-dispatch groups={}x{}x{}", ctx.x[1], ctx.x[2], ctx.x[3]);
+            }
+            // Draws are most of the NVN calls, and in split-screen several game threads record at once: append without the
+            // global lock. A command buffer is recorded by one thread at a time, and the map's nodes do not move, so a thread
+            // may keep a pointer to its own list until a recording starts or ends anywhere (the generation changes).
+            struct RecordingCache {
+                u64 cmdbuf = 0;
+                std::vector<Command>* list = nullptr;
+                u64 generation = ~u64{0};
+            };
+            static thread_local RecordingCache cache;
+            const u64 gen = st.recording_generation.load(std::memory_order_acquire);
+            if (cache.list && cache.cmdbuf == ctx.x[0] && cache.generation == gen) {
+                cache.list->push_back(std::move(c));
+            } else {
+                std::scoped_lock lock{st.lock};
+                cache = {};
+                if (const auto rit = st.recording.find(ctx.x[0]); rit != st.recording.end()) {
+                    rit->second.push_back(std::move(c));
+                    cache = {ctx.x[0], &rit->second, st.recording_generation.load(std::memory_order_relaxed)};
+                }
+            }
+            return replaced && ReturnFromCall(ctx);
+        });
+        return;
+    }
+    const auto it = handlers.find(name);
+    if (it == handlers.end()) {
+        if (Replaced(name)) {
+            RecompHooks::Install(address, [](HookContext& ctx) { return ReturnFromCall(ctx); });
+        }
+        return;
+    }
+    const Handler& handler = it->second;
+    const bool present = name == "nvnQueuePresentTexture";
+    const bool replaced = Replaced(name);
+    auto* timing = &S().hook_time[it->first]; // node-based map: stable address
+    RecompHooks::Install(address, [&handler, present, timing, replaced](HookContext& ctx) {
+        auto& st = S();
+        std::vector<Backend*> throttle;
+        const auto t0 = std::chrono::steady_clock::now();
+        {
+            std::scoped_lock lock{st.lock};
+            st.system = &ctx.system;
+            st.system_ptr.store(&ctx.system, std::memory_order_release);
+            handler(ctx, st);
+            if (present) {
+                for (auto& b : st.backends) throttle.push_back(b.get());
+            }
+            timing->first += static_cast<u64>((std::chrono::steady_clock::now() - t0).count());
+            ++timing->second;
+            if (present && ++st.presents_timed % 300 == 0) {
+                std::vector<std::pair<u64, std::string>> top;
+                u64 total = 0;
+                for (const auto& [n, v] : st.hook_time) {
+                    top.emplace_back(v.first, fmt::format("{} {:.3f}ms x{:.0f}", n, static_cast<double>(v.first) / 300.0 / 1e6, static_cast<double>(v.second) / 300.0));
+                    total += v.first;
+                }
+                std::sort(top.rbegin(), top.rend());
+                std::string out;
+                for (size_t i = 0; i < top.size() && i < 8; ++i) out += " | " + top[i].second;
+                LOG_INFO(Core_ARM, "nvn-host hook time per frame {:.2f} ms{}", static_cast<double>(total) / 300.0 / 1e6, out);
+                LOG_INFO(Core_ARM, "nvn-host submit split per frame: flatten {:.3f} ms, backend0 {:.3f}, backend1 {:.3f}",
+                         static_cast<double>(st.submit_flatten_ns) / 300e6, static_cast<double>(st.submit_backend_ns[0]) / 300e6,
+                         static_cast<double>(st.submit_backend_ns[1]) / 300e6);
+                st.submit_flatten_ns = 0;
+                st.submit_backend_ns = {};
+                for (auto& [n, v] : st.hook_time) v = {};
+            }
+        }
+        // Outside the lock: a pacing backend's render thread reads the model.
+        for (Backend* b : throttle) {
+            b->Throttle();
+        }
+        if (present && NativeQueue() && g_frame_displayed) g_frame_displayed();
+        if (t_wait_until != std::chrono::steady_clock::time_point{}) {
+            const auto until = t_wait_until;
+            t_wait_until = {};
+            // The wait must stay here (the window texture is then free when the game draws into it; waiting later, at the next
+            // system call, made the game draw over the texture on screen: flickering UI). A game thread gives its core up meanwhile.
+            const bool left = Kernel::NativeThreads::BeginHostWait();
+            std::this_thread::sleep_until(until);
+            if (left) Kernel::NativeThreads::EndHostWait();
+        }
+        return replaced && ReturnFromCall(ctx);
+    });
+}
+
+} // namespace Core::NvnHost
