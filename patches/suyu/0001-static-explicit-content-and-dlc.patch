+    /// Driver pipeline cache, persisted in the cache directory so compiled
+    /// pipelines survive between runs (the driver validates the blob's header).
+    static std::filesystem::path PipelineCachePath() {
+        return Common::FS::GetSuyuPath(Common::FS::SuyuPath::CacheDir) / "kartrecomp" / "vk_pipelines.bin";
+    }
+
+    void LoadPipelineCache() {
+        std::vector<char> blob;
+        if (std::ifstream in{PipelineCachePath(), std::ios::binary}) {
+            blob.assign(std::istreambuf_iterator<char>(in), {});
+        }
+        VkPipelineCacheCreateInfo pcci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+        pcci.initialDataSize = blob.size();
+        pcci.pInitialData = blob.empty() ? nullptr : blob.data();
+        if (vk.vkCreatePipelineCache(device, &pcci, nullptr, &pipeline_cache) != VK_SUCCESS) {
+            pcci.initialDataSize = 0;
+            pcci.pInitialData = nullptr;
+            vk.vkCreatePipelineCache(device, &pcci, nullptr, &pipeline_cache);
+        }
+        LOG_INFO(Frontend, "nvn-host vulkan: pipeline cache {} ({} bytes loaded)",
+                 Common::FS::PathToUTF8String(PipelineCachePath()), blob.size());
+    }
+
+    void SavePipelineCache() {
+        if (!pipeline_cache) {
+            return;
+        }
+        size_t size = 0;
+        vk.vkGetPipelineCacheData(device, pipeline_cache, &size, nullptr);
+        std::vector<char> blob(size);
+        if (size && vk.vkGetPipelineCacheData(device, pipeline_cache, &size, blob.data()) == VK_SUCCESS) {
+            std::error_code ec;
+            std::filesystem::create_directories(PipelineCachePath().parent_path(), ec);
+            std::ofstream out{PipelineCachePath(), std::ios::binary | std::ios::trunc};
+            out.write(blob.data(), static_cast<std::streamsize>(size));
+        }
+    }
+
+    void Shutdown() {
+        if (!device) {
+            return;
+        }
+        FgWaitIdle();
+        {
+            std::scoped_lock lock{fg_mx};
+            fg_stop = true;
+        }
+        fg_cv.notify_all();
+        if (fg_thread.joinable()) fg_thread.join();
+        vk.vkDeviceWaitIdle(device);
+        {
+            std::scoped_lock lock{pre_qlock};
+            pre_stop = true;
+        }
+        pre_cv.notify_all();
+        for (auto& t : pre_threads) t.join();
+        pre_threads.clear();
+        upscaler.Unload(); // a plugin frees its Vulkan objects: before the device goes away, not in the destructor after it
+        SavePipelineCache();
+        if (pipeline_cache) {
+            vk.vkDestroyPipelineCache(device, pipeline_cache, nullptr);
+        }
+        for (auto& [key, p] : pipelines) {
+            if (p) vk.vkDestroyPipeline(device, p, nullptr);
+        }
+        for (VkPipeline p : retired_pipelines) {
+            if (p) vk.vkDestroyPipeline(device, p, nullptr);
+        }
+        for (auto& prog : retired_programs) {
+            DestroyProgram(prog);
+        }
+        for (auto& [key, prog] : programs) {
+            for (auto& s : prog.stages) vk.vkDestroyShaderModule(device, s.module, nullptr);
+            if (prog.layout) vk.vkDestroyPipelineLayout(device, prog.layout, nullptr);
+            if (prog.set_layout) vk.vkDestroyDescriptorSetLayout(device, prog.set_layout, nullptr);
+        }
+        for (auto& [key, img] : images) {
+            for (auto& [f, v] : img.views) vk.vkDestroyImageView(device, v, nullptr);
+            for (auto& [f, v] : img.sample_views) vk.vkDestroyImageView(device, v, nullptr);
+            if (img.sample_view != img.attach_view) vk.vkDestroyImageView(device, img.sample_view, nullptr);
+            vk.vkDestroyImageView(device, img.attach_view, nullptr);
+            vk.vkDestroyImage(device, img.image, nullptr);
+            vk.vkFreeMemory(device, img.memory, nullptr);
+        }
+        for (Image* d : {&dummy_2d, &dummy_2d_array, &dummy_cube, &dummy_cube_array, &dummy_3d}) {
+            vk.vkDestroyImageView(device, d->sample_view, nullptr);
+            vk.vkDestroyImage(device, d->image, nullptr);
+            vk.vkFreeMemory(device, d->memory, nullptr);
+        }
+        for (auto& [k, smp] : game_samplers) vk.vkDestroySampler(device, smp, nullptr);
+        vk.vkDestroySampler(device, sampler, nullptr);
+        vk.vkDestroySampler(device, shadow_sampler, nullptr);
+        vk.vkDestroyDescriptorPool(device, descriptor_pool, nullptr);
+        vk.vkDestroyBuffer(device, ring, nullptr);
+        vk.vkFreeMemory(device, ring_memory, nullptr);
+        vk.vkDestroySemaphore(device, acquired, nullptr);
+        vk.vkDestroySemaphore(device, rendered, nullptr);
+        vk.vkDestroyFence(device, fence, nullptr);
+        vk.vkDestroyCommandPool(device, pool, nullptr);
+        vk.vkDestroySwapchainKHR(device, swapchain, nullptr);
+        vk.vkDestroyDevice(device, nullptr);
+        vk.vkDestroySurfaceKHR(instance, surface, nullptr);
+        vk.vkDestroyInstance(instance, nullptr);
+        // The window is destroyed by the owning (main) thread, in the destructor.
+    }
