+// kart-recomp (Windows): large buffers are reserved and committed page by page on first touch, like an mmap on Linux. The guest page
+// table alone is 4 GB (39-bit address space), of which a race touches about 25 MB; committing it all up front charged 4 GB against
+// the system's commit limit (RAM + page file), which an 8 GB PC with a small page file can run out of. A vectored exception handler
+// commits 64 KB around a first access inside a registered range and resumes; anything else passes on. KARTRECOMP_LAZY_COMMIT=0 off.
+constexpr std::size_t kLazyMinimum = std::size_t{256} << 20;
+constexpr std::uintptr_t kCommitChunk = 0x10000;
+struct LazyRange {
+    std::atomic<std::uintptr_t> begin{0};
+    std::atomic<std::uintptr_t> end{0};
+};
+std::array<LazyRange, 16> lazy_ranges;
+std::mutex lazy_mutex;
+
+LONG CALLBACK CommitOnFirstTouch(EXCEPTION_POINTERS* info) {
+    const EXCEPTION_RECORD* rec = info->ExceptionRecord;
+    if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || rec->NumberParameters < 2) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const auto addr = static_cast<std::uintptr_t>(rec->ExceptionInformation[1]);
+    for (const LazyRange& r : lazy_ranges) {
+        const std::uintptr_t begin = r.begin.load(std::memory_order_acquire);
+        const std::uintptr_t end = r.end.load(std::memory_order_acquire);
+        if (begin != 0 && addr >= begin && addr < end) {
+            const std::uintptr_t chunk = std::max(begin, addr & ~(kCommitChunk - 1));
+            const std::size_t length = static_cast<std::size_t>(std::min(end, chunk + kCommitChunk) - chunk);
+            return VirtualAlloc(reinterpret_cast<void*>(chunk), length, MEM_COMMIT, PAGE_READWRITE) ? EXCEPTION_CONTINUE_EXECUTION
