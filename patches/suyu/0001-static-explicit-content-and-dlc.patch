+            const int tw = static_cast<int>(extent.width) / tiles;
+            const int th = static_cast<int>(extent.height) / tiles;
+            for (size_t i = 0; i < drawn_targets.size() && i < 16; ++i) {
+                Image* src = drawn_targets[i];
