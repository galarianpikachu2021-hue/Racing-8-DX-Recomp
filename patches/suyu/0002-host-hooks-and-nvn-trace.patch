+// ---- Reconstructed state ----------------------------------------------------
+
+struct State {
+    std::mutex lock;
+    // KARTRECOMP_NVN_COUNTER_PROBE=1 (research): what the counter reports hold a few frames after they were recorded.
+    std::vector<std::tuple<u32, u64, u64>> counter_probe; ///< type, GPU address, frame
