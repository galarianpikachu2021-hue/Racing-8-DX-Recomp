+SystemConfig MakeSystemConfig() {
+    SystemConfig cfg;
+    const auto lang = static_cast<size_t>(Settings::values.language_index.GetValue());
+    if (lang < LanguageCodes().size()) cfg.language = LanguageCodes()[lang];
+    cfg.region = static_cast<int>(Settings::values.region_index.GetValue());
+    cfg.docked = Settings::IsDockedMode();
+    return cfg;
+}
+
+AccountConfig MakeAccountConfig(Core::System& system) {
+    AccountConfig cfg;
+    const auto& pm = system.GetProfileManager();
+    const auto last = pm.GetLastOpenedUser();
+    for (size_t i = 0; i < pm.GetUserCount(); ++i) {
+        Service::Account::ProfileBase base{};
+        if (!pm.GetProfileBase(i, base)) continue;
+        UserProfile u;
+        std::memcpy(u.uuid.data(), &base.user_uuid, 16);
+        u.timestamp = base.timestamp;
+        const char* n = reinterpret_cast<const char*>(base.username.data());
+        u.name.assign(n, strnlen(n, base.username.size()));
+        if (base.user_uuid == last) cfg.users.insert(cfg.users.begin(), u); // the playing user first
+        else cfg.users.push_back(u);
+    }
+    cfg.account_id = last.Hash();
+    return cfg;
+}
+
+/// The DLC among the player's files (the same list the emulated "aoc:u" builds).
+AddOnConfig MakeAddOnConfig(Core::System& system) {
+    AddOnConfig cfg;
+    const u64 program = system.GetApplicationProcessProgramID();
+    const u64 base = FileSys::GetBaseTitleID(program);
+    const auto& rcu = system.GetContentProvider();
+    const auto& disabled = Settings::values.disabled_addons[base];
+    if (std::find(disabled.begin(), disabled.end(), "DLC") == disabled.end()) {
+        for (const auto& e : rcu.ListEntriesFilter(FileSys::TitleType::AOC, FileSys::ContentRecordType::Data)) {
+            if (FileSys::GetBaseTitleID(e.title_id) != base) continue;
+            const auto nca = rcu.GetEntry(e.title_id, FileSys::ContentRecordType::Data);
+            if (!nca || nca->GetStatus() != Loader::ResultStatus::Success) continue;
+            cfg.contents.push_back(static_cast<u32>(FileSys::GetAOCID(e.title_id)));
+        }
+    }
+    const FileSys::PatchManager pm{program, system.GetFileSystemController(), system.GetContentProvider()};
+    const auto control = pm.GetControlMetadata();
+    cfg.base_id = control.first ? control.first->GetDLCBaseTitleId() : FileSys::GetAOCBaseTitleID(program);
+    return cfg;
+}
