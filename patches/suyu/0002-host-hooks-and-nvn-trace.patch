+    const auto addr = static_cast<std::uintptr_t>(rec->ExceptionInformation[1]);
+    for (const LazyRange& r : lazy_ranges) {
+        const std::uintptr_t begin = r.begin.load(std::memory_order_acquire);
+        const std::uintptr_t end = r.end.load(std::memory_order_acquire);
+        if (begin != 0 && addr >= begin && addr < end) {
+            const std::uintptr_t chunk = std::max(begin, addr & ~(kCommitChunk - 1));
+            const std::size_t length = static_cast<std::size_t>(std::min(end, chunk + kCommitChunk) - chunk);
