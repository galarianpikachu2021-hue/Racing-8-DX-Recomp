+
+    // Descriptor pools: TIC/TSC entries live in a memory pool at (pool, offset).
+    h["nvnTexturePoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.texture_pool = {ctx.x[1], ctx.x[2], Arg32(ctx, 3)};
+        PublishDescriptorPool(s, s.texture_pool, s.tic_base, s.tic_count);
+        KartRe::Log("texture-pool-init pool={:#x} mempool={:#x} offset={:#x} count={}", ctx.x[0],
+                    ctx.x[1], ctx.x[2], Arg32(ctx, 3));
+        LOG_INFO(Core_ARM, "nvn-host: texture pool mempool={:#x} offset={:#x} count={}", ctx.x[1],
+                 ctx.x[2], Arg32(ctx, 3));
+    };
+    h["nvnSamplerPoolInitialize"] = [](HookContext& ctx, State& s) {
+        s.sampler_pool = {ctx.x[1], ctx.x[2], Arg32(ctx, 3)};
+        PublishDescriptorPool(s, s.sampler_pool, s.tsc_base, s.tsc_count);
+        LOG_INFO(Core_ARM, "nvn-host: sampler pool mempool={:#x} offset={:#x} count={}", ctx.x[1],
+                 ctx.x[2], Arg32(ctx, 3));
+    };
+    // Texture pool: handles carry the registered ID.
+    h["nvnTexturePoolRegisterTexture"] = [](HookContext& ctx, State& s) {
+        const TextureDesc d = ResolveTexture(ctx, s, ctx.x[2]);
+        std::unique_lock lock{s.texture_id_lock};
+        s.texture_ids[Arg32(ctx, 1)] = d;
+    };
+    return h;
+}
+
+/// Exclusive mode replaces these NVN command-buffer calls outright: nvn-host
+/// records them for the native backend and returns to the game without running
+/// the guest driver, so neither the driver (pushbuffer encoding) nor the
+/// emulated GPU (decoding it, to draw nothing) does the work. Sync, queries,
+/// conditional rendering, copies and recording begin/end stay on the driver.
+/// KARTRECOMP_NATIVE_KEEP_NVN=1 keeps everything on the driver.
+bool Replaced(const std::string& name) {
+    static const bool keep = std::getenv("KARTRECOMP_NATIVE_KEEP_NVN") != nullptr;
+    if (keep || !Exclusive()) {
+        return false;
+    }
+    static const std::set<std::string> names{
+        "nvnCommandBufferBindUniformBuffer", "nvnCommandBufferBindTexture",
+        "nvnCommandBufferBindProgram", "nvnCommandBufferBindVertexBuffer",
+        "nvnCommandBufferSetRenderTargets", "nvnCommandBufferBindColorState",
+        "nvnCommandBufferSetViewport", "nvnCommandBufferBindBlendState",
+        "nvnCommandBufferBindVertexStreamState", "nvnCommandBufferBindVertexAttribState",
+        "nvnCommandBufferSetBlendColor", "nvnCommandBufferBindChannelMaskState",
+        "nvnCommandBufferDrawElements", "nvnCommandBufferSetScissor",
+        "nvnCommandBufferBindDepthStencilState", "nvnCommandBufferBindPolygonState",
+        "nvnCommandBufferDrawElementsInstanced", "nvnCommandBufferUpdateUniformBuffer",
+        "nvnCommandBufferDrawElementsBaseVertex", "nvnCommandBufferClearColor",
+        "nvnCommandBufferSetPolygonOffsetClamp", "nvnCommandBufferSetDepthClamp",
+        "nvnCommandBufferSetRasterizerDiscard", "nvnCommandBufferBindStorageBuffer",
+        "nvnCommandBufferDrawArraysInstanced", "nvnCommandBufferClearDepthStencil",
+        "nvnCommandBufferDrawArrays", "nvnCommandBufferSetViewports",
+        "nvnCommandBufferSetScissors", "nvnCommandBufferSetDepthRange",
+        // Pure state the native backend does not model yet and the (Null) emulated
+        // GPU does not need.
+        "nvnCommandBufferSetStencilRef", "nvnCommandBufferSetStencilValueMask",
+        "nvnCommandBufferSetStencilMask", "nvnCommandBufferSetDepthBounds",
+        "nvnCommandBufferBindMultisampleState", "nvnCommandBufferSetPointSize",
+        "nvnCommandBufferSetLineWidth",
+    };
+    return names.contains(name);
+}
+
+/// Returns from a replaced NVN call (all are void): resume at the caller.
+bool ReturnFromCall(HookContext& ctx) {
+    ctx.pc = ctx.x[30];
+    return true;
+}
+
+/// Handlers that must also see the return value.
+void InstallReturnHandlers(const std::string& name, u64 address) {
+    if (name == "nvnCommandBufferEndRecording") {
+        RecompHooks::Install(address, [](HookContext& ctx) {
+            const u64 cmdbuf = ctx.x[0];
+            RecompHooks::TrapReturn(ctx, [cmdbuf](HookContext& ret) {
+                auto& s = S();
+                std::scoped_lock lock{s.lock};
+                auto node = s.recording.extract(cmdbuf);
+                if (!node.empty()) {
+                    s.recorded_size[cmdbuf] = node.mapped().size();
+                    s.lists[ret.x[0]] = std::make_shared<const std::vector<Command>>(std::move(node.mapped()));
+                }
+            });
+            return false;
+        });
+    } else if (name == "nvnMemoryPoolGetBufferAddress") {
+        RecompHooks::Install(address, [](HookContext& ctx) {
+            const u64 pool = ctx.x[0];
+            RecompHooks::TrapReturn(ctx, [pool](HookContext& ret) {
+                auto& s = S();
+                std::scoped_lock lock{s.lock};
+                if (const auto it = s.pools.find(pool); it != s.pools.end()) {
+                    it->second.gpu_base = ret.x[0];
+                }
+            });
+            return false;
+        });
+    }
+}
+
+bool IsDraw(const std::string& name) {
+    return name.starts_with("nvnCommandBufferDraw");
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_GPU");
+        return v && (std::strcmp(v, "shadow") == 0 || std::strcmp(v, "native") == 0);
+    }();
+    return enabled;
+}
+
+bool Exclusive() {
+    static const bool exclusive = [] {
+        const char* v = std::getenv("KARTRECOMP_NATIVE_GPU");
+        return v && std::strcmp(v, "native") == 0;
+    }();
+    return exclusive;
+}
+
+/// 32-byte hardware descriptor (TIC/TSC) number id of a descriptor pool. Lock held.
+
+
+bool ReadGpuMemoryInSubmit(u64 gpu_address, void* out, size_t size) {
+    return ReadGpu(S(), gpu_address, out, size, true);
+}
+
+bool ReadGpuMemory(u64 gpu_address, void* out, size_t size) {
+    const bool ok = ReadGpu(S(), gpu_address, out, size);
+    if (!ok && KartRe::Enabled()) {
+        static std::atomic<int> shown{0};
+        if (shown.fetch_add(1) < 20) {
+            auto& s = S();
+            std::scoped_lock lock{s.lock};
+            for (const auto& [obj, pool] : s.pools) {
+                for (const u64 base : pool.gpu_bases) {
+                    if (gpu_address >= base && gpu_address < base + pool.size) {
+                        KartRe::Log("unmapped-detail gpu={:#x}+{:#x} in pool {:#x} base={:#x} size={:#x} "
+                                    "storage={:#x} flags={:#x}",
+                                    gpu_address, size, obj, base, pool.size, pool.storage, pool.flags);
+                    }
+                }
+            }
+        }
+    }
+    return ok;
+}
+
+bool ReadGuestMemory(u64 address, void* out, size_t size) {
+    auto& s = S();
+    Core::System* system = s.system_ptr.load(std::memory_order_acquire);
+    return system && system->ApplicationMemory().ReadBlock(address, out, size);
+}
+
+int WindowOriginMode() {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    return s.window_origin;
+}
+
+u64 ShaderControlAddress(u64 shader_data) {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    const auto it = s.shader_controls.find(shader_data);
+    return it == s.shader_controls.end() ? 0 : it->second;
+}
+
+bool ReadTextureDescriptor(u32 id, void* out32) {
+    auto& s = S();
+    return ReadPublishedDescriptor(s, s.tic_base, s.tic_count, id, out32);
+}
+
+u32 TextureDescriptorCount() {
+    return S().tic_count.load(std::memory_order_acquire);
+}
+
+bool ReadSamplerDescriptor(u32 id, void* out32) {
+    auto& s = S();
+    return ReadPublishedDescriptor(s, s.tsc_base, s.tsc_count, id, out32);
+}
+
+TextureDesc LookupTextureId(u32 id) {
+    auto& s = S();
+    std::shared_lock lock{s.texture_id_lock};
+    const auto it = s.texture_ids.find(id);
+    return it == s.texture_ids.end() ? TextureDesc{} : it->second;
+}
+
+void ShutdownBackends() {
+    std::vector<std::unique_ptr<Backend>> doomed;
+    {
+        auto& s = S();
+        std::scoped_lock lock{s.lock};
+        doomed.swap(s.backends);
+    }
+    doomed.clear(); // outside the lock: render threads may still be reading the model
+}
+
+void AddBackend(std::unique_ptr<Backend> backend) {
+    auto& s = S();
+    std::scoped_lock lock{s.lock};
+    s.backends.push_back(std::move(backend));
+}
+
+void OnResolved(const std::string& name, u64 address) {
+    KartRe::Log("onresolved {} {:#x}", name, address);
+    ++S().resolved_calls;
+    if (address == 0) {
+        return;
+    }
+    static const auto handlers = BuildHandlers();
+    auto& s = S();
+    {
+        // The game resolves some entry points twice (bootstrap loader and
+        // GetProcAddress); hook each address once or every call counts double.
+        static std::set<u64> installed;
+        std::scoped_lock lock{s.lock};
+        if (!installed.insert(address).second) {
+            return;
+        }
+        static bool stats_added = false;
+        if (!stats_added) {
+            s.backends.push_back(std::make_unique<StatsBackend>());
+            stats_added = true;
+            // Translation statistics only; the Vulkan backend translates what it draws.
+            if (KartRe::Enabled()) {
+                std::thread(ShaderWorker).detach();
+            }
+        }
+    }
+    KartRe::Log("resolved {} {:#x}", name, address);
+    InstallReturnHandlers(name, address);
+    // RE: generic argument + struct log for state setters and binders.
+    if (KartRe::Enabled() &&
+        (name.find("State") != std::string::npos || name.starts_with("nvnTextureView") ||
+         name == "nvnCommandBufferSetRenderTargets" || name == "nvnCommandBufferBindVertexBuffer" ||
+         name == "nvnCommandBufferSetViewport" || name == "nvnCommandBufferSetScissor" ||
+         name == "nvnCommandBufferBindProgram" || name == "nvnCommandBufferBindStorageBuffer" ||
+         name == "nvnDeviceGetTextureHandle" || name == "nvnTexturePoolRegisterTexture" ||
+         name.starts_with("nvnSamplerBuilder") || name == "nvnSamplerInitialize" ||
+         name == "nvnSamplerPoolRegisterSampler")) {
+        auto counter = std::make_shared<std::atomic<int>>(0);
+        RecompHooks::Install(address, [name, counter](HookContext& ctx) {
+            if (counter->fetch_add(1) >= 400) {
+                return false;
+            }
+            const bool array_bind = name.find("BindVertex") != std::string::npos &&
+                                    name.find("State") != std::string::npos;
+            const u64 ptr = array_bind ? ctx.x[2] : (name.find("Bind") != std::string::npos ? ctx.x[1] : ctx.x[0]);
+            u32 w[12]{};
+            Mem(ctx).ReadBlock(ptr, w, sizeof(w));
+            float f[4];
+            for (int i = 0; i < 4; ++i) {
+                f[i] = ArgF(ctx, i);
+            }
+            KartRe::Log("state {} x0={:#x} x1={:#x} x2={:#x} x3={:#x} x4={:#x} x5={:#x} | v {} {} {} {} | "
+                        "[{:#x}] {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} {:08x} "
+                        "{:08x} {:08x}",
+                        name, ctx.x[0], ctx.x[1], ctx.x[2], ctx.x[3], ctx.x[4], ctx.x[5], f[0], f[1],
+                        f[2], f[3], ptr, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9],
+                        w[10], w[11]);
+            return false;
+        });
+    }
+    if (IsDraw(name) || name == "nvnCommandBufferDispatchCompute") {
+        u16 entry;
+        {
+            std::scoped_lock lock{s.lock};
+            entry = EntryIndex(s, name);
+        }
+        const Op op = IsDraw(name) ? Op::Draw : Op::Dispatch;
+        const DrawKind kind = name == "nvnCommandBufferDrawElements"             ? DrawKind::Elements
+                              : name == "nvnCommandBufferDrawElementsInstanced"  ? DrawKind::ElementsInstanced
+                              : name == "nvnCommandBufferDrawElementsBaseVertex" ? DrawKind::ElementsBaseVertex
+                              : name == "nvnCommandBufferDrawArrays"             ? DrawKind::Arrays
+                              : name == "nvnCommandBufferDrawArraysInstanced"    ? DrawKind::ArraysInstanced
+                                                                                 : DrawKind::Other;
+        const bool replaced = Replaced(name);
+        RecompHooks::Install(address, [entry, op, kind, replaced](HookContext& ctx) {
+            auto& st = S();
+            Command c{.op = op, .entry = entry, .draw = kind};
+            std::memcpy(c.args, ctx.x + 1, sizeof(c.args));
+            if (op == Op::Dispatch) {
+                KartRe::Log("nvn-dispatch groups={}x{}x{}", ctx.x[1], ctx.x[2], ctx.x[3]);
+            }
+            {
+                std::scoped_lock lock{st.lock};
+                Append(st, ctx.x[0], std::move(c));
+            }
+            return replaced && ReturnFromCall(ctx);
+        });
+        return;
+    }
+    const auto it = handlers.find(name);
+    if (it == handlers.end()) {
+        if (Replaced(name)) {
+            RecompHooks::Install(address, [](HookContext& ctx) { return ReturnFromCall(ctx); });
+        }
+        return;
+    }
+    const Handler& handler = it->second;
+    const bool present = name == "nvnQueuePresentTexture";
+    const bool replaced = Replaced(name);
+    auto* timing = &S().hook_time[it->first]; // node-based map: stable address
+    RecompHooks::Install(address, [&handler, present, timing, replaced](HookContext& ctx) {
+        auto& st = S();
+        std::vector<Backend*> throttle;
+        const auto t0 = std::chrono::steady_clock::now();
+        {
+            std::scoped_lock lock{st.lock};
+            st.system = &ctx.system;
+            st.system_ptr.store(&ctx.system, std::memory_order_release);
+            handler(ctx, st);
+            if (present) {
+                for (auto& b : st.backends) throttle.push_back(b.get());
+            }
+            timing->first += static_cast<u64>((std::chrono::steady_clock::now() - t0).count());
+            ++timing->second;
+            if (present && ++st.presents_timed % 300 == 0) {
+                std::vector<std::pair<u64, std::string>> top;
+                u64 total = 0;
+                for (const auto& [n, v] : st.hook_time) {
+                    top.emplace_back(v.first, fmt::format("{} {:.3f}ms x{:.0f}", n, static_cast<double>(v.first) / 300.0 / 1e6, static_cast<double>(v.second) / 300.0));
+                    total += v.first;
+                }
+                std::sort(top.rbegin(), top.rend());
+                std::string out;
+                for (size_t i = 0; i < top.size() && i < 8; ++i) out += " | " + top[i].second;
+                LOG_INFO(Core_ARM, "nvn-host hook time per frame {:.2f} ms{}", static_cast<double>(total) / 300.0 / 1e6, out);
+                LOG_INFO(Core_ARM, "nvn-host submit split per frame: flatten {:.3f} ms, backend0 {:.3f}, backend1 {:.3f}",
+                         static_cast<double>(st.submit_flatten_ns) / 300e6, static_cast<double>(st.submit_backend_ns[0]) / 300e6,
+                         static_cast<double>(st.submit_backend_ns[1]) / 300e6);
+                st.submit_flatten_ns = 0;
+                st.submit_backend_ns = {};
+                for (auto& [n, v] : st.hook_time) v = {};
+            }
+        }
+        // Outside the lock: a pacing backend's render thread reads the model.
+        for (Backend* b : throttle) {
+            b->Throttle();
+        }
+        return replaced && ReturnFromCall(ctx);
+    });
+}
+
+} // namespace Core::NvnHost
