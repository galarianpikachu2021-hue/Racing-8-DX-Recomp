+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: nvn-host, the native NVN implementation (shadow stage).
+//
+// Shadow stage: every relevant NVN call is observed through the static
+// dispatcher's host hooks (core/arm/recomp/host_hooks.h) while the game keeps
+// running on the emulated GPU. From the setters alone this rebuilds the game's
+// objects (memory pools, textures, windows) and its command stream (recorded
+// command buffers, submits, presents), and hands each submitted frame to a
+// Backend. Nothing depends on the guest driver's private struct layouts.
+//
+// When the native backend renders frames equal to the emulated ones, the same
+// handlers switch from observing to answering the calls, and the emulated GPU
+// goes away.
+//
+// Enabled with KARTRECOMP_NATIVE_GPU=shadow (beside the emulated output) or =native
+// (the only renderer). Report: <log dir>/nvn_host.txt.
+#pragma once
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Core::NvnHost {
+
+/// What a texture object describes: its storage and its shape. NVN textures are
+/// descriptors over memory-pool storage, so two objects with the same storage
+/// and description are the same image to a native backend.
+struct TextureDesc {
+    u64 pool = 0;   ///< guest NVNmemoryPool object
+    u64 offset = 0; ///< byte offset of the storage inside the pool
+    u32 target = 0;
+    u32 format = 0;
+    u32 width = 0;
+    u32 height = 1;
+    u32 depth = 1;
+    u32 levels = 1;
+    u32 samples = 0;
+    u32 flags = 0;
+    bool valid = false;
+
+    bool operator==(const TextureDesc&) const = default;
+};
+
+struct MemoryPool {
+    u64 storage = 0; ///< guest CPU address of the pool's memory
+    u64 size = 0;
+    u32 flags = 0;
+    u64 gpu_base = 0; ///< first GPU mapping (kept for reports)
+    /// Every GPU mapping of this pool's storage (pitch / block-linear / special
+    /// views all alias the same bytes). Read from the struct at init.
+    std::vector<u64> gpu_bases;
+};
+
+enum class Op : u8 {
+    SetRenderTargets,
+    ClearColor,
+    ClearDepthStencil,
+    Draw,
+    Dispatch,
+    BindProgram,       ///< shaders = NVN shader data addresses of the program
+    BindVertexAttribs, ///< words = packed attribute states (4 bytes each)
+    BindVertexStreams, ///< words = stride, divisor pairs
+    BindVertexBuffer,  ///< index, address, size
+    BindUniformBuffer, ///< stage, index (NVN slot), address, size
+    BindTexture,       ///< stage, index (NVN slot), handle
+    BindDepthStencil,  ///< raw (8-byte state)
+    BindColor,         ///< raw (8-byte state)
+    BindChannelMask,   ///< raw (4-byte state)
+    BindBlend,         ///< raw (8-byte state)
+    BindPolygon,       ///< raw (4-byte state), index = offset enables (1 point, 2 line, 4 fill)
+    Viewport,          ///< rect
+    Scissor,           ///< rect
+    RasterizerDiscard, ///< index = enabled
+    BindStorageBuffer, ///< stage, index (NVN slot), address, size
+    UpdateUniformBuffer, ///< address = buffer, size = buffer size, raw = offset, bytes = data
+    /// address = source buffer, colors[0] = destination texture, words = x, y, z,
+    /// width, height, depth, level, layer, row stride, image stride (0 = packed).
+    CopyBufferToTexture,
+    PolygonOffset, ///< rgba = factor (slope), units, clamp
+    DepthClamp,    ///< index = enabled (no near/far clipping; shadow maps)
+    DepthRange,    ///< rgba = near, far (viewport depth range)
+    BlendColor,    ///< rgba = blend constant
+    Call,          ///< call = a nested command list (CallCommands), executed in place
+};
+
+enum class DrawKind : u8 {
+    Elements,              ///< mode, index_type, count, index_address
+    ElementsInstanced,     ///< + base_vertex, base_instance, instance_count
+    ElementsBaseVertex,    ///< + base_vertex
+    Arrays,                ///< mode, first, count
+    ArraysInstanced,       ///< + base_instance, instance_count
+    Other,
+};
+
+struct Command {
+    Op op{};
+    // SetRenderTargets
+    std::vector<TextureDesc> colors;
+    TextureDesc depth;
+    /// Per color target, from its NVNtextureView: base mip level and an NVN format
+    /// override (0 = the texture's own), e.g. rendering through an sRGB view.
+    std::vector<u32> color_levels;
+    std::vector<u32> color_view_formats;
+    /// Per color target, the array layer its view selects (layered targets such as
+    /// a 2-layer HDR buffer are rendered one layer at a time); same for depth.
+    std::vector<u32> color_layers;
+    u32 depth_layer = 0;
+    // ClearColor: index + rgba (as raw float bits) + mask; ClearDepthStencil: depth/stencil
+    u32 index = 0;
+    float rgba[4]{};
+    u32 mask = 0;
+    float depth_value = 0;
+    u32 stencil_value = 0;
+    // Draw: which entry point and its scalar arguments (x1..x7 as passed)
+    u16 entry = 0;
+    DrawKind draw = DrawKind::Other;
+    u64 args[7]{};
+    // Binds
+    std::vector<u64> shaders;
+    std::vector<u32> words;
+    u32 stage = 0;
+    u64 address = 0;
+    u64 size = 0;
+    u64 handle = 0;
+    u64 raw = 0;
+    s32 rect[4]{};
+    std::vector<u8> bytes; ///< UpdateUniformBuffer payload, captured at record time
+    std::shared_ptr<const std::vector<Command>> call; ///< Op::Call
+};
+
+/// Recorded command lists are immutable once recording ends and are shared, not
+/// copied: a submit carries pointers into them plus references keeping them alive.
+using CommandList = std::shared_ptr<const std::vector<Command>>;
+
+struct SubmitData {
+    std::vector<const Command*> commands; ///< flattened (Call entries expanded)
+    std::vector<CommandList> lists;       ///< owners of everything `commands` points into
+};
+
+/// Receives the reconstructed frames. The shadow stage ships a statistics
+/// backend; Vulkan (desktop/Android) and Metal implement the same interface.
+class Backend {
+public:
+    virtual ~Backend() = default;
+    /// One QueueSubmitCommands, already flattened (CallCommands expanded).
+    virtual void Submit(const SubmitData& submit) = 0;
+    /// QueuePresentTexture: the window texture the game wants on screen.
+    virtual void Present(const TextureDesc& texture, u32 window_index) = 0;
+    /// Called after each present with no model lock held: a backend that is the
+    /// real renderer blocks here to pace the game instead of dropping frames.
+    virtual void Throttle() {}
+    /// nvnWindowSetCrop: the part of the window textures the game actually drew (handheld mode draws 1280x720 into the 1920x1080
+    /// window textures the display layer hands out). The presented picture is this rectangle. Model lock held: don't block.
+    virtual void OnWindowCrop(s32 x, s32 y, s32 w, s32 h) {}
+    /// nvnProgramSetShaders on a graphics program (model lock held: don't block).
+    /// Games create programs while loading, so a backend can translate early.
+    virtual void OnProgram(const std::vector<u64>& shader_datas) {}
+};
+
+bool Enabled();
+
+/// KARTRECOMP_NATIVE_GPU=native: the native backend is the only renderer. The
+/// emulated GPU still consumes the command stream (syncpoints, fences) through
+/// suyu's Null renderer but draws nothing.
+bool Exclusive();
+
+/// Reads guest memory by GPU address (through the memory pools). Thread-safe.
+bool ReadGpuMemory(u64 gpu_address, void* out, size_t size);
+
+/// Same, for use only inside Backend::Submit / Backend::Present (the model lock
+/// is already held there). Lets a backend snapshot data the game will overwrite.
+bool ReadGpuMemoryInSubmit(u64 gpu_address, void* out, size_t size);
+
+/// Guest CPU memory (e.g. an NVN shader control section). Thread-safe.
+bool ReadGuestMemory(u64 address, void* out, size_t size);
+
+/// The game's nvnDeviceSetWindowOriginMode argument, or -1 if never set.
+int WindowOriginMode();
+
+/// The control-section address NVN was given for this shader data, or 0.
+u64 ShaderControlAddress(u64 shader_data);
+
+/// The 32-byte hardware texture (TIC) / sampler (TSC) descriptor with this ID,
+/// read from the game's descriptor pools. Thread-safe.
+bool ReadTextureDescriptor(u32 id, void* out32);
+/// Number of descriptors in the published texture pool (ids below it can be read with ReadTextureDescriptor).
+u32 TextureDescriptorCount();
+bool ReadSamplerDescriptor(u32 id, void* out32);
+
+/// The texture registered in the texture pool under this ID (handles carry it
+/// in their low 20 bits), or an invalid desc.
+TextureDesc LookupTextureId(u32 id);
+
+/// Called by the NVN resolver for every entry point the game resolves.
+void OnResolved(const std::string& name, u64 address);
+
+/// Adds a backend; every backend sees every frame. A statistics backend is
+/// always present. Takes ownership.
+void AddBackend(std::unique_ptr<Backend> backend);
+
+/// Destroys every backend (joins render threads, closes windows). Frames
+/// submitted afterwards are dropped. Call before the frontend tears down SDL.
+void ShutdownBackends();
+
+} // namespace Core::NvnHost
