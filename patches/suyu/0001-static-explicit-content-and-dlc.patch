+// SPDX-FileCopyrightText: Copyright 2026 suyu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+namespace SuyuCmd {
+
+/// KARTRECOMP_PROFILE=<start_s>,<seconds>[,wall]: samples every thread of the
+/// process at 1 kHz (CPU time, or wall time with ",wall") and writes the samples
+/// to KARTRECOMP_PROFILE_OUT (default profile.txt). Each sample is the thread, its time in
+/// ms since the first sample, the
+/// interrupted instruction and the first code addresses found on its stack, which
+/// stand in for callers since the recompiled code has no frame pointers.
+/// tools/profile-report.py symbolizes the file. No-op without the variable.
+void StartSamplingProfiler();
+
+} // namespace SuyuCmd
