+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime: virtual CPU cores for host threads.
+//
+// On the console every game thread belongs to a core; at most one thread runs per core, the runnable thread with the best
+// priority (lowest number) always runs, and equal priorities take turns only when the running one blocks or yields. Games rely on
+// this (threads of one core share data without locks). Here every game thread is a real host thread, and this class decides which
+// of them may execute game code:
+//
+//   Acquire(t)  the thread wants to run: returns when it is the running thread of its core
+//   Release(t)  the thread stops running (it is about to wait, or it ended): the core goes to the best waiting thread
+//   Yield(t)    lets waiting threads of the same or better priority run first, then continues
+//   PreemptRequested(t)  true when a better-priority thread waits for t's core: t should Yield at its next safe point
+//
+// No dependencies beyond the standard library; see README.md.
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace KartRuntime {
+
+class CoreScheduler {
+public:
+    class Thread {
+    public:
+        int Core() const { return core; }
+        int Priority() const { return priority; }
+
+    private:
+        friend class CoreScheduler;
+        int core = 0;
+        int priority = 0;
+        bool waiting = false;         ///< in its core's wait list
+        bool granted = false;         ///< it is the running thread of its core
+        std::uint64_t order = 0;      ///< arrival order among equal priorities
+        std::atomic<bool> preempt{false};
+        std::condition_variable wake;
+    };
+
+    explicit CoreScheduler(int core_count) : cores(static_cast<std::size_t>(core_count)) {}
+
+    /// Called (with the scheduler's lock held: keep it short, do not call back in) when a running thread is asked to yield, so
+    /// the owner can interrupt whatever that thread is executing. Optional.
+    void SetPreemptCallback(std::function<void(Thread*)> fn) { on_preempt = std::move(fn); }
+
+    /// A new thread for `core` with `priority` (lower = runs first). Not running yet.
+    std::unique_ptr<Thread> Create(int core, int priority) {
+        auto t = std::make_unique<Thread>();
+        t->core = core;
+        t->priority = priority;
+        return t;
+    }
+
+    void Acquire(Thread* t) {
+        std::unique_lock lk{lock};
+        Enqueue(t);
+        Dispatch(t->core);
+        t->wake.wait(lk, [t] { return t->granted; });
+    }
+
+    void Release(Thread* t) {
+        std::scoped_lock lk{lock};
+        ReleaseLocked(t);
+    }
+
+    void Yield(Thread* t) {
+        std::unique_lock lk{lock};
+        t->preempt.store(false, std::memory_order_relaxed);
+        if (!BetterOrEqualWaiter(t)) return;
+        ReleaseLocked(t);
+        Enqueue(t);
+        Dispatch(t->core);
+        t->wake.wait(lk, [t] { return t->granted; });
+    }
+
+    bool PreemptRequested(const Thread* t) const { return t->preempt.load(std::memory_order_relaxed); }
+
+    /// Changes take effect at once: a waiting thread is re-sorted, a running one may get a preemption request.
+    void SetPriority(Thread* t, int priority) {
+        std::scoped_lock lk{lock};
+        t->priority = priority;
+        Dispatch(t->core);
+    }
+
+    /// Moves a thread to another core. A running thread keeps running until it next releases or yields (ask it with
+    /// PreemptRequested); a waiting one waits for the new core.
+    void SetCore(Thread* t, int core) {
+        std::scoped_lock lk{lock};
+        const int old = t->core;
+        if (old == core) return;
+        if (t->waiting) {
+            Remove(cores[static_cast<std::size_t>(old)].waiting, t);
+            t->core = core;
+            cores[static_cast<std::size_t>(core)].waiting.push_back(t);
+            Dispatch(core);
+        } else if (t->granted) {
+            // Leave the old core now and queue for the new one; the thread itself blocks at its next Yield/Acquire.
+            cores[static_cast<std::size_t>(old)].running = nullptr;
+            t->granted = false;
+            t->core = core;
+            Enqueue(t);
+            RequestPreempt(t);
+            Dispatch(old);
+            Dispatch(core);
+        } else {
+            t->core = core;
+        }
+    }
+
+    /// The running thread of a core (null when idle). For diagnostics and tests.
+    const Thread* Running(int core) {
+        std::scoped_lock lk{lock};
+        return cores[static_cast<std::size_t>(core)].running;
+    }
+
+private:
+    struct CoreState {
+        Thread* running = nullptr;
+        std::vector<Thread*> waiting;
+    };
+
+    static void Remove(std::vector<Thread*>& list, Thread* t) {
+        for (auto it = list.begin(); it != list.end(); ++it) {
+            if (*it == t) {
+                list.erase(it);
+                return;
+            }
+        }
+    }
+
+    void Enqueue(Thread* t) {
+        t->waiting = true;
+        t->granted = false;
+        t->order = ++arrivals;
+        cores[static_cast<std::size_t>(t->core)].waiting.push_back(t);
+    }
+
+    static bool Before(const Thread* a, const Thread* b) {
+        return a->priority != b->priority ? a->priority < b->priority : a->order < b->order;
+    }
+
+    Thread* Best(CoreState& c) {
+        Thread* best = nullptr;
+        for (Thread* w : c.waiting)
+            if (!best || Before(w, best)) best = w;
+        return best;
+    }
+
+    bool BetterOrEqualWaiter(const Thread* t) {
+        for (const Thread* w : cores[static_cast<std::size_t>(t->core)].waiting)
+            if (w->priority <= t->priority) return true;
+        return false;
+    }
+
+    /// Gives an idle core to its best waiter; asks a running thread to yield when a better one waits.
+    void Dispatch(int core) {
+        CoreState& c = cores[static_cast<std::size_t>(core)];
+        Thread* best = Best(c);
+        if (!best) return;
+        if (!c.running) {
+            Remove(c.waiting, best);
+            best->waiting = false;
+            best->granted = true;
+            best->preempt.store(false, std::memory_order_relaxed);
+            c.running = best;
+            best->wake.notify_one();
+            best = Best(c);
+            if (!best) return;
+        }
+        if (best->priority < c.running->priority) RequestPreempt(c.running);
+    }
+
+    void RequestPreempt(Thread* t) {
+        if (t->preempt.exchange(true, std::memory_order_relaxed)) return;
+        if (on_preempt) on_preempt(t);
+    }
+
+    void ReleaseLocked(Thread* t) {
+        CoreState& c = cores[static_cast<std::size_t>(t->core)];
+        if (t->waiting) { // moved to another core while running, or released before it was granted
+            Remove(c.waiting, t);
+            t->waiting = false;
+        }
+        if (c.running == t) c.running = nullptr;
+        t->granted = false;
+        t->preempt.store(false, std::memory_order_relaxed);
+        Dispatch(t->core);
+    }
+
+    std::mutex lock;
+    std::vector<CoreState> cores;
+    std::uint64_t arrivals = 0;
+    std::function<void(Thread*)> on_preempt;
+};
+
+} // namespace KartRuntime
diff --git a/src/kart_runtime/direct_memory.h b/src/kart_runtime/direct_memory.h
new file mode 100644
index 0000000000..6b0956610e
--- /dev/null
+++ b/src/kart_runtime/direct_memory.h
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime: direct game memory.
+//
+// The game's address space is one reserved host range ("arena"): game address A lives at arena + A. Recompiled code built for
+// direct memory reads and writes there with plain host instructions, with no lookup and no call. That only works for pages that
+// are mapped with the right access, so this file supplies what the lookup path used to do for the rest, from a fault handler:
+//
+//   read of an unmapped page    reads zeros (a zero page is mapped there, read-only): what the lookup path returned. A character
+//                               mod that leaves a null object pointer in the game does this every frame; after the first fault
+//                               the page is there and later reads cost nothing.
+//   write to an unmapped page   is dropped: the page is made writable for that one instruction (single step), then replaced with
+//                               a zero page again. Two signals per write is far too slow for code that fills a whole buffer it
+//                               never got (a game without firmware decodes Mii data into a null buffer, 300,000 writes a
+//                               second), so a page that takes kSinkAfter such writes becomes a "sink": it stays writable, and
+//                               ZeroSinks(), which the caller runs once per frame, empties all sinks. Writes to a sink are
+//                               gone by the next frame instead of at once.
+//   access to a mapped page the game has no permission for (the lookup path ignored permissions): the page is opened for good.
+//
+// Faults outside the arena are not ours and go to the previous handler. Everything is counted (Stats) so a caller can log it.
+// Linux x86-64 only for now; Install returns false elsewhere and the caller must not load direct-memory game code then.
+// No dependencies beyond the standard library and the OS; see README.md.
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#if defined(__linux__) && defined(__x86_64__)
+#include <signal.h>
+#include <sys/mman.h>
+#include <ucontext.h>
+#endif
+
+namespace KartRuntime::DirectMemory {
+
+/// True when the game has this address mapped. Called from the fault handler: it may only read memory (no locks, no allocation).
+using IsMappedFn = bool (*)(std::uint64_t game_address);
+
+struct Stats {
+    std::atomic<std::uint64_t> unmapped_reads{0};  ///< faults: reads of unmapped pages (each page faults once)
+    std::atomic<std::uint64_t> unmapped_writes{0}; ///< faults: dropped writes to unmapped pages
+    std::atomic<std::uint64_t> opened_pages{0};    ///< mapped pages opened because the game lacked permission
+    std::atomic<std::uint64_t> last_unmapped{0};   ///< game address of the latest unmapped access
+    std::atomic<std::uint64_t> last_opened{0};     ///< game address of the latest opened page
+    std::atomic<std::uint64_t> sink_pages{0};      ///< unmapped pages that take writes without a fault (emptied by ZeroSinks)
+    std::atomic<std::uint64_t> last_write_ip{0};   ///< host instruction address of the latest dropped write (which code did it)
+};
+
+inline Stats& GetStats() {
+    static Stats stats;
+    return stats;
+}
+
+namespace Detail {
+inline std::atomic<std::uint8_t*> g_base{nullptr};
+inline std::atomic<std::uint64_t> g_size{0};
+inline std::atomic<IsMappedFn> g_is_mapped{nullptr};
+inline constexpr std::uint32_t kSinkAfter = 16;   ///< dropped writes to one page before it becomes a sink
+inline constexpr std::size_t kCountSlots = 4096;  ///< write counters, a direct-mapped cache keyed by page
+inline constexpr std::size_t kMaxRanges = 1024;   ///< separate sink ranges; past that, writes are single-stepped again
+inline constexpr std::uint64_t kMaxGrow = 1u << 20; ///< a range that keeps being extended grows by up to this much at once
+inline std::atomic<std::uint64_t> g_count_page[kCountSlots];
+inline std::atomic<std::uint32_t> g_count[kCountSlots];
+/// Sink ranges [start, end) in game addresses. Code that fills a buffer it never got walks upwards through memory, so a sink is
+/// usually the page after an existing range: ranges keep the list short and let the range grow ahead of the writer.
+struct SinkRange {
+    std::uint64_t start, end;
+};
+inline SinkRange g_ranges[kMaxRanges];
+inline std::size_t g_range_count = 0;
+inline std::atomic_flag g_range_lock = ATOMIC_FLAG_INIT; ///< spin lock: taken in the fault handler and in ZeroSinks
+struct RangeLock {
+    RangeLock() {
+        while (g_range_lock.test_and_set(std::memory_order_acquire)) {
+        }
+    }
+    ~RangeLock() { g_range_lock.clear(std::memory_order_release); }
+};
+
+/// Counts a dropped write to `page` (a game address); true when the page should become a sink now.
+inline bool CountWrite(std::uint64_t page) {
+    const std::size_t slot = (page >> 12) % kCountSlots;
+    if (g_count_page[slot].load(std::memory_order_relaxed) != page + 1) {
+        g_count_page[slot].store(page + 1, std::memory_order_relaxed);
+        g_count[slot].store(1, std::memory_order_relaxed);
+        return false;
+    }
+    return g_count[slot].fetch_add(1, std::memory_order_relaxed) + 1 >= kSinkAfter;
+}
+#if defined(__linux__) && defined(__x86_64__)
+inline struct sigaction g_old_segv {};
+inline struct sigaction g_old_trap {};
+/// Pages made writable for the instruction being stepped (one instruction can touch two pages).
+inline thread_local void* t_stepping[2] = {nullptr, nullptr};
+
+inline void Chain(const struct sigaction& old, int sig, siginfo_t* info, void* raw) {
+    if (old.sa_flags & SA_SIGINFO) {
+        if (old.sa_sigaction) return old.sa_sigaction(sig, info, raw);
+    } else if (old.sa_handler != SIG_DFL && old.sa_handler != SIG_IGN) {
+        return old.sa_handler(sig);
+    }
+    // No earlier handler: die the default way, with the fault reported as itself.
+    struct sigaction dfl {};
+    dfl.sa_handler = SIG_DFL;
+    sigaction(sig, &dfl, nullptr);
+}
+
+inline void OnSegv(int sig, siginfo_t* info, void* raw) {
+    auto* uc = static_cast<ucontext_t*>(raw);
+    std::uint8_t* const base = g_base.load(std::memory_order_relaxed);
+    auto* const fault = static_cast<std::uint8_t*>(info->si_addr);
+    if (!base || fault < base || fault >= base + g_size.load(std::memory_order_relaxed)) return Chain(g_old_segv, sig, info, raw);
+    const std::uint64_t game = static_cast<std::uint64_t>(fault - base);
+    void* const page = base + (game & ~std::uint64_t{0xfff});
+    const bool write = (uc->uc_mcontext.gregs[REG_ERR] & 2) != 0;
+    Stats& stats = GetStats();
+    const IsMappedFn is_mapped = g_is_mapped.load(std::memory_order_relaxed);
+    if (is_mapped && is_mapped(game)) {
+        if (mprotect(page, 0x1000, PROT_READ | PROT_WRITE) != 0) return Chain(g_old_segv, sig, info, raw);
+        stats.opened_pages.fetch_add(1, std::memory_order_relaxed);
+        stats.last_opened.store(game, std::memory_order_relaxed);
+        return;
+    }
+    stats.last_unmapped.store(game, std::memory_order_relaxed);
+    if (!write) {
+        if (mmap(page, 0x1000, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) {
+            return Chain(g_old_segv, sig, info, raw);
+        }
+        stats.unmapped_reads.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    stats.last_write_ip.store(static_cast<std::uint64_t>(uc->uc_mcontext.gregs[REG_RIP]), std::memory_order_relaxed);
+    const std::uint64_t game_page = game & ~std::uint64_t{0xfff};
+    if (CountWrite(game_page)) {
+        RangeLock lock;
+        // The page right after a range extends it, and by as much as the range has already grown (up to kMaxGrow, stopping at
+        // anything the game has mapped): a writer walking through memory soon stops faulting at all.
+        std::uint64_t start = game_page, end = game_page + 0x1000;
+        SinkRange* into = nullptr;
+        for (std::size_t i = 0; i < g_range_count; ++i) {
+            if (g_ranges[i].end == game_page) {
+                into = &g_ranges[i];
+                const std::uint64_t want = std::min(g_ranges[i].end - g_ranges[i].start, kMaxGrow);
+                const std::uint64_t limit = g_size.load(std::memory_order_relaxed);
+                while (end - start < want && end < limit && !(is_mapped && is_mapped(end))) end += 0x1000;
+                break;
+            }
+        }
+        if ((into || g_range_count < kMaxRanges) &&
+            mmap(base + start, end - start, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != MAP_FAILED) {
+            if (into) into->end = end;
+            else g_ranges[g_range_count++] = {start, end};
+            stats.sink_pages.fetch_add((end - start) >> 12, std::memory_order_relaxed);
+            stats.unmapped_writes.fetch_add(1, std::memory_order_relaxed);
+            return; // the write happens, into the sink
+        }
+    }
+    int slot = t_stepping[0] == nullptr ? 0 : (t_stepping[1] == nullptr ? 1 : -1);
+    if (slot < 0 || mmap(page, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) {
+        return Chain(g_old_segv, sig, info, raw);
+    }
+    t_stepping[slot] = page;
+    uc->uc_mcontext.gregs[REG_EFL] |= 0x100; // trap flag: SIGTRAP after this instruction
+    stats.unmapped_writes.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void OnTrap(int sig, siginfo_t* info, void* raw) {
+    if (!t_stepping[0]) return Chain(g_old_trap, sig, info, raw);
+    auto* uc = static_cast<ucontext_t*>(raw);
+    for (void*& page : t_stepping) {
+        if (page) mmap(page, 0x1000, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0); // a fresh zero page: the write is gone
+        page = nullptr;
+    }
+    uc->uc_mcontext.gregs[REG_EFL] &= ~static_cast<greg_t>(0x100);
+}
+#endif
+} // namespace Detail
+
+/// Empties the sink pages (see the top of the file): call once per frame, from any one thread. Sinks the game has mapped real
+/// memory over since are left alone.
+inline void ZeroSinks() {
+#if defined(__linux__) && defined(__x86_64__)
+    std::uint8_t* const base = Detail::g_base.load(std::memory_order_relaxed);
+    if (!base) return;
+    const IsMappedFn is_mapped = Detail::g_is_mapped.load(std::memory_order_relaxed);
+    Detail::RangeLock lock;
+    for (std::size_t i = 0; i < Detail::g_range_count; ++i) {
+        const Detail::SinkRange range = Detail::g_ranges[i];
+        // Pages the game has mapped since are its own now: empty only the runs between them.
+        std::uint64_t run = range.start;
+        for (std::uint64_t page = range.start; page <= range.end; page += 0x1000) {
+            if (page == range.end || (is_mapped && is_mapped(page))) {
+                if (page > run) madvise(base + run, page - run, MADV_DONTNEED);
+                run = page + 0x1000;
+            }
+        }
+    }
+#endif
+}
+
+/// Starts handling faults in [base, base + size). Call once, before game code runs. False when this platform has no handler.
+inline bool Install(std::uint8_t* base, std::uint64_t size, IsMappedFn is_mapped) {
+#if defined(__linux__) && defined(__x86_64__)
+    if (!base || Detail::g_base.load()) return Detail::g_base.load() == base;
+    Detail::g_is_mapped.store(is_mapped);
+    Detail::g_size.store(size);
+    Detail::g_base.store(base);
+    struct sigaction sa {};
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_sigaction = &Detail::OnSegv;
+    if (sigaction(SIGSEGV, &sa, &Detail::g_old_segv) != 0) return false;
+    sa.sa_sigaction = &Detail::OnTrap;
+    return sigaction(SIGTRAP, &sa, &Detail::g_old_trap) == 0;
+#else
+    (void)base, (void)size, (void)is_mapped;
+    return false;
+#endif
+}
+
+} // namespace KartRuntime::DirectMemory
