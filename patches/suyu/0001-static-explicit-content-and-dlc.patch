+void Menu::Build(uint32_t screen_w, uint32_t screen_h, const Stats& stats, std::vector<Quad>& out) const {
+    const float scale = std::max(1.0f, std::round(static_cast<float>(screen_h) / 540.0f));
+    const float cw = kFontCellW * scale, ch = kFontCellH * scale;
+    const uint32_t white = Rgba(1, 1, 1, 1), grey = Rgba(0.55f, 0.55f, 0.58f, 1), shadow = Rgba(0, 0, 0, 0.8f);
+
+    const auto fps_text = [&] {
+        char buf[64];
+        std::snprintf(buf, sizeof buf, "%.0f fps  %.1f ms", stats.fps, stats.frame_ms);
+        return std::string{buf};
+    };
+    if (Recording().load()) {
+        Rect(out, cw * 0.5f, ch * 0.4f, cw * 5.5f, ch * 1.3f, Rgba(0, 0, 0, 0.55f));
+        Text(out, cw, ch * 0.5f, scale, "REC", Rgba(1.0f, 0.25f, 0.25f, 1));
+    }
+    if (!OpenFlag().load()) {
+        if (live.fps_counter) {
+            const std::string t = fps_text();
+            const float x = static_cast<float>(screen_w) - cw * (t.size() + 2), y = ch * 0.5f;
+            Rect(out, x - cw * 0.5f, y - ch * 0.15f, cw * (t.size() + 1), ch * 1.3f, Rgba(0, 0, 0, 0.55f));
+            Text(out, x, y, scale, t, Rgba(0.6f, 1, 0.6f, 1));
+        }
+        return;
+    }
+
+    constexpr int kCols = 50;
+    const float pitch = ch * 1.25f;
+    const float px = cw * 2, py = ch * 2, pw = cw * kCols, rows = static_cast<float>(kRowCount) * 1.25f + 4.5f;
+    Rect(out, px, py, pw, ch * rows, Rgba(0.02f, 0.02f, 0.05f, 0.82f));
+    Rect(out, px, py, pw, ch * 1.6f, Rgba(0.12f, 0.28f, 0.6f, 0.95f));
+    Text(out, px + cw, py + ch * 0.3f, scale, "KartRecomp - in-game settings", white);
+    float y = py + ch * 2.0f;
+    for (int i = 0; i < kRowCount; ++i, y += pitch) {
+        const Item& it = items[i];
+        if (i == selected) Rect(out, px + cw * 0.5f, y - ch * 0.12f, pw - cw, ch * 1.2f, Rgba(0.2f, 0.45f, 0.9f, 0.85f));
+        const uint32_t color = it.enabled ? white : grey;
+        Text(out, px + cw, y, scale, it.label, color);
+        if (!it.options.empty()) {
+            std::string value = it.options[static_cast<size_t>(std::clamp(it.value, 0, static_cast<int>(it.options.size()) - 1))];
+            if (it.enabled) value = "< " + value + " >";
+            Text(out, px + pw - cw * (value.size() + 1), y, scale, value, color);
+            if (!it.note.empty() && i == selected) {
+                Text(out, px + cw * 20, y, scale, "(" + it.note + ")", grey);
+            }
+        }
+    }
+    y += ch * 0.4f;
+    Text(out, px + cw, y, scale, "Up/Down select   Left/Right change   B / F10 close", grey);
+    y += ch * 1.25f;
+    const std::string status = std::string{"Running: "} + (stats.upscaler[0] ? stats.upscaler : "no upscaler") + ", " + fps_text();
+    Text(out, px + cw, y, scale, status, grey);
+    (void)shadow;
+}
+
+} // namespace KartOverlay
