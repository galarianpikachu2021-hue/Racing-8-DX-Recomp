+/// Stand-in for the page table: the game pages (below 1 MiB) a test has mapped.
+static std::atomic<bool> g_dm_mapped[0x100];
+
+static bool DmIsMapped(std::uint64_t address) {
+    const std::uint64_t page = address >> 12;
+    return page < std::size(g_dm_mapped) && g_dm_mapped[page].load();
+}
+
+/// An arena with the fault handler installed on it, removed again at the end of the test.
+struct DirectMemoryArena {
+    HostMemory mem{BACKING_SIZE, VIRTUAL_SIZE};
+    u8* arena{};
+
+    DirectMemoryArena() {
+        RequireFastmemArena(mem);
+        for (auto& mapped : g_dm_mapped) {
+            mapped = false;
+        }
+        const auto ops = mem.HandlerOps();
+        REQUIRE(DM::Install(mem.VirtualBasePointer(), VIRTUAL_SIZE, &DmIsMapped, &ops));
+        arena = mem.VirtualBasePointer();
+    }
+    ~DirectMemoryArena() {
+        DM::Uninstall();
+    }
+    /// A game Map: the page table first, then the arena, as core/memory.cpp does.
+    void Map(size_t address, size_t backing, size_t length) {
+        for (size_t page = address; page < address + length; page += 0x1000) {
+            g_dm_mapped[page >> 12] = true;
+        }
+        mem.Map(address, backing, length, PERMS, HEAP);
+    }
+};
