+        }
+        return pipeline;
+    }
+
+    /// Executes one NVN draw natively. Returns false when it had to be skipped.
+    bool Draw(DrawState& st, const Command& c) {
+        hit_deferred = false;
+        defer_ok = !st.colors.empty() && st.colors[0] && current_frame && st.colors[0]->guest_width == current_frame->present.width;
+        if (st.program.empty()) {
+            ++skip_no_program;
+            return false;
+        }
+        ProgramEntry* prog = GetProgram(st.program, st);
+        if (!prog->ok) {
+            ++skip_program;
+            return false;
+        }
+        if (prog->unsupported_resources) {
+            ++skip_resources;
+            return false;
+        }
+        const bool indexed = c.draw == DrawKind::Elements || c.draw == DrawKind::ElementsInstanced ||
+                             c.draw == DrawKind::ElementsBaseVertex;
+        const u32 mode = static_cast<u32>(c.args[0]);
+        const auto topology = MapTopology(mode);
+        if (!topology || c.draw == DrawKind::Other) {
+            ++skip_topology;
+            return false;
+        }
+        if (dump_frame && prog->stages.front().data == 0x4001bd500 && current_frame) {
+            // Tonemap inputs: exposure = tex4x4.a * vs_cbuf3[0]; LUT coord = c*fs_c3[12] + fs_c3[13].
+            const auto floats = [&](int stage) {
+                std::string out;
+                const auto& u = st.uniforms[stage][0];
+                if (u.snapshot) {
+                    const float* f = reinterpret_cast<const float*>(current_frame->snapshot.data() + u.snapshot - 1);
+                    for (u32 i = 0; i < std::min<u64>(16, u.size / 4); ++i) out += fmt::format(" {}", f[i]);
+                } else {
+                    out = " (no snapshot)";
+                }
+                return out;
+            };
+            u8 texel[64]{};
+            const u64 h = st.textures[0][0];
+            Tegra::Texture::TICEntry tic{};
+            if (h && Core::NvnHost::ReadTextureDescriptor(static_cast<u32>(h & 0xFFFFF), &tic)) {
+                Core::NvnHost::ReadGpuMemory(tic.Address(), texel, sizeof(texel));
+            }
+            KartRe::Log("tonemap vs_c3:{} | fs_c3:{} | vs tex handle={:#x} first texels {:02x} {:02x} {:02x} {:02x} "
+                        "{:02x} {:02x} {:02x} {:02x}",
+                        floats(0), floats(1), h, texel[0], texel[1], texel[2], texel[3], texel[4],
+                        texel[5], texel[6], texel[7]);
+        }
+        if (dump_frame && st.colors.size() == 1 && st.colors[0] && st.colors[0]->guest_width >= 480) {
+            const auto dir = Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "native_dump" /
+                             (dump_dir_name + "_spv");
+            std::filesystem::create_directories(dir);
+            for (const auto& stg : prog->stages) {
+                std::ofstream f(dir / fmt::format("pass{:03}_stage{}_{:x}.spv", pass_index,
+                                                  static_cast<int>(stg.stage), stg.data),
+                                std::ios::binary);
+                f.write(reinterpret_cast<const char*>(stg.spirv.data()), stg.spirv.size() * 4);
+            }
+        }
+        if (dump_frame) {
+            std::string attribs, streams, vbs;
+            for (u32 w : st.attribs) attribs += fmt::format(" {:08x}", w);
+            for (size_t i = 0; i + 1 < st.streams.size(); i += 2)
+                streams += fmt::format(" {}/{}", st.streams[i], st.streams[i + 1]);
+            for (u32 i = 0; i < 4; ++i)
+                vbs += fmt::format(" {:#x}/{:#x}", st.vertex_buffers[i].address, st.vertex_buffers[i].size);
+            KartRe::Log("dumpframe pass{:03} draw kind={} args={:#x},{:#x},{:#x},{:#x},{:#x} attribs[{}] "
+                        "streams[{}] vb[{}] vp={},{},{},{} sc={},{},{},{} ds={:#x} color={:#x} mask={:#x} "
+                        "poly={:#x} blend0={:#x} vs_loads_generic0={}",
+                        pass_index, static_cast<int>(c.draw), c.args[0], c.args[1], c.args[2],
+                        c.args[3], c.args[4], attribs, streams, vbs, st.viewport[0], st.viewport[1],
+                        st.viewport[2], st.viewport[3], st.scissor[0], st.scissor[1], st.scissor[2],
+                        st.scissor[3], st.depth_stencil & 0xFF, st.color, st.channel_mask,
+                        st.polygon & 0xFF, st.blend[0], prog->stages.front().info.loads.Generic(0));
+        }
+        // Draw parameters (registers as passed after the command buffer).
+        u32 index_type = 0, count = 0, first = 0, instance_count = 1, base_instance = 0;
+        s32 base_vertex = 0;
+        u64 index_address = 0;
+        if (indexed) {
+            index_type = static_cast<u32>(c.args[1]);
+            count = static_cast<u32>(c.args[2]);
+            index_address = c.args[3];
+            if (c.draw == DrawKind::ElementsBaseVertex || c.draw == DrawKind::ElementsInstanced) {
+                base_vertex = static_cast<s32>(c.args[4]);
+            }
+            if (c.draw == DrawKind::ElementsInstanced) {
+                base_instance = static_cast<u32>(c.args[5]);
+                instance_count = static_cast<u32>(c.args[6]);
+            }
+        } else {
+            first = static_cast<u32>(c.args[1]);
+            count = static_cast<u32>(c.args[2]);
+            if (c.draw == DrawKind::ArraysInstanced) {
