+    for (std::uint64_t a = 21 * 0x1000; a < 40 * 0x1000; a += 0x400) CHECK(mem[a] == 0);
+    CHECK(mem[kMapped + 5] == 42);
+
+    // A mapped page the game may not write is opened, and keeps its contents and the write.
+    mem[kMapped + 6] = 7;
+    CHECK(mem[kMapped + 5] == 42 && mem[kMapped + 6] == 7);
+    CHECK(stats.opened_pages.load() == 1);
+    CHECK(stats.last_opened.load() == kMapped + 6);
+    std::printf("test_direct_memory: ok\n");
+    return 0;
+}
+#else
+int main() {
+    std::printf("test_direct_memory: skipped (no fault handler on this platform)\n");
+    return KartRuntime::DirectMemory::Install(nullptr, 0, nullptr) ? 1 : 0;
+}
+#endif
