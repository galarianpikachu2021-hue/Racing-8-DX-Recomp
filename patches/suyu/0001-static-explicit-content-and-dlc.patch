+/// In-game overlay menu (kart-recomp): reads a controller's state through SDL's gamepad mapping,
+/// turns presses into menu navigation and opens/closes the menu on L3+R3. Returns true while the
+/// menu is open, in which case the game gets neutral input.
+struct OverlayPad {
+    SDL_Gamepad* pad = nullptr;
+    bool ls = false, rs = false, up = false, down = false, left = false, right = false, a = false, b = false;
+};
+
+bool OverlayPoll(SDL_JoystickID id) {
+    static std::mutex lock;
+    static std::unordered_map<SDL_JoystickID, OverlayPad> pads;
+    std::scoped_lock guard{lock};
+    OverlayPad& p = pads[id];
+    if (!p.pad && SDL_IsGamepad(id)) {
+        p.pad = SDL_OpenGamepad(id);
+    }
+    if (!p.pad) {
+        return KartOverlay::IsOpen();
+    }
+    const auto button = [&](SDL_GamepadButton b) { return SDL_GetGamepadButton(p.pad, b); };
+    const bool ls = button(SDL_GAMEPAD_BUTTON_LEFT_STICK), rs = button(SDL_GAMEPAD_BUTTON_RIGHT_STICK);
+    const bool up = button(SDL_GAMEPAD_BUTTON_DPAD_UP), down = button(SDL_GAMEPAD_BUTTON_DPAD_DOWN);
+    const bool left = button(SDL_GAMEPAD_BUTTON_DPAD_LEFT), right = button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT);
+    const bool a = button(SDL_GAMEPAD_BUTTON_SOUTH), b = button(SDL_GAMEPAD_BUTTON_EAST);
+    using KartOverlay::Nav;
+    if (ls && rs && !(p.ls && p.rs)) {
+        KartOverlay::Push(Nav::Toggle);
+    } else if (KartOverlay::IsOpen()) {
+        if (up && !p.up) KartOverlay::Push(Nav::Up);
+        if (down && !p.down) KartOverlay::Push(Nav::Down);
+        if (left && !p.left) KartOverlay::Push(Nav::Left);
+        if (right && !p.right) KartOverlay::Push(Nav::Right);
+        if (a && !p.a) KartOverlay::Push(Nav::Accept);
+        if (b && !p.b) KartOverlay::Push(Nav::Back);
+    }
+    p.ls = ls, p.rs = rs, p.up = up, p.down = down, p.left = left, p.right = right, p.a = a, p.b = b;
+    return KartOverlay::IsOpen();
+}
