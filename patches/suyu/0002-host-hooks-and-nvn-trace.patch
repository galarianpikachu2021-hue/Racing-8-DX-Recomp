+// kart-recomp: the socket table and calls behind "bsd:u" as a library (no service framework): the emulated service (bsd.cpp)
+// and the runtime's (core/hle/kernel/native_bsd.cpp) both drive it. While the engine is in a multiplayer room, new sockets are
+// proxy sockets: their packets travel through the room (network/room_member) to the other members' fake addresses.
+#pragma once
+
+#include <array>
+#include <memory>
+#include <optional>
