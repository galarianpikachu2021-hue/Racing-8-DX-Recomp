+Menu::Menu(std::vector<std::string> upscaler_names) {
+    items.resize(kRowCount);
+    items[kUpscaler] = {"Upscaler", std::move(upscaler_names), 0, true, ""};
+    items[kGraphics] = {"Graphics quality", {"Launcher setting", "Low (handheld)", "High (docked)"}, 0, true, ""};
+    items[kResolution] = {"Output resolution", {"Launcher setting", "720p", "1080p", "1440p", "4K (2160p)"}, 0, true, ""};
+    items[kQuality] = {"3D render scale",
+                       {"Off", "100% (DLAA / native AA)", "67% (quality)", "58% (balanced)", "50% (performance)",
+                        "33% (ultra performance)", "150% (supersample)", "200% (supersample)"},
+                       0, true, ""};
+    items[kSharp] = {"Sharpening", {"Off", "Low", "Medium", "High"}, 3, true, ""};
+    items[kJitter] = {"Camera jitter", {"Off", "On"}, 0, true, ""};
+    items[kFrameGen] = {"Frame generation", {"Off", "Built-in (2x)"}, 0, true, "needs a temporal upscaler"};
+    items[kHdr] = {"HDR output", {"Off", "On"}, 0, false, "display not in HDR mode"};
+    items[kHdrPaper] = {"HDR paper white", {"100 nits", "150 nits", "203 nits (standard)", "250 nits", "300 nits"}, 1, false, "needs HDR output"};
+    items[kHdrPeak] = {"HDR peak brightness", {"400 nits", "600 nits", "800 nits", "1000 nits", "1500 nits"}, 0, false, "needs HDR output"};
+    items[kPresent] = {"Present mode", {"Mailbox", "FIFO (vsync)", "Immediate"}, 0, true, ""};
+    items[kSpeed] = {"Speed limit", {"50%", "75%", "100%", "125%", "150%", "200%", "Off"}, kSpeedDefault, true, ""};
+    items[kFps] = {"FPS counter", {"Off", "On"}, 0, true, ""};
+    items[kRecord] = {"Record my inputs", {"Off", "Recording"}, 0, true, ""};
+    for (int i = 0; i < 4; ++i) {
+        items[kPlayer1 + i] = {"Player " + std::to_string(i + 1) + " controller", {"Disconnected", "Keyboard"}, 1, false, "no controller info yet"};
+    }
+    // Extra cups (CTGP DX's, added without replacing any course): "extra_cups.txt" in the game folder lists them, one per line as
+    // "Cup name|CT_00 CT_01 CT_02 CT_03". Choosing one writes extra_cup.txt, which the Grand Prix start hook reads (see docs/CTGP.md).
+    items[kExtraCup] = {"Extra cup (next Grand Prix)", {"Off"}, 0, false, "none installed"};
+    if (std::ifstream list("extra_cups.txt"); list) {
+        for (std::string line; std::getline(list, line);) {
+            const auto bar = line.find('|');
+            if (bar == std::string::npos || bar == 0) continue;
+            items[kExtraCup].options.push_back(line.substr(0, bar));
+            extra_cups.push_back(line.substr(bar + 1));
+        }
+        if (!extra_cups.empty()) {
+            items[kExtraCup].enabled = true;
+            items[kExtraCup].note = "press A in the cup screen as usual";
+        }
+    }
+    std::remove("extra_cup.txt"); // never start with an old choice
+    items[kClose] = {"Close menu", {}, 0, true, ""};
+    live.speed_limit = kSpeedDefault;
+}
