+                const auto it = map.find(ctx.x[0]);
+                return it == map.end() ? 0 : static_cast<u32>(it->second);
+            };
+            c.words = {static_cast<u32>(region[0]), static_cast<u32>(region[1]), static_cast<u32>(region[2]),
+                       static_cast<u32>(region[3]), static_cast<u32>(region[4]),
+                       static_cast<u32>(std::max(region[5], 1)), level, layer, stride(s.copy_row_stride),
