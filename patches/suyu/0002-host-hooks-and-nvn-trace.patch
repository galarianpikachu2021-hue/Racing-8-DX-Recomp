+        if (KartRe::Enabled() && shown.size() < 40 && shown.emplace(c.rgba[0], c.rgba[1], c.rgba[2]).second) {
+            KartRe::Log("polygon-offset args {} {} {}", c.rgba[0], c.rgba[1], c.rgba[2]);
