+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/nvn_host/shader_translate.h"
+
+#include <algorithm>
+#include <exception>
+#include <memory>
+#include <mutex>
+#include <limits>
+
+#include "shader_recompiler/backend/bindings.h"
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/environment.h"
+#include "shader_recompiler/frontend/ir/basic_block.h"
+#include "shader_recompiler/frontend/maxwell/control_flow.h"
+#include "shader_recompiler/frontend/maxwell/translate_program.h"
+#include "shader_recompiler/host_translate_info.h"
+#include "shader_recompiler/object_pool.h"
+#include "shader_recompiler/profile.h"
+#include "shader_recompiler/runtime_info.h"
+#include "core/nvn_host/nvn_host.h"
+#include "video_core/textures/texture.h"
+
+namespace Core::NvnHost {
+Shader::TextureType TextureTypeForHandle(u32 raw_handle) {
+    Tegra::Texture::TICEntry tic{};
+    if (raw_handle == 0 || !NvnHost::ReadTextureDescriptor(raw_handle & 0xFFFFF, &tic)) {
+        return Shader::TextureType::Color2D;
+    }
+    using T = Tegra::Texture::TextureType;
+    switch (tic.texture_type.Value()) {
+    case T::Texture1D: return Shader::TextureType::Color1D;
+    case T::Texture3D: return Shader::TextureType::Color3D;
+    case T::TextureCubemap: return Shader::TextureType::ColorCube;
+    case T::Texture1DArray: return Shader::TextureType::ColorArray1D;
+    case T::Texture2DArray: return Shader::TextureType::ColorArray2D;
+    case T::Texture1DBuffer: return Shader::TextureType::Buffer;
+    case T::TextureCubeArray: return Shader::TextureType::ColorArrayCube;
+    default: return Shader::TextureType::Color2D;
+    }
+}
+
+namespace {
+
+class NvnShaderEnvironment final : public Shader::Environment {
+public:
+    NvnShaderEnvironment(const GpuReader& reader_, u64 program_base_, u32 start,
+                         const CbufQuery* cbuf_ = nullptr)
+        : reader{reader_}, program_base{program_base_}, cbuf{cbuf_} {
+        start_address = start;
+        if (!reader(program_base + start_address, &sph, sizeof(sph))) {
+            throw std::runtime_error("shader header is not mapped");
+        }
+        // SPH shader type: 1 vertex, 2 tess control, 3 tess eval, 4 geometry, 5 pixel.
+        switch (sph.common0.shader_type.Value()) {
+        case 1: stage = Shader::Stage::VertexB; break;
+        case 2: stage = Shader::Stage::TessellationControl; break;
+        case 3: stage = Shader::Stage::TessellationEval; break;
+        case 4: stage = Shader::Stage::Geometry; break;
+        case 5: stage = Shader::Stage::Fragment; break;
+        default: throw std::runtime_error("unknown SPH shader type");
+        }
+        const u64 local = sph.LocalMemorySize();
+        local_memory = static_cast<u32>(std::min<u64>(local, std::numeric_limits<u32>::max())) +
+                       sph.common3.shader_local_memory_crs_size;
+    }
+
+    u64 ReadInstruction(u32 address) override {
+        u64 insn = 0;
+        if (!reader(program_base + address, &insn, sizeof(insn))) {
+            throw std::runtime_error("shader code is not mapped");
+        }
+        return insn;
+    }
+    u32 ReadCbufValue(u32 index, u32 offset) override {
+        return cbuf && *cbuf ? (*cbuf)(NvnStageIndex(), index, offset) : 0;
+    }
+    // Texture types and formats come from the bound texture's TIC when known.
+    Shader::TextureType ReadTextureType(u32 raw_handle) override {
+        return TextureTypeForHandle(raw_handle);
+    }
+    Shader::TexturePixelFormat ReadTexturePixelFormat(u32) override {
+        return Shader::TexturePixelFormat::A8B8G8R8_UNORM;
+    }
+    bool IsTexturePixelFormatInteger(u32) override { return false; }
+
+    int NvnStageIndex() const {
+        switch (stage) {
+        case Shader::Stage::Fragment: return 1;
+        case Shader::Stage::Geometry: return 2;
+        case Shader::Stage::TessellationControl: return 3;
+        case Shader::Stage::TessellationEval: return 4;
+        default: return 0;
+        }
+    }
+    u32 ReadViewportTransformState() override { return 1; }
+    u32 TextureBoundBuffer() const override { return 2; } // NVN: texture handles live in cbuf 2
+    u32 LocalMemorySize() const override { return local_memory; }
+    u32 SharedMemorySize() const override { return 0; }
+    std::array<u32, 3> WorkgroupSize() const override { return {1, 1, 1}; }
+    bool HasHLEMacroState() const override { return false; }
+    std::optional<Shader::ReplaceConstant> GetReplaceConstBuffer(u32, u32) override {
+        return std::nullopt;
+    }
+    void Dump(u64, u64) override {}
+
+private:
+    const GpuReader& reader;
+    u64 program_base;
+    const CbufQuery* cbuf;
+    u32 local_memory = 0;
+};
+
+class NvnComputeEnvironment final : public Shader::Environment {
+public:
+    NvnComputeEnvironment(const GpuReader& reader_, u64 base_, std::array<u32, 3> workgroup_,
+                          u32 shared_, const CbufQuery* cbuf_)
+        : reader{reader_}, base{base_}, workgroup{workgroup_}, shared{shared_}, cbuf{cbuf_} {
+        stage = Shader::Stage::Compute;
+        start_address = 0;
+    }
+    u64 ReadInstruction(u32 address) override {
+        u64 insn = 0;
+        if (!reader(base + address, &insn, sizeof(insn))) {
+            throw std::runtime_error("compute code is not mapped");
+        }
+        return insn;
+    }
+    u32 ReadCbufValue(u32 index, u32 offset) override {
+        return cbuf && *cbuf ? (*cbuf)(5, index, offset) : 0;
+    }
+    Shader::TextureType ReadTextureType(u32 raw_handle) override {
+        Tegra::Texture::TICEntry tic{};
+        if (raw_handle == 0 || !NvnHost::ReadTextureDescriptor(raw_handle & 0xFFFFF, &tic)) {
+            return Shader::TextureType::Color2D;
+        }
+        using T = Tegra::Texture::TextureType;
+        switch (tic.texture_type.Value()) {
+        case T::Texture3D: return Shader::TextureType::Color3D;
+        case T::TextureCubemap: return Shader::TextureType::ColorCube;
+        case T::Texture2DArray: return Shader::TextureType::ColorArray2D;
+        case T::TextureCubeArray: return Shader::TextureType::ColorArrayCube;
+        default: return Shader::TextureType::Color2D;
+        }
+    }
+    Shader::TexturePixelFormat ReadTexturePixelFormat(u32) override {
+        return Shader::TexturePixelFormat::A8B8G8R8_UNORM;
+    }
+    bool IsTexturePixelFormatInteger(u32) override { return false; }
+    u32 ReadViewportTransformState() override { return 0; }
+    u32 TextureBoundBuffer() const override { return 2; }
+    u32 LocalMemorySize() const override { return 0; }
+    u32 SharedMemorySize() const override { return shared; }
+    std::array<u32, 3> WorkgroupSize() const override { return workgroup; }
+    bool HasHLEMacroState() const override { return false; }
+    std::optional<Shader::ReplaceConstant> GetReplaceConstBuffer(u32, u32) override {
+        return std::nullopt;
+    }
+    void Dump(u64, u64) override {}
+
+private:
+    const GpuReader& reader;
+    u64 base;
+    std::array<u32, 3> workgroup;
+    u32 shared;
+    const CbufQuery* cbuf;
+};
+
+Shader::Profile DesktopProfile() {
+    Shader::Profile p{};
+    p.supported_spirv = 0x00010500;
+    p.unified_descriptor_binding = true;
+    p.support_descriptor_aliasing = true;
+    p.support_int8 = true;
+    p.support_int16 = true;
+    p.support_int64 = true;
+    p.support_vertex_instance_id = false;
+    p.support_float_controls = true;
+    p.support_separate_denorm_behavior = true;
+    p.support_separate_rounding_mode = true;
+    p.support_fp32_denorm_preserve = true;
+    p.support_fp32_denorm_flush = true;
+    p.support_demote_to_helper_invocation = true;
+    p.support_derivative_control = true;
+    p.support_typeless_image_loads = true;
+    p.support_vote = true;
+    p.warp_size_potentially_larger_than_guest = true;
+    p.has_broken_spirv_clamp = false;
+    p.max_user_clip_distances = 8;
+    return p;
+}
+
+} // namespace
+
+// Single-stage and compute translations stay serialized. The heap corruption
+// once blamed on concurrent translation came from the statistics worker reading
+// the model without its lock; graphics programs translate in parallel.
+std::mutex g_translate_lock;
+
+TranslatedShader TranslateShader(const GpuReader& read, u64 base, u32 start) {
+    std::scoped_lock lock{g_translate_lock};
+    TranslatedShader out;
+    try {
+        NvnShaderEnvironment env{read, base, start};
+        Shader::ObjectPool<Shader::IR::Inst> inst_pool;
+        Shader::ObjectPool<Shader::IR::Block> block_pool;
+        Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow_pool;
+        const u32 cfg_offset = static_cast<u32>(env.StartAddress() + sizeof(Shader::ProgramHeader));
+        Shader::Maxwell::Flow::CFG cfg{env, flow_pool, cfg_offset};
+        Shader::HostTranslateInfo host_info{};
+        host_info.support_float64 = true;
+        host_info.support_float16 = true;
+        host_info.support_int64 = true;
+        host_info.needs_demote_reorder = false;
+        host_info.support_snorm_render_buffer = true;
+        host_info.support_viewport_index_layer = true;
+        host_info.min_ssbo_alignment = 16;
+        auto program = Shader::Maxwell::TranslateProgram(inst_pool, block_pool, env, cfg, host_info);
+        Shader::Backend::Bindings bindings;
+        const Shader::Profile profile = DesktopProfile();
+        Shader::RuntimeInfo runtime{};
+        out.spirv = Shader::Backend::SPIRV::EmitSPIRV(profile, runtime, program, bindings);
+        out.stage = program.stage;
+        out.info = program.info;
+        out.ok = !out.spirv.empty();
+    } catch (const std::exception& e) {
+        out.error = e.what();
+    }
+    return out;
+}
+
+std::vector<TranslatedShader> TranslateProgramStages(const GpuReader& read,
+                                                     const std::vector<u64>& datas,
+                                                     const CbufQuery& cbuf, u32 uint_outputs) {
+    // No global lock: every call has its own pools and environment, as in suyu's
+    // own multi-threaded pipeline cache, so programs translate in parallel.
+    constexpr u32 kPrefix = 0x30;
+    struct Stage {
+        u64 data;
+        std::unique_ptr<NvnShaderEnvironment> env;
+        Shader::IR::Program program;
+    };
+    Shader::ObjectPool<Shader::IR::Inst> inst_pool;
+    Shader::ObjectPool<Shader::IR::Block> block_pool;
+    Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow_pool;
+    Shader::HostTranslateInfo host_info{};
+    host_info.support_float64 = true;
+    host_info.support_float16 = true;
+    host_info.support_int64 = true;
+    host_info.support_snorm_render_buffer = true;
+    host_info.support_viewport_index_layer = true;
+    host_info.min_ssbo_alignment = 16;
+
+    std::vector<TranslatedShader> out;
+    std::vector<Stage> stages;
+    for (const u64 data : datas) {
+        TranslatedShader t;
+        try {
+            auto env = std::make_unique<NvnShaderEnvironment>(read, data, kPrefix, &cbuf);
+            const u32 cfg_offset = static_cast<u32>(env->StartAddress() + sizeof(Shader::ProgramHeader));
+            Shader::Maxwell::Flow::CFG cfg{*env, flow_pool, cfg_offset};
+            auto program = Shader::Maxwell::TranslateProgram(inst_pool, block_pool, *env, cfg, host_info);
+            stages.push_back({data, std::move(env), std::move(program)});
+        } catch (const std::exception& e) {
+            t.error = e.what();
+            return {t}; // a program with an untranslatable stage cannot be drawn
+        }
+    }
+    // Pipeline order: vertex, tessellation, geometry, fragment.
+    std::stable_sort(stages.begin(), stages.end(), [](const Stage& a, const Stage& b) {
+        return static_cast<int>(a.program.stage) < static_cast<int>(b.program.stage);
+    });
+    Shader::Backend::Bindings bindings;
+    const Shader::Profile profile = DesktopProfile();
+    const Shader::IR::Program* previous = nullptr;
+    for (auto& st : stages) {
+        TranslatedShader t;
+        try {
+            Shader::RuntimeInfo runtime{};
+            if (previous) {
+                runtime.previous_stage_stores = previous->info.stores;
+                runtime.previous_stage_legacy_stores_mapping = previous->info.legacy_stores_mapping;
+            } else {
+                runtime.previous_stage_stores.mask.set();
+            }
+            if (st.program.stage == Shader::Stage::Fragment) {
+                for (u32 i = 0; i < 8; ++i) {
+                    runtime.color_output_types[i] = (uint_outputs >> i) & 1 ? Shader::AttributeType::UnsignedInt
+                                                                           : Shader::AttributeType::Float;
+                }
+            }
+            if (st.program.stage == Shader::Stage::VertexB) {
+                runtime.convert_depth_mode = true; // NVN default depth range is GL-style [-1, 1]
+            }
+            t.spirv = Shader::Backend::SPIRV::EmitSPIRV(profile, runtime, st.program, bindings);
+            t.stage = st.program.stage;
+            t.data = st.data;
+            t.info = st.program.info;
+            t.ok = !t.spirv.empty();
+        } catch (const std::exception& e) {
+            t.error = e.what();
+        }
+        out.push_back(std::move(t));
+        previous = &st.program;
+    }
+    return out;
+}
+
+TranslatedShader TranslateComputeShader(const GpuReader& read, u64 data,
+                                        std::array<u32, 3> workgroup, u32 shared_memory,
+                                        const CbufQuery& cbuf) {
+    std::scoped_lock lock{g_translate_lock};
+    TranslatedShader out;
+    try {
+        NvnComputeEnvironment env{read, data, workgroup, shared_memory, &cbuf};
+        Shader::ObjectPool<Shader::IR::Inst> inst_pool;
+        Shader::ObjectPool<Shader::IR::Block> block_pool;
+        Shader::ObjectPool<Shader::Maxwell::Flow::Block> flow_pool;
+        Shader::Maxwell::Flow::CFG cfg{env, flow_pool, env.StartAddress()};
+        Shader::HostTranslateInfo host_info{};
+        host_info.support_float64 = true;
+        host_info.support_float16 = true;
+        host_info.support_int64 = true;
+        host_info.min_ssbo_alignment = 16;
+        auto program = Shader::Maxwell::TranslateProgram(inst_pool, block_pool, env, cfg, host_info);
+        Shader::Backend::Bindings bindings;
+        out.spirv = Shader::Backend::SPIRV::EmitSPIRV(DesktopProfile(), {}, program, bindings);
+        out.stage = program.stage;
+        out.info = program.info;
+        out.data = data;
+        out.ok = !out.spirv.empty();
+    } catch (const std::exception& e) {
+        out.error = e.what();
+    }
+    return out;
+}
+
+} // namespace Core::NvnHost
