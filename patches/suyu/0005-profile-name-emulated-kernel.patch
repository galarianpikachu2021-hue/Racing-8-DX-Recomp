+    // kart-recomp: KARTRECOMP_PROFILE_NAME (the launcher's "Profile name") for the emulated kernel too: the playing user's
+    // console profile is renamed before the game runs, so Wireless Play's lobby shows it (the native services do the same in
+    // native_services_list.cpp, which the Windows engine does not run). The console allows 10 characters.
+    if (const char* profile_name = std::getenv("KARTRECOMP_PROFILE_NAME"); profile_name && *profile_name) {
+        std::string name;
+        size_t chars = 0;
+        for (const char* p = profile_name; *p && chars < 10;) {
+            const auto c = static_cast<unsigned char>(*p);
+            const size_t len = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 1;
+            if (name.size() + len > Service::Account::profile_username_size) break;
+            for (size_t i = 0; i < len && p[i]; ++i) name.push_back(p[i]);
+            p += len;
+            ++chars;
+        }
+        auto& profile_manager = system.GetProfileManager();
+        const auto user_id = profile_manager.GetLastOpenedUser();
+        Service::Account::ProfileBase base{};
+        if (!name.empty() && profile_manager.GetProfileBase(user_id, base)) {
+            const std::string old_name(reinterpret_cast<const char*>(base.username.data()),
+                                       strnlen(reinterpret_cast<const char*>(base.username.data()), base.username.size()));
+            if (old_name != name) {
+                base.username.fill(0);
+                std::memcpy(base.username.data(), name.data(), name.size());
+                if (profile_manager.SetProfileBase(user_id, base)) {
+                    LOG_INFO(Frontend, "kart-recomp: profile name '{}' -> '{}'", old_name, name);
+                }
+            }
+        }
+    }
