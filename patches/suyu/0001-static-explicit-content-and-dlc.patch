+// The overlay's "Player N controller" rows (kart-recomp): publishes who plays on what, and applies
+// a request to give a player a controller, the keyboard or nothing. A controller already in use
+// by another player swaps places with the requesting player's old device, so no pad plays twice.
+// Controls chosen here are the player's own: the automatic assignment stays off afterwards.
+void EmuWindow_SDL2::ServicePadRequests() {
+    using namespace SuyuCmd::detail;
+    if (tas_playback) {
+        return;
+    }
+    const auto devices = input_subsystem->GetInputDevices();
+    const auto all = ControllerPads(devices);
+    // A Joy-Con pair is listed whole and as halves: offer the whole.
+    std::vector<Common::ParamPackage> pads;
+    for (const auto& pad : all) {
+        const bool half = !IsPair(pad) && std::any_of(all.begin(), all.end(), [&](const auto& pair) {
+            return IsPair(pair) && MapsHalfOf(pad, pair);
+        });
+        if (!half) {
+            pads.push_back(pad);
+        }
+    }
+    auto& players = Settings::values.players.GetValue();
+    const Slots slots{players, devices, SdlConfig::default_buttons};
+
+    // Where each player is now: -2 disconnected, -1 keyboard, else the pad's index.
+    const auto code_of = [&](std::size_t slot) {
+        if (!players[slot].connected) {
+            return -2;
+        }
+        for (std::size_t i = 0; i < pads.size(); ++i) {
+            const auto held = slots.Holding(pads[i]);
+            if (std::find(held.begin(), held.end(), slot) != held.end()) {
+                return static_cast<int>(i);
+            }
+        }
+        return -1;
+    };
+    const auto set_slot = [&](std::size_t slot, int code) {
+        if (code >= 0 && static_cast<std::size_t>(code) < pads.size()) {
+            const auto& pad = pads[static_cast<std::size_t>(code)];
+            Give(players[slot], pad, TypeFor(pad), [this](const Common::ParamPackage& p, Settings::PlayerInput& player) {
+                MapDefault(*input_subsystem, p, player);
+            });
+        } else if (code == -1) {
+            Clear(players[slot]);
+            RestoreKeyboard(players[slot]);
+            players[slot].controller_type = Settings::ControllerType::ProController;
+            players[slot].connected = true;
+        } else {
+            Clear(players[slot]);
+            players[slot].connected = false;
+        }
+    };
+
+    auto& state = KartOverlay::Pads();
+    std::array<int, 4> want;
+    {
+        std::scoped_lock lock{state.lock};
+        want = state.want;
+        state.want.fill(-3);
+    }
+    bool changed = false;
+    for (std::size_t p = 0; p < 4; ++p) {
+        if (want[p] == -3) {
+            continue;
+        }
+        const int old_code = code_of(p);
+        const int new_code = want[p] >= static_cast<int>(pads.size()) ? -2 : want[p];
+        if (new_code == old_code) {
+            continue;
+        }
+        // Whoever has the requested controller (or the keyboard) takes this player's old one.
+        for (std::size_t q = 0; q < 8; ++q) {
+            if (q != p && new_code != -2 && code_of(q) == new_code) {
+                set_slot(q, old_code);
+            }
+        }
+        set_slot(p, new_code);
+        LOG_INFO(Frontend, "Overlay: Player {} -> {}", p + 1,
+                 new_code == -2 ? std::string{"disconnected"}
+                 : new_code == -1 ? std::string{"keyboard"}
+                                  : pads[static_cast<std::size_t>(new_code)].Get("display", std::string{"controller"}));
+        changed = true;
+    }
+    if (changed) {
+        SdlConfig::auto_assign_controllers = false;
+        system.HIDCore().ReloadInputDevices();
+        controls_save_pending = true;
+    }
+
+    std::vector<std::string> names;
+    for (std::size_t i = 0; i < pads.size(); ++i) {
+        std::string name = pads[i].Get("display", std::string{"Controller"});
+        const auto same = std::count_if(pads.begin(), pads.begin() + static_cast<std::ptrdiff_t>(i), [&](const auto& other) {
+            return other.Get("display", std::string{"Controller"}) == name;
+        });
+        names.push_back(same == 0 ? name : name + " #" + std::to_string(same + 1));
+    }
