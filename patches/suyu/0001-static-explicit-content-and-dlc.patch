diff --git a/src/suyu_cmd/mem_scan.h b/src/suyu_cmd/mem_scan.h
new file mode 100644
index 0000000000..25c60e1a3a
--- /dev/null
+++ b/src/suyu_cmd/mem_scan.h
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: debugging aid for mod work. When a file named `memscan.req` appears in the working directory the running game's memory is
+// searched and the answers are written to `memscan.out` (the request is deleted). One command per line:
+//   u8|u16|u32|u64 <n> <n> ...      a sequence of little-endian integers (decimal or 0x..)
+//   str <text>                      an ASCII string
+//   strided <width> <max stride> <n> <n> ...   the integers spaced by any common stride (width 1/2/4/8, stride a multiple of the width)
+//   dump <addr> <len>               hex dump of guest memory
+//   read64 <addr> [count]           64-bit words
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "core/core.h"
+#include "core/memory.h"
+
+namespace MemScan {
+
+inline void Service(Core::System& system) {
+    std::ifstream req("memscan.req");
+    if (!req) return;
+    std::vector<std::string> lines;
+    for (std::string l; std::getline(req, l);) lines.push_back(l);
+    req.close();
+    std::remove("memscan.req");
+    std::ofstream out("memscan.out", std::ios::trunc);
+    auto& mem = system.ApplicationMemory();
+
+    // Mapped ranges: probe every 64 KiB, then refine to 4 KiB.
+    std::vector<std::pair<u64, u64>> ranges;
+    for (u64 a = 0x200000; a < 0x8000000000ULL; a += 0x10000) {
+        if (!mem.IsValidVirtualAddress(a)) continue;
+        u64 lo = a;
+        while (lo > 0x1000 && a - lo < 0x10000 && mem.IsValidVirtualAddress(lo - 0x1000)) lo -= 0x1000;
+        u64 hi = a + 0x1000;
+        while (mem.IsValidVirtualAddressRange(hi, 0x1000) && hi - a < 0x10000) hi += 0x1000;
+        if (!ranges.empty() && ranges.back().second >= lo) {
+            ranges.back().second = std::max(ranges.back().second, hi);
+        } else {
+            ranges.emplace_back(lo, hi);
+        }
+    }
+    u64 total = 0;
+    for (const auto& r : ranges) total += r.second - r.first;
+    out << "mapped ranges " << ranges.size() << ", " << (total >> 20) << " MiB\n";
+
+    for (const auto& line : lines) {
+        std::istringstream in(line);
+        std::string cmd;
+        in >> cmd;
+        out << "> " << line << "\n";
+        if (cmd == "dump" || cmd == "read64") {
+            std::string a, n;
+            in >> a >> n;
+            const u64 addr = std::strtoull(a.c_str(), nullptr, 0);
+            const u64 len = n.empty() ? 64 : std::strtoull(n.c_str(), nullptr, 0);
+            if (cmd == "dump") {
+                std::vector<u8> buf(len);
+                if (!mem.IsValidVirtualAddressRange(addr, len)) {
+                    out << "  unmapped\n";
+                    continue;
+                }
+                mem.ReadBlock(addr, buf.data(), len);
+                for (u64 i = 0; i < len; i += 16) {
+                    char row[128];
+                    int p = std::snprintf(row, sizeof row, "  %llx:", static_cast<unsigned long long>(addr + i));
+                    for (u64 j = i; j < i + 16 && j < len; ++j) p += std::snprintf(row + p, sizeof row - p, " %02x", buf[j]);
+                    out << row << "\n";
+                }
+            } else {
+                for (u64 i = 0; i < len; ++i) {
+                    if (!mem.IsValidVirtualAddressRange(addr + i * 8, 8)) break;
+                    char row[64];
+                    std::snprintf(row, sizeof row, "  %llx: %llx\n", static_cast<unsigned long long>(addr + i * 8),
+                                  static_cast<unsigned long long>(mem.Read64(addr + i * 8)));
+                    out << row;
+                }
+            }
+            continue;
+        }
+        if (cmd == "strided") {
+            int width = 0;
+            u64 max_stride = 0;
+            in >> width >> max_stride;
+            std::vector<u64> vals;
+            for (std::string tok; in >> tok;) vals.push_back(std::strtoull(tok.c_str(), nullptr, 0));
+            if (vals.size() < 2 || (width != 1 && width != 2 && width != 4 && width != 8)) {
+                out << "  bad arguments\n";
+                continue;
+            }
+            int hits = 0;
+            std::vector<u8> chunk;
+            const auto get = [&](const u8* p) {
+                u64 v = 0;
+                std::memcpy(&v, p, width);
+                return v;
+            };
+            const u64 span = max_stride * (vals.size() - 1) + 8;
+            for (const auto& r : ranges) {
+                for (u64 base = r.first; base < r.second && hits < 60; base += 0x100000) {
+                    const u64 len = std::min<u64>(0x100000 + span, r.second - base);
+                    chunk.resize(len);
+                    if (!mem.IsValidVirtualAddressRange(base, len)) continue;
+                    mem.ReadBlock(base, chunk.data(), len);
+                    for (u64 i = 0; i + span <= len && i < 0x100000 && hits < 60; i += width) {
+                        if (get(&chunk[i]) != vals[0]) continue;
+                        for (u64 stride = width; stride <= max_stride; stride += width) {
+                            bool ok = true;
+                            for (size_t k = 1; k < vals.size() && ok; ++k) ok = get(&chunk[i + k * stride]) == vals[k];
+                            if (!ok) continue;
+                            char row[96];
+                            std::snprintf(row, sizeof row, "  hit %llx stride %llu\n", static_cast<unsigned long long>(base + i),
+                                          static_cast<unsigned long long>(stride));
+                            out << row;
+                            ++hits;
+                            break;
+                        }
+                    }
+                }
+            }
+            out << "  " << hits << " hit(s)\n";
+            continue;
+        }
+        std::vector<u8> needle;
+        if (cmd == "str") {
+            std::string text;
+            std::getline(in, text);
+            if (!text.empty() && text[0] == ' ') text.erase(0, 1);
+            needle.assign(text.begin(), text.end());
+        } else {
+            const int width = cmd == "u8" ? 1 : cmd == "u16" ? 2 : cmd == "u32" ? 4 : cmd == "u64" ? 8 : 0;
+            if (!width) {
+                out << "  unknown command\n";
+                continue;
+            }
+            for (std::string tok; in >> tok;) {
+                const u64 v = std::strtoull(tok.c_str(), nullptr, 0);
+                for (int b = 0; b < width; ++b) needle.push_back(static_cast<u8>(v >> (8 * b)));
+            }
+        }
+        if (needle.empty()) continue;
+        int hits = 0;
+        std::vector<u8> chunk;
+        for (const auto& r : ranges) {
+            for (u64 base = r.first; base < r.second && hits < 60; base += 0x100000) {
+                const u64 len = std::min<u64>(0x100000 + needle.size(), r.second - base);
+                chunk.resize(len);
+                if (!mem.IsValidVirtualAddressRange(base, len)) continue;
+                mem.ReadBlock(base, chunk.data(), len);
+                for (u64 i = 0; i + needle.size() <= len && hits < 60; ++i) {
+                    if (chunk[i] != needle[0] || std::memcmp(&chunk[i], needle.data(), needle.size()) != 0) continue;
+                    char row[64];
+                    std::snprintf(row, sizeof row, "  hit %llx\n", static_cast<unsigned long long>(base + i));
+                    out << row;
+                    ++hits;
+                }
+            }
+        }
+        out << "  " << hits << " hit(s)\n";
+    }
+}
+
+} // namespace MemScan
