diff --git a/src/common/kart_re_log.h b/src/common/kart_re_log.h
new file mode 100644
index 0000000000..9839ebcc04
--- /dev/null
+++ b/src/common/kart_re_log.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: reverse-engineering log for the native NVN backend.
+// Enabled with KARTRECOMP_NVN_RE=1; writes <log dir>/nvn_re.txt directly (not
+// through the logger, so nothing is filtered or dropped).
+#pragma once
+
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+
+namespace KartRe {
+
+inline bool Enabled() {
+    static const bool enabled = std::getenv("KARTRECOMP_NVN_RE") != nullptr;
+    return enabled;
+}
+
+/// One stream for the whole process. (A function-local static inside the
+/// template below would exist once per argument signature, each truncating the
+/// same file; that silently lost most lines.)
+inline void WriteLine(const std::string& line) {
+    static std::mutex lock;
+    static std::ofstream out(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_re.txt",
+                             std::ios::trunc);
+    std::scoped_lock guard{lock};
+    out << line << '\n';
+}
+
+template <typename... Args>
+void Log(fmt::format_string<Args...> format, Args&&... args) {
+    if (!Enabled()) {
+        return;
+    }
+    WriteLine(fmt::format(format, std::forward<Args>(args)...));
+}
+
+} // namespace KartRe
diff --git a/src/common/kart_tune_sites.h b/src/common/kart_tune_sites.h
new file mode 100644
index 0000000000..53119f50fd
--- /dev/null
+++ b/src/common/kart_tune_sites.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: tuning points. A few places in the game compute a value the engine wants to scale at run time (no JIT, no code
+// patching: the generated code itself multiplies by a number the engine sets). The exporter marks each site; the generated code
+// multiplies the named float register by recomp_tune[slot] right after that instruction, and the module hands the engine the
+// table through recomp_image_tune_v1. Every slot starts at 1.0, so a game built with tuning points behaves exactly like one
+// without until the engine changes a slot, and an engine that knows nothing about them changes nothing.
+//
+// Slot 0, view aspect: the game sets each camera's aspect ratio to its view's width / height ("fdiv" of the two, stored into the
+// projection, in four places: full screen, the two split-screen layouts, and the resize path). Slot 0 = wanted aspect / (16:9)
+// widens every camera, with the game's own culling following (the projection is the game's, not a renderer trick).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace KartTune {
+
+inline constexpr int kSlots = 8;
+inline constexpr int kSlotAspect = 0;
+
+struct Site {
+    uint64_t build;  ///< first 8 bytes of main's NSO build ID
+    uint64_t offset; ///< in main: the instruction whose result is scaled
+    uint32_t word;   ///< what must be there (otherwise the site is left alone)
+    int reg;         ///< float register holding the result (S<reg>)
+    int slot;
+};
+
+inline constexpr Site kSites[] = {
+    // 4.0.1
+    {0x158c0c7399aabd7bULL, 0x3ccab4, 0x1e211800, 0, kSlotAspect}, // fdiv s0, s0, s1
+    {0x158c0c7399aabd7bULL, 0x3cd258, 0x1e201820, 0, kSlotAspect}, // fdiv s0, s1, s0
+    {0x158c0c7399aabd7bULL, 0x3cd314, 0x1e201820, 0, kSlotAspect}, // fdiv s0, s1, s0
+    {0x158c0c7399aabd7bULL, 0x3ce048, 0x1e251884, 4, kSlotAspect}, // fdiv s4, s4, s5
+    // 3.0.4
+    {0x2452c49bc26ec159ULL, 0x3ca93c, 0x1e211800, 0, kSlotAspect},
+    {0x2452c49bc26ec159ULL, 0x3cb0e0, 0x1e201820, 0, kSlotAspect},
+    {0x2452c49bc26ec159ULL, 0x3cb19c, 0x1e201820, 0, kSlotAspect},
+    {0x2452c49bc26ec159ULL, 0x3cbecc, 0x1e251884, 4, kSlotAspect},
+};
+
+/// The loaded game's table (null when the game was built without tuning points). Set once by the module loader.
+inline std::atomic<float*> g_table{nullptr};
+
+/// Sets a slot; false when the loaded game has no tuning points.
+inline bool Set(int slot, float value) {
+    float* const table = g_table.load(std::memory_order_acquire);
+    if (!table || slot < 0 || slot >= kSlots) return false;
+    table[slot] = value;
+    return true;
+}
+
+} // namespace KartTune
