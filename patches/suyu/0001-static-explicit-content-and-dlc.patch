+void Menu::SetHdrAvailable(bool on) {
+    items[kHdr].enabled = on;
+    items[kHdr].note = on ? "" : "display not in HDR mode";
+    items[kHdrPaper].enabled = items[kHdrPeak].enabled = on;
+    items[kHdrPaper].note = items[kHdrPeak].note = on ? "" : "needs HDR output";
+}
