@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: Maxwell shader -> SPIR-V for nvn-host, with no emulated GPU.
+//
+// The game's shaders are precompiled Maxwell binaries in a guest memory pool.
+// This feeds them to suyu's shader recompiler through an Environment that reads
+// the code straight from guest memory, using the NVN conventions learned in
+// docs/NATIVE_GPU.md (program = shader data + 0x30, texture handles in cbuf 2).
+#pragma once
+
+#include <array>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "common/common_types.h"
+#include "shader_recompiler/shader_info.h"
+#include "shader_recompiler/stage.h"
+
+namespace Core::NvnHost {
+
+/// Reads guest GPU-visible memory by GPU address; false when unmapped.
+using GpuReader = std::function<bool(u64 gpu_address, void* out, size_t size)>;
+
+struct TranslatedShader {
+    bool ok = false;
+    std::string error;
+    Shader::Stage stage{};
+    u64 data = 0; ///< NVN shader data address (also what hardware cbuf 1 points at)
+    std::vector<u32> spirv;
+    Shader::Info info;
+};
+
+/// base: an aligned GPU address the code is addressed from (the NVN shader data
+/// address); start: offset of the Maxwell program (SPH) from it (0x30 for NVN).
+/// Maxwell puts a scheduling word every 32 bytes and the decoder finds them by
+/// address alignment, so the base must keep the code at its real alignment.
+TranslatedShader TranslateShader(const GpuReader& read, u64 base, u32 start);
+
+/// All graphics stages of one NVN program, translated together so their
+/// descriptor bindings do not collide (one Bindings counter across stages, in
+/// pipeline order) and each stage sees what the previous one writes.
+/// datas: NVN shader data addresses as given to nvnProgramSetShaders.
+/// Draw-time knowledge for translation: the bound texture handle at a constant
+/// buffer word (NVN keeps texture handles in cbuf 2, one 8-byte handle per slot),
+/// per NVN stage (0 vertex, 1 fragment, 2 geometry, 3 tess control, 4 tess eval).
+using CbufQuery = std::function<u32(int nvn_stage, u32 cbuf_index, u32 cbuf_offset)>;
+
+/// The texture type the translator assumes for a texture handle: from the
+/// handle's TIC, Color2D when there is none (handle 0 or unreadable).
+Shader::TextureType TextureTypeForHandle(u32 raw_handle);
+
+/// uint_outputs: bit i set = fragment color output i is an unsigned integer (the
+/// render target is a UINT format), as suyu's pipeline cache tells its compiler.
+std::vector<TranslatedShader> TranslateProgramStages(const GpuReader& read,
+                                                     const std::vector<u64>& datas,
+                                                     const CbufQuery& cbuf = {},
+                                                     u32 uint_outputs = 0);
+
+/// An NVN compute program: code starts at the data address (no SPH header, no
+/// 0x30 prefix - verified against the hardware launch descriptors); the
+/// workgroup size comes from the program's control section (+0x748).
+TranslatedShader TranslateComputeShader(const GpuReader& read, u64 data,
+                                        std::array<u32, 3> workgroup, u32 shared_memory,
+                                        const CbufQuery& cbuf = {});
+
+} // namespace Core::NvnHost
