+
+std::function<bool(const std::string&)> g_open_url;
+
+/// The display service and its once-per-refresh vsync tick (KARTRECOMP_VSYNC_HZ, as the native renderer's display clock).
+KartRuntime::Services::Display& NativeDisplay(KartRuntime::NativeKernel& runtime) {
+    struct Holder {
+        explicit Holder(KartRuntime::NativeKernel& k) : display{k} {
+            display.on_unknown_transaction = [](u32 code) { LOG_WARNING(Service_VI, "native services: buffer queue transaction {} is not implemented", code); };
+            ticker = std::thread([this] {
+                int hz = 60;
+                if (const char* v = std::getenv("KARTRECOMP_VSYNC_HZ")) hz = std::clamp(std::atoi(v), 30, 360);
+                const auto period = std::chrono::nanoseconds{1000000000 / hz};
+                auto next = std::chrono::steady_clock::now();
+                while (!stop.load(std::memory_order_relaxed)) {
+                    next += period;
+                    std::this_thread::sleep_until(next);
+                    display.Vsync();
+                }
+            });
+        }
+        ~Holder() {
+            stop = true;
+            if (ticker.joinable()) ticker.join();
+        }
+        KartRuntime::Services::Display display;
+        std::atomic<bool> stop{false};
+        std::thread ticker;
+    };
+    static Holder holder{runtime};
+    return holder.display;
+}
+KartRuntime::Services::Applets* g_applets = nullptr;
