index 0000000000..eb20110fe8
--- /dev/null
+++ b/src/core/hle/kernel/native_audio_service.cpp
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: the audio renderer service ("audren:u") answered by the runtime. The renderer itself - voices, mixes, effects,
+// sinks, the DSP command lists and the output to the host's audio device - is suyu's audio_core library; this replaces the
+// service around it. The renderer's "rendered" event is still an emulated kernel event (audio_core signals it), handed out as a
+// copy handle.
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "audio_core/audio_render_manager.h"
+#include "audio_core/common/audio_renderer_parameter.h"
+#include "audio_core/renderer/audio_device.h"
+#include "audio_core/renderer/audio_renderer.h"
+#include "audio_core/audio_core.h"
+#include "audio_core/sink/sink.h"
+#include "common/string_util.h"
+#include "core/core.h"
+#include "core/hle/kernel/k_event.h"
+#include "core/hle/kernel/k_handle_table.h"
+#include "core/hle/kernel/k_process.h"
+#include "core/hle/kernel/k_readable_event.h"
+#include "core/hle/kernel/k_transfer_memory.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/native_game.h"
+#include "core/hle/kernel/native_services.h"
+#include "core/hle/kernel/native_services_list.h"
+#include "core/hle/service/audio/errors.h"
+#include "core/hle/service/kernel_helpers.h"
+#include "kart_runtime/native_kernel.h"
+
+namespace Kernel::NativeServices {
+namespace {
+
+using KartRuntime::Context;
+using KartRuntime::Service;
+using AudioCore::Renderer::AudioDevice;
+
+
+/// One renderer session: audio_core's renderer, its event, the game's process held open while it runs.
+struct RendererSession {
+    RendererSession(Core::System& system, AudioCore::Renderer::Manager& manager)
+        : context{system, "native IAudioRenderer"}, event{context.CreateEvent("native IAudioRendererEvent")},
+          renderer{std::make_unique<AudioCore::Renderer::Renderer>(system, manager, event)} {}
+    ~RendererSession() {
+        if (renderer) renderer->Finalize();
+        renderer.reset();
+        context.CloseEvent(event);
+        if (process && kernel) process->Close(*kernel);
+    }
+    ::Service::KernelHelpers::ServiceContext context;
+    Kernel::KEvent* event;
+    std::unique_ptr<AudioCore::Renderer::Renderer> renderer;
+    Kernel::KProcess* process = nullptr;
+    KernelCore* kernel = nullptr;
+};
+
+std::mutex g_sessions_lock;
+std::vector<std::weak_ptr<RendererSession>> g_sessions;
+
+std::shared_ptr<Service> Renderer(KernelCore& kernel, std::shared_ptr<RendererSession> r) {
+    {
+        std::scoped_lock lk{g_sessions_lock};
+        g_sessions.push_back(r);
+    }
+    // A wrapper: after the engine stopped the renderer (shutdown), late requests answer "invalid state" instead of touching it.
+    struct Guarded : Service {
+        explicit Guarded(std::shared_ptr<RendererSession> rs) : Service{"IAudioRenderer"}, session{std::move(rs)} {}
+        void When(uint32_t cmd, Handler h) {
+            On(cmd, [rs = session, h = std::move(h)](Context& c) {
+                if (!rs->renderer) return c.SetResult(0xFA01);
+                h(c);
+            });
+        }
+        std::shared_ptr<RendererSession> session;
+    };
+    auto s = std::make_shared<Guarded>(r);
+    s->When(0, [r](Context& c) { c.Push<u32>(r->renderer->GetSystem().GetSampleRate()); });
+    s->When(1, [r](Context& c) { c.Push<u32>(r->renderer->GetSystem().GetSampleCount()); });
+    s->When(2, [r](Context& c) { c.Push<u32>(r->renderer->GetSystem().GetMixBufferCount()); });
+    s->When(3, [r](Context& c) { c.Push<u32>(!r->renderer->GetSystem().IsActive()); });
+    auto update = [r](Context& c) { // RequestUpdate(Auto): input -> output, performance
+        const auto input = c.ReadBuffer(0);
+        std::vector<u8> out(c.WriteBufferSize(0)), perf(c.WriteBufferSize(1));
+        const Result res = r->renderer->RequestUpdate(input, perf, out);
+        if (!out.empty()) c.WriteBuffer(out.data(), out.size(), 0);
+        if (!perf.empty()) c.WriteBuffer(perf.data(), perf.size(), 1);
+        if (res.IsError()) c.SetResult(res.raw);
+    };
+    s->When(4, update);
+    s->When(10, update);
+    s->When(5, [r](Context&) { r->renderer->Start(); });
+    s->When(6, [r](Context&) { r->renderer->Stop(); });
+    s->When(7, [&kernel, r](Context& c) { // QuerySystemEvent
+        if (r->renderer->GetSystem().GetExecutionMode() == AudioCore::ExecutionMode::Manual)
+            return c.SetResult(::Service::Audio::ResultNotSupported.raw);
+        c.PushCopyHandle(MirrorKernelEvent(kernel, &r->event->GetReadableEvent()));
+    });
+    s->When(8, [r](Context& c) { r->renderer->GetSystem().SetRenderingTimeLimit(c.Pop<u32>()); });
+    s->When(9, [r](Context& c) { c.Push<u32>(r->renderer->GetSystem().GetRenderingTimeLimit()); });
+    s->When(12, [r](Context& c) { r->renderer->GetSystem().SetVoiceDropParameter(c.Pop<f32>()); });
+    s->When(13, [r](Context& c) { c.Push<f32>(r->renderer->GetSystem().GetVoiceDropParameter()); });
+    return s;
+}
+
+std::shared_ptr<Service> Device(KernelCore& kernel, u64 aruid, u32 revision) {
+    struct State {
+        State(Core::System& system, u64 aruid, u32 revision)
+            : context{system, "native IAudioDevice"}, impl{system, aruid, revision}, event{context.CreateEvent("native IAudioDeviceEvent")} {}
+        ~State() { context.CloseEvent(event); }
+        ::Service::KernelHelpers::ServiceContext context;
+        AudioDevice impl;
+        Kernel::KEvent* event;
+    };
+    Core::System& system = kernel.System();
+    auto st = std::make_shared<State>(system, aruid, revision);
+    st->event->Signal(kernel);
+    auto s = std::make_shared<Service>("IAudioDevice");
+    auto list = [st](Context& c) { // ListAudioDeviceName(Auto) -> names, count
+        std::vector<AudioDevice::AudioDeviceName> names(c.WriteBufferSize(0) / sizeof(AudioDevice::AudioDeviceName), AudioDevice::AudioDeviceName{""});
+        const u32 n = st->impl.ListAudioDeviceName(names);
+        if (n) c.WriteBuffer(names.data(), n * sizeof(AudioDevice::AudioDeviceName), 0);
+        c.Push<s32>(static_cast<s32>(n));
+    };
+    auto name_of = [](Context& c) {
+        const auto raw = c.ReadBuffer(0);
+        return std::string(reinterpret_cast<const char*>(raw.data()), strnlen(reinterpret_cast<const char*>(raw.data()), raw.size()));
+    };
+    auto set_volume = [st, name_of](Context& c) { // SetAudioDeviceOutputVolume(Auto)(name, volume)
+        const auto volume = c.Pop<f32>();
+        if (c.request.a.empty() && c.request.x.empty()) return c.SetResult(::Service::Audio::ResultInsufficientBuffer.raw);
+        if (name_of(c) == "AudioTvOutput") st->impl.SetDeviceVolumes(volume);
+    };
+    auto get_volume = [st, name_of](Context& c) {
+        const std::string name = name_of(c);
+        c.Push<f32>(name == "AudioTvOutput" ? st->impl.GetDeviceVolume(name) : 1.0f);
+    };
+    auto active_name = [](Context& c) {
+        const AudioDevice::AudioDeviceName name{"AudioTvOutput"};
+        if (c.WriteBufferSize(0) < sizeof(name)) return c.SetResult(::Service::Audio::ResultInsufficientBuffer.raw);
+        c.WriteBuffer(&name, sizeof(name), 0);
+    };
+    auto event = [&kernel, st](Context& c) { c.PushCopyHandle(MirrorKernelEvent(kernel, &st->event->GetReadableEvent())); };
+    s->On(0, list);
+    s->On(1, set_volume);
+    s->On(2, get_volume);
+    s->On(3, active_name);
+    s->On(4, [&kernel, st, event](Context& c) {
+        st->event->Signal(kernel);
+        event(c);
+    });
+    s->On(5, [&system](Context& c) { c.Push<u32>(system.AudioCore().GetOutputSink().GetSystemChannels()); });
+    s->On(6, list);
+    s->On(7, set_volume);
+    s->On(8, get_volume);
+    s->On(10, active_name);
+    s->On(11, event);
+    s->On(12, event);
+    s->On(13, active_name);
+    return s;
+}
+
+} // namespace
+
+void StopAudioRenderers() {
+    std::vector<std::shared_ptr<RendererSession>> live;
+    {
+        std::scoped_lock lk{g_sessions_lock};
+        for (auto& w : g_sessions)
+            if (auto s = w.lock()) live.push_back(std::move(s));
+        g_sessions.clear();
+    }
+    for (auto& s : live) {
+        if (s->renderer) {
+            s->renderer->Finalize();
+            s->renderer.reset();
+        }
+    }
+}
+
+std::shared_ptr<Service> MakeAudioRendererService(KernelCore& kernel) {
+    Core::System& system = kernel.System();
+    static AudioCore::Renderer::Manager& manager = *new AudioCore::Renderer::Manager{system}; // kept to process exit
+    auto s = std::make_shared<Service>("audren:u");
+    s->On(0, [&kernel, &system](Context& c) { // OpenAudioRenderer(params, transfer memory size, aruid; tmem, process)
+        const auto params = c.Pop<AudioCore::AudioRendererParameterInternal>();
+        const auto tmem_size = c.Pop<u64>();
+        c.Pop<u64>();
+        const u64 aruid = c.Pid();
+        if (c.request.copy_handles.size() < 2) return c.SetResult(0xE401);
+        // The work buffer and the game's process: from the runtime's kernel, or from the emulated handle table.
+        u64 tmem_address = 0;
+        KProcess* game = nullptr;
+        if (NativeGame::Process()) {
+            const auto t = NativeGame::TransferMemory(c.request.copy_handles[0]);
+            if (!t) return c.SetResult(0xE401);
+            tmem_address = t->first;
+            game = NativeGame::Process();
+        } else {
+            auto& table = GetCurrentProcess(kernel).GetHandleTable();
+            KScopedAutoObject tmem = table.GetObject<KTransferMemory>(kernel, c.request.copy_handles[0]);
+            KScopedAutoObject process = table.GetObject<KProcess>(kernel, c.request.copy_handles[1]);
+            if (tmem.IsNull() || process.IsNull()) return c.SetResult(0xE401);
+            tmem_address = GetInteger(tmem->GetSourceAddress());
+            game = process.GetPointerUnsafe();
+        }
+        if (manager.GetSessionCount() + 1 > AudioCore::MaxRendererSessions) return c.SetResult(::Service::Audio::ResultOutOfSessions.raw);
+        const s32 session = manager.GetSessionId();
+        if (session == -1) return c.SetResult(::Service::Audio::ResultOutOfSessions.raw);
+        auto r = std::make_shared<RendererSession>(system, manager);
+        r->process = game;
+        r->process->Open(kernel);
+        r->kernel = &kernel;
+        if (const Result res = r->renderer->Initialize(params, tmem_address, tmem_size, r->process, aruid, session); res.IsError())
+            return c.SetResult(res.raw);
+        c.PushInterface(Renderer(kernel, r));
+    });
+    s->On(1, [](Context& c) { // GetWorkBufferSize(params)
+        const auto params = c.Pop<AudioCore::AudioRendererParameterInternal>();
+        u64 size = 0;
+        if (const Result r = manager.GetWorkBufferSize(params, size); r.IsError()) return c.SetResult(r.raw);
+        c.Push(size);
+    });
+    s->On(2, [&kernel](Context& c) { // GetAudioDeviceService(aruid)
+        c.Pop<u64>();
+        c.PushInterface(Device(kernel, c.Pid(), 0x31564552)); // "REV1"
+    });
+    s->On(4, [&kernel](Context& c) { // GetAudioDeviceServiceWithRevisionInfo(revision, aruid)
+        const auto revision = c.Pop<u32>();
+        c.Pop<u64>();
+        c.PushInterface(Device(kernel, c.Pid(), revision));
+    });
+    return s;
+}
+
+} // namespace Kernel::NativeServices
diff --git a/src/core/hle/kernel/native_bsd.cpp b/src/core/hle/kernel/native_bsd.cpp
