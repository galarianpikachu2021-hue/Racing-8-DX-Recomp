+constexpr int kSpeedLimits[] = {50, 75, 100, 125, 150, 200, 0}; // 0 = off (no limit); 100% is index kSpeedDefault
+
+constexpr uint32_t Rgba(float r, float g, float b, float a) {
+    return static_cast<uint32_t>(r * 255.0f + 0.5f) | static_cast<uint32_t>(g * 255.0f + 0.5f) << 8 |
+           static_cast<uint32_t>(b * 255.0f + 0.5f) << 16 | static_cast<uint32_t>(a * 255.0f + 0.5f) << 24;
+}
+
+void Rect(std::vector<Quad>& out, float x, float y, float w, float h, uint32_t color) {
+    // The solid cell is the last of the atlas (index 95); sample its middle.
+    const float u = (15.0f * kFontCellW + kFontCellW / 2.0f) / kFontAtlasW;
+    const float v = (5.0f * kFontCellH + kFontCellH / 2.0f) / kFontAtlasH;
+    out.push_back({x, y, w, h, u, v, u, v, color});
+}
+
+void Text(std::vector<Quad>& out, float x, float y, float scale, const std::string& text, uint32_t color) {
+    for (const char ch : text) {
+        const int index = (ch >= 32 && ch <= 126) ? ch - 32 : 0;
+        if (index != 0) {
+            const int col = index % kFontCols, row = index / kFontCols;
+            // Half a texel in from the cell edges, so linear filtering doesn't pull in the neighbours.
+            constexpr float hx = 0.5f / kFontAtlasW, hy = 0.5f / kFontAtlasH;
+            out.push_back({x, y, kFontCellW * scale, kFontCellH * scale,
+                           static_cast<float>(col * kFontCellW) / kFontAtlasW + hx,
+                           static_cast<float>(row * kFontCellH) / kFontAtlasH + hy,
+                           static_cast<float>((col + 1) * kFontCellW) / kFontAtlasW - hx,
+                           static_cast<float>((row + 1) * kFontCellH) / kFontAtlasH - hy, color});
+        }
+        x += kFontCellW * scale;
+    }
+}
