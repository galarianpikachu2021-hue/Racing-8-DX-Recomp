+namespace {
+// kart-recomp: IPC tracer (KARTRECOMP_IPC_TRACE=1), for the native-engine plan (docs/NATIVE_ENGINE.md): which service commands the
+// game sends and how often. <log dir>/ipc_trace.txt every 10 s: total, last 10 s, "service: command".
+struct IpcCount {
+    u64 total = 0, reported = 0;
+};
+bool IpcTraceEnabled() {
+    static const bool on = [] {
+        const char* v = std::getenv("KARTRECOMP_IPC_TRACE");
+        return v && *v == '1';
+    }();
+    return on;
+}
+void IpcTraceCount(std::string_view service, const char* command) {
+    static std::mutex lock;
+    static std::map<std::string, IpcCount> counts;
+    static auto last = std::chrono::steady_clock::now();
+    std::scoped_lock guard{lock};
+    ++counts[std::string{service} + ": " + (command ? command : "(unimplemented)")].total;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(10)) return;
+    last = now;
+    std::vector<std::pair<std::string, IpcCount*>> rows;
+    for (auto& [k, v] : counts) rows.emplace_back(k, &v);
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.second->total > b.second->total; });
+    std::ofstream out(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "ipc_trace.txt", std::ios::trunc);
+    out << "# total last_10s service: command\n";
+    for (auto& [k, v] : rows) {
+        out << v->total << ' ' << (v->total - v->reported) << ' ' << k << '\n';
+        v->reported = v->total;
+    }
+}
+} // namespace
