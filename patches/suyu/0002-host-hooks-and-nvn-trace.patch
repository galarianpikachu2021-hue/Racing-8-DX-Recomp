diff --git a/src/common/kart_code_patches.h b/src/common/kart_code_patches.h
new file mode 100644
index 0000000000..7d4a017150
--- /dev/null
+++ b/src/common/kart_code_patches.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: optional game changes made when the game is built, never at run time (no JIT). The exporter
+// (`kartrecomp-export --patch <name>`) changes the instruction before translating the user's own code and lists what it changed in
+// <export>/code_patches.txt; the launcher copies that list into the module folder, and the engine makes the same change to the
+// loaded code (core/loader/nso.cpp), so the code guard's expected words and the game's memory agree. Each entry is tied to one game
+// build (first 8 bytes of main's NSO build ID) and checks the original word before it changes anything.
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace KartCodePatches {
+
+struct Patch {
+    const char* name;
+    uint64_t build;    ///< first 8 bytes of main's NSO build ID
+    uint64_t offset;   ///< in main
+    uint32_t old_word; ///< what must be there
+    uint32_t new_word;
+};
+
+// split60: 60 fps split-screen in 3-4 player races. Once per frame the game gives each view a mode from its group count (byte
+// +0x19 of the view list): fewer than 2 groups = every view drawn every frame (as in 1-2 player races); otherwise only one group
+// is drawn per frame and the others show a kept copy (30 fps per view). The branch "cmp w10,#2; b.lo <mode 0>" becomes "b <mode 0>".
+// The 4.0.1 counterpart of the 3.0.3 "60FPS in Split Screen" patch (bne -> b at main+0xbc0b1c). See docs/FRAMERATE.md.
+inline constexpr Patch kPatches[] = {
+    {"split60", 0x158c0c7399aabd7bULL, 0xafece8, 0x540001a3, 0x1400000d}, // 4.0.1: b.lo 0xafed1c -> b 0xafed1c
+    {"split60", 0x2452c49bc26ec159ULL, 0xafa2b0, 0x540001a3, 0x1400000d}, // 3.0.4: b.lo 0xafa2e4 -> b 0xafa2e4
+};
+
+inline uint64_t BuildPrefix(const uint8_t* build_id) {
+    uint64_t id = 0;
+    for (int i = 0; i < 8; ++i) id = (id << 8) | build_id[i];
+    return id;
+}
+
+/// One line of code_patches.txt: "<module> <offset hex> <old hex> <new hex> <name>".
+struct Applied {
+    std::string module;
+    uint64_t offset;
+    uint32_t old_word, new_word;
+    std::string name;
+};
+
+inline std::vector<Applied> ReadList(const std::string& path) {
+    std::vector<Applied> out;
+    std::ifstream in(path);
+    for (std::string line; std::getline(in, line);) {
+        char module[32]{}, name[64]{};
+        unsigned long long offset = 0;
+        unsigned old_word = 0, new_word = 0;
+        if (std::sscanf(line.c_str(), "%31s %llx %x %x %63s", module, &offset, &old_word, &new_word, name) == 5)
+            out.push_back({module, offset, old_word, new_word, name});
+    }
+    return out;
+}
+
+} // namespace KartCodePatches
diff --git a/src/common/kart_overlay.h b/src/common/kart_overlay.h
new file mode 100644
index 0000000000..032850d7a5
--- /dev/null
+++ b/src/common/kart_overlay.h
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: input path to the in-game overlay menu (suyu_cmd/native_gpu/overlay_menu.h).
+// The window and controller drivers push navigation events here; while the menu is open the
+// drivers keep input away from the game.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <deque>
+#include <mutex>
+
+namespace KartOverlay {
+
+enum class Nav { Up, Down, Left, Right, Accept, Back, Toggle };
+
+inline std::atomic<bool>& OpenFlag() {
+    static std::atomic<bool> open{false};
+    return open;
+}
+inline bool IsOpen() {
+    return OpenFlag().load(std::memory_order_relaxed);
+}
+
+inline std::mutex& QueueLock() {
+    static std::mutex m;
+    return m;
+}
+inline std::deque<Nav>& Queue() {
+    static std::deque<Nav> q;
+    return q;
+}
+
+inline std::atomic<bool>& RestartRequest(); // defined below
+/// Set while the Mods page has unapplied changes: the menu cannot be closed then, only "Restart now" leaves it.
+inline std::atomic<bool>& CloseLocked() {
+    static std::atomic<bool> locked{false};
+    return locked;
+}
+/// Toggle flips the open flag at once; everything else is queued for the render thread.
+inline void Push(Nav n) {
+    if (n == Nav::Toggle) {
+        if (IsOpen() && CloseLocked().load()) { // leaving with unapplied mod changes restarts the game to apply them
+            RestartRequest().store(true);
+            return;
+        }
+        OpenFlag().store(!IsOpen());
+        return;
+    }
+    if (!IsOpen()) {
+        return;
+    }
+    std::scoped_lock lock{QueueLock()};
+    if (Queue().size() < 64) {
+        Queue().push_back(n);
+    }
+}
+
+/// The mods folder the game reads (<dir>/<title id>/<mod>/), set by the frontend at start-up; the overlay's Mods page lists it.
+inline std::string& ModsDir() {
+    static std::string dir;
+    return dir;
+}
+/// Set (by the main-menu hook on the Toy-Con button, now "Mods") to open the overlay on its Mods page.
+inline std::atomic<bool>& ModsPageRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+/// Posted by the overlay for the frontend thread: save the config (mod on/off changed), and save then restart the game.
+inline std::atomic<bool>& SaveRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+inline std::atomic<bool>& RestartRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+/// Held while Settings::values.disabled_addons is changed (render thread) or saved (frontend thread).
+inline std::mutex& SettingsLock() {
+    static std::mutex m;
+    return m;
+}
+/// The game's own command line, for RestartRequest (set by the frontend at start-up).
+inline std::vector<std::string>& LaunchArgs() {
+    static std::vector<std::string> args;
+    return args;
+}
+inline void OpenModsPage() {
+    ModsPageRequest().store(true);
+    OpenFlag().store(true);
+}
+inline bool Pop(Nav& n) {
+    std::scoped_lock lock{QueueLock()};
+    if (Queue().empty()) {
+        return false;
+    }
+    n = Queue().front();
+    Queue().pop_front();
+    return true;
+}
+
+/// The speed limit the user configured, remembered when the overlay first overrides it, so the
+/// frontend's config save (SaveNativeControls) writes the configured value and not the override.
+struct SpeedOriginal {
+    bool saved = false;
+    bool use_limit = true;
+    unsigned percent = 100;
+};
+inline SpeedOriginal& SpeedOriginalValue() {
+    static SpeedOriginal original;
+    return original;
+}
+
+/// Requests from the overlay to the frontend (suyu_cmd's main loop and window): handheld/docked and input recording.
+inline std::atomic<int>& ConsoleRequest() { // -1 none, 0 handheld (low graphics), 1 docked (high)
+    static std::atomic<int> v{-1};
+    return v;
+}
+/// The title screen ("press L + R"): until it is passed the game gets no B (B there would open the main menu, so holding it 5 s to
+/// quit could not work); TitleBHeld has one bit per player for whoever is holding B (hid_core's EmulatedController sets it).
+inline std::atomic<bool>& BlockTitleB() {
+    static std::atomic<bool> on{true};
+    return on;
+}
+inline std::atomic<uint32_t>& TitleBHeld() {
+    static std::atomic<uint32_t> bits{0};
+    return bits;
+}
+/// Diagnostics for the frame-pacing log line: controller reads by the game and vsync signals since the last line.
+inline std::atomic<uint32_t>& DiagPadReads() {
+    static std::atomic<uint32_t> n{0};
+    return n;
+}
+inline std::atomic<uint32_t>& DiagVsyncs() {
+    static std::atomic<uint32_t> n{0};
+    return n;
+}
+inline std::atomic<bool>& QuitRequest() { // the overlay's "Quit game": the window closes like its close button
+    static std::atomic<bool> v{false};
+    return v;
+}
+inline std::atomic<int>& RecordRequest() { // -1 none, 0 stop, 1 start
+    static std::atomic<int> v{-1};
+    return v;
+}
+inline std::atomic<bool>& Recording() {
+    static std::atomic<bool> v{false};
+    return v;
+}
+/// The configured console mode, remembered when the overlay first overrides it (like SpeedOriginal).
+struct ConsoleOriginal {
+    bool saved = false;
+    bool docked = true;
+};
+inline ConsoleOriginal& ConsoleOriginalValue() {
+    static ConsoleOriginal original;
+    return original;
+}
+
+/// Controller assignment for Players 1-4. The window thread publishes the connected controllers
+/// and who plays on what; the overlay shows them as rows and posts a request when a row changes.
+/// Codes: -2 disconnected, -1 keyboard, >= 0 index into `devices`. -3 = no request.
+struct PadState {
+    std::mutex lock;
+    std::vector<std::string> devices;      ///< connected controllers (display names)
+    std::array<int, 4> current{-3, -3, -3, -3};
+    std::array<int, 4> want{-3, -3, -3, -3};
+    uint64_t version = 0;                  ///< bumped whenever devices, current or bindings change
+    bool published = false;                ///< the frontend has filled this in at least once
+    // Controls page: what each player's inputs are bound to (kControlInputs order, readable text), and requests for the window
+    // thread (it owns the input library): capture the next press for one input, or a whole-player action.
+    std::array<std::vector<std::string>, 4> bindings;
+    int capture_player = -1, capture_input = -1; ///< request: rebind this input (index into kControlInputs) by the next press
+    bool capture_cancel = false;
+    int capturing_player = -1, capturing_input = -1; ///< the capture running now (-1 = none)
+    std::string capture_message;              ///< the last capture's result, shown under the list
+    std::array<int, 4> action{};              ///< request: 1 = swap A/B and X/Y, 2 = standard layout for the player's device
+};
+
+/// The inputs the Controls page lists: Settings::NativeButton values, or 100 + Settings::NativeAnalog for the sticks.
+struct ControlInput {
+    const char* label;
+    int code;
+};
+inline constexpr ControlInput kControlInputs[] = {
+    {"A", 0},           {"B", 1},           {"X", 2},           {"Y", 3},
