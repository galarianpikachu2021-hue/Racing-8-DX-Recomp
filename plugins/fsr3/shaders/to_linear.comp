// kart-recomp FSR 3 plugin: the host's tonemapped (sRGB-encoded) colour to linear RGBA16F, which is what FSR 3.1 expects for LDR input.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; int pass_through; } p;
vec3 srgb_to_linear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= p.size.x || px.y >= p.size.y) return;
    vec3 c = texelFetch(src, px, 0).rgb;
    imageStore(dst, px, vec4(p.pass_through != 0 ? c : srgb_to_linear(c), 1.0));
}
