+/// Channel fix-ups for formats stored in a differently ordered Vulkan format
+/// (see MapPixelFormat), applied on top of the TIC swizzle.
+VkComponentMapping FixSwizzle(VideoCore::Surface::PixelFormat f, VkComponentMapping m) {
+    using P = VideoCore::Surface::PixelFormat;
+    const auto swap_rb = [](VkComponentSwizzle c) {
+        return c == VK_COMPONENT_SWIZZLE_R ? VK_COMPONENT_SWIZZLE_B
+               : c == VK_COMPONENT_SWIZZLE_B ? VK_COMPONENT_SWIZZLE_R : c;
+    };
+    const auto reverse = [](VkComponentSwizzle c) {
+        switch (c) {
+        case VK_COMPONENT_SWIZZLE_R: return VK_COMPONENT_SWIZZLE_A;
+        case VK_COMPONENT_SWIZZLE_G: return VK_COMPONENT_SWIZZLE_B;
+        case VK_COMPONENT_SWIZZLE_B: return VK_COMPONENT_SWIZZLE_G;
+        case VK_COMPONENT_SWIZZLE_A: return VK_COMPONENT_SWIZZLE_R;
+        default: return c;
+        }
+    };
+    switch (f) {
+    case P::B5G6R5_UNORM:
+        return {swap_rb(m.r), swap_rb(m.g), swap_rb(m.b), swap_rb(m.a)};
+    case P::A4B4G4R4_UNORM:
+        return {reverse(m.r), reverse(m.g), reverse(m.b), reverse(m.a)};
+    default:
+        return m;
+    }
+}
+
+VkComponentSwizzle MapSwizzle(Tegra::Texture::SwizzleSource s) {
+    using S = Tegra::Texture::SwizzleSource;
+    switch (s) {
+    case S::Zero: return VK_COMPONENT_SWIZZLE_ZERO;
+    case S::R: return VK_COMPONENT_SWIZZLE_R;
+    case S::G: return VK_COMPONENT_SWIZZLE_G;
+    case S::B: return VK_COMPONENT_SWIZZLE_B;
+    case S::A: return VK_COMPONENT_SWIZZLE_A;
+    default: return VK_COMPONENT_SWIZZLE_ONE;
+    }
+}
+
+/// NVN keeps bound texture handles in hardware cbuf 2, one 8-byte handle per
+/// slot starting at byte 0x20 (verified: slot 0 is read at 0x20, slot 1 at 0x28).
+constexpr u32 kTextureHandleBase = 0x20;
+constexpr u32 TextureSlot(u32 cbuf_offset) {
+    return cbuf_offset >= kTextureHandleBase ? (cbuf_offset - kTextureHandleBase) / 8 : 0xFFFF;
+}
