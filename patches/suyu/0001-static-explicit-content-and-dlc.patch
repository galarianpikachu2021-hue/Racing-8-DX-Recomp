+                {
+                    Profile::Scope ps{prof, Profile::DrawTotal};
+                    done = Draw(st, c);
+                }
+                if (frames % 300 == 299) {
+                    std::string sig;
+                    for (const auto* img : st.colors) {
+                        sig += img ? fmt::format("{}x{}:{} ", img->width, img->height,
+                                                 static_cast<int>(img->info.format))
+                                   : std::string{"null "};
+                    }
+                    sig += st.depth ? fmt::format("| d{}x{}", st.depth->width, st.depth->height)
+                                    : std::string{"| nodepth"};
