+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime: virtual CPU cores for host threads.
+//
+// On the console every game thread belongs to a core; at most one thread runs per core, the runnable thread with the best
+// priority (lowest number) always runs, and equal priorities take turns only when the running one blocks or yields. Games rely on
+// this (threads of one core share data without locks). Here every game thread is a real host thread, and this class decides which
+// of them may execute game code:
+//
+//   Acquire(t)  the thread wants to run: returns when it is the running thread of its core
+//   Release(t)  the thread stops running (it is about to wait, or it ended): the core goes to the best waiting thread
+//   Yield(t)    lets waiting threads of the same or better priority run first, then continues
+//   PreemptRequested(t)  true when a better-priority thread waits for t's core: t should Yield at its next safe point
+//
+// No dependencies beyond the standard library; see README.md.
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace KartRuntime {
+
+class CoreScheduler {
+public:
+    class Thread {
+    public:
+        int Core() const { return core; }
+        int Priority() const { return priority; }
+
+    private:
+        friend class CoreScheduler;
+        int core = 0;
+        int priority = 0;
+        bool waiting = false;         ///< in its core's wait list
+        bool granted = false;         ///< it is the running thread of its core
+        int pending_core = -1;        ///< a move asked for while it ran: done when it next yields or releases
+        std::uint64_t order = 0;      ///< arrival order among equal priorities
+        std::atomic<bool> preempt{false};
+        std::condition_variable wake;
+    };
+
+    /// `defer_running_moves`: a running thread moved to another core keeps its core until it yields or waits (the runtime's own
+    /// kernel, where each thread has its own code runner). Without it the old core is handed on at once and the thread queues for
+    /// the new one: what the emulated kernel's native threads need, whose registers live in the per-core runner of the core they
+    /// entered a system call on (moving them mid-call handed one thread's registers to another: a jump to 0 after a lock wait).
+    explicit CoreScheduler(int core_count, bool defer_running_moves = false)
+        : cores(static_cast<std::size_t>(core_count)), defer_moves{defer_running_moves} {}
+
+    /// Called (with the scheduler's lock held: keep it short, do not call back in) when a running thread is asked to yield, so
+    /// the owner can interrupt whatever that thread is executing. Optional.
+    void SetPreemptCallback(std::function<void(Thread*)> fn) { on_preempt = std::move(fn); }
+
+    /// A new thread for `core` with `priority` (lower = runs first). Not running yet.
+    std::unique_ptr<Thread> Create(int core, int priority) {
+        auto t = std::make_unique<Thread>();
+        t->core = core;
+        t->priority = priority;
+        return t;
+    }
+
+    void Acquire(Thread* t) {
+        std::unique_lock lk{lock};
+        Enqueue(t);
+        Dispatch(t->core);
+        t->wake.wait(lk, [t] { return t->granted; });
+    }
+
+    /// `keep_core`: the thread comes back to the same core (a wait inside a host call, while the core's code runner is still in
+    /// use by that call); a pending move is then done at its next yield instead.
+    void Release(Thread* t, bool keep_core = false) {
+        std::scoped_lock lk{lock};
+        ReleaseLocked(t, keep_core);
+    }
+
+    void Yield(Thread* t) {
+        std::unique_lock lk{lock};
+        t->preempt.store(false, std::memory_order_relaxed);
+        if (t->pending_core < 0 && !BetterOrEqualWaiter(t)) return;
+        ReleaseLocked(t);
+        Enqueue(t);
+        Dispatch(t->core);
+        t->wake.wait(lk, [t] { return t->granted; });
+    }
+
+    bool PreemptRequested(const Thread* t) const { return t->preempt.load(std::memory_order_relaxed); }
+
+    /// Changes take effect at once: a waiting thread is re-sorted, a running one may get a preemption request.
+    void SetPriority(Thread* t, int priority) {
+        std::scoped_lock lk{lock};
+        t->priority = priority;
+        Dispatch(t->core);
+    }
+
+    /// Moves a thread to another core. A running thread keeps its core (and reports it) until it next releases or yields - it is
+    /// asked to with PreemptRequested - and moves then; a waiting one waits for the new core.
+    ///
+    /// The running case must not hand the old core on while the thread still executes: the game keeps per-core data indexed by
+    /// nn::os::GetCurrentCoreNumber (a per-core buffer at race start), and two threads executing with one core number shared it
+    /// (memory corruption, a garbage object passed to the graphics driver, a crash ~40 s into a race).
+    void SetCore(Thread* t, int core) {
+        std::scoped_lock lk{lock};
+        const int old = t->core;
+        if (t->granted && defer_moves) {
+            t->pending_core = old == core ? -1 : core;
+            if (t->pending_core >= 0) RequestPreempt(t);
+            return;
+        }
+        if (old == core) return;
+        if (t->waiting) {
+            Remove(cores[static_cast<std::size_t>(old)].waiting, t);
+            t->core = core;
+            cores[static_cast<std::size_t>(core)].waiting.push_back(t);
+            Dispatch(core);
+        } else if (t->granted) {
+            // Leave the old core now and queue for the new one; the thread itself blocks at its next Yield/Acquire.
+            cores[static_cast<std::size_t>(old)].running = nullptr;
+            t->granted = false;
+            t->core = core;
+            Enqueue(t);
+            RequestPreempt(t);
+            Dispatch(old);
+            Dispatch(core);
+        } else {
+            t->core = core;
+        }
+    }
+
+    /// The running thread of a core (null when idle). For diagnostics and tests.
+    const Thread* Running(int core) {
+        std::scoped_lock lk{lock};
+        return cores[static_cast<std::size_t>(core)].running;
+    }
+
+private:
+    struct CoreState {
+        Thread* running = nullptr;
+        std::vector<Thread*> waiting;
+    };
+
+    static void Remove(std::vector<Thread*>& list, Thread* t) {
+        for (auto it = list.begin(); it != list.end(); ++it) {
+            if (*it == t) {
+                list.erase(it);
+                return;
+            }
+        }
+    }
+
+    void Enqueue(Thread* t) {
+        t->waiting = true;
+        t->granted = false;
+        t->order = ++arrivals;
+        cores[static_cast<std::size_t>(t->core)].waiting.push_back(t);
+    }
+
+    static bool Before(const Thread* a, const Thread* b) {
+        return a->priority != b->priority ? a->priority < b->priority : a->order < b->order;
+    }
+
+    Thread* Best(CoreState& c) {
+        Thread* best = nullptr;
+        for (Thread* w : c.waiting)
+            if (!best || Before(w, best)) best = w;
+        return best;
+    }
+
+    bool BetterOrEqualWaiter(const Thread* t) {
+        for (const Thread* w : cores[static_cast<std::size_t>(t->core)].waiting)
+            if (w->priority <= t->priority) return true;
+        return false;
+    }
+
+    /// Gives an idle core to its best waiter; asks a running thread to yield when a better one waits.
+    void Dispatch(int core) {
+        CoreState& c = cores[static_cast<std::size_t>(core)];
+        Thread* best = Best(c);
+        if (!best) return;
+        if (!c.running) {
+            Remove(c.waiting, best);
+            best->waiting = false;
+            best->granted = true;
+            best->preempt.store(false, std::memory_order_relaxed);
+            c.running = best;
+            best->wake.notify_one();
+            if (best->pending_core >= 0) RequestPreempt(best); // a move still to do (it came back here after a host wait)
+            best = Best(c);
+            if (!best) return;
+        }
+        if (best->priority < c.running->priority) RequestPreempt(c.running);
+    }
+
+    void RequestPreempt(Thread* t) {
+        if (t->preempt.exchange(true, std::memory_order_relaxed)) return;
+        if (on_preempt) on_preempt(t);
+    }
+
+    void ReleaseLocked(Thread* t, bool keep_core = false) {
+        CoreState& c = cores[static_cast<std::size_t>(t->core)];
+        if (t->waiting) { // moved to another core while running, or released before it was granted
+            Remove(c.waiting, t);
+            t->waiting = false;
+        }
+        if (c.running == t) c.running = nullptr;
+        t->granted = false;
+        t->preempt.store(false, std::memory_order_relaxed);
+        Dispatch(t->core);
+        if (t->pending_core >= 0 && !keep_core) { // the move asked for while it ran
+            t->core = t->pending_core;
+            t->pending_core = -1;
+        }
+    }
+
+    std::mutex lock;
+    std::vector<CoreState> cores;
+    std::uint64_t arrivals = 0;
+    std::function<void(Thread*)> on_preempt;
+    const bool defer_moves;
+};
+
+} // namespace KartRuntime
diff --git a/src/kart_runtime/direct_memory.h b/src/kart_runtime/direct_memory.h
new file mode 100644
index 0000000000..6b0956610e
--- /dev/null
+++ b/src/kart_runtime/direct_memory.h
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart_runtime: direct game memory.
+//
+// The game's address space is one reserved host range ("arena"): game address A lives at arena + A. Recompiled code built for
+// direct memory reads and writes there with plain host instructions, with no lookup and no call. That only works for pages that
+// are mapped with the right access, so this file supplies what the lookup path used to do for the rest, from a fault handler:
+//
+//   read of an unmapped page    reads zeros (a zero page is mapped there, read-only): what the lookup path returned. A character
+//                               mod that leaves a null object pointer in the game does this every frame; after the first fault
+//                               the page is there and later reads cost nothing.
+//   write to an unmapped page   is dropped: the page is made writable for that one instruction (single step), then replaced with
+//                               a zero page again. Two signals per write is far too slow for code that fills a whole buffer it
+//                               never got (a game without firmware decodes Mii data into a null buffer, 300,000 writes a
+//                               second), so a page that takes kSinkAfter such writes becomes a "sink": it stays writable, and
+//                               ZeroSinks(), which the caller runs once per frame, empties all sinks. Writes to a sink are
+//                               gone by the next frame instead of at once.
+//   access to a mapped page the game has no permission for (the lookup path ignored permissions): the page is opened for good.
+//
+// Faults outside the arena are not ours and go to the previous handler. Everything is counted (Stats) so a caller can log it.
+// Linux x86-64 only for now; Install returns false elsewhere and the caller must not load direct-memory game code then.
+// No dependencies beyond the standard library and the OS; see README.md.
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#if defined(__linux__) && defined(__x86_64__)
+#include <signal.h>
+#include <sys/mman.h>
+#include <ucontext.h>
+#endif
+
+namespace KartRuntime::DirectMemory {
+
+/// True when the game has this address mapped. Called from the fault handler: it may only read memory (no locks, no allocation).
+using IsMappedFn = bool (*)(std::uint64_t game_address);
+
+struct Stats {
+    std::atomic<std::uint64_t> unmapped_reads{0};  ///< faults: reads of unmapped pages (each page faults once)
+    std::atomic<std::uint64_t> unmapped_writes{0}; ///< faults: dropped writes to unmapped pages
+    std::atomic<std::uint64_t> opened_pages{0};    ///< mapped pages opened because the game lacked permission
+    std::atomic<std::uint64_t> last_unmapped{0};   ///< game address of the latest unmapped access
+    std::atomic<std::uint64_t> last_opened{0};     ///< game address of the latest opened page
+    std::atomic<std::uint64_t> sink_pages{0};      ///< unmapped pages that take writes without a fault (emptied by ZeroSinks)
+    std::atomic<std::uint64_t> last_write_ip{0};   ///< host instruction address of the latest dropped write (which code did it)
+};
+
+inline Stats& GetStats() {
+    static Stats stats;
+    return stats;
+}
+
+namespace Detail {
+inline std::atomic<std::uint8_t*> g_base{nullptr};
+inline std::atomic<std::uint64_t> g_size{0};
+inline std::atomic<IsMappedFn> g_is_mapped{nullptr};
+inline constexpr std::uint32_t kSinkAfter = 16;   ///< dropped writes to one page before it becomes a sink
+inline constexpr std::size_t kCountSlots = 4096;  ///< write counters, a direct-mapped cache keyed by page
+inline constexpr std::size_t kMaxRanges = 1024;   ///< separate sink ranges; past that, writes are single-stepped again
+inline constexpr std::uint64_t kMaxGrow = 1u << 20; ///< a range that keeps being extended grows by up to this much at once
+inline std::atomic<std::uint64_t> g_count_page[kCountSlots];
+inline std::atomic<std::uint32_t> g_count[kCountSlots];
+/// Sink ranges [start, end) in game addresses. Code that fills a buffer it never got walks upwards through memory, so a sink is
+/// usually the page after an existing range: ranges keep the list short and let the range grow ahead of the writer.
+struct SinkRange {
+    std::uint64_t start, end;
+};
+inline SinkRange g_ranges[kMaxRanges];
+inline std::size_t g_range_count = 0;
+inline std::atomic_flag g_range_lock = ATOMIC_FLAG_INIT; ///< spin lock: taken in the fault handler and in ZeroSinks
+struct RangeLock {
+    RangeLock() {
+        while (g_range_lock.test_and_set(std::memory_order_acquire)) {
+        }
+    }
+    ~RangeLock() { g_range_lock.clear(std::memory_order_release); }
+};
+
+/// Counts a dropped write to `page` (a game address); true when the page should become a sink now.
+inline bool CountWrite(std::uint64_t page) {
+    const std::size_t slot = (page >> 12) % kCountSlots;
+    if (g_count_page[slot].load(std::memory_order_relaxed) != page + 1) {
+        g_count_page[slot].store(page + 1, std::memory_order_relaxed);
+        g_count[slot].store(1, std::memory_order_relaxed);
+        return false;
+    }
+    return g_count[slot].fetch_add(1, std::memory_order_relaxed) + 1 >= kSinkAfter;
+}
+#if defined(__linux__) && defined(__x86_64__)
+inline struct sigaction g_old_segv {};
+inline struct sigaction g_old_trap {};
+/// Pages made writable for the instruction being stepped (one instruction can touch two pages).
+inline thread_local void* t_stepping[2] = {nullptr, nullptr};
+
+inline void Chain(const struct sigaction& old, int sig, siginfo_t* info, void* raw) {
+    if (old.sa_flags & SA_SIGINFO) {
+        if (old.sa_sigaction) return old.sa_sigaction(sig, info, raw);
+    } else if (old.sa_handler != SIG_DFL && old.sa_handler != SIG_IGN) {
+        return old.sa_handler(sig);
+    }
+    // No earlier handler: die the default way, with the fault reported as itself.
+    struct sigaction dfl {};
+    dfl.sa_handler = SIG_DFL;
+    sigaction(sig, &dfl, nullptr);
+}
+
+inline void OnSegv(int sig, siginfo_t* info, void* raw) {
+    auto* uc = static_cast<ucontext_t*>(raw);
+    std::uint8_t* const base = g_base.load(std::memory_order_relaxed);
+    auto* const fault = static_cast<std::uint8_t*>(info->si_addr);
+    if (!base || fault < base || fault >= base + g_size.load(std::memory_order_relaxed)) return Chain(g_old_segv, sig, info, raw);
+    const std::uint64_t game = static_cast<std::uint64_t>(fault - base);
+    void* const page = base + (game & ~std::uint64_t{0xfff});
+    const bool write = (uc->uc_mcontext.gregs[REG_ERR] & 2) != 0;
+    Stats& stats = GetStats();
+    const IsMappedFn is_mapped = g_is_mapped.load(std::memory_order_relaxed);
+    if (is_mapped && is_mapped(game)) {
+        if (mprotect(page, 0x1000, PROT_READ | PROT_WRITE) != 0) return Chain(g_old_segv, sig, info, raw);
+        stats.opened_pages.fetch_add(1, std::memory_order_relaxed);
+        stats.last_opened.store(game, std::memory_order_relaxed);
+        return;
+    }
+    stats.last_unmapped.store(game, std::memory_order_relaxed);
+    if (!write) {
+        if (mmap(page, 0x1000, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) {
+            return Chain(g_old_segv, sig, info, raw);
+        }
+        stats.unmapped_reads.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    stats.last_write_ip.store(static_cast<std::uint64_t>(uc->uc_mcontext.gregs[REG_RIP]), std::memory_order_relaxed);
+    const std::uint64_t game_page = game & ~std::uint64_t{0xfff};
+    if (CountWrite(game_page)) {
+        RangeLock lock;
+        // The page right after a range extends it, and by as much as the range has already grown (up to kMaxGrow, stopping at
+        // anything the game has mapped): a writer walking through memory soon stops faulting at all.
+        std::uint64_t start = game_page, end = game_page + 0x1000;
+        SinkRange* into = nullptr;
+        for (std::size_t i = 0; i < g_range_count; ++i) {
+            if (g_ranges[i].end == game_page) {
+                into = &g_ranges[i];
+                const std::uint64_t want = std::min(g_ranges[i].end - g_ranges[i].start, kMaxGrow);
+                const std::uint64_t limit = g_size.load(std::memory_order_relaxed);
+                while (end - start < want && end < limit && !(is_mapped && is_mapped(end))) end += 0x1000;
+                break;
+            }
+        }
+        if ((into || g_range_count < kMaxRanges) &&
+            mmap(base + start, end - start, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) != MAP_FAILED) {
+            if (into) into->end = end;
+            else g_ranges[g_range_count++] = {start, end};
+            stats.sink_pages.fetch_add((end - start) >> 12, std::memory_order_relaxed);
+            stats.unmapped_writes.fetch_add(1, std::memory_order_relaxed);
+            return; // the write happens, into the sink
+        }
+    }
+    int slot = t_stepping[0] == nullptr ? 0 : (t_stepping[1] == nullptr ? 1 : -1);
+    if (slot < 0 || mmap(page, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) {
+        return Chain(g_old_segv, sig, info, raw);
+    }
+    t_stepping[slot] = page;
+    uc->uc_mcontext.gregs[REG_EFL] |= 0x100; // trap flag: SIGTRAP after this instruction
+    stats.unmapped_writes.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void OnTrap(int sig, siginfo_t* info, void* raw) {
+    if (!t_stepping[0]) return Chain(g_old_trap, sig, info, raw);
+    auto* uc = static_cast<ucontext_t*>(raw);
+    for (void*& page : t_stepping) {
+        if (page) mmap(page, 0x1000, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0); // a fresh zero page: the write is gone
+        page = nullptr;
+    }
+    uc->uc_mcontext.gregs[REG_EFL] &= ~static_cast<greg_t>(0x100);
+}
+#endif
+} // namespace Detail
+
+/// Empties the sink pages (see the top of the file): call once per frame, from any one thread. Sinks the game has mapped real
+/// memory over since are left alone.
+inline void ZeroSinks() {
+#if defined(__linux__) && defined(__x86_64__)
+    std::uint8_t* const base = Detail::g_base.load(std::memory_order_relaxed);
+    if (!base) return;
+    const IsMappedFn is_mapped = Detail::g_is_mapped.load(std::memory_order_relaxed);
+    Detail::RangeLock lock;
+    for (std::size_t i = 0; i < Detail::g_range_count; ++i) {
+        const Detail::SinkRange range = Detail::g_ranges[i];
+        // Pages the game has mapped since are its own now: empty only the runs between them.
+        std::uint64_t run = range.start;
+        for (std::uint64_t page = range.start; page <= range.end; page += 0x1000) {
+            if (page == range.end || (is_mapped && is_mapped(page))) {
+                if (page > run) madvise(base + run, page - run, MADV_DONTNEED);
+                run = page + 0x1000;
+            }
+        }
+    }
+#endif
+}
+
+/// Starts handling faults in [base, base + size). Call once, before game code runs. False when this platform has no handler.
+inline bool Install(std::uint8_t* base, std::uint64_t size, IsMappedFn is_mapped) {
+#if defined(__linux__) && defined(__x86_64__)
+    if (!base || Detail::g_base.load()) return Detail::g_base.load() == base;
+    Detail::g_is_mapped.store(is_mapped);
+    Detail::g_size.store(size);
+    Detail::g_base.store(base);
+    struct sigaction sa {};
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_sigaction = &Detail::OnSegv;
+    if (sigaction(SIGSEGV, &sa, &Detail::g_old_segv) != 0) return false;
+    sa.sa_sigaction = &Detail::OnTrap;
+    return sigaction(SIGTRAP, &sa, &Detail::g_old_trap) == 0;
+#else
+    (void)base, (void)size, (void)is_mapped;
+    return false;
+#endif
+}
+
+} // namespace KartRuntime::DirectMemory
diff --git a/src/kart_runtime/game_kernel.h b/src/kart_runtime/game_kernel.h
new file mode 100644
index 0000000000..1555c08363
--- /dev/null
+++ b/src/kart_runtime/game_kernel.h
@@ -0,0 +1,610 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp runtime: the kernel for the game's process (docs/NATIVE_KERNEL.md, stages 3-4).
+//
+// Game threads are runtime threads: each one a host thread that takes one of the console's four virtual cores from the
+// core scheduler, runs the recompiled code through an `Executor` until the code makes a system call, answers the call here and
+// goes on. A thread that waits gives its core up meanwhile. The system calls the game makes are answered from the runtime's
+// parts: the address space (memory calls), the native kernel (handles, sessions, events, waits), the sync arbiter (locks,
+// condition variables, address waits, sleeps) and this file (threads, info, shared and transfer memory).
+//
+// Standard library only (tests: tests/test_game_kernel.cpp).
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "address_space.h"
+#include "core_scheduler.h"
+#include "native_kernel.h"
+#include "sync_arbiter.h"
+
+namespace KartRuntime {
+
+/// A guest thread's registers (AArch64).
+/// (The console kernel's ThreadContext layout: x0-x28, fp, lr, sp, pc, pstate, 32 x 128-bit vector registers, fpcr, fpsr.)
+struct ThreadContext {
+    std::array<uint64_t, 31> x{}; ///< x0-x30 (x29 = fp, x30 = lr)
+    uint64_t sp = 0, pc = 0;
+    uint32_t pstate = 0, padding = 0;
+    std::array<uint64_t, 64> v{}; ///< 32 vector registers, 128 bits each
+    uint32_t fpcr = 0, fpsr = 0;
+    uint64_t tpidr = 0;           ///< TPIDR_EL0 (the game's own)
+};
+static_assert(sizeof(ThreadContext) == 0x320);
+
+class GameKernel;
+
+/// A game thread. Its handle object is a waitable that is signalled when the thread has ended.
+class GuestThread final : public Event {
+public:
+    GuestThread(NativeKernel& k, uint64_t id_) : Event{k, "thread"}, id{id_} {}
+    const char* Kind() const override { return "thread"; }
+    static constexpr ObjectType StaticType = ObjectType::Thread;
+    ObjectType Type() const override { return StaticType; }
+
+    const uint64_t id;
+    ThreadContext ctx;
+    uint64_t tls = 0; ///< the thread's 0x200-byte local region (TPIDRRO_EL0)
+    int priority = 44;
+    int ideal_core = 0;
+    uint64_t affinity = 1;
+    std::unique_ptr<CoreScheduler::Thread> sched;
+    std::atomic<bool> started{false}, ended{false}, terminate{false};
+    void* executor_data = nullptr; ///< the executor's per-thread state
+    int wait_depth = 0;            ///< nested host waits (BeginWait / EndWait), on the thread itself only
+    int start_core = 0;            ///< the core it starts on (its ideal core, or what SetThreadCoreMask chose before the start)
+};
+
+/// Runs a guest thread's code.
+class Executor {
+public:
+    virtual ~Executor() = default;
+    /// Runs `t` (holding virtual core `core`) until it makes a system call: returns the call's number, or -1 when it was
+    /// interrupted (preemption, termination).
+    virtual int Run(GuestThread& t, int core) = 0;
+    /// Makes the Run on `core` return soon.
+    virtual void Interrupt(int core) = 0;
+    /// `t` has ended (on its own host thread): per-thread state can go.
+    virtual void Ended(GuestThread&) {}
+};
+
+class GameKernel {
+public:
+    struct Config {
+        uint64_t program_id = 0, process_id = 0x51;
+        uint64_t entry = 0;
+        uint64_t main_stack_size = 0x100000;
+        int main_priority = 44, main_core = 0;
+        uint64_t core_mask = 0b111, priority_mask = ~uint64_t{0};
+        uint64_t total_memory = 0;  ///< GetInfo total memory size
+        std::function<uint64_t()> tick; ///< the 19.2 MHz system counter
+        std::function<uint32_t*(uint64_t)> host_word; ///< guest word -> host pointer (lock / arbiter words)
+        std::function<std::optional<uint32_t>(const std::string&)> connect_port; ///< ConnectToNamedPort (the service manager)
+        std::function<void(GuestThread&, uint32_t svc)> unknown_svc;
+        /// svcBreak. A break that is not a notification (bit 31 of the reason clear) is a crash: with no debugger attached the
+        /// console ends the process, and so does the runtime (after this hook, which can log the thread's state).
+        std::function<void(GuestThread&, uint32_t reason, uint64_t a, uint64_t b)> on_break;
+        std::function<void(const std::string&)> debug_output;
+        std::function<void()> on_exit_process;
+    };
+
+    static constexpr uint32_t CurrentThreadHandle = 0xFFFF8000, CurrentProcessHandle = 0xFFFF8001;
+    static constexpr uint64_t TlsSlot = 0x200;
+
+    GameKernel(Config c, AddressSpace& memory, NativeKernel& handles, SyncArbiter& arbiter, CoreScheduler& scheduler,
+               Executor& executor)
+        : cfg{std::move(c)}, mem{memory}, kernel{handles}, sync{arbiter}, sched{scheduler}, exec{executor} {
+        std::random_device rd;
+        for (auto& e : entropy) e = (uint64_t{rd()} << 32) | rd();
+    }
+    ~GameKernel() { Shutdown(); }
+
+    /// The game thread running on this host thread (null on other threads).
+    static GuestThread* Current() { return t_current; }
+    /// A waiting game thread gives its core up / takes it back (hooks for the native kernel's and the arbiter's waits).
+    /// The calling game thread waits in host code: its virtual core is free meanwhile. Waits nest (a blocking service call whose
+    /// library code blocks again): only the outermost gives the core up and takes it back.
+    void BeginWait() {
+        if (GuestThread* t = t_current; t && t->wait_depth++ == 0) sched.Release(t->sched.get());
+    }
+    void EndWait() {
+        if (GuestThread* t = t_current; t && t->wait_depth > 0 && --t->wait_depth == 0) sched.Acquire(t->sched.get());
+    }
+
+    /// Creates and starts the main thread: stack in the stack region, x0 = 0, x1 = its handle.
+    uint32_t StartMain() {
+        const auto stack = mem.FindFree(mem.GetLayout().stack_start, mem.GetLayout().stack_size, cfg.main_stack_size);
+        if (!stack) return MemResult::OutOfAddressSpace;
+        if (const uint32_t r = mem.MapNew(*stack, cfg.main_stack_size, MemState::Stack, MemPerm::ReadWrite); r) return r;
+        uint32_t handle = 0;
+        if (const uint32_t r = CreateThread(cfg.entry, 0, *stack + cfg.main_stack_size, cfg.main_priority, cfg.main_core, &handle); r)
+            return r;
+        auto t = kernel.GetAs<GuestThread>(handle);
+        t->ctx.x[1] = handle;
+        main_thread = t;
+        return StartThread(handle);
+    }
+
+    /// Ends every thread (engine shutdown): their waits end, their code is interrupted, their host threads are joined.
+    void Shutdown() {
+        std::vector<std::shared_ptr<GuestThread>> list;
+        {
+            std::scoped_lock lk{threads_lock};
+            list = threads;
+        }
+        for (auto& t : list) {
+            t->terminate = true;
+            kernel.Terminate(t->id);
+            sync.Cancel(t->id);
+            if (t->sched) exec.Interrupt(t->sched->Core());
+        }
+        std::vector<std::thread> hosts;
+        {
+            std::scoped_lock lk{threads_lock};
+            hosts.swap(host_threads);
+        }
+        for (auto& h : hosts)
+            if (h.joinable()) h.join();
+    }
+
+    size_t LiveThreads() {
+        std::scoped_lock lk{threads_lock};
+        size_t n = 0;
+        for (auto& t : threads) n += t->started && !t->ended;
+        return n;
+    }
+    std::shared_ptr<GuestThread> MainThread() { return main_thread; }
+
+    // ---- system calls
+    /// Answers system call `svc` for `t` (arguments and results in its registers).
+    void Svc(GuestThread& t, uint32_t svc) {
+        if (on_svc) {
+            const auto before = t.ctx.x;
+            on_svc(t, svc, before, true);
+            SvcImpl(t, svc);
+            on_svc(t, svc, before, false);
+            return;
+        }
+        SvcImpl(t, svc);
+    }
+    /// Diagnostics: called before (`entering`) and after each system call with the registers it was made with.
+    std::function<void(GuestThread&, uint32_t svc, const std::array<uint64_t, 31>& args, bool entering)> on_svc;
+
+private:
+    void SvcImpl(GuestThread& t, uint32_t svc) {
+        auto& x = t.ctx.x;
+        auto ret = [&](uint32_t r) { x[0] = r; };
+        switch (svc) {
+        case 0x01: { // SetHeapSize(size) -> addr
+            uint64_t addr = 0;
+            ret(mem.SetHeapSize(x[1], &addr));
+            x[1] = addr;
+            break;
+        }
+        case 0x02: ret(mem.SetPermission(x[0], x[1], static_cast<uint32_t>(x[2]))); break;
+        case 0x03: ret(mem.SetAttribute(x[0], x[1], static_cast<uint32_t>(x[2]), static_cast<uint32_t>(x[3]))); break;
+        case 0x04: ret(mem.MapAlias(x[0], x[1], x[2])); break;
+        case 0x05: ret(mem.UnmapAlias(x[0], x[1], x[2])); break;
+        case 0x06: { // QueryMemory(out info, out page info, addr)
+            const MemoryInfo info = mem.Query(x[2]);
+            ret(kernel.Write(x[0], &info, sizeof(info)) ? 0 : MemResult::InvalidCurrentMemory);
+            x[1] = 0;
+            break;
+        }
+        case 0x07: // ExitProcess
+            if (cfg.on_exit_process) cfg.on_exit_process();
+            t.terminate = true;
+            break;
+        case 0x08: { // CreateThread(entry, arg, stack top, priority, core) -> handle
+            uint32_t h = 0;
+            ret(CreateThread(x[1], x[2], x[3], static_cast<int32_t>(x[4]), static_cast<int32_t>(x[5]), &h));
+            x[1] = h;
+            break;
+        }
+        case 0x09: ret(StartThread(static_cast<uint32_t>(x[0]))); break;
+        case 0x0A: t.terminate = true; break; // ExitThread
+        case 0x0B: Sleep(t, static_cast<int64_t>(x[0])); break;
+        case 0x0C: { // GetThreadPriority(handle)
+            auto th = ThreadOf(t, static_cast<uint32_t>(x[1]));
+            if (!th) return ret(KernelResult::InvalidHandle);
+            ret(0);
+            x[1] = static_cast<uint64_t>(th->priority);
+            break;
+        }
+        case 0x0D: { // SetThreadPriority(handle, priority)
+            auto th = ThreadOf(t, static_cast<uint32_t>(x[0]));
+            if (!th) return ret(KernelResult::InvalidHandle);
+            const int p = static_cast<int32_t>(x[1]);
+            if (p < 0 || p > 63 || !((cfg.priority_mask >> p) & 1)) return ret(0xE001); // invalid priority
+            th->priority = p;
+            if (th->sched) sched.SetPriority(th->sched.get(), p);
+            ret(0);
+            break;
+        }
+        case 0x0E: { // GetThreadCoreMask(handle) -> ideal core, mask
+            auto th = ThreadOf(t, static_cast<uint32_t>(x[2]));
+            if (!th) return ret(KernelResult::InvalidHandle);
+            ret(0);
+            x[1] = static_cast<uint64_t>(th->ideal_core);
+            x[2] = th->affinity;
+            break;
+        }
+        case 0x0F: ret(SetCoreMask(t, static_cast<uint32_t>(x[0]), static_cast<int32_t>(x[1]), x[2])); break;
+        case 0x10: CheckOwner(t, "core number"); x[0] = static_cast<uint64_t>(t.sched->Core()); break; // GetCurrentProcessorNumber
+        case 0x12: { // ClearEvent (whether or not it was signalled)
+            auto e = kernel.GetAs<Event>(static_cast<uint32_t>(x[0]));
+            if (!e) return ret(KernelResult::InvalidHandle);
+            e->Clear();
+            if (on_reset) on_reset(*e);
+            ret(0);
+            break;
+        }
+        case 0x13: ret(MapShared(static_cast<uint32_t>(x[0]), x[1], x[2], static_cast<uint32_t>(x[3]))); break;
+        case 0x14: ret(UnmapShared(static_cast<uint32_t>(x[0]), x[1], x[2])); break;
+        case 0x15: { // CreateTransferMemory(addr, size, perm) -> handle
+            uint32_t h = 0;
+            ret(CreateTransferMemory(x[1], x[2], static_cast<uint32_t>(x[3]), &h));
+            x[1] = h;
+            break;
+        }
+        case 0x16: ret(kernel.Close(static_cast<uint32_t>(x[0])) ? 0 : KernelResult::InvalidHandle); break;
+        case 0x17: { // ResetSignal
+            auto e = kernel.GetAs<Event>(static_cast<uint32_t>(x[0]));
+            if (!e) return ret(KernelResult::InvalidHandle);
+            if (!e->IsSignaled()) return ret(KernelResult::InvalidState);
+            e->Clear();
+            if (on_reset) on_reset(*e);
+            ret(0);
+            break;
+        }
+        case 0x18: Wait(t); break;
+        case 0x19: { // CancelSynchronization(thread handle)
+            auto th = ThreadOf(t, static_cast<uint32_t>(x[0]));
+            if (!th) return ret(KernelResult::InvalidHandle);
+            kernel.CancelWait(th->id);
+            ret(0);
+            break;
+        }
+        case 0x1A: ret(Arbiter(sync.LockWait(t.id, x[1], static_cast<uint32_t>(x[0]), static_cast<uint32_t>(x[2]), t.priority))); break;
+        case 0x1B: ret(Arbiter(sync.Unlock(x[0]))); break;
+        case 0x1C: ret(Arbiter(sync.ConditionWait(t.id, x[0], x[1], static_cast<uint32_t>(x[2]), t.priority, static_cast<int64_t>(x[3])))); break;
+        case 0x1D: sync.ConditionSignal(x[0], static_cast<int32_t>(x[1])); break;
+        case 0x1E: x[0] = cfg.tick ? cfg.tick() : 0; break; // GetSystemTick
+        case 0x1F: { // ConnectToNamedPort(name)
+            char name[13]{};
+            if (!kernel.Read(x[1], name, 12)) return ret(MemResult::InvalidAddress);
+            const auto h = cfg.connect_port ? cfg.connect_port(name) : std::nullopt;
+            if (!h) return ret(0xF201); // not found
+            ret(0);
+            x[1] = *h;
+            break;
+        }
+        case 0x21: { // SendSyncRequest(session): the message is the thread's local region
+            uint8_t msg[Hipc::MessageSize];
+            if (!kernel.Read(t.tls, msg, sizeof(msg))) return ret(MemResult::InvalidAddress);
+            const uint32_t r = kernel.SendSyncRequest(static_cast<uint32_t>(x[0]), msg);
+            if (r == 0) kernel.Write(t.tls, msg, sizeof(msg));
+            ret(r);
+            break;
+        }
+        case 0x24: // GetProcessId
+            ret(0);
+            x[1] = cfg.process_id;
+            break;
+        case 0x25: { // GetThreadId(handle)
+            auto th = ThreadOf(t, static_cast<uint32_t>(x[1]));
+            if (!th) return ret(KernelResult::InvalidHandle);
+            ret(0);
+            x[1] = th->id;
+            break;
+        }
+        case 0x26: { // Break
+            const auto reason = static_cast<uint32_t>(x[0]);
+            if (cfg.on_break) cfg.on_break(t, reason, x[1], x[2]);
+            ret(0);
+            if (!(reason & 0x80000000u)) { // not a notification: the process ends
+                if (cfg.on_exit_process) cfg.on_exit_process();
+                t.terminate = true;
+            }
+            break;
+        }
+        case 0x27: { // OutputDebugString(ptr, size)
+            std::string s(std::min<uint64_t>(x[1], 0x1000), '\0');
+            if (!s.empty() && kernel.Read(x[0], s.data(), s.size()) && cfg.debug_output) cfg.debug_output(s);
+            ret(0);
+            break;
+        }
+        case 0x29: { // GetInfo(type, handle, sub)
+            uint64_t v = 0;
+            ret(GetInfo(static_cast<uint32_t>(x[1]), static_cast<uint32_t>(x[2]), x[3], &v));
+            x[1] = v;
+            break;
+        }
+        case 0x34:
+            ret(Arbiter(sync.AddressWait(t.id, x[0], static_cast<SyncArbiter::WaitType>(x[1]), static_cast<int32_t>(x[2]), t.priority,
+                                         static_cast<int64_t>(x[3]))));
+            break;
+        case 0x35:
+            ret(Arbiter(sync.AddressSignal(x[0], static_cast<SyncArbiter::SignalType>(x[1]), static_cast<int32_t>(x[2]), static_cast<int32_t>(x[3]))));
+            break;
+        default:
+            if (cfg.unknown_svc) cfg.unknown_svc(t, svc);
+            ret(0xF201); // not implemented
+            break;
+        }
+    }
+
+public:
+    /// Shared memory owned by a service (fonts, controller state): pages at `phys` mapped by the game with MapSharedMemory.
+    class SharedMemory final : public KernelObject {
+    public:
+        SharedMemory(uint64_t p, uint64_t s, uint32_t perm) : phys{p}, size{s}, owner_perm{perm} {}
+        const char* Kind() const override { return "shared memory"; }
+        static constexpr ObjectType StaticType = ObjectType::SharedMemory;
+        ObjectType Type() const override { return StaticType; }
+        const uint64_t phys, size;
+        const uint32_t owner_perm;
+    };
+    /// Memory the game lends to a service (audio and driver work buffers).
+    class TransferMemory final : public KernelObject {
+    public:
+        TransferMemory(AddressSpace& m, uint64_t a, uint64_t s) : mem{m}, address{a}, size{s} {}
+        ~TransferMemory() override { mem.UnlockTransfer(address, size); }
+        const char* Kind() const override { return "transfer memory"; }
+        static constexpr ObjectType StaticType = ObjectType::TransferMemory;
+        ObjectType Type() const override { return StaticType; }
+        AddressSpace& mem;
+        const uint64_t address, size;
+    };
+
+    /// Called after a runtime ResetSignal (the adapter resets an emulated event behind a mirror).
+    std::function<void(Event&)> on_reset;
+
+private:
+    static inline thread_local GuestThread* t_current = nullptr;
+
+    uint32_t CreateThread(uint64_t entry, uint64_t arg, uint64_t stack_top, int priority, int core, uint32_t* out) {
+        if (core == -2) core = cfg.main_core;
+        if (core < 0 || core > 3 || !((cfg.core_mask >> core) & 1)) return 0xF601; // invalid core id
+        if (priority < 0 || priority > 63 || !((cfg.priority_mask >> priority) & 1)) return 0xE001;
+        const uint64_t tls = AllocateTls();
+        if (!tls) return MemResult::OutOfMemory;
+        auto t = std::make_shared<GuestThread>(kernel, next_id++);
+        t->ctx.pc = entry;
+        t->ctx.x[0] = arg;
+        t->ctx.sp = stack_top;
+        // x18 (the platform register) starts as a random odd value, as the console's kernel sets it (KThread's context reset).
+        {
+            static thread_local std::mt19937_64 rng{std::random_device{}()};
+            t->ctx.x[18] = rng() | 1;
+        }
+        t->tls = tls;
+        t->priority = priority;
+        t->ideal_core = core;
+        t->start_core = core;
+        t->affinity = uint64_t{1} << core;
+        {
+            std::scoped_lock lk{threads_lock};
+            threads.push_back(t);
+        }
+        *out = kernel.Add(t);
+        return 0;
+    }
+
+    uint32_t StartThread(uint32_t handle) {
+        auto t = kernel.GetAs<GuestThread>(handle);
+        if (!t) return KernelResult::InvalidHandle;
+        if (t->started.exchange(true)) return KernelResult::InvalidState;
+        t->sched = sched.Create(t->start_core, t->priority);
+        std::scoped_lock lk{threads_lock};
+        host_threads.emplace_back([this, t] { HostMain(t); });
+        return 0;
+    }
+
+    void HostMain(std::shared_ptr<GuestThread> t) {
+        t_current = t.get();
+        sched.Acquire(t->sched.get());
+        while (!t->terminate) {
+            const int svc = exec.Run(*t, t->sched->Core());
+            if (svc >= 0) Svc(*t, static_cast<uint32_t>(svc));
+            if (t->terminate) break;
+            if (sched.PreemptRequested(t->sched.get())) sched.Yield(t->sched.get());
+        }
+        sched.Release(t->sched.get());
+        exec.Ended(*t);
+        t->ended = true;
+        t->Signal(); // waiting for this thread ends
+        t_current = nullptr;
+    }
+
+    /// Diagnostics: a thread executing game code must be the running thread of its core (the game keeps per-core data).
+    void CheckOwner(GuestThread& t, const char* where) {
+        if (sched.Running(t.sched->Core()) == t.sched.get()) return;
+        static std::atomic<int> logged{0};
+        if (logged.fetch_add(1) < 20 && cfg.debug_output)
+            cfg.debug_output("runtime kernel: thread " + std::to_string(t.id) + " " + where + " on core " + std::to_string(t.sched->Core()) +
+                             " without holding it");
+    }
+
+    void Sleep(GuestThread& t, int64_t ns) {
+        if (ns <= 0) {
+            // 0 / -1 / -2: yield (to a thread of the same priority, any priority, or another core).
+            sched.Yield(t.sched.get());
+            return;
+        }
+        sync.Sleep(t.id, ns);
+    }
+
+    void Wait(GuestThread& t) {
+        auto& x = t.ctx.x;
+        const int32_t count = static_cast<int32_t>(x[2]);
+        if (count < 0 || count > 64) {
+            x[0] = KernelResult::OutOfRange;
+            return;
+        }
+        std::vector<uint32_t> handles(static_cast<size_t>(count));
+        if (count && !kernel.Read(x[1], handles.data(), handles.size() * 4)) {
+            x[0] = MemResult::InvalidAddress;
+            return;
+        }
+        std::vector<std::shared_ptr<Waitable>> objs;
+        for (const uint32_t h : handles) {
+            auto w = kernel.GetAs<Waitable>(h);
+            if (!w) {
+                x[0] = KernelResult::InvalidHandle;
+                return;
+            }
+            objs.push_back(std::move(w));
+        }
+        int32_t index = -1;
+        const uint32_t r = kernel.WaitAny(t.id, objs, static_cast<int64_t>(x[3]), &index);
+        x[0] = r;
+        if (r == 0) x[1] = static_cast<uint64_t>(index);
+        if (r == KernelResult::Cancelled && t.terminate) x[0] = 0xEC01;
+    }
+
+    uint32_t SetCoreMask(GuestThread& self, uint32_t handle, int core, uint64_t mask) {
+        auto t = ThreadOf(self, handle);
+        if (!t) return KernelResult::InvalidHandle;
+        if (core == -2) core = cfg.main_core;
+        if (core == -3) core = t->ideal_core; // keep the ideal core
+        if (mask == 0 || (mask & ~cfg.core_mask)) return 0xFA01;
+        if (core >= 0 && !((mask >> core) & 1)) return 0xFA01;
+        if (core >= 0) t->ideal_core = core;
+        t->affinity = mask;
+        int run_on = t->ideal_core;
+        if (!((mask >> run_on) & 1))
+            for (int c = 0; c < 4; ++c)
+                if ((mask >> c) & 1) {
+                    run_on = c;
+                    break;
+                }
+        // A thread not started yet starts there. (The game creates its workers, sets their core masks and only then starts them;
+        // the move used to be dropped, so every worker ran on core 0 - and the game, which keeps per-core buffers indexed by the
+        // core number a thread reads at its start, gave them all the same buffer: memory corruption at race start.)
+        t->start_core = run_on;
+        if (t->sched) sched.SetCore(t->sched.get(), run_on);
+        return 0;
+    }
+
+    uint32_t MapShared(uint32_t handle, uint64_t addr, uint64_t size, uint32_t perm) {
+        auto shm = kernel.GetAs<SharedMemory>(handle);
+        if (!shm) return KernelResult::InvalidHandle;
+        if (size != shm->size) return MemResult::InvalidSize;
+        if (perm != MemPerm::Read && perm != MemPerm::ReadWrite) return MemResult::InvalidNewMemoryPermission;
+        const auto& l = mem.GetLayout();
+        if (addr >= l.heap_start && addr < l.heap_start + l.heap_size) return MemResult::InvalidMemoryRegion;
+        return mem.MapPhysical(addr, size, shm->phys, MemState::Shared, perm);
+    }
+    uint32_t UnmapShared(uint32_t handle, uint64_t addr, uint64_t size) {
+        auto shm = kernel.GetAs<SharedMemory>(handle);
+        if (!shm) return KernelResult::InvalidHandle;
+        return mem.Unmap(addr, size, MemState::Shared);
+    }
+    uint32_t CreateTransferMemory(uint64_t addr, uint64_t size, uint32_t perm, uint32_t* out) {
+        if (perm != MemPerm::None && perm != MemPerm::Read && perm != MemPerm::ReadWrite) return MemResult::InvalidNewMemoryPermission;
+        if (const uint32_t r = mem.LockTransfer(addr, size, perm); r) return r;
+        *out = kernel.Add(std::make_shared<TransferMemory>(mem, addr, size));
+        return 0;
+    }
+
+    uint32_t GetInfo(uint32_t type, uint32_t handle, uint64_t sub, uint64_t* out) {
+        const auto& l = mem.GetLayout();
+        switch (type) {
+        case 11: // RandomEntropy (handle 0, sub 0-3)
+            if (handle != 0) return KernelResult::InvalidHandle;
+            if (sub > 3) return 0xF001; // invalid combination
+            *out = entropy[sub];
+            return 0;
+        case 8: // DebuggerAttached
+        case 10: // IdleTickCount
+            *out = 0;
+            return 0;
+        default:
+            break;
+        }
+        if (handle != CurrentProcessHandle) return KernelResult::InvalidHandle;
+        if (sub != 0) return 0xF001;
+        switch (type) {
+        case 0: *out = cfg.core_mask; return 0;
+        case 1: *out = cfg.priority_mask; return 0;
+        case 2: *out = l.alias_start; return 0;
+        case 3: *out = l.alias_size; return 0;
+        case 4: *out = l.heap_start; return 0;
+        case 5: *out = l.heap_size; return 0;
+        case 6: case 21: *out = cfg.total_memory; return 0;        // TotalMemorySize / TotalNonSystemMemorySize
+        case 7: case 22: *out = used_memory ? used_memory() : 0; return 0; // UsedMemorySize / UsedNonSystemMemorySize
+        case 12: *out = l.code_start; return 0;                     // AslrRegionAddress
+        case 13: *out = l.code_size; return 0;
+        case 14: *out = l.stack_start; return 0;
+        case 15: *out = l.stack_size; return 0;
+        case 16: case 17: *out = 0; return 0;                      // system resource size
+        case 18: *out = cfg.program_id; return 0;
+        case 23: *out = 1; return 0;                               // IsApplication
+        case 24: *out = 0x100; return 0;                           // FreeThreadCount
+        default: return 0xF001;
+        }
+    }
+
+    uint64_t AllocateTls() {
+        std::scoped_lock lk{tls_lock};
+        for (auto& [page, used] : tls_pages)
+            for (int i = 0; i < 8; ++i)
+                if (!(used & (1u << i))) {
+                    used |= 1u << i;
+                    return page + static_cast<uint64_t>(i) * TlsSlot;
+                }
+        const auto& l = mem.GetLayout();
+        const auto page = mem.FindFree(l.kmap_start, l.kmap_size, AddressSpace::PageSize);
+        if (!page || mem.MapNew(*page, AddressSpace::PageSize, MemState::ThreadLocal, MemPerm::ReadWrite)) return 0;
+        tls_pages.emplace_back(*page, 1u);
+        return *page;
+    }
+
+    std::shared_ptr<GuestThread> ThreadOf(GuestThread& self, uint32_t handle) {
+        if (handle == CurrentThreadHandle) return std::static_pointer_cast<GuestThread>(self.shared_from_this());
+        return kernel.GetAs<GuestThread>(handle);
+    }
+
+    static uint32_t Arbiter(SyncArbiter::Result r) {
+        switch (r) {
+        case SyncArbiter::Result::Success: return 0;
+        case SyncArbiter::Result::TimedOut: return KernelResult::TimedOut;
+        case SyncArbiter::Result::InvalidState: return KernelResult::InvalidState;
+        case SyncArbiter::Result::InvalidCurrentMemory: return MemResult::InvalidCurrentMemory;
+        case SyncArbiter::Result::Cancelled: return 0xEC01; // termination requested
+        }
+        return KernelResult::InvalidState;
+    }
+
+public:
+    std::function<uint64_t()> used_memory; ///< GetInfo used memory size
+
+private:
+    Config cfg;
+    AddressSpace& mem;
+    NativeKernel& kernel;
+    SyncArbiter& sync;
+    CoreScheduler& sched;
+    Executor& exec;
+    std::array<uint64_t, 4> entropy{};
+    std::atomic<uint64_t> next_id{0x60};
+    std::mutex threads_lock;
+    std::vector<std::shared_ptr<GuestThread>> threads;
+    std::vector<std::thread> host_threads;
+    std::shared_ptr<GuestThread> main_thread;
+    std::mutex tls_lock;
+    std::vector<std::pair<uint64_t, uint32_t>> tls_pages; ///< page, used slots
+};
+
+} // namespace KartRuntime
