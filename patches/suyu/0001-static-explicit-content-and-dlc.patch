+        // Vertex input: the attributes the vertex shader reads, one upload per stream.
+        const VertexLayout layout = ComputeVertexLayout(prog->stages.front(), st);
+        const auto& attrs = layout.attrs;
+        const auto& binds = layout.binds;
+        std::vector<VkBuffer> vb_buffers;
+        std::vector<VkDeviceSize> vb_offsets;
+        for (const u32 stream : layout.streams) {
+            const u32 stride = stream * 2 < st.streams.size() ? st.streams[stream * 2] : 0;
+            const u32 divisor = stream * 2 + 1 < st.streams.size() ? st.streams[stream * 2 + 1] : 0;
+            const auto& vb = st.vertex_buffers[stream];
