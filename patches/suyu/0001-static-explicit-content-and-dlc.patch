+namespace {
+
+// KARTRECOMP_ROMFS_DUMP, a development aid for mod work: with the game loaded (mods and update applied), writes what is in its RomFS and exits.
+//   list=<out file>                      every file, "path size"
+//   get=<romfs path>=<out file>          one file
+//   tree=<romfs dir>=<out dir>           a whole directory
+void DumpRomfsAndExit(Core::System& system, const std::string& spec) {
+    // What the game itself reads: the loader's raw RomFS has neither the update nor the mods, the process's RomFS has both.
+    FileSys::VirtualFile file;
+    if (const auto* process = system.ApplicationProcess()) {
+        u64 program_id = 0;
+        std::shared_ptr<Service::FileSystem::SaveDataController> save;
+        std::shared_ptr<Service::FileSystem::RomFsController> controller;
+        if (system.GetFileSystemController().OpenProcess(&program_id, &save, &controller, process->GetProcessId()) ==
+                Result{} && controller) {
+            file = controller->OpenRomFSCurrentProcess();
+        }
+    }
+    if (!file && (system.GetAppLoader().ReadRomFS(file) != Loader::ResultStatus::Success || !file)) {
+        std::fprintf(stderr, "romfs dump: no RomFS\n");
+        std::exit(2);
+    }
+    const FileSys::VirtualDir root = FileSys::ExtractRomFS(file);
+    if (!root) {
+        std::fprintf(stderr, "romfs dump: cannot read the RomFS\n");
+        std::exit(2);
+    }
+    const auto eq = spec.find('=');
+    const std::string mode = spec.substr(0, eq), rest = eq == std::string::npos ? "" : spec.substr(eq + 1);
+    const auto write_file = [](const FileSys::VirtualFile& f, const std::filesystem::path& to) {
+        std::filesystem::create_directories(to.parent_path());
+        std::ofstream out(to, std::ios::binary);
+        const auto bytes = f->ReadAllBytes();
+        out.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    };
+    std::function<void(const FileSys::VirtualDir&, const std::string&, const std::function<void(const std::string&, const FileSys::VirtualFile&)>&)> walk =
+        [&](const FileSys::VirtualDir& dir, const std::string& prefix, const auto& visit) {
+            for (const auto& f : dir->GetFiles()) visit(prefix + f->GetName(), f);
+            for (const auto& d : dir->GetSubdirectories()) walk(d, prefix + d->GetName() + "/", visit);
+        };
+    if (mode == "list") {
+        std::ofstream out(rest);
+        walk(root, "", [&](const std::string& path, const FileSys::VirtualFile& f) { out << path << ' ' << f->GetSize() << '\n'; });
+    } else if (mode == "get" || mode == "tree") {
+        // get=<path>=<out file>    tree=<dir>=<out dir>[=<only files with this name>]
+        std::vector<std::string> parts;
+        for (size_t at = 0;;) {
+            const auto next = rest.find('=', at);
+            parts.push_back(rest.substr(at, next == std::string::npos ? std::string::npos : next - at));
+            if (next == std::string::npos) break;
+            at = next + 1;
+        }
+        if (parts.size() < 2) {
+            std::fprintf(stderr, "romfs dump: bad spec\n");
+            std::exit(3);
+        }
+        const std::string path = parts[0], to = parts[1], only = parts.size() > 2 ? parts[2] : "";
+        if (mode == "get") {
+            const auto f = root->GetFileRelative(path);
+            if (!f) {
+                std::fprintf(stderr, "romfs dump: %s not found\n", path.c_str());
+                std::exit(3);
+            }
