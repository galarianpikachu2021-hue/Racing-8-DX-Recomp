+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindVertexBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindVertexBuffer, .index = Arg32(ctx, 1)};
+        c.address = ctx.x[2];
+        c.size = ctx.x[3];
+        Append(s, ctx.x[0], std::move(c));
+    };
+    h["nvnCommandBufferBindUniformBuffer"] = [](HookContext& ctx, State& s) {
+        Command c{.op = Op::BindUniformBuffer, .index = Arg32(ctx, 2)};
+        c.stage = Arg32(ctx, 1);
+        c.address = ctx.x[3];
+        c.size = ctx.x[4];
