+            for (const auto& [sig, n] : frame_draws) {
+                KartRe::Log("  {:5} {}", n, sig);
+            }
+            frame_draws.clear();
+            for (const auto& [why, n] : dummy_reasons) {
+                KartRe::Log("  dummy texture: {:8} {}", n, why);
+            }
+            dummy_reasons.clear();
+        }
+        // Textures unused for 20 s (another course, a menu left behind) are freed;
+        // they upload again if they come back.
+        if (frames % 600 == 300) {
+            u64 freed = 0, kept = 0;
+            for (auto it = sampled.begin(); it != sampled.end();) {
+                if (frames - it->second.last_used > 1200) {
+                    if (it->second.ok) {
+                        freed += it->second.bytes;
+                        RetireTexture(it->second);
+                    }
+                    it = sampled.erase(it);
+                } else {
+                    kept += it->second.bytes;
+                    ++it;
+                }
+            }
+            if (freed) {
+                LOG_INFO(Frontend, "nvn-host vulkan: evicted {} MB of unused textures ({} MB kept)",
+                         freed >> 20, kept >> 20);
+            }
+        }
+        // Persist new pipelines now and then: runs often end without a clean shutdown.
+        if (frames % 1800 == 900 && pipelines.size() != pipelines_saved) {
+            pipelines_saved = pipelines.size();
+            SavePipelineCache();
+        }
+        if (++frames % 300 == 0) {
+            const auto ms = [this](Profile::Slot sl) { return prof.ns[sl] / 300.0 / 1e6; };
+            LOG_INFO(Frontend,
+                     "nvn-host vulkan profile (ms/frame): wait {:.2f} record {:.2f} [tex-check {:.2f} "
+                     "upload {:.2f} ({:.1f} MB/frame) descriptors+textures {:.2f} pipelines {:.2f} draws {:.2f} "
+                     "(index-scan {:.2f}, index+vertex setup {:.2f})] submit {:.2f}",
+                     ms(Profile::Wait), ms(Profile::Record), ms(Profile::TexCheck), ms(Profile::Upload),
+                     upload_bytes / 300.0 / 1e6, ms(Profile::Descriptors), ms(Profile::Pipelines),
+                     ms(Profile::DrawTotal), ms(Profile::IndexScan), ms(Profile::PreDescriptors),
+                     ms(Profile::Submit));
