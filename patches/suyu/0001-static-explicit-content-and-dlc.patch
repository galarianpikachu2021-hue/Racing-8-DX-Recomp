+            }
+            if (dump_frame) {
+                ++dumps_done;
+                dump_dir_name = fmt::format("{:06}", frames);
+            }
+        }
+        // GPU state persists across command buffers and frames, as on the hardware:
+        // the game sets some state (e.g. the blend color bloom upsampling uses)
+        // only now and then.
