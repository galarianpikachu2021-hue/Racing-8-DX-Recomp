+static u64 Load64(const u8* p) {
+    return *reinterpret_cast<const volatile u64*>(p);
+}
+static void Store64(u8* p, u64 value) {
+    *reinterpret_cast<volatile u64*>(p) = value;
+}
+
+/// Calls the handler as Windows would for an access violation at `address` (access: 0 read, 1 write), or for a single step.
+static LONG ForgeFault(u8* address, ULONG_PTR access) {
+    EXCEPTION_RECORD rec{};
+    rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+    rec.NumberParameters = 2;
+    rec.ExceptionInformation[0] = access;
+    rec.ExceptionInformation[1] = reinterpret_cast<ULONG_PTR>(address);
+    CONTEXT context{};
+    EXCEPTION_POINTERS pointers{&rec, &context};
+    return DM::Detail::OnException(&pointers);
+}
+static LONG ForgeSingleStep() {
+    EXCEPTION_RECORD rec{};
+    rec.ExceptionCode = EXCEPTION_SINGLE_STEP;
+    CONTEXT context{};
+    EXCEPTION_POINTERS pointers{&rec, &context};
+    return DM::Detail::OnException(&pointers);
+}
+
+/// True when reading `p` raised an exception that reached this frame (no C++ objects here: __try).
+static __declspec(noinline) bool ReadFaultReachesCaller(const volatile u8* p) {
+    __try {
+        (void)*p;
+        return false;
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return true;
+    }
+}
