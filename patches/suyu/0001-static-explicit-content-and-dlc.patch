diff --git a/src/suyu_cmd/cpu_topology.h b/src/suyu_cmd/cpu_topology.h
new file mode 100644
index 0000000000..cfff83c84e
--- /dev/null
+++ b/src/suyu_cmd/cpu_topology.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: keeps the emulator off the efficiency cores of hybrid CPUs.
+//
+// Intel hybrid CPUs (Alder Lake and later) list their performance cores under /sys/devices/cpu_core and
+// the efficiency cores under /sys/devices/cpu_atom. The guest's CPU cores run as host threads, and one
+// scheduled on an E-core is slow enough to show as frame drops, so the whole process is restricted to the
+// P-cores (their hyper-threads included) before any thread exists. Other CPUs are left alone.
+//
+// KARTRECOMP_PIN_PCORES=0 disables it; KARTRECOMP_PCORE_LIST="0-7,16" forces a CPU list (testing).
+#pragma once
+
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <cstdio>
+
+#ifdef __linux__
+#include <sched.h>
+#endif
+
+namespace SuyuCmd {
+
+/// "0-7,16,18-19" -> CPU numbers. Anything unparsable gives an empty list.
+inline std::vector<int> ParseCpuList(const std::string& text) {
+    std::vector<int> cpus;
+    std::stringstream parts(text);
+    std::string part;
+    while (std::getline(parts, part, ',')) {
+        while (!part.empty() && (part.back() == '\n' || part.back() == ' ')) {
+            part.pop_back();
+        }
+        if (part.empty()) {
+            continue;
+        }
+        const auto dash = part.find('-');
+        char* end = nullptr;
+        const long first = std::strtol(part.c_str(), &end, 10);
+        long last = first;
+        if (dash != std::string::npos) {
+            last = std::strtol(part.c_str() + dash + 1, &end, 10);
+        }
+        if (first < 0 || last < first || last >= 1024 || *end != '\0') {
+            return {};
+        }
+        for (long cpu = first; cpu <= last; ++cpu) {
+            cpus.push_back(static_cast<int>(cpu));
+        }
+    }
+    return cpus;
+}
+
+inline std::string ReadSmallFile(const char* path) {
+    std::ifstream file(path);
+    std::string text;
+    std::getline(file, text);
+    return text;
+}
+
+/// Restricts this process (and the threads it creates later) to the performance cores of a hybrid CPU.
+inline void PinToPerformanceCores() {
+#ifdef __linux__
+    if (const char* off = std::getenv("KARTRECOMP_PIN_PCORES"); off && std::string{off} == "0") {
+        return;
+    }
+    std::string list;
+    if (const char* forced = std::getenv("KARTRECOMP_PCORE_LIST")) {
+        list = forced;
+    } else if (!ReadSmallFile("/sys/devices/cpu_atom/cpus").empty()) {
+        list = ReadSmallFile("/sys/devices/cpu_core/cpus");
+    }
+    const auto cpus = ParseCpuList(list);
+    if (cpus.empty()) {
+        return;
+    }
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    for (const int cpu : cpus) {
+        CPU_SET(cpu, &set);
+    }
+    if (sched_setaffinity(0, sizeof(set), &set) == 0) {
+        std::fprintf(stderr, "hybrid CPU: restricted to the performance cores (%zu logical CPUs: %s)\n", cpus.size(), list.c_str());
+    } else {
+        std::fprintf(stderr, "hybrid CPU: could not restrict to the performance cores (%s)\n", list.c_str());
+    }
+#endif
+}
+
+} // namespace SuyuCmd
