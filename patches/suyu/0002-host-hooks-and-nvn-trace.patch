diff --git a/src/common/kart_overlay.h b/src/common/kart_overlay.h
new file mode 100644
index 0000000000..bb13d758a4
--- /dev/null
+++ b/src/common/kart_overlay.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: input path to the in-game overlay menu (suyu_cmd/native_gpu/overlay_menu.h).
+// The window and controller drivers push navigation events here; while the menu is open the
+// drivers keep input away from the game.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <deque>
+#include <mutex>
+
+namespace KartOverlay {
+
+enum class Nav { Up, Down, Left, Right, Accept, Back, Toggle };
+
+inline std::atomic<bool>& OpenFlag() {
+    static std::atomic<bool> open{false};
+    return open;
+}
+inline bool IsOpen() {
+    return OpenFlag().load(std::memory_order_relaxed);
+}
+
+inline std::mutex& QueueLock() {
+    static std::mutex m;
+    return m;
+}
+inline std::deque<Nav>& Queue() {
+    static std::deque<Nav> q;
+    return q;
+}
+
+inline std::atomic<bool>& RestartRequest(); // defined below
+/// Set while the Mods page has unapplied changes: the menu cannot be closed then, only "Restart now" leaves it.
+inline std::atomic<bool>& CloseLocked() {
+    static std::atomic<bool> locked{false};
+    return locked;
+}
+/// Toggle flips the open flag at once; everything else is queued for the render thread.
+inline void Push(Nav n) {
+    if (n == Nav::Toggle) {
+        if (IsOpen() && CloseLocked().load()) { // leaving with unapplied mod changes restarts the game to apply them
+            RestartRequest().store(true);
+            return;
+        }
+        OpenFlag().store(!IsOpen());
+        return;
+    }
+    if (!IsOpen()) {
+        return;
+    }
+    std::scoped_lock lock{QueueLock()};
+    if (Queue().size() < 64) {
+        Queue().push_back(n);
+    }
+}
+
+/// The mods folder the game reads (<dir>/<title id>/<mod>/), set by the frontend at start-up; the overlay's Mods page lists it.
+inline std::string& ModsDir() {
+    static std::string dir;
+    return dir;
+}
+/// Set (by the main-menu hook on the Toy-Con button, now "Mods") to open the overlay on its Mods page.
+inline std::atomic<bool>& ModsPageRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+/// Posted by the overlay for the frontend thread: save the config (mod on/off changed), and save then restart the game.
+inline std::atomic<bool>& SaveRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+inline std::atomic<bool>& RestartRequest() {
+    static std::atomic<bool> req{false};
+    return req;
+}
+/// Held while Settings::values.disabled_addons is changed (render thread) or saved (frontend thread).
+inline std::mutex& SettingsLock() {
+    static std::mutex m;
+    return m;
+}
+/// The game's own command line, for RestartRequest (set by the frontend at start-up).
+inline std::vector<std::string>& LaunchArgs() {
+    static std::vector<std::string> args;
+    return args;
+}
+inline void OpenModsPage() {
+    ModsPageRequest().store(true);
+    OpenFlag().store(true);
+}
+inline bool Pop(Nav& n) {
+    std::scoped_lock lock{QueueLock()};
+    if (Queue().empty()) {
+        return false;
+    }
+    n = Queue().front();
+    Queue().pop_front();
+    return true;
+}
+
+/// The speed limit the user configured, remembered when the overlay first overrides it, so the
+/// frontend's config save (SaveNativeControls) writes the configured value and not the override.
+struct SpeedOriginal {
+    bool saved = false;
+    bool use_limit = true;
+    unsigned percent = 100;
+};
+inline SpeedOriginal& SpeedOriginalValue() {
+    static SpeedOriginal original;
+    return original;
+}
+
+/// Requests from the overlay to the frontend (suyu_cmd's main loop and window): handheld/docked and input recording.
+inline std::atomic<int>& ConsoleRequest() { // -1 none, 0 handheld (low graphics), 1 docked (high)
+    static std::atomic<int> v{-1};
+    return v;
+}
+inline std::atomic<int>& RecordRequest() { // -1 none, 0 stop, 1 start
+    static std::atomic<int> v{-1};
+    return v;
+}
+inline std::atomic<bool>& Recording() {
+    static std::atomic<bool> v{false};
+    return v;
+}
+/// The configured console mode, remembered when the overlay first overrides it (like SpeedOriginal).
+struct ConsoleOriginal {
+    bool saved = false;
+    bool docked = true;
+};
+inline ConsoleOriginal& ConsoleOriginalValue() {
+    static ConsoleOriginal original;
+    return original;
+}
+
+/// Controller assignment for Players 1-4. The window thread publishes the connected controllers
+/// and who plays on what; the overlay shows them as rows and posts a request when a row changes.
+/// Codes: -2 disconnected, -1 keyboard, >= 0 index into `devices`. -3 = no request.
+struct PadState {
+    std::mutex lock;
+    std::vector<std::string> devices;      ///< connected controllers (display names)
+    std::array<int, 4> current{-3, -3, -3, -3};
+    std::array<int, 4> want{-3, -3, -3, -3};
+    uint64_t version = 0;                  ///< bumped whenever devices or current change
+    bool published = false;                ///< the frontend has filled this in at least once
+};
+inline PadState& Pads() {
+    static PadState pads;
+    return pads;
+}
+
+} // namespace KartOverlay
diff --git a/src/common/kart_re_log.h b/src/common/kart_re_log.h
new file mode 100644
index 0000000000..9839ebcc04
--- /dev/null
+++ b/src/common/kart_re_log.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// kart-recomp: reverse-engineering log for the native NVN backend.
+// Enabled with KARTRECOMP_NVN_RE=1; writes <log dir>/nvn_re.txt directly (not
+// through the logger, so nothing is filtered or dropped).
+#pragma once
+
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+
+namespace KartRe {
+
+inline bool Enabled() {
+    static const bool enabled = std::getenv("KARTRECOMP_NVN_RE") != nullptr;
+    return enabled;
+}
+
+/// One stream for the whole process. (A function-local static inside the
+/// template below would exist once per argument signature, each truncating the
+/// same file; that silently lost most lines.)
+inline void WriteLine(const std::string& line) {
+    static std::mutex lock;
+    static std::ofstream out(Common::FS::GetSuyuPath(Common::FS::SuyuPath::LogDir) / "nvn_re.txt",
+                             std::ios::trunc);
+    std::scoped_lock guard{lock};
+    out << line << '\n';
+}
+
+template <typename... Args>
+void Log(fmt::format_string<Args...> format, Args&&... args) {
+    if (!Enabled()) {
+        return;
+    }
+    WriteLine(fmt::format(format, std::forward<Args>(args)...));
+}
+
+} // namespace KartRe
